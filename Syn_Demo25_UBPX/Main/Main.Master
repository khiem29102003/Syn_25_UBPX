	<script>
		var data_m;
		/**
		* Dropdowns
		*/
		
		/*
		document.getElementById("dropdownToggle").addEventListener("click", function() {
			var selectMenu = document.getElementById("selectMenu");
			if (selectMenu.style.display === "block") {
				selectMenu.style.display = "none";
			} else {
				selectMenu.style.display = "block";
			}
		});
		*/

		const requestDataSet = function(script) {
			return new Promise((resolve, reject) => {
				var m = new Memvars();
				var controller = "loaddulieutable";
				var p = window.location.href.toString();
				p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData"; //GetValue

				var query = `${script}`;
				m.val("query", 'C', query);

				$.ajax({
					type: "POST",
					url: p,
					header: '',
					data: JSON.stringify({
						controller: controller,
						oMemvar: m.val()
					}),
					contentType: "application/json; charset=utf-8",
					dataType: "json",
					timeout: 30000,
					success: function(msg, s) {                 
						if (msg.d.length > 0) {
							const data = msg.d;
							resolve(data);
						} else {
							resolve("");
						}
					},
					error: function(e) {
						console.log(e);
					}
				});
			});
		}

		const createDataSet = function () {
			requestDataSet(`select * from dmtttd where ma_loai in ('CALL', 'THDB') and status = 1`)
				.then(data => {
					//console.log(data);
					data.forEach(item => {
						const option = document.createElement("option");
						option.value = item.ma_tttd;
						option.label = item.ten_tttd;

						document.getElementById("callCodes").appendChild(option);
					});					
				})
				.catch(error => {
					console.error(error);
				});

			//requestDataSet(`select ma_qh, ten_qh, ten_qh2, status from dmqhgd where status = 1`)
				//.then(data => {
					//console.log(data);
					//data.forEach(item => {
						//const option = document.createElement("option");
						//option.value = item.ma_qh;
						//option.label = item.ten_qh;

						//document.getElementById("contactCodes").appendChild(option);
					//});					
				//})
				//.catch(error => {
					//console.error(error);
				//});

			requestDataSet(`select ma_plkh, ten_plkh, ten_plkh2, status from dmploaikh where status = 1`)
				.then(data => {
					//console.log(data);
					data.forEach(item => {
						const option = document.createElement("option");
						option.value = item.ma_plkh;
						option.label = item.ten_plkh;

						document.getElementById("contactCodes").appendChild(option);
					});					
				})
				.catch(error => {
					console.error(error);
				});
		}

		function closeModal3() {
            // Lấy phần tử có lớp là "modal3"
            let modal3 = document.querySelector('.modal3');

            // Ẩn phần tử bằng cách đặt thuộc tính "display" thành "none"
            modal3.style.display = 'none';
        }

		function changeStatus(status) {
			var m = new Memvars();
			var controller = "loaddulieutable";
			var p = window.location.href.toString();
			p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData"; //GetValue
					
			var query = `
			UPDATE sysuserinfo
			SET xstatus = ${status}
			WHERE username = '${$.localVal('$USERINFO').Items[2]}'
			`;
			m.val("query", 'C', query);			
			
			$.ajax({
				type: "POST",
				url: p,
				header: '',
				data: JSON.stringify({ controller: controller, oMemvar: m.val() }),
				contentType: "application/json; charset=utf-8",
				dataType: "json",
				timeout: 30000,
				success: function (msg, s) {
					//console.log(msg.d);
				},
				error: function (e) {
					console.log(e);
				}
			});
		}	

		function setStatus() {
			var m = new Memvars();
			var controller = "loaddulieutable";
			var p = window.location.href.toString();
			p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData"; //GetValue		
			var query = `
			SELECT xstatus FROM sysuserinfo WHERE username = '${$.localVal('$USERINFO').Items[2]}'
			`;
			m.val("query", 'C', query);			
			
			$.ajax({
				type: "POST",
				url: p,
				header: '',
				data: JSON.stringify({ controller: controller, oMemvar: m.val() }),
				contentType: "application/json; charset=utf-8",
				dataType: "json",
				timeout: 30000,
				success: function (msg, s) {
					//console.log(msg.d[0]);
					const data = msg.d[0];
					// Cập nhật giá trị status_staff từ trang con
					localStorage.setItem('status_staff', data.xstatus);
				
					var dropdownToggle = document.getElementById("dropdownToggle");
					var selectMenu = document.getElementById("selectMenu");

					if (data.xstatus === 1) {
						dropdownToggle.textContent = "Sẵn sàng";
						dropdownToggle.className = "btn-status btn-success dropdown-toggle"; // Thêm class để thay đổi màu
					} else if (data.xstatus === 2) {
						dropdownToggle.textContent = "Bận";
						dropdownToggle.className = "btn-status btn-danger dropdown-toggle"; // Thêm class để thay đổi màu
					} else {
						dropdownToggle.textContent = "Offline";
						dropdownToggle.className = "btn-status btn-warning dropdown-toggle"; // Thêm class để thay đổi màu
					}

					var selectItems = document.querySelectorAll("#selectMenu a");
					selectItems.forEach(function(item) {
						item.parentElement.style.display = "block";
						if (item.dataset.status === `${data.xstatus}`) {
							item.parentElement.style.display = "none";
						}
						item.addEventListener("click", function(event) {
							event.preventDefault();

							selectItems.forEach(function(li) {
								li.parentElement.style.display = "block";
							});


							$('#dropdownToggle').prop('disabled', true);
							setTimeout(function () {
								$('#dropdownToggle').prop('disabled', false);
							}, 2000);


							this.parentElement.style.display = "none";
							var selectedValue = this.getAttribute("data-value");
							var selectedStatus = this.getAttribute("data-status");
							
							//console.log(selectedValue, selectedStatus);
							localStorage.setItem('status_staff', selectedStatus);
							window.parent.postMessage("changeStatus", "*");

							dropdownToggle.textContent = selectedValue;
							selectMenu.style.display = "none";
							
							// Thay đổi màu nền của button dựa trên giá trị đã chọn
							if (selectedStatus === "1") {
								changeStatus(1);
								dropdownToggle.className = "btn-status btn-success dropdown-toggle"; // Thêm class để thay đổi màu
							} else if (selectedStatus === "2") {
								changeStatus(2);
								dropdownToggle.className = "btn-status btn-danger dropdown-toggle"; // Thêm class để thay đổi màu
							} else if (selectedStatus === "3") {
								changeStatus(3);
								dropdownToggle.className = "btn-status btn-warning dropdown-toggle"; // Thêm class để thay đổi màu
							}
						});
					});
				},
				error: function (e) {
					console.log(e);
				}
			});
		}		
