		// Hàm thêm lớp 'highlight' vào label
		function addHighlightClass(input) {
			var label = document.querySelector('label[for="' + input + '"]');
			label.classList.add("highlight");
		}

		// Hàm xóa lớp 'highlight' khỏi label
		function removeHighlightClass(input) {
			var label = document.querySelector('label[for="' + input + '"]');
			label.classList.remove("highlight");
		}

		// Hàm xóa lớp 'highlight' khỏi tất cả các label có class 'form-label'
		function removeAllHighlightClass() {
			var labels = document.querySelectorAll('label.form-label.highlight');

			labels.forEach(function(label) {
				label.classList.remove("highlight");
			});
		}

		function addData() {
			async function fetchData() {
				try {				
					var callCode = document.getElementById("callCode").value;
					var contactCode = document.getElementById("contactCode").value;
					var noteText = document.getElementById("noteArea").value;
					var ngayNote = document.getElementById("ngayNote").value;
					var firstEmptyField = null;

					// Kiểm tra kiểu dữ liệu và điều kiện Ngày PTP hoặc Ngày Paid
					if (callCode && contactCode) {
						var currentDate = await getSystemDate('yyyy-MM-dd');
						var selectedDate;
						
						// Kiểm tra mã chế độ liên lạc để quyết định cột cần kiểm tra
						if (callCode === "CRC") {
							if (ngayNote) {
								selectedDate = ngayNote;
								if (selectedDate >= currentDate) {
									var boolCallCodes = checkInputValue("callCode", 'callCodes', 2);
									var boolContactCodes = checkInputValue("contactCode", 'contactCodes', 3);
									
									//if (boolModeCodes == true && boolCallCodes == true && boolContactCodes == true) {
									if (boolCallCodes == true && boolContactCodes == true) {
										//@referenceId, @duration, @billsec, @disposition, @datetime0, @datetime2, @hangup, @recordingfile, @src								
										xuLyPhanTuLncg(contactCode, callCode, ngayNote, noteText, data_datetime0, data_datetime2);
										//console.log("INSERT INTO lslncuocgoi (app_id, line, ngay_goi, ma_nv, sdt_vua_goi, ma_qh, ma_td, ma_remode, ngay_hen_dong, tien_hen_dong, tien_paid, dien_giai, tien, ma_bp, ma_pb, ma_donvi, gio_goi, phone_type) SELECT '" + data_appid + "', " + data.maxline + ", '" + data_ngaygoi + "', '" + $.userinfo.val("username") + "', '" + data_dst + "', '" + contactCode + "', '" + callCode + "', '" + modeCode + "', '" + (ngayPTP == "1900-01-01" ? "" : ngayPTP) + "', " + (ptpAmount == "" ? 0 : ptpAmount.replaceAll(',', '')) + ", 0, N'" + noteText + "', 0, '" + data_mabp + "', '" + data_mapb + "', '" + data_madv + "', '" + data_giogoi + "', '" + data_type + "';", data.maxline);
										//@app_id, @ngay_goi, @ma_nv, @sdt_vua_goi, @ma_qh, @ma_td, @ngay_hen_dong, @tien_hen_dong, @ngay_goi_lai, @dien_giai, @ma_remode, @ma_bp, @ma_pb, @ma_donvi, @gio_goi, @phone_type, @ngay_paid, @tien_paid
										clearTextAndDateInput();
										//console.log('false');
										closeModals();
										document.getElementById('dataContainer').style.display = 'none';
										document.getElementById('formCall').style.height = '178px';
										data_flagstatus = 'false';
										//localStorage.setItem('maxline', data.maxline);
										data_notetext = noteText;
										//data_ptpamount = checkPtpAmount;
										//data_ngayptp = ngayPTP;
										//data_modecode = modeCode;
										data_ngaynote = ngayNote;
										data_callcode = callCode;
										data_contactcode = contactCode;
									}
								} else {
									$.showToast("Ngày hẹn gọi lại phải lớn hơn hoặc bằng ngày hiện tại.");
									firstEmptyField = "ngayNote";
									removeAllHighlightClass();
									addHighlightClass("ngayNote");
								}
							} 						
							
							if (firstEmptyField) {
								document.getElementById(firstEmptyField).focus();
							} 	
						} else {				
							var boolCallCodes = checkInputValue("callCode", 'callCodes', 2);
							var boolContactCodes = checkInputValue("contactCode", 'contactCodes', 3);
							
							if (boolCallCodes == true && boolContactCodes == true) {
								//xuLyPhanTu("INSERT INTO lslncuocgoi (app_id, line, ngay_goi, ma_nv, sdt_vua_goi, ma_qh, ma_td, ma_remode, tien_hen_dong, tien_paid, dien_giai, tien, ma_bp, ma_pb, ma_donvi, gio_goi, phone_type) SELECT '" + data_appid + "', " + data.maxline + ", '" + data_ngaygoi + "', '" + $.userinfo.val("username") + "', '" + data_dst + "', '" + contactCode + "', '" + callCode + "', '" + modeCode + "', 0, 0, N'" + noteText + "', 0, '" + data_mabp + "', '" + data_mapb + "', '" + data_madv + "', '" + data_giogoi + "', '" + data_type + "';", data.maxline);
								xuLyPhanTuLncg(contactCode, callCode, null, noteText, data_datetime0, data_datetime2);
								//console.log("INSERT INTO lslncuocgoi (app_id, line, ngay_goi, ma_nv, sdt_vua_goi, ma_qh, ma_td, ma_remode, tien_hen_dong, tien_paid, dien_giai, tien, ma_bp, ma_pb, ma_donvi, gio_goi, phone_type) SELECT '" + data_appid + "', " + data.maxline + ", '" + data_ngaygoi + "', '" + $.userinfo.val("username") + "', '" + data_dst + "', '" + contactCode + "', '" + callCode + "', '" + modeCode + "', 0, 0, N'" + noteText + "', 0, '" + data_mabp + "', '" + data_mapb + "', '" + data_madv + "', '" + data_giogoi + "', '" + data_type + "';", data.maxline);
								clearTextAndDateInput();
								//console.log('false');
								closeModals();
								document.getElementById('dataContainer').style.display = 'none';
								document.getElementById('formCall').style.height = '178px';
								data_flagstatus = 'false';
								//localStorage.setItem('maxline', data.maxline);
								data_notetext = noteText;
								//data_modecode = modeCode;
								data_callcode = callCode;
								data_contactcode = contactCode;	
							}
						}										
					} else {
						if (!callCode) {
							firstEmptyField = "callCode";
							$.showToast("Vui lòng nhập Mã cuộc gọi.");
							removeAllHighlightClass();
							addHighlightClass("callCode");
						} else if (!contactCode) {
							firstEmptyField = "contactCode";
							$.showToast("Vui lòng nhập Mã người liên lạc.");
							removeAllHighlightClass();
							addHighlightClass("contactCode");
						}

						if (firstEmptyField) {
							document.getElementById(firstEmptyField).focus();
						}
					}				
				} catch (error) {
					console.error(error);
				}
			}

			// Gọi hàm fetchData
			fetchData();
		}


		function handleModeCodeChange() {
			var callCode = document.getElementById("callCode").value;
			var ngayNote = document.getElementById("ngayNote");

			// Kiểm tra giá trị của mã chế độ liên lạc và hiển thị nhóm tương ứng
			if (callCode === "CRC") {
				ngayNote.disabled = false;	
			} else {
				ngayNote.disabled = true;
			}
		}


		function copyText() {
			// Ngăn chặn hành vi mặc định của trình duyệt
			event.preventDefault();
			// Lấy nội dung cần sao chép
			var textToCopy = document.getElementById("textToCopy");
		  
			// Tạo một vùng chứa tạm thời để sao chép nội dung
			var tempInput = document.createElement("input");
			tempInput.value = textToCopy.innerText;
			document.body.appendChild(tempInput);
			
			// Chọn toàn bộ nội dung trong vùng chứa tạm thời
			tempInput.select();
		  
			// Thực hiện lệnh sao chép
			document.execCommand("copy");
		  
			// Loại bỏ vùng chứa tạm thời
			document.body.removeChild(tempInput);
		  
			// Hiển thị thông báo hoặc thực hiện các hành động khác (nếu cần)
			alert("Sao chép mã lỗi: " + textToCopy.innerText);
		}
		// Lấy tham chiếu đến nút bằng cách sử dụng id
		var copyTextBtn = document.getElementById("copyButton");

		// Gắn sự kiện click cho nút và trỏ đến hàm handleClick
		copyTextBtn.addEventListener("click", copyText);
		function MoveVideo() {
            document.addEventListener('DOMContentLoaded', (event) => {
                const videoSection = document.getElementById('videoSection');
                const localVideo = document.getElementById('localVideo');
                const remoteVideo = document.getElementById('remoteVideo');

                let isDragging = false;
                let draggedElement = null;
                let offsetX = 0;
                let offsetY = 0;

                function onMouseDown(e) {
                    if (e.target === localVideo || e.target === remoteVideo) {
                        isDragging = true;
                        draggedElement = e.target;
                        offsetX = e.clientX - draggedElement.getBoundingClientRect().left;
                        offsetY = e.clientY - draggedElement.getBoundingClientRect().top;
                    }
                }

                function onMouseMove(e) {
                    if (isDragging && draggedElement) {
                        const rect = videoSection.getBoundingClientRect();
                        draggedElement.style.left = `${e.clientX - rect.left - offsetX}px`;
                        draggedElement.style.top = `${e.clientY - rect.top - offsetY}px`;
                    }
                }

                function onMouseUp() {
                    isDragging = false;
                    draggedElement = null;
                }

                document.addEventListener('mousedown', onMouseDown);
                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });
		}
		MoveVideo();
  </script>
</body>
</html>
