		function changeTotalCall() {
			var m = new Memvars();
			var controller = "loaddulieutable";
			var p = window.location.href.toString();
			p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData"; //GetValue
					
			var query = `
				DECLARE @total_clicktocall int, @total_autocall int, @total_ncall int, @total_slcuocgoi int

				SELECT @total_clicktocall = COUNT(*) from clicktocall where running = 1
				SELECT @total_autocall = COUNT(*) from  autocall where running = 1
				SELECT @total_ncall = ncall from system

				SELECT TOP 1 @total_slcuocgoi = sl_cuocgoi FROM khgoi WHERE GETDATE() BETWEEN ngay_thuchien AND ngay_ketthuc ORDER BY sl_cuocgoi DESC

				SELECT @total_clicktocall total_clicktocall, @total_autocall total_autocall, @total_ncall total_ncall, ISNULL(@total_slcuocgoi, 0) total_slcuocgoi
			`;
			m.val("query", 'C', query);			
			
			$.ajax({
				type: "POST",
				url: p,
				header: '',
				data: JSON.stringify({ controller: controller, oMemvar: m.val() }),
				contentType: "application/json; charset=utf-8",
				dataType: "json",
				timeout: 30000,
				success: function (msg, s) {
					//console.log(msg.d);
					if (msg.d.length > 0) {
						const data = msg.d[0];

						document.querySelector(".counter-ncall").innerHTML = (data.total_ncall - data.total_slcuocgoi);
						document.querySelector(".counter-slcuocgoi").innerHTML = data.total_slcuocgoi;

						document.querySelector(".counter-autocall").dataset.countto = data.total_autocall;
						$(".counter-autocall").each(function () {
							var $this = $(this), countTo = $this.attr("data-countto"); 
							countDuration = parseInt($this.attr("data-duration"));
							$({ counter: $this.text() }).animate(
								{ 
									counter: countTo 
								},
								{
									duration: countDuration,
									easing: "linear",
									step: function () {
										$this.text(Math.floor(this.counter));
									},
									complete: function () {
										$this.text(this.counter);
									}
								}
							);
						});

						document.querySelector(".counter-clicktocall").dataset.countto = data.total_clicktocall;
						$(".counter-clicktocall").each(function () {
							var $this = $(this), countTo = $this.attr("data-countto"); 
							countDuration = parseInt($this.attr("data-duration"));
							$({ counter: $this.text() }).animate(
								{ 
									counter: countTo 
								},
								{
									duration: countDuration,
									easing: "linear",
									step: function () {
										$this.text(Math.floor(this.counter));
									},
									complete: function () {
										$this.text(this.counter);
									}
								}
							);
						});
					}					
				},
				error: function (e) {
					console.log(e);
				}
			});
		}
