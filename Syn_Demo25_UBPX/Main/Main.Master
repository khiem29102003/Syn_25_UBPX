        }
        /* modal3 Content/Box */
        
        .modal3-content {
            background-color: #fefefe;
            margin: 3% auto;
            /* 15% from the top and centered */
            padding: 20px;
            border: 1px solid #888;
            width: 70%;
            /* Could be more or less, depending on screen size */
            height: 70%;
        }
        /* The Close Button */
        
        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }
        
        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }
        /* Iframe container */
        
        .iframe-container {
            display: flex;
            justify-content: space-between;
            width: 100%;
        }
        
        .iframe-container iframe {
            width: 48%;
            /* Two iframes side by side, with some space between */
            height: 500px;
            /* Adjust the height as needed */
        }
        /*=============== TEMPLATE =======================*/
