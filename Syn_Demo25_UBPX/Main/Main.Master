		function checkValueNull(val) {
			switch(val) {
				case undefined:
					return "";
					break;
				case "":
					return "";
					break;
				case null:
					return "";
					break;
				default:
					return val;
			};
		}

		document.getElementById('callFromToArea').addEventListener('click', function() {
			const copyTextarea = this;
			const tooltip = document.getElementById('callFromToTooltip');

			// Lấy nội dung từ thuộc tính data-copy
			const contentToCopy = copyTextarea.getAttribute('data-copy');

			// Tạo một phần tử textarea ẩn để sao chép nội dung vào đó
			const textarea = document.createElement('textarea');
			textarea.value = contentToCopy;
			document.body.appendChild(textarea);

			// Chọn toàn bộ nội dung trong textarea
			textarea.select();

			// Thử sao chép nội dung vào clipboard
			document.execCommand('copy');

			// Xóa phần tử textarea sau khi đã sao chép
			document.body.removeChild(textarea);

			// Thêm lớp CSS để thay đổi màu
			copyTextarea.classList.add('highlighted');

			// Hiển thị tooltip
			tooltip.style.display = 'block';

			// Ẩn tooltip sau 3 giây
			setTimeout(function() {
				tooltip.style.display = 'none';
				copyTextarea.classList.remove('highlighted');
			}, 1500);
		});
	

		function GetDates() {
			// Lấy thời gian hiện tại
			var currentDate = new Date();

			// Tạo các biến để lấy ngày, tháng và năm hiện tại
			var year = currentDate.getFullYear();
			var month = String(currentDate.getMonth() + 1).padStart(2, '0'); // Thêm '0' ở đầu nếu cần
			var day = String(currentDate.getDate()).padStart(2, '0'); // Thêm '0' ở đầu nếu cần
			var hours = String(currentDate.getHours()).padStart(2, '0');
			var minutes = String(currentDate.getMinutes()).padStart(2, '0');
			var seconds = String(currentDate.getSeconds()).padStart(2, '0');

			// Tạo chuỗi định dạng "yyyy-MM-dd HH:mm:ss"
			//var formattedDate = year + '-' + month + '-' + day + ' ' + hours + ':' + minutes + ':' + seconds;
			var formattedDate = year + '-' + month + '-' + day + ' 00:00:00';

			//console.log("Thời gian hiện tại định dạng: " + formattedDate);
			return formattedDate;
		}
		
		
		function FormatDates(date) {
			// Kiểm tra xem date có phải là một đối tượng Date không
			if (!(date instanceof Date)) {
				// Nếu không phải, tạo một đối tượng Date mới từ giá trị của date
				date = new Date(date);
			}

			var year = date.getFullYear();
			var month = String(date.getMonth() + 1).padStart(2, '0');
			var day = String(date.getDate()).padStart(2, '0');
			var hours = String(date.getHours()).padStart(2, '0');
			var minutes = String(date.getMinutes()).padStart(2, '0');
			var seconds = String(date.getSeconds()).padStart(2, '0');
			var milliseconds = String(date.getMilliseconds()).padStart(3, '0');

			var formattedDate = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}.${milliseconds}`;

			return formattedDate;
		}
		
		
		function FormatDatesAll(date) {
			// Kiểm tra xem date có phải là một đối tượng Date không
			if (!(date instanceof Date)) {
				// Nếu không phải, tạo một đối tượng Date mới từ giá trị của date
				date = new Date(date);
			}

			var year = date.getFullYear();
			var month = String(date.getMonth() + 1).padStart(2, '0');
			var day = String(date.getDate()).padStart(2, '0');
			var hours = String(date.getHours()).padStart(2, '0');
			var minutes = String(date.getMinutes()).padStart(2, '0');
			var seconds = String(date.getSeconds()).padStart(2, '0');
			var milliseconds = String(date.getMilliseconds()).padStart(3, '0').slice(0, 3);

			var formattedDate = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}.${milliseconds}`;
			
			var formattedDate2 = year + month + day + hours + minutes + seconds + milliseconds;

			return [formattedDate, formattedDate2];
		}
		
	
		function getSystemTime(format) {
			return new Promise(function(resolve, reject) {
				$.ajax({
					type: "POST",
					url: "/Main/Defaults.aspx/GetSystemTime",
					contentType: "application/json; charset=utf-8",
					dataType: "json",
					data: JSON.stringify({ format: format }),
					success: function(response) {
						var systemTime = response.d;
						resolve(systemTime);
					},
					error: function(error) {
						reject(error);
					}
				});
			});
		}


		function getSystemDate(format) {
			return new Promise(function(resolve, reject) {
				$.ajax({
					type: "POST",
					url: "/Main/Defaults.aspx/getSystemDate",
					contentType: "application/json; charset=utf-8",
					dataType: "json",
					data: JSON.stringify({ format: format }),
					success: function(response) {
						var systemDate = response.d;
						resolve(systemDate);
					},
					error: function(error) {
						reject(error);
					}
				});
			});
		}
		
		
		/******************************************************************************
		let mediaRecorder;
		let audioChunks = [];

		function startRecording(session) {
			const audioStream = session.connection.getRemoteStreams()[0];

			mediaRecorder = new MediaRecorder(audioStream);
			mediaRecorder.ondataavailable = (event) => {
				if (event.data.size > 0) {
					audioChunks.push(event.data);
				}
			};

			mediaRecorder.onstop = () => {
				const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
				saveRecording(audioBlob);
				audioChunks = [];
			};

			mediaRecorder.start();
		}

		function stopRecording() {
			if (mediaRecorder && mediaRecorder.state === 'recording') {
				mediaRecorder.stop();
			}
		}

		function saveRecording(audioBlob) {
			const recordingsDirectory = 'DataRecord'; // Tên thư mục bạn muốn lưu tệp âm thanh vào

			// Tạo thư mục nếu chưa tồn tại
			if (!fs.existsSync(recordingsDirectory)) {
				fs.mkdirSync(recordingsDirectory);
			}

			const filePath = path.join(recordingsDirectory, `recording_${Date.now()}.wav`);
			const fileStream = fs.createWriteStream(filePath);

			audioBlob.stream().pipe(fileStream);

			fileStream.on('finish', () => {
				console.log(`Recording saved to ${filePath}`);
			});
		}
		
		
		var audioContext = new (window.AudioContext || window.webkitAudioContext)();
		var recorder;
		var audioPlayer = document.getElementById('audioPlayer');
		******************************************************************************/
		
		// Hàm hủy đăng ký và đăng ký lại


		function GetRegisterJSSIP() {		
			var m = new Memvars();
			var controller = 'loaddulieulogin';

			m.val('username', 'C',  $.userinfo.val("username"));
			var p = window.location.href.toString();
			p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData";//GetValue
			$.ajax({
				type: "POST",
				url: p,
				header: '',
				data: JSON.stringify({ controller: controller, oMemvar: m.val() }),
				contentType: "application/json; charset=utf-8",
				dataType: "json",
				timeout: 30000,
				success: function (msg, s) {		
					var data = msg.d[0];
					//console.log(msg.d[0]);
					
					
					// Lấy dữ liệu mới từ nguồn nào đó (ví dụ: một API hoặc dữ liệu trên trang)
					var newData = data; // Lấy dữ liệu mới từ nguồn nào đó


					// Lấy dữ liệu đã lưu trữ trong Local Storage
					data_userid = newData.user_id_0;
					data_ip = newData.ip_address;
					data_line = newData.line_sip;
					data_password = newData.password_sip;
					data_port = newData.port;
					data_web = newData.web_socket;
					data_manv = newData.ma_nv;
					data_madv = newData.ma_dv;
					data_mabp = newData.ma_bp;
					data_mapb = newData.ma_pb;
					

					/*
					* How To Use:
					* 1. fill in valid credentials in the config below
					* 2. run the JsFiddle and enjoy
					*/
					var socket = new JsSIP.WebSocketInterface(data_web);

					var configuration = {
						sockets: [socket],
						uri: 'sip:' + data_line + '@' + data_ip + ':' + data_port,
						ws_servers: data_web,
						authorization_user: data_line,
						password: data_password,
						display_name: data_line,
						register: true,
						googIPv6: false,
						register_expires: 300,
						transportOptions: {
							wss: {
								max_reconnection_attempts: 10,
								reconnectionTimeout: 15,
							},
						},
						session_timers: false,
						iceCheckingTimeout: 0,
						hack_via_ws: false,
						rtcpMuxPolicy: 'negotiate' // Thêm tùy chọn RTCP-MUX
					};

					ua = new JsSIP.UA(configuration);
					
					if (configuration.uri && configuration.password) {
						JsSIP.debug.disable('JsSIP:*'); // more detailed debug output
						//JsSIP.debug.enable('JsSIP:*'); // more detailed debug output
						phone = new JsSIP.UA(configuration);
						phone.on('registrationFailed', function (ev) {
							//alert('Registering on SIP server failed with error: ' + ev.cause);
							configuration.uri = null;
							configuration.password = null;
							updateUI();
						});
						

						// Bắt lỗi tổng quát
						phone.on('failed', function(e) {
							console.log('UA failed:', e);
						});

						phone.on('newRTCSession', function (ev) {
							window.parent.postMessage("callStarted", "*");
							var newSession = ev.session;
							if (session) { // hangup any existing call
								session.terminate();
							}
							session = newSession;	
							
							fetchData();

							async function fetchData() {
								try {
									var completeSession = function () {
										session = null;
										updateUI();
										// Trong các hàm bắt sự kiện, sau khi cuộc gọi kết thúc, gửi thông điệp đến trang cha
										window.parent.postMessage({eventType: "callEnded", data: additionalData}, "*");
										hangupAudio();
									};


									// Trong hàm startedSession, sau khi cuộc gọi bắt đầu, hãy thêm thông tin cuộc gọi vào lịch sử
									var startedSession = function (data) {										
										async function fetchStartTime() {										
											try {
												callAccepted = true; // Đánh dấu cuộc gọi đã được chấp nhận
												startedTime = await getSystemDate('yyyy/MM/dd HH:mm:ss.FFF');
												//console.log(startedTime);
												var callInfo = {
													appId: data_appid,
													caller: session.local_identity.uri.user,
													callee: session.remote_identity.uri.user,
													status: 'ANS',
													startTime: startedTime,
													endTime: null,
													callDate: firstedTime,
													billsec: 0, // Khởi tạo billsec với giá trị ban đầu là 0
													duration: 0,
													hangup: ""
												};
												callHistory.push(callInfo);
												updateUI();
												additionalData = {
													message: "ANS"
												};
												
												if (session.direction === 'incoming') {
													console.log('Cuộc gọi đến không cần lưu record cho bên nghe!');
													// Kiểm tra header SIP có liên quan đến refer
													handleIncomingCall();
                                                } else if (session.direction === 'outgoing'){
													handleOutgoingCall();
													startRecording(session);
												}
																								
												console.log('Call success:', data);

												// Kiểm tra xem có thông báo SIP không
												if (data.response) {
													var sipMessage = data.response;

													// Kiểm tra xem có phần headers không
													if (sipMessage.headers && sipMessage.headers['P-Asserted-Identity']) {
														var pAssertedIdentityValue = sipMessage.headers['P-Asserted-Identity'][0];
														//console.log('P-Asserted-Identity:', pAssertedIdentityValue.raw);
														
														// Chuỗi đầu vào
														var inputString = pAssertedIdentityValue.raw;

														// Sử dụng biểu thức chính quy để lấy phần số CID
														var match = inputString.match(/CID:(\d+)/);

														// Kiểm tra xem có phù hợp không
														if (match && match[1]) {
															var cidNumber = match[1];
															//console.log('CID Number:', cidNumber);
															data_outboundcid = cidNumber;															
														} else {
															//console.log('CID Number not found in the input string');
															data_outboundcid = '';
														}

														// Xử lý giá trị P-Asserted-Identity ở đây
													} else if (sipMessage.headers && sipMessage.headers['Remote-Party-Id']) {
														var pAssertedIdentityValue = sipMessage.headers['Remote-Party-Id'][0];
														//console.log('P-Asserted-Identity:', pAssertedIdentityValue.raw);
														
														// Chuỗi đầu vào
														var inputString = pAssertedIdentityValue.raw;

														// Sử dụng biểu thức chính quy để lấy phần số CID
														var match = inputString.match(/CID:(\d+)/);

														// Kiểm tra xem có phù hợp không
