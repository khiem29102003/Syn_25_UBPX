		function internalcall(line, password, web, ip, port, sdt, mabp, manv) {
			if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
				var userConfirmed = confirm("Bạn có chắc chắn muốn tiếp tục không?");
				if (userConfirmed) {
					// Yêu cầu truy cập vào microphone khi trang web được tải
					navigator.mediaDevices.getUserMedia({ audio: true })
					.then(function(stream) {
						var plaintext = "ip=" + ip + "&wss=" + web + "&port=" + port + "&line=" + line + "&pw=" + password + "&phone=" + sdt + "&appid=" + "" + "&manv=" + manv + "&mabp=" + mabp;

						// Mã hóa chuỗi bằng CryptoJS
						var encoded = CryptoJS.AES.encrypt(plaintext, "IS7676VT").toString();
						
						//console.log(encoded);				
						document.getElementById('formCall').src = "/Main/call.html?" + encoded;
						document.getElementById('modal_form').style.display = 'block';
						document.getElementById('dataContainer').style.display = 'none';
						data_flagstatus = 'false';
						// Trang cha (popup)
						// Lắng nghe thông điệp từ iframe
						var flag = data_flagstatus;
						window.addEventListener("message", function(event) {
							if (event.data.eventType === "callEnded") {
								if (flag == 'false') {
									closeModals();	
									document.getElementById('dataContainer').style.display = 'none';
									document.getElementById('formCall').style.height = '178px';	
									//console.log("3");									
								}
							}
						});		
					})
					.catch(function(error) {
						// Người dùng từ chối hoặc có lỗi xảy ra
						$.showToast('Lỗi khi yêu cầu truy cập vào microphone: ' + error);
					});
				}
			} else {
				$.showToast('Trình duyệt không hỗ trợ API getUserMedia.');
			}
		}


