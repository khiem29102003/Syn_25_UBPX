									function handleOutgoingCall(session) {

                                        navigator.mediaDevices.getUserMedia({ video: isVideoOutGoing, audio: true })
                                            .then(function (stream) {
                                                // Hiển thị local stream (luồng của bạn) trên phần tử localVideo
                                                var localVideoElement = document.getElementById('localVideo');
                                                localVideoElement.srcObject = stream;

                                                // Thêm stream vào kết nối WebRTC
                                                stream.getTracks().forEach(function (track) {
													session.connection.addTrack(track, stream);
												});
                                                session.call({
                                                    mediaConstraints: { audio: true, video: isVideoOutGoing }
                                                });
                                            })
                                            .catch(function (err) {
                                                console.error('Không thể truy cập camera/micro: ', err);
                                            });
                                    }

                                    // Hàm xử lý cuộc gọi đến
                                    function handleIncomingCall(session) {
                                        // Yêu cầu quyền truy cập camera và micro
                                        navigator.mediaDevices.getUserMedia({ video: isThisVideo, audio: true })
                                            .then(function (stream) {
                                                var localVideoElement = document.getElementById('localVideo');
                                                localVideoElement.srcObject = stream;
                                            })
                                            .catch(function (err) {
                                                console.error('Không thể truy cập camera/micro: ', err);
                                            });
                                    }
									// Trong hàm endedSession, sau khi cuộc gọi kết thúc, tính thời gian billsec và cập nhật giá trị
									var endedSession = function (data) {
										document.getElementById('videoSection').style.display = 'none';
                                        var localVideoElement = document.getElementById('localVideo');
                                        if (localVideoElement.srcObject) {
                                            localVideoElement.srcObject.getTracks().forEach(function (track) {
                                                track.stop();  // Dừng track
                                            });
                                        }
										var callInfo = callHistory.find(function (info) {
											return info.caller === session.local_identity.uri.user &&
												info.callee === session.remote_identity.uri.user &&
												info.status === 'ANS';
										});
										
										var endedTime;
										var sdt = data_dst;
										var sessionDirection = session.direction;
										
										async function fetchEndedTime() {										
											try {
												endedTime = await getSystemDate('yyyy/MM/dd HH:mm:ss.FFF');												
												//console.log(endedTime);
												
												//console.log(data.originator);
												if (data.originator === 'local') {
													// Người gọi kết thúc cuộc gọi
													//console.log('Người gọi kết thúc cuộc gọi : ' + session.local_identity.uri.user);
													if (callInfo) {
														//callInfo.status = 'HANGUP';
														callInfo.endTime = endedTime;
														// Tính thời gian billsec và cập nhật vào thuộc tính billsec
														callInfo.billsec = Math.floor(((new Date(callInfo.endTime)) - (new Date(callInfo.startTime))) / 1000);
														callInfo.duration = Math.floor(((new Date(callInfo.endTime)) - (new Date(callInfo.callDate))) / 1000);
														callInfo.hangup = "AGENT";
													}
													additionalData = {
														message: "ANS",
														hangup: "AGENT"
													};
												} else if (data.originator === 'remote') {
													// Người nhận cuộc gọi kết thúc cuộc gọi
													//console.log('Người nhận cuộc gọi kết thúc cuộc gọi : ' + session.remote_identity.uri.user);
													if (callInfo) {
														//callInfo.status = 'HANGUP';
														callInfo.endTime = endedTime;
														// Tính thời gian billsec và cập nhật vào thuộc tính billsec
														callInfo.billsec = Math.floor(((new Date(callInfo.endTime)) - (new Date(callInfo.startTime))) / 1000);
														callInfo.duration = Math.floor(((new Date(callInfo.endTime)) - (new Date(callInfo.callDate))) / 1000);
														callInfo.hangup = "CUSTOMER";										
													}
													additionalData = {
														message: "ANS",
														hangup: "CUSTOMER"
													};
												}
																														
												var m = new Memvars();
												var controller = "loaddulieutable";
												var p = window.location.href.toString();
												p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData"; //GetValue
														
												m.val("query", 'C', "select * from dmkh where ma_kh in ('" + data_outboundcid + "')");			
												
												$.ajax({
													type: "POST",
													url: p,
													header: '',
													data: JSON.stringify({ controller: controller, oMemvar: m.val() }),
													contentType: "application/json; charset=utf-8",
													dataType: "json",
													timeout: 30000,
													success: function (msg, s) {
