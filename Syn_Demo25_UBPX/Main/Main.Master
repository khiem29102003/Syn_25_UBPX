					})
					tab.classList.add("active");
				})
			});			
		}


		function tabFilters(imabp, imapb, imadv) {
			var tabs = document.querySelectorAll(".tabs_wrap ul li");
			var	bps = document.querySelectorAll("." + imabp);
			var pbs = document.querySelectorAll("." + imapb);
			var dvs = document.querySelectorAll("." + imadv);
			var all = document.querySelectorAll(".item_wrap");


			tabs.forEach((tab)=>{
				tab.addEventListener("click", ()=>{
					tabs.forEach((tab)=>{
						tab.classList.remove("active");
					})
					tab.classList.add("active");
					var tabval = tab.getAttribute("data-tabs");

					all.forEach((item)=>{
						//console.log("none");					
						item.style.display = "none";
					})

					if(tabval == imabp){
						//console.log(imabp);					
						bps.forEach((bp)=>{
							bp.style.display = "block";
						})
					}
					else if(tabval == imapb){
						//console.log(imapb);
						pbs.forEach((pb)=>{
							pb.style.display = "block";
						})
					}
					else if(tabval == imadv){
						//console.log(imadv);
						dvs.forEach((dv)=>{
							dv.style.display = "block";
						})
					}
					else if(tabval == "both"){
						//console.log("both");
						all.forEach((item)=>{
							item.style.display = "block";
						})
					}
				})
			})
		}


