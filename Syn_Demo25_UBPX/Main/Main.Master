		function loadContent() {	 		
			var rowSupport = "";
			var rowStaff = "";
			var count = 0;
			
			
			for (var item of arrOn) {
				var encodedString = "";
				count++;
				if (item.image_id != 0 || item.image_id != "") {
					let originalString = 'Download[@#]0[@#]' + item.image_id + '[@#]1[@#][@#]';
					// Mã hóa chuỗi UTF-8 thành Base64
					encodedString = utf8_to_b64(originalString);
				}

				var formattedDate = "";
				if (kiemTraChuoi(item.time_kt, 2) != "") {
					var timestamp = parseInt((item.time_kt).match(/\d+/)[0]);
					// Tạo đối tượng Date từ số miligisecond
					var dateObject = new Date(timestamp);
					formattedDate = new Intl.DateTimeFormat('vi-VN', {
						day: '2-digit',
						month: '2-digit',
						year: 'numeric',
						hour: '2-digit',
						minute: '2-digit',
						second: '2-digit',
					}).format(dateObject);
				} else {
					formattedDate = "Cập nhật";
				}	
				// 
				if (item.hotro_yn == 1 && item.useron == 1) {			
					// Mã hóa số điện thoại
					var secretKey = 'vtechcore';
					var encrypted = CryptoJS.AES.encrypt(kiemTraChuoi(item.line_sip, 0), secretKey).toString();		
					rowSupport += 	`<li class="context-menu-row item_wrap bp${item.ma_bp} dv${item.ma_dv} pb${item.ma_pb} online" data-manv="${kiemTraChuoi(item.ma_nv, 0)}" data-line="${encrypted}">
										<div class="item">
											<div class="flex-item">
												<div class="item_left flex-item">
													<div class="img">
														<div class="user-avatars" style="background-image: url(&quot;../AppHandler/FileHandler.ashx?param=${encodedString}&quot;);"></div>
													</div>
												</div>
											</div>
											<div class="item_right flex-item">
												<div class="data">
													<p class="name">${item.ten_nv}</p>
													<p class="distance status">Online</p>
												</div>
											</div>
											<div class="flex-item">
												<div class="data">
													<p class="name">${kiemTraChuoi(item.sl_time, 1)}</p>
													<p class="distance">${formattedDate}</p>
												</div>
											</div>
											<div class="flex-item">										
												<div class="item_right flex-item">
													<div class="data">
														<p class="name"><button class="call-btn" data-line="${encrypted}"></button></p>														
														<p class="distance line">${kiemTraChuoi(item.line_sip, 1)}</p>
													</div>
												</div>
											</div>
										</div>
									</li>`;															
				}
				
				if (item.useron == 1) {
					// Mã hóa số điện thoại
					var secretKey = 'vtechcore';
					var encrypted = CryptoJS.AES.encrypt(kiemTraChuoi(item.line_sip, 0), secretKey).toString();
					rowStaff += 	'<li class="context-menu-row item_wrap bp' + item.ma_bp + ' dv' + item.ma_dv + ' pb' + item.ma_pb + ' online" data-manv="' + kiemTraChuoi(item.ma_nv, 0) + '" data-manv="${kiemTraChuoi(item.ma_nv, 0)}" data-line="' + encrypted + '">' +
										'<div class="item">' +
											'<div class="flex-item">' +
												'<div class="item_left flex-item">' +
													'<div class="img">' +
														'<div class="user-avatars" style="background-image: url(&quot;../AppHandler/FileHandler.ashx?param=' + encodedString + '&quot;);"></div>' +
