	<script>
		var timeoutId;	
		var seconds = 60;
		var intervalId;
		var countdownElement;


		var arrBP = [];
		var arrPB = [];
		var arrDV = [];
		var arrOn = [];
		var arrOff = [];	
		var arrMCDLL = [];	
		var arrMCG = [];	
		var arrMNLL = [];	
		var arrMaxLine = [];


		var	chooseBP = "";	 
		var	choosePB = "";	 
		var	chooseDV = "";	 
		var	chooseMANV = "";	 
		var	chooseOnOff = 2;


		setTimeout(function() {	
			data_flagstatus = 'false';


			loadDataTable('loaddulieutable', 'select ma_bp, ten_bp from dmbp group by ma_bp, ten_bp', arrBP);
			loadDataTable('loaddulieutable', 'select ma_pb, ten_pb from dmpb group by ma_pb, ten_pb', arrPB);
			loadDataTable('loaddulieutable', 'select ma_dv, ten_dv from dmdonvi group by ma_dv, ten_dv', arrDV);
			
			
			capNhatNoiDung();
		}, 2000)

		
		/*
		setTimeout(function() {	
			loadDataTable('loaddulieutable', 'select * from vdmremode', arrMCDLL);
			loadDataTable('loaddulieutable', 'select * from vdmtd', arrMCG);
			loadDataTable('loaddulieutable', 'select * from vdmqhgd', arrMNLL);
		}, 2000)
		*/
		

		$(document).ready(function () {		
			$(".open-call").on("click", function (e) {
				e.preventDefault();
				$("#wrap-support").animate({ width: "toggle" }, 300);
				$(".open-call").toggleClass("opened closed");
			});
			$(".close-call").click(function () {
				$("#wrap-support").hide({ width: "toggle" }, 300);
			});
			$(".reset-call").click(function () {
				capNhatNoiDung();			
			});

			var wrapper = document.getElementById('flex-wrapper');
			var inside = document.getElementById('flex-inside');

			wrapper.style.height = inside.offsetHeight + "px";		
			
			countdownElement = document.getElementById("countdown");
			loadMaxHeightArea();
			loadDateToday();
			loadDateTodayValid();
			createDataSet();
			

			if (!$.userinfo.val("user_id") || $.userinfo.val("user_id") != "" || $.userinfo.val("user_id") != null || $.userinfo.val("user_id") != undefined) {
				setTimeout(function () {
					loadListUser();									
					ganMenuOptions();
					
					
					setTimeout(function() {
						loadTabFilter();
						btnCallClick("#support-box", "#staff-box");	
						tabFilter();					
					}, 1000);


					var input;
					input = document.getElementById("searchStaff");
					input.addEventListener("keyup", function() {
						var filter, ul, li, a, i;												
						filter = input.value.toUpperCase();
						//console.log(filter);
						ul = document.getElementById("staff-box");
						li = ul.getElementsByTagName("li");
						for (i = 0; i < li.length; i++) {
							a = li[i].getElementsByTagName("p")[0];
							code = li[i].dataset.manv;
							line = li[i].dataset.line;
							if (a.innerHTML.toUpperCase().indexOf(filter) > -1) {
								li[i].style.display = "";
							} else if ((code == undefined ? "" : code).toUpperCase().indexOf(filter) > -1) {
								li[i].style.display = "";
							} else if ((line == undefined ? "" : line).toUpperCase().indexOf(filter) > -1) {
								li[i].style.display = "";
							} else {
								li[i].style.display = "none";
							}
						}
					});


					const contextMenu = document.getElementById("contextMenu");
					const rows = document.querySelectorAll(".context-menu-row");

					rows.forEach((row) => {
						row.addEventListener("contextmenu", (event) => {
							event.preventDefault();
							const dataManv = row.getAttribute("data-manv");
							showContextMenu(event.clientX, event.clientY, dataManv);
						});
					});

					document.addEventListener("click", () => {
						hideContextMenu();
					});
				
					const buttons = document.querySelectorAll(".faq-toggle");
					let activeIndex = 0;
					buttons.forEach((button, index) => {
						button.addEventListener("click", () => {
							// Loại bỏ lớp "active" khỏi tất cả các button
							buttons.forEach((otherButton) => {
								otherButton.parentElement.classList.remove("active");
							});

							// Đảm bảo chỉ có một button là ở trạng thái "active" vào một thời điểm
							button.parentElement.classList.add("active");

							// Cập nhật activeIndex
							activeIndex = index;
						});
					});
					// Đặt trạng thái "active" cho button mặc định (ví dụ: button đầu tiên)
					buttons[activeIndex].parentElement.classList.add("active");				
				}, 3000);
			};
		});


		//setTimeout(loadCodeCall(), 5000);
		
		
		function loadCodeCall() {
			document.getElementById("btnResetData").disabled = true;
			document.getElementById("wait_btn_reset").style.display = "block";
			htmlMCDLL = "";
			htmlMCG = "";
			htmlMNLL = "";
			arrMCDLL = [];
			arrMCG = [];
			arrMNLL = [];
			
			
			loadDataTable('loaddulieutable', 'select * from vdmremode', arrMCDLL);
			loadDataTable('loaddulieutable', "select * from vdmtd where ma_loai in ('CALL', 'THDB') and status = 1", arrMCG);
			loadDataTable('loaddulieutable', 'select * from vdmqhgd', arrMNLL);
			
			
			setTimeout(function() {	
				for (var item of arrMCDLL) {
					htmlMCDLL += "<option value='" + item.ma_remode + "' label='" + item.ten_remode + "'></option>";			
				}
				document.getElementById('modeCodes').innerHTML = htmlMCDLL;
				for (var item of arrMCG) {
					htmlMCG += "<option value='" + item.ma_td + "' label='" + item.ten_td + "'></option>";
				}
				document.getElementById('callCodes').innerHTML = htmlMCG;
				for (var item of arrMNLL) {
					htmlMNLL += "<option value='" + item.ma_qh + "' label='" + item.ten_qh + "'></option>";
				}
				document.getElementById('contactCodes').innerHTML = htmlMNLL;
				document.getElementById("btnResetData").disabled = false;
				document.getElementById("wait_btn_reset").style.display = "none";
			}, 3000)	
		}


		setTimeout(function() {
			let isDragging = false;
			let isDraggingDmttcall = false;
			let offsetX, offsetY;
			let offsetDmttcallX, offsetDmttcallY;

			const modal = document.getElementById('modal-child');
			const modaldmttcall = document.getElementById('popup_dmttsdt_child');

			modal.addEventListener('mousedown', (e) => {
				if (e.target.classList.contains('draggable')) {
					isDragging = true;
					offsetX = e.clientX - modal.getBoundingClientRect().left;
					offsetY = e.clientY - modal.getBoundingClientRect().top;
					modal.style.cursor = 'grabbing';
				}
			});
			modaldmttcall.addEventListener('mousedown', (e) => {
				if (e.target.classList.contains('draggable')) {
					isDraggingDmttcall = true;
					offsetDmttcallX = e.clientX - modaldmttcall.getBoundingClientRect().left;
					offsetDmttcallY = e.clientY - modaldmttcall.getBoundingClientRect().top;
					modaldmttcall.style.cursor = 'grabbing';
				}
			});

			document.addEventListener('mousemove', (e) => {
				if (isDragging) {
					let newLeft = e.clientX - offsetX;
					let newTop = e.clientY - offsetY;

					// Kiểm tra nếu div vượt ra khỏi tầm hiển thị, thì giữ nó ở mép
					newLeft = Math.max(0, newLeft);
					newTop = Math.max(0, newTop);

					// Lấy chiều rộng và chiều cao của màn hình
					const screenWidth = window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth;
					const screenHeight = window.innerHeight || document.documentElement.clientHeight || document.body.clientHeight;

					// Kiểm tra nếu div vượt ra khỏi tầm hiển thị, thì giữ nó ở mép
					newLeft = Math.min(screenWidth - modal.offsetWidth, newLeft);
					newTop = Math.min(screenHeight - modal.offsetHeight, newTop);

					modal.style.left = newLeft + 'px';
					modal.style.top = newTop + 'px';
				}
			});
			document.addEventListener('mousemove', (e) => {
				if (isDraggingDmttcall) {
					let newLeft = e.clientX - offsetDmttcallX;
					let newTop = e.clientY - offsetDmttcallY;

					// Kiểm tra nếu div vượt ra khỏi tầm hiển thị, thì giữ nó ở mép
					newLeft = Math.max(0, newLeft);
					newTop = Math.max(0, newTop);

					// Lấy chiều rộng và chiều cao của màn hình
					const screenWidth = window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth;
					const screenHeight = window.innerHeight || document.documentElement.clientHeight || document.body.clientHeight;

					// Kiểm tra nếu div vượt ra khỏi tầm hiển thị, thì giữ nó ở mép
					newLeft = Math.min(screenWidth - modaldmttcall.offsetWidth, newLeft);
					newTop = Math.min(screenHeight - modaldmttcall.offsetHeight, newTop);

					modaldmttcall.style.left = newLeft + 'px';
					modaldmttcall.style.top = newTop + 'px';
				}
			});
			document.addEventListener('mouseup', () => {
				isDragging = false;
				modal.style.cursor = 'move';
			});
			document.addEventListener('mouseup', () => {
				isDraggingDmttcall = false;
				modaldmttcall.style.cursor = 'move';
			});
		}, 2000);


		function loadDateToday() {
			// Lấy ngày hiện tại
			var today = new Date();

			// Định dạng ngày để có định dạng YYYY-MM-DD (định dạng phù hợp với input type=date)
			var dd = String(today.getDate()).padStart(2, '0');
			var mm = String(today.getMonth() + 1).padStart(2, '0'); // Tháng bắt đầu từ 0
			var yyyy = today.getFullYear();

			// Ghép chuỗi để có định dạng YYYY-MM-DD
			var formattedDate = yyyy + '-' + mm + '-' + dd;

			// Gán giá trị cho trường ngày
			document.getElementById('ngayNote').value = formattedDate;
			//document.getElementById('ngayPTP').value = formattedDate;
		}
		
		
		function loadDateTodayValid() {
			// Lấy tham chiếu đến phần tử input
			var ngayNoteInput = document.getElementById('ngayNote');

			// Lấy ngày hiện tại
			var currentDate = new Date();
			var currentYear = currentDate.getFullYear();
			var currentMonth = (currentDate.getMonth() + 1).toString().padStart(2, '0'); // Thêm số 0 phía trước nếu tháng là một chữ số
			var currentDay = currentDate.getDate().toString().padStart(2, '0'); // Thêm số 0 phía trước nếu ngày là một chữ số

			// Tìm ngày cuối cùng của tháng hiện tại
			var lastDay = new Date(currentYear, currentMonth, 0).getDate();

			// Đặt giá trị cho thuộc tính min và max của input
			ngayNoteInput.setAttribute('min', `${currentYear}-${currentMonth}-01`);
			ngayNoteInput.setAttribute('max', `${currentYear}-${currentMonth}-${lastDay}`);

			/*
			// Thêm sự kiện lắng nghe để kiểm tra giá trị ngày nhập vào
			ngayNoteInput.addEventListener('change', function() {
				var selectedDate = new Date(this.value);
				if (selectedDate > currentDate) {
					// Giữ giá trị ngày nếu nó lớn hơn ngày hiện tại
					this.value = `${currentYear}-${currentMonth}-${currentDay}`;
				}
			});
			*/
		}


		function loadMaxHeightArea() {
			let isResizing = false;
			let startHeight, startY;

			const container = document.getElementById('modal-child');
			const textarea = document.getElementById('noteArea');

			textarea.addEventListener('mousedown', (e) => {
				isResizing = true;
				startHeight = parseInt(document.defaultView.getComputedStyle(textarea).height, 10);
				startY = e.clientY;
			});
			
			document.addEventListener('mousemove', (e) => {
				if (isResizing) {
					let newHeight = startHeight + (e.clientY - startY);

					// Kiểm tra xem có vượt quá kích thước của div không
					if (newHeight > container.offsetHeight) {
						newHeight = container.offsetHeight;
						isResizing = false; // Ngưng kéo khi vượt quá kích thước
					}

					// Kiểm tra xem có vượt quá kích thước tối thiểu không (ở đây là 50)
					if (newHeight < 50) {
						newHeight = 50;
					}

					textarea.style.height = newHeight + 'px';
				}
			});

			document.addEventListener('mouseup', () => {
				isResizing = false;
			});	
		};


		function ganMenuOptions() {
			// Lấy các mục trong menu ngữ cảnh
			const callOption = document.getElementById("callOption");
			const viewOption = document.getElementById("viewOption");
			const messageOption = document.getElementById("messageOption");

			// Gán sự kiện click cho mỗi mục
			callOption.addEventListener("click", () => {
				interactWithOption("Gọi", 1);
			});

			viewOption.addEventListener("click", () => {
				interactWithOption("Xem thông tin", 2);
			});

			messageOption.addEventListener("click", () => {
				interactWithOption("Nhắn tin", 3);
			});
		};


