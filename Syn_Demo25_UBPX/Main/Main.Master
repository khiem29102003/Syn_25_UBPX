									var recorder;
									var audioIn_01;
									var audioIn_02;
									var dest;

									// Hàm để bắt đầu ghi âm cuộc gọi
									function startRecording(session) {
										var localStream = session.connection.getLocalStreams()[0];
										var remoteStream = session.connection.getRemoteStreams()[0];

										var OutgoingAudioMediaStream = new MediaStream();
										OutgoingAudioMediaStream.addTrack(localStream.getAudioTracks()[0]);

										var IncomingAudioMediaStream = new MediaStream();
										IncomingAudioMediaStream.addTrack(remoteStream.getAudioTracks()[0]);

										const audioContext = new AudioContext();

										audioIn_01 = audioContext.createMediaStreamSource(OutgoingAudioMediaStream);
										audioIn_02 = audioContext.createMediaStreamSource(IncomingAudioMediaStream);

										dest = audioContext.createMediaStreamDestination();

										audioIn_01.connect(dest);
										audioIn_02.connect(dest);

										var FinalStream = dest.stream;

										// Tạo RecordRTC object và lưu vào biến toàn cục
										recorder = RecordRTC(FinalStream, {
											type: 'audio',
											mimeType: 'audio/ogg', // Chuyển đổi sang định dạng ogg
											audioBitsPerSecond: 8000, // Giảm bit rate xuống 8kbps
											recorderType: MediaStreamRecorder, //StereoAudioRecorder, // Chọn recorder type
											desiredSampRate: 16000, // Tần số lấy mẫu mong muốn
											numberOfAudioChannels: 1 // Số kênh âm thanh (1: mono, 2: stereo)
										});

										// Bắt đầu ghi âm
										recorder.startRecording();
									}

									// Hàm để dừng ghi âm
									function stopRecording(customValue, cid) {
										if (recorder && recorder.state === 'recording') {
											recorder.stopRecording(function() {
												var audioBlob = recorder.getBlob();
												saveRecording(audioBlob, customValue, cid);
											});
										}
									}

									function saveRecording(audioBlob, customValue, cid) {
										var formData = new FormData();
										formData.append('audio', audioBlob, 'recording.webm'); // Đổi thành webm nếu máy chủ xử lý được
										formData.append('customValue', customValue);

										fetch('/AppHandler/YourSaveRecordingHandler.ashx', {
											method: 'POST',
											body: formData
										})
										.then(response => {
											if (!response.ok) {
												return response.text().then(text => { throw new Error(text) });
											}
											return response.text(); // hoặc response.json() nếu phản hồi là JSON
										})
										.then(data => {
											console.log('Success:', data); // Kiểm tra dữ liệu trả về từ server
											data_record = data;
											$('#callStatus').show();

											var callWaiting = document.getElementById("callWaiting");
											setTimeout(function() {
												callWaiting.style.display = "none";
												window.parent.postMessage({ eventType: "callEnded", data: additionalData }, "*");
											}, 1000);

											displayCallHistory("LSCG", cid);
										})
										.catch(error => {
											console.error('Error saving recording:', error);
											$('#callStatus').show();

											var callWaiting = document.getElementById("callWaiting");
											setTimeout(function() {
												callWaiting.style.display = "none";
												window.parent.postMessage({ eventType: "callEnded", data: additionalData }, "*");
											}, 5000);

											displayCallHistory("LSCG", "");
										});
									}
									
