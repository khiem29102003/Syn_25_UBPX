    <asp:ContentPlaceHolder ID="ContentHeader" runat="server"></asp:ContentPlaceHolder>
	
	<style type="text/css">
        .auto-style1 {
            width: 94%;
            height: 471px;
        }
        
        #modal_form {
            display: none;
            position: relative !important;
            /* Sử dụng position: fixed thay vì position: absolute */
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 10000;
        }
        
        #modal-child {
            width: 400px;
            background: white;
            border-radius: 16px;
            position: fixed;
            top: 20%;
            left: 40%;
            cursor: default;
            transition: transform 0.3s ease;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(8.6px);
            -webkit-backdrop-filter: blur(8.6px);
            border-top: 35px solid rgba(210, 210, 210, 0.6);
        }
        
        .handle {
			position: absolute;
			width: 37px;
			height: 27px;
			top: -31px;
			right: 6px;
			background-color: #363333;
			border-radius: 4px;
			display: flex;
			justify-content: center;
			align-items: center;
			cursor: pointer;
			color: white;
        }
        
        .handle:hover {
            cursor: move
        }
        
        .handle i {
            color: #333;
            /* Màu của biểu tượng */
            font-size: 20px;
        }
        
        .handle::before,
        .handle::after {
            content: '';
			position: absolute;
			width: 10px;
			height: 2px;
			background-color: #ffffff;
        }
        
        .handle::before {
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            transform-origin: right;
        }
        
        .handle::after {
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            transform-origin: bottom;
        }
        
        .handle:hover::before,
        .handle:hover::after {
            background-color: #555;
        }
        
        #popup_dmttsdt {
            display: none;
            position: relative !important;
            /* Sử dụng position: fixed thay vì position: absolute */
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 10000;
        }
        
        #popup_dmttsdt_child {
            background: white;
            border-radius: 16px;
            position: fixed;
            top: 20%;
            left: 40%;
            cursor: default;
            transition: transform 0.3s ease;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(8.6px);
            -webkit-backdrop-filter: blur(8.6px);
            border-top: 35px solid rgba(210, 210, 210, 0.6);
        }
        
        #error_popup_dmttsdt {
            display: block;
        }
        
        #modal_form2 {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10000;
        }
        
        #formCall2 {
            border-radius: 16px;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(8.6px);
            -webkit-backdrop-filter: blur(8.6px);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        
        .data-form {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 5%;
            padding: 7px;
        }
        
        .form-group-inline {
            width: 30%;
            box-sizing: border-box;
        }
        
        .form-group-error {
            width: 100%;
            box-sizing: border-box;
            height: 100px;
        }
        
        .form-group-inline-two {
            width: 47%;
            box-sizing: border-box;
        }
        
        .form-label {
            font-size: 13px;
            font-weight: 600;
        }
        
        .form-label-red {
            color: red;
        }
        
        .form-label-error {
            color: red;
            text-align: justify;
            padding: 10px;
        }
        
        .form-label-blue {
            color: dodgerblue;
        }
        
        .data-container {
            width: 400px;
            display: none;
        }
        
        .error-container {
            width: auto;
            display: none;
        }
        
        #formCall {
            border: none;
        }
        /* Điều chỉnh kiểu hiển thị của datalist */
        
        #modeCodes option,
        #callCodes option,
        #contactCodes option {
            display: flex;
            align-items: center;
        }
        
        #modeCodes option::before,
        #callCodes option::before,
        #contactCodes option::before {
            content: attr(label);
            margin-right: 10px;
        }
        
        .form-input {
            border: none;
            border-bottom: 1px solid;
            background: none;
            width: 100%;
            height: 33px;
            box-sizing: border-box;
        }
        
        .form-button {
            width: 30%;
            height: 55px;
            border-radius: 5px;
            margin-left: auto;
        }
        
        .form-textarea {
            resize: vertical;
            width: 100%;
            background: none;
            border: none;
            border-bottom: 1px solid;
            min-height: 50px;
        }
        
        .form-group-area {
            width: 100%;
        }
        
        .content-support {
            text-align: center;
            width: 500px;
            height: 100%;
            background: #f7f7f7;
            padding: 10px 10px;
            border-radius: 20px 0px 0 20px;
        }
        
        #wrap-support {
            position: absolute;
            right: 0px;
            top: 65px;
            bottom: 4px;
            display: none;
			z-index: 1;
        }
        
        .open-call {
            /* padding: 15px 30px; */
            /* font-size: 18px; */
            /* cursor: pointer; */
            /* margin-top: 100px; */
        }
        
        .close-call {
            position: absolute;
            right: 10px;
            top: 20px;
            background: transparent;
            border: none;
            cursor: pointer;
            background-color: #ca2929;
            /* Màu nền */
        }
        
        .reset-call {
            position: absolute;
            right: 50px;
            top: 20px;
            background: transparent;
            border: none;
            cursor: pointer;
            background-color: #3498db;
            /* Màu nền */
        }
        
        .time-call {
            position: absolute;
            right: 90px;
            top: 20px;
            background: transparent;
            border: none;
            cursor: default !important;
            background-color: #3498db;
            /* Màu nền */
        }
        
        .button-call {
            font-size: 25px;
            color: #ffffff;
            /* Màu chữ */
            border: none;
            /* Không có viền */
            font-size: 16px;
            /* Kích thước chữ */
            cursor: pointer;
            /* Hiển thị con trỏ khi di chuột qua nút */
            border-radius: 5px;
            /* Bo tròn góc */
            z-index: 1;
        }
        /* Hover effect */
        
        .reset-call:hover {
            background-color: #2980b9;
            /* Màu nền khi hover */
        }
        
        .close-call:hover {
            background-color: #861818;
            /* Màu nền khi hover */
        }
        
        .number-online {
            position: absolute;
            left: -50px;
            top: 12px;
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 18px;
            z-index: 100;
            background-color: #269e26;
            color: white;
            border-radius: 22px;
            width: 45px;
            height: 42px;
        }
        
        #wrap-support h1 {
            color: #1d1e22;
            font-size: 18px;
            letter-spacing: 1px;
        }
        
        #wrap-support p {
            color: #1d1e22;
            line-height: normal;
            letter-spacing: 0.1px;
            text-align: justify;
        }
        
        @import url('https://fonts.googleapis.com/css?family=Montserrat:400,600,700&display=swap');
        .wrapper {
            width: 495px;
            height: 100%;
            background: #fff;
            margin: 0 auto 0;
        }
        
        .wrapper .title {
            /* padding: 30px 20px; */
            text-align: center;
            font-size: 24px;
            font-weight: 700;
            /* border-bottom: 1px solid #ebedec; */
            line-height: 35px;
            /* height: 35px; */
        }
        
        .wrapper .tabs_wrap {
            /* padding: 20px; */
            border-bottom: 1px solid #ebedec;
            /* height: 80px; */
            padding-bottom: 4px;
        }
        
        .wrapper .tabs_wrap ul {
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            justify-content: center;
            list-style-type: none;
            padding: 0;
            margin: 0;
            line-height: 40px;
        }
        
        .wrapper .tabs_wrap ul li {
            flex-grow: 1;
            width: calc(100% / 4) !important;
            text-align: center;
            background: #e9ecf1;
            border-right: 1px solid #c1c4c9;
            /* padding: 13px 15px; */
            cursor: pointer;
            -webkit-transition: all 0.2s ease;
            -o-transition: all 0.2s ease;
            transition: all 0.2s ease;
        }
        
        .wrapper .tabs_wrap ul li:first-child {
            border-top-left-radius: 25px;
            border-bottom-left-radius: 25px;
        }
        
        .wrapper .tabs_wrap ul li:last-child {
            border-right: 0px;
            border-top-right-radius: 25px;
            border-bottom-right-radius: 25px;
        }
        
        .wrapper .tabs_wrap ul li:hover,
        .wrapper .tabs_wrap ul li.active {
            background: #7fc469;
            color: #000000;
        }
        
        .wrapper .container-support .item_wrap {
            /* padding: 5px 5px; */
            border-bottom: 1px solid #ebedec;
            cursor: pointer;
            min-height: 40px;
        }
        
        .wrapper .container-support .item_wrap:hover {
            background: #e9ecf1;
        }
        
        .wrapper .container-support .item {
            position: relative;
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-box-pack: justify;
            -ms-flex-pack: justify;
            justify-content: space-between;
        }
        
        .flex-item {
            text-align: center;
        }
        /* Cài đặt các tỷ lệ cho các phần tử con */
        
        .flex-item:nth-child(1) {
            /* flex: 1;  Phần nhỏ */
            padding-right: 7px;
        }
        
        .flex-item:nth-child(2) {
            flex: 1.3;
            /* Chiếm 60% */
        }
        
        .flex-item:nth-child(3) {
            flex: 1;
            /* Chiếm 30% */
            /* padding-right: 10px; */
        }
        
        .flex-item:nth-child(4) {
            /* flex: 1;  Chiếm 30% */
            /* padding-right: 10px; */
            text-align: center;
        }
        
        .flex-item:nth-child(5) {
            flex: 3;
            /* Phần còn lại */
        }
        
        .item_wrap .item .item_left {
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
        }
        
        .item_wrap .item_left img {
            width: 50px;
            height: 50px;
            display: block;
        }
        
        .item_wrap .item_left .data {
            margin-left: 20px;
        }
        
        .item_wrap .item_left .data .name {
            font-weight: 600;
        }
        
        .item_wrap .item_left .data .distance {
            color: #7f8b9b;
            font-size: 14px;
            margin-top: 3px;
        }
        
        .item_wrap .item_right .status {
            position: relative;
            color: #77818d;
        }
        
        .item_wrap .item_right .status:before {
            content: "";
            position: absolute;
            top: 5px;
            left: -10px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #b3bbc8;
        }
        
        .item_wrap.offline .item_right .status {
            color: #b3bbc8;
        }
        
        .item_wrap.online .item_right .status:before {
            background: #7fc469;
        }
        
        .container-support {
            height: calc(100% - 89px);
        }
        
        .container-support ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
            overflow: auto;
            height: 100%;
        }
        /*=============== GOOGLE FONTS ===============*/
        
        @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap");
        .faq-container {
            max-width: 600px;
            margin: 0 auto 0;
            border-radius: 10px;
            background-color: #f8f8f8;
            box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px;
            overflow: hidden;
            height: 100%;
        }
        
        .faq {
            box-sizing: border-box;
            background: transparent;
            padding: 10px;
            position: relative;
            overflow: hidden;
        }
        
        .faq:not(:first-child) {
            border-top: 1px solid #e6e6e6;
        }
        
        .faq-title {
            margin: 0 35px 0 0;
        }
        
        .faq-text {
            margin: 20px 0 0;
            display: none;
            line-height: 1.5rem;
            height: calc(100% - 40px);
        }
        
        .faq.active {
            background-color: #fff;
            box-shadow: inset 4px 0px 0px 0px var(--accent-color);
            height: calc(100% - 47px);
        }
        
        .faq.active .faq-title {
            color: var(--accent-color);
        }
        
        .faq.active .faq-text {
            display: block;
        }
        
        .faq-toggle {
            background-color: transparent;
            border: 1px solid #e6e6e6;
            color: inherit;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            padding-top: 3px;
            position: absolute;
            top: 10px;
            left: 20px;
            height: 30px;
            width: 30px;
            transition: 0.3s ease;
        }
        
        .faq-toggle:focus {
            outline: none;
        }
        
        .faq.active .faq-toggle {
            transform: rotate(180deg);
            background-color: var(--accent-color);
            border-color: var(--accent-color);
            color: #000000;
        }
        /*=============== POPUP THAM DINH ===============*/
        
        .custom-model-main {
            text-align: center;
            overflow: hidden;
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            /* z-index: 1050; */
            -webkit-overflow-scrolling: touch;
            outline: 0;
            opacity: 0;
            -webkit-transition: opacity 0.15s linear, z-index 0.15;
            -o-transition: opacity 0.15s linear, z-index 0.15;
            transition: opacity 0.15s linear, z-index 0.15;
            z-index: -1;
            overflow-x: hidden;
            overflow-y: auto;
        }
        
        .custom-model-media {
            text-align: center;
            overflow: hidden;
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            /* z-index: 1050; */
            -webkit-overflow-scrolling: touch;
            outline: 0;
            opacity: 0;
            -webkit-transition: opacity 0.15s linear, z-index 0.15;
            -o-transition: opacity 0.15s linear, z-index 0.15;
            transition: opacity 0.15s linear, z-index 0.15;
            z-index: -1;
            overflow-x: hidden;
            overflow-y: auto;
        }
        
        .model-open {
            z-index: 99999;
            opacity: 1;
            overflow: hidden;
        }
        
        .custom-model-inner {
            -webkit-transform: translate(0, -25%);
            -ms-transform: translate(0, -25%);
            transform: translate(0, -25%);
            -webkit-transition: -webkit-transform 0.3s ease-out;
            -o-transition: -o-transform 0.3s ease-out;
            transition: -webkit-transform 0.3s ease-out;
            -o-transition: transform 0.3s ease-out;
            transition: transform 0.3s ease-out;
            transition: transform 0.3s ease-out, -webkit-transform 0.3s ease-out;
            display: inline-block;
            vertical-align: top;
            width: 100%;
            margin: 35px auto;
            max-width: 1230px;
        }
        
        .model-open .custom-model-vertical {
            -webkit-transform: translate(100%, 0);
            -ms-transform: translate(100%, 0);
            transform: translate(100%, 0);
            position: absolute;
            z-index: 999;
            height: 100%;
            right: 600px;
        }
        
        .custom-model-vertical {
            -webkit-transform: translate(25%, 0);
            -ms-transform: translate(25%, 0);
            transform: translate(25%, 0);
            -webkit-transition: -webkit-transform 0.3s ease-out;
            -o-transition: -o-transform 0.3s ease-out;
            transition: -webkit-transform 0.3s ease-out;
            -o-transition: transform 0.3s ease-out;
            transition: transform 0.3s ease-out;
            transition: transform 0.3s ease-out, -webkit-transform 0.3s ease-out;
            display: inline-block;
            vertical-align: top;
            width: 100%;
            /* margin: 35px auto; */
            max-width: 600px;
        }
        
        .custom-model-wrap {
            display: block;
            width: 100%;
            position: relative;
            /* background-color: #fff; */
            /* border: 1px solid #999; */
            /* border: 1px solid rgba(0, 0, 0, 0.2); */
            border-radius: 6px;
            -webkit-box-shadow: 0 3px 9px rgba(0, 0, 0, 0.5);
            box-shadow: 0 3px 9px rgba(0, 0, 0, 0.5);
            background-clip: padding-box;
            outline: 0;
            text-align: left;
            padding: 4px;
            -webkit-box-sizing: border-box;
            -moz-box-sizing: border-box;
            box-sizing: border-box;
            max-height: 100vh;
            overflow-y: auto;
            height: 65%;
        }
        
        .model-open .custom-model-inner {
            -webkit-transform: translate(0, 0);
            -ms-transform: translate(0, 0);
            transform: translate(0, 0);
            position: relative;
            z-index: 999;
            height: 100%;
        }
        
        .model-open .bg-overlay {
            background: rgba(0, 0, 0, 0.6);
            z-index: 99;
        }
        
        .bg-overlay {
            background: rgba(0, 0, 0, 0);
            height: 100vh;
            width: 100%;
            position: fixed;
            left: 0;
            top: 0;
            right: 0;
            bottom: 0;
            z-index: 0;
            -webkit-transition: background 0.15s linear;
            -o-transition: background 0.15s linear;
            transition: background 0.15s linear;
        }
        
        .close-btn {
            position: absolute;
            top: -55px;
            right: 0px;
            cursor: pointer;
            z-index: 99;
            font-size: 45px;
            color: #fff;
        }
        
        .pop-up-content-wrap {
            height: 100%;
        }
        
        @media screen and (min-width:800px) {
            .custom-model-main:before {
                content: "";
                display: inline-block;
                height: auto;
                vertical-align: middle;
                margin-right: -0px;
                height: 100%;
            }
            .custom-model-media:before {
                content: "";
                display: inline-block;
                height: auto;
                vertical-align: middle;
                margin-right: -0px;
                height: 100%;
            }
        }
        
        @media screen and (max-width:799px) {
            .custom-model-inner {
                margin-top: 45px;
            }
            .custom-model-vertical {
                margin-right: 10px;
            }
        }
        
        .user-avatars {
            width: 35px;
            height: 35px;
            background-color: #b7702a;
            border-radius: 100%;
            background-size: 100% auto;
        }
        
        #loading-screen {
            display: none;
            position: absolute;
            top: 0;
            right: 0;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.8);
            text-align: center;
            padding-top: 50%;
            font-size: 20px;
            z-index: 9999;
        }
        
        .loader {
            border: 8px solid #f3f3f3;
            border-top: 8px solid #3498db;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }
        
        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }
        
        .select-staff {
            width: 100%;
            border: none;
            background: transparent;
        }
        
        .select-staff:focus-visible {
            outline-offset: 0;
            border: none;
        }
        
        .scroll-inner {
            overflow-x: auto;
            &::-webkit-scrollbar {
                width: 10px;
            }
            &::-webkit-scrollbar:horizontal {
                height: 5px;
            }
            &::-webkit-scrollbar-track {
                background-color: transparentize(#ccc, 0.7);
            }
            &::-webkit-scrollbar-thumb {
                border-radius: 10px;
                background: transparentize(#ccc, 0.5);
                box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.5);
            }
        }
        /* Thiết lập style cho input */
        
        #searchStaff {
            margin: 5px 0px 0px 0px;
            padding: 8px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 4px;
            width: calc(100% - 100px);
            float: left;
        }
        
        #contextMenu {
            display: none;
            position: fixed;
            background-color: #fff;
            border: 1px solid #ccc;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            padding: 8px;
            z-index: 1000;
        }
        
        #contextMenu ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        
        #contextMenu li {
            padding: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        
        #contextMenu li:hover {
            background-color: #f0f0f0;
        }
        /* Add icons to the options */
        
        #contextMenu #callOption::before {
            content: "\260E";
            /* Unicode for phone icon */
            margin-right: 8px;
        }
        
        #contextMenu #viewOption::before {
            content: "\1F4D6";
            /* Unicode for document icon */
            margin-right: 8px;
        }
        
        #contextMenu #messageOption::before {
            content: "\1F4E9";
            /* Unicode for envelope icon */
            margin-right: 8px;
        }
        
        .call-btn {
            display: inline-block;
            font-size: 16px;
            font-weight: bold;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            border: 2px solid #3498db;
            color: #3498db;
            border-radius: 5px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        
        .call-btn:hover {
            background-color: #3498db;
            color: #fff;
        }
        /* Thêm biểu tượng điện thoại */
        
        .call-btn::before {
            content: "\260E";
            /* Unicode for phone icon */
            margin: 7px;
        }
        
        .total-number {
            margin: 0;
            line-height: 45px;
            vertical-align: middle;
        }
        
        #wrap-support p.distance.line {
            text-align: center;
        }
        
        .highlight {
            color: red;
            /* Một số kiểu CSS tùy chọn để làm nổi bật label */
            font-weight: bold;
        }
        
        input:focus-visible {
            outline: none;
            border-color: #007bff;
            /* Màu sắc mới khi input được focus-visible */
        }
        /* Khi được focus bởi bất kỳ phương tiện nào khác (fallback) */
        
        input:focus {
            outline: none;
            border-color: #007bff;
            /* Màu sắc mới khi input được focus */
        }
        
        textarea:focus-visible {
            outline: none;
            border-color: #007bff;
            /* Màu sắc mới khi input được focus-visible */
        }
        /* Khi được focus bởi bất kỳ phương tiện nào khác (fallback) */
        
        textarea:focus {
            outline: none;
            border-color: #007bff;
            /* Màu sắc mới khi input được focus */
        }
        
        .btn-reset-code .div-reset-code {
            background: url(../Images/all_icon_1.png);
            background-repeat: no-repeat;
            width: 16px;
            height: 16px;
            margin: auto;
            background-position: -224px -0 !important;
        }
        
        .btn-reset-code {
            background: none;
            border: none;
        }
    </style>

    <style>
        @charset"UTF-8";
        /* CSS Document */
        /* Styling for the wrapper */
        /* Styling for the wrapper to simulate a mobile phone */
        
        #wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 20px;
            padding: 5px;
            border: 1px solid #ccc;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            background-color: #0c0c0ca8;
            max-width: 400px;
            height: 180px;
            margin: auto;
        }
        
        #power_by {
            color: white;
            margin: auto;
        }
        /* Styling for the incoming call */
        /*
		#incomingCall {
			display: flex;
			flex-direction: column;
			align-items: center;
			border: 1px solid #ccc;
			border-radius: 10px;
			background-color: #ffffff1c;
			margin-bottom: 20px;
			width: 300px;
		}
		*/
        
        #incomingCall {
            display: block;
            background-image: url('/Images/phoneX.png');
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            height: 130px;
        }
        
        #incomingCall {
            display: none;
            flex-direction: column;
            align-items: center;
            padding: 12px;
            /* border: 1px solid #ccc; */
            border-radius: 10px;
            background-color: #fff;
            margin-bottom: 5px;
            width: 300px;
            text-align: center;
        }
        /* Styling for the call info */
        
        .callInfo {
            text-align: center;
            display: inline-block;
            align-items: center;
            width: 71%;
            display: inline-block;
        }
        /* Styling for the call info elements */
        
        .callInfo h3 {
            font-size: 24px;
            margin-bottom: 5px;
            margin-top: 0;
            color: mintcream;
        }
        
        .callInfo p {
            font-size: 16px;
            color: #fff;
        }
        /* Styling for the answer and reject buttons */
        
        #answer,
        #reject {
            display: inline-block;
            width: 30%;
            margin-top: 10px;
            cursor: pointer;
            padding: 7px 20px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
        }
        
        #reject {
            transform: scaleY(-1);
            margin-right: 10px;
            background-color: red !important;
        }
        /* Styling for the call status */
        
        #callStatus {
            display: none;
            flex-direction: column;
            align-items: center;
            padding: 10px;
            /* border: 1px solid #ccc; */
            border-radius: 7px;
            background-color: #fff;
            margin: auto;
            width: 370px;
        }
        /* Styling for the call control */
        
        #callControl {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        /* Styling for the "to" field */
        
        #toField {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            width: 80%;
            margin-bottom: 10px;
            font-size: 16px;
        }
        /* Styling for the connect call button */
        
        #connectCall {
            cursor: pointer;
            padding: 10px 20px;
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
        }
        
        .call-icons {
            text-align: center;
            /* margin: 0 auto; */
            /* height: calc(100% - 0px); */
            display: inline-block;
            float: right;
            /* margin: 0 0 -30px 0; */
            cursor: pointer;
            /* padding: 10px 20px; */
            /* background-color: #d53434c4; */
            /* color: white; */
            /* border: none; */
            border-radius: 5px;
            font-size: 16px;
            width: 20%;
        }
        
        #mute {
            margin: auto;
            border-radius: 10px;
            padding: 10px 0;
            background-color: white;
            margin-bottom: 5px;
            cursor: pointer;
        }
        
        #mute img {
            cursor: pointer;
        }
        
        #hangUp {
            border-radius: 10px;
            padding: 10px 0;
            background-color: #d53434c4;
            cursor: pointer;
        }
        
        #hangUp img {
            cursor: pointer;
        }
        /* Styling for the hang-up button */
        /* CSS cho dialPad */
        
        #dialPad {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 24px;
        }
        /* CSS cho dialpad-char (được sử dụng để hiển thị thời gian) */
        
        .dialpad-char {
            font-size: 20px;
            color: gold;
        }
        
        .dialpad-channel {
            font-size: 20px;
            color: bisque;
        }
        
        #callStatus {
            display: block;
            background-image: url(/Images/phoneX.png);
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            height: 140px;
        }
        
        #callInfoText {
            color: white;
        }
        
        #callInfoNumber {
            margin: 7px 0px 4px 0px;
            /* Loại bỏ margin mặc định */
            color: cyan;
        }
        
        .slogan-name {
            font-weight: 600;
            text-decoration: none;
            color: white;
        }
        
        .slogan-name:hover {
            font-weight: 600;
            text-decoration: none;
            color: #59aee8;
        }
        
        #errorMessage {
            text-align: center;
            padding: 0 0 5px 0;
        }
        
        @import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap");
        .card-error *,
        .card-error *:after,
        .card-error *:before {
            box-sizing: border-box;
            padding: 0;
            margin: 0;
            //font-family: "Inter", sans-serif;
        }
        
        .card-error {
            border-radius: 0.75rem;
            background-color: #fff;
            overflow: hidden;
        }
        
        .info__padding {
            padding: 5px;
        }
        
        .card-error h3 {
            font-size: 19px;
            margin-bottom: 12px;
            font-weight: 600;
        }
        
        .card-error p {
            font-size: 16px;
            font-weight: 400;
        }
        
        .card-error h3,
        .card-error p {
            color: #0b1a28;
            text-align: center;
        }
        
        .button__group button {
            color: #007aff;
            background-color: #fff;
            font-size: 16px;
            font-weight: 500;
            outline: none;
            border: none;
            border-top: 1px solid rgb(220, 224, 226);
            border-left: 1px solid rgb(220, 224, 226);
            padding: 10px 10px;
            cursor: pointer;
            float: left;
            width: calc(100% / 3);
        }
        
        .button__group:after {
            content: "";
            clear: both;
            display: table;
        }
        
        .button__group button:not(:last-child) {
            //border-left: none;
        }
        
        .button__group button:hover {
            background-color: rgb(250, 250, 250);
        }
        
        .button__group button:active {
            background-color: rgb(245, 245, 245);
        }
        
        @media only screen and (max-width: 600px) {
            .card-error {
                padding: 30px;
            }
        }
        
        .col-32 {
            width: 32% !important;
        }
        
        #errorFormDmttsdt {
            gap: 1%;
        }
        
        .color-ans {
            color: #34a853;
        }
        
        .color-nans {
            color: rgba(255, 0, 0, 0.7);
        }
        
        .color-busy {
            color: rgb(242, 93, 43);
        }
        
        .color-faild {
            color: rgba(255, 0, 0, 0.7);
        }
        
        .color-can {
            color: rgb(30, 144, 255);
        }
        
        .color-udf {
            color: #200cd9;
        }
        
        .btn-custom {
            text-align: center;
            width: auto;
            right: 5px;
            top: -28px;
            position: absolute;
            border: none;
            background: transparent;
        }
        
        .btn-icon-custom {
            text-align: center;
            margin: 0 auto;
            border: none;
            width: 20px;
            height: 20px;
            cursor: pointer;
        }
        
        .btn-icon-custom:hover {
            background-color: #c4bebe;
        }
        
        #copyButton {
            cursor: pointer;
        }
        
        #textToCopy {
            text-align: left;
            margin: 0 0 10px 10px;
        }
        
        .title-error {
			position: absolute;
			top: 0%;
			right: -50%;
			float: left;
			transform: translate(-70%, -130%);
			font-size: 14px;
			font-weight: 700;
			color: #519f9c;
			width: calc(100% - 50px);
			text-align: center;
        }
        
        textarea#callFromToArea {
            transition: background-color 0.3s ease;
        }
        
        textarea#callFromToArea.highlighted {
            background-color: lightblue;
        }
        
        .highlighted {
            background-color: lightblue;
        }
        
        #callFromToGroup {
            position: relative;
            position: relative;
            margin-top: 30px;
            /* Để chừng nào để mũi tên của tooltip được hiển thị rõ */
        }
        
        #callFromToTooltip {
            display: none;
            position: absolute;
            background-color: #333;
            color: #fff;
            padding: 5px;
            border-radius: 5px;
            transition: opacity 0.3s ease;
            top: -40px;
            right: 5px;
        }
        
        #callFromToTooltip::before {
            content: '';
            position: absolute;
            width: 0;
            height: 0;
            border-left: 10px solid transparent;
            border-right: 10px solid transparent;
            border-top: 10px solid #333;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
        }
        
        #btnAddData {
            position: relative;
        }
        
        #callWaiting {
            left: 0;
            top: 0;
            position: absolute;
            width: 100%;
            height: 100%;
            background-color: #c8c8c873;
        }
        
        #btnAddData.waiting:after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 30px;
            height: 30px;
            border: 3px solid #ccc;
            border-radius: 50%;
            border-top-color: #333;
            animation: spin 1s infinite linear;
        }
        
        #callWaiting.waiting:after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 30px;
            height: 30px;
            border: 3px solid #ccc;
            border-radius: 50%;
            border-top-color: #333;
            animation: spin 1s infinite linear;
        }
        
        @keyframes spin {
            0% {
                transform: translate(-50%, -50%) rotate(0deg);
            }
            100% {
                transform: translate(-50%, -50%) rotate(360deg);
            }
        }
        /**
        * Dropdowns
        */
        
        @dropdown-bg: #FFFFFF;
        @dropdown-divider-bg: #E0E0E0;
        .dropdown-menu {
            background-color: @dropdown-bg;
            border: none;
            box-shadow: 1px 2px 6px rgba(0, 0, 0, .2);
            margin-top: 2px;
            .divider {
                background-color: @dropdown-divider-bg;
            }
        }
        /**
        * Buttons
        */
        
        @btn-padding-lr: 1.2em;
        .btn-group>.btn-status:first-child {
            margin-left: 0;
            padding: 5px;
        }
        
        .btn-status {
            min-width: 80px;
            height: 32px;
            padding: 0;
            cursor: default;
            border: 0px solid rgba(0, 0, 0, 0) !important;
            border-radius: 5px !important;
            box-shadow: 0 1px 5px rgba(0, 0, 0, .4) !important;
            padding-left: @btn-padding-lr;
            padding-right: @btn-padding-lr;
            &:hover,
            &:focus,
            &:active,
            &:active &:focus {
                outline: none !important;
            }
        }
        
        .btn-flat-style(@color,
        @hover-color) {
            background-color: inherit;
            box-shadow: none;
            color: @color;
            font-weight: bold;
            &:hover {
                color: @color;
                background-color: @hover-color;
            }
            &:focus {
                color: @color;
            }
        }
        
        @btn-hover-percent: 2.5%;
        .btn-style(@bg-color) {
            background-color: @bg-color;
            &:hover {
                background-color: darken(@bg-color, @btn-hover-percent);
            }
            &:focus {
                background-color: @bg-color;
            }
        }
        
        @btn-danger-color: #F44336;
        .btn-danger {
            .btn-style(@btn-danger-color);
        }
        
        .btn-flat-danger {
            .btn-flat-style(@btn-danger-color,
            lighten(@btn-danger-color,
            35%));
        }
        
        .btn-link {
            box-shadow: none;
        }
        /* Custom styles for dropdown button colors */
        
        #dropdownToggle {
            transition: background-color 0.3s ease;
            /* Thêm hiệu ứng chuyển đổi */
        }
        
        #dropdownToggle.btn-danger {
            background-color: #F44336;
            /* Màu đỏ cho trạng thái "Bận" */
        }
        
        #dropdownToggle.btn-success {
            background-color: #008000;
            /* Màu xanh cho trạng thái "Sẵn sàng" */
        }
        
        #dropdownToggle.btn-warning {
            background-color: #FFA500;
            /* Màu cam cho trạng thái "Chuẩn bị" */
        }
        
        .counter-autocall,
        .counter-clicktocall {
            display: flex;
            align-items: center;
            align-content: center;
            justify-content: center;
            font-size: 14px;
            background-color: #f4f4f4;
            width: 52px;
            border-radius: 25%;
            height: 25px;
            vertical-align: middle;
        }
        
        .counter-autocall:hover,
        .counter-clicktocall:hover {
            text-decoration: none;
        }
        
        #flex-wrapper {
            overflow: hidden;
        }
        
        #flex-wrapper #flex-container {
            display: flex;
            overflow-x: scroll;
            width: 100%;
            -webkit-overflow-scrolling: touch;
        }
        
        #flex-wrapper #flex-container #flex-inside {
            background-color: #e9e8e8;
            display: flex;
            flex: 0 0 auto;
            border-radius: 5px;
        }
        
        #flex-wrapper #flex-container #flex-inside .flex-item {
            color: white;
            flex: 0 0 auto;
            margin: auto;
            width: auto;
            padding: 5px;
            font-size: 14px;
            font-weight: 700;
        }
        
        #flex-wrapper #flex-container #flex-inside .flex-item:first-of-type {
            margin-left: 5px;
        }
        
        #flex-wrapper #flex-container #flex-inside .flex-item:last-of-type {
            margin-right: 5px;
        }
        
        #selectMenu a {
            font-weight: 700;
        }
    </style>

    <style>
        /* The modal2 (background) */
        
        .modal2 {
            display: none;
            /* Hidden by default */
            position: absolute;
            z-index: 10000;
            /* Sit on top */
            left: 0;
            top: 0;
            width: 100%;
            /* Full width */
            height: 100%;
            /* Full height */
            overflow: auto;
            /* Enable scroll if needed */
            background-color: rgb(0, 0, 0);
            /* Fallback color */
            background-color: rgba(0, 0, 0, 0.4);
            /* Black w/ opacity */
        }
        /* modal2 Content/Box */
        
        .modal2-content {
            background-color: #fefefe;
            margin: 3% auto;
            /* 15% from the top and centered */
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
            /* Could be more or less, depending on screen size */
            height: 90%;
        }
        /* The modal3 (background) */
        
        .modal3 {
            display: none;
            /* Hidden by default */
            position: absolute;
            z-index: 10000;
            /* Sit on top */
            left: 0;
            top: 0;
            width: 100%;
            /* Full width */
            height: 100%;
            /* Full height */
            overflow: auto;
