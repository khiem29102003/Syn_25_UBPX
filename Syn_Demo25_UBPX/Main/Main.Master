													'<div class="data">' +
														'<p class="name"><button class="call-btn" data-line="' + encrypted + '">Gọi</button></p>' +
														'<p class="distance">' + /*kiemTraChuoi(item.dien_thoai, 1)*/ '</p>' +
													'</div>' +
												'</div>' +
											'</div>' +
										'</div>' +
									'</li>';
				}
			}
			
			
			if (rowSupport.length <= 0) {
				// Mã hóa số điện thoại
				var secretKey = 'vtechcore';
				var encrypted = CryptoJS.AES.encrypt("000000", secretKey).toString();
				rowSupport += 	'<li class="context-menu-row item_wrap nobody" data-manv="" data-line="' + encrypted + '">' +
