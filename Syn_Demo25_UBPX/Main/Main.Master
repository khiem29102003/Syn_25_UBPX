		// Function to convert input value to uppercase
		function convertToUpperCase(inputId) {
			var inputElement = document.getElementById(inputId);
			inputElement.value = inputElement.value.toUpperCase();
		}

		// Function to handle "Tab" key press
		function handleTabKeyPress(event, dataListId, number) {
			if (event.key === "Tab") {
				var inputElement = event.target;
				var dataList = document.getElementById(dataListId);

				// Convert input value to uppercase for case-insensitive comparison
				var inputValue = inputElement.value.toUpperCase();

				if (inputValue != "") {
					// Find the closest option in the datalist
					var closestOption = getClosestOption(inputValue, dataList.options);

					// If a closest option is found, set it as the input value
					if (closestOption) {
						inputElement.value = closestOption.value;	
						if (number == 2) {
							if (closestOption.value == "NKP" || closestOption.value == "NAB") {
								//document.getElementById("contactCode").value = "NOBODY";
							} else if (closestOption.value == "HUP") {
								//document.getElementById("contactCode").value = "OTHER";
							} else {
								//document.getElementById("contactCode").value = "";
							}
						}
					}
				}
			}

		}

		function getClosestOption(inputValue, options) {
			options = Array.from(options);

			// Convert input value to uppercase for case-insensitive comparison
			inputValue = inputValue.toUpperCase();

			// Filter options that start with the input value
			var startingWithOptions = options.filter(function(option) {
				return option.value.toUpperCase().startsWith(inputValue);
			});

			// Sort options by Levenshtein distance
			startingWithOptions.sort(function(a, b) {
				var distanceA = levenshteinDistance(inputValue, a.value.toUpperCase());
				var distanceB = levenshteinDistance(inputValue, b.value.toUpperCase());
				return distanceA - distanceB;
			});

			// Return the option with the smallest distance, or null if no match is found
			return startingWithOptions[0] || null;
		}


		// Function to calculate Levenshtein distance between two strings
		function levenshteinDistance(a, b) {
			if (a.length === 0) return b.length;
			if (b.length === 0) return a.length;

			var matrix = [];

			// Initialize matrix
			for (var i = 0; i <= b.length; i++) {
				matrix[i] = [i];
			}

			for (var j = 0; j <= a.length; j++) {
				matrix[0][j] = j;
			}

			// Compute matrix
			for (var i = 1; i <= b.length; i++) {
				for (var j = 1; j <= a.length; j++) {
					if (b.charAt(i - 1) === a.charAt(j - 1)) {
						matrix[i][j] = matrix[i - 1][j - 1];
					} else {
						matrix[i][j] = Math.min(
							matrix[i - 1][j - 1] + 1,
							matrix[i][j - 1] + 1,
							matrix[i - 1][j] + 1
						);
					}
				}
			}

			return matrix[b.length][a.length];
		}

		function formatCurrency(value, id) {
			// Xóa các dấu phẩy có thể đã được thêm vào trước đó
			value = value.replace(/,/g, '');

			// Chuyển đổi thành số thực
			let floatValue = parseFloat(value);

			// Kiểm tra nếu giá trị không phải là một số hợp lệ, không thực hiện định dạng
			if (isNaN(floatValue)) {
			return;
			}

			// Định dạng số thành dạng có dấu phẩy ngăn cách
			let formattedValue = floatValue.toString().replace(/(\d)(?=(\d\d\d)+(?!\d))/g, "$1,")

			// Gán giá trị định dạng vào input
			document.getElementById(id).value = formattedValue;
		}

