												console.log('Call failed:', data);
												
												var reasonCause, reasonQ, reasonPhrase, statusCode;

												// Kiểm tra xem có thông báo SIP không
												if (data.message) {
													var sipCause = data.cause;
													data_cause = data.cause;
													console.log('Cause:', sipCause);
												
												
													var sipMessage = data.message;
													reasonPhrase = sipMessage.reason_phrase;
													statusCode = sipMessage.status_code;
													//console.log('reason_phrase:', sipMessage.reason_phrase);
													//console.log('status_code:', sipMessage.status_code);
													
													
													// Kiểm tra xem có phần headers không
													if (sipMessage.headers && sipMessage.headers['Reason']) {
														var pReasonValue = sipMessage.headers['Reason'][0];
														reasonCause = extractCause(pReasonValue.raw);
														reasonQ = extractBeforeSemicolon(pReasonValue.raw);
														//console.log('Reason Cause: ', extractCause(pReasonValue.raw));
														//console.log('Reason Q:', extractBeforeSemicolon(pReasonValue.raw));
													} else {}									


													callErrorDetail = {
														reasonCause: (reasonCause == null ? "" : reasonCause),
														reasonQ: (reasonQ == null ? "" : reasonQ),
														reasonPhrase: (reasonPhrase == null ? "" : reasonPhrase),
														statusCode: (statusCode == null ? "" : statusCode),
														sipCause: (sipCause == null ? "" : sipCause)
													};
													callError.push(callErrorDetail);
												
													
													// Hàm để trích xuất giá trị cause từ chuỗi Q.850
													function extractCause(q850Message) {
														// Sử dụng biểu thức chính quy để tìm giá trị cause trong thông điệp Q.850
														const match = q850Message.match(/cause=(\d+)/);

														// Trả về giá trị cause nếu tìm thấy, ngược lại trả về null
														return match ? parseInt(match[1]) : null;
													}
													// Hàm để lấy phần trước dấu chấm phẩy (;) từ chuỗi Q.850
													function extractBeforeSemicolon(q850Message) {
														// Sử dụng split để chia chuỗi theo dấu chấm phẩy và lấy phần đầu tiên
														const parts = q850Message.split(';');
														
														// Trả về phần trước dấu chấm phẩy nếu có ít nhất một phần, ngược lại trả về null
														return parts.length > 0 ? parts[0] : null;
													}
												
												
													// Kiểm tra xem có phần headers không
													if (sipMessage.headers && sipMessage.headers['P-Asserted-Identity']) {
														var pAssertedIdentityValue = sipMessage.headers['P-Asserted-Identity'][0];
														//console.log('P-Asserted-Identity:', pAssertedIdentityValue.raw);
														
														// Chuỗi đầu vào
														var inputString = pAssertedIdentityValue.raw;

														// Sử dụng biểu thức chính quy để lấy phần số CID
														var match = inputString.match(/CID:(\d+)/);

														// Kiểm tra xem có phù hợp không
														if (match && match[1]) {
															var cidNumber = match[1];
															//console.log('CID Number:', cidNumber);
															data_outboundcid = cidNumber;
														} else {
															//console.log('CID Number not found in the input string');
															data_outboundcid = '';
														}

														// Xử lý giá trị P-Asserted-Identity ở đây
													} else if (sipMessage.headers && sipMessage.headers['Remote-Party-Id']) {
														var pAssertedIdentityValue = sipMessage.headers['Remote-Party-Id'][0];
														//console.log('P-Asserted-Identity:', pAssertedIdentityValue.raw);
														
														// Chuỗi đầu vào
														var inputString = pAssertedIdentityValue.raw;

														// Sử dụng biểu thức chính quy để lấy phần số CID
														var match = inputString.match(/CID:(\d+)/);

														// Kiểm tra xem có phù hợp không
														if (match && match[1]) {
															var cidNumber = match[1];
															//console.log('CID Number:', cidNumber);
															data_outboundcid = cidNumber;
														} else {
															//console.log('CID Number not found in the input string');
															data_outboundcid = '';
														}
													} else {
														//console.log('P-Asserted-Identity not present in headers');
													}
															
													//console.log(data_outboundcid);													
													
													if (data_outboundcid != "" && data_outboundcid != null && data_outboundcid != undefined) {
														var m = new Memvars();
														var controller = "loaddulieutable";
														var p = window.location.href.toString();
														p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData"; //GetValue
																
														m.val("query", 'C', "select * from dmkh where ma_kh in ('" + data_outboundcid + "')");			
														
														$.ajax({
															type: "POST",
															url: p,
															header: '',
															data: JSON.stringify({ controller: controller, oMemvar: m.val() }),
															contentType: "application/json; charset=utf-8",
															dataType: "json",
															timeout: 30000,
															success: function (msg, s) {
																var data = msg.d[0];
																//console.log(data); 
																if (data != undefined) {																														
																	document.getElementById("currentChannel").innerHTML = "Kênh gọi: " + data.ten_kh;
																	data_record = "";
																	displayCallHistory("LOGLSCG", data.ten_kh);
																} else {
																	document.getElementById("currentChannel").innerHTML = "Kênh gọi: LOCAL";
																	data_record = "";
																	displayCallHistory("LOGLSCG", "LOCAL");
																}																
															},
															error: function (event) {
																data_record = "";
																displayCallHistory("LOGLSCG", "");
															}
														});
													} else {
														data_record = "";
														displayCallHistory("LOGLSCG", "");
													}
												} else {
													var sipCause = data.cause;
													data_cause = data.cause;
													//console.log('No SIP message in the failed event');
													callErrorDetail = {
														reasonCause: (reasonCause == null ? "" : reasonCause),
														reasonQ: (reasonQ == null ? "" : reasonQ),
														reasonPhrase: (reasonPhrase == null ? "" : reasonPhrase),
														statusCode: (statusCode == null ? "" : statusCode),
														sipCause: (sipCause == null ? "" : sipCause)
													};
													callError.push(callErrorDetail);
													data_record = "";
													displayCallHistory("LOGLSCG", "");
												}

											
												session = null;
												updateUI();
												window.parent.postMessage({eventType: "callEnded", data: additionalData}, "*");
											} catch (error) {
												console.error(error);
											}
										}
										fetchEndTime();																		
									}

									session.on('ended', endedSession);
									session.on('failed', failedSession);
									session.on('accepted', startedSession);
									session.on('confirmed', function () {
										var localStream = session.connection.getLocalStreams()[0];
										var dtmfSender = session.connection.createDTMFSender(localStream.getAudioTracks()[0])
										session.sendDTMF = function (tone) {
											dtmfSender.insertDTMF(tone);
										};

                                        var hasVideo = session.connection.getReceivers().some(function (receiver) {
                                            return receiver.track && receiver.track.kind === 'video';
                                        });

										if (hasVideo) {
                                            // Xử lý việc hiển thị remote video
                                            session.connection.getReceivers().forEach(function (receiver) {
                                                if (receiver.track && receiver.track.kind === 'video') {
                                                    var remoteStream = new MediaStream([receiver.track]);
                                                    var remoteVideoElement = document.getElementById('remoteVideo');
                                                    remoteVideoElement.srcObject = remoteStream;
                                                }
                                            });
											document.getElementById('videoSection').style.display = 'block';
                                        } else {
                                            document.getElementById('videoSection').style.display = 'none';
                                        }
										
                                        
										updateUI();
										
										console.log(session);
										
									});

									session.on('peerconnection', (e) => {
										//console.log('peerconnection', e);
										let logError = '';
										const peerconnection = e.peerconnection;

										peerconnection.onaddstream = function (e) {
											//console.log('addstream', e);
											// set remote audio stream (to listen to remote audio)
											// remoteAudio is <audio> element on pag
											remoteAudio.srcObject = e.stream;
											remoteAudio.play();
										};

										var remoteStream = new MediaStream();
										//console.log(peerconnection.getReceivers());
										peerconnection.getReceivers().forEach(function (receiver) {
											//console.log(receiver);
											remoteStream.addTrack(receiver.track);
										});
									});

									if (session.direction === 'incoming') {
										var newAudioFile = '/Images/video/' + randomMusic();
										// Đặt lại nguồn âm thanh mới
										incomingCallAudio.setAttribute('src', newAudioFile);

										// Bắt đầu phát âm thanh mới từ đầu
										incomingCallAudio.load(); // Cần load lại tệp âm thanh
										incomingCallAudio.currentTime = 0;
										incomingCallAudio.play();
									} else {
										//console.log('con', session.connection)
										session.connection.addEventListener('addstream', function (e) {
											incomingCallAudio.pause();
											remoteAudio.srcObject = e.stream;
										});
									}
									updateUI();
								} catch (error) {
									console.error(error);
								}
							}							
						});
						phone.start();
					}				
					
					function formatDateToCustomFormat(date) {
						// Kiểm tra xem date có phải là một đối tượng Date không
						if (!(date instanceof Date)) {
							// Nếu không phải, tạo một đối tượng Date mới từ giá trị của date
							date = new Date(date);
						}

						// Lấy năm, tháng, ngày, giờ, phút, giây và mili-giây
						var year = date.getFullYear();
						var month = String(date.getMonth() + 1).padStart(2, '0');
						var day = String(date.getDate()).padStart(2, '0');
						var hours = String(date.getHours()).padStart(2, '0');
						var minutes = String(date.getMinutes()).padStart(2, '0');
						var seconds = String(date.getSeconds()).padStart(2, '0');
						var milliseconds = String(date.getMilliseconds()).padStart(3, '0');

						// Tạo chuỗi định dạng
						var formattedDate = year + month + day + hours + minutes + seconds + milliseconds;

						return formattedDate;
					}


					const requestEndCall = function(nv, type) {
						return new Promise((resolve, reject) => {
							var m = new Memvars();
							var controller = "loaddulieutable";
							var p = window.location.href.toString();
							p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData"; //GetValue

							var query = `
							exec [ISWIFT_CLICKTOCALL] '${nv}', ${type}			
							`;
							m.val("query", 'C', query);

							$.ajax({
								type: "POST",
								url: p,
								header: '',
								data: JSON.stringify({
									controller: controller,
									oMemvar: m.val()
								}),
								contentType: "application/json; charset=utf-8",
								dataType: "json",
								timeout: 30000,
								success: function(msg, s) {
									//console.log($.userinfo.val("language"));                    
									if (msg.d.length > 0) {
										const data = msg.d[0].value;
										resolve(data);
									} else {
										resolve("");
									}
								},
								error: function(e) {
									console.log(e);
								}
							});
						});
					}


					// Hàm hiển thị lịch sử cuộc gọi
					function displayCallHistory(action, channel) {
						callHistoryBackup = callHistory;
						callHistory.forEach(function(callInfo, index) {
							xuLyPhanTuLscg(callInfo, index, action, callError, channel);
						});
					}
							
					let seconds = -1;
					let minutes = 0;
					let hours = 0;
					let timerInterval;
					
					function xuLyPhanTuLscg(item, index, action, error, channel) {
						var m = new Memvars();
						var p = window.location.href.toString();
						p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData";//GetValue
						var controller = 'st_InsertLSCG';

						data_uniqueid = Date.now() / 1000; // Chia cho 1000 để chuyển từ mili giây thành giây
						var data_statuscode = "";
						
						//@app_id, @calldate, @uniqueid, @accountcode, @dst, @ma_bp, @ma_pb , @ma_donvi, @duration, @billsec, @disposition, @datetime0, @datetime2, @hangup, @src
						m.val('app_id', 'C', item.appId);
						m.val('calldate', 'C', item.callDate);
						m.val('uniqueid', 'C', data_uniqueid);
						m.val('accountcode', 'C', data_manv);
						m.val('dst', 'C', item.callee);
						m.val('ma_bp', 'C', data_mabp);
						m.val('ma_pb', 'C', data_mapb);
						m.val('ma_donvi', 'C', data_madv);
						m.val('duration', 'C', item.duration);
						m.val('billsec', 'C', item.billsec);
						m.val('disposition', 'C', item.status);
						m.val('datetime0', 'C', FormatDates(item.startTime));
						m.val('datetime2', 'C', FormatDates(item.endTime ? item.endTime : "N/A"));
						m.val('hangup', 'C', (item.hangup == undefined ? "" : item.hangup));
						m.val('src', 'C', item.caller);
						m.val('outbound_cid', 'C', data_outboundcid);
						m.val('recordingfile', 'C', data_record);
						
						if (action == "LOGLSCG") {
							error.forEach(function (callError, index) {
								m.val('reason_cause', 'C', callError.reasonCause);
								m.val('reasonQ', 'C', callError.reasonQ);
								m.val('status_code', 'C', callError.statusCode);
								m.val('reason_phrase', 'C', callError.reasonPhrase);
								m.val('sip_cause', 'C', callError.sipCause);
								data_statuscode = (callError.statusCode != "" ? (callError.statusCode == "503" ? "Tràn kênh" : "") : callError.statusCode);
							});	
						} else {
							m.val('reason_cause', 'C', '');
							m.val('reasonQ', 'C', '');
							m.val('status_code', 'C', '');
							m.val('reason_phrase', 'C', '');
							m.val('sip_cause', 'C', '');
						}
						
						m.val('action', 'C', action);						
						
						if (channel != null && channel != "" && channel != undefined) {
							document.getElementById("txtError").innerHTML =  (data_statuscode != "" ? ("TT: " + item.status + " (" + data_statuscode + ") - KÊNH: " + channel) : ("TT: " + item.status + " - KÊNH: " + channel));
						} else {
							document.getElementById("txtError").innerHTML = "TT: " + item.status;
						}
						
						document.getElementById("callFromToArea").innerHTML = "Gọi từ " + item.caller + " đến " +  item.callee + ", Time: " + item.callDate;
						document.getElementById("callFromToArea").setAttribute("data-copy", "Gọi từ " + item.caller + " đến " +  item.callee + " - Time call: " + item.callDate + " - Trạng thái: " + item.status + " - Kênh gọi: " + (channel == "" ? "chưa kết nối" : channel));		
						
						//Câu lệnh sql
						//var query = "INSERT INTO lscuocgoi (app_id, calldate, src, dst, disposition, billsec, duration, accountcode, datetime0, datetime2, uniqueid, ma_bp, ma_pb, ma_donvi, hangup, referenceId) SELECT '" + item.appId + "', '" + item.callDate + "', '" + item.caller + "', '" + item.callee + "', '" + item.status + "', '" + item.billsec + "', '" + item.duration + "', '" + manv + "', '" + datetime0 + "', '" + FormatDates(item.endTime ? item.endTime : "N/A") + "', '" + uniqueId + "', '" + mabp + "', '" + mapb + "', '" + madv + "', '" + (item.hangup == undefined ? "" : item.hangup) + "', '" + referenceid + "';";
						
						var xstatus = item.status;
						
						//localStorage.setItem('referenceId', '');
						data_duration = item.duration;
						data_billsec = item.billsec;
						data_disposition = item.status;
						data_datetime0 = FormatDates(item.startTime);
						data_datetime2 = FormatDates(item.endTime ? item.endTime : "N/A");
						data_hangup = (item.hangup == undefined ? "" : item.hangup);
						//localStorage.setItem('recordingfile', '');
						data_src = item.caller;

						if (item.status === "ANS") {
							$.ajax({
								type: "POST",
								url: p,
								header: '',
								data: JSON.stringify({
									controller: controller,
									oMemvar: m.val()
								}),
								contentType: "application/json; charset=utf-8",
								dataType: "json",
								timeout: 30000,
								success: function(msg, s) {
									// ket qua o day
									console.log("Thêm LSCG " + item.appId);																	
									seconds = -1;
									minutes = 0;
									hours = 0;
									clearTimeout(timerInterval);
									callHistory = [];
									callError = []
								},
								error: function(e) {
									// loi o day
									console.log(e);
									seconds = -1;
									minutes = 0;
									hours = 0;
									clearTimeout(timerInterval);
									callHistory = [];
									callError = []
								}
							});
						} else {
							seconds = -1;
							minutes = 0;
							hours = 0;
							clearTimeout(timerInterval);
							callHistory = [];
							callError = []
							callHistoryBackup = [];
						}
					}

					// Hàm tính thời gian cuộc gọi
					function calculateCallDuration(callInfo) {
						if (callInfo.startTime && callInfo.endTime) {
							var startTime = new Date(callInfo.startTime);
							var endTime = new Date(callInfo.endTime);
							var duration = endTime - startTime; // Khoảng thời gian tính bằng mili giây
							var seconds = Math.floor(duration / 1000); // Chuyển đổi sang giây
							var minutes = Math.floor(seconds / 60); // Tính số phút
							seconds = seconds % 60; // Tính số giây còn lại
							return minutes + " phút " + seconds + " giây";
						} else {
							return "0";
						}
					}
					
					
					function updateCallTime() {
						seconds++;
						if (seconds === 60) {
							seconds = 0;
							minutes++;
						}
						if (minutes === 60) {
							minutes = 0;
							hours++;
						}
						const timeString = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
						const callTimeElement = document.getElementById('currentTime');
						callTimeElement.innerHTML = timeString;
					}

					function startOrStopTimer() {
						const inCallButtons = document.getElementById('inCallButtons');
						if (inCallButtons.style.display === 'block') {
							if (!timerInterval) {
								updateCallTime();
								// Bắt đầu đếm khi chuyển thành "block" nếu timerInterval chưa tồn tại
								timerInterval = setInterval(updateCallTime, 1000); // Cập nhật thời gian mỗi giây
							}
						} else {
							// Dừng đếm khi chuyển về "none"
							clearInterval(timerInterval);
							timerInterval = null; // Đặt lại timerInterval thành null để đảm bảo không bắt đầu lại ngay lập tức
						}
					}

					// Hàm để bắt đầu cuộc gọi và bộ đếm thời gian
					function startCall() {
						const inCallButtons = document.getElementById('inCallButtons');
						inCallButtons.style.display = 'block'; // Hiển thị nút dừng cuộc gọi
						startOrStopTimer(); // Bắt đầu đếm thời gian
					}

					
					updateUI();
					var hangup = function () {
						session.terminate();
						//hangupAudio();						
					};
					
					var hanguplocal = function () {
						session.terminate();
						data_flagstatus = 'false';
					};

					function hangupAudio() {
						hangupCallAudio.play();
						setTimeout(function() {
							hangupCallAudio.pause();
						}, 2000);
						// Giảm âm lượng
						//hangupCallAudio.volume = 0.5; // Giả sử giảm âm lượng xuống 50%
					}
					
					
					function busyAudio() {
						busyCallAudio.play();
						setTimeout(function() {
							busyCallAudio.pause();
						}, 3000);
						// Giảm âm lượng
						//hangupCallAudio.volume = 0.5; // Giả sử giảm âm lượng xuống 50%
					}


					function updateUI() {
						if (configuration.uri && configuration.password || true) {						
							$('#errorMessage').hide();
							$('#wrapper').show();
							if (session) {
								if (session.isInProgress()) {
									if (session.direction === 'incoming') {
                                        //Check có yêu cầu video hay không
                                        const request = session._request;
                                        if (request && request.body) {
                                            const sdp = request.body;
											const videoPresent = /a=mid:video-1/.test(sdp);
											if (videoPresent && hasDeviceCamera)
												isThisVideo = true;
											else
												isThisVideo = false;
											if (!hasDeviceCamera && videoPresent)
												$.showToast("Thiết bị của bạn không có Camera");
                                        } else {
                                            console.error('Request body is undefined');
										}
										console.log(session);
										$('#incomingCallNumber').html(session.remote_identity.uri.user);
										$('#incomingCall').show();
										$('#callControl').hide()
										$('#incomingCall').show();
										console.log("incoming");
									} else {
										$('#callInfoText').html('Đang kết nối ...');
										setTimeout(function() {
											$('#callInfoText').html('Đang đổ chuông ...');
										}, 2000);
										$('#callInfoNumber').html(session.remote_identity.uri.user);
										$('#callStatus').show();
									}

								} else if (session.isEstablished()) {
									$('#callStatus').show();
									$('#incomingCall').hide();
									$('#callInfoText').html('Đang nghe máy ...');
									$('#callInfoNumber').html(session.remote_identity.uri.user);
									$('#inCallButtons').show();
									inCallButtons.style.display = "block";
									// Kiểm tra trạng thái mỗi giây
									startOrStopTimer();
									setInterval(startOrStopTimer, 1000);
									incomingCallAudio.pause();
								}
								$('#callControl').hide();
							} else {
								$('#incomingCall').hide();
								$('#callControl').show();
								$('#callStatus').hide();
								$('#inCallButtons').hide();
								incomingCallAudio.pause();								
							}
							//microphone mute icon
							if (session && session.isMuted().audio) {
								$('#muteIcon').addClass('fa-microphone-slash');
								$('#muteIcon').removeClass('fa-microphone');
							} else {
								$('#muteIcon').removeClass('fa-microphone-slash');
								$('#muteIcon').addClass('fa-microphone');
							}
						} else {
							$('#wrapper').hide();
							$('#errorMessage').show();
						}
					}

					setTimeout(function() {
						$('#connectCall').click(function () {
							//var dest = $('#toField').val();
							phone.call(phone, callOptions);
							updateUI();
						});


						$('#answer').click(function () {
							session.answer({
                                mediaConstraints: { audio: true, video: isThisVideo }
                            });
							data_flagstatus = 'false';
						});


						$('#hangUp').click(hangup);
						$('#reject').click(hanguplocal);


						$('#mute').click(function () {
							//console.log('MUTE CLICKED');
							if (session.isMuted().audio) {
								session.unmute({ audio: true });
								$('#muteIcon').attr("src", '/Images/Icon/mic.png');
							} else {
								session.mute({ audio: true });
								$('#muteIcon').attr("src", '/Images/Icon/mute.png');
							}
							updateUI();
						});
						$('#toField').keypress(function (e) {
							if (e.which === 13) {//enter
								$('#connectCall').click();
							}
						});
						$('#inCallButtons').on('click', '.dialpad-char', function (e) {
							var $target = $(e.target);
							var value = $target.data('value');
							session.sendDTMF(value.toString());
						});
					}, 100);
				},
				error: function (e) {
					// loi o day
					console.log(e);
				}
			});
		}
		
		function unRegister() {
			// Hủy đăng ký
			var options = {
				all: true
			};

			ua.unregister(options);
			phone.unregister(options);
			console.log("Hủy đăng ký ua và phone thành công");
		}
		
		var valueTest = '';
		function ExcecCall(sdt, isvideo) {
            if (isvideo && hasDeviceCamera) {
                document.getElementById('videoSection').style.display = 'block';
				isVideoOutGoing = true;
			}
			else {
                document.getElementById('videoSection').style.display = 'none';
				isVideoOutGoing = false;
			}
			if (!hasDeviceCamera)
				$.showToast("Thiết bị không có camera");
			var callOptions = {
				mediaConstraints: { audio: true, video: isVideoOutGoing }
			};
			phone.call(sdt, callOptions);
			
			//firstedTime = new Date();
			//firstedTime = await getSystemDate('yyyy/MM/dd HH:mm:ss.FFF');
			// Hàm gọi bất đồng bộ
			async function fetchData() {
				try {
					firstedTime = await getSystemDate('yyyy/MM/dd HH:mm:ss.FFF');
					//console.log(firstedTime);		
				} catch (error) {
					console.error(error);
				}
			}

			// Gọi hàm fetchData
			fetchData();

			//setTimeout(function(){ console.log(firstedTime); if (valueTest == '') {  } }, 100);
		}
        async function hasCamera() {
            try {
                // Lấy danh sách các thiết bị media
                const devices = await navigator.mediaDevices.enumerateDevices();

                // Kiểm tra xem có thiết bị camera nào không
                return devices.some(device => device.kind === 'videoinput');
            } catch (error) {
                console.error('Lỗi khi kiểm tra thiết bị:', error);
                return false; // Nếu có lỗi xảy ra, giả định rằng thiết bị không có camera
            }
        }
		var hasDeviceCamera;
        // Ví dụ sử dụng hàm
        hasCamera().then(cameraAvailable => {
            if (cameraAvailable) {
				hasDeviceCamera = true;
            } else {
				hasDeviceCamera = false;
            }
        });


		function openModals() {
			document.getElementById('modal_form').style.display = 'block';
		}
		function closeModals() {
			document.getElementById('modal_form').style.display = 'none';
			
			// Kiểm tra xem có phần tử nào có class "btn-close-form" không
			var elements = document.getElementsByClassName("btn-close-form");

			if (elements.length > 0) {
				//console.log("Có class 'btn-close-form' trong tài liệu.");
				var button = document.querySelector(".btn-close-form");
				 // Kiểm tra nếu button đã có thuộc tính disabled
				if (button.hasAttribute('disabled')) {
					// Gỡ bỏ thuộc tính disabled
					button.removeAttribute('disabled');
					//console.log('Button is enabled now.');
				}
			} else {
				//console.log("Không có class 'btn-close-form' trong tài liệu.");
			}		
		}		
		window.addEventListener("message", function(event) {
			if (event.data === "callStarted") {
				openModals();
				document.getElementById('formCall').style.display = 'block';
				document.getElementById('errorContainer').style.display = 'none';
				document.getElementById('dataContainer').style.display = 'none';
				document.getElementById('formCall').style.height = '178px';
				//console.log("1");			
			}
			if (event.data.eventType === "callEnded") {		
				// Truy cập dữ liệu bên trong thông báo
				var additionalData = event.data.data;
				var flag = data_flagstatus;

				// Hiển thị thông báo từ cửa sổ con
				//console.log("Call ended. Child says:", additionalData.message);
				//console.log("Call ended. flag:", flag);		
				
				if (flag == 'false' && data_cause != "User Denied Media Access") {
					closeModals();				
					//console.log("2");				
				} else if (flag == 'false' && data_cause == "User Denied Media Access") {
					if (additionalData.message === "ANS" || additionalData.message === "NANS") {
						document.getElementById('formCall').style.display = 'none';
						document.getElementById('dataContainer').style.display = 'block';
						document.getElementById('errorContainer').style.display = 'none';
						document.getElementById('formCall').style.height = '178px';				
