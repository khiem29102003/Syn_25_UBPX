		function checkInputValue(input, datalist, number) {
			if (number == 1) {
				var inputValue = document.getElementById(input).value;
				var datalistOptions = document.getElementById(datalist).options;
				
				if (inputValue == "") {
					removeAllHighlightClass();
				}

				if (inputValue != "") {
					// Kiểm tra xem giá trị nhập vào có trong danh sách datalist hay không
					var isValid = Array.from(datalistOptions).some(function(option) {
						return option.value === inputValue;
					});
					// Hiển thị thông báo lỗi nếu giá trị không hợp lệ
					//var errorText = document.getElementById('errorModeCodes');
					if (!isValid) {
						//errorText.textContent = 'Mã không hợp lệ!';
						removeAllHighlightClass();
						addHighlightClass(input);
						$.showToast('Mã chế độ liên lạc sai.');
						document.getElementById(input).focus();
						return false;
					} else {
						//errorText.textContent = ''; // Xóa thông báo lỗi nếu giá trị hợp lệ
						return true;
					}
				} else {
					return true;
				}
			}
			else if (number == 2) {
				var inputValue = document.getElementById(input).value;
				var datalistOptions = document.getElementById(datalist).options;

				// Kiểm tra xem giá trị nhập vào có trong danh sách datalist hay không
				var isValid = Array.from(datalistOptions).some(function(option) {
					return option.value === inputValue;
				});
				
				if (inputValue == "") {
					removeAllHighlightClass();
				}

				// Hiển thị thông báo lỗi nếu giá trị không hợp lệ
				if (!isValid) {
					removeAllHighlightClass();
					addHighlightClass(input);
					$.showToast('Mã cuộc gọi sai.');
					document.getElementById(input).focus();
					return false;
				} else {
					return true;
				}
			}
			else {
				var inputValue = document.getElementById(input).value;
				var datalistOptions = document.getElementById(datalist).options;

				// Kiểm tra xem giá trị nhập vào có trong danh sách datalist hay không
				var isValid = Array.from(datalistOptions).some(function(option) {
					return option.value === inputValue;
				});
				
				if (inputValue == "") {
					removeAllHighlightClass();
				}

				// Hiển thị thông báo lỗi nếu giá trị không hợp lệ
				if (!isValid) {
					removeAllHighlightClass();
					addHighlightClass(input);
					$.showToast('Mã người liên lạc sai.');
					document.getElementById(input).focus();
					return false;
				} else {
					return true;
				}
			}
		}


