						ExcecCall(selectedRow.getAttribute("data-line"));
					} else {
						$.showToast('Không hỗ trợ');
					}
				} else if (index == 2) {
					//console.log(`${option} cho dòng có data-line=${selectedRow.getAttribute("data-line")}`);
				} else {
					//console.log(`${option} cho dòng có data-line=${selectedRow.getAttribute("data-line")}, data-manv=${selectedRow.getAttribute("data-manv")}`);
				}
			}
			hideContextMenu();
		}


		function showContextMenu(x, y, dataManv) {
			hideContextMenu();
			contextMenu.style.display = "block";
			contextMenu.style.left = x + "px";
			contextMenu.style.top = y + "px";
			
			// Thêm lớp "selected" cho dòng được chuột phải vào
			const selectedRow = document.querySelector(".selected");
			if (selectedRow) {
				selectedRow.classList.remove("selected");
			}
			const clickedRow = document.querySelector(`[data-manv="${dataManv}"]`);
			if (clickedRow) {
				clickedRow.classList.add("selected");
			}
		}

		function hideContextMenu() {
			contextMenu.style.display = "none";
		}	


		function startTimeout() {
			timeoutId = setTimeout(function() {
				loadListUser();
				startCountdown();
			}, 60000); // 60 seconds
		}
		function stopTimeout() {
			if (timeoutId) {
				clearTimeout(timeoutId);
			}
		}


		function countdown() {
			countdownElement.textContent = seconds;
			seconds--;
			if (seconds < 0) {
				clearInterval(intervalId);
				stopTimeout();
				loadListUser();
			}
		}

		function startCountdown() {
			// Kiểm tra xem có interval nào đang chạy không
			if (intervalId) {
				clearInterval(intervalId); // Nếu có, xóa nó
			}
			// Đặt lại giá trị của biến đếm và bắt đầu lại quá trình đếm ngược
			seconds = 60;
			intervalId = setInterval(countdown, 1000);
		}


		function loadListUser() {
			// Hiển thị màn hình chờ
			document.getElementById("loading-screen").style.display = "block";		
			loadContent();	
			// Gọi hàm startCountdown để bắt đầu đếm ngược khi trang web được tải lần đầu
			startCountdown();
			
			
			// Bắt đầu một setTimeout
			startTimeout();
		}


		function loadDataTable(controll, mVal, arr) {
			var m = new Memvars();
			var controller = controll;
			var p = window.location.href.toString();
			p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData"; //GetValue
					
			m.val('query', 'C', mVal);			
			
			$.ajax({
				type: "POST",
				url: p,
				header: '',
				data: JSON.stringify({ controller: controller, oMemvar: m.val() }),
				contentType: "application/json; charset=utf-8",
				dataType: "json",
				timeout: 30000,
				success: function (msg, s) {
					var data = msg.d;
					Array.prototype.push.apply(arr, data);
					return arr;
				}
			});
		}


		function loadDataOnOff(controll, madv, mapb, mabp, manv, useron, ion, arr) {
			var m = new Memvars();
			var controller = controll;
			var p = window.location.href.toString();
			p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData"; //GetValue
					
			m.val('ma_dv', 'C', madv);			
			m.val('ma_pb', 'C', mapb);			
			m.val('ma_bp', 'C', mabp);			
			m.val('ma_nv', 'C', manv);			
			m.val('useron', 'C', useron);			
			m.val('ion', 'I', ion);			
			
			$.ajax({
				type: "POST",
				url: p,
				header: '',
				data: JSON.stringify({ controller: controller, oMemvar: m.val() }),
				contentType: "application/json; charset=utf-8",
				dataType: "json",
				timeout: 30000,
				success: function (msg, s) {
					var data = msg.d;
					Array.prototype.push.apply(arr, data);
					return arr;
				}
			});
		}


