		function kiemTraChuoi(chuoi, bool) {
			// Kiểm tra nếu chuỗi không tồn tại hoặc là null hoặc rỗng
			if (!chuoi || chuoi === '') {
				if (bool == 1) {
					return "Cập nhật";
				} else if (bool == 2) {
					return "";
				} else {
					return "000000";
				}
			} else {
				return chuoi.replace(/\s/g, '');
			}
		}


		function btnCallClick(support, staff) {
			// Lấy danh sách tất cả các nút trong phần tử có thẻ ul
			var buttons1 = document.querySelectorAll(support + ' .call-btn');
			var buttons2 = document.querySelectorAll(staff + ' .call-btn');

			// Gỡ bỏ sự kiện click cũ trước khi thêm mới
			buttons1.forEach((button) => {
				button.removeEventListener("click", handleButtonClick);
			});

			buttons2.forEach((button) => {
				button.removeEventListener("click", handleButtonClick);
			});

			// Thêm sự kiện click mới
			buttons1.forEach((button) => {
				button.addEventListener("click", handleButtonClick);
			});

			buttons2.forEach((button) => {
				button.addEventListener("click", handleButtonClick);
			});
		}


