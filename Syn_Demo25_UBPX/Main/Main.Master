												'</div>' +
											'</div>' +
											'<div class="flex-item">' +
												'<div class="data">' +
													'<p class="name"></p>' +
													'<p class="distance"></p>' +
												'</div>' +
											'</div>' +
											'<div class="flex-item">' +											
												'<div class="item_right flex-item">' +
													'<div class="data">' +
														'<p class="name"></p>' +
														'<p class="distance status"></p>' +
													'</div>' +
												'</div>' +
											'</div>' +
										'</div>' +
									'</li>';	
			}

			if (rowStaff.length <= 0) {
				// Mã hóa số điện thoại
