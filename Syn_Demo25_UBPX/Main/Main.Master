		#videoSection {
			margin-top: 10px;
			display: block;
			position: fixed;
			top: 100%;
			width: 200%;
		}

		#videoSection video {
			height: auto;
			border: 1px solid #ccc;
			border-radius: 5px;
		}
		
		#localVideo {
			position: absolute;
