    <!--Map-->
    <h3 class="title">Seaport Map </h3>
    <div class=" contact-top">
        <section id="portfolio" class="portfolio">
                <div id="Map"></div>
                <style>
		            #Map {
			            width:100%!important; height: 80vh;
		            }
        
                </style>
                <script type="text/javascript">

                    $(document).ready(function () {

                        var m = new Memvars();

                        var controller = 'PT';

                        var p = window.location.href.toString();
                        p = p.substring(0, p.indexOf("Main/")) + 'AppService/EService.asmx/' + "GetData";//GetValue
                        //Goi Map
                        var mapObj = null;
                        var defaultCoord = [10.882914225174689, 106.65449135343488]; // coord mặc định, HCM
                        var zoomLevel = 14; // Mức phóng to bản đồ
                        var mapConfig = {
                            attributionControl: false, // để ko hiện watermark nữa, nếu bị liên hệ đòi thì nhớ open nha
                            center: defaultCoord, // vị trí map mặc định hiện tại
                            zoom: zoomLevel,
                            zoomControl: false,
                        };

                        mapObj = L.map('Map', mapConfig);

                        // xài free từ OpenStreetMap
                        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                        }).addTo(mapObj);
                        L.control.zoom({
                            position: 'bottomright'
                        }).addTo(mapObj);

                        $.ajax({
                            type: "POST",
                            url: p,
                            header: '',

                            data: JSON.stringify({ controller: controller, oMemvar: m.val() }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            timeout: 30000,
                            success: function (data) {
                                //Convert từ dạng json sang Geojson
                                var geoJsonData = [];
                                for (var i = 0; i < data.d.length; i++) {
                                    geoJsonData.push(
                                        {
                                            "type": "Feature",
                                            "geometry": {
                                                "type": "Point",
                                                "coordinates": [data.d[i].tdy, data.d[i].tdx]
                                            },
                                            "properties": {
                                                "id": data.d[i].ma_kho,
                                                "name": data.d[i].ten_kho,
                                                "maqg": data.d[i].ma_qg,
                                                "tdx": data.d[i].tdx,
                                                "tdy": data.d[i].tdy,
                                            }
                                        }
                                    );

                                }
                                //Make icon marker
                                const basicPortIcon = L.icon({
                                    iconUrl: '../Images/marker-icon-grey (1).png',
                                    iconSize: [20, 30],
                                });
                                const basicSearchIcon = L.icon({
                                    iconUrl: '../Images/marker-icon-2x-red.png',
                                    iconSize: [25, 35],
                                });
                                //Create marker
                                const lightData = L.geoJSON(geoJsonData, {
                                    onEachFeature: function (feature, layer) {
                                        let coord = feature.geometry.coordinates;
                                        const popupContent =
                                            "<b style='color:red;font-size:18px'>" + feature.properties.name + "</b>" + "<br>" +
                                            "<div style='font-size:18px'>" +
                                            "<b>Tọa độ :</b>" + feature.properties.tdx + "," + feature.properties.tdy + "<br>" +
                                            "<b>Mã cảng :</b>" + feature.properties.id + "<br>" +
                                            "<b>Mã quốc gia:</b>" + feature.properties.maqg + "<br>" +
                                            "<button class='btn btn-info gpsphat' data-lat='" + coord[1] + "' data-lng='" + coord[0] + "'>Chỉ đường</button>" +
                                            "</div>"
                                        layer.bindPopup(popupContent);
                                    },
                                    pointToLayer: function (feature, latlng) {
                                        return L.marker(latlng, { icon: basicPortIcon });
                                    },
                                });
                                const markers = L.markerClusterGroup().addLayer(lightData);
                                // marker cluster
                                mapObj.addLayer(markers);
                                var searchMarker = null;
                                //Search Map
                                var searchControl = L.control.search({
                                    textPlaceholder: 'Nhập cảng muốn tìm...',
                                    textErr: 'Không tìm thấy',
                                    layer: markers,
                                    propertyName: 'name',
                                    zoom: 16,
                                    initial: false,
                                    autoCollapse: false,
                                    collapsed: false,
                                    autoType: false,
                                    position: 'topleft',
                                    marker: false,
                                    moveToLocation: function (latlng, title, map) {
                                        map.setView(latlng, 17); // access the zoom
                                        console.log(latlng);
                                        searchMarker = L.marker(latlng, { icon: basicSearchIcon, circle: false }).addTo(map).openPopup();
                                    },
                                });
                                //Xu ly su kien search
                                searchControl.on('search:locationfound', function (e) {
                                    if (e.layer._popup)
                                        e.layer.openPopup();
                                }),
                                    searchControl.on('search:cancel', function (e) {
                                        if (searchMarker && mapObj.hasLayer(searchMarker)) {
                                            searchMarker.removeFrom(mapObj);
                                            return;
                                        }
                                        if (e.layer._popup)
                                            e.layer.closePopup();
                                });
                                mapObj.addControl(searchControl);
                                var lc = L.control.locate({
                                    position: 'topright',
                                    strings: {
                                        title: "Show me where I am, yo!"
                                    }
                                }).addTo(mapObj);
                                //lc.start();
                                //Xu Ly Button
                                $(document).on("click", ".gpsphat", function () {
                                    let latLng = [$(this).data('lat'), $(this).data('lng')];
                                    control.spliceWaypoints(control.getWaypoints().length - 1, 1, latLng);
                                })
                            },
                            error: function (e) {
                                // loi o day
                                console.log(e);
                            }
                        });
                    });
                    function Memvars(a) {
                        this.obj = []; //{ Name: [0], DataType: [1], Value: [2], Extend: [3] }
                        this.add(a);
                    }
                    Memvars.prototype = {
                        val: function (n, t, v, e) {
                            if ($.type(n) == 'undefined') return this.obj;
                            var i = this.index(n);
                            if ($.type(v) == 'undefined') {
                                if (i != -1)
                                    return this.obj[i].Value
                                else
                                    return null
                            }
                            else {
                                if ($.type(e) == 'undefined') e = null;
                                if (t == "D" && v != null) v = $.date(v, "yymmdd");
                                if (i != -1)
                                    this.obj[i] = { Name: n, DataType: t, Value: v, Extend: e }
                                else
                                    this.obj.push({ Name: n, DataType: t, Value: v, Extend: e })
                                return this;
                            }
                            return 1;
                        },
                        index: function (n) {
                            for (var i = 0; i < this.obj.length; i++) {
                                if (this.obj[i].Name == n) return i;
                            }
                            return -1;
                        },
                        get: function (n) {
                            var i = this.index(n);
                            if (i != -1)
                                return this.obj[i];
                            else
                                return null
                        },
                        remove: function (n) {
                            var i = this.index(n);
                            if (i != -1) this.obj.splice(i, 1);
                        },
                        add: function (a) {
                            if (!a) return;
                            var m = this;
                            if ($.type(a[0]) != 'array') {
                                if (a[1] == 'D' && $.type(a[2]) == 'date')
                                    a[2] = $.offsetDate(a[2]);
                                m.val(a[0], a[1], a[2], a[3]);
                            }
                            else $.each(a, function (i, v) {
                                if (v[1] == 'D' && $.type(a[2]) == 'date')
                                    v[2] = $.offsetDate(v[2]);
                                m.val(v[0], v[1], v[2], v[3]);
                            });
                        },
                        push: function (m) {
                            var a = m.val();
                            for (var i = 0; i < a.length; i++) this.obj.push(a[i]);
                            return this;
                        }
                    };
                </script>
        </section>
    </div>
    <!--//Map-->
    <div class="clearfix"></div>
    <br />
    <br />
    <!--services-section-->

    <div class="services" id="services">
        <div class="container">
            <h3 class="title clr">Dịch Vụ</h3>
            <div class="agileits-banner-grids text-center">
                <div class="banner-bottom-girds">
                    <div class="col-md-3  col-sm-6 col-xs-6  agileits-banner-grid">
                        <span class="fa fa-truck banner-icon" aria-hidden="true"></span>
                        <h4>Đường bộ</h4>
                        <p class="text-justify">Mọi hành trình vận chuyển hàng hóa đều được lên kế hoạch, dự phòng và tối ưu hóa đường đi để đảm bảo mục tiêu thời gian với chi phí hợp lý.</p>
                    </div>
                    <div class="col-md-3  col-sm-6 col-xs-6 agileits-banner-grid">
                        <span class="fa fa-ship banner-icon" aria-hidden="true"></span>
                        <h4>Vận chuyển đường thủy</h4>
                        <p class="text-justify">Chúng tôi có thể cung cấp cho bạn đầy đủ các dịch vụ vận chuyển hàng hóa đường biển quốc tế phù hợp với nhu cầu của bạn.</p>
                    </div>
                    <div class="col-md-3  col-sm-6 col-xs-6  agileits-banner-grid">
                        <span class="fa fa-plane banner-icon" aria-hidden="true"></span>
                        <h4>Vận tải hàng không</h4>
                        <p class="text-justify">Khả năng hiển thị trực tuyến vượt trội và truy cập tức thì vào bộ đầy đủ thông tin chi tiết về vận chuyển lô hàng quốc tế và thủ tục hải quan.</p>
                    </div>
                    <div class="col-md-3  col-sm-6 col-xs-6  clr1 agileits-banner-grid">
                        <span class="fa  fa-bus  banner-icon" aria-hidden="true"></span>
                        <h4>Giải pháp vận chuyển theo yêu cầu</h4>
                        <p class="text-justify">Mỗi lĩnh vực ngành đều có những yêu cầu riêng về quản lý logistics. ISWIFT có thể thiết kế một kế hoạch duy nhất là dịch vụ phù hợp nhất cho công ty của bạn.</p>
                    </div>
                    <div class="clearfix"></div>
                </div>

                <div class="service-top">


                    <div class="col-md-8 services-matter">
                        <p>
                            Iswift Solution là giải pháp toàn diện cho chuỗi vận hành logistics, giải quyết các vấn đề về sự phức tạp trong chuỗi về dòng thông tin, dòng hàng hoá và dòng tài chính. Đồng thời, giải pháp Iswift ecosystem nâng cao chất lượng dịch vụ logistics về sự chính xác, đảm bảo về mặt thời gian cũng như các dịch vụ hỗ trợ khác, từ đó cải thiện sự hài lòng khách hàng và phát triển, mở rộng thị trường trong và ngoài nước.
                        </p>
                        <div class="w3_read-buttn ">
                            <a href="#" data-toggle="modal" data-target="#myModal">ĐỌC THÊM</a>
                        </div>
                    </div>
