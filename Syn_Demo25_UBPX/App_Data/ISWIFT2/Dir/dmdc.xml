<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmdc" table="dmdc" fieldKey="ma_kh,ma_dc" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục địa chỉ giao hàng" e="Delivery Address List"></title>
  <title0 v="Thêm" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_kh" format="U" label="1" field="1" viewType="Lookup" clientDefault="true" fieldType="PK" >
          <text v="Mã khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_dc" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Địa chỉ" e="Delivery Address Code"></text>
        </field>
        <field name="ten_dc" label="1" field="-" allowBlank="false"  >
          <text v="Diễn giải" e="Description"></text>
        </field>
        <field name="ten_dc2" label="1" field="-" allowBlank="true">
          <text v="Diễn giải khác" e="Other name"></text>
        </field>
        <field name="lien_he_gh" label="1" field="-" allowBlank="true">
          <text v="Người liên hệ" e="Other name"></text>
        </field>
        <field name="dt_gh" label="1" field="1">
          <text v="Điện thoại" e="Phone"></text>
        </field>
        <field name="fax_gh" label="1" field="1">
          <text v="Fax" e="Fax"></text>
        </field>
        <field name="ghi_chu" label="1" field="-" allowBlank="true">
          <text v="Ghi chú" e="Notes"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmdc(p){
  this.constructor(p);
}
dir$dmdc.prototype = new DirEvent();
dir$dmdc.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Địa chỉ đã tồn tại' else N'Delivery Address code is exists' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Địa chỉ đã tồn tại' else N'Delivery Address code is exists' end
         ]]>
      </text>
    </declare>
  </script>

</dir>