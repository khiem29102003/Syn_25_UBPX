<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmcang" table="dmcang" fieldKey="ma_cang" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục cảng" e="Port List"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_cang" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã cảng" e="Port Code"></text>
        </field>
        <field name="ten_cang" label="1" field="2" allowBlank="false">
          <text v="Tên cảng" e="Port Name"></text>
        </field>
        <field name="ten_cang2" label="1" field="2">
          <text v="Tên khác" e="Other name"></text>
        </field>
        <field name="dia_chi" label="1" field="-" importWidth="250" importable="30">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="ma_qg" viewType="Lookup" label="1" field="[120]"  >
           <text v="Mã quốc gia" e="Country code"></text>
           <viewInfo lookupType="One" lookupId="dmquocgia" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_qg" lookupInfo="dmquocgia|ma_qg|ten_qg" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_qg" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
           <text v="" e=""></text>
        </field>
		
		<field name="ma_kv" viewType="Lookup" label="1" field="[120]"  >
           <text v="Mã khu vực" e="Area code"></text>
           <viewInfo lookupType="One" lookupId="dmkhuvuc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_kv" lookupInfo="dmkhuvuc|ma_kv|ten_kv" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_kv" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
           <text v="" e=""></text>
        </field>
		
		<field name="dien_thoai" label="1" field="1" importable="80">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="fax" label="1" field="1"  importable="85">
          <text v="Fax" e="Fax"></text>
        </field>
        <field name="email" label="1" field="2" importable="90">
          <text v="Email" e="Email"></text>
        </field>
		<field name="tdx" label="1" field="1" dataType="N" importable="90">
          <text v="Kinh độ" e="Longitude"></text>
        </field>
		<field name="tdy" label="1" field="1" dataType="N" importable="85">
          <text v="Vĩ độ" e="Latitude"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmcang(p){
  this.constructor(p);
}
dir$dmcang.prototype = new DirEvent();
dir$dmcang.prototype.beforeInit = function(renderType){
  this._dir.options._files = null;
}
dir$dmcang.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

  dir$dmcangDisabledMasterField(p, g);

}

function dir$dmcangDisabledMasterField(p, g){
  
  if(p.valForm('ma_cang').trim() != '')
  {
    p.setDisabled('ma_cang', true);
  }
  else
  {
    p.setDisabled('ma_cang', false);
  }
}

         ]]>
    </text>
  </js>

  <script>
	    

  
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã cảng đã tồn tại' else N'Port Code is exists' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã cảng đã tồn tại' else N'Port Code is exists' end
         ]]>
      </text>
    </declare>
  </script>

</dir>