<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmdv" table="dmdv" fieldKey="ma_dv" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục dịch vụ" e="Service List"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_dv" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã dịch vụ" e="Service Code"></text>
        </field>
        <field name="ten_dv" label="1" field="-" allowBlank="false" fieldType="PK" >
          <text v="Tên dịch vụ" e="Description"></text>
        </field>
        <field name="ten_dv2" label="1" field="-">
          <text v="Tên khác" e="Other name"></text>
        </field>

        <field name="ghi_chu" label="1" field="-" >
          <text v="Ghi chú" e="Notes"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmdv(p){
  this.constructor(p);
}
dir$dmdv.prototype = new DirEvent();
dir$dmdv.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã dịch vụ đã có hoặc lồng nhau trong danh mục dịch vụ." e="The Service is invalid or already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã dịch vụ đã có hoặc lồng nhau trong danh mục dịch vụ." e="The Service is invalid or already exists."/>
    </message>
  </messages>

</dir>