      break;
  }
}
dir$m32.prototype.formFieldValueChange = function (o, cF, v) {
  var p = this._dir;
  switch (cF){
]]>&VoucherExRateValid01;<![CDATA[
    case 'ma_gd':
      dir$m32HiddenColumnByTran(p);
      break;
    case 'ma_ngv':
      dir$m32HiddenColumnByType(p);
      break;
    case 'ty_gia':
      p.calcExpressionAll(0, '!ty_gia');
