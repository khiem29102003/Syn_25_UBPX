dir$m32.prototype.gridDetailActionChange = function(gindex, action, r){
  if(gindex > 0) return true;
  
  var p = this._dir;
  if (action == 'AfterDeleteRow' || action == 'AfterAppendGrid') dir$m32DisabledMasterField(p, p.grid(gindex));
  return true;
}
function dir$m32DisabledMasterField(p, g){
  var dt = g.data, rows = dt.findRow("[ma_dv].trim() != ''"), dis = rows.length > 0;
  p.setDisabled('unit_id', dis);
  p.setInactive('unit_id', true);
  p.setDisabled('ma_ngv', dis);
  if (p.options._sale_lock_master == 1) 
    p.setDisabled(['ma_kh', 'ngay_ct', 'ma_nt'], dis);
  else {
    rows = dt.findRow("[ma_dv].trim() != '' && [id_pn] > 0"), dis = rows.length > 0;
    p.setDisabled('ma_kh', dis);
  }
}
function dir$m32HiddenColumnByType(p){
  var v = p.valForm('ma_ngv'), nt = p.valForm('ma_nt'), bc = p.options.struct.baseCurrency;
  p.setColumnHidden(0, ['sl_pn'], v == 3);
  p.setColumnHidden(0, ['line_pn', 'so_ct_pn'], v == 3);
  p.setColumnHidden(0, ['gia', 'tien'], nt == bc);
  p.setInvisible(['t_tien'], nt == bc);
}
function dir$m32HiddenColumnByTran(p){
  
}
function dir$m32DisabledStatusByAction(p){
  var o = p.jObject('status');
  if (p.options.action != 'VIEW') o.find("[value=6],[value=7],[value=9]").remove();
}
         ]]>
    </text>
  </js>

  <script>


    &VoucherRequest;
    &VoucherPurchaseRequest;

    <query>
      <text>
        <![CDATA[
if @action = 'EDIT' begin
]]>&CheckUpdatingDeleting;<![CDATA[
end
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @action in ('EDIT', 'VIEW') exec ISWIFTStoreGetListFiles 'xfile', @id, '@@voucherCode', '', @script output
if @script is null set @script = ''

if @action = 'NEW' begin
  declare @ma_nk varchar(32), @ten_nk nvarchar(3000), @ngay_ct date, @so_ct varchar(32), @i_so_ct int, @unit_id int
  select @ngay_ct = getdate(), @unit_id = @@unit
]]>&VoucherNumberQuery;<![CDATA[
  if @so_ct is null
    select '' as [so_ct], 0 as [i_so_ct], @unit_id as [unit_id], '' as ma_nk, '' as ten_nk
  else
    select @so_ct as [so_ct], @i_so_ct as [i_so_ct], @unit_id as [unit_id], @ma_nk as ma_nk, @ten_nk as ten_nk
end
else select @script as script
drop table #@@table
         ]]>
      </text>
    </query>

    <declare>
      <text>
        <![CDATA[
declare @warning nvarchar(256), @dOldVoucherDate date, @dVoucherDate date, @nVoucherType tinyint, @strIds varchar(256), @q nvarchar(4000)
set @warning = ''
create table #idupdatestatusPN(id int); create table #idupdatestatusDH(id int)
         ]]>
      </text>
    </declare>

    &VoucherJSLoading;

    <beforesave>
      <text>
        &VoucherNumberBeforeSave;
      </text>
    </beforesave>

    <deleting>
      <text>
        &CheckUpdatingDeleting;
        <![CDATA[
select @dOldVoucherDate = ngay_ct, @dVoucherDate = ngay_ct, @nVoucherType = ma_ngv from m32 where id = @id
        ]]>
      </text>
    </deleting>

    <deleted>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
insert into #idupdatestatusPN select id_pn from d32 where id = @id and id_pn <> 0 group by id_pn
insert into #idupdatestatusDH select id_dh from d32 where id = @id and id_dh <> 0 and id_pn = 0 group by id_dh

]]>
<![CDATA[  
select ma_vt ma_dv, ma_kho, ma_lo, ma_vi_tri, so_luong, he_so, id, datetime2, ct_nxd, 0 as del into #in0 from wrkin
set @q = 'insert into #in0 select ma_vt ma_dv, ma_kho, ma_lo, ma_vi_tri, so_luong, he_so, id, datetime2, ct_nxd, 1 from r90$' + convert(char(6), @dOldVoucherDate, 112) + ' where id in (' + @strIds + ')'
exec (@q)
]]>
<![CDATA[

delete ctcq20 where id_ct = @id
]]><![CDATA[


drop table #idupdatestatusPN, #idupdatestatusDH
        ]]>
      </text>
    </deleted>

    <updating>
      <text>
        <![CDATA[
insert into #idupdatestatusPN select id_pn from d32 where id = @id and id_pn <> 0 group by id_pn
insert into #idupdatestatusDH select id_dh from d32 where id = @id and id_dh <> 0 and id_pn = 0 group by id_dh
select @dOldVoucherDate = ngay_ct from m32 where id = @id
        ]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId, i_so_ct = @i_so_ct, so_ct = @so_ct where [%whereFieldKey]
update dmttin set status = 0 from dmttin where id0 = rtrim(@id) and xgroup = '@@voucherCode'
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
         ]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[
select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @ma_ct = '@@voucherCode'
exec ISWIFTStoredGetIdentityNumber '@@voucherCode', '@@table', @id output
         ]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
]]>
      </text>
    </inserted>

    <aftersave>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
if @action = 'NEW' set @dOldVoucherDate = @ngay_ct
update @d32 set id = @id, ma_kh = @ma_kh, ngay_ct = @ngay_ct, so_ct = @so_ct, status = @status
update @f32 set id = @id
delete d32 where id = @id
delete f32 where id = @id
delete ctcq20 where id_ct = @id
insert d32 select * from @d32
insert f32 select * from @f32
update d32 set ngay_kt = dateadd(day,so_ngay_bh,ngay_bh) where id = @id and convert(char(8),ngay_bh,112) <>''

]]><![CDATA[  
select ma_vt ma_dv, ma_kho, ma_lo, ma_vi_tri, so_luong, he_so, id, datetime2, ct_nxd, 0 as del into #in0 from wrkin
set @q = 'insert into #in0 select ma_vt ma_dv, ma_kho, ma_lo, ma_vi_tri, so_luong, he_so, id, datetime2, ct_nxd, 1 from r90$' + convert(char(6), @dOldVoucherDate, 112) + ' where id in (' + @strIds + ')'
exec (@q)
]]><![CDATA[


--exec ISWIFTStoredPostingVoucher 'm32', 'd32', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''

exec ISWIFTStoredPostingARFund @ma_ngv, 0, 'm32', 'd32', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''


]]>
<![CDATA[  
set @q = 'insert into #in0 select ma_vt ma_dv , ma_kho, ma_lo, ma_vi_tri, so_luong, he_so, id, datetime2, ct_nxd, 0 from r90$' + convert(char(6), @ngay_ct, 112) + ' where id in (' + @strIds + ')'
exec (@q)
]]><![CDATA[

insert into #idupdatestatusPN select id_pn from @d32 where id = @id and id_pn not in (select id from #idupdatestatusPN) and id_pn <> 0 group by id_pn
insert into #idupdatestatusDH select id_dh from @d32 where id = @id and id_dh not in (select id from #idupdatestatusDH) and id_dh <> 0 and id_pn = 0 group by id_dh

drop table #idupdatestatusPN, #idupdatestatusDH

exec ISWIFTStoredIncreaseVoucherNo @ma_nk, @ngay_ct, '@@voucherCode', @i_so_ct, @so_ct, '@@table'
select '' as message, @warning as warning, @id as [#id], @so_ct as [#so_ct], @ma_unit as [#ma_unit]
]]>
      </text>
    </aftersave>

  </script>

  <messages>
    <message val="invoiceRetrieve">
      <text v="Chỉ xử lý nghiệp vụ lấy số liệu cho hóa đơn" e="" />
    </message>
    <message val="DaThanhToan">
