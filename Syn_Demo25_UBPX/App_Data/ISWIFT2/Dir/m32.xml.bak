<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields01.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherPurchaseRequest SYSTEM "..\Include\XML\VoucherPurchaseRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from m32 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
  if exists(select 1 from d56 with(index(id_hd)) where id_hd = @id) begin
    select '$DaTraLai' as message
    return
  end
  if exists(select 1 from ctcq20 where id_tt = @id and loai_tt = 1) begin
    select '$DaThanhToan' as message
    return
  end
    ">
]>

<dir id="m32" table="m32" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="CN1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phiếu chi hoạt động" e="Payment Slip for Activitye"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_ngv" viewType="Combobox" valueDefault="" label="1" field="[180]" >
          <text v="Loại hóa đơn" e="Inv. Type"></text>
          <viewInfo>
            <options query="select ma_ngv, ten_ngv%l from dmngv where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="ma_kh" allowBlank="true" viewType="Lookup" label="1" field="1" importable="5">
          <text v="Mã nhà cung cấp" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ong_ba" label="1" rows="1" field="-">
          <text v="Người nhận" e="Receipt"></text>
        </field>
		 
        <field name="ma_tt" viewType="Lookup" label="1" field="1">
          <text v="Mã thanh toán" e="Credit Term"></text>
          <viewInfo lookupType="One" lookupId="dmtt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_tt" lookupInfo="dmtt|ma_tt|ten_tt" />
        </field>
        <field name="ten_tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="dien_giai" label="1" rows="1" field="-">
          <text v="Diễn giải" e="Memo"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="d32" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>
	<form tabPageIndex="2" gravity="MiddleLeft"  hidden="true" height="320" columns="120,120,240" >
      <text v="Chi phí" e="Fee"></text>
      <fields>
        <field name="f32" allowBlank="false" label=""  hidden="true" field="-" viewType="Grid">
          <text v="Chi phí" e="Fee"></text>
        </field>
      </fields>
    </form>

  
    <form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Khác" e="Other"></text>
      <fields>
        <field name="ma_nvbh" clientDefault="true" allowBlank="true" viewType="Lookup" label="1" field="1" setype="1">
          <text v="Mã nhân viên" e="Sale"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nvbh" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" />
        </field>
        <field name="ten_nvbh" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptvc" viewType="Lookup" label="1" field="1">
          <text v="Phương tiện v/c" e="Transportation"></text>
          <viewInfo lookupType="One" lookupId="dmptvc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptvc" lookupInfo="dmptvc|ma_ptvc|ten_ptvc" />
        </field>
        <field name="ten_ptvc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_pttt" viewType="Lookup" label="1" field="1">
          <text v="Ph/th thanh toán" e="Payment Methods"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        
        
        <field name="ghi_chu" label="1" rows="3" field="-">
          <text v="Ghi chú" e="Note"></text>
        </field>
      </fields>
    </form>

  

    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="CN1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="120,120,120,120,120" >
      <fields>
        <field name="t_so_luong" label="1" field="1" dataType="N" disabled="true" format="Qty" >
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
        <field name="t_tien_nt2" nextRow="false" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
        <field name="t_tien2" nextRow="false" label="" field="1" disabled="true" dataType="N" format="Amount" hidden="true">
          <text v="" e="Total Amount"></text>
        </field>
       
      <field name="t_phi" label="1" field="1" dataType="N" disabled="true" format="Amount" >
          <text v="Tổng phí" e="Total Fee"></text>
        </field>
        <field name="t_tt_nt" nextRow="false" label="1" field="1" dataType="N" disabled="true" format="FCAmount" hidden="true">
          <text v="Tổng thanh toán" e="Total Amount"></text>
        </field>
        <field name="t_tt" label="" field="1" nextRow="false" disabled="true" dataType="N" format="Amount" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="d32" table="d32" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_dv" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã dịch vụ" e="Service"></text>
          <viewInfo lookupType="One" lookupId="dmdv" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dv" lookupInfo="dmdv|ma_dv|ten_dv" />
        </field>
        <field name="ten_dv" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmdv b on a.ma_dv = b.ma_dv ">
          <text v="Tên dịch vụ" e="Service Name"></text>
        </field>
       
        <field name="so_luong" dataType="N" format="Qty" allowBlank="false" width="100" readOnly="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
             
        
        <field name="gia_nt2" dataType="N" format="FCPrice" width="100" readOnly="false" >
          <text v="Giá mua %s" e="%s Price"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="FCAmount" width="100" readOnly="true" >
          <text v="Thành tiền %s" e="%s Amount"></text>
        </field>
       
       
        <field name="gia2" dataType="N" format="Price" width="100" inactivate="true" readOnly="false" >
          <text v="Giá mua" e="Price"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false" >
          <text v="Thành tiền" e="Amount"></text>
        </field>
       
       
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[
set nocount on
--select @@fields into #t from d32 a @@join where @@key order by line
select @@fields into #t from d32 a @@join where @@key order by line
--select a.*,b.ten_dv from #t left join dmdv b on a.ma_dv=b.ma_dv order by line

Select * from #t
drop table #t
         ]]>
          </text>
        </query>
      </script>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="retrieve">
          <text v="$RetrieveToolbar" e="$RetrieveToolbar"></text>
          <items>
            <button id="10">
              <text v="Lấy dữ liệu từ đơn hàng"  e="Extract Data from Purchase Orders"/>
            </button>
            <button id="20">
              <text v="Lấy dữ liệu từ phiếu nhập"  e="Extract Data from Pick List"/>
            </button>
            <button id="80">
              <text v="-"  e="-"/>
            </button>
            <button id="90">
              <text v="Xem các hóa đơn liên quan"  e="View Invoice"/>
            </button>
          </items>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[
set nocount on
select @@fields into #t from d32 a @@join where @@key order by line

select * from #t order by line
drop table #t
         ]]>
          </text>
        </query>
      </script>

    </grid>
    <grid id="f32" table="f32" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ma_phi" width="100" viewType="Lookup" readOnly="false" >
          <text v="Mã phí" e="Fee"></text>
          <viewInfo lookupType="One" lookupId="dmphi" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_phi" lookupInfo="dmphi|ma_phi|ten_phi" />
        </field>
        <field name="ten_phi" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmphi b on a.ma_phi = b.ma_phi ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
        <field name="tien" dataType="N" format="Amount" width="100" readOnly="false" >
          <text v="Tiền" e="Amount"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>
      <script>
        <query>
          <text>
            <![CDATA[
set nocount on
select @@fields into #t from f32 a @@join where @@key order by line
select * from #t order by line
drop table #t
         ]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$m32(p)
{
  this.constructor(p);
}
dir$m32.prototype = new DirEvent();
dir$m32.prototype.beforeInit = function(renderType)
{
  this._dir.options._files = null;
}
dir$m32.prototype.afterInit = function(renderType)
{
  var p = this._dir, g = p.grid() , f32 = p.grid(1);
  var exp = 
  {  
	gia2: ['*gia2', '[gia_nt2]*[!ty_gia]'],
    tien_nt2: ['*tien_nt2', '[so_luong]*[gia_nt2]'],
    tien2: ['*tien2', '[so_luong]*[gia2]'],
	tien2_tg: ['*tien2', '[tien_nt2]*[!ty_gia]'],
    t_so_luong: ['@t_so_luong', '[so_luong]'],
   
    t_tien_nt2: ['@t_tien_nt2', '[tien_nt2] '],
    t_tien2: ['@t_tien2', '[tien2]'],
  
    t_tt_nt: ['#t_tt_nt', '[t_tien_nt2] + 0'],
    t_tt: ['#t_tt', '[t_tien2] + [t_phi]']
  }
  p.applyExpression(exp, g, false);
  
   var exp_f32 = 
  {
    t_phi: ['@t_phi', '[tien]'],
	t_tt: ['#t_tt', '[t_tien2] + [t_phi]']
  }
  p.applyExpression(exp_f32, f32, false);
  f32.FomulaApplied = 
  {
	"tien":["t_phi", "t_tt"],
	"t_phi":["t_tt"]
  }  
  var expForm = 
  {
    t_tt: ['#t_tt', '[t_tien2] + [t_phi]']
  }
   
  p.applyExpressionForm(expForm, false);
 
  g.FomulaApplied = 
  {
    "so_luong":["t_so_luong", "tien_nt2", "t_tien_nt2","tien2_tg", "t_tien2", "t_tt_nt", "t_tt", "t_phi"],
    "gia_nt2":["tien_nt2", "gia2", "t_tien_nt2","tien2_tg",  "t_tien2",  "t_tt_nt", "t_tt","t_so_luong"],
    "!ty_gia":["gia2", "tien2_tg", "t_tien2", "t_tt"],
    "tien_nt2":["tien2_tg","t_tien_nt2", "t_tien2", "t_tt_nt", "t_tt"],
    "gia2":["tien2", "t_tien2", "t_tt","t_so_luong"],
    "tien2":["t_tien2","t_so_luong","t_tt"],
    "t_tien_nt2":["t_so_luong","t_tt_nt"],
    "t_tien2":["t_tt"],
	"t_phi":["t_tt"]
  }
  
  //console.log(JSON.stringify(g.FomulaApplied)); //Gan la ds cong thuc tinh cho cot nao do: 
  
  p.options.FCColumns = {FC: ['t_tien_nt2'], BC: ['t_tien2']};
  g.FCColumns = {FC: ['gia_nt2', 'tien_nt2'], BC: ['gia2','tien2']};
  
  var oldTG = '', oTG = p.jObject('ma_nt'); //Neu ty gia thay doi // oTG = p.jObject('ma_nt')
  oTG.focus(function(){ oldTG = oTG.fval(); }).blur(function(){ if (oldTG != oTG.fval()) onExRateChanged(oTG, p);});
  p.applyFCColumns();
  p.applyFCColumns(g);
  p.setFCHidden(oTG.fval());
 
  
  dir$m32DisabledMasterField(p, g);
  dir$m32HiddenColumnByType(p);
  dir$m32HiddenColumnByTran(p);
  dir$m32DisabledStatusByAction(p);
  p.find(".control-label.t_so_luong, .control-label.t_tien_nt2, .control-label.t_tt_nt,  .control-label.t_phi,  .input-field.t_so_luong, .input-field.t_tien_nt2, .input-field.t_tien2,  .input-field.t_phi, .input-field.t_tt_nt, .input-field.t_tt").css("font-weight", "bold");
}

dir$m32.prototype.beforeButtonGridClick = function (id, gindex) {
  var p = this._dir;
  switch (id) {
    case '10':
      if (p.valForm('ma_kh').trim() == '') {
        p.jObject('ma_kh').focus(); 
        return;
      }
      p.showFilter("m32PN1", null, {_ngay_ct2: p.valForm('ngay_ct'), _ma_kh: p.valForm('ma_kh'), _ten_kh: p.valForm('ten_kh'), _ma_nt: p.valForm('ma_nt'), _unit_id: p.valForm('unit_id')});
      return false;
      break;
    case '20':
      if (p.valForm('ma_ngv') != 1) {
        p.jObject('ma_ngv').focus();
        $.showToast(p.msg('invoiceRetrieve'));
        return;
      }
      if (p.valForm('ma_kh').trim() == '') {
        p.jObject('ma_kh').focus(); 
        return;
      }
      p.showFilter("m32PN3", null, {_ngay_ct2: p.valForm('ngay_ct'), _ma_kh: p.valForm('ma_kh'), _ten_kh: p.valForm('ten_kh'), _ma_nt: p.valForm('ma_nt'), _unit_id: p.valForm('unit_id')});
      return false;
      break;
    default:
      break;
  }
  return true;
}

