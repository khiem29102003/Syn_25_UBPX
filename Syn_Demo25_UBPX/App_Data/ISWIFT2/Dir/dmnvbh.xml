<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmnvbh" table="dmnvbh" fieldKey="ma_nvbh" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhân viên bán hàng" e="Saleman List"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_nvbh" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã nhân viên" e="Saleman Code"></text>
        </field>
        <field name="ten_nvbh" label="1" field="-" allowBlank="false" >
          <text v="Tên nhân viên" e="Description"></text>
        </field>
        <field name="ten_nvbh2" label="1" field="-" allowBlank="true">
          <text v="Tên khác" e="Other name"></text>
        </field>
        <field name="nh_nv1" label="1" field="1" viewType="Lookup" clientDefault="true" allowBlank="true">
          <text v="Nhóm nhân viên 1" e="Saleman Group 1"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'NV1' and status=1" lookupCheck="ma_loai_nh = 'NV1'" lookupRef="ten_nh_nv1" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_nv1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_nv2" label="1" field="1" viewType="Lookup" clientDefault="true" allowBlank="true">
          <text v="Nhóm nhân viên 2" e="Saleman Group 2"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'NV2' and status=1" lookupCheck="ma_loai_nh = 'NV2'" lookupRef="ten_nh_nv2" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_nv2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_nv3" label="1" field="1" viewType="Lookup" clientDefault="true" allowBlank="true">
          <text v="Nhóm nhân viên 3" e="Saleman Group 3"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'NV3' and status=1" lookupCheck="ma_loai_nh = 'NV3'" lookupRef="ten_nh_nv3" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_nv3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_bp" format="U" label="1" field="1" viewType="Lookup" clientDefault="true" allowBlank="false" >
          <text v="Bộ phận" e="Department"></text>
          <viewInfo lookupType="One" lookupId="dmbp" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_bp" lookupInfo="dmbp|ma_bp|ten_bp" />
        </field>
        <field name="ten_bp" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="user_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1">
          <text v="User ID" e="User ID"></text>
        </field>
        <field name="username" fieldType="EXParam" viewType="Lookup" label="1" field="1">
          <text v="Tên đăng nhập" e="Username"></text>
          <viewInfo lookupType="One" lookupId="sysuserinfo" lookupKey="1=1" lookupCheck="1=1" lookupRef="nickname" lookupInfo="sysuserinfo|username|nickname" />
        </field>
        <field name="nickname" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmnvbh(p){
  this.constructor(p);
}
dir$dmnvbh.prototype = new DirEvent();
dir$dmnvbh.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <script>

    <query>
      <text>
        <![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table
if @action = 'EDIT' or @copy = 1 select username, nickname from sysuserinfo where user_id in (select user_id from #@@table)
drop table #@@table
         ]]>
      </text>
    </query>
    
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã nhân viên đã tồn tại' else N'Saleman code is exists' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã nhân viên đã tồn tại' else N'Saleman code is exists' end
         ]]>
      </text>
    </declare>

    <beforesave>
      <text>
        <![CDATA[
if @username <> '' and @username <> @ma_nvbh begin
  select N'Nhân viên và tên đăng nhập phải được đặt cùng tên' as message
  return
end
select @user_id = user_id from sysuserinfo where username = @username
        ]]>
      </text>
    </beforesave>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId, user_id = @user_id where [%whereFieldKey]
         ]]>
      </text>
    </updated>
  
  </script>

</dir>