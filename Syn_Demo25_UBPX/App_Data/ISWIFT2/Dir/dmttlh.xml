        <field name="ma_tt" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã trạng thái lô hàng" e="Department Code"></text>
        </field>
        <field name="ten_tt" label="1" field="-" allowBlank="false" fieldType="PK" >
          <text v="Tên trạng thái" e="Description"></text>
        </field>

     
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
