  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã đơn vị hàng đã có trong danh mục đơn vị hàng." e="The site is already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã đơn vị hàng đã có trong danh mục đơn vị hàng." e="The site is already exists."/>
    </message>
  </messages>

</dir>