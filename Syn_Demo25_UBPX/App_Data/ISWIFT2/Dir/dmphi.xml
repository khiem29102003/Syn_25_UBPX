<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmphi" table="dmphi" fieldKey="ma_phi" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phí" e="Fee List"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_phi" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã phí" e="Code"></text>
        </field>
        <field name="ten_phi" label="1" field="-" allowBlank="false">
          <text v="Tên phí" e="Description"></text>
        </field>
        <field name="ten_phi2" label="1" field="-" >
          <text v="Tên khác" e="Other name"></text>
        </field>
		<field name="ma_dvt" viewType="Lookup" label="1" field="1">
          <text v="ĐVT" e="Unit"></text>
          <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" />
        </field>
        <field name="ten_dvt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="nhom_bg1" viewType="Lookup" label="1" field="1" importable="60">
          <text v="Nhóm 1" e="Group 1"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'BG1' and status=1" lookupCheck="ma_loai_nh = 'BG1'" lookupRef="ten_nh_bg1" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'BG1' and z.status=1"/>
        </field>
        <field name="ten_nh_bg1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="nhom_bg2" viewType="Lookup" label="1" field="1" importable="60">
          <text v="Nhóm 2" e="Group 1"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'BG2' and status=1" lookupCheck="ma_loai_nh = 'BG2'" lookupRef="ten_nh_bg2" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'BG2' and z.status=1"/>
        </field>
        <field name="ten_nh_bg2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="nhom_bg3" viewType="Lookup" label="1" field="1" importable="60">
          <text v="Nhóm 3" e="Group 1"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'BG3' and status=1" lookupCheck="ma_loai_nh = 'BG3'" lookupRef="ten_nh_bg3" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'BG3' and z.status=1"/>
        </field>
        <field name="ten_nh_bg3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
		<field name="df" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="[150]" field="[50]">
          <text v="Default thêm mới (Quote)" e="Default Insert AddNew (Quote)"></text>
        </field>
		 
			<field name="fcl_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
				<text v="FCL" e="Tuesday"></text>
			</field> 
			<field name="lcl_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
				<text v="LCL" e="Tuesday"></text>
			</field> 
			<field name="air_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
				<text v="AIR" e="Tuesday"></text>
			</field> 
		<field name="df2" fieldType="EX" readOnly="true" inactivate="true" label="[150]" field="[50]">
          <text v="Default thêm mới (Cost)" e="Default Insert AddNew (Quote)"></text>
        </field>
		 
			<field name="fcl2_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
				<text v="FCL" e="Tuesday"></text>
			</field> 
			<field name="lcl2_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
				<text v="LCL" e="Tuesday"></text>
			</field> 
			<field name="air2_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
				<text v="AIR" e="Tuesday"></text>
			</field> 
		<field name="df3" fieldType="EX" readOnly="true" inactivate="true" label="[150]" field="[50]">
          <text v="Default thêm mới (Bill)" e="Default Insert AddNew (Quote)"></text>
        </field>
		 
			<field name="fcl3_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
				<text v="FCL" e="Tuesday"></text>
			</field> 
			<field name="lcl3_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
				<text v="LCL" e="Tuesday"></text>
			</field> 
			<field name="air3_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
				<text v="AIR" e="Tuesday"></text>
			</field> 
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmphi(p){
  this.constructor(p);
}
dir$dmphi.prototype = new DirEvent();
dir$dmphi.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmphi.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

  dir$dmphiDisabledMasterField(p, g);

}

function dir$dmphiDisabledMasterField(p, g){
  
  if(p.valForm('ma_phi').trim() != '')
  {
    p.setDisabled('ma_phi', true);
  }
  else
  {
    p.setDisabled('ma_phi', false);
  }
}
         ]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã phí đã tồn tại' else N'Fee code is exists' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã phí đã tồn tại' else N'Fee code is exists' end
         ]]>
      </text>
    </declare>
  </script>
</dir>