dir$s41.prototype.gridDetailActionChange = function(gindex, action, r){
  var p = this._dir;
  if (action == 'AfterDeleteRow' || action == 'AfterAppendGrid') dir$s41DisabledMasterField(p, p.grid(gindex));
  return true;
}


dir$s41.prototype.beforeButtonGridClick = function (id, gindex) {
  var p = this._dir;
  switch (id) {
    case 'refresh':
      dir$sysrightvoucherLoadFieldGrid(p, 0);
      return false;
    default:
