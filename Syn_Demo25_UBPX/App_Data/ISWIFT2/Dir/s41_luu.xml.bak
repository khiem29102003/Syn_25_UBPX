    <form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Khác" e="Other"></text>
      <fields>
        <field name="ma_nvbh" clientDefault="true" viewType="Lookup" label="1" field="1" setype="1">
          <text v="Mã nhân viên" e="Sale"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nvbh" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" />
        </field>
        <field name="ten_nvbh" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		 <field name="ma_tt" viewType="Lookup" label="1" field="1">
          <text v="Mã thanh toán" e="Credit Term"></text>
          <viewInfo lookupType="One" lookupId="dmtt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_tt" lookupInfo="dmtt|ma_tt|ten_tt" />
        </field>
        <field name="ten_tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptvc" viewType="Lookup" label="1" field="1">
          <text v="Phương tiện v/c" e="Transportation"></text>
          <viewInfo lookupType="One" lookupId="dmptvc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptvc" lookupInfo="dmptvc|ma_ptvc|ten_ptvc" />
        </field>
        <field name="ten_ptvc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_pttt" viewType="Lookup" label="1" field="1">
          <text v="Ph/th thanh toán" e="Payment Methods"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptgh" viewType="Lookup" label="1" field="1">
          <text v="Ph/th giao hàng" e="Delivery Methods"></text>
          <viewInfo lookupType="One" lookupId="dmptgh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptgh" lookupInfo="dmptgh|ma_ptgh|ten_ptgh" />
        </field>
        <field name="ten_ptgh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
       
      </fields>
    </form>

    <form tabPageIndex="6" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Tổng cộng" e="Total"></text>
      <fields>
        <field name="t_ck_nt" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng chiết khấu" e="Total Tax"></text>
        </field>
        <field name="t_ck" label="" field="1" nextRow="false" disabled="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_tc_tien_nt2" label="1" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền hàng" e="Total Tax"></text>
        </field>
        <field name="t_tc_tien2" label="" field="1" nextRow="false" disabled="true" fieldType="EX" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_km_nt" label="1" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền KM" e="Total Tax"></text>
        </field>
        <field name="t_km" label="" field="1" nextRow="false" disabled="true" fieldType="EX" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
      </fields>
    </form>

	
    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="BQ1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="120,120,120,120,120" >
      <fields>
        <field name="t_so_luong" label="1" field="1" dataType="N" disabled="true" format="Qty" >
          <text v="Tổng số lượng " e="Total Quatity"></text>
        </field>
        <field name="t_tien_nt2" nextRow="false" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
        <field name="t_tien2" nextRow="false" label="" field="1" disabled="true" dataType="N" format="Amount" >
          <text v="" e="Total Amount"></text>
        </field>
        <field name="t_thue_nt" blank="2" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng thuế" e="Total Tax"></text>
        </field>
        <field name="t_thue" label="" field="1" nextRow="false" disabled="true" dataType="N" format="Amount" >
          <text v="" e="Total Tax"></text>
        </field>
       
        <field name="t_tt_nt" nextRow="false" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng thanh toán" e="Total Amount"></text>
        </field>
        <field name="t_tt" label="" field="1" nextRow="false" disabled="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="v41" table="v41" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_noi_ct" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã phí" e="Fee"></text>
          <viewInfo lookupType="One" lookupId="dmkhobai" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_kho" lookupInfo="dmkhobai|ma_noi_ct|ten_kho" />
        </field>
        <field name="ten_kho" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmkhobai b on a.ma_noi_ct = b.ma_noi_ct ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
		
       
		 <field name="ma_dvt" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Đvt" e="Unit"></text>
          <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" />
        </field>
        <field name="ten_dvt" width="0" fieldType="EX" inactivate="true" readOnly="true" aliasName="d.ten_dvt " join=" left join dmdvt d on a.ma_dvt = d.dvt ">
          <text v="Tên đvt" e="Unit Name"></text>
        </field>
		
		
        <field name="so_luong" dataType="N" format="Qty" allowBlank="false" width="100" readOnly="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
        
        <field name="gia_nt1" dataType="N" inactivate="true" format="FCPrice" width="100" readOnly="true" >
          <text v="Giá chuẩn %s" e="%s Std.Price"></text>
        </field>
        <field name="gia_nt2" dataType="N" format="FCPrice" width="100" readOnly="false" >
          <text v="Giá bán %s" e="%s Price"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="FCAmount" width="100" readOnly="false" >
          <text v="Doanh số %s" e="%s Amount"></text>
        </field>
        <field name="tl_ck" dataType="N" format="Rate" width="100" readOnly="false" >
          <text v="Tl ck(%)" e="Dis.Rate"></text>
        </field>
        <field name="ck_nt" dataType="N" format="FCAmount" width="100" readOnly="false" clientDefault="true" >
          <text v="Ch.khấu %s" e="%s Discount"></text>
        </field>
        <field name="thue_suat" dataType="N" format="0" width="100" readOnly="false" clientDefault="true" >
          <text v="Thuế suất(%)" e="Tax"></text>
        </field>
        <field name="thue_nt" dataType="N" format="FCAmount" width="100" readOnly="false">
          <text v="Thuế %s" e="%s Tax"></text>
        </field>
        <field name="gia1" dataType="N" format="Price" width="100" inactivate="true" readOnly="true" >
          <text v="Giá chuẩn" e="Std.Price"></text>
        </field>
        <field name="gia2" dataType="N" format="Price" width="100" inactivate="true" readOnly="false" >
          <text v="Giá bán" e="Price"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false" >
          <text v="Doanh số" e="Amount"></text>
        </field>
        <field name="ck" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false">
          <text v="Chiết khấu" e="Discount"></text>
        </field>
        <field name="thue" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false">
          <text v="Thuế" e="Tax"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[
set nocount on
select @@fields into #t from v41 a @@join where @@key order by line


select * from #t order by line
drop table #t
         ]]>
          </text>
        </query>
      </script>

    </grid>
	
	
 
	<grid id="v41_3" table="v41_3" fieldKey="id, ma_ct" order="ma_ct" allowFilter="true" allowOrder="true" readOnly="false">
       <fields>
        <field name="id" dataType="I" foreignField="id" fieldType="PK" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
      <field name="ma_ct" foreignField="ma_ct" fieldType="PK" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="ma_ttct" width="80" hidden="true" fieldType="PK" readOnly="true" >
          <text v="Trạng thái" e="Status"></text>
        </field>
        <field name="ten_ttct" width="250" readOnly="true" inactivate="true" aliasName="b" >
          <text v="Tên trạng thái" e="Status Name"></text>
        </field>
        <field name="a_view" dataType="B" width="80" readOnly="false" >
          <text v="Xem" e="View"></text>
        </field>
        <field name="a_new" dataType="B" width="80" readOnly="false" >
          <text v="Mới" e="New"></text>
        </field>
        <field name="a_edit" dataType="B" width="80" readOnly="false" >
          <text v="Sửa" e="Edit"></text>
        </field>
        <field name="a_del" dataType="B" width="80" readOnly="false" >
          <text v="Xóa" e="Delete"></text>
        </field>
        <field name="stt" dataType="I" aliasName="b" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>
		
							
      <buttons>
        <button id="refresh">
          <text v="Hiện tất cả" e="Show All"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>
	  
      <script>
        <query>
          <text>
            <![CDATA[
			declare @ma_ct as varchar(33) select @ma_ct='@@voucherCode'
select @@fields into #t from @@table a left join dmttct b on a.ma_ct = b.ma_ct and a.ma_ttct = b.ma_ttct where @@key order by stt
insert into #t select @id, @ma_ct, ma_ttct, ten_ttct, 0, 0, 0, 0, stt from dmttct where ma_ct = @ma_ct and ma_ttct not in (select ma_ttct from #t) and right_yn = 1
select * from #t order by stt
drop table #t
         ]]>
          </text>
        </query>
      </script>
    </grid>
	
    <grid id="v41_1" table="v41_1" fieldKey="id, line" order="line" readOnly="false">
