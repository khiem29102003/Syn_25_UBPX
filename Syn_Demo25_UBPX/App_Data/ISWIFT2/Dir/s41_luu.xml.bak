  }
  return true;
}


function dir$sysrightvoucherLoadFieldGrid(p, xtype) {
	
	//if (p.options.wait) return;
  var time = $.userinfo.val('CommandTimeout'), controller = '@' + 'CTN';
  console.log(time);
  p.wait(true, controller);
  var param = { cController: controller, cFolder: "Dir" };
  console.log(param);
  $.invoke('GetDirStruct', param, p, time, function (d) {
    var k, i, item, hi, ro, f, fs, fi, dt = new DataTable(), g = p.grid(0), gdt = g.data, notrights = ['ma_nt', 'ty_gia', 'ngay_ct', 'so_ct', 'ma_nk', 'ten_nk', '
	'], grids = {}, items = {};
    if (gdt.count() > 0) {
      k = gdt.count();
      while(k--){
        items[gdt.val(k, 'tab') + '#' + gdt.val(k, 'field')] = {a_hidden: gdt.val(k, 'a_hidden'), a_readonly: gdt.val(k, 'a_readonly') }
		console.log(items);
      }
    }
    dt.addColumn(['C', 'C', 'C', 'C', 'I', 'I'], ['tab', 'tabtext', 'field', 'fieldtext', 'a_hidden', 'a_readonly']);
    if (d) {
      f = d.forms.form;
      for (k = 0; k < f.length; k++) {
        fs = f[k].fields.field;
        for (i = 0; i < fs.length; i++) {
          fi = fs[i];
          if (fi.viewType == "Grid") 
            grids[fi.name] =  fi.text.lan
          else if (!fi.hidden && fi.text.lan != '' && notrights.indexOf(fi.name) == -1) {
            item = items['#' + fi.name]; 
            if (item) {hi = item.a_hidden; ro = item.a_readonly; }
            else {hi = 0; ro = 0; }
            if (xtype == 0 || hi != 0 || ro != 0) dt.addRow(['', p.msg('commonInfo'), fi.name, fi.text.lan, hi, ro]);
          }
        }
      }
      f = d.grids.grid;
      for (k = 0; k < f.length; k++) {
        fs = f[k].fields.field;
        for (i = 0; i < fs.length; i++) {
          fi = fs[i];
          if (!fi.hidden && fi.text.lan != ''){
            item = items[k + '#' + fi.name];
            if (item) {hi = item.a_hidden; ro = item.a_readonly; }
            else {hi = 0; ro = 0; }
            if (xtype == 0 || hi != 0 || ro != 0) dt.addRow([k.toString(), grids[f[k].id], fi.name, fi.text.lan.replace('%s', p.msg('FCText')), hi, ro]);
          }
        }
      }
    }
    
    p.appendGrid(1, dt, true);
    p.wait(false, controller);
  }, null, function () {
      p.wait(false, controller);
  })
  
}

function dir$s41DisabledMasterField(p, g){
  var dt = g.data, rows = dt.findRow("[ma_noi_ct].trim() != ''"), dis = rows.length > 0;
  p.setDisabled('unit_id', dis);
  p.setInactive('unit_id', true);
  if (p.options._sale_lock_master == 1) p.setDisabled(['ma_kh', 'ngay_ct', 'ma_nt'], dis);
}
function dir$s41HiddenColumnByType(p){
  var v = p.valForm('ma_ngv'), nt = p.valForm('ma_nt'), bc = p.options.struct.baseCurrency;
}
function dir$s41HiddenColumnByTran(p){
  
}
function dir$s41DisabledStatusByAction(p){
  var o = p.jObject('status');
  if (p.options.action != 'VIEW') o.find("[value=6],[value=7],[value=9]").remove();
}


         ]]>
    </text>
