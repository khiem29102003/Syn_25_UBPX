  <script>
    &VoucherRequest;
    &VoucherSaleRequest;

    <query>
      <text>
        <![CDATA[
if @action = 'EDIT' begin
]]>&CheckUpdatingDeleting;<![CDATA[
end
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @action in ('EDIT', 'VIEW') exec ISWIFTStoreGetListFiles 'xfile', @id, '@@voucherCode', '', @script output
if @script is null set @script = ''

if @action = 'NEW' begin
  declare @ma_nk varchar(32), @ten_nk nvarchar(3000), @ngay_ct date, @so_ct varchar(32), @i_so_ct int, @unit_id int
  select @ngay_ct = getdate(), @unit_id = @@unit
]]>&VoucherNumberQuery;<![CDATA[
  if @so_ct is null
    select '' as [so_ct], 0 as [i_so_ct], @unit_id as [unit_id], '' as ma_nk, '' as ten_nk
  else
    select @so_ct as [so_ct], @i_so_ct as [i_so_ct], @unit_id as [unit_id], @ma_nk as ma_nk, @ten_nk as ten_nk
end
else select @script as script
drop table #@@table
         ]]>
      </text>
    </query>

    <declare>
      <text>
        <![CDATA[
declare @warning nvarchar(256), @dOldVoucherDate date, @dVoucherDate date, @nVoucherType tinyint, @strIds varchar(256), @q nvarchar(4000)
set @warning = ''
         ]]>
      </text>
    </declare>

    &VoucherJSLoading;

    <beforesave>
      <text>
        &VoucherNumberBeforeSave;
      </text>
    </beforesave>

    <deleting>
      <text>
        &CheckUpdatingDeleting;
        <![CDATA[
select @dOldVoucherDate = ngay_ct, @dVoucherDate = ngay_ct, @nVoucherType = ma_ngv from s41 where id = @id
        ]]>
      </text>
    </deleting>

    <deleted>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
exec ISWIFTStoredDeleteDataWithKey 'v41', @strIds, '', @dVoucherDate
exec ISWIFTStoredDeleteDataWithKey 'v41_1', @strIds, '', @dVoucherDate
exec ISWIFTStoredDeleteDataWithKey 'v41_2', @strIds, '', @dVoucherDate
exec ISWIFTStoredDeleteDataWithKey 'v41_3', @strIds, '', @dVoucherDate
        ]]>
      </text>
    </deleted>

    <updating>
      <text>
        <![CDATA[
select @dOldVoucherDate = ngay_ct from s41 where id = @id
        ]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId, i_so_ct = @i_so_ct, so_ct = @so_ct where [%whereFieldKey]
update dmttin set status = 0 from dmttin where id0 = rtrim(@id) and xgroup = '@@voucherCode'
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
         ]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[
select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @ma_ct = '@@voucherCode'
exec ISWIFTStoredGetIdentityNumber '@@voucherCode', '@@table', @id output
         ]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
]]>
      </text>
    </inserted>

    <aftersave>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
if @action = 'NEW' set @dOldVoucherDate = @ngay_ct
update @v41 set id = @id, ma_kh = @ma_kh, ngay_ct = @ngay_ct, so_ct = @so_ct, status = @status
delete v41 where id = @id
insert v41 select * from @v41


update @v41_1 set id = @id
delete v41_1 where id = @id
insert v41_1 select * from @v41_1


update @v41_3 set id = @id
delete v41_3 where id = @id
insert v41_3 select * from @v41_3


update @v41_2 set id = @id
delete v41_2 where id = @id
insert v41_2 select * from @v41_2


exec ISWIFTStoredPostingVoucher 's41', 'v41', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
exec ISWIFTStoredPostingVoucher 's41', 'v41_1', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
exec ISWIFTStoredPostingVoucher 's41', 'v41_2', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
exec ISWIFTStoredPostingVoucher 's41', 'v41_3', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''

exec ISWIFTStoredIncreaseVoucherNo @ma_nk, @ngay_ct, '@@voucherCode', @i_so_ct, @so_ct, '@@table'
select '' as message, @warning as warning, @id as [#id], @so_ct as [#so_ct], @ma_unit as [#ma_unit]
]]>
      </text>
    </aftersave>
  </script>

  <messages>
    <message val="physicalRetrieve">
      <text v="Chỉ xử lý nghiệp vụ sổ sách lấy dữ liệu từ thực tế" e="" />
    </message>
  </messages>
</dir>