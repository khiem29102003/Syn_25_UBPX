  <js>
    <text>
      <![CDATA[
function dir$s41(p){
  this.constructor(p);
}
dir$s41.prototype = new DirEvent();
dir$s41.prototype.beforeInit = function(renderType){
  this._dir.options._files = null;
}
dir$s41.prototype.afterInit = function(renderType){

  var p = this._dir, g = p.grid();
  var exp = {
    gia1: ['*gia1', '[!ty_gia]*[gia_nt1]'],
    gia_ban: ['*gia_ban', '[gia_ban_nt]*[!ty_gia]'],
    gia2: ['*gia2', '[gia_nt2]*[!ty_gia]'],
    tien_nt2: ['*tien_nt2', '[so_luong]*[gia_nt2]'],
    tien2_tg: ['*tien2', '[tien_nt2]*[!ty_gia]'],
    tien2: ['*tien2', '[so_luong]*[gia2]'],
    thue_nt: ['*thue_nt', '[thue_suat]*([tien_nt2] - [ck_nt])/100'],
    thue: ['*thue', '[thue_suat]*([tien2] - [ck])/100'],
    thue_tg: ['*thue', '[!ty_gia]*[thue_nt]'],
    ck_nt: ['*ck_nt', '[tien_nt2]*[tl_ck]/100'],
    ck_tg: ['*ck', '[ck_nt]*[!ty_gia]'],
    ck: ['*ck', '[tien2]*[tl_ck]/100'],

    t_so_luong: ['@t_so_luong', '[so_luong]'],
    t_tien_nt2: ['@t_tien_nt2', '[tien_nt2] - [ck_nt]', '[ct_km] == 0'],
    t_tien2: ['@t_tien2', '[tien2] - [ck]', '[ct_km] == 0'],
    t_ck_nt: ['@t_ck_nt', '[ck_nt]', '[ct_km] == 0'],
    t_ck: ['@t_ck', '[ck]', '[ct_km] == 0'],
    t_thue_nt: ['@t_thue_nt', '[thue_nt]', '[ct_km] == 0'],
    t_thue: ['@t_thue', '[thue]', '[ct_km] == 0'],
    t_tc_tien_nt2: ['@t_tc_tien_nt2', '[tien_nt2]'],
    t_tc_tien2: ['@t_tc_tien2', '[tien2]'],
    t_km_nt: ['@t_km_nt', '[tien_nt2]', '[ct_km] == 1'],
    t_km: ['@t_km', '[tien2]', '[ct_km] == 1'],

    t_tt_nt: ['#t_tt_nt', '[t_tien_nt2] + [t_thue_nt]'],
    t_tt: ['#t_tt', '[t_tien2] + [t_thue]']
  }
  p.applyExpression(exp, g, false);
  
 
  var expForm = {
    t_tt_nt: ['#t_tt_nt', '[t_tien_nt2] + [t_thue_nt]'],
    t_tt: ['#t_tt', '[t_tien2] + [t_thue]']
  }
  p.applyExpressionForm(expForm, true);
  
  g.FomulaApplied = {
    "so_luong":["t_so_luong", "tien_nt2", "ck_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "he_so":["tien_nt2", "ck_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "gia_nt2":["tien_nt2", "gia2", "gia1", "ck_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "!ty_gia":["gia2", "tien2_tg", "ck_tg", "thue_tg", "t_tien2", "t_km", "t_tc_tien2", "t_ck", "t_thue", "t_tt"],
    "thue_suat":["thue_nt", "thue", "t_thue_nt", "t_thue", "t_tt_nt", "t_tt"],
    "tien_nt2":["ck_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "tl_ck":["ck_nt", "thue_nt", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "ck_nt":["thue_nt", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "ct_km":["t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "gia2":["tien2", "ck", "thue", "t_tien2", "t_km", "t_tc_tien2", "t_thue", "t_ck", "t_tt"],
    "tien2":["ck", "thue", "t_tien2", "t_km", "t_tc_tien2", "t_thue", "t_ck", "t_tt"],
    "ck":["thue", "t_tien2", "t_km", "t_tc_tien2", "t_thue", "t_ck", "t_tt"],
    "thue_nt":["thue_tg", "t_thue_nt", "t_thue", "t_tt", "t_tt_nt"],
    "thue":["t_thue", "t_tt"],
    "t_tien_nt2":["t_tt_nt"],
    "t_thue_nt":["t_tt_nt"],
    "t_tien2":["t_tt"],
    "t_thue":["t_tt"],
    "t_ex_total": ["t_tc_tien_nt2", "t_tc_tien2", "t_km_nt", "t_km"]
  }
  //console.log(JSON.stringify(g.FomulaApplied)); //Gan la ds cong thuc tinh cho cot nao do: 
  
  p.options.FCColumns = {FC: ['t_tien_nt2', 't_thue_nt', 't_tt_nt', 't_tc_tien_nt2', 't_km_nt', 't_ck_nt'], BC: ['t_tien2', 't_thue', 't_tt', 't_tc_tien2', 't_km', 't_ck']};
  g.FCColumns = {FC: ['gia_nt1', 'gia_nt2', 'tien_nt2', 'thue_nt', 'ck_nt'], BC: ['gia1', 'gia2', 'tien2', 'thue', 'ck']};
  
  var oldTG = '', oTG = p.jObject('ma_nt'); //Neu ty gia thay doi
  oTG.focus(function(){ oldTG = oTG.fval(); }).blur(function(){ if (oldTG != oTG.fval()) onExRateChanged(oTG, p);});
  p.applyFCColumns();
  p.applyFCColumns(g);
  p.setFCHidden(oTG.fval());
  p.calcExpressionAll(0, 't_ex_total');
  
  p.setColumnAuth(0, ['ma_lo', 'ma_vi_tri'], true); // Ko sd ma_lo, ma_vi_tri
  dir$s41DisabledMasterField(p, g);
  dir$m41HiddenColumnByType(p);
  dir$m41HiddenColumnByTran(p);
  dir$m41DisabledStatusByAction(p);
  p.find(".control-label.t_so_luong, .control-label.t_tien_nt2, .control-label.t_thue_nt, .control-label.t_tt_nt, .input-field.t_so_luong, .input-field.t_tien_nt2, .input-field.t_tien2, .input-field.t_thue_nt, .input-field.t_thue, .input-field.t_tt_nt, .input-field.t_tt").css("font-weight", "bold");
}

dir$s41.prototype.beforeButtonDialogClick = function (id) {
  var p = this._dir, g = p.grid(0), dt = g.data;
  switch (id) {
    case 'ok':
      var rows = dt.findRow("[so_luong] > [sl_ton]") //Ban chuan chi xu ly canh bao ton kho tuc thoi tren client
      if (p.valForm('status') != '0' && rows.length) {
        $.question('$VoucherCurrentStockOverload', $.msg.get("QuestionTitle"), p, function (q, v) {
          q._close();
          if (v)
            p.options.event.buttonDialogClick(id, false);
          else {
            p.tabActive("1");
            p.jCell(rows[0], 'so_luong', 0).focus();
          }
        });
        return false;
      }
      break;
    default:
      break;
  }
  return true;
}
