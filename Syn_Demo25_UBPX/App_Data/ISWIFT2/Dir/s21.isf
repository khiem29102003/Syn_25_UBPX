<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields03.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields04.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from s21 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="s21" table="s21" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="BN1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo giá" e="Quotation Entry"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
         <field name="ma_kh" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="true">
          <text v="Mã khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_hang" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false">
			  <text v="Mã hãng tàu (*)" e="Carrier Code (*)"></text>
			  <viewInfo lookupType="One" lookupId="dmhangtau" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_hang" lookupInfo="dmhangtau|ma_hang|ten_hang" />
			</field>
			<field name="ten_hang" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="-" aliasName="cast('' as nvarchar(200)) as ">
			  <text v="" e=""></text>
			</field>
		<field name="ma_noi_di" viewType="Lookup" label="1" field="1" allowBlank="false">
			<text v="Nơi đi (*)" e="Origin (*)"></text>
			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
		</field>
		<field name="ten_noi_di" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="[150]"  aliasName="cast('' as nvarchar(4000)) as ">
			<text v="" e=""></text>
		</field> 	
		<field name="ma_dk_gh" viewType="Combobox" valueDefault="" label="[120]" field="[70]" nextRow="false" >
			<text v="Điều kiện giao hàng" e="Traffic term"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'DK' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>		
		<field name="ma_noi_den" viewType="Lookup" label="1" field="1" allowBlank="false ">
			<text v="Nơi đến (*)" e="Destination (*)"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_noi_den" lookupInfo="vdmcangden|ma_noi_den|ten_noi_den"/>
		</field>
		<field name="ten_noi_den" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="[150]" aliasName="cast('' as nvarchar(200)) as ">
			<text v="" e=""></text>
		</field> 			
		<field name="ma_dk_nh" viewType="Combobox" valueDefault="" label="[120]" field="[70]" nextRow="false">
			<text v="Điều kiện nhận hàng" e="Traffic term"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'DK' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>		
			

				<field name="ma_dk_ngay" viewType="Combobox" valueDefault="2" label="1" field="[200]" nextRow="false">
					<text v="Thời gian khởi hành" e="Departure"></text>
					<viewInfo>
						<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'DAY' and status = 1 order by stt">
						</options>
					</viewInfo>
				</field>	
				 <field name="so_ngay_vc" label="[150]" field="[60]"  dataType="N" format="Amount" nextRow="false">
				  <text v="T.gian v.chuyển (ngày)" e="Transit time (Days)"></text>
				</field>
				<field name="t2_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="true" inactivate="true" importable="30" >
					<text v="Thứ 2" e="Monday"></text>
				</field> 
				  <field name="t3_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
					<text v="Thứ 3" e="Tuesday"></text>
				</field> 
				<field name="t4_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
					<text v="Thứ 4" e="Wednesday"></text>
				</field> 
				<field name="t5_yn" dataType="B" clientDefault="true" label="[40]" field="[40]"  nextRow="false" inactivate="true" importable="30" >
					<text v="Thứ 5" e="Thursday"></text>
				</field> 
				<field name="t6_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
					<text v="Thứ 6" e="Friday"></text>
				</field> 
				<field name="t7_yn" dataType="B" clientDefault="true" label="[40]" field="[40]" nextRow="false" inactivate="true" importable="30" >
					<text v="Thứ 7" e="Saturday"></text>
				</field> 
				<field name="t8_yn" dataType="B" clientDefault="true" label="[60]" field="[40]" nextRow="false" inactivate="true" importable="30" >
					<text v="Chủ nhật" e="Sunday"></text>
				</field> 	
				
				<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" >
					<text v="Ngày hiệu lực (*)" e="Effective date (*)"></text>
				</field>
				
		
				<field name="ma_cuoc" viewType="Combobox" valueDefault="" label="1"  nextRow="false" field="[180]" >
					<text v="Loại cước" e="Prepaid / Collect"></text>
					<viewInfo>
						<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'LCC' and status = 1 order by stt">
						</options>
					</viewInfo>
				</field>	
				
				<field name="ngay_hld" label="1" field="[120]" dataType="D" allowBlank="false" >
					<text v="Hiệu lực đến (*)" e="Expiry date (*)"></text>
				</field>
				<field name="ma_dk_vc" viewType="Combobox" valueDefault="" label="1"  field="[180]" nextRow="false" >
					<text v="Đi thẳng/Chuyển tải" e="Direct / Transit"></text>
					<viewInfo>
						<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'VT' and status = 1 order by stt">
						</options>
					</viewInfo>
				</field>	
			<field name="ma_cong" viewType="Combobox" valueDefault="" label="1"  nextRow="true" field="[180]" >
					<text v="Container" e="Prepaid / Collect"></text>
					<viewInfo>
						<options query="select ma_cong, ten_cong%l from dmcong where status = 1 order by ma_cong">
						</options>
					</viewInfo>
				</field>	
				
			<field name="dien_giai" label="1" rows="1" field="-">
			  <text v="Diễn giải" e="Memo"></text>
			</field>
			<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
			  <text v="" e=""></text>
			</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
      </fields>
    </form>

   
    <form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="v21" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>
	
	<form tabPageIndex="2" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Container" e="Container"></text>
      <fields>
        <field name="v21_3" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Container" e="Container"></text>
        </field>
      </fields>
    </form>
	
   <form tabPageIndex="8" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Cảng chuyển tải" e="Transit Port"></text>
      <fields>
        <field name="v21_1" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Cảng chuyển tải" e="Transit Port"></text>
        </field>
      </fields>
    </form>
    
	  <form tabPageIndex="9" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Nơi hạ Container" e="Drop off terminals"></text>
      <fields>
        <field name="v21_2" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Nơi hạ Container" e="Drop off terminals"></text>
        </field>
      </fields>
    </form>
    
