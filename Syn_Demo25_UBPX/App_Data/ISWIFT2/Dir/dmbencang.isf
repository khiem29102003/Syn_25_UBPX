<dir id="dmbencang" table="dmbencang" fieldKey="ma_ben" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bến cảng" e="Port Directory"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_ben" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã bến cảng" e="Harbor Code"></text>
        </field>
        <field name="ten_ben" label="1" field="2" allowBlank="false" fieldType="PK" >
          <text v="Tên bến cảng" e="Harbor name"></text>
        </field>
        <field name="ten_ben2" label="1" field="2">
          <text v="Tên khác" e="Other name"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

