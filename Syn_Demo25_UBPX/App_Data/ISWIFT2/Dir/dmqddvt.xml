              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmqddvt(p){
  this.constructor(p);
}
dir$dmqddvt.prototype = new DirEvent();
dir$dmqddvt.prototype.afterInit = function(){
  var p = this._dir;
}
