<dir id="dmqddvt" table="dmqddvt" fieldKey="ma_vt, dvt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục quy đổi đơn vị tính" e="Unit Conversion"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
