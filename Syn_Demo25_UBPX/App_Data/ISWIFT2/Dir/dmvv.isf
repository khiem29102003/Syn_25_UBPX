<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmvv" table="dmvv" fieldKey="ma_vv" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục vụ việc" e="Department List"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_vv" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã vụ việc" e="Department Code"></text>
        </field>
        <field name="ten_vv" label="1" field="-" allowBlank="false" fieldType="PK" >
          <text v="Tên vụ việc" e="Description"></text>
        </field>
        <field name="ten_vv2" label="1" field="-">
          <text v="Tên khác" e="Other name"></text>
        </field>

        <field name="ghi_chu" label="1" field="-" >
          <text v="Ghi chú" e="Notes"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc>049wDmPUialWgb+Xlc1yiE/g7HXeuet6TSw0AogYADX/8BJWwMI/KUeno0WhPogSVoanI++Yg46ewVHR0MJOtwDqpY3ZzxQzc0MPZYmi2AX5XskRZQAMJcYd+mgDXnXslDZRqjWOtTfKcMI9y4i/6/freseYR3YC2fuMQEYvFe7ZK9h31qPPwaQ/G2ZSrG3O</enc>]]>
    </text>
  </js>

  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã vụ việc đã có hoặc lồng nhau trong danh mục vụ việc." e="The job is invalid or already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã vụ việc đã có hoặc lồng nhau trong danh mục vụ việc." e="The job is invalid or already exists."/>
    </message>
  </messages>

</dir>