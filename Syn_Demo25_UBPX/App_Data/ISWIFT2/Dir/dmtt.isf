<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmtt" table="dmtt" fieldKey="ma_tt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hạn thanh toán" e="Payment Term List"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_tt" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã thanh toán" e="Payment Term Code"></text>
        </field>
        <field name="ten_tt" label="1" field="-" allowBlank="false">
          <text v="Tên thanh toán" e="Description"></text>
        </field>
        <field name="ten_tt2" label="1" field="-" allowBlank="true">
          <text v="Tên khác" e="Other name"></text>
        </field>
        <field name="han_tt" label="1" field="1" dataType="N" format="0">
          <text v="Hạn thanh toán" e="Payment Day(s)"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

