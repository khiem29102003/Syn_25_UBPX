<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields03.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields04.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from phixe where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="phixe" table="phixe" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="BQ1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo giá" e="Quotation Entry"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
         <field name="ma_kh" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="true">
          <text v="Mã khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
				<field name="ma_xe" label="1" field="1" viewType="Lookup" allowBlank="false" >
					<text v="Mã xe" e="Vehicle"></text>
					<viewInfo lookupType="One" lookupId="dmxe" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_xe" lookupInfo="dmxe|ma_xe|ten_xe" />
				</field>
				<field name="ten_xe" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field> 
			
				
			<field name="dien_giai" label="1" rows="1" field="-">
			  <text v="Diễn giải" e="Memo"></text>
			</field>
			<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
			  <text v="" e=""></text>
			</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
      </fields>
    </form>

   
    <form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="phixect" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>
	

    <form gravity="BottomLeft" columns="120,120,120,120,120" >
      <fields>
        <field name="t_so_luong" label="1" field="1" dataType="N" disabled="true" format="Qty" >
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
        <field name="t_tien_nt2" nextRow="false" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
        <field name="t_tien2" nextRow="false" label="" field="1" hidden="true" disabled="true" dataType="N" format="Amount" >
          <text v="" e="Total Amount"></text>
        </field>
        <field name="t_thue_nt" blank="2" label="1" field="1" dataType="N" hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thuế" e="Total Tax"></text>
        </field>
        <field name="t_thue" label="" field="1" nextRow="false" disabled="true" hidden="true" dataType="N" format="Amount" >
          <text v="" e="Total Tax"></text>
        </field>
        <field name="t_tt_nt" nextRow="false" label="1" field="1" dataType="N"  hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thanh toán" e="Total Amount"></text>
        </field>
        <field name="t_tt" label="" field="1" nextRow="false" disabled="true" hidden="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

 <grids>
		<grid id="phixect" table="phixect" fieldKey="id, line" order="line" readOnly="false">
			<fields>
				<field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
				  <text v="" e=""></text>
				</field>
				<field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
				  <text v="Dòng" e="Line"></text>
				</field>
				<field name="ma_phi" width="120"  viewType="Lookup" readOnly="false" allowBlank="false" >
					<text v="Mã phí" e="Vehicle"></text>
					<viewInfo lookupType="One" lookupId="dmphi" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_phi" lookupInfo="dmphi|ma_phi|ten_phi" />
				</field>
				<field name="ten_phi" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" width="250"  aliasName="cast('' as nvarchar(4000)) as ">
					<text v="Tên phí" e=""></text>
				</field>
				<field name="so_luong" width="120" readOnly="false" dataType="N" allowBlank="false"  >
					<text v="Số lượng" e="Explain"></text>
				</field>
				<field name="gia" width="120" readOnly="false" dataType="N" allowBlank="false">
					<text v="Giá" e="Explain"></text>
				</field>
				<field name="tien" width="120" dataType="N" disabled="true" >
					<text v="Tiền" e="Explain"></text>
				</field>
				<field name="tyle" width="120" readOnly="false" dataType="N" allowBlank="false" >
					<text v="Tỷ giá" e="Explain"></text>
				</field>
				<field name="tien_tong" width="120" dataType="N">
					<text v="Tổng cộng" e="Explain"></text>
				</field>
				<field name="dien_giai" width="200" readOnly="false" >
					<text v="Diễn giải" e="Explain"></text>
				</field> 
			</fields>
			<buttons>
				<button id="add">
					<text v="$AddToolbar" e="$AddToobar"></text>
				</button>
				<button id="delete">
					<text v="$DeleteToolbar" e="$DeleteToolbar"></text>
				</button>
				<button id="copy">
					<text v="$CopyToolbar" e="$CopyToolbar"></text>
				</button>
				<button id="paste">
					<text v="$PasteToolbar" e="$PasteToolbar"></text>
				</button>
				<button id="moveup">
					<text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
				</button>
				<button id="movedown">
					<text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
				</button>
				<button id="split">
					<text v="-" e="-"></text>
				</button>
				<button id="freeze">
					<text v="$FreezeToolbar" e="$FreezeToolbar"></text>
				</button>
			</buttons>
			 <script>
        <query>
          <text>
            <![CDATA[<enc>U6tALZrmzWP9Q0mrx4SoDrhEuguc32Q6FB1C5khEfstlgz2fCnlJGgJgJuM4cGvNc0MKxhB+tkcSaNxNafcAMv8TAydNw0tANukuQ71C3yBLyyg3TJXTCvmFeC4YIpvAR17M85JoakvsAr8FwSbAUoZqGJ3/MAGnkLkIeoz9NxQ=</enc>]]>
          </text>
        </query>
      </script>
			
		</grid>
	</grids>

  &DefaultButton;

