<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmcong" table="dmcong" fieldKey="ma_cong" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục công/thùng hàng" e="Container List"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_cong" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã container" e="Container Code"></text>
        </field>
        <field name="ten_cong" label="1" field="2" allowBlank="false" fieldType="PK" >
          <text v="Tên container" e="Container Name"></text>
        </field>
		    <field name="ma_loai" viewType="Lookup" label="1" field="1">
           <text v="Mã loại" e="Type Code"></text>
           <viewInfo lookupType="One" lookupId="dmloaicong" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_loai" lookupInfo="dmloaicong|ma_loai|ten_loai" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_loai" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
           <text v="" e=""></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[<enc>hxQPm/hYhpvPifcenBxj7nfT+X4T8oXvYmZx4Kpwn3fRRVZY+foYIow2vt1OHdzq0lG6PkDpvnlKR1ei3AR28UkawCxswedTww8YMZ/ax/1/BVJZ6K0wvLOosliedaWZUkrxTuSEhMwtxgzkHXAI9A1mM2gBVfjkBSeM0COLKt2Ta+bpGZ2rfhZhs1pGuYzdN4kAtnCVvZ+vFi7FsYrTkxPpJpY1c9Lum1AZQ708tto=</enc>]]>
      </text>
    </declare>
  </script>

</dir>