<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY HreScript SYSTEM "..\Include\XML\HreScript.xml">
]>

<dir id="hrecd" table="hrecd" fieldKey="id, line" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Công đoàn" e=""></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120" >
      <fields>
        <field name="id" dataType="N" fieldType="PK" label="1" field="1" format="0" hidden="true">
          <text v="ID" e="ID"></text>
        </field>
        <field name="line" dataType="N" fieldType="PK" label="1" field="1" format="0" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ngay_tu" dataType="D" allowBlank="false" label="1" field="1" >
          <text v="Ngày tham gia từ" e=""></text>
        </field>
        <field name="ngay_den" dataType="D" label="1" field="1" >
          <text v="Ngày tham gia đến" e=""></text>
        </field>
        <field name="tien" dataType="N" label="1" field="1" format="0">
          <text v="Số tiền" e="Amount"></text>
        </field>
        <field name="dien_giai" rows="3" label="1" field="-" >
          <text v="Diễn giải" e="Description"></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$hrecd(p){
  this.constructor(p);
}
dir$hrecd.prototype = new DirEvent();
dir$hrecd.prototype.afterInit = function(){
  var p = this._dir, pa = p.options.parent;
  if (p.options.action == 'NEW') p.valForm('id', pa.options._id);
}
]]>
    </text>
  </js>

  <script>
    &HreScript;
  </script>
</dir>