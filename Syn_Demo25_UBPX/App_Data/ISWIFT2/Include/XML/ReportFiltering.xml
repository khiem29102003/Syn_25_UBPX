<field name="report_filtering" label="1" field="[360]" inactivate="true" viewType="Combobox">
  <text v="Mẫu lọc báo cáo" e="Report Filtering Form"></text>
  <viewInfo>
    <options cache="false" query="select id, formname%l from sysreportform where user_id in (0, @@userId) and controller = '@@controller'">
      <option val="">
        <text v="Người dùng tự lọc" e="Users Filter"></text>
      </option>
    </options>
  </viewInfo>
</field>
<field name="report_filtering_cmd" nextRow="false" label="" field="[40]" viewType="Command">
  <text v="..." e="..."></text>
  <viewInfo>
    <options>
      <option val="add">
        <text v="Lưu mẫu mới" e="Create New Form"></text>
      </option>
      <option val="overwrite">
        <text v="Lưu đè vào mẫu đang chọn" e="Save Overwrite Selected Form"></text>
      </option>
      <option val="edit">
        <text v="Sửa lưu đè vào mẫu khác" e="Save Overwrite Other Form"></text>
      </option>
      <option val="delete">
        <text v="Xóa mẫu đang chọn" e="Delete Selected Form"></text>
      </option>
    </options>
  </viewInfo>
</field>