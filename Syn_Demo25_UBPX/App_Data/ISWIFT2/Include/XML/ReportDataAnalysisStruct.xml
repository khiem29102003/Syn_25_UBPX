<field name="data_analysis_struct" label="1" field="[360]" inactivate="true" viewType="Combobox">
  <text v="Mẫu phân tích DL" e="Data Analysis Form"></text>
  <viewInfo>
    <options cache="false" query="select pivotinfo, formname%l from sysreportpivot where (user_id in (0, @@userId) or form_type = 1) and controller = '@@controller' order by user_id, id">
      <option val="">
        <text v="Không phân tích" e="No Analysis"></text>
      </option>
    </options>
  </viewInfo>
</field>
<field name="data_analysis_struct_cmd" nextRow="false" label="" field="[40]" viewType="Command">
  <text v="..." e="..."></text>
  <viewInfo>
    <options>
      <option val="add">
        <text v="Tạo mẫu phân tích mới" e="Create New Analysis Form"></text>
      </option>
      <option val="edit">
        <text v="Sửa mẫu đang chọn" e="Edit Analysis Selected Form"></text>
      </option>
      <option val="delete">
        <text v="Xóa mẫu đang chọn" e="Delete Analysis Selected Form"></text>
      </option>
    </options>
  </viewInfo>
</field>