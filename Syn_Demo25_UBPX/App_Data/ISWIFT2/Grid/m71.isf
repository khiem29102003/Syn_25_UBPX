<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="m71" dirViewType="Grid" dirObjectType="Voucher" voucherCode="YC1" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phiếu yêu cầu xuất kho" e="Material Requisition"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="m71" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
        <field name="so_ct" width="100" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="ma_bp" width="120" >
          <text v="Mã bộ phận" e="Dept. Code"></text>
        </field>
        <field name="ten_bp" width="250" fieldType="EX" >
          <text v="Tên bộ phận" e="Dept. Name"></text>
        </field>
        <field name="t_so_luong" dataType="N" format="Qty" width="100">
          <text v="Số lượng" e="Qty"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="80" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="80" fieldType="EX" >
          <text v="Đơn vị" e="Customer Name"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc>ut7bmtX51o7ohlkZy11sVIaZnUwHEM+ebZUTVuvKujTLx2PmEIPuinqCEHbbvi5dpBE6w2M3Nh2OkjLOJ5WiHTnkpCkKcVuHb7pGQOjAK6gV2EiOqwNefPIS54qOAz3z1didC1d9wnGZsAa2kHUn4FtOr/mNHd57Fa/OzO07uV0QtMSoU+4XhScChYYxsUWtliwH7gVW0yTiQ44zszWwP9XBPSblE1Oq/rZBK59WZyQFXsarrRCS9X9tLPV4KRdC</enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>XymOY7dD2w2+zQLbB/WOXHW0O0XBK4WAlm2fkLnKA13+HeJfCPccExji/ML+/y27ipEcEvExF2nFPgzdAnu4a0zhv7XFCYrz4nGlAjjJNefPU3Oe6cUXDPLnryCxFO9Iwukh4aRg6EmqhoDqWuKUm1sA88Tu4D3Om5cqSinZ47KREZT1E0kHbMvfiL3cHnLZ</enc>]]>
    </text>
