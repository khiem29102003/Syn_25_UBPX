<dir id="dmkh" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục khách hàng" e="Customer List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit..."></subtitle>
  <grids>
    <grid table="dmkh" fieldKey="ma_kh" order="ma_kh" allowFilter="true" allowOrder="true" >
