        </field>
        <field name="ncc_yn" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Nhà cung cấp" e="Supplier"></text>
        </field>
        <field name="rg_code" width="120">
          <text v="Nhà cung cấp" e="Supplier"></text>
        </field>
      </fields>
      
