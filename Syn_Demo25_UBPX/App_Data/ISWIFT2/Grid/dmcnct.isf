		 <field name="ten_cnct" fieldType="PK" width="250">
          <text v="Tên chứng từ" e="Voucher name"></text>
        </field>
        <field name="status" width="150">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

