<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="sysrighthrempinfo" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phân quyền truy vấn thông tin nhân viên" e=""></title>
  <subtitle v="Phân quyền" e="Permission"></subtitle>
  <grids>
    <grid table="vsysuserinfo" fieldKey="user_id" order="user_id" allowFilter="true" allowOrder="true" key="(@@admin = 1 or user_id = @@userId)" >
      <fields>
        <field name="user_id" fieldType="PK" dataType="N" align="Right" width="40" filterType="Code" aliasName="a">
          <text v="ID" e="ID"></text>
        </field>
        <field name="username" width="120" filterType="Code" aliasName="a">
          <text v="Tên" e="Name"></text>
        </field>
        <field name="nickname" width="300" aliasName="a">
          <text v="Tên đầy đủ" e="Fullname"></text>
        </field>
      </fields>

      <buttons>
        <button id="permission">
          <text v="Phân quyền (Ctrl + E, Alt + E)" e="Permission (Ctrl + E, Alt + E)"></text>
        </button>
        <button id="view">
          <text v="$ViewToolbar" e="$ViewToolbar"></text>
        </button>
        <button id="find">
          <text v="$FindToolbar" e="$FindToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <script>
    <request code="CheckRight">
      <text>
        <![CDATA[<enc>r07gHy2a1YsWBN5sJQoNxb4xjNEuroiUKExJ8zUOMf1/3HeoNjMl0dyQw42aagBzvzLxRwI58/bs6KnGaOZsn61LJk243kVa1wYRuYLxclNbo+COgDbx/TdAcLYYm4Ao/Wwgk1UB0YrGbenJx0UdV1ht9eh/LBR9mk9K1UMTGjI=</enc>]]>
      </text>
    </request>
  </script>
</dir>