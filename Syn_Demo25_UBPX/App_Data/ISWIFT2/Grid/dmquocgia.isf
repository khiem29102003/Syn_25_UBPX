<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmquocgia" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục Quốc gia" e="Country Directory"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmquocgia" fieldKey="ma_qg" order="ma_qg" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_qg" fieldType="PK" width="120">
          <text v="Mã Quốc gia" e="Country code"></text>
        </field>
        <field name="ten_qg" width="250">
          <text v="Tên Quốc gia" e="Country name"></text>
        </field>
		 <field name="status" width="150">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
