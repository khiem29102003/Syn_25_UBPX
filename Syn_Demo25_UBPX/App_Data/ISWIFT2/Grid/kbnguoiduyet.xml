<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="kbnguoiduyet" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo người duyệt" e="Approving Officers List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="kbnguoiduyet" fieldKey="id" order="user_id, loai, ma_nt" allowFilter="true" allowOrder="true">
      <fields >
        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="loai" dataType="N" format="0">
          <text v="Loại" e="Type"></text>
        </field>
        <field name="user_id" dataType="N" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="username" width="100" fieldType="EX">
          <text v="Tên" e="Name"></text>
        </field>
        <field name="nickname" width="300" fieldType="EX">
          <text v="Tên đầy đủ" e="FullName"></text>
        </field>
        <field name="ma_nt" width="100">
          <text v="Ngoại tệ" e="Customer Code"></text>
        </field>
        <field name="tien" width="120" dataType="N" format="0">
          <text v="Tiền" e="Amount"></text>
        </field>
      </fields>

      &DefaultButton;
      <script>
        <query>
          <text>
            <![CDATA[
exec iswiftStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', 'left join sysuserinfo b on a.user_id = b.user_id', 'b.username, b.nickname', '@@key', '', @@filterKey, '', @pageIndex, 50, @@admin, @@userId
         ]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$kbnguoiduyet(f){
  this.constructor(f);
}
grid$kbnguoiduyet.prototype = new DirEvent();
grid$kbnguoiduyet.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
</dir>