<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmsvc" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục svc" e="SVC List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid id="0" table="dmsvc" fieldKey="ma_svc" order="ma_svc" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_svc" fieldType="PK" width="150">
          <text v="Mã svc" e="svc code"></text>
        </field>
		 <field name="ten_svc" fieldType="PK" width="250">
          <text v="Tên svc" e="svc name"></text>
        </field>
        <field name="status" width="150">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

