<dir id="dmbencang" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bến cảng" e="Port Directory"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbencang" fieldKey="ma_ben" order="ma_ben" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_ben" fieldType="PK" width="150">
          <text v="Mã bến cảng" e="Harbor Code"></text>
        </field>
        <field name="ten_ben" width="250">
          <text v="Tên bến cảng" e="Harbor name"></text>
        </field>
		<field name="status" width="150">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

