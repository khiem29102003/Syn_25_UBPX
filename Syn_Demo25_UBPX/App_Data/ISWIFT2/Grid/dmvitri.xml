<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="vdmvitri" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục vị trí kho hàng" e="Location List"></title>
  <subtitle v="Cập nhật vị trí: thêm, sửa, xóa..." e="Add, Edit, Delete Location..."></subtitle>
  <grids>
    <grid table="vdmvitri" fieldKey="ma_kho, ma_vi_tri" order="ma_kho, ma_vi_tri" allowFilter="true" allowOrder="true">
      <fields>
        <field name="ma_kho" fieldType="PK" width="100">
          <text v="Mã kho" e="Site"></text>
        </field>
        <field name="ten_kho" width="300">
          <text v="Tên kho" e="Site Name"></text>
        </field>
        <field name="ma_vi_tri" fieldType="PK" width="100">
          <text v="Mã vị trí" e="Location"></text>
        </field>
        <field name="ten_vi_tri" width="300">
          <text v="Tên vị trí" e="Description"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$vdmvitri(f){
  this.constructor(f);
}
grid$vdmvitri.prototype = new DirEvent();
grid$vdmvitri.prototype.afterInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
</dir>