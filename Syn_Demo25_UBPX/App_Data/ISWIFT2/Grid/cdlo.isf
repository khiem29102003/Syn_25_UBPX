<dir id="cdlo" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Vào tồn kho đầu kỳ" e="Stock Opening Balance"></title>
  <subtitle v="Vào tồn kho đầu kỳ năm {nam}" e="Stock Opening Balance Year {nam}"></subtitle>
  <grids>
    <grid table="vcdlo" fieldKey="nam, ma_vt, ma_kho, ma_vi_tri, ma_lo" order="nam, ma_vt, ma_kho, ma_vi_tri, ma_lo" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="nam" fieldType="PK" width="0" hidden="true" dataType="I">
          <text v="Năm" e="Năm"></text>
        </field>
        <field name="ma_vt" fieldType="PK" width="120">
          <text v="Mã vật tư" e="Item"></text>
        </field>
        <field name="ten_vt" width="300">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
        <field name="ma_kho" fieldType="PK" width="120">
          <text v="Mã kho" e="Site"></text>
        </field>
        <field name="ma_vi_tri" fieldType="PK" width="120">
          <text v="Mã vị trí" e="Location"></text>
        </field>
        <field name="ma_lo" fieldType="PK" width="120">
          <text v="Mã lô" e="Lot"></text>
        </field>
        <field name="ton00" format="Qty" dataType="N" width="120">
          <text v="Tồn đầu" e="Opening Quantity"></text>
        </field>
        <field name="du00" format="Amount" dataType="N" width="120">
          <text v="Dư đầu" e="Opening Balance"></text>
        </field>
        <field name="du_nt00" format="FCAmount" dataType="N" width="120">
          <text v="Dư đầu ngoại tệ" e="FC Opening Balance"></text>
        </field>
      </fields>
      
      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="edit">
          <text v="$EditToolbar" e="$EditToolbar"></text>
