<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmtau" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục tàu" e="List of ships"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmtau" fieldKey="ma_tau" order="ma_tau" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_tau" fieldType="PK" width="150">
          <text v="Mã tàu" e="Train code"></text>
        </field>
        <field name="ten_tau" width="250">
          <text v="Tên tàu" e="Train name"></text>
        </field>
		<field name="ten_tau2" width="250">
          <text v="Tên khác" e="Aother Name"></text>
        </field>
		<field name="ma_loai" fieldType="PK" width="150">
          <text v="Mã loại" e="Type Code"></text>
        </field>
		<field name="ma_qg" width="120">
          <text v="Mã quốc gia" e="Country code"></text>
        </field>
		<field name="so_imo" fieldType="PK" width="120">
          <text v="Số imo" e="imo"></text>
        </field>
		<field name="hieu_tau" fieldType="PK" width="120">
          <text v="Hiệu tàu" e="Ship Sign"></text>
        </field>
		<field name="so_dk" fieldType="PK" width="120">
          <text v="Số đăng kí" e="Registration Number"></text>
        </field>
		<field name="ma_cang" fieldType="PK" width="120">
          <text v="Mã cảng" e="Port Code"></text>
        </field>
		<field name="ma_hang" fieldType="PK" width="120">
          <text v="Mã hãng" e="Brand Code"></text>
        </field>
		<field name="status" width="150">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>bsvaIawgtKJzcFHsQ94P0J6pA1k+lc4BH5LY5r27qnnnv7SQNft/Q7GH0YVR61lA6O167dBVA1R8eEZtUE8X1olcsjws5RRTgpeXkfGtXTHkFRP1lBQj/Wutja/FWzuouTIcF+kYZXrO/8tF3wkf9TT5rfl6IDxCjS+ZO8uKBpVweN58KJzMxYdrMNgdxA/V</enc>]]>
    </text>
  </js>
</dir>