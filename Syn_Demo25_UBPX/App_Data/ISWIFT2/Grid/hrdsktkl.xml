<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="hrdsktkl" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách khen thưởng kỷ luật" e="Employee List"></title>
  <subtitle v="Từ ngày {ngay_ct_tu} đến ngày {ngay_ct_den}..." e="From {ngay_ct_tu} To {ngay_ct_den}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_nv" operation="=" width="100">
          <text v="Mã nhân viên" e="Employee ID"></text>
        </field>
        <field name="ten_nv" width="250" aliasName="b">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
        <field name="ten_bp" width="150">
          <text v="Bộ phận" e="Department"></text>
        </field>
        <field name="ten_vtr" width="150">
          <text v="Vị trí" e="Position"></text>
        </field>
        <field name="ngay_ky" width="100" dataType="D">
          <text v="Ngày ký" e=""></text>
        </field>
        <field name="noi_dung" width="300">
          <text v="Nội dung" e="Content"></text>
        </field>
        <field name="tien2" format="Amount" dataType="N" width="120">
          <text v="Số tiền" e="Amount"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$hrdsktkl(f){
  this.constructor(f);
}
grid$hrdsktkl.prototype = new DirEvent();
grid$hrdsktkl.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$hrdsktkl.prototype.beforeInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
</dir>