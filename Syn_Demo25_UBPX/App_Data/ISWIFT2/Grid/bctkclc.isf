<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="bctkclc" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo cáo tồn kho chậm luân chuyển" e="Slow-moving Item Report" />
  <subtitle v="Ngày: {ngay_ct1}, số ngày luân chuyển: {thoi_gian}" e="Date: {ngay_ct1},  No. of Slow-Moving Date: {thoi_gian}"></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_vt" width="100">
          <text v="Mã vật tư" e="Item Code"></text>
        </field>
        <field name="ten_vt" width="350">
          <text v="Tên vật tư" e="Item Name"></text>
        </field>
        <field name="ngay_xuat" width="100" dataType="D" align="Center">
          <text v="Ngày xuất cuối" e="Last Issue"></text>
        </field>
        <field name="dvt" width="80">
          <text v="Đvt" e="UOM"></text>
        </field>
        <field name="so_luong" dataType="N" format="Qty" width="120">
          <text v="Số lượng tồn" e="Closing Q'ty"></text>
        </field>
        <field name="tien_nt" dataType="N" format="Amount" width="120">
          <text v="Tiền nt" e="FC Amount"></text>
        </field>
        <field name="tien" dataType="N" format="FCAmount" width="120">
          <text v="Tiền" e="Amount"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

</dir>