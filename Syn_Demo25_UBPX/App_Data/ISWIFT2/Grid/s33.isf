<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="s33" dirViewType="Grid" dirObjectType="Voucher" voucherCode="YG3" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Yêu cầu báo giá dịch vụ" e="Quotation Services"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="s33" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
        <field name="so_ct" width="80" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="80" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="ma_kh" width="0" >
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="0" fieldType="EX" >
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>     
		<field name="ma_noi_di" width="100" hidden="true">
          <text v="Nơi đi" e="Origin"></text>
        </field>
		<field name="ten_noi_di" width="150" fieldType="EX">
		  <text v="Nơi đi " e="Origin Name"></text>
		</field>
		<field name="ma_dk_gh" width="0" hidden="true">
          <text v="ĐK giao hàng" e="Traffic term"></text>
        </field>
		<field name="ten_dk_gh" width="80" fieldType="EX" >
          <text v="ĐK giao hàng" e="Traffic term"></text>
        </field>
		
		<field name="ma_noi_den" width="100" hidden="true" >
          <text v="Nơi đến" e="Destination"></text>
        </field>	
		<field name="ten_noi_den" width="150" fieldType="EX" >
		  <text v="Nơi đến " e="Destination Name"></text>
		</field>		
			
		<field name="ma_dk_nh" width="0" hidden="true">
          <text v="ĐK nhận hàng" e="Traffic term"></text>
        </field>	
		<field name="ten_dk_nh" width="80" fieldType="EX" >
          <text v="ĐK nhận hàng" e="Traffic term"></text>
        </field>	
		
		<field name="ngay_hl" width="100" dataType="D">
          <text v="Ngày dự đi" e="Effective  date"></text>
        </field>
		<field name="ngay_hld" width="100" dataType="D">
          <text v="Ngày dự đến" e="Expiry  date"></text>
        </field>
		<field name="ma_nt" width="0" >
          <text v="Ngoại tệ" e="Currency"></text>
        </field>
		
		 <field name="t_so_luong" dataType="N" format="FCAmount" width="100">
          <text v="Tổng số cont." e="Total Container"></text>
        </field>
        <field name="t_tong_trong" dataType="N" format="FCAmount" width="100">
          <text v="Tổng trọng lượng" e="Total amount"></text>
        </field>
		<field name="dien_giai" width="200">
          <text v="Ghi chú" e="Note"></text>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="80" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="80" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
