<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
select a.unit_id, isnull(u.ma_so_thue, '') as ms_thue, a.so_ct, a.so_ct2 as ky_hieu, a.ma_kh, a.ong_ba as nguoi_mua_hang, b.ten_kh as ten_kh, B.dia_chi, b.ma_so_thue, b.dien_thoai, isnull(c.ten_tt, '') as ten_tt, a.ma_tt, a.dien_giai,
	isnull(d.ten_pttt, '') as ten_pttt, cast(a.status as char(1)) as status, a.ma_nt, dbo.iswiftFunctionReadCurrency(a.ma_nt, a.t_tt_nt) as t_tt_in_word
	  , replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct,0 t_phi,a.t_tien_nt2,a.t_tt_nt,u.ten_unit

	from m54 a with(nolock)
		left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
		left join dmtt c on a.ma_tt = c.ma_tt
		left join dmpttt d on a.ma_pttt = d.ma_pttt
		left join sysunit u on a.unit_id = u.unit_id
	where a.id = @id

select line as stt, a.ma_vt, b.ten_vt, a.so_luong, a.dvt, a.gia_nt2 as gia2, a.tien_nt2 as tien2,a.thue_suat,a.tl_ck,a.thue,a.ck,a.thue_nt,a.ck_nt
	from d54 a with(nolock) left join dmvt b with(nolock) on a.ma_vt = b.ma_vt
	where a.id = @id
]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="m55_1" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Phiếu bán hàng (.pdf)" e="Payment Invoice"></text>
    </form>
    <form id="020" fileName="m55_1" fileType="rdlc" exportExt="docx" image="word">
      <text v="Phiếu bán hàng (.docx)" e="Payment Invoice "></text>
    </form>
	 <form id="030" fileName="m55_1" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Phiếu bán hàng (.xlsx)" e="Payment Invoice"></text>
    </form>	
  </forms>

  <fields>
    <field name="isFC" type="B">
      <text v="False" e="False"/>
    </field>
    <field name="title" type="C">
      <text v="HÓA ĐƠN BÁN HÀNG" e="SALES INVOICE"/>
    </field>
    <field name="h_day" type="C">
      <text v="Ngày" e="Date"/>
    </field>
    <field name="h_month" type="C">
      <text v="tháng" e="Month"/>
    </field>
    <field name="h_year" type="C">
      <text v="năm" e="Year"/>
    </field>

    <field name="h_so_seri" type="C">
      <text v="Ký hiệu" e="Serial No."/>
    </field>
    <field name="h_so_ct" type="C">
      <text v="Số" e="Invoice No."/>
    </field>

    <field name="h_don_vi_ban" type="C">
      <text v="Đơn vị bán hàng:" e="Seller:"/>
    </field>

    <field name="h_nguoi_mua" type="C">
      <text v="Họ tên người mua hàng:" e="Buyer:"/>
    </field>
    <field name="h_don_vi_mua" type="C">
      <text v="Tên đơn vị:" e="Company:"/>
    </field>
    <field name="h_ma_so_thue" type="C">
      <text v="Mã số thuế:" e="Tax Code:"/>
    </field>
    <field name="h_dia_chi" type="C">
      <text v="Địa chỉ:" e="Address:"/>
    </field>

    <field name="h_company" type="C">
      <text v="Đơn vị" e="Company"/>
    </field>
    <field name="h_address" type="C">
      <text v="Địa chỉ:" e="Address:"/>
    </field>
    <field name="h_kh" type="C">
      <text v="Tên khách hàng:" e="Customer Name:"/>
    </field>
    <field name="h_noi_giao" type="C">
      <text v="Nơi giao" e="Ship - to"/>
    </field>
 <field name="h_ma_vt" type="C">
      <text v="Mã" e="Code"/>
    </field>
    <field name="h_vt" type="C">
      <text v="Vật tư" e="Item"/>
    </field>
    <field name="h_dvt" type="C">
      <text v="Đvt" e="UOM"/>
    </field>
    <field name="h_sl" type="C">
      <text v="Số lượng" e="Quantity"/>
    </field>
    <field name="h_gia" type="C">
      <text v="Giá" e="Price"/>
    </field>
    <field name="h_tien" type="C">
      <text v="Tiền" e="Amount"/>
    </field>
    <field name="h_total" type="C">
      <text v="Cộng tiền bán hàng hóa, dịch vụ:" e="Total Amount:"/>
    </field>
    <field name="h_bang_chu" type="C">
      <text v="Bằng chữ:" e="In words:"/>
    </field>
    <field name="h_kiem_tra" type="C">
      <text v="(Cần kiểm tra, đối chiếu khi lập, giao, nhận hóa đơn)" e="(Please do check, compare when issuing, delivering and receiving invoice)"/>
    </field>
    <field name="h_nguoi_mua_hang" type="C">
      <text v="Người mua hàng" e="Buyer"/>
    </field>
    <field name="h_nguoi_ban_hang" type="C">
      <text v="Người bán hàng" e="Seller"/>
    </field>
	
	<field name="h_thue" type="C">
      <text v="Thuế (%)" e="Tax (%)"/>
    </field>
	<field name="h_ck" type="C">
      <text v="C.Khấu (%)" e="Discount (%)"/>
    </field>
	<field name="h_con_lai" type="C">
      <text v="Tổng tiền" e="Total"/>
    </field>
	<field name="h_chi_phi" type="C">
      <text v="Tổng chi phí:" e="Total Cost:"/>
    </field>
	<field name="h_tong_cong" type="C">
      <text v="Tổng cộng:" e="Total All Amount:"/>
    </field>
	<field name="h_ly_do" type="C">
      <text v="Lý do xuất kho:" e="Note"/>
    </field>
	<field name="h_ma_kho" type="C">
      <text v="Kho" e="Warehouse"/>
    </field>
	<field name="h_so_luong" type="C">
      <text v="Số lượng" e="Warehouse"/>
    </field>
  </fields>

</report>