<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
]>

<dir id="m71" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phiếu yêu cầu xuất kho" e="Material Requisition"></title>

  <grids>
    <grid table="m71" fieldKey="id" fieldName="so_ct" order="id" allowFilter="true" allowOrder="true">
      <fields>
        <field name="id" dataType="N" fieldType="PK" width="100" format="0" hidden="true">
          <text v="ID" e="ID"></text>
        </field>
        <field name="so_ct" width="100" fieldType="RF" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="ma_bp" width="120" >
          <text v="Mã bộ phận" e="Department Code"></text>
        </field>
        <field name="ten_bp" width="250" fieldType="EX" >
          <text v="Tên bộ phận" e="Department Name"></text>
        </field>
        <field name="t_so_luong" dataType="N" format="Qty" width="100">
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
      </fields>
      <script>
        <query>
          <text>
            <![CDATA[
declare @key2 nvarchar(3000)
select @key2 = @lookupKey + case when @val = '' then '' else ' and (@@fieldKey like N''' + dbo.ISWIFTFunctionReplaceSQLValue(@val) + '%'' or @@fieldName like N''' + dbo.ISWIFTFunctionReplaceSQLValue(@val) + '%'')' end
exec ISWIFTStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', 'left join dmbp b on a.ma_bp = b.ma_bp', 'b.ten_bp', N'@@key', @key2, @@filterKey, '', @pageIndex, 10, @@admin, @@userId
         ]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>
</dir>