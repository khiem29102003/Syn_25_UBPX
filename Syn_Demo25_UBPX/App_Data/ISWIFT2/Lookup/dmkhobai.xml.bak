<?xml version="1.0" encoding="utf-8"?>

<dir id="dmkhobai" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục kho bãi" e="Warehouse/Site List"></title>
  <grids>
    <grid table="dmkhobai" fieldKey="ma_kho" fieldName="ten_kho" order="ma_kho" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_kho" fieldType="PK" width="100" filterType="Code" >
          <text v="Mã kho" e="Warehouse code"></text>
        </field>
        <field name="ten_kho" width="250">
          <text v="Tên kho" e="Warehouse name"></text>
        </field>
      </fields>
    </grid>
  </grids>
</dir>