<?xml version="1.0" encoding="utf-8"?>

<dir id="dmtt" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục thanh toán" e="Department List"></title>
  <grids>
    <grid table="dmtt" fieldKey="ma_tt" fieldName="ten_tt" order="ma_tt" allowFilter="true" allowOrder="true" key="" >
      <fields>
        <field name="ma_tt" fieldType="PK" width="100" filterType="Code" >
          <text v="Mã thanh toán" e="Department Code"></text>
        </field>
        <field name="ten_tt" width="250">
          <text v="Tên thanh toán" e="Department Name"></text>
        </field>
        <field name="han_tt" dataType="N" format="0" width="120">
          <text v="Hạn thanh toán" e="Payment Day(s)"></text>
        </field>
      </fields>
    </grid>
  </grids>
</dir>