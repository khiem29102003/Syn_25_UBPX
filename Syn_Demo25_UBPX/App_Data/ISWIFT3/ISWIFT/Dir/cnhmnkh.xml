<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="cnhmnkh" table="cnhmnkh" fieldKey="ma_kh, ngay_hl" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Cập nhật hạn mức nợ khách hàng" e="Cập nhật hạn mức nợ khách hàng"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_kh" allowBlank="false" viewType="Lookup" label="1" field="1" fieldType="PK">
          <text v="Mã khách hàng" e="Item Code"></text>
          <viewInfo lookupType="One" lookupId="dmkhkt" lookupKey="status=1 and ma_kh_kt &lt;&gt; ''" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh_kt|ten_kh" />
        </field>
        <field name="ten_kh" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ngay_hl" label="1" field="1" allowBlank="false" dataType="D" fieldType="PK">
          <text v="Từ ngày" e="Từ ngày"></text>
        </field>
        <field name="han_muc_no" label="1" field="1" dataType="N" format="Amount">
          <text v="Hạn mức nợ" e="Hạn mức nợ"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" valueDefault="1">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$cnhmnkh(p){
  this.constructor(p);
}
dir$cnhmnkh.prototype = new DirEvent();
dir$cnhmnkh.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Khách hàng và ngày hiệu lực đã tồn tại trong cơ sở dữ liệu' else N'Khách hàng và ngày hiệu lực tồn tại trong cơ sở dữ liệu' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Khách hàng và ngày hiệu lực tồn tại trong cơ sở dữ liệu' else N'Khách hàng và ngày hiệu lực tồn tại trong cơ sở dữ liệu' end
         ]]>
      </text>
    </declare>
  </script>
</dir>