<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="hrdmnn" table="hrdmnn" fieldKey="ma_nn" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục ngoại ngữ" e="Language List"></title>
  <title0 v="Thêm" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_nn" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã ngoại ngữ" e="Language"></text>
        </field>
        <field name="ten_nn" allowBlank="false" label="1" field="-">
          <text v="Tên ngoại ngữ" e="Description"></text>
        </field>
        <field name="ten_nn2" label="1" field="-">
          <text v="Tên khác" e="Other name"></text>
        </field>

        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$hrdmnn(p){
  this.constructor(p);
}
dir$hrdmnn.prototype = new DirEvent();
dir$hrdmnn.prototype.afterInit = function(){
  var p = this._dir, pa = p.options.parent;
}
]]>
    </text>
  </js>

  <script>

    <query>
      <text>
        <![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table
drop table #@@table
]]>
      </text>
    </query>

  </script>

  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã ngoại ngữ đã có hoặc lồng nhau trong danh mục ngoại ngữ." e="The language is invalid or already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã ngoại ngữ đã có hoặc lồng nhau trong danh mục ngoại ngữ." e="The language is invalid or already exists."/>
    </message>
  </messages>

</dir>