<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="hrdmca" table="hrdmca" fieldKey="ma_ca" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục ca làm việc" e="Working Shift List"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120"  >
      <fields>
        <field name="ma_ca" format="U" fieldType="PK" allowBlank="false" label="1" field="1" clientDefault="true">
          <text v="Mã ca" e="Mã ca"></text>
        </field>
        <field name="ten_ca" label="1" field="-" allowBlank="false">
          <text v="Tên ca" e="Description"></text>
        </field>
        <field name="ten_ca2" label="1" field="-">
          <text v="Tên khác" e="Other Name"></text>
        </field>
        <field name="nh_ca" viewType="Lookup" label="1" field="1">
          <text v="Nhóm ca" e="Group"></text>
          <viewInfo lookupType="One" lookupId="hrdmnhca" lookupKey="status=1" lookupCheck="1 = 1" lookupRef="ten_nh_ca" lookupInfo="hrdmnhca|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_ca" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="kieu_lt" viewType="Combobox" label="1" field="2" >
          <text v="Kiểu làm tròn" e="Rounding Type"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="0 - Không làm tròn" e="1 - Not Round"></text>
              </option>
              <option val="1">
                <text v="1 - Làm tròn lên" e="1 - Up"></text>
              </option>
              <option val="2">
                <text v="2 - Làm tròn xuống" e="2 - Down"></text>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="khoang_cach" label="1" field="1" allowBlank="true" format="Qty" dataType="N" importable="40">
          <text v="Block (phút)" e="Block (Minutes)"></text>
        </field>
        <field name="phut_lech" label="1" field="1" allowBlank="true" format="Qty" dataType="N" importable="40">
          <text v="Phút lệch" e=""></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="250" columns="120,120,240" >
      <text v="Chi tiết ca" e="Detail"></text>
      <fields>
        <field name="hrdmca2" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>

  </forms>

  <grids>
    <grid id="hrdmca2" table="hrdmca2" fieldKey="ma_ca, line" order="line" allowFilter="true" allowOrder="true" readOnly="false">
      <fields>
        <field name="ma_ca" foreignField="ma_ca" fieldType="PK" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_ca_ct" width="100" format="U" hidden ="true" >
          <text v="Ca chi tiết" e="Detailed Shift"></text>
        </field>
        <field name="dien_giai" width="150" readOnly="false" >
          <text v="Tên chi tiết ca" e="Description"></text>
        </field>
        <field name="gio_tu" allowBlank="false" viewType="Time" align="Center" width="100" readOnly="false">
          <text v="Giờ vào" e="Time In"></text>
        </field>
        <field name="hs_tu" dataType="B" width="80" readOnly="false">
          <text v="Liên ngày" e="Next Day"></text>
        </field>
        <field name="gio_den" allowBlank="false" viewType="Time" align="Center" width="100" readOnly="false">
          <text v="Giờ ra" e="Time Out"></text>
        </field>
        <field name="hs_den" dataType="B" width="80" readOnly="false">
          <text v="Liên ngày" e="Next Day"></text>
        </field>
        <field name="so_phut_tt" width="120" readOnly="false" dataType="N" format="2">
          <text v="Số phút tối thiểu" e="Minimum Minutes"></text>
        </field>
        <field name="so_gio_td" width="100" readOnly="false" dataType="N" format="2">
          <text v="Số giờ tối đa" e="Maximum Hours"></text>
        </field>
        <field name="so_phut_tre" width="100" readOnly="false" dataType="N" format="2">
          <text v="Số phút trễ" e=""></text>
        </field>
        <field name="so_phut_som" width="100" readOnly="false" dataType="N" format="2">
          <text v="Số phút ra sớm" e="Early Out"></text>
        </field>
        <field name="so_phut_them" width="100" readOnly="false" dataType="N" format="2">
          <text v="Số phút thêm" e="Số phút thêm"></text>
        </field>
        <field name="ma_cong" format="U" allowBlank="false" width="100" readOnly="false">
          <text v="Mã công" e="Workday Code"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[
select @@fields from @@table a where @@key order by a.line
         ]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

&DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$hrdmca(p){
  this.constructor(p);
}
dir$hrdmca.prototype = new DirEvent();
dir$hrdmca.prototype.afterInit = function(){
  var p = this._dir, g = p.options.parent;
}
         ]]>
    </text>
  </js>

  <script>
    <beforesave>
      <text>
        <![CDATA[
if exists(select 1 from @@@table2 where ma_ca_ct = '')
begin
	declare @min_ca_ct varchar(6)
	select @min_ca_ct = min(ma_ca_ct) from @@@table2
	if isnull(@min_ca_ct, '') = '' update @@@table2 set ma_ca_ct = right(rtrim(100 + line), 2)
	else update @@@table2 set ma_ca_ct = right(rtrim(cast(@min_ca_ct as int) + 100 + line), 2)
end
         ]]>
      </text>
    </beforesave>
    <deleted>
      <text>
        <![CDATA[
delete @@table2 where ma_ca = @ma_ca
]]>
      </text>
    </deleted>
    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]

delete @@table2 where ma_ca = @@old_ma_ca
insert @@table2 select * from @@@table2
         ]]>
      </text>
    </updated>

    <inserted>
      <text>
        <![CDATA[
delete @@table2 where [%whereFieldKey]
insert @@table2 select * from @@@table2
]]>
      </text>
    </inserted>

  </script>
  <messages>
    <message val="codeExistsNewMsg">
      <text v="Ca làm việc đã được khai báo trong danh mục." e="This item already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Ca làm việc đã được khai báo trong danh mục." e="This item already exists."/>
    </message>
    <message val="detailDuplicate">
      <text v="Chi tiết ca không được lặp lại ở chi tiết." e="Detailed Shift Repeat In Detail."/>
    </message>
  </messages>

</dir>