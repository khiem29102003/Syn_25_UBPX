        </field>
        <field name="suc_khoe" label="1" field="-" >
          <text v="Sức khỏe" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$hrettsk(p){
  this.constructor(p);
}
dir$hrettsk.prototype = new DirEvent();
dir$hrettsk.prototype.afterInit = function(){
  var p = this._dir, pa = p.options.parent;
  if (p.options.action == 'NEW') p.valForm('id', pa.options._id);
}
]]>
    </text>
  </js>

  <script>
    &HreScript;
  </script>
