<dir id="dmvt" table="" height="" fieldKey="ma_nh" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120"  >
      <fields>
        
        <field name="nh_vt1" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Nhóm 1" e="Group 1"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'VT1' and status=1" lookupCheck="ma_loai_nh = 'VT1'" lookupRef="ten_nh_vt1" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_vt1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_vt2" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Nhóm 2" e="Group 2"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'VT2' and status=1" lookupCheck="ma_loai_nh = 'VT2'" lookupRef="ten_nh_vt2" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_vt2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_vt3" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Nhóm 3" e="Group 3"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'VT3' and status=1" lookupCheck="ma_loai_nh = 'VT3'" lookupRef="ten_nh_vt3" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_vt3" nextRow="false" fieldType="EX"  readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <script>
