<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
  <!ENTITY ReportFilterUnit SYSTEM "..\Include\XML\ReportFilterUnit.xml">
]>

<dir id="ctgiatb" dirViewType="Dialog" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Tính giá trung bình" e="Calculate Average Cost"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120">
      <fields>
        <field name="ky" label="1" field="1" format="-1" maxLength="2" allowBlank="false" dataType="I" aliasName="@CurrMonth">
          <text v="Kỳ" e="Period"></text>
        </field>
        <field name="nam" label="1" field="1" format="-1" maxLength="4" allowBlank="false" dataType="I" aliasName="@CurrYear">
          <text v="Năm" e="Year"></text>
        </field>
        <field name="ma_nh" hidden="true" viewType="Lookup" label="1" field="1">
          <text v="Nhóm kho" e="Site Group"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'NKH' and status=1" lookupRef="ten_nh" />
        </field>
        <field name="ten_nh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" >
          <text v="" e=""></text>
        </field>
        <field name="ma_kho" viewType="Lookup" label="1" field="1">
          <text v="Mã kho" e="Site"></text>
          <viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kho" lookupExactValue="1" />
        </field>
        <field name="ten_kho" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="ma_vt" viewType="Lookup" label="1" field="1">
          <text v="Mã vật tư" e="Item"></text>
          <viewInfo lookupType="One" lookupId="dmvt" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_vt" lookupExactValue="1" />
        </field>
        <field name="ten_vt" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        &ReportFilterUnit;
        <field name="tao_px" viewType="Combobox" dataType="I" clientDefault="true" valueDefault="1" inactivate="true" label="1" field="2" >
          <text v="Tạo chênh lệch" e="Create Issue"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Không tạo" e="None"/>
              </option>
              <option val="1">
                <text v="Tạo khi không còn tồn kho" e="When No Inventory"/>
              </option>
              <option val="2">
                <text v="Tất cả các trường hợp" e="All"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="update_px" viewType="Combobox" dataType="I" valueDefault="2" clientDefault="true" inactivate="true" label="1" field="2" >
          <text v="Cập nhật giá" e="Price Update"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="Chỉ tính giá" e=""/>
              </option>
              <option val="2">
                <text v="Tính và cập nhật giá vào kho" e=""/>
              </option>
              <option val="3">
                <text v="Chỉ cập nhật giá vào kho" e=""/>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>


  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$ctgiatb(p){
  this.constructor(p);
}
filter$ctgiatb.prototype = new DirEvent();
filter$ctgiatb.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <script>
    <processing>
      <text>
        <![CDATA[
exec ss_Avg_CalcCost @ky, @nam, @ma_nh, @ma_kho, @ma_vt, @tao_px, @update_px, @ma_unit, @@userId, @@admin
select '$Processed' as message
        ]]>
      </text>
    </processing>
  </script>
</dir>