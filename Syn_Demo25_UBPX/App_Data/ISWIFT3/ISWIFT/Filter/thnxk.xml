<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
  <!ENTITY ReportFilterItemGroup SYSTEM "..\Include\XML\ReportFilterItemGroup.xml">
  <!ENTITY ReportFilterStockType SYSTEM "..\Include\XML\ReportFilterStockType.xml">
  <!ENTITY ReportJSLoading SYSTEM "..\Include\XML\ReportJSLoading.xml">
  <!ENTITY ReportFilterUnit SYSTEM "..\Include\XML\ReportFilterUnit.xml">
  <!ENTITY ReportFiltering SYSTEM "..\Include\XML\ReportFiltering.xml">
  <!ENTITY ReportDataAnalysisStruct SYSTEM "..\Include\XML\ReportDataAnalysisStruct.xml">

]>

<dir id="thnxk" table="" height="" fieldKey="id" dirViewType="Dialog" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Tổng hợp nhập/xuất kho" e="Receipt/Issue Summary"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
        <field name="ngay_ct1" label="1" field="1" aliasName="@DFDFrom" clientDefault="true" allowBlank="false" dataType="D">
          <text v="Ngày từ/đến" e="Date From/To"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" aliasName="@DFDTo" clientDefault="true" allowBlank="false" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>
        <field name="so_ct1"  label="1" field="1" operation="a.so_ct &gt;= N'%s'">
          <text v="Số c/từ (từ/đến)" e="Voucher Number"></text>
        </field>
        <field name="so_ct2"  label="" nextRow="false" field="1" operation="a.so_ct &lt;= N'%s'">
          <text v="" e=""></text>
        </field>
        <field name="ct_nxd" viewType="Combobox"  operation="=" label="1" field="[360]" >
          <text v="Nhập/xuất" e="Receipt/Issue"></text>
          <viewInfo>
            <options>
              <option val="">
                <text v="Tất cả" e="All"/>
              </option>
              <option val="1">
                <text v="Nhập kho" e="Receipt"></text>
              </option>
              <option val="2">
                <text v="Xuất kho" e="Issue"/>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="0" columns="120,120,120,120,120"  >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="ma_kho" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Mã kho" e="Site"></text>
          <viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kho" />
        </field>
        <field name="ten_kho" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="ma_khon" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Mã kho đ/c" e="Site Transfer"></text>
          <viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_khon" />
        </field>
        <field name="ten_khon" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="ma_vt" viewType="Lookup" operation="like" label="1" field="1">
          <text v="Mã vật tư" e="Item"></text>
          <viewInfo lookupType="One" lookupId="dmvt" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_vt" />
        </field>
        <field name="ten_vt" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="ma_lo" viewType="Lookup" operation="like" label="1" field="1">
          <text v="Mã lô" e="Lot"></text>
          <viewInfo lookupType="One" lookupId="dmlo2" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_lo" />
        </field>
        <field name="ten_lo" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="ma_vi_tri" viewType="Lookup" operation="like" label="1" field="1">
          <text v="Mã vị trí" e="Position"></text>
          <viewInfo lookupType="One" lookupId="dmvitri" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_vi_tri" />
        </field>
        <field name="ten_vi_tri" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="ma_kh" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Mã đối tượng" e="Customer"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        &ReportFilterItemGroup;
        <field name="dien_giai" label="1" field="3" operation="a.dien_giai like N'%%s%'">
          <text v="Diễn giải" e="Voucher Number"></text>
        </field>
        &ReportFilterUnit;
        &ReportFilterStockType;
        <field name="mau_bc" dataType="I" viewType="Combobox" valueDefault="2" label="1" field="[360]" >
          <text v="Mẫu báo cáo" e="Report Form"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="Mẫu số lượng" e="Quantity Form"></text>
              </option>
              <option val="2">
                <text v="Mẫu in số lượng và giá trị" e="Quantity and Values Form"/>
              </option>
              <option val="3">
                <text v="Mẫu in số lượng và giá trị ngoại tệ" e="Quantity and FC Values Form"/>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>

    <form tabPageIndex="2" gravity="MiddleLeft" height="0" columns="120,120,120,120,120"  >
      <text v="Khác" e="Other"></text>
      <fields>
        <field name="group_by" viewType="Combobox" valueDefault="" label="1" field="3" >
          <text v="Nhóm theo" e="Group By"></text>
          <viewInfo>
            <options query="select id, name%l from syscolumncodes where xgroup = 3 and xindex > 0">
              <option val="">
                <text v="Không phân nhóm" e="No Group"></text>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="ps_dc" viewType="Combobox" valueDefault="1" label="1" field="3" >
          <text v="Tính ps điều chuyển" e="Include Transfers"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Không tính phát sinh điều chuyển kho" e="No Include Transfers"/>
              </option>
              <option val="1">
                <text v="Tính phát sinh điều chuyển kho" e="Include Transfers"/>
              </option>
            </options>
          </viewInfo>
        </field>
        &ReportFiltering;
        &ReportDataAnalysisStruct;
      </fields>
    </form>

  </forms>


  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$thnxk(p){
  this.constructor(p);
}
filter$thnxk.prototype = new DirEvent();
filter$thnxk.prototype.afterInit = function(){
  var p = this._dir, ev = this;
}
         ]]>
    </text>
  </js>

  <script>
    <processing>
      <text>
        <![CDATA[
EXEC ss_thnxk @ngay_ct1, @ngay_ct2, @ps_dc, @strJoin, @strFinding, @group_by, @loai_du_lieu, @ma_unit, '@@lan', @@userId, @@admin
        ]]>
      </text>
    </processing>
    &ReportJSLoading;
  </script>
</dir>