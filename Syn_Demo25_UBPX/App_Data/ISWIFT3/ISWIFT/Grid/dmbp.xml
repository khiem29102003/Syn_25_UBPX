  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbp" fieldKey="ma_bp" order="ma_bp" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_bp" fieldType="PK" width="120">
          <text v="Mã bộ phận" e="Department Code"></text>
