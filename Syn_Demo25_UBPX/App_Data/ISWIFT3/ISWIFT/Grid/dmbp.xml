        <field name="ten_bp" width="250">
          <text v="Tên bộ phận" e="Description"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$dmbp(f){
  this.constructor(f);
}
grid$dmbp.prototype = new DirEvent();
grid$dmbp.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
</dir>