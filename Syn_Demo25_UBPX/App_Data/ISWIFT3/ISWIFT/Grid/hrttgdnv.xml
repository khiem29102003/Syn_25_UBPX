<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="hrttgdnv" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thông tin gia đình nhân viên" e="Employee List"></title>
  <subtitle v="Nhận việc từ ngày {ngay_vao_tu} đến ngày {ngay_vao_den}..." e="From {ngay_vao_tu} To {ngay_vao_den}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_nv" operation="=" width="100">
          <text v="Mã nhân viên" e="Employee ID"></text>
        </field>
        <field name="ten_nv" width="250" aliasName="b">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
        <field name="ten_bp" width="150">
          <text v="Bộ phận" e="Department"></text>
        </field>
        <field name="gd_ho_ten" width="250">
          <text v="Họ tên người thân" e=""></text>
        </field>
        <field name="gd_ten_qh" width="150">
          <text v="Quan hệ" e=""></text>
        </field>
        <field name="gd_ngay_sinh" width="100" dataType="D">
          <text v="Ngày sinh" e=""></text>
        </field>
        <field name="gd_tuoi" format="Amount" dataType="N" width="60">
          <text v="Tuổi" e=""></text>
        </field>
        <field name="gd_mst" width="100">
          <text v="MST" e=""></text>
        </field>
        <field name="gd_cmnd" width="100">
          <text v="Số CMND" e=""></text>
        </field>
        <field name="gh_ngay_hl_tu" width="100" dataType="D">
          <text v="Ngày hiệu lực phụ thuộc từ" e="Join date"></text>
        </field>
        <field name="gh_ngay_hl_den" width="100" dataType="D">
          <text v="Ngày hiệu lực phụ thuộc đến" e=""></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$hrttgdnv(f){
  this.constructor(f);
}
grid$hrttgdnv.prototype = new DirEvent();
grid$hrttgdnv.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$hrttgdnv.prototype.beforeInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
</dir>