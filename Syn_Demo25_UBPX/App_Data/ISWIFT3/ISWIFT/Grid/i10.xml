          <text v="$PrintToolbar" e="$PrintToolbar"></text>
        </button>
        <button id="editPrintForm">
          <text v="$EditPrintFormToolbar" e="$EditPrintFormToolbar"></text>
        </button>
        <button id="export">
          <text v="$ExportToolbar" e="$ExportToolbar"></text>
        </button>
      </buttons>
    </grid>
  </grids>

  <script>
    <processing>
      <text>
        <![CDATA[
declare @q nvarchar(4000), @key nvarchar(4000), @partable varchar(32), @i int
select @fieldKey = dbo.ISWIFTFunctionReplaceSQLValue(@fieldKey), @valKey = dbo.ISWIFTFunctionReplaceSQLValue(@valKey), @i = 1, @key = ''
while @i <= dbo.sf_GetWordCount(@fieldKey) begin
	set @key = @key + case when @i <> 1 then ' and ' else '' end + 'a.' + dbo.sf_GetWordNum(@fieldKey, @i) + ' = ''' + dbo.sf_GetWordNum(@valKey, @i) + ''''
	set @i = @i + 1
end
create table #par(ngay_ct date)
set @q = 'insert into #par select ngay_ct from ' + dbo.ISWIFTFunctionReplaceSQLValue(@table) + ' a where ' + @key
exec (@q)
select @q = 'select @@gridFields from ' + 'r70$' + convert(char(6), ngay_ct, 112) + ' a @@gridJoin where ' + @key + ' order by line' from #par
exec (@q)
drop table #par
        ]]>
      </text>
    </processing>
  </script>
  
</dir>