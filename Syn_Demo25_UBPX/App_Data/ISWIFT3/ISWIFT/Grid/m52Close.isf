<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
]>

<dir id="m52Close" dirViewType="Grid" selectMultiple="Table" voucherCode="" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Đóng đơn hàng" e="Đóng đơn hàng"></title>
  <subtitle v="Xử lý &lt;b&gt;%s&lt;/b&gt; đơn hàng" e="&lt;b&gt;%s&lt;/b&gt; Sales Order"></subtitle>

  <grids>
    <grid table="m52" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
        <field name="so_ct" width="100" link="V" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="ma_gd" width="80" >
          <text v="Giao dịch" e="Transaction Code"></text>
        </field>
        <field name="ma_kh" width="120" >
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250" fieldType="EX" >
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
        <field name="ma_nvbh" width="100">
          <text v="Mã nhân viên" e="Sale"></text>
        </field>
        <field name="ma_nt" width="80" >
          <text v="Ngoại tệ" e="FC"></text>
        </field>
        <field name="t_tt_nt" dataType="N" format="Amount" width="100" >
          <text v="Tổng tiền" e="Pcs UOM"></text>
        </field>
        <field name="status" fieldType="PK" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = 'DH1' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="ma_ct" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="id" dataType="I" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      <buttons>
        <button id="close">
          <text v="Đóng/Bỏ đóng" e="Close/Cancel Close"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="find">
          <text v="$FindToolbar" e="$FindToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
      </buttons>

      <script>
        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <css>
    <text>
      <![CDATA[<enc>KC1cKJv5fV3yTGRKpOAWLOrvz21BaEnqgu3aGnAY8RBVenDkJZKQFYghY4E1scCovM9zIzWSUYvwGt8aqZFF4XWjnod/Lq5lWN8PMIdfH6y7DYVxXCmlOajLypQf35Dv01RPyr6Je23sNK01q9ZwHA==</enc>]]>
    </text>
  </css>
  
  <script>
    <request code="CloseDH">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>
  </script>

  <messages>
    <message val="msg1">
      <text v="Bạn có chắc chắn sẽ &lt;b&gt;đóng&lt;/b&gt; các đơn hàng được chọn không?" e="Bạn có chắc chắn sẽ &lt;b&gt;đóng&lt;/b&gt; các đơn hàng được chọn không?"/>
    </message>
    <message val="msg2">
      <text v="Bạn có chắc chắn sẽ &lt;b&gt;bỏ đóng&lt;/b&gt; các đơn hàng được chọn không?" e="Bạn có chắc chắn sẽ &lt;b&gt;bỏ đóng&lt;/b&gt; các đơn hàng được chọn không?"/>
    </message>
    <message val="close">
      <text v="Đóng đơn hàng" e="Đóng đơn hàng"/>
    </message>
    <message val="unclose">
      <text v="Bỏ đóng đơn hàng" e="Bỏ đóng đơn hàng"/>
    </message>
  </messages>
</dir>