<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="vdmlo" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục lô" e="Lot Maintenance"></title>
  <subtitle v="Cập nhật lô: thêm, sửa, xóa..." e="Add, Edit, Delete Lot..."></subtitle>
  <grids>
    <grid table="vdmlo" fieldKey="ma_vt, ma_lo" order="ma_vt, ma_lo" allowFilter="true" allowOrder="true">
      <fields>
        <field name="ma_vt" fieldType="PK" width="100">
          <text v="Mã vật tư" e="Item"></text>
        </field>
        <field name="ten_vt" width="300">
          <text v="Tên vật tư" e="Item Name"></text>
        </field>
        <field name="ma_lo" fieldType="PK" width="100">
          <text v="Mã lô" e="Lot"></text>
        </field>
        <field name="ten_lo" width="300">
          <text v="Tên lô" e="Description"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$vdmlo(f){
  this.constructor(f);
}
grid$vdmlo.prototype = new DirEvent();
grid$vdmlo.prototype.afterInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
</dir>