        <![CDATA[<enc>F77xk9+KbdeoFpBTQKEubi2TIPBqX1b8P402+yMNNwERYYtfsUS5AtDJdGFsWyk5teWSdXCj272WrbRURTfb2rV0EOmMg0E76w2M4M7V880uwYQuZt478DOtpOujcl6S5/pgH0gmmzH4mPG4ZI6g6oKWnMsmDlOMX0pO5K6bVHLuzJdilaWRVvbksNSUeV7YJXAWinqgFH2BupNE8X0eLw==</enc>]]>
      </text>
    </processing>
  </script>
  <messages>
    <message val="ChartName">
      <text v="Biểu đồ" e="Chart"/>
    </message>
  </messages>
</dir>