<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmtt" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hạn thanh toán" e="Payment Term List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmtt" fieldKey="ma_tt" order="ma_tt" allowFilter="true" allowOrder="true" >
      <fields >
        <field name="ma_tt" fieldType="PK" width="120">
          <text v="Mã thanh toán" e="Payment Term Code"></text>
        </field>
        <field name="ten_tt" width="250">
          <text v="Tên thanh toán" e="Description"></text>
        </field>
		    <field name="han_tt" dataType="N" format="0" width="120">
          <text v="Hạn thanh toán" e="Payment Day(s)"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$dmtt(f){
  this.constructor(f);
}
grid$dmtt.prototype = new DirEvent();
grid$dmtt.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
</dir>