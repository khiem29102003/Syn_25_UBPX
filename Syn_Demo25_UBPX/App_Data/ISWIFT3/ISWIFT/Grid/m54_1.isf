  <script>
    &VoucherJSLoading;
  </script>

  <messages>
    <message val="DaTraLai">
      <text v="Đã có chứng từ trả lại cho phiếu xuất này, không được sửa/xóa." e=""/>
    </message>
  </messages>
</dir>