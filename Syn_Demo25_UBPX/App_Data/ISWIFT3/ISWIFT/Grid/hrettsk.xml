<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="hrettsk" width="Large" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thông tin sức khỏe &lt;b&gt;[%s]&lt;/b&gt;" e="&lt;b&gt;[%s]&lt;/b&gt;"></title>
  <subtitle v="Thêm, sửa, xóa..." e="Add, Edit, Delete..."></subtitle>
  <grids>
    <grid table="hrettsk" fieldKey="id, line" order="id, line" allowFilter="true" allowOrder="true">
      <fields>
        <field name="id" dataType="N" fieldType="PK" width="100" format="0" hidden="true">
          <text v="ID" e="ID"></text>
        </field>
        <field name="line" dataType="N" fieldType="PK" width="100" format="0" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ngay_kham" width="100" dataType="D">
          <text v="Ngày khám" e=""></text>
        </field>
        <field name="nhom_mau" width="100">
          <text v="Nhóm máu" e=""></text>
        </field>
        <field name="chieu_cao" width="100">
          <text v="Chiều cao" e=""></text>
        </field>
        <field name="can_nang" width="100">
          <text v="Cân nặng" e=""></text>
        </field>
        <field name="suc_khoe" width="250">
          <text v="Sức khỏe" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[
declare @key2 nvarchar(3000)
select @key2 = 'id = ' + rtrim(@id)
exec iswiftStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', '@@join', '', '@@key', @key2, @@filterKey, '', @pageIndex, 50, @@admin, @@userId
         ]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$hrettsk(f){
  this.constructor(f);
}
grid$hrettsk.prototype = new DirEvent();
grid$hrettsk.prototype.afterInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
</dir>