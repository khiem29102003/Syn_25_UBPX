<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="hrettgd" width="Large" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thông tin gia đình &lt;b&gt;[%s]&lt;/b&gt;" e="Family Infomation &lt;b&gt;[%s]&lt;/b&gt;"></title>
  <subtitle v="Thêm, sửa, xóa..." e="Add, Edit, Delete..."></subtitle>
  <grids>
    <grid table="hrettgd" fieldKey="id, line" order="id, line" allowFilter="true" allowOrder="true">
      <fields>
        <field name="id" dataType="N" fieldType="PK" width="100" format="0" hidden="true">
          <text v="ID" e="ID"></text>
        </field>
        <field name="line" dataType="N" fieldType="PK" width="100" format="0" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ma_qh" width="100" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="ten_qh" fieldType="EX" width="100" aliasName="b" join="left join hrdmqhgd b on a.ma_qh = b.ma_qh">
          <text v="Quan hệ" e="Relationship"></text>
        </field>
        <field name="ho_ten" width="150">
          <text v="Họ và tên" e="Full Name"></text>
        </field>
        <field name="ngay_sinh" dataType="D" width="100">
          <text v="Ngày sinh" e="Date of Birth"></text>
        </field>
        <field name="ghi_chu" width="300">
          <text v="Ghi chú" e="Note"></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[
declare @key2 nvarchar(3000)
select @key2 = 'id = ' + rtrim(@id)
exec iswiftStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', '@@join', 'b.ten_qh', '@@key', @key2, @@filterKey, '', @pageIndex, 50, @@admin, @@userId
         ]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$hrettgd(f){
  this.constructor(f);
}
grid$hrettgd.prototype = new DirEvent();
grid$hrettgd.prototype.afterInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
</dir>