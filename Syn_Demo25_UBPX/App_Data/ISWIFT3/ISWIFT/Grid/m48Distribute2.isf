  <messages>
    <message val="NoRowsChoice">
      <text v="Không có dòng phân bổ được nhập" e=""/>
    </message>
    <message val="GreaterThanAR">
      <text v="Số tiền phân bổ vượt quá số tiền trên phiếu thu, không thể lưu" e=""/>
    </message>
  </messages>
</dir>