<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="m48Distribute2" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Chi tiết hóa đơn" e="Allocation to Invoices"></title>
  <subtitle v="Phiếu thu số %s1 ngày %s2 phân bổ: &lt;b&gt;%s3&lt;/b&gt;, còn lại: &lt;b&gt;%s4&lt;/b&gt;" e="%s"></subtitle>

  <grids>
    <grid table="ctct20" fieldKey="id" order="ngay_ct, so_ct, id" allowFilter="true" readOnly="false" allowOrder="true" key="loai_tt = 0">
      <fields>
        <field name="tag" dataType="B" fieldType="EX" format="0" width="40" readOnly="false">
          <text v="..." e="..."></text>
        </field>
        <field name="stt" dataType="I" fieldType="EX" format="0" width="40">
          <text v="Stt" e="Order"></text>
        </field>
        <field name="so_ct" width="100" link="V" >
          <text v="Số hóa đơn" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày hóa đơn" e="Voucher Date"></text>
        </field>
        <field name="ma_kh" hidden="true" width="120" >
          <text v="Mã nhà cung cấp" e="Customer Code"></text>
        </field>
        <field name="ma_nt" width="50" hidden="true" >
          <text v="Ngoại tệ" e="FC"></text>
        </field>
        <field name="t_tt_nt" dataType="N" format="FCAmount" width="100">
          <text v="Tổng tiền" e=""></text>
        </field>
        <field name="da_pb_nt" dataType="N" format="FCAmount" width="100" aliasName="0*t_tt_nt as ">
          <text v="Đã phân bổ" e=""></text>
        </field>
        <field name="da_pb_ct_nt" dataType="N" format="FCAmount" width="100" aliasName="0*t_tt_nt as ">
          <text v="P/bổ trên pthu" e=""></text>
        </field>
        <field name="tt_nt" dataType="N" format="FCAmount" width="100" aliasName="0*t_tt_nt as " readOnly="false">
          <text v="Phân bổ" e=""></text>
        </field>
        <field name="cl_nt" dataType="N" format="FCAmount" width="100" aliasName="0*t_tt_nt as " >
          <text v="Còn lại" e=""></text>
        </field>
        <field name="tt_yn" dataType="B" width="80" >
          <text v="Tất toán" e=""></text>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="80" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_ct" width="80" >
          <text v="Chứng từ" e="Voucher"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      <buttons>
        <button id="save">
          <text v="Lưu phân bổ" e="Save"></text>
        </button>
        <button id="delete">
          <text v="Xóa phân bổ" e="Delete"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>
      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <css>
    <text>
      <![CDATA[<enc>XN7SSMVQXNjTZZuKXE9kvamr3qklLMQb194oNMt+zqHlch5uK9b5CYBw1rrMUUCiCZwUbXuNuPwsT5HcAhuyl2lKZ/D0FzEaXRtSkSJNkYw=</enc>]]>
    </text>
  </css>

  <script>
    <request code="SaveDistribute" transaction="true">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>

    <request code="DeleteDistribute" transaction="true">
      <text>
        <![CDATA[<enc>/6eZ5tY1784mEutmmhSzcq55XrQM8CjfW8PL8FslNq1JuMllEpIaA/993m8AOSHw5xGxEDCzowfCLrxYTm2EDRndB3kYkq0sjER9XqScXh3fhhvId4pEocO2EX7Ba7UAHRL9gK23lv2F+LmQxVJVxYlfQXepvYBQOcMRXPhJy3qNdVtL11UIY2g+OI449ea3ctoYMBSQzF43O58d23XGlth05MHC+Mb2OoR4aEEIvV/HY1qozqR0kdFtGQu+0r36oRGNSXfBb8N6HbdjEAuhHA==</enc>]]>
