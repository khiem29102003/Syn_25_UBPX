<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="hrdssnnv" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách sinh nhật nhân viên" e="Employee List"></title>
  <subtitle v="Tháng {thang}..." e="Month {thang}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_nv" operation="=" width="100">
          <text v="Mã nhân viên" e="Employee ID"></text>
        </field>
        <field name="ten_nv" width="250" aliasName="b">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
        <field name="ten_bp" width="150">
          <text v="Bộ phận" e="Department"></text>
        </field>
        <field name="ten_vtr" width="150">
          <text v="Vị trí" e="Position"></text>
        </field>
        <field name="ngay_vao" width="100" dataType="D">
          <text v="Ngày nhận việc" e="Join date"></text>
        </field>
        <field name="ngay_sinh" width="100" dataType="D">
          <text v="Ngày sinh" e="Date of Birth"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$hrdssnnv(f){
  this.constructor(f);
}
grid$hrdssnnv.prototype = new DirEvent();
grid$hrdssnnv.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$hrdssnnv.prototype.beforeInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
</dir>