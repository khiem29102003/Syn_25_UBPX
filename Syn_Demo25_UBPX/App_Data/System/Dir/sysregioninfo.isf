<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="sysregioninfo" table="sysregioninfo" fieldKey="rg_code" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục khu vực" e="List of customer"></title>
  <title0 v="Thêm khu vực" e="New customer"></title0>
  <title1 v="Sửa khu vực" e="Edit customer"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120"  >
      <fields>
        <field name="rg_code" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã khu vực" e="Code"></text>
        </field>
        <field name="rgname" allowBlank="false" label="1" field="-">
          <text v="Tên khu vực" e="Name"></text>
        </field>
        <field name="rgname2" label="1" field="-">
          <text v="Tên 2" e="Name 2"></text>
        </field>
        <field name="parent_rg" viewType="Lookup" label="1" field="1">
          <text v="Khu vực mẹ" e="Parent Region"></text>
          <viewInfo lookupType="One" lookupId="sysregioninfo" lookupKey="status=1" lookupCheck="1=1" lookupRef="parent_rgname" lookupInfo="sysregioninfo|rg_code|rgname" />
        </field>
        <field name="parent_rgname" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_rg1" viewType="Lookup" label="1" field="1">
          <text v="Nhóm 1" e="Group 1"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'RG1' and status=1" lookupCheck="ma_loai_nh = 'RG1'" lookupRef="ten_nh_rg1" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_rg1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_rg2" viewType="Lookup" label="1" field="1">
          <text v="Nhóm 2" e="Group 2"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'RG2' and status=1" lookupCheck="ma_loai_nh = 'RG2'" lookupRef="ten_nh_rg2" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_rg2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_rg3" viewType="Lookup" label="1" field="1">
          <text v="Nhóm 3" e="Name"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'RG3' and status=1" lookupCheck="ma_loai_nh = 'RG3'" lookupRef="ten_nh_rg3" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_rg3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="stt"  dataType="N" label="1" field="1">
          <text v="Số thứ tự" e="Order"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
