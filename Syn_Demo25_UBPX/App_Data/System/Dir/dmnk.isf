  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã quyển đã có trong danh mục." e="The Book Is Already Exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã quyển đã có trong danh mục." e="The Book Is Already Exists."/>
    </message>
    <message val="duplicateUserVoucher">
      <text v="Chứng từ và người sử dụng đã bị trùng." e="Voucher And User Is Already Exists."/>
    </message>
  </messages>
</dir>