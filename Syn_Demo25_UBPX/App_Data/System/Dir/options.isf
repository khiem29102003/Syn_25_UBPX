<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="options" table="options" fieldKey="name" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo các tham số tùy chọn" e="Optional Parameters"></title>
  <title0 v="Thêm mới tham số tùy chọn" e="New Parameters"></title0>
  <title1 v="Sửa tham số tùy chọn" e="Edit Parameters"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120"  >
      <fields>
        <field name="name" hidden="true" fieldType="PK" label="1" field="1" checkCode="0">
          <text v="" e=""></text>
        </field>
        <field name="inputmask" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="type"  hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="val" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="val_mask" fieldType="EX" checkCode="0" hidden="true">
          <text v="" e=""></text>
        </field>
        
        <field name="descript" label="1" field="-" allowBlank="false" disabled="true" >
          <text v="Tên tham số" e="Parameters Name"></text>
        </field>
        
        <field name="val_num" format="2" dataType="N" fieldType="EX" label="1" field="1">
          <text v="Giá trị" e="Value"></text>
        </field>
        <field name="val_cbo" viewType="Combobox" fieldType="EX" label="1" field="2">
          <text v="Giá trị" e="Value"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="val_date" fieldType="EX" dataType="D" label="1" field="1" >
          <text v="Giá trị" e="Value"></text>
        </field>
        <field name="val_text" fieldType="EX" label="1" field="-" >
          <text v="Giá trị" e="Value"></text>
        </field>
      </fields>
    </form>
  </forms>

&DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[<enc>hxQPm/hYhpvPifcenBxj7nfT+X4T8oXvYmZx4Kpwn3fRRVZY+foYIow2vt1OHdzq0lG6PkDpvnlKR1ei3AR28SzjESCDA2EtG2sfHnni81uOonMnF15VB/l/c/bVAZ/m</enc>]]>
      </text>
    </declare>
  </script>
</dir>