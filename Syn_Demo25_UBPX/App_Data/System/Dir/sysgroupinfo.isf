<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="sysgroupinfo" table="sysgroupinfo" fieldKey="group_id" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo nhóm người sử dụng" e="Group Maintenance"></title>
  <title0 v="Thêm thông tin nhóm người sử dụng" e="New Group's Information"></title0>
  <title1 v="Sửa thông tin nhóm người sử dụng" e="Edit Group's Information"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,240"  >
      <fields>
        <field name="group_id" label="" field="1" dataType="I" hidden="true" fieldType="PK">
          <text v="" e=""></text>
        </field>
        <field name="groupname" format="U" allowBlank="false" label="1" field="1">
          <text v="Nhóm" e="Group"></text>
        </field>
        <field name="dien_giai" allowBlank="false" label="1" field="2">
          <text v="Tên nhóm" e="Description"></text>
        </field>
        <field name="ds_username" allowBlank="false" viewType="Lookup" label="1" field="-">
          <text v="Ds người sử dụng" e="User List"></text>
          <viewInfo lookupType="Multi" lookupId="sysuserinfo" lookupKey="admin = 0 and status=1" lookupCheck="admin = 0 and status=1" lookupRef="" lookupInfo="sysuserinfo|username|nickname" />
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

