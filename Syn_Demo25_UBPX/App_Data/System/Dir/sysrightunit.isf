<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="sysrightunit" table="sysrightunit3" transaction="true" tryCatch="true" fieldKey="user_id" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phân quyền truy cập theo đơn vị" e="Access Right by Unit"></title>
  <title0 v="Mới" e="New" />
  <title1 v="Sửa" e="Edit" />

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="user_id" hidden="true" dataType="I" label="1" field="1" fieldType="PK" >
          <text v="User id" e="User id"></text>
        </field>
        <field name="username" fieldType="EXParam" viewType="Lookup" allowBlank="false" label="1" field="1">
          <text v="Tên/Nhóm" e="Name/Group"></text>
          <viewInfo lookupType="One" lookupId="vsysuserinfo" lookupKey="status = 1 and admin = 0" lookupCheck="1=1" lookupRef="nickname" lookupInfo="vsysuserinfo|username|nickname" />
        </field>
        <field name="nickname" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="350" >
      <text v="Trạng thái" e="Status"></text>
      <fields>
        <field name="sysrightunit2" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>


  <grids>
    <grid id="sysrightunit2" table="sysrightunit2" fieldKey="user_id, line" order="line" readOnly="false">
      <fields>
        <field name="user_id" dataType="I" foreignField="user_id" fieldType="PK" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="unit_id" readOnly="true" hidden="true" inactivate="true" dataType="I" width="80" >
          <text v="" e=""></text>
        </field>
        <field name="ma_unit" width="100" viewType="Lookup" allowBlank="false" readOnly="false" aliasName="b" >
          <text v="Đơn vị" e="Status"></text>
          <viewInfo lookupType="One" lookupId="sysunit" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_unit" />
        </field>
        <field name="ten_unit" width="250" readOnly="true" inactivate="true" aliasName="b" fieldType="EX" >
          <text v="Tên đơn vị" e="Unit Name"></text>
        </field>
        <field name="a_view" valueDefault="1" dataType="B" width="80" readOnly="true" inactivate="true" >
          <text v="Xem" e="View"></text>
        </field>
        <field name="a_new" dataType="B" width="80" readOnly="false" >
          <text v="Mới" e="New"></text>
        </field>
        <field name="a_edit" dataType="B" width="80" readOnly="false" >
          <text v="sửa" e="Edit"></text>
        </field>
        <field name="a_del" dataType="B" width="80" readOnly="false" >
          <text v="Xóa" e="Delete"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc>Ts8UHiXSGkQdavUSCrw2AtMjZkzqr/Bi9jfieg0UMgUtiKUIOboCRg++W0r50pioOOZpVFYxrv/Kf4JMoJhrukIaRIaupeK+CmU/JbzBVSoQZVYvShM+rLu0hTTHEHOgvTF2MuvKbbTTwh7jMrFrowNEVRvRZDdhIImjVjmRl9CU8+9EtGwtbF22drj2mxgB</enc>]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

