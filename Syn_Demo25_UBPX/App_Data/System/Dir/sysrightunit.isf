  <messages>
    <message val="codeExistsNewMsg">
      <text v="Tên/nhóm đã tồn tại" e="Name/Group Already Exists"/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Tên/nhóm đã tồn tại" e="Name/Group Already Exists"/>
    </message>
    <message val="unitDuplicate">
      <text v="Mã đơn vị đã bị trùng ở chi tiết" e="Duplicate Unit"/>
    </message>
