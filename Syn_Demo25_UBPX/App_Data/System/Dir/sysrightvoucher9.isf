<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="sysrightvoucher" table="sysrightvoucher3" fieldKey="ma_ct,user_id" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Giới hạn quyền truy nhập cho các trạng thái của chứng từ" e="Limit Access Right to Voucher Statuses"></title>
  <title0 v="Mới" e="New" />
  <title1 v="Sửa" e="Edit" />

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_ct" format="U" label="1" field="1" viewType="Lookup" allowBlank="false" fieldType="PK" >
          <text v="Mã chứng từ" e="Voucher Code"></text>
          <viewInfo lookupType="One" lookupId="dmct" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ct" lookupInfo="dmct|ma_ct|ten_ct" />
        </field>
        <field name="ten_ct" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="user_id" hidden="true" dataType="I" label="1" field="1" fieldType="PK" >
          <text v="User id" e="User id"></text>
        </field>
        <field name="username" fieldType="EXParam" viewType="Lookup" allowBlank="false" label="1" field="1">
          <text v="Tên/Nhóm" e="Name/Group"></text>
          <viewInfo lookupType="One" lookupId="vsysuserinfo" lookupKey="status = 1 and admin = 0" lookupCheck="1=1" lookupRef="nickname" lookupInfo="vsysuserinfo|username|nickname" />
        </field>
        <field name="nickname" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="350" >
      <text v="Trạng thái" e="Status"></text>
      <fields>
        <field name="sysrightvoucher2" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>


  <grids>
    <grid id="sysrightvoucher2" table="sysrightvoucher2" fieldKey="user_id, ma_ct, field" order="field" allowFilter="true" allowOrder="true" readOnly="false">
      <fields>
        <field name="user_id" dataType="I" foreignField="user_id" fieldType="PK" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="ma_ct" foreignField="ma_ct" fieldType="PK" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="tab" width="100" hidden="true" fieldType="PK" readOnly="false" >
          <text v="Tab" e="Tab"></text>
        </field>
        <field name="tabtext" width="150" readOnly="true" inactivate="true" fieldType="EX" aliasName="'' as " >
          <text v="Màn hình" e="Tab"></text>
        </field>
        <field name="field" width="100" hidden="true" fieldType="PK" readOnly="false" >
          <text v="Code" e="Code"></text>
        </field>
        <field name="fieldtext" width="250" readOnly="true" inactivate="true" fieldType="EX" aliasName="'' as " >
          <text v="Thông tin" e="Field Info"></text>
        </field>
        <field name="a_hidden" dataType="B" width="80" readOnly="false" >
          <text v="Ẩn" e="Hidden"></text>
        </field>
        <field name="a_readonly" dataType="B" width="80" readOnly="false" >
          <text v="Chỉ đọc" e="Read Only"></text>
        </field>
      </fields>

      <buttons>
        <button id="refresh">
          <text v="Hiện tất cả" e="Show All"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc>kQg4t4b34iYYuFEXiNX/X7Soxwgz5fH8A7carzh1TtAme5ZFDSEdUhq/Ud6eJx1sT56I4oVSlarzHHnCCN0tRvjkQeTF/FJxSi2T7yen9kqBmtPPAOzcGBstCFgObIXjMsMnVQV7/cTP/n+9CH4vMA==</enc>]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

