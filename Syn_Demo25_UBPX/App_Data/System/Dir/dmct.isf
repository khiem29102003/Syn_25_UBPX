<dir id="dmct" table="dmct" fieldKey="ma_ct" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục chứng từ" e="List of customer"></title>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120"  >
      <fields>
        <field name="ma_ct" disabled="true" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã chứng từ" e="Code"></text>
        </field>
        <field name="ten_ct" allowBlank="false" label="1" field="-">
          <text v="Tên chứng từ" e="Name"></text>
        </field>
        <field name="ten_ct2" label="1" field="-">
          <text v="Tên 2" e="Name 2"></text>
        </field>
        <field name="ngay_ks" dataType="D" label="1" field="1">
          <text v="Ngày khóa sổ" e="Lock Date"></text>
        </field>
        <field name="df_status" dataType="I" label="1" field="1">
          <text v="Trạng thái ngầm định" e="Default Status"></text>
        </field>
        <field name="i_so_ct" dataType="I" label="1" field="1">
          <text v="Số chứng từ hiện tại" e="Current No"></text>
        </field>
      </fields>
    </form>
  </forms>


  &DefaultButton;

