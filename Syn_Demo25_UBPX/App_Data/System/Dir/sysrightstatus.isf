<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="sysrightstatus" table="sysrightstatus3" fieldKey="ma_ct,user_id" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Giới hạn quyền truy nhập cho các trạng thái của chứng từ" e="Limit Access Right to Voucher Statuses"></title>
  <title0 v="Mới" e="New" />
  <title1 v="Sửa" e="Edit" />

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_ct" format="U" label="1" field="1" viewType="Lookup" clientDefault="true" allowBlank="false" fieldType="PK" >
          <text v="Mã chứng từ" e="Voucher Code"></text>
          <viewInfo lookupType="One" lookupId="dmct" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ct" lookupInfo="dmct|ma_ct|ten_ct" />
        </field>
        <field name="ten_ct" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" clientDefault="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="user_id" hidden="true" dataType="I" label="1" field="1" fieldType="PK" >
          <text v="User id" e="User id"></text>
        </field>
        <field name="username" fieldType="EXParam" viewType="Lookup" allowBlank="false" label="1" field="1">
          <text v="Tên/Nhóm" e="Name/Group"></text>
          <viewInfo lookupType="One" lookupId="vsysuserinfo" lookupKey="status = 1 and admin = 0" lookupCheck="1=1" lookupRef="nickname" lookupInfo="vsysuserinfo|username|nickname" />
        </field>
        <field name="nickname" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="350" >
      <text v="Trạng thái" e="Status"></text>
      <fields>
        <field name="sysrightstatus2" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>


  <grids>
    <grid id="sysrightstatus2" table="sysrightstatus2" fieldKey="user_id, ma_ct, ma_ttct" order="ma_ttct" allowFilter="true" allowOrder="true" readOnly="false">
      <fields>
        <field name="user_id" dataType="I" foreignField="user_id" fieldType="PK" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="ma_ct" foreignField="ma_ct" fieldType="PK" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="ma_ttct" width="80" hidden="true" fieldType="PK" readOnly="true" >
          <text v="Trạng thái" e="Status"></text>
        </field>
        <field name="ten_ttct" width="250" readOnly="true" inactivate="true" aliasName="b" >
          <text v="Tên trạng thái" e="Status Name"></text>
        </field>
        <field name="a_view" dataType="B" width="80" readOnly="false" >
          <text v="Xem" e="View"></text>
        </field>
        <field name="a_new" dataType="B" width="80" readOnly="false" >
          <text v="Mới" e="New"></text>
        </field>
        <field name="a_edit" dataType="B" width="80" readOnly="false" >
          <text v="Sửa" e="Edit"></text>
        </field>
        <field name="a_del" dataType="B" width="80" readOnly="false" >
          <text v="Xóa" e="Delete"></text>
        </field>
        <field name="stt" dataType="I" aliasName="b" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      <buttons>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc>m+NJqfNgxHrO3YuPcxH14FOY5iTN6VMW7deC7mTalmdtosPadWn75Guu/Xp7rza9T5Ede2XdzX5HeTXCzNGHNRKNFmnecBULKcAEWOj0jQJl4CYpUYiAtb07lc4Q8XUywpEu05iDcJ6hXWwBF69zA4oEDF2DuHYEWBKdUrYR8s2UpDwaZ3RdqP0i00X3af3gnoVTaRL4kj534LJJkncCY3meLXgAjXog3wu6vePgLNzqos+WbSOidbgKMkS1xV5q4UIpdCfj+DYdVYWa71FeFQ==</enc>]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

