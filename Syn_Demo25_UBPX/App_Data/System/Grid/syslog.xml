<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="syslog" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Nhật ký hệ thống" e="System Logs"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="Date from {ngay_ct1} to {ngay_ct2}"></subtitle>
  <grids>
    <grid table="" fieldKey="" order="" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ip" width="120">
          <text v="IP" e="Code"></text>
        </field>
        <field name="username" width="120">
          <text v="Tên đăng nhập" e="Username"></text>
        </field>
        <field name="nickname" width="250">
          <text v="Tên người sử dụng" e="Nick name"></text>
        </field>
        <field name="ctext" width="250">
          <text v="Chức năng" e="Menu"></text>
        </field>
        <field name="ctime" width="150">
          <text v="Thời gian" e="Datetime"></text>
        </field>
      </fields>

      <buttons>
        <button id="find">
          <text v="Tìm kiếm" e="Find"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="Làm tươi" e="Refresh"></text>
        </button>
        <button id="freeze">
          <text v="Gim cột" e="Freeze"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="export">
          <text v="Kết xuất dữ liệu" e="Kết xuất dữ liệu"></text>
        </button>
      </buttons>

      <mobileView>
        <text>
          <![CDATA[
     [stt]   Mạ khach hang: [ma_kh] 
        TEN kh: [ten_kh]
        ]]>
        </text>
      </mobileView>
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$syslog(f){
  this.constructor(f);
}
grid$syslog.prototype = new DirEvent();
grid$syslog.prototype.afterInitFields = function(){
  var p = this._dir;
}

grid$syslog.prototype.afterInit = function(){
  var p = this._dir;
}
]]>
      </text>
  </js>
    <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
</dir>