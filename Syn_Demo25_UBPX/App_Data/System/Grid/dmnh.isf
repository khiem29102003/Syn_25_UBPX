          <text v="Loại nhóm" e="Parent Code"></text>
        </field>
        <field name="ma_nh" fieldType="PK" width="100" filterType="Code">
          <text v="Mã nhóm" e="Code"></text>
        </field>
        <field name="ten_nh" width="250">
          <text v="Tên nhóm" e="Name"></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>
