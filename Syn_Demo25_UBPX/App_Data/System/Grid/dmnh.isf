<dir id="dmnh" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phân nhóm" e="List of group"></title>
  <subtitle v="Phân nhóm: &lt;i&gt;{ma_loai_nh} - {ten_loai_nh}&lt;/i&gt;" e="Group: &lt;i&gt;{ma_loai_nh} - {ten_loai_nh}&lt;/i&gt;"></subtitle>
  <grids>
    <grid table="dmnh" fieldKey="ma_nh" order="ma_nh" allowFilter="true" allowOrder="true" key="" >
