<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="syslog" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Nhật ký hệ thống" e="System Logs"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="Date from {ngay_ct1} to {ngay_ct2}"></subtitle>
  <grids>
    <grid table="" fieldKey="" order="" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ip" width="120">
          <text v="IP" e="Code"></text>
        </field>
        <field name="username" width="120">
          <text v="Tên đăng nhập" e="Username"></text>
        </field>
        <field name="nickname" width="250">
          <text v="Tên người sử dụng" e="Nick name"></text>
        </field>
        <field name="ctext" width="250">
          <text v="Chức năng" e="Menu"></text>
        </field>
        <field name="ctime" width="150">
          <text v="Thời gian" e="Datetime"></text>
        </field>
      </fields>

      <buttons>
        <button id="find">
          <text v="Tìm kiếm" e="Find"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="Làm tươi" e="Refresh"></text>
        </button>
        <button id="freeze">
          <text v="Gim cột" e="Freeze"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="export">
          <text v="Kết xuất dữ liệu" e="Kết xuất dữ liệu"></text>
        </button>
      </buttons>

      <mobileView>
        <text>
          <![CDATA[<enc>lmiQ0uBmKxjywDEVuIj5dhosnan9ljbAHwpruRqIMa3QfhJ0KoyiokUWA6Ee0rPcm2IrF4uy6pld1IPMNj0R+n+0ua73q51j3peWTzAqhzI=</enc>]]>
        </text>
      </mobileView>
    </grid>
  </grids>

