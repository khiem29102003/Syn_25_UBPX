<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="sysrightvoucher" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Giới hạn quyền truy nhập cho các thông tin của chứng từ" e="Limit Access Right to Vouchers"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>
  <grids>
    <grid table="vsysrightvoucher" fieldKey="ma_ct,user_id" order="ma_ct, username" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_ct" fieldType="PK" width="120" filterType="Code">
          <text v="Mã chứng từ" e="Voucher Code"></text>
        </field>
        <field name="ten_ct" width="250">
          <text v="Tên chứng từ" e="Voucher Name"></text>
        </field>
        <field name="user_id" fieldType="PK" width="50" hidden="true" filterType="Code">
          <text v="User ID" e="User ID"></text>
        </field>
        <field name="username" width="100">
          <text v="Mã/Nhóm" e="Code/Group"></text>
        </field>
        <field name="nickname" width="250">
          <text v="Tên/Nhóm" e="Name/Group"></text>
        </field>
        <field name="is_user" dataType="B" width="100">
          <text v="Người sử dụng" e="User"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
