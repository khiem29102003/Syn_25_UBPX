<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridFinding.xml">
]>

<dir id="dmnh" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phân nhóm" e="List of group"></title>
  <subtitle v="Phân nhóm: &lt;i&gt;{ma_loai_nh} - {ten_loai_nh}&lt;/i&gt;" e="Group: &lt;i&gt;{ma_loai_nh} - {ten_loai_nh}&lt;/i&gt;"></subtitle>
  <grids>
    <grid table="dmnh" fieldKey="ma_nh" order="ma_nh" allowFilter="true" allowOrder="true" key="" >
      <fields>
        <field name="ma_loai_nh" hidden="true" fieldType="PK" width="100">
          <text v="Loại nhóm" e="Parent Code"></text>
        </field>
        <field name="ma_nh" fieldType="PK" width="100" filterType="Code">
          <text v="Mã nhóm" e="Code"></text>
        </field>
        <field name="ten_nh" width="250">
          <text v="Tên nhóm" e="Name"></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[
declare @strKey nvarchar(128)
set @strKey = 'ma_loai_nh = ''' + dbo.ISWIFTFunctionReplaceSQLParam(@ma_loai_nh) + ''''
exec ISWIFTStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', '', '', '@@key', @strKey, @@filterKey, '', @pageIndex, 50, @@admin, @@userId    --@@columnFilterKey
         ]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$dmnh(f){
  this.constructor(f);
}
grid$dmnh.prototype = new DirEvent();
grid$dmnh.prototype.afterInit = function() {
  var p = this._dir;
}
         ]]>
    </text>
  </js>
</dir>