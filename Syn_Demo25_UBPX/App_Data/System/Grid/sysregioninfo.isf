<dir id="sysregioninfo" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục khu vực" e="List of region"></title>
  <subtitle v="Thêm, xóa, sửa khu vực..." e="New, delete, edit region..."></subtitle>
  <grids>
    <grid id="0" table="sysregioninfo" fieldKey="rg_code" order="stt_ref" allowFilter="true" allowOrder="true" key="" >
      <fields>
        <field name="rg_code" fieldType="PK" width="100" filterType="Code">
          <text v="Mã khu vực" e="Code"></text>
        </field>
        <field name="rgname" width="250">
          <text v="Tên khu vực" e="Name"></text>
        </field>
        <field name="parent_rg" width="100">
          <text v="Khu vực mẹ" e="Parent Code"></text>
        </field>
        <field name="nh_rg1" width="100">
          <text v="Nhóm 1" e="Parent Code"></text>
        </field>
        <field name="stt_ref" width="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

