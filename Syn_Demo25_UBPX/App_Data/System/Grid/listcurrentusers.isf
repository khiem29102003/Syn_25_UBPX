<?xml version="1.0" encoding="utf-8"?>

<dir id="listcurrentusers" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách người dùng đang sử dụng" e="List Of Current Users"></title>
  <subtitle v="Đang sử dụng..." e="Running..."></subtitle>
  <grids>
    <grid table="sysuserinfo" fieldKey="user_id" order="user_id" allowFilter="true" allowOrder="true" key="(@@admin = 1 or user_id = @@userId)" >
      <fields>
        <field name="user_id" fieldType="PK" dataType="N" align="Right" width="40" filterType="Code">
          <text v="ID" e="ID"></text>
        </field>
        <field name="username" width="120" filterType="Code">
          <text v="Tên" e="Name"></text>
        </field>
        <field name="nickname" width="300">
          <text v="Tên đầy đủ" e="Fullname"></text>
        </field>
      </fields>

      <buttons>
        <button id="refresh">
          <text v="Làm tươi" e="Refresh"></text>
        </button>
        <button id="killInstance">
          <text v="Kết thúc phiên làm việc" e="Kill user process"></text>
        </button>
        <button id="clearCache">
          <text v="Xóa bộ nhớ tạm" e="Clear cache"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="Gim cột" e="Freeze"></text>
        </button>
        <!--<button id="compressAll">
          <text v="Nén lại toàn bộ xml" e="Compress All XML"></text>
        </button>-->
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
  <script>
    <request code="clearCache">
      <text>
        <![CDATA[<enc>0/6rDJy7MgZTBIHArt/bHxyURC1Et80mejrdLj+/pH2E2kmNb5NevyW57oP0KoB1qV1UbJGoJSkr2Yxb5S8pHQ==</enc>]]>
      </text>
    </request>

    <request code="killInstance">
      <text>
        <![CDATA[<enc>0/6rDJy7MgZTBIHArt/bH/PdKdVb6OVsLV4kD8ea8ySgUOcAgnavKa88N3hirFISreBWfTzAK1hts9bnIJeQ/ncd0HMAWmib/ZA9IQfrTsqj3kSO2HLDgXAGoxBdmIIzejfCJYno2kBSKtgz3ASrCA==</enc>]]>
      </text>
    </request>

    <request code="compressAll">
      <text>
        <![CDATA[<enc>0/6rDJy7MgZTBIHArt/bHzLVPiH+mvSNLVxRVE/O/L4X8Uk6p6+aqVzhO+vfAi8DHfgVqOjnXg+bGjgehGcK6DoiQISB0swa4VsVxSUFk8nraKJXxr6yJPTDJ6uZPhn01KoS6fl5j/T+3I4aiS68x4OzvcpmPU/rhcDPOx1y9m8=</enc>]]>
      </text>
    </request>
  </script>

</dir>