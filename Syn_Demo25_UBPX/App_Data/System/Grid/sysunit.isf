<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridFinding.xml">
]>

<dir id="sysunit" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục đơn vị cơ sở" e="List of unit"></title>
  <subtitle v="Sửa thông tin đơn vị cơ sở" e="Sửa thông tin đơn vị cơ sở"></subtitle>
  <grids>
    <grid table="sysunit" fieldKey="unit_id" order="ma_unit" allowFilter="true" allowOrder="true" key="" >
      <fields>
        <field name="unit_id" hidden="true" fieldType="PK" width="0">
          <text v="" e=""></text>
        </field>
        <field name="ma_unit" width="100">
          <text v="Mã đơn vị" e="Unit Code"></text>
        </field>
        <field name="ten_unit" width="250">
          <text v="Tên đơn vị" e="Unit Name"></text>
        </field>
        <field name="ma_so_thue" width="120">
          <text v="Mã số thuế" e="Mã số thuế"></text>
        </field>
        <field name="ngay_ks" dataType="D" width="100">
          <text v="Ngày khóa sổ" e="Lock Date"></text>
        </field>
      </fields>

      <buttons>
        <button id="edit">
          <text v="$EditToolbar" e="$EditToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="export">
          <text v="$ExportToolbar" e="$ExportToolbar"></text>
        </button>
      </buttons>

    </grid>
  </grids>

  <js>
