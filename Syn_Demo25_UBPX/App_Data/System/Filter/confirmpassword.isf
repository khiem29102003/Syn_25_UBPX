<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="confirmpassword" table="" fieldKey="" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Xác nhận mật khẩu để tiếp tục phiên làm việc (Tên đang nhập: %s)" e="Confirm password (Username: %s)"></title>
  <title0 v="" e=""></title0>
  <title1 v="" e=""></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
        <field name="old_pass" label="1" field="1" allowBlank="false" >
          <text v="Mật khẩu" e="Password"></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
</dir>