  <messages>
    <message val="notSaveCommonForm">
      <text v="Không thể sửa/lưu vào mẫu chung" e="No Change Common Form"/>
    </message>
    <message val="columnNotBlank">
      <text v="Chưa nhập thông tin các cột cần in" e="Columns Is Empty"/>
    </message>
    <message val="columnDuplicate">
      <text v="Có cột dữ liệu bị trùng, kiểm tra lại dữ liệu" e="Columns Is Duplicate"/>
    </message>
    <message val="mustReload">
      <text v="Cần làm tươi lại để theo dõi thay đổi mẫu in" e="Reload To Change"/>
    </message>
    <message val="notEdit">
      <text v="Không thể thay đổi mẫu chung hoặc đã được sửa bởi người khác" e="Unable to change the common form or another has been fixed by"/>
    </message>
  </messages>

</dir>