<?xml version="1.0" encoding="utf-8"?>

<dir id="saveReportPrint" table="sysreportprint" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thêm mới mẫu in" e="Save New Print Form"></title>

  <forms>
    <form gravity="TopLeft" columns="120,360" >
      <fields>
        <field name="xid" label="1" viewType="Combobox" field="1" >
          <text v="Loại giấy"  e="Portrait"></text>
          <viewInfo>
            <options cache="false" query="select rtrim(user_id) + '_' + rtrim(id) as id, report_name%l from sysreportprint where (user_id in (@@userId, 0) or form_type = 1) and controller = @xcontroller">
              <option val="">
                <text v="Thêm mới mẫu" e="New Form"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="btn_delete" nextRow="false" label="" field="[100]" viewType="Command">
          <text v="Xóa mẫu" e="Delete"></text>
        </field>
        <field name="btn_copy" nextRow="false" label="" field="[100]" viewType="Command">
          <text v="Sao chép mẫu" e="Copy"></text>
        </field>
        <field name="report_name" allowBlank="false" label="1" field="1" >
          <text v="Nhập tên mẫu mới"  e="Name"></text>
        </field>
        <field name="report_name2" label="1" field="1" >
          <text v="Tên khác"  e="Name 2"></text>
        </field>
        <field name="report_file" label="1" viewType="Combobox" field="[240]" >
          <text v="Mẫu"  e="Form"></text>
          <viewInfo>
            <options query="select filename, description%l from sysreportrdlcform where status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="portrait" label="" nextRow="false" viewType="Combobox" field="[120]" >
          <text v="Loại giấy"  e="Portrait"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Giấy in ngang" e="Landscape"/>
              </option>
              <option val="1">
                <text v="Giấy in đứng" e="Portrait"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="title" allowBlank="false" label="1" field="1" >
          <text v="Tiêu đề in"  e="Title"></text>
        </field>
        <field name="title2" label="1" field="1" >
          <text v="Tiêu đề 2"  e="Title 2"></text>
        </field>
        <field name="subtitle" label="1" field="1" >
          <text v="Tiêu đề phụ"  e="Sub Title"></text>
        </field>
        <field name="subtitle2" label="1" field="1" >
          <text v="Tiêu đề phụ 2"  e="Sub Title 2"></text>
        </field>
        <field name="form_type" label="1" viewType="Combobox" field="1" >
          <text v="Loại mẫu"  e="Form Type"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Mẫu cho người sử dụng hiện tại"  e="Form For Current User"></text>
              </option>
              <option val="1">
                <text v="Mẫu chung cho tất cả người dùng"  e="Common Form For All User"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="250" >
      <text v="Cột in" e="Print Columns"></text>
      <fields>
        <field name="sysreportprint2" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="sysreportprint2" table="sysreportprint2" key="line" order="line" readOnly="false">
      <fields>
        <field name="stt" foreignField="@@ROW" dataType="I" hidden="true">
          <text v="Stt" e="Line"></text>
        </field>
        <field name="field" width="120" readOnly="false" viewType="Combobox" >
          <text v="Cột" e="Field"></text>
        </field>
        <field name="header" width="250" readOnly="false" >
          <text v="Tên cột" e="Header"></text>
        </field>
        <field name="header2" width="250" readOnly="false" >
          <text v="Tên cột 2" e="Header"></text>
        </field>
        <field name="data_type" width="120" hidden="true" readOnly="true" >
          <text v="Kiểu DL" e="DataType"></text>
        </field>
        <field name="width" width="120" readOnly="false" dataType="N" >
          <text v="Độ rộng" e="Width"></text>
        </field>
        <field name="format" width="100" readOnly="false" viewType="Combobox" >
          <text v="Định dạng" e="Format"></text>
          <viewInfo>
            <options>
              <option val="">
                <text v="Mặc định" e="Default"/>
              </option>
              <option val="Amount">
                <text v="Tiền" e="Amount"/>
              </option>
              <option val="FCAmount">
                <text v="Tiền ngoại tệ" e="FC Amount"/>
              </option>
              <option val="Rate">
                <text v="Tỷ lệ" e="Rate"/>
              </option>
              <option val="ExRate">
                <text v="Tỷ giá" e="Ex Rate"/>
              </option>
              <option val="Price">
                <text v="Giá" e="Price"/>
              </option>
              <option val="FCPrice">
                <text v="Giá ngoại tệ" e="FC Price"/>
              </option>
              <option val="Qty">
                <text v="Số lượng" e="Quanlity"/>
              </option>
              <option val="-1">
                <text v="Không phân cách" e="No Space"/>
              </option>
              <option val="1">
                <text v="1 sổ lẻ" e="1 Decimal"/>
              </option>
              <option val="2">
                <text v="2 sổ lẻ" e="2 Decimals"/>
              </option>
              <option val="3">
                <text v="3 sổ lẻ" e="3 Decimals"/>
              </option>
              <option val="4">
                <text v="4 sổ lẻ" e="4 Decimals"/>
              </option>
              <option val="5">
                <text v="5 sổ lẻ" e="5 Decimals"/>
              </option>
              <option val="6">
                <text v="6 sổ lẻ" e="6 Decimals"/>
              </option>
              <option val="7">
                <text v="7 sổ lẻ" e="7 Decimals"/>
              </option>
              <option val="8">
                <text v="8 sổ lẻ" e="8 Decimals"/>
              </option>
              <option val="9">
                <text v="9 sổ lẻ" e="9 Decimals"/>
              </option>
              <option val="12">
                <text v="12 sổ lẻ" e="12 Decimals"/>
              </option>
              <option val="DT">
                <text v="Ngày giờ" e="Datetime"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="align" width="80" readOnly="false" viewType="Combobox" >
          <text v="Căn chỉnh" e="Align"></text>
          <viewInfo>
            <options>
              <option val="L">
                <text v="Trái" e="Left"/>
              </option>
              <option val="C">
                <text v="Giữa" e="Center"/>
              </option>
              <option val="R">
                <text v="Phải" e="Right"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="bold" width="100" readOnly="false" dataType="B" >
          <text v="In đậm" e="Bold"></text>
        </field>
        <field name="italic" width="100" readOnly="false" dataType="B" >
          <text v="Nghiêng" e="Italic"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc>6047k8Qms+WY5WeBXOHiv1gNYMr5OCLK5rXY1bocHlbaUyaBeUIQiotrIcRWES+DTEPEv0pC2BZ+NecilXfx2au/tgT9fB6mrwywqa8UBblVBwYwzQa9OOpgIzeksjxynSv2wsKOWizSVQEe5ewX4IA8k6qnNKUGjLU48jWCXvD3vK8MRt6yXLGw+4mr+PC4UrhP9BkVywo1jqMzwAwLSZlzv+xNsOIDSPkOly9ZHM9Sy5UK9aypjlsPEhwzp+5e/u1XPnj+88bfvkqpAYufjw==</enc>]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  <buttons>
    <button id="ok" default="true">
      <text v="$AcceptLabel" e="$AcceptLabel"></text>
    </button>
    <button id="filterCancel">
      <text v="$CancelLabel" e="$CancelLabel"></text>
    </button>
  </buttons>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  <css>
    <text>
      <![CDATA[<enc>gUvd4wZ35UlOSsGh5TkGLBadUrdIb55X2eZao0obdCc=</enc>]]>
    </text>
  </css>
