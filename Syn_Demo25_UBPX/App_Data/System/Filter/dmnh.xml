<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="dmnh" table="" height="" fieldKey="ma_nh" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phân nhóm (Lọc)" e="List of customer"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120"  >
      <fields>
        <field name="ma_loai_nh" allowBlank="false" viewType="Lookup" label="1" field="1">
          <text v="Loại nhóm" e=""></text>
          <viewInfo lookupType="One" lookupId="dmloainh" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_loai_nh" lookupExactValue="1"/>
        </field>
        <field name="ten_loai_nh" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>


  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmnh(p){
  this.constructor(p);
  if ($.queryString('group') != '')
    p.field('ma_loai_nh').viewInfo.lookupKey = "status = 1 and ma_loai_nh like '" + $.queryString('group') + "%'"
}
filter$dmnh.prototype = new DirEvent();
filter$dmnh.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <script>

  </script>
</dir>