<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>


<dir id="selectFile" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Chọn tập tin lấy dữ liệu" e="Select file to import"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120" >
      <fields>
        <field name="import_file" label="1" field="3" viewType="File" >
          <text v="Tệp đính kèm" e="Tệp đính kèm"></text>
          <viewInfo fileFieldId0="rg_code" fileGroup="TLBH" fileExtension="xlsx" maxFileSize="10240" maxFileCount="1"></viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <script>
   
  </script>

</dir>