<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>


<dir id="saveReportForm" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir" >
  <title v="Lưu mới mẫu báo cáo" e="Save New Report Form"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120" >
      <fields>
        <field name="name" label="1" field="3" >
          <text v="Nhập tên mẫu mới" e="Name"></text>
        </field>
        <field name="name2" label="1" field="3" >
          <text v="Tên 2" e="Name 2"></text>
        </field>
        <field name="report_filtering" label="1" field="[360]" viewType="Combobox">
          <text v="Mẫu lọc báo cáo" e="Report Filtering Form"></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <script>
    <request code="NEW">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>

    <request code="EDIT">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>
  </script>

</dir>