<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="sysunit" table="" fieldKey="name" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Chọn đơn vị cơ sở làm việc" e="Select Current Unit"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120"  >
      <fields>
        <field name="unit_id" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Chọn đơn vị" e="Unit"></text>
          <viewInfo>
            <options cache="false" query="select unit_id, ma_unit + ' - ' + ten_unit from sysunit where unit_id in (select unit_id from dbo.ISWIFTFunctionGetUnitIDRight(@@userId, @@admin, ''))">
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>


  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <script>
    <loading code="1">
      <text>
        <![CDATA[<enc>B6uGb+1ViCnJmhgbJCyuT74UxwvzWxLsDkOqoDVUB+ryXHElVbglF9hF2KwCEeOrPA2q/VZtmRydYFZJV+0rOyrpjvBdk05q+OvcyazpjpCekOVuuAGm4vSbhzJ2UR7CuHIozIR7S7S36HhmhhFY+XtGREsO8CEoPz8WZmb8IiQvh52x8oxFoBGgjkuuyzE0jb/yt9kTZyXgpIfcrn2u7i9FU5XzdysodV/siWaEZvgB+uJuPMt5AsmGQaZRGlzWs4sIwX32Tm3Q8LQ14KK8cg==</enc>]]>
      </text>
    </loading>
  </script>

  <messages>
    <message val="errorSelectUnit">
      <text v="Có lỗi trong quá trình chọn đơn vị, phân quyền có thể đã bị thay đổi hãy trở lại màn hình đăng nhập và đăng nhập lại hệ thống" e=""/>
    </message>
  </messages>
</dir>