<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>


<dir id="systextlanguage" dirViewType="Dialog" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thay đổi ngôn ngữ màn hình" e=""></title>
  <title0 v="Mới" e="New" />
  <title1 v="Sửa" e="Edit" />

  <forms>
    <form gravity="TopLeft" columns="120,360" >
      <fields>
        <field name="controller_filter" inactivate="true" label="1" field="1"  >
          <text v="Lọc controller" e="Controller Filter"></text>
        </field>
        <field name="file_controller" label="1" field="1" viewType="Combobox" >
          <text v="Chọn màn hình" e="Screen"></text>
        </field>
        <field name="cmd_restore" label="" nextRow="false" invisible="true" field="[120]" viewType="Command" >
          <text v="Mặc định" e="Reset"></text>
        </field>
        <field name="cmd_saveroot" label="" nextRow="false" invisible="true" field="[120]" viewType="Command" >
          <text v="Lưu thành bản gốc" e="Save To Root"></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="350" >
      <text v="Trạng thái" e="Status"></text>
      <fields>
        <field name="systextlanguage2" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>


  <grids>
    <grid id="systextlanguage2" allowFilter="true" allowOrder="true" readOnly="false">
      <fields>
        <field name="val" width="200" >
          <text v="ID" e="ID"></text>
        </field>
        <field name="v" width="290" readOnly="false" >
          <text v="Tiếng Việt" e="Vietnamese"></text>
        </field>
        <field name="e" width="290" readOnly="false" >
          <text v="Tiếng Anh" e="English"></text>
        </field>
      </fields>

      <buttons>
        <button id="refresh">
          <text v="$Refresh" e="$Refresh"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>


    </grid>
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <script>
    <request code="GetController">
      <text>
        <![CDATA[<enc>GJgBVkOd9xy3In+SUACpOFpkKBPK3P4bhUh7o2OOkQW6s/PX88JmedjomKLf+ylwoMSxgJdSGikdOp8pD1c02sbmj/rbJOIU94Lth1JDute9pPPiMrC2NZ3LpHK+93XE</enc>]]>
      </text>
    </request>

    <beforesave>
      <text>
        <![CDATA[<enc>GJgBVkOd9xy3In+SUACpOIWsJhz27nlnO+8pkLN4hGdjeD5jP9qR/Uh19nTTwvCQs3DUp3VMEbq5IEvaYHz85M9foe3zIZ8CLkja4nGfWvNw00rc1AdSqAnsizcYV5SF</enc>]]>
      </text>
    </beforesave>

    <deleted>
      <text>
        <![CDATA[<enc>gdo2Braqfv+2TGPWmFXn8Hzy0iGEy9U3j6PDswWBHzg8MxGKEufOy6IYJzYswW1fMPlBQcKC4tv7mvlTdaecLlMzf+dKxnP3iniRP7N4HoKmEcecF/627yj4J8rCBIX4i6uvQyyVtIjJSgJ9uSZr7MEmJYfKw1oKqYBOMjJR32ung9h2g2mbz49SqHnjcMKB</enc>]]>
      </text>
    </deleted>

    <updated>
      <text>
        <![CDATA[<enc>lijy9vhnSntkZxGSL/iGiMOyKFzJ69F7GWvfILj+IOJ9B89tNtMUZjoDBVlTZBsaIJzQnM9GYi12dH7+vyxYDP1NRblIP9qFZbWVbokprjNz+6X4IkfCyZJmxwQ7fuBuE7Tud+lRmRvwSgGrnKeaduhvLnYd9KAf7/p81euQu+dz7KL6QA70Plnpn8J9Rru1I6zB0Ced/43W47136XlcHpg+ECJEIdVynDD3iI2IV7c=</enc>]]>
      </text>
    </updated>

    <aftersave>
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </aftersave>
  </script>

  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã chứng từ - Tên/nhóm đã tồn tại" e="Voucher Code - Name/Group Already Exists"/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã chứng từ - Tên/nhóm đã tồn tại" e="Voucher Code - Name/Group Already Exists"/>
    </message>
    <message val="commonInfo">
      <text v="Thông tin chung" e="Header"/>
    </message>
    <message val="FCText">
      <text v="nt" e="FC"/>
    </message>
    <message val="noChange">
      <text v="Chưa thay đổi thông tin" e="No Item Changed"/>
    </message>
  </messages>

</dir>