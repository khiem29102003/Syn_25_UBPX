<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY CheckUpdatingDeleting "
	if exists(select 1 from dmdtcntd where dien_thoai = @dien_thoai and status in (0,3)) begin
	select '$NotEditVoucherStatus' as message
		return
		end
  ">
]>

<dir id="dmdtcntd" table="dmdtcntd" fieldKey="ma_nv, dien_thoai" transaction="true" tryCatch="true" dirViewType="Dialog" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách cán bộ công khai số điện thoại tiếp dân" e="Public List of Officials' Citizen Reception Contact Numbers"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>
  <forms>
	<form gravity="TopLeft" columns="120,120,120,120" >
		<fields>
		    <field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_nv" viewType="Lookup" label="1" field="1" allowBlank="false" disabled="false" fieldType="PK" importable="5">
				<text v="Mã cán bộ" e="Employee Code"></text>
				<viewInfo lookupType="One" lookupId="dmnv" lookupKey="status=1 and xstatus = 5" lookupCheck="1=1" lookupInfo="dmnv|ma_nv|ten_nv"/>
			</field>
			<field name="dien_thoai" nextRow="true" label="1" field="1" importable="10" disabled="false" align="left" fieldType="PK">
				<text v="Điện thoại" e="Phone Number"></text>
			</field>
			<field name="ma_loai" viewType="Combobox" width ="150" >
			  <text v="Loại điện thoại" e="Phone Type"></text>
			  <viewInfo>
				<options query="select ma_loai, ten_loai%l from dmloaiphone where status = 1 and ma_loai = 'TIEPDAN' order by ma_loai">
				</options>
			  </viewInfo>
			</field>
			<field name="ma_ttp" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" disabled="false">
			  <text v="Tỉnh thành phố" e="Province/City"></text>
			  <viewInfo lookupType="One" lookupId="dmttp" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_ttp" lookupInfo="dmttp|ma_ttp|ten_ttp" />
			</field>
			<field name="ten_ttp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ma_phuongxa" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" disabled="false">
			  <text v="Phường/xã" e="Ward/Commune"></text>
			  <viewInfo lookupType="One" lookupId="dmphuongxa" lookupKey="ma_ttp = ![ma_ttp]! and status = 1" lookupCheck="1=1" lookupRef="ten_phuongxa" lookupInfo="dmphuongxa|ma_phuongxa|ten_phuongxa" />
			</field>
			<field name="ten_phuongxa" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ghi_chu" nextRow="true" label="1" field="2" importable="20" disabled="false">
				<text v="Ghi chú 1" e="Note"></text>
			</field>
			<field name="status" viewType="Combobox" label="1" field="2" valueDefault="1">
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 order by ma_tt">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
	<form tabPageIndex="1" gravity="MiddleLeft" height="200" columns="120,120,120,120" >
		<text v="Thông tin cán bộ" e="Information"></text>
		<fields>		
        <field name="ho_ten" allowBlank="true" label="1" field="2" disabled="true">
          <text v="Họ tên" e="Customer Name"></text>
        </field>
		<field name="ma_pb" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" disabled="true">
          <text v="Phòng ban" e="Department"></text>
		  <viewInfo lookupType="One" lookupId="dmpb" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_pb" lookupInfo="dmpb|ma_pb|ten_pb" />
		</field>
		<field name="ten_pb" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
		  <text v="" e=""></text>
		</field>
		<field name="ma_bp" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" disabled="true">
          <text v="Bộ phận" e="Section"></text>
		  <viewInfo lookupType="One" lookupId="dnbp" lookupKey="ma_pb = ![ma_pb]! and status = 1" lookupCheck="1=1" lookupRef="ten_bp" lookupInfo="dmbp|ma_bp|ten_bp" />
		</field>
		<field name="ten_bp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
		  <text v="" e=""></text>
		</field>
		<field name="ma_cv" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" disabled="true">
          <text v="Chức vụ" e="Duty Code"></text>
		  <viewInfo lookupType="One" lookupId="dmchucvu" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_cv" lookupInfo="dmchucvu|ma_cv|ten_cv" />
		</field>
		<field name="ten_cv" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
		  <text v="" e=""></text>
		</field>

      </fields>
	</form>
  </forms>

&DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmdtcntd(p){
  this.constructor(p);
}
dir$dmdtcntd.prototype = new DirEvent();
dir$dmdtcntd.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmdtcntd.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid();

dir$dmdtcntdDisabledMasterField(p, g);

}
dir$dmdtcntd.prototype.formFieldValueChange = function(o, cF, v) {
    var p = this._dir;
	switch (cF){
		case 'ma_nv':
			console.log(v);
			p.request('info_request', '', [['ma_nv', 'C', v]]);
		break;
		default:
		break;
	}
};
function dir$dmdtcntdDisabledMasterField(p, g){
  if(p.valForm('ma_nv').trim() != '')
  {
	p.setDisabled('ma_nv', true);
  }
  else
  {
	p.setDisabled('ma_nv', false);
  }
	}
         ]]>
    </text>
  </js>
<css>
	<text>
		  <![CDATA[
		.modal-dialog-lg{min-width:720px!important;}
		.control-label.tt {color: #499b98; text-decoration: underline}
		.control-label.ma_nv, .control-label.dien_thoai {color: #499b98;}
		  ]]>
	</text>
</css>
  <script>
	<request code="info_request">
		<text>		
			<![CDATA[
SELECT TOP 1 a.ten_nv as [!ho_ten], a.ma_pb as [!ma_pb] , CAST('' AS NVARCHAR(32)) as [!ten_pb],
	a.ma_bp as [!ma_bp], CAST('' AS NVARCHAR(32)) as [!ten_bp],
	a.ma_cv as [!ma_cv], CAST('' AS NVARCHAR(32)) as [!ten_cv]
into #dmnv
FROM dmnv a
WHERE a.ma_nv = @ma_nv

UPDATE #dmnv SET [!ten_pb] = (SELECT ISNULL(MAX(ten_pb), '') FROM dmpb WHERE ma_pb = #dmnv.[!ma_pb] AND 1=1)
UPDATE #dmnv SET [!ten_bp] = (SELECT ISNULL(MAX(ten_bp), '') FROM dmbp WHERE ma_bp = #dmnv.[!ma_bp] AND ma_pb = #dmnv.[!ma_pb])
UPDATE #dmnv SET [!ten_cv] = (SELECT ISNULL(MAX(ten_cv), '') FROM dmchucvu WHERE ma_cv = #dmnv.[!ma_cv] AND 1=1)

SELECT * FROM #dmnv

DROP TABLE #dmnv
			]]>
		</text>
	</request>
  <inserting>
      <text>
        <![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit, @status = @status
]]>
      </text>
    </inserting>
	<importing>
      <text>
        <![CDATA[
update #data set unit_id = @@unit
@@insert
        ]]>
      </text>
    </importing>
  </script>
  <messages>
    <message val="codeExistsNewMsg">
      <text v="Số điện thoại đã tồn tại" e="Phone number is exists"/>
    </message>
    <message val="taxtCodeExists">
      <text v="Số điện thoại đã tồn tại" e="Phone number is exists"/>
    </message>
  </messages>
</dir>
