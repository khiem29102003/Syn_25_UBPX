		<field name="status" viewType="Combobox" label="1" field="1" operation="like" >
          <text v="Trạng thái" e="Status"></text>
		  <viewInfo>
			<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				<option val="">
                <text v="Tất cả" e="All"></text>
              </option>
			</options>
		  </viewInfo>
		</field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmkhac(p){
  this.constructor(p);
}
filter$dmkhac.prototype = new DirEvent();
filter$dmkhac.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
