<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="qlcncstbls" table="pldancu" fieldKey="ma_dancu" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Quản lý cá nhân chính sách Thương binh - Liệt sĩ" e="War Invalids and Martyrs Policy Beneficiaries Management"></title>
  <title0 v="Thêm mới - Thương binh Liệt sĩ" e="New - War Invalids and Martyrs"></title0>
  <title1 v="Sửa - Thương binh Liệt sĩ" e="Edit - War Invalids and Martyrs"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120,120" >
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_dancu" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" importable="5">
			  <text v="Mã dân cư" e="Household Head Code"></text>
			  <viewInfo lookupType="One" lookupId="qldctcccd" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_dancu" lookupInfo="qldctcccd|ma_dancu|ten_dancu" />
			</field>
			<field name="ten_dancu" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ma_pldancu" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false" importable="10">
				<text v="Mã phân loại" e="Classification Code"></text>
				<viewInfo lookupType="One" lookupId="dmpldancu" lookupKey="ma_pl in ('TB', 'LS') and status = 1" lookupCheck="1=1" lookupRef="ten_pldancu" lookupInfo="dmpldancu|ma_pl|ten_pl" />
			</field>
			<field name="ten_pldancu" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ngay_bd" label="1" field="1" dataType="D" allowBlank="false" inactivate="false" nextRow="true" importable="15">
				<text v="Từ ngày" e="From Date"></text>
			</field>
			<field name="khoang_cach" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="[100]">
				<text v="" e=""></text>
			</field>
			<field name="ngay_kt" label="1" field="1" dataType="D" allowBlank="true" inactivate="true" nextRow="false" importable="20">
				<text v="Đến ngày" e="To date"></text>
			</field>
			<field name="so_giay_cn" label="1" field="1" allowBlank="true" inactivate="false" importable="25">
				<text v="Số giấy chứng nhận" e="Certificate No."></text>
			</field>
			<field name="khoang_cach" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="[100]">
				<text v="" e=""></text>
			</field>
			<field name="cap_boi" label="1" field="-" allowBlank="true" inactivate="false" nextRow="false" importable="30">
				<text v="Cơ quan cấp" e="Issuing Authority"></text>
			</field>
			<field name="muc_tro_cap" dataType="N" format="Amount" label="1" field="1" allowBlank="true" disabled="false" importable="35">
				<text v="Mức trợ cấp" e="Allowance Amount"></text>
			</field>
			<field name="status" viewType="Combobox" nextRow="true" inactivate="false" label="1" field="2" importable="40">
			  <text v="Trạng thái" e="STatus"></text>
			  <viewInfo>
				<options>
					<option val="0">
						<text v="Đang hưởng chế độ" e="Currently receiving benefits"></text>
					</option>
					<option val="1">
						<text v="Đã kết thúc" e="Finished"></text>
					</option>
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
	<form tabPageIndex="1" gravity="MiddleLeft" height="250" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="ma_dancu" fileGroup="qlcncstbls" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
</forms>

&DefaultButton;

<js>
    <text>
  <![CDATA[
function dir$qlcncstbls(p){
  this.constructor(p);
}
dir$qlcncstbls.prototype = new DirEvent();
dir$qlcncstbls.prototype.afterInit = function(){
  var p = this._dir;
}
dir$qlcncstbls.prototype.afterInit = function(renderType){
  var p = this._dir;

dir$qlcncstblsDisabledMasterField(p);

}

function dir$qlcncstblsDisabledMasterField(p){
var maPl = p.valForm('ma_dancu');
	if(maPl) {
		p.setDisabled('ma_dancu', true);
	} else {
		p.setDisabled('ma_dancu', false);
	}
}
         ]]>
    </text>
  </js>
	<css>
		<text>
			  <![CDATA[
.modal-dialog-lg{min-width:720px!important;}
.control-label.tt {color: #499b98; text-decoration: underline}
.control-label.ma_dancu {color: #499b98;}
			  ]]>
		</text>
	</css>
	<script>
		<query>
		  <text>
			<![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @action in ('EDIT', 'VIEW') exec ISWIFTStoreGetListFiles 'xfile', @ma_dancu, 'qlcncstbls', '', @script output
if @script is null set @script = ''

select @script as script
drop table #@@table
			 ]]>
		  </text>
		</query>
		<updated>
		  <text>
			<![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]
update dmttin set status = 0 from dmttin where id0 = rtrim(@ma_dancu) and xgroup = 'qlcncstbls'
if @xfile <> '' update dmttin set status = 1, id0 = @ma_dancu from dmttin where charindex(id, @xfile) > 0 and xgroup = 'qlcncstbls'

			 ]]>
		  </text>
		</updated>
		<inserting>
		  <text>
			<![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
			]]>
		  </text>
		</inserting>
		<inserted>
		  <text>
			<![CDATA[
if @xfile <> '' update dmttin set status = 1, id0 = @ma_dancu from dmttin where charindex(id, @xfile) > 0 and xgroup = 'qlcncstbls'

			]]>
		  </text>
		</inserted>
		<importing>
			<text>
			<![CDATA[
update #data set unit_id = @@unit
@@insert
			]]>
			</text>
		</importing>
	</script>
	<messages>
		<message val="codeExistsNewMsg">
		  <text v="Mã cư dân đã tồn tại trong danh sách" e="Resident code already exists in the list"/>
		</message>
	</messages>
</dir>
