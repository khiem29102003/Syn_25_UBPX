<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="n21Approve" dirViewType="Grid" selectMultiple="Table" voucherCode="PF1" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Duyệt phiếu đề xuất" e="Approve proposals"></title>
  <subtitle v="Xử lý &lt;b&gt;%s&lt;/b&gt; phiếu đề xuat" e="&lt;b&gt;%s&lt;/b&gt; proposal form"></subtitle>

  <grids>
    <grid table="n21" fieldKey="id" order="id desc" key="xstatus in (0)" allowFilter="true" allowOrder="true">
      <fields>
	  <field name="ma_ct" width="0">
          <text v="Mã c/từ" e="Voucher Code"></text>
        </field>
        <field name="so_ct" width="80" link="V" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày hiệu lực" e="Voucher Date"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
		<field name="ma_dv" width="250" hidden="true">
          <text v="Mã đơn vị" e="Unit code"></text>
        </field>
		<field name="ten_dv" width="150" fieldType="EX">
		  <text v="Tên đơn vị" e="Unit name"></text>
		</field>
		<field name="ma_pb" width="250" hidden="true">
          <text v="Mã phòng ban" e="Department code"></text>
        </field>
		<field name="ten_pb" width="150" fieldType="EX">
		  <text v="Tên phòng ban" e="Department name"></text>
		</field>
		<field name="ma_bp" width="250" hidden="true">
          <text v="Mã bộ phận" e="Parts code"></text>
        </field>
		<field name="ten_bp" width="150" fieldType="EX">
		  <text v="Tên bộ phận" e="Parts name"></text>
		</field>
		<field name="ma_nv" width="250" hidden="true">
          <text v="Mã nhân viên" e="Employee ID"></text>
        </field>
		<field name="ten_nv" width="150" fieldType="EX">
		  <text v="Tên nhân viên " e="Employee name"></text>
		</field>
		<field name="ma_hmdx" width="150" hidden="true">
          <text v="Hạng mục đề xuất" e="Recommended items"></text>
        </field>
		<field name="ten_hmdx" width="150" fieldType="EX">
		  <text v="Hạng mục đề xuất" e="Recommended items"></text>
		</field>
		<field name="ma_loaidx" width="150" hidden="true">
          <text v="Loại đề xuất" e="Proposal type"></text>
        </field>
		<field name="ten_loaidx" width="150" fieldType="EX">
		  <text v="Loại đề xuất" e="Proposal type"></text>
		</field>
		<field name="tieu_de" width="200" >
		  <text v="Tiêu đề" e="Title"></text>
		</field>
		<field name="noi_dung" width="200" >
		  <text v="Nội dung" e="Content"></text>
		</field>
		<field name="ly_do" width="200" >
		  <text v="Lý do" e="Reason"></text>
		</field>
		<field name="gop_y" width="200" >
		  <text v="Góp ý" e="Feedback"></text>
		</field>
		<field name="unit_id" hidden="true" dataType="I" width="0" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="0" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="id" fieldType="PK" hidden="true" width="120">
          <text v="" e=""></text>
        </field>
      </fields>

      <buttons>
        <button id="approve">
          <text v="Duyệt" e="Approve"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="find">
          <text v="$FindToolbar" e="$FindToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
  <script>
    <request code="Approve" transaction="true">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>
    <request code="Close" transaction="true">
      <text>
        <![CDATA[<enc>puK4p+NYsDqsHf5dn+qH1oAd9RSu5ThEOUOMVTb0nSTMAEpUBOMd8I4FZFo7DEaQKVR0k3Sg//DkpZmW8NQucHLcNLk466Edn6jnzRCu2IQsC0hlE8nTi7wL/0DwXBD4sP2BvEg0uxO8zYoI8t7+WDdOc9RY4+02Dg/B+ctNvajKIkfCMnaHPqdtWFp8ZO2bPK5f+2xLUWQ/B2nn7MI/eJMfXCqLK6xN8D8zbbaG/CqeKoWqWLR0qS7ahodngTat</enc>]]>
      </text>
    </request>

    &VoucherJSLoading;
  </script>

  <messages>
    <message val="msg1">
      <text v="Bạn có chắc chắn sẽ &lt;b&gt;duyệt&lt;/b&gt; các phiếu được chọn không?" e=""/>
    </message>
    <message val="msg2">
      <text v="Bạn có chắc chắn sẽ &lt;b&gt;bỏ duyệt&lt;/b&gt; các phiếu được chọn trở về trạng thái [Chờ duyệt] không?" e=""/>
    </message>
    <message val="msg3">
      <text v="Bạn có chắc chắn sẽ &lt;b&gt;bỏ đóng&lt;/b&gt; các phiếu được chọn trở về trạng thái [Đã duyệt] không?" e=""/>
    </message>
    <message val="close">
      <text v="Hủy/đóng" e="Close"/>
    </message>
    <message val="approve">
      <text v="Duyệt" e="Approve"/>
    </message>
    <message val="undo">
      <text v="Bỏ duyệt" e="Undo"/>
    </message>
    <message val="open">
      <text v="Bỏ đóng" e="Open &amp; Approve"/>
    </message>
      <message val="inputTitle">
      <text v="Nhập lý do hủy phiếu" e=""/>
    </message>
    <message val="reason">
      <text v="Lý do" e="Reason"/>
    </message>
  </messages>
</dir>