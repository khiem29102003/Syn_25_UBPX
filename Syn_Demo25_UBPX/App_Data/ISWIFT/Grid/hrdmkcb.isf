<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridFinding.xml">
]>

<dir id="hrdmkcb" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nơi đăng ký KCB" e="Medical Care Center List"></title>
  <subtitle v="Cập nhật nơi đăng ký KCB: thêm, sửa, xóa..." e="Add, Edit, Delete Medical Care Center..."></subtitle>
  <grids>
    <grid table="hrdmkcb" fieldKey="ma_kcb" order="ma_kcb" allowFilter="true" allowOrder="true" key="" >
      <fields>
        <field name="ma_kcb" fieldType="PK" width="80">
          <text v="Mã đăng ký" e="Code"></text>
        </field>
        <field name="ten_kcb" width="250">
          <text v="Tên đăng ký" e="Description"></text>
        </field>
        <field name="ma_tinh" width="100">
          <text v="Tỉnh thành" e="Province/City"></text>
        </field>
        <field name="benh_vien" width="100">
          <text v="Bệnh viện" e="Hospital"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

