<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="thnxk" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Tổng hợp nhập/xuất kho" e="Receipt/Issue Summary"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_vt" link="~bknxk" operation="=" width="100">
          <text v="Mã hàng hóa" e="Goods Code"></text>
        </field>
        <field name="ten_vt" width="250">
          <text v="Tên hàng hóa" e="Goods Name"></text>
        </field>

        <field name="sl_nhap" dataType="N" format="Qty" width="100">
          <text v="Sl nhập" e="Received Q'ty"></text>
        </field>
        <field name="tien_nt_nhap" dataType="N" format="FCAmount" width="100">
          <text v="Tiền nhập nt" e="FC Receive Amt."></text>
        </field>
        <field name="tien_nhap" dataType="N" format="Amount" width="100">
          <text v="Tiền nhập" e="Receive Amt."></text>
        </field>

        <field name="sl_xuat" dataType="N" format="Qty" width="100">
          <text v="Sl xuất" e="Issued Q'ty"></text>
        </field>
        <field name="tien_nt_xuat" dataType="N" format="FCAmount" width="100">
          <text v="Tiền xuất nt" e="FC Issued Amt."></text>
        </field>
        <field name="tien_xuat" dataType="N" format="Amount" width="100">
          <text v="Tiền xuất" e="Issued Amt."></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
</dir>