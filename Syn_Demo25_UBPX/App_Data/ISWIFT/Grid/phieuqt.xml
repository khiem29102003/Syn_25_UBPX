<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="phieu_qt" dirViewType="Grid" dirObjectType="Voucher" voucherCode="LDX0" xmlns="urn:schemas-iswift:struct-dir">
	<title v="Quyết toán dịch vụ" e="Service settlement"></title>
	<subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

	<grids>
		<grid table="phieu_qt" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
			<fields>
				<field name="so_ct" width="100" >
				  <text v="Số c/từ" e="Voucher Number"></text>
				</field>
				<field name="ngay_ct" width="100" dataType="D">
				  <text v="Ngày c/từ" e="Voucher Date"></text>
				</field>
				<field name="ma_kh" width="120" >
				  <text v="Mã khách hàng" e="Customer code"></text>
				</field>
				<field name="ma_sdt" width="120" >
				  <text v="Số điện thoại" e="Phone Number"></text>
				</field>
				<field name="ngay_den" width="120" >
				  <text v="Ngày đến" e="Arrival date"></text>
				</field>
				<field name="gio_den" width="120" >
				  <text v="Giờ đến" e="Arrival time"></text>
				</field>
				<field name="ngay_giao_xe" width="120" >
				  <text v="Ngày giao xe" e="Delivery date"></text>
				</field>
				<field name="gio_giao_xe" width="120" >
				  <text v="Giờ giao xe" e="Delivery time"></text>
				</field>
				<field name="unit_id" hidden="true" dataType="I" width="80" >
				  <text v="Unit ID" e="Unit ID"></text>
				</field>
				<field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
				  <text v="" e=""></text>
				</field>
			</fields>
			&DefaultButton;
		</grid>
	</grids>

	<js>
		<text>
			<![CDATA[
				function grid$phieu_qt(f){
				  this.constructor(f);
				}
				grid$phieu_qt.prototype = new DirEvent();
				grid$phieu_qt.prototype.afterInit = function(renderType){
				  var p = this._dir;
				}
			]]>
		</text>
	</js>
	<css>
    <text>
		<![CDATA[
		.toolbar-close > div {
			background-position: -336px -400px !important;
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
</dir>