<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="s42" dirViewType="Grid" dirObjectType="Voucher" voucherCode="BQ2" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo giá vận tải đường biển LCL" e="LCL Ocean Freight Quote"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="s42" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
        <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="100" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="so_ct" width="80" hidden="true"  >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
		<field name="ma_job" width="100" hidden = "false" link="V" >
          <text v="Mã job" e="Job Code"></text>
        </field>
		<field name="so_job" width="100" link="V" >
          <text v="Số job" e="Job Number"></text>
        </field>

        <field name="ma_kh" width="150" hidden = "false">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250" fieldType="EX" >
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>     
		<field name="ma_noi_di" width="0" hidden="false">
          <text v="Nơi đi" e="Origin"></text>
        </field>
		<field name="ten_noi_di" width="250" fieldType="EX">
		  <text v="Nơi đi " e="Origin"></text>
		</field>
		<field name="ma_noi_den" width="0" hidden="false" >
          <text v="Nơi đến" e="Destination"></text>
        </field>	
		<field name="ten_noi_den" width="250" fieldType="EX" >
		  <text v="Nơi đến " e="Destination"></text>
		</field>		
		<field name="ma_hang" width="150" >
          <text v="Mã Hãng tàu/Đại lý" e=" Carrier/Agent Code"></text>
        </field>
		<field name="ten_hang" width="250" fieldType="EX" >
          <text v="Tên Hãng tàu/Đại lý" e="Carrier/Agent Name"></text>
        </field>
		<field name="ngay_hl" width="120" dataType="D">
          <text v="Ngày hiệu lực" e="Effective Date"></text>
        </field>
		<field name="ngay_hld" width="120" dataType="D">
          <text v="Hiệu lực đến" e="Expiry Date"></text>
        </field>
		<field name="ma_nt" width="0" >
          <text v="Ngoại tệ" e="Currency"></text>
        </field>
		<field name="t_tong_trong" width="120" >
          <text v="Tổng trọng lượng" e="Total Gross Weight"></text>
        </field>
		<field name="t_tong_khoi" width="120" >
          <text v="Tổng volume" e="Total Volume"></text>
        </field>
		<field name="dien_giai" width="250">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		<field name="ma_ngv" viewType="Combobox" inactivate="true" width="120">
          <text v="Loại báo giá" e="Inv. Type"></text>
          <viewInfo>
            <options query="select ma_ngv, ten_ngv%l from dmngv where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>5wErx4q93yz4A4Cu1Ug/I2cTecPoalbpwNr/U1EJdxY5x19YmEmNscRiwn2BTKTv/Q/EXAUMsZIQQcD0rxAnNDvs8mjFnOPCB8918B6E1f6HYvZ2xjlcL++mnE3hdUKF9YvKC8JRVazINb3xLc4D/avQhB4ZbbUZvL+WllVFA2ST+qrqZZNjO9leFyjNCc662SW0BGahwiQnntm2ewrbfQ==</enc>]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    &VoucherJSLoading;
  </script>
</dir>