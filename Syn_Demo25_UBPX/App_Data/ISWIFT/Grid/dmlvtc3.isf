<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
	<!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmlvtc3" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
	<title v="Danh mục nghành hàng cấp 3" e="Level 3 product catalog"></title>
	<subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
	<grids>
		<grid table="dmlvtc3" fieldKey="ma_lvtc3" order="ma_lvtc3" allowFilter="true" allowOrder="true" >
			<fields>
				<field name="ma_lvtc3" link="1" width="150" fieldType="PK">
					<text v="Mã nghành hàng" e="Industry code"></text>
				</field>
				<field name="ten_lvtc3" width="250">
					<text v="Tên nghành hàng" e="Industry name"></text>
				</field>
				<field name="ten_khac" width="250">
					<text v="Tên khác" e="Other name"></text>
				</field>
				<field name="unit_id" width="120">
					<text v="Đơn vị" e="Unit"></text>
				</field>
				<field name="thu_tu" width="100">
					<text v="Thứ tự" e="Position"></text>
				</field>	
				<field name="status" width="120">
					<text v="Trạng thái" e="Status"></text>
				</field>
			</fields>

			&DefaultButton;

		</grid>
	</grids>

