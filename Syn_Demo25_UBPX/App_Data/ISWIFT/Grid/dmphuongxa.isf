<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmphuongxa" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phường/xã" e="Ward/Commune List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmphuongxa" fieldKey="ma_phuongxa" order="ma_phuongxa" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_phuongxa" fieldType="PK" width="120">
          <text v="Mã phường/xã" e="Ward/Commune Code"></text>
        </field>
        <field name="ten_phuongxa" width="250">
          <text v="Tên phường/xã" e="Ward/Commune Name "></text>
        </field>
		<field name="ten_phuongxa2" width="250">
          <text v="Tên tiếng anh" e="English name "></text>
        </field>
		<field name="ma_loai" viewType="Combobox" width="100">
		  <text v="Mã loại" e="Type Code"></text>
          <viewInfo>
            <options>
              <option val="phuong">
                <text v="Phường" e="Ward"/>
              </option>
              <option val="xa">
                <text v="Xã" e="Commune"/>
              </option>
			   <option val="dackhu">
                <text v="Đặc khu" e="Special Zone"/>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="ma_ttp" width="120">
          <text v="Mã tỉnh/thành" e="Province/City Code "></text>
        </field>
		<field name="ten_ttp" width="250"  hidden="true" fieldType="EX" >
          <text v="Tỉnh thành" e="Province/City"></text>
        </field>

		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_tt, ten_tt%l from dmttsd where status = 1">
            </options>
          </viewInfo>
        </field>
      </fields>

      &DefaultButton;
	<script>
		<query>
		  <text>
		  <![CDATA[<enc>HUJkcPcGuF7ox4j4icaDbUO0tlnRLcOMi/8WKcO2PVdM0UkkGEOwqVoSIWKF4daGTfhRSc7oAk4qkcP8eEfmsdR4q/prD8UqG7mDAfQmUL9d46kQelTE3x27yaQJ5MD6G6PWM2hIqjqjEsp/irDZJOdnAbRZC35v3kwm6whSpfnihRIV8rMWYT+AmAoM24lCyTnDp5baZyADMt7HRrJGU9Om30hrLFCZManpsNyVhiU=</enc>]]>
