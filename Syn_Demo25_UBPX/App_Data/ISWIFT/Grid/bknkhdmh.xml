<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="bknkhdmh" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Nhật ký hóa đơn mua hàng" e="Sales Invoice Diary"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_unit" width="80" aliasName="d" join="left join sysunit d on a.unit_id = d.unit_id" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="so_ct" width="100" link="V" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ma_kh" width="100">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250" aliasName="b" join="left join dmkh b on a.ma_kh = b.ma_kh">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
        <field name="dien_giai" width="250">
          <text v="Diễn giải" e="Description"></text>
        </field>
        <field name="ma_vt" width="100">
          <text v="Mã hàng hóa" e="Goods Code"></text>
        </field>
        <field name="ten_vt" width="250" aliasName="c" join="left join dmvt c on a.ma_vt = c.ma_vt">
          <text v="Tên hàng hóa" e="Goods Name"></text>
        </field>
        <field name="dvt" width="50">
          <text v="Đvt" e="UOM"></text>
        </field>
        <field name="sl_nhap" dataType="N" format="Qty" width="100">
          <text v="Số lượng" e="Quantity"></text>
        </field>
        <field name="gia_nt2" dataType="N" format="FCPrice" width="100">
          <text v="Giá mua nt" e="FC Price"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="FCAmount" width="100">
          <text v="Thành tiền nt" e="FC Money"></text>
        </field>
        <field name="thue_nt" dataType="N" format="FCAmount" width="100">
          <text v="Thuế nt" e="FC Tax Amt."></text>
        </field>
        <field name="ck_nt" dataType="N" format="FCAmount" width="100">
          <text v="Chiết khấu nt" e="FC Discount Amt."></text>
        </field>
        <field name="pt_nt" dataType="N" format="FCAmount" width="100">
          <text v="Phải chi nt" e="FC Receivable Amt."></text>
        </field>
        <field name="gia_nt" dataType="N" format="FCPrice" width="0">
          <text v="Giá vốn nt" e="FC Cogs"></text>
        </field>
        <field name="tien_nt_nhap" dataType="N" format="FCAmount" width="0">
          <text v="Tiền vốn nt" e="FC Cogs Amt."></text>
        </field>
        <field name="ma_nt" width="60">
          <text v="Mã nt" e="FC Code"></text>
        </field>
        <field name="ty_gia" dataType="N" format="ExRate" width="100">
          <text v="Tỷ giá" e="Exchange Rate"></text>
        </field>
        <field name="gia2" dataType="N" format="Price" width="100">
          <text v="Giá mua" e="Price"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100">
          <text v="Thành tiền" e="Money"></text>
        </field>
        <field name="thue" dataType="N" format="Amount" width="100">
          <text v="Thuế" e="Tax Amt."></text>
        </field>
        <field name="ck" dataType="N" format="Amount" width="100">
          <text v="Chiết khấu" e="Discount Amt."></text>
        </field>
        <field name="pt" dataType="N" format="Amount" width="100">
          <text v="Phải chi" e="Receivable Amt."></text>
        </field>
        <field name="gia" dataType="N" format="Price" width="0">
          <text v="Giá vốn" e="Cogs"></text>
        </field>
        <field name="tien_nhap" dataType="N" format="Amount" width="0">
          <text v="Tiền vốn" e="Cogs Amt."></text>
        </field>
        <field name="ma_kho" width="0" >
          <text v="Mã kho" e="Site"></text>
        </field>
        <field name="ma_bp" width="0" >
          <text v="Mã bộ phận" e="Department"></text>
        </field>
        <field name="ma_vv" width="0" >
          <text v="Mã vụ việc" e="Job"></text>
        </field>

        <field name="unit_id" dataType="I" hidden="true" width="100" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="id" dataType="I" hidden="true" width="100" >
          <text v="ID" e="ID"></text>
        </field>
        <field name="ma_ct" width="100" hidden="true">
          <text v="Mã chứng từ" e="VC Code"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$bknkhdmh(f){
  this.constructor(f);
}
grid$bknkhdmh.prototype = new DirEvent();
grid$bknkhdmh.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$bknkhdmh.prototype.beforeInit = function(){
  var p = this._dir;
}
grid$bknkhdmh.prototype.afterInit = function(){
  var p = this._dir, g = p.grid(), dt = g.data;

  if (p.options._mau_bc == 1) p.setColumnHidden(0, ['gia_nt2', 'tien_nt2', 'thue_nt', 'ck_nt', 'pt_nt', 'gia_nt', 'tien_nt_xuat', 'ma_nt', 'ty_gia', 'gia2', 'tien2', 'thue', 'ck', 'pt', 'gia', 'tien_xuat'], true);
  if (p.options._mau_bc == 2) p.setColumnHidden(0, ['gia_nt2', 'tien_nt2', 'thue_nt', 'ck_nt', 'pt_nt', 'gia_nt', 'tien_nt_xuat', 'ma_nt', 'ty_gia'], true);
}
]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[
		//.toolbar-close > div {
		//	background-position: -336px -400px !important;
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
  <script>
    <processing>
      <text>
        <![CDATA[
exec ss_bknkhdmh @ngay_ct1, @ngay_ct2, '@@gridJoin', '@@gridFields', @strJoin, @strFinding, @loai_du_lieu, @ma_unit, '@@lan', @@userId, @@admin
        ]]>
      </text>
    </processing>
  </script>
</dir>