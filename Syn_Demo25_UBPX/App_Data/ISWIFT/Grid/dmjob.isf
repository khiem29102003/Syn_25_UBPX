<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmjob" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục Job" e="List of Job"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmjob" fieldKey="ma_ct" order="ma_ct" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_ct" fieldType="PK" width="120">
          <text v="Mã job" e="Job code"></text>
        </field>
        <field name="ten_ct" width="250">
          <text v="Tên job" e="Job name"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      <buttons>
  <button id="add">
    <text v="$AddToolbar" e="$AddToobar"></text>
  </button>
  <button id="edit">
    <text v="$EditToolbar" e="$EditToolbar"></text>
  </button>
  <button id="delete">
    <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
  </button>
  <button id="copy">
    <text v="$CopyToolbar" e="$CopyToolbar"></text>
  </button>
  <button id="view">
    <text v="$ViewToolbar" e="$ViewToolbar"></text>
  </button>
  <button id="split">
    <text v="-" e="-"></text>
  </button>
  <button id="refresh">
    <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
  </button>
  <button id="freeze">
    <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
  </button>
  <button id="split">
    <text v="-" e="-"></text>
  </button>
  <button id="export">
    <text v="$ExportToolbar" e="$ExportToolbar"></text>
  </button>
</buttons>

    </grid>
  </grids>

