<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmdv" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục dịch vụ" e="Job List"></title>
  <subtitle v="Cập nhật dịch vụ: thêm, sửa, xóa..." e="Add, Edit, Delete Job..."></subtitle>
  <grids>
    <grid table="dmdv" fieldKey="ma_vv" order="ma_vv" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_vv" fieldType="PK" width="120">
          <text v="Mã dịch vụ" e="Job"></text>
        </field>
        <field name="ten_vv" width="250">
          <text v="Tên dịch vụ" e="Description"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$dmdv(f){
  this.constructor(f);
}
grid$dmdv.prototype = new DirEvent();
grid$dmdv.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
</dir>