<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmth" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thương hiệu/ Nhãn hàng" e="Vehicle List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmth" fieldKey="ma_th" order="ma_th" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_th" fieldType="PK" width="240">
          <text v="Mã Thương hiệu/ Nhãn hàng" e="Product type code"></text>
        </field>
		<field name="ten_th" width="220">
          <text v="Tên Thương hiệu/ Nhãn hàng" e="Product type name"></text>
        </field>
		<field name="ten_th2"  width="120">
          <text v="Tên khác" e="Alias"></text>
        </field>
		<field name="mo_ta" width="120">
          <text v="Mô tả" e="Description"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
		<field name="thu_tu" width="120">
          <text v="Thứ tự" e="Position"></text>
        </field>
		 
      </fields>

      &DefaultButton;

    </grid>
  </grids>

