<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="ss_bcsntttpb" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Số ngày trễ thanh toán bán hàng" e="Number of days to calculate sales"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
	<fields>	
        <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="120" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
		<field name="so_ngay_tre" width="100" align="Center">
          <text v="SỐ NGÀY TRỄ" e="DAYS PAST DUE"></text>
        </field>
		<field name="ma_job_s61" width="100" hidden = "false" >
          <text v="Mã Đơn Hàng" e="Job Code"></text>
        </field>
		<field name="so_job_s61" width="100" hidden = "false" link="V" >
          <text v="Số Đơn Hàng" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
		<field name="ma_kh" width="150" hidden="false">
          <text v="Mã người thanh toán" e="Employee Code"></text>
        </field>
		<field name="ten_kh" width="300">
          <text v="Tên người thanh toán" e="Employee Name"></text>
        </field>
		<field name="so_tk" width="150">
          <text v="Số tờ khai" e="Declaration number"></text>
        </field>
		<field name="t_tt" width="120" dataType="N" hidden="fasle">
		  <text v="Tiền mua" e="SPurchase Amount"></text>
        </field>
		<field name="t_ttx" width="120" dataType="N" hidden="fasle">
		  <text v="Tiền chi hộ" e="SPurchase Amount"></text>
        </field>
		<field name="tong_tien" width="120" dataType="N" hidden="fasle">
		  <text v="Tổng tiền" e="SPurchase Amount"></text>
        </field>
		<field name="ngay_phai_thanh_toan" width="120" dataType="D" align="center">
          <text v="Hạn thanh toán" e="Voucher Date"></text>
        </field>
		<field name="ngay_tt" width="180" dataType="D" align="center">
          <text v="Ngày thanh toán gần nhất" e="Voucher Date"></text>
        </field>
		<field name="tt" width="120" dataType="N" hidden="fasle">
		  <text v="Đã thanh toán" e="Settled"></text>
        </field>	
		<field name="t_cl" width="120" dataType="N" hidden="fasle">
		  <text v="Tiền còn lại" e="Remaining Balance"></text>
        </field>
		
		<!-- <field name="tat_toan" width="80" align="Center"> -->
          <!-- <text v="Tất toán" e="Settlement"></text> -->
        <!-- </field>	 -->
		<field name="dien_giai" width="250">
          <text v="Diễn giải" e="Explain"></text>
        </field>
      </fields>
      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$ss_bcsntttpb(f){
  this.constructor(f);
}
grid$ss_bcsntttpb.prototype = new DirEvent();
grid$ss_bcsntttpb.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$ss_bcsntttpb.prototype.beforeInit = function(){
  var p = this._dir;
}
grid$ss_bcsntttpb.prototype.afterInit = function(){
  var p = this._dir, g = p.grid(), dt = g.data;
}
]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}
		.grid-column.so_ngay_tre{
			color: red;
		}
		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
  <script>
    <processing>
      <text>
        <![CDATA[
exec ss_bcsntttpb @ngay_ct1, @ngay_ct2, @ma_kh, @ps
		]]>
      </text>	
    </processing>
  </script>
</dir>