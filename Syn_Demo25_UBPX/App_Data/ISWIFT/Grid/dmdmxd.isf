        </field>
		<field name="ten_xd" width="220" fieldType="EX">
          <text v="Tên nhiên liệu" e="Staff name"></text>
        </field>	
		<field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày hiệu lực" e="Effective date"></text>
        </field>
     </fields>
