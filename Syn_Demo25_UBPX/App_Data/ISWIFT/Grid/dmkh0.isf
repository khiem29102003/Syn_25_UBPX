<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
   <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmkh0" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục khách hàng" e="List of Customer"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit..."></subtitle>
  <grids>
    <grid table="dmkh0" fieldKey="ma_so_thue" order="ma_so_thue" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_so_thue" width="120" fieldType="PK" link = "1">
          <text v="Mã số thuế" e="Tax Code"></text>
        </field>
        <field name="ten_kh" width="250">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>      
		<field name="ten_kh2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="dia_chi" width="250">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="kh_yn" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Khách hàng" e="Customer"></text>
        </field>
        <field name="ma_nvbh" width="120">
          <text v="Mã nhân viên" e="Employee"></text>
        </field>
		<field name="nh_kh1" width="120">
          <text v="Nhóm 1" e="Group 1"></text>
        </field>
		<field name="ten_nh_kh1" width="200" fieldType="EX">
          <text v="Tên nhóm 1" e="Group 1"></text>
        </field>
		<field name="nh_kh2" width="120">
          <text v="Nhóm 2" e="Group 2"></text>
        </field>
		<field name="ten_nh_kh2" width="200" fieldType="EX">
          <text v="Tên nhóm 2" e="Group 2"></text>
        </field>
		<field name="nh_kh3" width="120">
          <text v="Nhóm 3" e="Group 3"></text>
        </field>
		<field name="ten_nh_kh3" width="200" fieldType="EX">
          <text v="Tên nhóm 3" e="Group 3"></text>
        </field>
		<field name="ghi_chu" width="200">
          <text v="Ghi chú" e="Note"></text>
        </field>
		
		<field name="status" viewType="Combobox" width ="150" valueDefault="1">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_tt, ten_tt%l from dmttsd where status = 1 order by ma_tt">
            </options>
          </viewInfo>
        </field>
      </fields>
	  
	  &DefaultButton;	   
	  <script>
		<query>
			<text>
			<![CDATA[<enc></enc>]]>
			</text>
		</query>

		<finding>
			<text>
			<![CDATA[<enc></enc>]]>
			</text>
		</finding>
	  </script>

	</grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  <css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    <request code="viewtree">
      <text>
        <![CDATA[<enc>g+KZ+QKBlC+LdD0jHhpbmdKmFxfI+e4PKr7RwKzYsIiaidO3HABMT5bB8MUttTPVMG2UgiB9E+jyMZVE7uGlZw==</enc>]]>
      </text>
    </request>
  </script>

  <messages>
    <message val="TreeName">
      <text v="Cây phân vùng. khu vực" e="Region tree"/>
    </message>
  </messages>
</dir>