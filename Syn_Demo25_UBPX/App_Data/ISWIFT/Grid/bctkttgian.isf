<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="bctkttgian" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo cáo tồn kho theo thời gian" e="Aging Stock by Time" />
  <subtitle v="Ngày: {ngay_ct1}" e="Date: {ngay_ct1}"></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_vt" width="100">
          <text v="Mã hàng hóa" e="Goods Code"></text>
        </field>
        <field name="ten_vt" width="350">
          <text v="Tên hàng hóa" e="Goods Name"></text>
        </field>
        <field name="dvt" width="80">
          <text v="Đvt" e="UOM"></text>
        </field>
        <field name="so_luong" dataType="N" format="Qty" width="120">
          <text v="Số lượng" e="Q'ty"></text>
        </field>
        <field name="ky" width="100">
          <text v="Kỳ" e="Month"></text>
        </field>
        <field name="ten_ky" width="100">
          <text v="Tên kỳ" e="Month Name"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

