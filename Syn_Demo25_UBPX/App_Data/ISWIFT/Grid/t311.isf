<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="t311" dirViewType="Grid" dirObjectType="Voucher" voucherCode="TT1" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Tạo điều xe tròn tua" e="Create a shipment"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="t311" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
	  	<field name="ma_ldx" width="80" >
          <text v="Hình thức" e="Carrier"></text>
        </field>
        <field name="so_ct" width="100" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>

        <field name="ma_xe" width="0" hidden = "false">
          <text v="Mã đầu kéo" e="Tractor Code"></text>
        </field>
        <field name="ten_xe" width="250" fieldType="EX" >
          <text v="Đầu kéo" e="Tractor Name"></text>
        </field>
		<field name="ten_ldx" width="250" fieldType="EX" >
          <text v="Tên hình thức" e="Carrier"></text>
        </field>
		<field name="ma_tx" width="0" >
          <text v="Tài xế" e="Carrier"></text>
        </field>
		<field name="ten_tx" width="250" fieldType="EX" >
          <text v="Tài xế" e="Carrier"></text>
        </field>			
		
		<field name="ma_rm" width="0" >
          <text v="Tên rơ mooc" e="Carrier"></text>
        </field>
		<field name="ten_rm" width="250" fieldType="EX" >
          <text v="Rơ mooc" e="Carrier"></text>
        </field>	
		
		<field name="dien_giai" width="250">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="120" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>jTwWP4URN13fjiNnm/IWVHWbxgislSrQr10kPl1PjemM8pHHdEtmysrmJiSFiJ24xF8Xa4QLDO4PZGXiRVr/SlYBhf32ib/G5YntKehj/HysmU7tRdFdFKKQLmDIccG2vUbk7KkiQ1xyjZPNMY9CRiAy7bj6AJwrDKIU6vaWDtCDWVE3Kj/JLg245BsGkJ/64fzY78fSei3nHb8Sue5ELg==</enc>]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    &VoucherJSLoading;
  </script>
</dir>