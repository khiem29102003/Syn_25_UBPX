<dir id="ss_bcdttt_tkh" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Bảng kê doanh thu trước thuế theo khách hàng" e="Detailed revenue before tax by customer"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>

		<field name="ma_kh" width="120">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
		<field name="ten_kh" width="300">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
			
		<field name="t_tieny2_m72" width="100" dataType="N" >
          <text v="Tiền mua" e="Purchase Cost"></text>
        </field>
		<field name="t_tieny2_m54" width="100" dataType="N" >
          <text v="Tiền bán" e="Sale Proceeds"></text>
        </field>
		<field name="t_tien_ln" width="100" dataType="N" >
          <text v="Lợi nhuận" e="Profit"></text>
        </field>

		
		
      </fields>

      &DefaultButton;
    </grid>
  </grids>

