<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="bctgdtt_kh" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Bảng chi tiết giao dịch thanh toán khách hàng" e="Sales Invoice Listing"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>
		
		<field name="stt_1" fieldType="EX"  width="50" align="center">
          <text v="STT" e="STT"></text>
        </field>
		<field name="so_ct" width="100" align="center">
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
		<field name="ngay_ct" width="120" dataType="D" align="center">
          <text v="Ngày C\từ" e="Customer Code"></text>
        </field>
		<field name="ma_kh" width="120"  hidden = "true">
          <text v="" e=""></text>
        </field>
		<field name="ten_kh" width="200" aliasName="b" join="left join dmkh b on a.ma_kh = b.ma_kh">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
		<field name="tt" width="150" dataType="N" format="FCAmount">
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
		<field name="dien_giai" width="200" >
          <text v="Diễn giải" e="Note"></text>
        </field>
		
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
