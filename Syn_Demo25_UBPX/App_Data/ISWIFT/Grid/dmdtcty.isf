<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmdtcty" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục điện thoại CTY" e="List of Phone company"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmdtcty" fieldKey="ma_sdt" order="ma_sdt" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_sdt" fieldType="PK" width="120">
          <text v="Mã số đt" e="Phone code"></text>
        </field>
        <field name="ten_sdt" width="250">
          <text v="Tên CTY" e="Company name "></text>
        </field>
		 <field name="status" width="250">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

