<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="bkctdvmh" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Bảng kê mua/chi hoạt động" e="Activity purchase/expenditure statement"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="so_ct" width="100" link="V" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ma_kh" width="100">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250" aliasName="b" join="left join dmkh b on a.ma_kh = b.ma_kh">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
		 
        <field name="ma_dv" width="100">
          <text v="Mã dịch vụ" e="Services Code"></text>
        </field>
        <field name="ten_dv" width="250" aliasName="d" join="left join dmdv d on a.ma_dv = d.ma_dv">
          <text v="Tên dịch vụ" e="Services Name"></text>
        </field>
		 <field name="so_luong" dataType="N" format="Price" width="100">
          <text v="Số lượng" e="Quantity"></text>
        </field>
       <field name="gia2" dataType="N" format="Price" width="100">
          <text v="Giá mua" e="Price"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100">
          <text v="Thành tiền" e="Turnover"></text>
        </field>
        <field name="thue" dataType="N" format="Amount" width="0">
          <text v="Thuế" e="Tax Amt."></text>
        </field>
        <field name="ck" dataType="N" format="Amount" width="0">
          <text v="Chiết khấu" e="Discount Amt."></text>
        </field>
        <field name="pt" dataType="N" format="Amount" width="0">
          <text v="Phải chi" e="Receivable Amt."></text>
        </field>
        <field name="gia" dataType="N" format="Price" width="0">
          <text v="Giá vốn" e="Cogs"></text>
        </field> 
        <field name="id" dataType="I" hidden="true" width="100" >
          <text v="ID" e="ID"></text>
        </field>
		
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$bkctdvmh(f){
  this.constructor(f);
}
grid$bkctdvmh.prototype = new DirEvent();
grid$bkctdvmh.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$bkctdvmh.prototype.beforeInit = function(){
  var p = this._dir;
}
grid$bkctdvmh.prototype.afterInit = function(){
  var p = this._dir, g = p.grid(), dt = g.data;

  if (p.options._mau_bc == 1) p.setColumnHidden(0, ['gia_nt2', 'tien_nt2', 'thue_nt', 'ck_nt', 'pt_nt', 'gia_nt', 'tien_nt_xuat', 'ma_nt', 'ty_gia', 'gia2', 'tien2', 'thue', 'ck', 'pt', 'gia', 'tien_xuat'], true);
  if (p.options._mau_bc == 2) p.setColumnHidden(0, ['gia_nt2', 'tien_nt2', 'thue_nt', 'ck_nt', 'pt_nt', 'gia_nt', 'tien_nt_xuat', 'ma_nt', 'ty_gia'], true);
}
]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
  <script>
    <processing>
      <text>
        <![CDATA[
exec ss_bkctdvmh @ngay_ct1, @ngay_ct2, '@@gridJoin', '@@gridFields', @strJoin, @strFinding, @ma_unit, '@@lan', @@userId, @@admin
        ]]>
      </text>
    </processing>
  </script>
</dir>