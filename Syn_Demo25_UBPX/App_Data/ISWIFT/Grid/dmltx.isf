<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmltx" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục loại kho & cảng" e="List of types warehouses and ports"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmltx" fieldKey="ma_loai" order="ma_loai" allowFilter="true" allowOrder="true" >
      <fields >
        <field name="ma_loai" fieldType="PK" width="120">
          <text v="Mã loại" e="Type Code"></text>
        </field>
        <field name="ten_loai" width="250">
          <text v="Tên loại" e="Type Name "></text>
        </field>
		 <field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>
      &DefaultButton;
    </grid>
  </grids>

