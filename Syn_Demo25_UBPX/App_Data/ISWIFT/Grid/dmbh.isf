<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridFinding.xml">
]>

<dir id="dmbh" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bảo hành" e="Cập nhật hạn mức nợ khách hàng"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit..."></subtitle>
  <grids>
    <grid table="dmbh" fieldKey="ma_bh" order="ma_bh" allowFilter="true" allowOrder="true">
      <fields>
        <field name="ma_bh" width="120" fieldType="PK" >
          <text v="Mã  bảo hành" e="Guarantee Code"></text>
        </field>
        <field name="ten_bh" width="350" >
          <text v="Tên bảo hành" e="Guarantee Name"></text>
        </field>
        <field name="ngay_bh" width="100" dataType="D">
          <text v="Ngày bảo hành" e="Date"></text>
        </field>
		 <field name="model" width="150" fieldType="PK" >
          <text v="Model" e="Model"></text>
        </field>
		 <field name="series" width="250"  >
          <text v="Series" e="Series"></text>
        </field>
		<field name="pn" width="150" >
          <text v="P/N" e="P/N"></text>
        </field>
		<field name="so_luong" width="150" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
		<field name="ma_kh" width="150" >
          <text v="Khách hàng" e="Customer code"></text>
        </field>
		<field name="noi_mua" width="150" >
          <text v="Nơi mua" e="Place of purchase"></text>
        </field>
      </fields>

      &DefaultButton;

   

    </grid>
  </grids>

  <js>
