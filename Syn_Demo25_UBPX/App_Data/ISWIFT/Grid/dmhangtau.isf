<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmhangtau" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hãng tàu" e="List Of Shipping Lines"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmhangtau" fieldKey="ma_hang" order="ma_hang" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_hang" fieldType="PK" width="120">
          <text v="Mã hãng" e="Brand Code"></text>
        </field>
        <field name="ten_hang" width="250">
          <text v="Tên hãng" e="Brand Name"></text>
        </field>
        <field name="ten_hang2" width="250">
          <text v="Tên khác" e="Another Name"></text>
        </field>
		<field name="ma_loai" width="120">
          <text v="Mã loại" e="Country code"></text>
        </field>
		<field name="ma_nhom" width="120">
          <text v="Mã nhóm" e="Group Code"></text>
        </field>
		<field name="ma_qg" width="120">
          <text v="Mã quốc gia" e="Country code"></text>
        </field>
		<field name="dia_chi" fieldType="PK" width="250" link="1">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="ma_thue" width="120">
          <text v="Mã thuế" e="Tax code"></text>
        </field>
        <field name="dien_thoai" width="120">
          <text v="Điện thoại" e="Phone"></text>
        </field>
        <field name="email" width="120">
          <text v="Email" e="Email"></text>
        </field>
		<field name="fax" width="120">
          <text v="FAX" e="Fax"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
