<dir id="dmbaohanh" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bảo hành" e="Warranty of List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbaohanh" fieldKey="ma_baohanh" order="ma_baohanh" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_baohanh" fieldType="PK" width="120">
          <text v="Mã bảo hành" e="Warranty code"></text>
        </field>
        <field name="ten_baohanh" width="250">
          <text v="Tên bảo hành" e="Warranty name"></text>
        </field>
		 <field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
		<field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="100" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
      </fields>

