<dir id="n15Approve" dirViewType="Grid" selectMultiple="Table" voucherCode="DT1" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Duyệt đề nghị nghỉ phép/ chế độ" e="Approve a training request form"></title>
  <subtitle v="Xử lý &lt;b&gt;%s&lt;/b&gt; phiếu yêu cầu đào tạo" e="&lt;b&gt;%s&lt;/b&gt; training request form"></subtitle>

  <grids>
    <grid table="n15" fieldKey="id" order="id desc" key="xstatus in (0,1)" allowFilter="true" allowOrder="true">
      <fields>
		<field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="120" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="so_ct" width="120" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày hiệu lực" e="Voucher Date"></text>
        </field>
		<field name="ma_nv" width="250" hidden="true">
          <text v="Mã nhân viên" e="Origin"></text>
        </field>
		<field name="ten_nv" width="120" fieldType="EX">
		  <text v="Tên nhân viên " e="Origin Name"></text>
		</field>
		<field name="ma_loainghi" width="250" hidden="true">
          <text v="Loại nghỉ" e="Origin"></text>
        </field>
		<field name="ten_loainghi" width="250" fieldType="EX">
		  <text v="Tên loại nghỉ" e="Origin Name"></text>
		</field>

		<field name="ma_ca" width="250" hidden="true">
          <text v="Ca" e="Origin"></text>
        </field>
		<field name="ten_ca" width="250" fieldType="EX">
		  <text v="Tên ca" e="Origin Name"></text>
		</field>
		
		<field name="so_gio" width="120" >
		  <text v="Số giờ" e="Origin Name"></text>
		</field>
        <field name="id" fieldType="PK" hidden="true" width="120">
          <text v="" e=""></text>
        </field>
      </fields>

      <buttons>
        <button id="approve">
          <text v="Duyệt" e="Approve"></text>
        </button>
        <button id="cancel">
          <text v="Hủy" e="Close"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="find">
          <text v="$FindToolbar" e="$FindToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  <css>
