<dir id="dmtygiakm" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Giá trị quy đổi KM" e="Exchange value"></title>
  <subtitle v="Cập nhật tỷ giá..." e="Add, Edit, Delete Exchange Rate..."></subtitle>
  <grids>
    <grid table="dmtygiakm" fieldKey="ma_dvt,ngay_hl" order="ma_dvt" allowFilter="true" allowOrder="true" >
      <fields >
        <field name="ma_dvt" fieldType="PK" width="120" >
          <text v="Mã đơn vị tính" e="Unit Code"></text>
        </field>
        <field name="ten_dvt" width="250" fieldType="EX"  aliasName="b">
          <text v="Tên đơn vị tính" e="Unit Name"></text>
        </field>
        <field name="ngay_hl" fieldType="PK" width="120" dataType="D">
          <text v="Ngày" e="Date"></text>
        </field>
        <field name="ty_gia" dataType="N" format="ExRate" width="120">
          <text v="Tỷ giá" e="Exchange Rate"></text>
        </field>
      </fields>

      &DefaultButton;

