<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucherImport.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="allsmail" dirViewType="Grid" dirObjectType="Voucher" voucherCode="SM2" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách gửi Mail vãng lai" e="Mailing list"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="allsmail" fieldKey="id" order="ngay_ct desc" allowFilter="true" allowOrder="true">
      <fields>
	    <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
	   <field name="ma_unit" width="120" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="ten_unit" width="200" fieldType="EX" hidden="true">
          <text v="Tên đơn vị" e="Unit Name"></text>
        </field>
        <field name="so_ct" width="100" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
		<field name="s_mail" width="400" >
          <text v="Mail gửi" e="Mail Sent"></text>
        </field>
        <field name="title" width="400" >
          <text v="Tiêu đề" e="Subject"></text>
        </field>
		<field name="ds_mail" width="400" >
          <text v="D/s mail" e="Mail Sent"></text>
        </field>
        <field name="email_body" width="500" >
          <text v="Nội dung" e="Body"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
		<field name="imageisf" width="100" fieldType="EX" hidden="true">
          <text v="Hình ảnh" e="Image"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="edit">
          <text v="$EditToolbar" e="$EditToolbar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
		<button id="view">
		  <text v="$ViewToolbar" e="$ViewToolbar"></text>
		</button>
		<button id="split">
		  <text v="-" e="-"></text>
		</button>
		<button id="refresh">
		<text v="$RefreshToolbar" e="$RefreshToolbar"></text>
		</button>
		<button id="freeze">
		<text v="$FreezeToolbar" e="$FreezeToolbar"></text>
		</button>
		<button id="split">
		<text v="-" e="-"></text>
		</button>
		<button id="print">
		<text v="$PrintToolbar" e="$PrintToolbar"></text>
		</button>
		<button id="export">
		<text v="$ExportToolbar" e="$ExportToolbar"></text>
		</button>
		<button id="split">
		<text v="-" e="-"></text>
		</button>
		<button id="downtemplate">
		<text v="Tải mẫu Excel" e="Down import template"></text>
		</button>
		<button id="import">
		<text v="Lấy dữ liệu từ Excel" e="Import data"></text>
		</button>
		<button id="send">
		  <text v="Gửi mail" e="Send an email"></text>
		</button>

      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc>n6SsM4/jSBKuL3BfLolp3JFiEX25/qMBpJKhhJEYZwYAj04FEwyCkp1jTTEqerNRVf0AMgKnU7ygDk0oyVT3hlytR6WYp00UaTppf+34Mh+FMiskJ2NiIZjlTfVAqQnc0EJjc39no/+cz3geH3rkZaQSQ7mbVx3vWKyKG0yiKebSKvxEPEsyjnKb3V5Wr0l5eO64CKbxKKcsO0zOUhfdzhBzHaKMItJOQ9JxltIRoSriovoMqqTcstrvTke3w0y2JESRjMj2u9P3nbXxFYZonw==</enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </js>
  <css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    &VoucherJSLoading;
