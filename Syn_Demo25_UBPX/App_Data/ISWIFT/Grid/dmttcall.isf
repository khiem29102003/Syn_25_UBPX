<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmttcall" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục trạng thái cuộc gọi" e="Call Status List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmttcall" fieldKey="ma_ttcall" order="ma_ttcall" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_ttcall" fieldType="PK" width="120">
          <text v="Mã trạng thái cuộc gọi" e="Call Status code"></text>
        </field>
        <field name="ten_ttcall" width="250">
          <text v="Tên trạng thái cuộc gọi" e="Call Status name"></text>
        </field>
		<field name="ma_td" width="120">
			<text v="Mã tác động" e="Impact code"></text>
        </field>
		<field name="ma_qh" width="120">
         	<text v="Quan hệ gia đình" e="Family relationship"></text>
        </field>
		<field name="is_close" width="120">
         	<text v="Is close" e="Is close"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

