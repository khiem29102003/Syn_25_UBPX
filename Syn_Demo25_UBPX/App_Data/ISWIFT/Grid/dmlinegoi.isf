<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmlinegoi" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục line gọi" e="Call Line Directory"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmlinegoi" fieldKey="ma_line" order="ma_line" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_line" fieldType="PK" width="120">
          <text v="Mã line" e="Line Code"></text>
        </field>
        <field name="ten_line" width="250">
          <text v="Tên line" e="Line Name"></text>
        </field>
        <field name="ten_line2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>

      &DefaultButton;
