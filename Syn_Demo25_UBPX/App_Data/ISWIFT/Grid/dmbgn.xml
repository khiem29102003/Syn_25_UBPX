<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmbgn" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục điều kiện" e="List Of Shipping Lines"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbgn" fieldKey="ma_bgn" order="ma_bgn" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_bgn" fieldType="PK" width="120">
          <text v="Mã điều kiện" e="Brand Code"></text>
        </field>
        <field name="ten_bgn" width="250">
          <text v="Tên điều kiện" e="Brand Name"></text>
        </field>
        <field name="ten_bgn2" width="250">
          <text v="Tên khác" e="Another Name"></text>
        </field>
		<field name="ma_ct" width="120">
          <text v="Mã chứng từ" e="vouchert code"></text>
        </field>
		
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$dmbgn(f){
  this.constructor(f);
}
grid$dmbgn.prototype = new DirEvent();
grid$dmbgn.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
</dir>