<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="ss_cnptkhth" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Công nợ phải thu khách hàng" e="Receivables from Customers"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
	<fields>
		<field name="id" width="100" hidden = "true" >
          <text v="Id hệ thống" e="ID"></text>
        </field>
		<field name="ma_ct" width="0" >
          <text v="Mã c/từ" e="Voucher Code"></text>
        </field>
		<field name="so_ct" width="0" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
		<field name="ma_job" width="60" align="center" >
          <text v="Mã" e="Code"></text>
        </field>
		<field name="so_job" width="80" align="center" link="V" >
          <text v="Số" e="Job Number"></text>
        </field>
		<field name="ngay_ct_job" width="100" dataType="D" align="center" >
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>	
		<field name="ma_kh" width="120" hidden="false">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
		<field name="ten_kh" width="250">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
		<field name="ma_xe" width="120" hidden="true">
          <text v="Mã xe" e="Vehicle ID"></text>
        </field>
		<field name="ten_xe" width="120">
          <text v="Biển xe" e="Vehicle Plate"></text>
        </field>
		<field name="hbl_no" width="150">
          <text v="Số HBL" e="HBL No"></text>
        </field>
		<field name="mbl_no" width="150">
          <text v="Số MBL" e="MBL No"></text>
        </field>
		<field name="so_tk" width="150">
          <text v="Số tờ khai" e="Declaration Number"></text>
        </field>
		<field name="dien_giai_job" width="250">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		<field name="tien_ban" width="120" dataType="N">
          <text v="Tiền dịch vụ" e="Service Fee"></text>
        </field>
		<field name="tien_th" width="120" dataType="N">
          <text v="Tiền thu hộ" e="Pay on Behalf"></text>
        </field>
		<field name="tien_tong" width="120" dataType="N">
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
		<field name="tt" width="120" dataType="N">
          <text v="KH thanh toán trước" e="Prepayment by Customer"></text>
        </field>
		<field name="tien_cl" width="120" dataType="N">
           <text v="Tiền còn lại" e="Remaining Amount"></text>
        </field>
		<field name="tat_toan" width="80" align="Center">
          <text v="Tất toán" e="Paid in Full"></text>
        </field>
		<field name="ten_noi_di" width="200">
           <text v="Nơi đi" e="Origin"></text>
        </field>
		<field name="ten_noi_den" width="200">
          <text v="Nơi đến" e="Destination"></text>
        </field>		
      </fields>
      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$ss_cnptkhth(f){
  this.constructor(f);
}
grid$ss_cnptkhth.prototype = new DirEvent();
grid$ss_cnptkhth.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$ss_cnptkhth.prototype.beforeInit = function(){
  var p = this._dir;
}
grid$ss_cnptkhth.prototype.afterInit = function(){
  var p = this._dir, g = p.grid(), dt = g.data;
}
]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
  <script>
    <processing>
      <text>
        <![CDATA[
exec ss_bccnkhpt @ngay_ct1, @ngay_ct2, @ma_job, @ma_kh, @ma_xe, @ps, @tt
		]]>
      </text>
	
    </processing>
  </script>
</dir>