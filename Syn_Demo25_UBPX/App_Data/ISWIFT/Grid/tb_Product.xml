<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="tb_Product" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Sản phẩm" e="Product"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="tb_Product" fieldKey="Id" order="Id" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="Id" fieldType="PK" width="120">
          <text v="Mã sản phẩm" e="Product code"></text>
        </field>
		 <field name="Title"   width="120">
          <text v="Tên sản phẩm" e="Product name"></text>
        </field>
		<field name="Alias"  width="120">
          <text v="Alias" e="Alias"></text>
        </field>
		<field name="ProductCode"  width="120">
          <text v="Code sản phẩm" e="Product code"></text>
        </field>
		<field name="ProductCategoryId"  width="120">
          <text v="Mã loại sản phẩm" e="Product type code"></text>
        </field>
		<field name="PromotionId"  width="120">
          <text v="Mã khuyến mãi" e="Promotion code"></text>
        </field>
		<field name="BrandId"  width="120">
          <text v="Mã thương hiệu" e="Brand code"></text>
        </field>
		<field name="Description" width="120">
          <text v="Mô tả" e="Description"></text>
        </field>
		 <field name="Detail"  width="120">
          <text v="Chi tiết" e="Detail"></text>
        </field>
		<field name="Information"  width="120">
          <text v="Thông tin sản phẩm" e="Information"></text>
        </field>
		<field name="Image"  width="120">
          <text v="Hình ảnh" e="Image"></text>
        </field>
		<field name="Price"  width="120" dataType="N">
          <text v="Giá gốc" e="Price"></text>
        </field>
		
		<field name="PriceSale"  width="120" dataType="N">
          <text v="Giá khuyến mãi" e="Price sale"></text>
        </field>
		<field name="Quantity" width="120">
          <text v="Số lượng" e="Quantity"></text>
        </field>
		<field name="Guarantee" width="120">
          <text v="Bảo hành" e="Guarantee"></text>
        </field>
		<field name="ViewCount" width="120">
          <text v="Số lượt xem" e="View count"></text>
        </field>
		<field name="Position"  width="120">
          <text v="Thứ tự" e="Position"></text>
        </field>
		<field name="SeoTitle"  width="120">
          <text v="Seo Title" e="Seo Title"></text>
        </field>
        <field name="SeoDescription" width="250">
          <text v="Seo Description" e="Seo Description"></text>
        </field>
		<field name="SeoKeywords" width="250">
          <text v="Seo Keywords" e="Seo Keywords"></text>
        </field>
		<field name="IsActive" width="120">
          <text v="Kích hoạt" e="Is active"></text>
        </field>
		<!-- <field name="IsHome" width="120"> -->
          <!-- <text v="Hiện trang chính" e="Is home"></text> -->
        <!-- </field> -->
		<!-- <field name="IsFeature" width="120"> -->
          <!-- <text v="Hiện tính năng" e="Is feature"></text> -->
        <!-- </field> -->
		<!-- <field name="IsSale" width="120"> -->
          <!-- <text v="Hiện khuyễn mãi" e="Is sale"></text> -->
        <!-- </field> -->
		<!-- <field name="IsHot" width="120"> -->
          <!-- <text v="Hiện nổi bật" e="Is hot"></text> -->
        <!-- </field> -->
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$tb_Product(f){
  this.constructor(f);
}
grid$tb_Product.prototype = new DirEvent();
grid$tb_Product.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[
		.toolbar-close > div {
			background-position: -336px -400px !important;
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
</dir>