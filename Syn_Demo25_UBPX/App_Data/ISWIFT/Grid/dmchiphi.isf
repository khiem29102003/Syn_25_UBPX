<dir id="dmchiphi" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phí" e="List of fee"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmchiphi" fieldKey="ma_phi" order="ma_phi" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_phi" fieldType="PK" width="120">
          <text v="Mã phí" e="Fee code"></text>
        </field>
        <field name="ten_phi" width="250">
          <text v="Tên phí" e="Fee name"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

