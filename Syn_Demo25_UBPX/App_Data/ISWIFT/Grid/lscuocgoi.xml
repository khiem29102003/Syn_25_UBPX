<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="lscuocgoi" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Lịch sử cuộc gọi" e="Call History"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="lscuocgoi" fieldKey="uniqueid" order="datetime0 desc" allowFilter="true" allowOrder="true">
      <fields>
		<field name="uniqueid" width="150" fieldType="PK">
          <text v="Uniqueid" e="Uniqueid"></text>
        </field>
		<field name="accountcode" width="120">
          <text v="Client" e="Client"></text>
        </field>
		<field name="src" width="120" align="right"  hidden="false">
          <text v="Source" e="Source"></text>
        </field>
		<field name="dst" width="120" align="right" hidden="false">
          <text v="Destination" e="Destination"></text>
        </field>
		<field name="ma_donvi" width="120" hidden="false">
		  <text v="Unit" e="Unit"></text>
		</field>
		<field name="ma_bp" width="120" hidden="false">
		  <text v="Group" e="Group"></text>
		</field>
		<field name="duration"  align="right" width="120">
          <text v="Duration" e="Duration"></text>
        </field>
		<field name="billsec" align="right" width="120">
          <text v="Billsec" e="Billsec"></text>
        </field>
		<field name="disposition" width="120">
          <text v="Call Status" e="Context"></text>
        </field>
		<field name="ma_so_thue" width="200" hidden="false">
          <text v="Mã số thuế" e="App ID"></text>
        </field>
		<field name="hangup" width="150" hidden="false">
          <text v="Hangup Person" e="Hangup Person"></text>
        </field>
 		<field name="datetime0" width="120" align="center" dataType="D">
          <text v="Time Start" e="Agent Number"></text>
        </field>
		<field name="datetime2" width="120" align="center" dataType="D">
          <text v="Maker Date" e="Agent Number"></text>
        </field>	
		
		<field name="referenceId" width="200">
          <text v="referenceId" e="Status"></text>
        </field>
      </fields>

        <buttons>
        <button id="view">
          <text v="$ViewToolbar" e="$ViewToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="find">
          <text v="$FindToolbar" e="$FindToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="export">
          <text v="$ExportToolbar" e="$ExportToolbar"></text>
        </button>
      </buttons>
      <script>
        <query>
          <text>
            <![CDATA[
declare @strKey nvarchar(3000)
exec ISWIFTStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', '', '', '@@key', '', @@filterKey, '', @pageIndex, 50, @@admin, @@userId
         ]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[
declare @strKey nvarchar(3000), @strDetailKey nvarchar(3000); set @strDetailKey = ''

set @strKey = @strFinding
exec ISWIFTStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', '', '', '@@key', @strKey, @@filterKey, '', @pageIndex, 50, @@admin, @@userId
         ]]>
          </text>
        </finding>
      </script>
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$lscuocgoi(f){
  this.constructor(f);
}
grid$lscuocgoi.prototype = new DirEvent();
grid$lscuocgoi.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
