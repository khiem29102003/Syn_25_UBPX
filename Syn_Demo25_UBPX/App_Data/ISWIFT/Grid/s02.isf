<dir id="s02" dirViewType="Grid" dirObjectType="Voucher" voucherCode="BL2" xmlns="urn:schemas-iswift:struct-dir">
  <title v="GIá cước dịch vụ ( hàng lẻ) dịch vụ" e="Service charge (retail)"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="s02" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
        <field name="so_ct" width="120" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="ma_kh" width="120" hidden = "true">
          <text v="Mã đại lý" e="Agent Code"></text>
        </field>
        <field name="ten_kh" width="0" fieldType="EX" >
          <text v="Tên đại lý" e="Agent Name"></text>
        </field>     
		<field name="ma_noi_di" width="120" hidden="true">
          <text v="Nơi đi" e="Origin"></text>
        </field>
		<field name="ten_noi_di" width="250" fieldType="EX">
		  <text v="Nơi đi " e="Origin Name"></text>
		</field>
		<field name="ma_dk_gh" width="0" hidden="true">
          <text v="ĐK giao hàng" e="Traffic term"></text>
        </field>
		<field name="ten_dk_gh" width="120" fieldType="EX" >
          <text v="ĐK giao hàng" e="Traffic term"></text>
        </field>
		
		<field name="ma_noi_den" width="120" hidden="true" >
          <text v="Nơi đến" e="Destination"></text>
        </field>	
		<field name="ten_noi_den" width="250" fieldType="EX" >
		  <text v="Nơi đến " e="Destination Name"></text>
		</field>		
			
		<field name="ma_dk_nh" width="0" hidden="true">
          <text v="ĐK nhận hàng" e="Traffic term"></text>
        </field>	
		<field name="ten_dk_nh" width="120" fieldType="EX" >
          <text v="ĐK nhận hàng" e="Traffic term"></text>
        </field>	
		
		<field name="ma_hang" width="0" >
          <text v="Hãng tàu" e="Carrier"></text>
        </field>
		<field name="ten_hang" width="120" fieldType="EX" >
          <text v="Hãng tàu" e="Carrier"></text>
        </field>
		
		<field name="ma_kh" width="0" >
          <text v="Đại lý" e="Agent"></text>
        </field>
		<field name="ngay_hl" width="120" dataType="D">
          <text v="Ngày hiệu lực" e="Effective  date"></text>
        </field>
		<field name="ngay_hld" width="120" dataType="D">
          <text v="Ngày hiệu lực đến" e="Expiry  date"></text>
        </field>
		<field name="ma_nt" width="0" >
          <text v="Ngoại tệ" e="Currency"></text>
        </field>
		<field name="dien_giai" width="250">
          <text v="Ghi chú" e="Note"></text>
        </field>
        <field name="t_tt_nt" dataType="N" format="FCAmount" width="120">
          <text v="Tổng tiền" e="Total amount"></text>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="120" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

