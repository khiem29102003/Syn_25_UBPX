<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmbanner" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục banner" e="Banner List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbanner" fieldKey="ma_banner" order="ma_banner" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_banner" fieldType="PK" width="120">
          <text v="Mã banner" e="Banner code"></text>
        </field>
		<field name="ten_banner" width="120">
          <text v="Tên banner" e="Banner name"></text>
        </field>
		<field name="ten_banner2"  width="120">
          <text v="Tên khác" e="Other"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
		<field name="thu_tu" width="250">
          <text v="Thứ tự" e="Position"></text>
        </field>
		<field name="phan_loai" width="250">
          <text v="Phân loại" e="Type"></text>
        </field>
		 
      </fields>

      &DefaultButton;

    </grid>
  </grids>

