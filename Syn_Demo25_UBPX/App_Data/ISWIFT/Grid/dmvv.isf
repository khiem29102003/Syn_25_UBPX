<dir id="dmvv" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục vụ việc" e="Job List"></title>
  <subtitle v="Cập nhật vụ việc: thêm, sửa, xóa..." e="Add, Edit, Delete Job..."></subtitle>
  <grids>
    <grid table="dmvv" fieldKey="ma_vv" order="ma_vv" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_vv" fieldType="PK" width="120">
          <text v="Mã vụ việc" e="Job"></text>
        </field>
        <field name="ten_vv" width="250">
          <text v="Tên vụ việc" e="Description"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

