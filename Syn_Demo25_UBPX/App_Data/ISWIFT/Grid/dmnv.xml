<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmnv" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách nhân sự" e="Staff List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmnv" fieldKey="ma_nv" order="xstatus" allowFilter="true" allowOrder="true" key="xstatus = 5">
      <fields >
		<field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
		<field name="ma_unit" width="120" fieldType="EX" align="center" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="ma_pb" width="80" hidden="true">
          <text v="Phòng ban" e="Department"></text>
        </field>
		<field name="ten_pb" width="200" fieldType="EX" >
          <text v="Phòng ban" e="Department"></text>
        </field>  
		<field name="ma_bp" width="80" hidden="true" align="Center">
          <text v="Tổ/Nhóm" e="Section"></text>
        </field>
		<field name="ten_bp" width="200" fieldType="EX" >
          <text v="Tổ/Nhóm" e="Section"></text>
        </field>  
        <field name="ma_nv" fieldType="PK" width="100" hidden="false">
          <text v="Mã nhân sự" e="Staff Code"></text>
        </field>
		<field name="ten_nv" width="200">
          <text v="Tên nhân sự" e="Staff Name"></text>
        </field>

		<field name="ma_gt" viewType="Combobox" inactivate="true" width="100" >
		  <text v="Giới tính" e="Gender"></text>
		  <viewInfo>
			<options query="select ma_gt, ten_gt%l from dmgioitinh where status = 1">
			</options>
		  </viewInfo>
		</field>
		<field name="ngay_sinh" width="120" dataType="D" align="Center">
          <text v="Ngày sinh" e="Brithday"></text>
        </field>
        <field name="ten_gt" width="120" fieldType="EX" align="center" hidden="true" >
          <text v="Giới tính" e="Gender"></text>
        </field>
		<field name="ngay_bd_lv" width="0" dataType="D" align="Center">
          <text v="Ngày bắt đầu làm việc" e="Joining Date"></text>
        </field>
		<field name="cmnd_so" width="0" align="right">
          <text v="Số CCCD" e="Citizen Identification Card"></text>
        </field>
		<field name="ma_cv" width="120" hidden="true">
          <text v="Chức vụ" e="Duty Code"></text>
        </field>
		<field name="ten_cv" width="200" fieldType="EX" >
          <text v="Chức vụ" e="Position"></text>
        </field>  
		<field name="ma_vtcv" width="120" hidden="true">
          <text v="Vị trí công việc" e="Job Position Code"></text>
        </field>
		<field name="ten_vtcv" width="200" fieldType="EX" >
          <text v="Vị trí công việc" e="Job Position Name"></text>
        </field> 
		<field name="parent_nv" width="120">
          <text v="Mã cấp trên" e="Manager Code"></text>
        </field>
		<field name="parent_ten_nv" fieldType="EX" width="200">
          <text v="Cấp trên" e="Manager"></text>
        </field>
		<field name="dien_thoai" width="120">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="email" width="120">
          <text v="Email" e="Email"></text>
        </field>
		<field name="dia_chi" width="250">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="xstatus" viewType="Combobox" inactivate="true" width="100">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="5">
                <text v="Đang làm việc" e="Working"></text>
              </option>
              <option val="9">
                <text v="Nghỉ việc" e="Quitting your job"></text>
              </option>
			  <option val="7">
                <text v="Nghỉ chế độ" e="Vacation mode"></text>
              </option>
            </options>
          </viewInfo>
        </field>		
	  </fields>
&DefaultButton;
    <script>
        <query>
          <text>
            <![CDATA[
exec ISWIFTStoreVoucherTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', 'left join sysunit b on a.unit_id = b.unit_id left join dmgioitinh c on a.ma_gt = c.ma_gt left join dmpb g on a.ma_pb = g.ma_pb left join dmbp r on a.ma_bp = r.ma_bp and a.ma_pb = r.ma_pb left join dmchucvu d on a.ma_cv = d.ma_cv left join dmvtcv e on a.ma_vtcv = e.ma_vtcv left join dmnv f on a.parent_nv = f.ma_nv', 'b.ma_unit, c.ten_gt, g.ten_pb, r.ten_bp, d.ten_cv, e.ten_vtcv, f.ten_nv parent_ten_nv', '@@key', '', @@filterKey, '', @pageIndex, 0, @@admin, @@userId
         ]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[
declare @strKey nvarchar(3000)
set @strKey  = @strFinding
exec ISWIFTStoreVoucherTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', 'left join sysunit b on a.unit_id = b.unit_id left join dmgioitinh c on a.ma_gt = c.ma_gt left join dmpb g on a.ma_pb = g.ma_pb left join dmbp r on a.ma_bp = r.ma_bp and a.ma_pb = r.ma_pb left join dmchucvu d on a.ma_cv = d.ma_cv left join dmvtcv e on a.ma_vtcv = e.ma_vtcv left join dmnv f on a.parent_nv = f.ma_nv', 'b.ma_unit, c.ten_gt, g.ten_pb, r.ten_bp, d.ten_cv, e.ten_vtcv, f.ten_nv parent_ten_nv', '@@key', @strKey, @@filterKey, '', @pageIndex, 0, @@admin, @@userId
 
         ]]>
          </text>
        </finding>
      </script>
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$dmnv(f){
  this.constructor(f);
}
grid$dmnv.prototype = new DirEvent();
grid$dmnv.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[
.table-bottom{
	left: 0px!important;
	height: calc(100% - 77px);
	top: 0px;
	position: relative;
	margin-top: 27px;
	clear: both;
	border-bottom: 1px solid #ddd;
}
#content .dir{
	position: relative !important;
	height: 100%;
}

@media only screen and (max-width: 767px) {
  .table-bottom{
	margin-top: 42px;
	height: calc(100% - 92px);
  }
}
		]]>
    </text>
  </css>
</dir>