<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="bclntkv" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo cáo lợi nhuận theo khu vực" e="Profitability by Region"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="rg_code" width="100" aliasName="b" join="left join dmkh b on a.ma_kh = b.ma_kh" link="~bclntkh" operation="=">
          <text v="Khu vực" e="Region Code"></text>
        </field>
        <field name="rgname" width="250" aliasName="c" join="left join sysregioninfo c on b.rg_code = c.rg_code">
          <text v="Tên khu vực" e="Region Name"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="FCAmount" width="100">
          <text v="Doanh thu nt" e="FC Turnover"></text>
        </field>
        <field name="tien_nt_xuat" dataType="N" format="FCAmount" width="100">
          <text v="Tiền vốn nt" e="FC Cogs Amt."></text>
        </field>
        <field name="tien_lai_nt" dataType="N" format="FCAmount" width="100">
          <text v="Lãi nt" e="FC Profit."></text>
        </field>
        <field name="ty_le_nt" dataType="N" format="2" width="100">
          <text v="Tỷ trọng lãi (%)" e="Interest (%)"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100">
          <text v="Doanh thu" e="Turnover"></text>
        </field>
        <field name="tien_xuat" dataType="N" format="Amount" width="100">
          <text v="Tiền vốn" e="Cogs Amt."></text>
        </field>
        <field name="tien_lai" dataType="N" format="Amount" width="100">
          <text v="Lãi" e="Profit."></text>
        </field>
        <field name="ty_le" dataType="N" format="2" width="100">
          <text v="Tỷ trọng lãi (%)" e="Interest (%)"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
  <script>
    <processing>
      <text>
        <![CDATA[<enc>xuxk/nHXG8yDaJqM5HeI7THqAkiuEH1nXh+L10IFQhwszJHZefkm12Cya9/50eZfsMUCK82egZxb6LsxHXjHGFULIE78rWUJ603tdRhx4+wJnoyaxdQY8GreOpq6T7ZrV0H16uVH9H8QLym+AWfMdToeIRSMcOKBdApjLXODWvWrAmvP01bXR90M3v9xMEXr</enc>]]>
      </text>
    </processing>
  </script>
</dir>