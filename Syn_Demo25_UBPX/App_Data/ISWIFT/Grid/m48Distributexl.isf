<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="m48Distribute" dirViewType="Grid" voucherCode="CT0" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách các phiếu chi" e="Allocation to Invoices"></title>
  <subtitle v="Phân bổ thu tiền cho các hóa đơn..." e=""></subtitle>

  <grids>
    <grid table="ctchi20" fieldKey="id" order="ngay_ct, so_ct, id" allowFilter="true" allowOrder="true">
      <fields>
        <field name="so_ct" width="100" link="V" >
          <text v="Số phiếu chi" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày phiếu chi" e="Voucher Date"></text>
        </field>
        <field name="ma_kh" width="120" >
          <text v="Mã người hoàn ứng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250" fieldType="EX" >
          <text v="Tên người hoàn ứng" e="Customer Name"></text>
        </field>
        <field name="ma_nt" width="80" >
          <text v="Ngoại tệ" e="FC"></text>
        </field>
        <field name="tien_nt" dataType="N" format="FCAmount" width="100">
          <text v="Tiền ứng" e="Pcs UOM"></text>
        </field>
        <field name="da_pb_nt" dataType="N" format="FCAmount" width="100" aliasName="0*tien_nt as ">
          <text v="Đã phân bổ" e="Pcs UOM"></text>
        </field>
		 <field name="cl_nt" dataType="N" format="FCAmount" width="100" aliasName="0*tien_nt as ">
          <text v="Chưa phân bổ" e="Cash In Return"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="80" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="80" fieldType="EX" >
          <text v="Đơn vị" e="Customer Name"></text>
        </field>
        <field name="ma_ct" width="80" >
          <text v="Chứng từ" e="Voucher"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      <buttons>
        <button id="find">
          <text v="$FindToolbar" e="$FindToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="export">
          <text v="$ExportToolbar" e="$ExportToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>

  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>


  <script>
    &VoucherJSLoading;
  </script>
  
</dir>