<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="hrdsnvnv" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách nhân viên nghỉ việc" e="Employee List"></title>
  <subtitle v="Nghỉ từ ngày {ngay_nghi_tu} đến ngày {ngay_nghi_den}..." e="From {ngay_nghi_tu} To {ngay_nghi_den}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_nv" operation="=" width="100">
          <text v="Mã nhân viên" e="Employee ID"></text>
        </field>
        <field name="ten_nv" width="250" aliasName="b">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
        <field name="ten_bp" width="120">
          <text v="Bộ phận" e="Department"></text>
        </field>
        <field name="ten_vtr" width="120">
          <text v="Vị trí" e="Position"></text>
        </field>
        <field name="ngay_vao" width="120" dataType="D">
          <text v="Ngày nhận việc" e="Join date"></text>
        </field>
        <field name="ngay_nghi" width="120" dataType="D">
          <text v="Ngày nghỉ việc" e=""></text>
        </field>
        <field name="ly_do_nghi" width="120">
          <text v="Lý do nghỉ" e="Region"></text>
        </field>
        <field name="so_tro_cap" format="Amount" dataType="N" width="150">
          <text v="Trợ cấp thất nghiệp" e=""></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
