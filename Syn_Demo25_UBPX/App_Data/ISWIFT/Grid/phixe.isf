<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="phixe" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Định mức phí vận chuyển" e="Shipping cost"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="phixe" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true" >
      <fields>

		<field name="so_ct" width="120" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày áp dụng" e="Voucher Date"></text>
        </field>
		<field name="ma_xe" width="120" >
          <text v="Xe" e="Vehicle"></text>
        </field>
		<field name="t_so_luong" width="120" >
          <text v="Tổng số lượng" e="Total"></text>
        </field>
		<field name="t_tien" width="120" >
          <text v="Tổng tiền" e="Total money"></text>
        </field>
		<field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>

		
     
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
