<dir id="dmdkxe" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo đăng kiểm" e="Registration declaration"></title>
  <subtitle v="Cập nhật tỷ giá..." e="Add, Edit, Delete Exchange Rate..."></subtitle>
  <grids>
    <grid table="dmdkxe" fieldKey="ma_xe,ngay_dk" order="ma_xe" allowFilter="true" allowOrder="true" >
      <fields >
        <field name="ma_xe" fieldType="PK" width="120" >
          <text v="Xe đăng kiểm" e="Currency Code"></text>
        </field>
        <field name="ten_xe" width="250" fieldType="EX"  aliasName="b">
          <text v="Tên xe" e="Currency Name"></text>
        </field>
        <field name="ngay_dk" fieldType="PK" width="120" dataType="D">
          <text v="Ngày đăng kiểm" e="Date"></text>
        </field>
		 <field name="ngay_hh" fieldType="PK" width="120" dataType="D">
          <text v="Ngày hết hạn" e="Date"></text>
        </field>
        
      </fields>

      &DefaultButton;

