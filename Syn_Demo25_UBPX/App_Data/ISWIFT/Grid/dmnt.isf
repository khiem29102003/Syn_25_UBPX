<dir id="dmnt" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục ngoại tệ" e="Currency List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmnt" fieldKey="ma_nt" order="ma_nt" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_nt" fieldType="PK" width="120">
          <text v="Mã ngoại tệ" e="Currency Code"></text>
        </field>
        <field name="ten_nt" width="300">
          <text v="Tên ngoại tệ" e="Currency Name"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

