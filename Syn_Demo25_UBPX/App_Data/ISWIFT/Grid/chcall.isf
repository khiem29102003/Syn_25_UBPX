<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="chcall" dirViewType="Grid" dirObjectType="Voucher" voucherCode="CH1" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Cấu hình cuôc gọi" e="Call configuration"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="chcall" fieldKey="id, ma_dv" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
	    <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="120" fieldType="EX" hidden="true" >
          <text v="Đơn vị" e="Unit"></text>
        </field>

        <field name="so_ct" width="100" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
		<field name="ma_dv" width="150" fieldType="PK" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="t_so_luong" width="100" >
          <text v="Tổng số lượng" e="Total quantity"></text>
        </field>

        <field name="dien_giai" width="200" >
          <text v="Diễn giải" e="Explain"></text>
        </field>
		
        <field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
		
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;
      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  <css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    &VoucherJSLoading;
  </script>
</dir>