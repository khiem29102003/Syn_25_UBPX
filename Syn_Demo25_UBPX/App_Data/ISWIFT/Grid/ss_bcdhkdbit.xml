<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="ss_bcdhkdbit" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Đơn hàng chưa làm Debit" e="Unbilled orders"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
	<fields>
		<field name="id" width="100" hidden = "true" >
          <text v="Id hệ thống" e="Customer Code"></text>
        </field>
		<field name="ma_ct" width="80">
          <text v="Mã c/từ" e="Voucher Code"></text>
        </field>
		<field name="so_ct" width="0" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
		<field name="ma_job" width="100" hidden = "false">
          <text v="Mã" e="Job Code"></text>
        </field>
		<field name="so_job" width="100" link="V" >
          <text v="Số" e="Job Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
		<field name="ma_log" width="100">
          <text v="Mã log" e="Log Code"></text>
        </field>
        <field name="ma_kh" width="0" hidden = "false">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250" fieldType="EX" >
          <text v="Khách hàng" e="Customer"></text>
        </field>		
		<field name="ma_noi_di" width="0" hidden="false">
          <text v="Nơi đi" e="Origin"></text>
        </field>
		<field name="ten_noi_di" width="250" fieldType="EX">
		  <text v="Nơi đi " e="Origin"></text>
		</field>
		<field name="ma_noi_den" width="0" hidden="false" >
          <text v="Nơi đến" e="Destination"></text>
        </field>	
		<field name="ten_noi_den" width="250" fieldType="EX" >
		  <text v="Nơi đến " e="Destination"></text>
		</field>
		<field name="hbl_no" width="120">
          <text v="Số HBL" e="HBL No"></text>
        </field>
		<field name="mbl_no" width="120">
          <text v="Số MBL" e="MBL No"></text>
        </field>
		<field name="so_tk" width="120">
          <text v="Số tờ khai" e="Declaration No"></text>
        </field>
		<field name="book_no" width="120">
          <text v="Book No" e="Book No"></text>
        </field>
		<field name="dien_giai" width="200">
          <text v="Diễn giải" e="Explain"></text>
        </field>
      </fields>
      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$ss_bcdhkdbit(f){
  this.constructor(f);
}
grid$ss_bcdhkdbit.prototype = new DirEvent();
grid$ss_bcdhkdbit.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$ss_bcdhkdbit.prototype.beforeInit = function(){
  var p = this._dir;
}
grid$ss_bcdhkdbit.prototype.afterInit = function(){
  var p = this._dir, g = p.grid(), dt = g.data;
}
]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
  <script>
    <processing>
      <text>
        <![CDATA[
exec ss_bcdhkdbit @ngay_ct1, @ngay_ct2, @ma_ct, @so_job
		]]>
      </text>	
    </processing>
  </script>
</dir>