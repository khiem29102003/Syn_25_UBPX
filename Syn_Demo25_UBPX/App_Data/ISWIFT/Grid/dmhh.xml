<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmhh" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hàng hóa" e="Commodity Menu"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmhh" fieldKey="ma_vt" order="ma_vt" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_vt" fieldType="PK" width="120">
          <text v="Mã hàng hóa" e="Agent Code"></text>
        </field>
        <field name="ten_vt" width="200">
          <text v="Tên hàng hóa" e="Agent Name"></text>
        </field>
		<field name="ten_vt2" width="200">
          <text v="Tên khác" e="Another Name"></text>
        </field>
		<field name="ma_dvt" fieldType="PK" width="120">
          <text v="Mã đơn vị tính" e="Unit Code"></text>
        </field>
		<field name="dg_ban" width="120">
          <text v="Đang bán" e="On Sale"></text>
        </field>
		<field name="ma_nhom" width="120">
          <text v="Mã Nhóm" e="Group Code"></text>
        </field>
		<field name="status" width="250">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$dmhh(f){
  this.constructor(f);
}
grid$dmhh.prototype = new DirEvent();
grid$dmhh.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[
		.toolbar-close > div {
			background-position: -336px -400px !important;
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
</dir>