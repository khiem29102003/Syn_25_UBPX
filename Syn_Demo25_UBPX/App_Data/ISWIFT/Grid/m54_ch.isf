<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="m54" dirViewType="Grid" dirObjectType="Voucher" voucherCode="PX3" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách phiếu bán chưa xử lý chi hộ" e="List of Sales Orders Pending Third-Party Handling"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="m54" fieldKey="id" order="ngay_ct desc" allowFilter="true" allowOrder="true">
      <fields>
		<field name="ma_ct" width="80">
          <text v="Mã c/từ" e="Voucher Code"></text>
        </field>
		<field name="so_ct" width="0" link="V" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
		<!-- <field name="ma_job" width="100" hidden = "false"> -->
          <!-- <text v="Mã" e="Job Code"></text> -->
        <!-- </field> -->
		<!-- <field name="so_job" width="100" link="V" > -->
          <!-- <text v="Số" e="Job Number"></text> -->
        <!-- </field> -->
		<field name="ma_dh" width="120" hidden = "false" fieldType="EX">
          <text v="Mã đơn hàng" e="Order Code"></text>
        </field>
		<field name="so_dh" width="120" link="V" fieldType="EX">
          <text v="Số đơn hàng" e="Order Number"></text>
        </field>
		<field name="so_ct_p" width="120" link="V" >
          <text v="Số file" e="File Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="ma_kh" width="120" >
          <text v="Mã đối tượng TT" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250" fieldType="EX" >
          <text v="Tên đối tượng TT" e="Customer Name"></text>
        </field>
		<field name="dien_thoai" width="120" fieldType="EX" >
          <text v="Điện thoại" e="Tel"></text>
        </field>
        <field name="ma_nt" width="80" >
          <text v="Ngoại tệ" e="FC"></text>
        </field>
		 <field name="t_tty" dataType="N" format="FCAmount" width="120">
          <text v="Tổng tiền bán" e="Total Invoice Amount"></text>
        </field>
		 <field name="t_ttx" dataType="N" format="FCAmount" width="120">
          <text v="Tổng thu hộ" e="Total Amount Collected on Behalf"></text>
        </field>
		<field name="t_tt" dataType="N" format="FCAmount" width="120">
          <text v="Tổng cộng" e="Total"></text>
        </field>
		<field name="dien_giai" width="250">
          <text v="Diễn giải" e="Explain"></text>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="80" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="80" fieldType="EX" >
          <text v="Đơn vị" e="Customer Name"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" >
          <text v="ID" e="ID"></text>
        </field>
		<field name="id_dh" dataType="N" fieldType="PK" format="0" >
          <text v="ID" e="ID"></text>
        </field>
      </fields>

		<buttons>
		  <button id="edit">
			<text v="$EditToolbar" e="$EditToolbar"></text>
		  </button>
		  <button id="view">
			<text v="$ViewToolbar" e="$ViewToolbar"></text>
		  </button>
		  <button id="split">
			<text v="-" e="-"></text>
		  </button>
		  <button id="find">
			<text v="$FindToolbar" e="$FindToolbar"></text>
		  </button>
		  <button id="split">
			<text v="-" e="-"></text>
		  </button>
		  <button id="refresh">
			<text v="$RefreshToolbar" e="$RefreshToolbar"></text>
		  </button>
		  <button id="freeze">
			<text v="$FreezeToolbar" e="$FreezeToolbar"></text>
		  </button>
		  <button id="split">
			<text v="-" e="-"></text>
		  </button>
		  <button id="print">
			<text v="$PrintToolbar" e="$PrintToolbar"></text>
		  </button>
		  <button id="export">
			<text v="$ExportToolbar" e="$ExportToolbar"></text>
		  </button>

		</buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>hLiBLm3iF/aJj7eF2MoRKkVrUDZares+TCtMAvrDcy+DR6gzQww2/A93NXL1SDstz8B956IkQjCFpww+gt+mquRiZflgRnpYt+pKTQJv+3BTOnRC7vZn53yAMkUIDVFZus75Q11IqLMSyrl8vr/bSqcFAzoOf5ui/U+R17zDXv1wlnrf0/LnLhxWzDerKIIX</enc>]]>
    </text>
  </js>


  <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
  <script>
    &VoucherJSLoading;
  </script>
  <messages>
    <message val="DaThanhToan">
      <text v="Đã có chứng từ thanh toán cho hóa đơn này, không được sửa/xóa." e=""/>
    </message>
    <message val="DaTraLai">
      <text v="Đã có chứng từ trả lại cho hóa đơn này, không được sửa/xóa." e=""/>
    </message>
  </messages>
</dir>