<dir id="dmttbm" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục trạng thái nhấc máy" e="Pick-up state List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmttbm" fieldKey="ma_ttbm" order="ma_ttbm" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_ttbm" fieldType="PK" width="120">
          <text v="Mã trạng thái nhấc máy" e="Pick-up state code"></text>
        </field>
        <field name="ten_ttbm" width="250">
          <text v="Tên trạng thái nhấc máy" e="Pick-up state name"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

