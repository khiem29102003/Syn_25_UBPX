<dir id="dmcong" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục công/thùng hàng" e="List of Container/Cargo"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmcong" fieldKey="ma_cong" order="ma_cong" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_cong" fieldType="PK" width="120">
          <text v="Mã container" e="Container Code"></text>
        </field>
        <field name="ten_cong" width="250">
          <text v="Tên container" e="Container Name"></text>
        </field>
		<field name="ten_cong2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
        <field name="ma_loai" width="120">
          <text v="Mã loại" e="Type Code"></text>
        </field>
		 <field name="ten_loai" width="220" fieldType="EX">
          <text v="Tên loại" e="Type Name"></text>
        </field>
		<field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>
	  
	  &DefaultButton;
