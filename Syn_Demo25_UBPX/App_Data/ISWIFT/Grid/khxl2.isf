<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridFinding.xml">
]>

<dir id="khxl" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách chăm sóc khách hàng" e="Customer Care List"></title>
  <subtitle v="Xem, sửa dữ liệu..." e="View, update data..."></subtitle>
  <grids>
    <grid table="dmkh0" fieldKey="ma_so_thue" order="ma_so_thue desc" allowFilter="true" allowOrder="true" >
      <fields>
	  	<field name="ngay_td" width="100" dataType="D" align="center">
          <text v="Ngày tác động" e="Effective Date"></text>
        </field>
		<field name="ma_so_thue" width="120" fieldType="PK" link="1">
          <text v="Mã số thuế" e="Tax Code"></text>
        </field>
        <field name="ten_kh" width="250">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>      
		<field name="ten_kh2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="dia_chi" width="250">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="chuc_vu" width="250">
          <text v="Chức vụ" e="Position"></text>
        </field>
		<field name="muc_luong" width="120" dataType="N">
          <text v="Mức lương" e="Salary"></text>
        </field>
		<field name="hs_luong" width="100" dataType="N">
          <text v="Hệ số lương" e="Salary Coefficient"></text>
        </field>
		<field name="kh_yn" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Khách hàng" e="Customer"></text>
        </field>
		<field name="nh_kh1" width="200" hidden="true">
          <text v="Nhóm 1" e="Group 1"></text>
        </field>
		<field name="ten_nh_kh1" width="200" fieldType="EX">
          <text v="Tên nhóm 1" e="Group Name 1"></text>
        </field>
		<field name="nh_kh2" width="200" hidden="true">
          <text v="Nhóm 2" e="Group 2"></text>
        </field>
		<field name="ten_nh_kh2" width="200" fieldType="EX">
          <text v="Tên nhóm 2" e="Group Name 2"></text>
        </field>
		<field name="nh_kh3" width="200" hidden="true">
          <text v="Nhóm 3" e="Group 3"></text>
        </field>
		<field name="ten_nh_kh3" width="200" fieldType="EX">
          <text v="Tên nhóm 3" e="Group Name 3"></text>
        </field>
		<field name="ma_plkh" width="150" fieldType="EX" >
          <text v="Mã p/loại KH gần nhất" e="Last Customer Classification Code"></text>
        </field>
		<field name="ten_plkh" width="200" fieldType="EX" >
          <text v="Tên p/loại KH gần nhất" e="Last Customer Classification Name"></text>
        </field>
		<field name="ma_nvbh" width="200">
          <text v="Mã nhân viên" e="Note"></text>
        </field>
		<field name="ghi_chu" width="200">
          <text v="Ghi chú" e="Note"></text>
        </field>
		
		<field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>
      
      <buttons>
	    <button id="edit">
          <text v="$EditToolbar" e="$EditToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
		<!-- <button id="find"> -->
          <!-- <text v="$FindToolbar" e="$FindToolbar"></text> -->
        <!-- </button> -->
		<!-- <button id="split"> -->
          <!-- <text v="-" e="-"></text> -->
        <!-- </button> -->
	    <button id="export">
	    	<text v="$ExportToolbar" e="$ExportToolbar"></text>
	    </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>
      
	  <script>
		<query>
			<text>
			<![CDATA[<enc></enc>]]>
			</text>
		</query>

		<finding>
			<text>
			<![CDATA[<enc></enc>]]>
			</text>
		</finding>
	  </script>

    </grid>
  </grids>

  <js>
    <text>
	<![CDATA[<enc></enc>]]>
    </text>
  </js>
<css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>

</dir>