<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="s631" dirViewType="Grid" dirObjectType="Voucher" voucherCode="PB1" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phiếu bán hàng hàng biển FCL" e="FCL Marine Sales Slip"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>
  <grids>
    <grid table="s631" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
        <field name="so_ct" width="80" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
		<field name="ma_job" width="100" format="U" hidden = "false">
          <text v="Mã job" e="Job Code"></text>
        </field>
		<field name="so_job"  format="0" width="100" hidden="false">
          <text v="Số job" e="Order number"></text>
        </field>
        <field name="so_don" dataType="N" format="0" width="100" hidden="false">
          <text v="Số đơn" e="Order number"></text>
        </field>
		<field name="ma_nv" width="0" hidden = "false">
          <text v="Mã nhân viên" e="Employee Code"></text>
        </field>
        <field name="ten_nv" width="200" fieldType="EX" >
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field> 
        <field name="ma_kh" width="0" hidden = "false">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250" fieldType="EX" >
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field> 
		<field name="ma_noi_di" width="0" hidden="false">
          <text v="Nơi đi" e="Origin"></text>
        </field>
		<field name="ten_noi_di" width="250" fieldType="EX">
		  <text v="Nơi đi " e="Origin"></text>
		</field>
		<field name="ma_noi_den" width="0" hidden="false" >
          <text v="Nơi đến" e="Destination"></text>
        </field>	
		<field name="ten_noi_den" width="250" fieldType="EX" >
		  <text v="Nơi đến " e="Destination"></text>
		</field>		
		<field name="ma_hang" width="0" hidden="false" >
          <text v="Hãng tàu" e="Carrier"></text>
        </field>
		<field name="ten_hang" width="250" fieldType="EX" >
          <text v="Hãng tàu" e="Carrier"></text>
        </field>
		<field name="hbl_no" width="120" fieldType="EX" >
          <text v="Số HBL" e="HBL No"></text>
        </field>
		<field name="mbl_no" width="120" fieldType="EX" >
          <text v="Số MBL" e="MBL No"></text>
        </field>
		<field name="so_tk" width="120" fieldType="EX" >
          <text v="Số tờ khai" e="Declaration No"></text>
        </field>
		<field name="book_no" width="120" fieldType="EX" >
          <text v="Book No." e="Book_No"></text>
        </field>
		<field name="dien_giai" width="200">
          <text v="Diễn giải" e="Explain"></text>
        </field>
        <field name="t_tt" dataType="N" format="FCAmount" width="120">
          <text v="Tổng tiền" e="Total amount"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="120" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
		<field name="id_dh" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>B3vwoV4prYvzOacbKQoWCxVBhI3usbRijg3gX3poQZipTMNlwCJFe5BZYhAWSc5ZSFBIk99bB488n26r8M9nhPzBoJvXKYHRbfS+MfKhPil5EBA4zwFPwVqVECOU91u6a867SLAlFqYOWzMBJNAQ2i2231HpgOQrLpn73H6WokgWd/IQv6WSU9/TKFaevCHQK9nNe3FyMgCSk5eIncXGMg==</enc>]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    &VoucherJSLoading;
  </script>
</dir>