<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmbcc" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bảng chấm công" e="List of timesheets"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbcc" fieldKey="id" order="id" allowFilter="true" allowOrder="true">
      <fields >
        <field name="unit_id" hidden="true" dataType="I" width="80" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
		
        <field name="ma_nv" fieldType="PK" width="120">
          <text v="Mã nhân viên" e="Staff code"></text>
        </field>

      </fields>

      &DefaultButton;

    </grid>
  </grids>

