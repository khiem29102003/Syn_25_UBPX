        </field>
		<field name="noi_dung" width="250" >
          <text v="Nội dung" e="Content"></text>
        </field>
		<field name="tag" width="120" >
          <text v="Tag" e="Tag"></text>
        </field>
		<field name="tag_name" width="200" fieldType="EX">
          <text v="Tag Name" e="Tag Name"></text>
        </field>
      </fields>


