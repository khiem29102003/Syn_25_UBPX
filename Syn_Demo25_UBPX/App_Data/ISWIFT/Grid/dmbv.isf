<dir id="dmbv" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách bài viết" e="Posts List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbv" fieldKey="ma_bv" order="ma_bv" allowFilter="true" allowOrder="true" >
