        <field name="ma_bv" fieldType="PK" width="0">
          <text v="Mã bài viết" e="Post Code"></text>
        </field>
        <field name="ten_bv" width="300">
          <text v="Tiêu đề" e="Title"></text>
        </field>
		<field name="luot_xem" dataType="N" format="Amount" width="80">
