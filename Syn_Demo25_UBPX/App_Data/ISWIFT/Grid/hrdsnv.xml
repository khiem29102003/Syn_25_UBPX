<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="hrdsnv" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách nhân viên" e="Employee List"></title>
  <subtitle v="Từ ngày {ngay_ct_tu} đến ngày {ngay_ct_den}..." e="From {ngay_ct_tu} To {ngay_ct_den}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_nv" operation="=" width="100">
          <text v="Mã nhân viên" e="Employee ID"></text>
        </field>
        <field name="ten_nv" width="250" aliasName="b">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
        <field name="ngay_vao" width="100" dataType="D">
          <text v="Ngày nhận việc" e="Join date"></text>
        </field>
        <field name="ngay_thu_viec" width="100" dataType="D">
          <text v="Ngày ký hđ chính thức" e="Official date"></text>
        </field>
        <field name="ten_bp" width="150">
          <text v="Bộ phận" e="Department"></text>
        </field>
        <field name="ten_vtr" width="150">
          <text v="Vị trí" e="Position"></text>
        </field>
        <field name="ngay_sinh" width="100" dataType="D">
          <text v="Ngày sinh" e="Date of Birth"></text>
        </field>
        <field name="dien_thoai_dd" width="100">
          <text v="Điện thoại" e="Phone Number"></text>
        </field>
        <field name="email_cty" width="150">
          <text v="Email" e="Email"></text>
        </field>
        <field name="dia_chi" width="200">
          <text v="Địa chỉ" e="Address"></text>
        </field>
        <field name="dia_chi_th_tru" width="200">
          <text v="Địa chỉ thường trú" e="Permanent address"></text>
        </field>
        <field name="que_quan" width="200">
          <text v="Quê quán" e="Native country"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$hrdsnv(f){
  this.constructor(f);
}
grid$hrdsnv.prototype = new DirEvent();
grid$hrdsnv.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$hrdsnv.prototype.beforeInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
</dir>