<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="ss_bctkrp" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Agent Sumary" e="Agent Sumary"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>
	  	 <field name="o_number" width="80" hidden="false" align="right">
          <text v="STT" e="STT"></text>
        </field>
		<field name="ma_donvi" width="120" hidden="false">
		  <text v="Unit Name" e="Unit Name"></text>
		</field>
		<field name="team" width="120" hidden="false">
		  <text v="Part Name" e="Part Name"></text>
		</field>
	  	<field name="accountcode" width="150" hidden="false">
          <text v="AccountCode" e="AccountCode"></text>
        </field>
		<field name="ten_nv" width="150" hidden="false">
          <text v="Fullname" e="Fullname"></text>
        </field>
		<field name="ten_parent" width="150" hidden="false">
          <text v="Teamlead" e="Teamlead"></text>
        </field>
		
		<!-- <field name="ma_pb" width="0" hidden="false"> -->
		  <!-- <text v="Department" e="Department Code"></text> -->
		<!-- </field> -->


		<field name="ncount" width="150" align="right" hidden="false">
          <text v="Total Calls" e="Total Calls"></text>
        </field>
		<field name="total_anscall" width="150"  align="right"   hidden="false">
          <text v="Total Answer Calls" e="Total Answer Calls"></text>
        </field>
		<field name="totalappid" width="150" align="right" hidden="false">
          <text v="Total Contracts" e="Total Contracts"></text>
        </field>
		<field name="total_ansapp" width="150" align="right" hidden="false">
          <text v="Total Connected Contracts" e="Total Contracts"></text>
        </field>
		<field name="totalduration" width="150"  align="right"   hidden="false">
          <text v="Total Duration" e="Total Duration"></text>
        </field>
		<field name="totalbillsec" width="150"  align="right"   hidden="false">
          <text v="Total Billsec" e="Total Billsec"></text>
        </field>
		<field name="avgbillsecqd" width="150"  align="right"   hidden="false">
          <text v="Avg Total Billsec" e="Avg Total Billsec"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$ss_bctkrp(f){
  this.constructor(f);
}
grid$ss_bctkrp.prototype = new DirEvent();
grid$ss_bctkrp.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$ss_bctkrp.prototype.beforeInit = function(){
  var p = this._dir;
}
grid$ss_bctkrp.prototype.afterInit = function(){
  var p = this._dir, g = p.grid(), dt = g.data;
}
]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
  <script>
    <processing>
      <text>
        <![CDATA[
exec ss_bctkrp @ngay_ct1, @ngay_ct2, '', '@@gridFields', '', '', @ma_unit, '@@lan', @@userId, @@admin, '',@ma_donvi,@ma_pb,@ma_bp
        ]]>
