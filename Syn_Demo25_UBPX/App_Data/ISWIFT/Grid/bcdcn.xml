<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="bcdcn" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Bảng cân đối công nợ" e=""></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_kh" width="100" link="~sctcn1kh" operation="=">
          <text v="Mã khách hàng" e="Customer"></text>
        </field>
        <field name="ten_kh" width="250" aliasName="b">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>

        <field name="no_dk" dataType="N" format="Qty" width="100">
          <text v="Dư đầu" e="Opening Q'ty"></text>
        </field>
        <field name="no_dk_nt" dataType="N" format="FCAmount" width="100">
          <text v="Dư đầu nt" e="FC Opening Amt."></text>
        </field>

        <field name="ps_no" dataType="N" format="Qty" width="100">
          <text v="Nợ trong kỳ" e=""></text>
        </field>
        <field name="ps_no_nt" dataType="N" format="Amount" width="100">
          <text v="Nợ trong kỳ nt" e=""></text>
        </field>

        <field name="ps_co" dataType="N" format="Qty" width="100">
          <text v="Trả trong kỳ" e=""></text>
        </field>
        <field name="ps_co_nt" dataType="N" format="Amount" width="100">
          <text v="Trả trong kỳ nt" e=""></text>
        </field>

        <field name="no_ck" dataType="N" format="Qty" width="100">
          <text v="Dư cuối" e="Opening Q'ty"></text>
        </field>
        <field name="no_ck_nt" dataType="N" format="" width="100">
          <text v="Dư cuối nt" e=""></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$bcdcn(f){
  this.constructor(f);
}
grid$bcdcn.prototype = new DirEvent();
grid$bcdcn.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$bcdcn.prototype.beforeInit = function(){
  var p = this._dir;
  p.options.hiddenNotExistsColumn = true;
}
grid$bcdcn.prototype.afterInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
</dir>