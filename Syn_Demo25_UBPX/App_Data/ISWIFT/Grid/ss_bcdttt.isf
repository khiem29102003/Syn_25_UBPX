<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="ss_bcdttt" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo cáo doanh thu trước thuế" e="Pre-tax Revenue Report"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>
		<field name="stt" width="50" align="Center">
          <text v="STT" e="No."></text>
        </field>
		<field name="ngay_ct" width="150" dataType="D" align="center" hidden="true">
          <text v="Ngày c\từ" e="Customer Code"></text>
        </field>		
		<field name="id" width="100" hidden = "true" >
          <text v="Id hệ thống" e="Customer Code"></text>
        </field>
		<field name="ma_ct" width="60" hidden = "true" >
          <text v="Mã c/từ" e="Voucher Code"></text>
        </field>
		<field name="so_ct" width="80" hidden = "true" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
		<field name="ma_job" width="60" hidden = "false" align="center">
          <text v="Mã" e="Job Code"></text>
        </field>
		<field name="so_job" width="80" link="V" align="center" >
          <text v="Số" e="Job Number"></text>
        </field>
		<field name="ma_kh" width="0" hidden = "false">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="200" >
          <text v="Khách hàng" e="Customer"></text>
        </field>		
		<field name="ma_nv" width="0" hidden = "true">
          <text v="Nhân viên" e="Employee"></text>
        </field>
        <field name="ten_nv" width="200">
          <text v="Nhân viên" e="Employee"></text>
        </field>
		<field name="so_tk" width="150">
          <text v="Số tờ khai" e="Declaration Number"></text>
        </field>
		
		<field name="t_tienx2_m72" width="100" dataType="N">
          <text v="Chi hộ" e="Pay on Behalf"></text>
        </field>
		<field name="t_tieny2_m72" width="100" dataType="N">
          <text v="Tiền mua" e="Purchase Funds"></text>
        </field>
		
		<field name="t_tienx2_m54" width="100" dataType="N">
          <text v="Thu hộ" e="Collect on Behalf"></text>
        </field>
		<field name="t_tieny2_m54" width="100" dataType="N" hidden="fasle">
		  <text v="Tiền bán" e="Sales Income"></text>
        </field>

		<field name="loinhuan" width="100" dataType="N">
          <text v="Lợi nhuận" e="Profit"></text>
        </field>
		
		
      </fields>

      &DefaultButton;
    </grid>
  </grids>

