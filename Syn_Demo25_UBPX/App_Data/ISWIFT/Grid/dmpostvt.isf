<dir id="dmpostvt" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Quản lý sản phẩm" e="Product Manager"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmpostvt" fieldKey="ma_vt" order="ma_vt" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_vt" fieldType="PK" width="120" link="1">
          <text v="Mã hàng hóa" e="Product Code"></text>
        </field>
        <field name="ten_vt" width="300">
          <text v="Tên hàng hóa" e="Description"></text>
        </field>
        <field name="dvt" width="80">
          <text v="Đvt" e="UOM"></text>
        </field>
        <field name="ma_lvt" width="80" >
          <text v="Loại hàng hóa" e="Goods Type"></text>
        </field>
		<field name="ten_lvt" width="200" fieldType="EX" >
          <text v="Tên loại hàng hóa" e="Goods Type"></text>
        </field>
		   <field name="ximage1" width="80" hidden="true">
          <text v="Ảnh" e="Goods Type"></text>
        </field>
        <field name="nh_vt1"  width="80" hidden="true">
          <text v="Nhóm 1" e="Group 1"></text>
        </field>
        <field name="nh_vt2"  width="150" hidden="true">
          <text v="Nhóm 2" e="Group 2"></text>
        </field>
		<field name="nh_vt3"  width="150" hidden="true">
          <text v="Nhóm 3" e="Group 3"></text>
        </field>
		<field name="thu_tu" width="250">
          <text v="Thứ tự" e="Position"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="edit">
          <text v="$EditToolbar" e="$EditToolbar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="view">
          <text v="$ViewToolbar" e="$ViewToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
       
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
