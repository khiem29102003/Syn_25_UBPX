  <js>
    <text>
      <![CDATA[
function grid$analysisSalesData(f){
  this.constructor(f);
}
grid$analysisSalesData.prototype = new DirEvent();
grid$analysisSalesData.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$analysisSalesData.prototype.beforeInit = function(){
  var p = this._dir;
  p.options.hiddenNotExistsColumn = (p.options._data_analysis_struct == '');
}
grid$analysisSalesData.prototype.afterInit = function(){
  var p = this._dir, g = p.grid(), dt = g.data;

  if (!$('#content .btn-action').length){
    var color = Chart.helpers.color;
    var chartData = {
        labels: [],
        datasets: []
    };
    var chartView = null;
  
    var s = '<button class="btn-action btn-action-v1" id="btnViewChart"><div class="icon-btn-bottom ic-view-dept"></div></button>'
    $("#content").append(s);
    $("#btnViewChart").click(function () {
      var f = $("#form_ChartView");
      if(f.length == 0){
        var chartBox = $.fn.addBottomBox("ChartView", p.msg("ChartName"), null, function () { $("#btnViewChart").show(150); });
        chartBox.append("<div style='height: calc(100% - 30px); overflow-x: hidden; overflow-y: auto;'><canvas id='canvas'></canvas><div>");
        
        var ctx = document.getElementById("canvas").getContext("2d");
        chartView = new Chart(ctx, {
            type: 'bar',
            data: chartData,
            options: {
                responsive: true,
                legend: {
                    position: 'top',
                },
                title: {
                    display: false,
                    text: ''
                }
            }
        });
  
        showChartBox();
      }
      else{
        showChartBox();
      }
    });
    
    $(".table-bottom table tbody").selectrange({onSelectedRange: function (tbody, allSelected, iFrom, iTo, jFrom, jTo) {
		  var allData = [], allHeader = [], allLabels = [];
      var tr = $(".table-bottom table thead tr");
      var trHead = tr.eq(tr.length - 1).find("th");
      var xIndex = 0;
      for(var j = jFrom; j <= jTo; j++){
        var dType = dt.obj.DataTypes[j + 1];
        if(dType == "N" || dType == "I"){
          allHeader.push(trHead.eq(j).find("span").html());
          allData.push([dt.obj.Rows[iFrom][j + 1]]);
        
          for(var i = iFrom; i <= iTo; i++){
            if(xIndex == 0){
              var row = tbody.find("tr:nth-child(" + (i + 1) + ")");
              allLabels.push(row.find("td:nth-child(2)").html());
            }
            if(i > iFrom)
              allData[xIndex].push(dt.obj.Rows[i][j + 1]);
          }
          xIndex++;
        }
      }
      chartData.labels = allLabels;
      chartData.datasets = [];
      var colorNames = Object.keys(window.chartColors);
      for(var i = 0; i < allHeader.length; i++){
        var colorName = colorNames[chartData.datasets.length % colorNames.length];
        var dsColor = window.chartColors[colorName];
      
        var newDataset = {
            label: allHeader[i],
            backgroundColor: color(dsColor).alpha(0.5).rgbString(),
            borderColor: dsColor,
            borderWidth: 1,
            data: allData[i]
        };
        chartData.datasets.push(newDataset);
      }
      chartView.update();    
	  }});
  }
}

function showChartBox(){
  $("#form_ChartView").show(150);
  $("#btnViewChart").hide(150);
}
window.chartColors = {
	red: 'rgb(255, 99, 132)',
	orange: 'rgb(255, 159, 64)',
	green: 'rgb(75, 192, 192)',
	blue: 'rgb(54, 162, 235)',
  yellow: 'rgb(255, 205, 86)',
	purple: 'rgb(153, 102, 255)'
};
]]>
    </text>
  </js>
