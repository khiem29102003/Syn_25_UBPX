<dir id="dmhaiquan" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hải quan" e="List of Customs"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmhaiquan" fieldKey="ma_hq" order="ma_hq" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_hq" fieldType="PK" width="120">
          <text v="Mã hải quan" e="Customs Code"></text>
        </field>
        <field name="ten_hq" width="250">
          <text v="Tên hải quan" e="Customs Name"></text>
        </field>
		<field name="ten_hq2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="ten_cd" width="250">
          <text v="Tên chức danh" e="Position Title"></text>
        </field>
		<field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

