        </field>
        <field name="ten_vtcv" width="250">
          <text v="Tên vị trí công việc" e="Job Position Name"></text>
        </field>         
		<field name="ten_vtcv2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field> 
		<field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

