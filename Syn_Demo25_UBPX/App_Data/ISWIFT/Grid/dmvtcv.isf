  <title v="Danh mục vị trí công việc" e="List of Job Positions"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmvtcv" fieldKey="ma_vtcv" order="ma_vtcv" allowFilter="true" allowOrder="true">
