<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="hrdsnvnv" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách nhân viên nghỉ việc" e="Employee List"></title>
  <subtitle v="Nghỉ từ ngày {ngay_nghi_tu} đến ngày {ngay_nghi_den}..." e="From {ngay_nghi_tu} To {ngay_nghi_den}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_nv" operation="=" width="100">
          <text v="Mã nhân viên" e="Employee ID"></text>
        </field>
        <field name="ten_nv" width="250" aliasName="b">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
        <field name="ten_bp" width="150">
          <text v="Bộ phận" e="Department"></text>
        </field>
        <field name="ten_vtr" width="150">
          <text v="Vị trí" e="Position"></text>
        </field>
        <field name="ngay_vao" width="100" dataType="D">
          <text v="Ngày nhận việc" e="Join date"></text>
        </field>
        <field name="ngay_nghi" width="100" dataType="D">
          <text v="Ngày nghỉ việc" e=""></text>
        </field>
        <field name="ly_do_nghi" width="200">
          <text v="Lý do nghỉ" e="Region"></text>
        </field>
        <field name="so_tro_cap" format="Amount" dataType="N" width="120">
          <text v="Trợ cấp thất nghiệp" e=""></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$hrdsnvnv(f){
  this.constructor(f);
}
grid$hrdsnvnv.prototype = new DirEvent();
grid$hrdsnvnv.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$hrdsnvnv.prototype.beforeInit = function(){
  var p = this._dir;
}
]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
</dir>