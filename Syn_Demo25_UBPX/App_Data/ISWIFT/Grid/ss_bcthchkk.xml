<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="ss_bcthchkk" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo cáo chi hộ thu hộ không khớp" e="Discrepancy in Collect and Disburse Reports"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
	  <fields>
		<field name="id" width="100" hidden = "true" >
          <text v="Id hệ thống" e="ID"></text>
        </field>
		<field name="ma_ct" width="0" >
          <text v="Mã c/từ" e="Voucher Code"></text>
        </field>
		<field name="so_ct" width="0" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
		<field name="ma_job" width="60" align="center" >
          <text v="Mã" e="Code"></text>
        </field>
		<field name="so_job" width="80" align="center" link="V" >
          <text v="Số" e="Job Number"></text>
        </field>
		<field name="ngay_ct_job" width="100" dataType="D" align="center" >
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>		
		<field name="ma_kh_job" width="120" hidden="false">
          <text v="Mã khách hàng DH" e="Customer Code"></text>
        </field>
		<field name="ten_kh" width="250">
          <text v="Tên khách hàng DH" e="Customer Name"></text>
        </field>
		<field name="so_tk" width="150">
          <text v="Số tờ khai" e="Declaration Number"></text>
        </field>
		<field name="hbl_no" width="150">
          <text v="Số B/L" e="B/L No"></text>
        </field>
		<field name="dien_giai_job" width="250">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		<field name="ten_noi_di" width="200">
           <text v="Nơi đi" e="Origin"></text>
        </field>
		<field name="ten_noi_den" width="200">
          <text v="Nơi đến" e="Destination"></text>
        </field>
		<field name="tien_ch" width="120" dataType="N">
          <text v="Tiền chi hộ" e="Pay on Behalf"></text>
        </field>
		<field name="tien_th" width="120" dataType="N">
          <text v="Tiền thu hộ" e="Total Amount"></text>
        </field>
		<!-- <field name="tt" width="120" dataType="N"> -->
          <!-- <text v="Tiền thanh toán trước" e="Prepayment"></text> -->
        <!-- </field> -->
		<!-- <field name="tien_cl" width="120" dataType="N"> -->
          <!-- <text v="Tiền còn lại" e="Remaining Amount"></text> -->
        <!-- </field> -->
		<!-- <field name="tat_toan" width="80" align="Center"> -->
          <!-- <text v="Tất toán" e="Paid in Full"></text> -->
        <!-- </field>	 -->
      </fields>
      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$ss_bcthchkk(f){
  this.constructor(f);
}
grid$ss_bcthchkk.prototype = new DirEvent();
grid$ss_bcthchkk.prototype.afterInitFields = function(){
  var p = this._dir;
}
grid$ss_bcthchkk.prototype.beforeInit = function(){
  var p = this._dir;
}
grid$ss_bcthchkk.prototype.afterInit = function(){
  var p = this._dir, g = p.grid(), dt = g.data;
}
]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
  <script>
    <processing>
      <text>
        <![CDATA[
exec ss_bcthchkk @ngay_ct1, @ngay_ct2
		]]>
      </text>
	
    </processing>
  </script>
</dir>