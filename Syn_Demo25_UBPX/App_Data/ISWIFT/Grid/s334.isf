<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="s334" dirViewType="Grid" dirObjectType="Voucher" voucherCode="BL3" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phí AIR theo cảng" e="AIR Fees By Port"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="s33" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
		<field name="so_ct" width="120" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
		<field name="ma_kh" width="120" hidden = "true">
          <text v="Mã hãng tàu / đại lý" e="Agent Code"></text>
        </field>
        <field name="ten_kh" width="250" fieldType="EX" >
          <text v="Tên hãng tàu / đại lý" e="Agent Name"></text>
        </field> 
		<field name="ma_noi_di" width="120" hidden="true" >
          <text v="Nơi đi" e="Destination"></text>
        </field>	
		<field name="ten_noi_di" width="250" fieldType="EX"  hidden="false">
		  <text v="Nơi đi " e="Destination Name"></text>
		</field>	
		 <field name="ma_ttp" width="120" hidden = "true">
          <text v="Mã khu vực" e="Agent Code"></text>
        </field>
        <field name="ten_ttp" width="250" fieldType="EX" hidden = "true">
          <text v="Tên khu vực" e="Agent Name"></text>
        </field>
        <field name="ma_qg" width="120" hidden = "true">
          <text v="Mã quốc gia" e="Agent Code"></text>
        </field>
        <field name="ten_qg" width="250" fieldType="EX" hidden = "true">
          <text v="Tên quốc gia" e="Agent Name"></text>
        </field>		
		<field name="ma_phi" width="120" hidden="true">
          <text v="Tên phí" e="Origin"></text>
        </field>
		<field name="ten_phi" width="250" fieldType="EX" hidden="true">
		  <text v="Tên phí" e="Origin Name"></text>
		</field>
		
		
		<field name="ma_kh" width="0" >
          <text v="Đại lý" e="Agent"></text>
        </field>
		<field name="ngay_hl" width="120" dataType="D">
          <text v="Ngày hiệu lực" e="Effective  date"></text>
        </field>
		<field name="ngay_hld" width="120" dataType="D">
          <text v="Ngày hiệu lực đến" e="Expiry  date"></text>
        </field>
		<field name="ma_nt" width="0" >
          <text v="Ngoại tệ" e="Currency"></text>
        </field>
		<field name="dien_giai" width="250">
          <text v="Ghi chú" e="Note"></text>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="80" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
