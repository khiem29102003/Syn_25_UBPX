<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmkc" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục khoảng cách" e="Distance catalog"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmkc" fieldKey="ma_kc" order="ma_kc" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_kc" fieldType="PK" width="120" >
          <text v="Mã khoảng cách" e="Distance code"></text>
        </field>
		 <field name="ten_kc" width="250">
          <text v="Tên khoảng cách" e="Distance name"></text>
        </field>
		<field name="noi_di" width="250">
          <text v="Nơi đi" e="Distance name"></text>
        </field>
		<field name="noi_den" width="250">
          <text v="Nơi đến" e="Distance name"></text>
        </field>
		<field name="chieu_dai" width="120">
          <text v="Chiều dài" e="Distance name"></text>
        </field>
        <field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$dmkc(f){
  this.constructor(f);
}
grid$dmkc.prototype = new DirEvent();
grid$dmkc.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[
		.table-bottom{
			left: 0px!important;
			height: calc(100% - 77px);
			top: 0px;
			position: relative;
			margin-top: 27px;
			clear: both;
			border-bottom: 1px solid #ddd;
		}
		#content .dir{
			position: relative !important;
			height: 100%;
		}

		@media only screen and (max-width: 767px) {
		  .table-bottom{
			margin-top: 42px;
			height: calc(100% - 92px);
		  }
		}
		]]>
    </text>
  </css>
</dir>