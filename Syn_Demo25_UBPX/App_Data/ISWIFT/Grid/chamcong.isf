<dir id="chamcong" dirViewType="Grid" dirObjectType="Voucher" voucherCode="CC0" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Chấm công" e="Timekeeping"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="chamcong" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields >
        <field name="id" fieldType="PK" hidden="true" width="120">
          <text v="" e=""></text>
        </field>
		<field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="120" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="ma_nv" width="120">
          <text v="Mã nhân viên" e="Staff code"></text>
        </field>
		<field name="ten_nv" width="220" fieldType="EX">
          <text v="Tên nhân viên" e="Staff name"></text>
        </field>	
		<field name="ma_cv" width="120">
          <text v="Mã chức vụ" e="Staff code"></text>
        </field>	
		<field name="ma_bp" width="120">
          <text v="Mã bộ phận" e="Staff code"></text>
        </field>
		<field name="tong_ngay_lam" width="120">
          <text v="Tổng ngày làm" e="Staff name"></text>
        </field>
		
     </fields>

		<buttons>
		 <button id="add">
			<text v="$AddToolbar" e="$AddToobar"></text>
		  </button>
		  <button id="edit">
