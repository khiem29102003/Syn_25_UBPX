<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="n14" dirViewType="Grid" dirObjectType="Voucher" voucherCode="CC0" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Đăng ký ngày công" e="Timekeeping"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="n14" fieldKey="id, ma_bp" order="id desc" allowFilter="true" allowOrder="true">
      <fields >
        <field name="id" fieldType="PK" hidden="true" width="120">
          <text v="" e=""></text>
        </field>
		<field name="ma_unit" width="100" fieldType="EX" align="center" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="100">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
		 <field name="ma_bp" fieldType="PK" hidden="false" width="100" align="center">
          <text v="Team" e="Team"></text>
        </field>
		<field name="ngay_hl" dataType="D" width="150">
          <text v="Ngày hiệu lực" e="Effective date"></text>
        </field>

		<field name="so_ct" width="120" hidden="true">
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D" hidden="true">
          <text v="Ngày hiệu lực" e="Voucher Date"></text>
        </field>
		<field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
		
     </fields>

		<buttons>
		 <button id="add">
			<text v="$AddToolbar" e="$AddToobar"></text>
		  </button>
		  <button id="edit">
			<text v="$EditToolbar" e="$EditToolbar"></text>
		  </button>
		  <button id="delete">
			<text v="$DeleteToolbar" e="$DeleteToolbar"></text>
		  </button>
		  <button id="copy">
			<text v="$CopyToolbar" e="$CopyToolbar"></text>
		  </button>
		  <button id="view">
			<text v="$ViewToolbar" e="$ViewToolbar"></text>
		  </button>
		  <button id="split">
			<text v="-" e="-"></text>
		  </button>
		  <button id="refresh">
			<text v="$RefreshToolbar" e="$RefreshToolbar"></text>
		  </button>
		  <button id="freeze">
			<text v="$FreezeToolbar" e="$FreezeToolbar"></text>
		  </button>
		  <button id="split">
			<text v="-" e="-"></text>
		  </button>
		  <button id="export">
			<text v="$ExportToolbar" e="$ExportToolbar"></text>
		  </button>
		</buttons>
		
	<script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
		
      </script>
	  
    </grid>
  </grids>

