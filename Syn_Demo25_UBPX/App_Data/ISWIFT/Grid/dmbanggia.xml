<dir id="dmbanggia" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo giá Bảng giá" e="Vehicle List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbanggia" fieldKey="ma_bg" order="ma_bg" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_bg" fieldType="PK" width="100">
          <text v="Mã Bảng giá" e="Product type code"></text>
        </field>
		<field name="ten_bg" width="220">
          <text v="Tên Bảng giá" e="Product type name"></text>
        </field>
	
		<field name="ma_loai" width="100">
          <text v="Mã Loại" e="Product type code"></text>
        </field>
		<field name="ten_loai" width="220">
          <text v="Tên Loại" e="Product type name"></text>
        </field>
	 
	
	 
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
		<field name="thu_tu" width="120">
          <text v="Thứ tự" e="Position"></text>
        </field>
		<field name="thu_tu2" width="120">
          <text v="Thứ tự 2" e="Position"></text>
        </field>
		  <field name="pack1" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Standard" e="Customer"></text>
        </field>
        <field name="pack2" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Professional" e="Supplier"></text>
        </field>
		<field name="pack3" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Premium" e="Supplier"></text>
        </field>
		<field name="pack4" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Customer" e="Supplier"></text>
        </field>
		 
		 
      </fields>

      &DefaultButton;

    </grid>
  </grids>

