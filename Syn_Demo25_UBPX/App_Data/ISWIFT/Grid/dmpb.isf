        </field>
        <field name="ten_pb" width="250">
          <text v="Tên phòng ban" e="Department Name"></text>
        </field>
		<field name="ten_pb2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

