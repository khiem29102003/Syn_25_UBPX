<dir id="dmpb" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phòng ban" e="List of Departments"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmpb" fieldKey="ma_pb" order="ma_pb" allowFilter="true" allowOrder="true">
