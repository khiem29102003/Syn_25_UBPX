<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridNotPrint.xml">
]>

<dir id="dmrmail" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách Mail nhận" e="Recipient list"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmrmail" fieldKey="ma_rmail" order="ma_rmail" allowFilter="true" allowOrder="true" >
      <fields>
	    <field name="ma_rmail" fieldType="PK" width="120">
          <text v="Mã" e="Code"></text>
        </field>
        <field name="r_mail" width="120">
          <text v="Email" e="Email"></text>
        </field>
		<field name="ten_mail" width="250">
          <text v="Tên mail" e="Full Name"></text>
        </field>		
		<field name="ten_mail2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="lastsentdate" dataType ="D" width="120">
          <text v="Gửi lần cuối" e="Last Sent Mail"></text>
        </field>
		<field name="so_lan_gui" dataType ="N" width="120">
          <text v="Số lần gửi" e="Total"></text>
        </field>
        <field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;
