<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridFinding.xml">
]>

<dir id="dmdtcn" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục điện thoại cá nhân" e="List of personal phone"></title>
  <subtitle v="Xem, sửa dữ liệu..." e="View, update data..."></subtitle>
  <grids>
    <grid table="dmdtcn" fieldKey="ma_so_thue, dien_thoai" order="ma_so_thue, dien_thoai" allowFilter="true" allowOrder="true" >
      <fields>	
		<field name="ma_so_thue" width="150" fieldType="PK">
          <text v="Mã số thuế" e="Tax Code"></text>
        </field>
		<field name="dien_thoai" width="150" align="right" fieldType="PK">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="ghi_chu" width="150" align="right">
          <text v="Ghi chú 1" e="Note 1 "></text>
        </field>
		<field name="ghi_chu2" width="150" align="right">
          <text v="Ghi chú 2" e="Note 2"></text>
        </field>
		<field name="status" viewType="Combobox" width ="150" valueDefault="1">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_tt, ten_tt%l from dmttsd where status = 1 order by ma_tt">
            </options>
          </viewInfo>
        </field>
		<field name="xstatus" viewType="Combobox" inactivate="true" label="1" field="[150]" nextRow="false" valueDefault ="5" >
          <text v="Trạng thái" e="Status"></text>
		  <viewInfo>
			<options query="select ma_tt, ten_tt%l from dmtrangthai where status = 1">
			</options>
		  </viewInfo>
        </field>

		<field name="user_id2" viewType="Combobox" width = "150">
          <text v="Người tác động" e="Date updated"></text>
          <viewInfo>
            <options query="select user_id, username%l from sysuserinfo where status = 1 order by user_id">
              <option val="">
                <text v="" e=""></text>
              </option>
            </options>
          </viewInfo>
        </field>
	   <field name="datetime2" hidden="false" dataType="D" width="150" align="center">
          <text v="Ngày tác động" e="Date updated"></text>
        </field>
      </fields>
	  
	  <buttons>
	   <button id="edit">
		<text v="$EditToolbar" e="$EditToolbar"></text>
	  </button>
	  <button id="view">
		<text v="$ViewToolbar" e="$ViewToolbar"></text>
	  </button>
	  <button id="split">
		<text v="-" e="-"></text>
	  </button>
	   <button id="find">
		<text v="$FindToolbar" e="$FindToolbar"></text>
	   </button>
	  <button id="split">
		<text v="-" e="-"></text>
	  </button>
	  <button id="refresh">
		<text v="$RefreshToolbar" e="$RefreshToolbar"></text>
	  </button>
	  <button id="freeze">
		<text v="$FreezeToolbar" e="$FreezeToolbar"></text>
	  </button>
	  <button id="split">
		<text v="-" e="-"></text>
	  </button>
	   <button id="print">
		<text v="$PrintToolbar" e="$PrintToolbar"></text>
	  </button>
	  <button id="export">
		<text v="$ExportToolbar" e="$ExportToolbar"></text>
	  </button>
	  <button id="downtemplate">
		<text v="Tải mẫu Excel" e="Down import template"></text>
		</button>
		<button id="import">
		<text v="Lấy dữ liệu từ tập tin" e="Import data"></text>
		</button>
	</buttons>
	<script>
        <query>
          <text>
            <![CDATA[
exec ISWIFTStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', '', '', '@@key', '', @@filterKey, '', @pageIndex, 50, @@admin, @@userId
         ]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[
declare @strKey nvarchar(3000)
set @strKey = @strFinding
  
exec ISWIFTStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', '', '', '@@key', @strKey, @@filterKey, '', @pageIndex, 50, @@admin, @@userId
         ]]>
          </text>
        </finding>
      </script>
    </grid>
  </grids>

  <js>
    <text>
	<![CDATA[
		function grid$dmdtcn(f){
			this.constructor(f);
		}
		grid$dmdtcn.prototype = new DirEvent();
		grid$dmdtcn.prototype.afterInit = function(){

		}
	]]>
    </text>
  </js>

