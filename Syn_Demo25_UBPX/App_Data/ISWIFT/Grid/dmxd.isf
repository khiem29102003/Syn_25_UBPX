<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmxd" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục xăng dầu" e="List of petroleum"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmxd" fieldKey="ma_xd" order="ma_xd" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_xd" fieldType="PK" width="120">
          <text v="Mã xăng dầu" e="Petroleum code"></text>
        </field>
        <field name="ten_xd" width="250">
          <text v="Tên xăng dầu" e="Petroleum name"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

