<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
   <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmddkh" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nơi đi/ đến của khách hàng" e="Customer Pickup/Delivery Location List"></title>
  <subtitle v="Xem, sửa dữ liệu..." e="View, update data..."></subtitle>
  <grids>
    <grid table="dmddkh" fieldKey="ma_so_thue, ma_noi_di, ma_noi_den" order="ma_so_thue" allowFilter="true" allowOrder="true" >
      <fields>	
		<field name="ma_so_thue" width="150" fieldType="PK">
          <text v="Mã số thuế" e="Tax Code"></text>
        </field>
		<field name="ten_kh" width="150" fieldType="EX">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
		<field name="dien_thoai" width="120" fieldType="EX" >
          <text v="Điện thoại" e="Tel"></text>
        </field>
		<field name="ma_noi_di" width="150" fieldType="PK">
          <text v="Mã nơi đi" e="Orgin"></text>
        </field>
		<field name="ma_noi_den" width="150" fieldType="PK">
          <text v="Mã nơi đến" e="Destination"></text>
        </field>
		<field name="status" viewType="Combobox" width ="150" valueDefault="1">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_tt, ten_tt%l from dmttsd where status = 1 order by ma_tt">
            </options>
          </viewInfo>
        </field>
	  </fields>
	  &DefaultButton;
	<script>
        <query>
          <text>
            <![CDATA[<enc>KrJ2pqmaIF3y7BHaWfCqamcOgeie6xQ6frxEzC2hRn+n6/tcIZlLxVon020yR5Qzndv9dGDI7FCDIXPIaAat7t4JRi3kaCkLDxb+H/Z/MPtVvb7SfNOa91H9JCJgM+QT365BimFj986Xu07ZEsg8/OPOsDguah31TMpExMav73/03Axuni6GB3bt1D5ToyCL4cc44/tFWoPFTVi2EMozLekx96Wpe53IztYh9HAm8Q/KBJfKuLIqBHAwXVxmg5ZA</enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>
    </grid>
  </grids>

  <js>
