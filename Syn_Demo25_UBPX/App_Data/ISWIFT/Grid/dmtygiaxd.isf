<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmtygiaxd" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo tỷ giá xăng dầu" e="Declare petrol rates"></title>
  <subtitle v="Cập nhật tỷ giá..." e="Add, Edit, Delete Exchange Rate..."></subtitle>
  <grids>
    <grid table="dmtygiaxd" fieldKey="ma_xd,ngay_hl" order="ma_xd" allowFilter="true" allowOrder="true" >
      <fields >
        <field name="ma_xd" fieldType="PK" width="120" >
          <text v="Mã xăng dầu" e="Petroleum Code"></text>
        </field>
        <field name="ten_xd" width="250" fieldType="EX"  aliasName="b">
          <text v="Tên xăng dầu" e="Petroleum Name"></text>
        </field>
        <field name="ngay_hl" fieldType="PK" width="120" dataType="D">
          <text v="Ngày" e="Date"></text>
        </field>
        <field name="ty_gia" dataType="N" format="ExRate" width="120">
          <text v="Tỷ giá" e="Exchange Rate"></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
