<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
	  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmkh" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục người gửi, nhận và thông báo" e="List of Shippers, Consignees and Notify Parties"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit..."></subtitle>
  <grids>
    <grid table="dmkh" fieldKey="ma_kh" order="ma_kh" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_kh" fieldType="PK" width="120" link="1">
          <text v="Mã đối tượng" e="Entitys Code"></text>
        </field>
        <field name="ten_kh" width="250">
          <text v="Tên đối tượng" e="Entitys Name"></text>
        </field>        
		<field name="ten_kh2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
        <field name="ma_so_thue" width="120">
          <text v="Mã số thuế" e="Tax Code"></text>
        </field>
        <field name="ma_nvbh" width="120">
          <text v="Mã nhân viên" e="Employee"></text>
        </field>
        <field name="kh_yn" dataType="B" align="center" width="100" allowOrder="false">
          <text v="Khách hàng" e="Customer"></text>
        </field>
        <field name="ncc_yn" dataType="B" align="center" width="100" allowOrder="false">
          <text v="Hãng tàu" e="Carriers"></text>
        </field>
		<field name="hk_yn" dataType="B" align="center" width="100" allowOrder="false">
          <text v="Hàng không" e="Airlines"></text>
        </field>
        <field name="dl_yn" dataType="B" align="center" width="100" allowOrder="false">
          <text v="Đại lý" e="Agent"></text>
        </field>        
		<field name="vc_yn" dataType="B" align="center" width="100" allowOrder="false">
          <text v="Vận tải" e="Trucking Company"></text>
        </field>
		<field name="other_yn" dataType="B" align="center" width="100" allowOrder="false">
          <text v="Khác" e="Other"></text>
        </field>
		<field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>
      
     <buttons>
	  <button id="add">
		<text v="$AddToolbar" e="$AddToobar"></text>
	  </button>
	  <button id="edit">
		<text v="$EditToolbar" e="$EditToolbar"></text>
	  </button>
	  <button id="delete">
		<text v="$DeleteToolbar" e="$DeleteToolbar"></text>
	  </button>
	  <button id="copy">
		<text v="$CopyToolbar" e="$CopyToolbar"></text>
	  </button>
	  <button id="view">
		<text v="$ViewToolbar" e="$ViewToolbar"></text>
	  </button>
	  <button id="split">
		<text v="-" e="-"></text>
	  </button>
	  <button id="find">
		<text v="$FindToolbar" e="$FindToolbar"></text>
	   </button>
	  <button id="refresh">
		<text v="$RefreshToolbar" e="$RefreshToolbar"></text>
	  </button>
	  <button id="freeze">
		<text v="$FreezeToolbar" e="$FreezeToolbar"></text>
	  </button>
	  <button id="split">
		<text v="-" e="-"></text>
	  </button>
	  <!-- <button id="print"> -->
		<!-- <text v="$PrintToolbar" e="$PrintToolbar"></text> -->
	  <!-- </button> -->
	  <button id="export">
		<text v="$ExportToolbar" e="$ExportToolbar"></text>
	  </button>
	  <button id="downtemplate">
		<text v="Tải mẫu Excel" e="Down import template"></text>
	  </button>
	  <button id="import">
		<text v="Lấy dữ liệu từ tập tin" e="Import data"></text>
	  </button>
	 </buttons>

      
