<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucherNotPrint.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="s13" dirViewType="Grid" dirObjectType="Voucher" voucherCode="YG3" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Yêu cầu báo giá hàng không (AIR)" e="Request Air Freight Quote"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="s13" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
        <field name="so_ct" width="80" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="ma_kh" width="0" >
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>     
		<field name="ma_noi_di" width="120" hidden="true">
          <text v="Nơi đi" e="Origin"></text>
        </field>
		<field name="ten_noi_di" width="250" fieldType="EX">
		  <text v="Nơi đi " e="Origin"></text>
		</field>
		
		<field name="ma_noi_den" width="120" hidden="true" >
          <text v="Nơi đến" e="Destination"></text>
        </field>	
		<field name="ten_noi_den" width="250" fieldType="EX" >
		  <text v="Nơi đến" e="Destination"></text>
		</field>		
			
		
		<field name="ngay_hl" width="120" dataType="D">
          <text v="Ngày dự đi" e="Effective date"></text>
        </field>
		<field name="ngay_hld" width="120" dataType="D">
          <text v="Ngày dự đến" e="Expiry date"></text>
        </field>
		
		 <field name="t_so_luong" dataType="N" format="FCAmount" width="120">
          <text v="Tổng số lượng" e="Total"></text>
        </field>
        <field name="t_tong_trong" dataType="N" format="FCAmount" width="120">
          <text v="Tổng trọng lượng" e="Total amount"></text>
        </field>
		<field name="t_tong_khoi" dataType="N" format="FCAmount" width="120">
          <text v="Tổng khối lượng" e="Total amount"></text>
        </field>
		<field name="dien_giai" width="250">
          <text v="Ghi chú" e="Note"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="120">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="120" fieldType="EX" >
          <text v="Đơn vị" e="Customer Name"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>jzcoae1D7/AzsY7GhcCcRRkO5hme8zhPjCpnySOvOCTBWF/4cYqbqfRbgbztJbc5DYzvQJL9vY64rPiJBeBON0t78evInA9h+gnquCEPw2ngTFawqqgEts2egLxkrxaVLN6BO93WX0gI7KVR3AP7kbzGzwUjquOWofoyclWSwJXchdX7Ro5x+/LF19WHdFhLVVYT/rEAP2lwBfIRP8726Q==</enc>]]>
    </text>
  </js>
<css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
  <script>
    &VoucherJSLoading;
  </script>
</dir>