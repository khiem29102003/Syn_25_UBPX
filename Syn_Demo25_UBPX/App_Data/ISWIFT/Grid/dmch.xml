<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmch" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục cửa hàng" e="Store List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmch" fieldKey="ma_ch, ma_dc" order="ma_ch" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_ch" fieldType="PK" width="120">
          <text v="Mã của hàng" e="Store code"></text>
        </field>
		<field name="ma_dc" fieldType="PK" width="120">
          <text v="Mã địa chỉ" e="Store address"></text>
        </field>
		<field name="ten_ch" width="120">
          <text v="Tên của hàng" e="Store name"></text>
        </field>
		<field name="ten_ch2"  width="120">
          <text v="Tên khác" e="Alias"></text>
        </field>
		<field name="noi_dung" width="240">
          <text v="Nội dung" e="Content"></text>
        </field>
		<field name="dia_chi" width="240">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="dien_thoai" width="240">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="hotline" width="240">
          <text v="Hotline" e="Hotline"></text>
        </field>
		<field name="email" width="240">
          <text v="Email" e="Email"></text>
        </field>
		<field name="gio_mo_cua" width="240">
          <text v="Giờ mở cửa" e="Time open"></text>
        </field>
		<field name="gio_dong_cua" width="240">
          <text v="Giờ đóng cửa" e="Time close"></text>
        </field>
		<field name="ngay_mo_cua" width="240">
          <text v="Ngày mở cửa" e="Day open"></text>
        </field>
		<field name="ngay_dong_cua" width="240">
          <text v="Ngày đóng cửa" e="Day close"></text>
        </field>
		<field name="thu_tu" width="120">
          <text v="Thứ tự" e="Position"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>		
      </fields>

      &DefaultButton;

    </grid>
  </grids>

