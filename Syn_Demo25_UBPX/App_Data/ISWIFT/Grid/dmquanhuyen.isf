<dir id="dmquanhuyen" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục quận/huyện" e="District List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmquanhuyen" fieldKey="ma_quanhuyen" order="ma_quanhuyen" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_quanhuyen" fieldType="PK" width="120">
          <text v="Mã Quận/Huyện" e="District Code"></text>
        </field>
        <field name="ten_quanhuyen" width="250">
          <text v="Tên Quận/Huyện" e="District Name "></text>
        </field>
		<field name="ten_quanhuyen2" width="250">
          <text v="Tên tiếng anh" e="English name "></text>
        </field>
		<field name="ma_ttp" width="120">
          <text v="Mã tỉnh/thành" e="Province/City Code "></text>
        </field>
		<field name="ten_ttp" width="250"  hidden="true" fieldType="EX" >
          <text v="Tỉnh thành" e="Province/City"></text>
        </field>
      </fields>

