<dir id="dmnganhang" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục ngân hàng" e="List of Bank"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmnganhang" fieldKey="ma_nh" order="ma_nh" allowFilter="true" allowOrder="true" >
      <fields >
        <field name="ma_nh" fieldType="PK" width="120">
          <text v="Mã ngân hàng" e="Bank Code"></text>
        </field>
        <field name="ten_nh" width="250">
          <text v="Tên ngân hàng" e="Bank Name"></text>
        </field>       
		<field name="ten_nh2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="ma_qg" width="0">
          <text v="Mã quốc gia" e="Country Code"></text>
        </field>	
		<field name="ten_qg" width="250" fieldType="EX">
          <text v="Quốc gia" e="Country"></text>
        </field>
		 <field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;
