<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmthue" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục thuế" e="Tax List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmthue" fieldKey="ma_thue" order="ma_thue" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_thue" fieldType="PK" width="120">
          <text v="Mã thuế" e="Tax code"></text>
        </field>
        <field name="ten_thue" width="250">
          <text v="Tên thuế" e="Tax name"></text>
        </field>	
		<field name="ma_loai" width="200">
          <text v="Mã loại thuế" e="Tax type"></text>
        </field>

      </fields>

      &DefaultButton;

    </grid>
  </grids>

