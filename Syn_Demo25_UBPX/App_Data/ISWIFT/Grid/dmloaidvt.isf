        <field name="ma_loai" fieldType="PK" width="120">
          <text v="Mã loại ĐVT" e="Unit type code"></text>
        </field>
        <field name="ten_loai" width="250">
          <text v="Tên loại ĐVT" e="Unit type name "></text>
        </field>
		 <field name="status" width="250">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

