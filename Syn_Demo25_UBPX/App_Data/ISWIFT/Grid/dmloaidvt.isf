<dir id="dmloaidvt" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục loại đơn vị tính" e="unit Type "></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmloaidvt" fieldKey="ma_loai" order="ma_loai" allowFilter="true" allowOrder="true" >
