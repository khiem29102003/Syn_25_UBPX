<dir id="hrdmnv" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thông tin nhân viên" e="Employee Information"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>
  <grids>
    <grid table="vhrdmnv" fieldKey="id" order="ma_nv" allowFilter="true" allowOrder="true">
      <fields>
        <field name="ma_nv" fieldType="PK" width="120" >
          <text v="Mã nhân viên" e="Employee ID"></text>
        </field>
        <field name="ho_ten_nv" width="250">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
        <field name="ten_bp" width="150">
          <text v="Bộ phận" e="Department"></text>
        </field>
        <field name="ten_vtr" width="150">
          <text v="Vị trí" e="Position"></text>
        </field>

        <field name="username" width="120" fieldType="EX" aliasName="b" hidden="true">
          <text v="Tên đăng nhập" e="Username"></text>
        </field>

        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

