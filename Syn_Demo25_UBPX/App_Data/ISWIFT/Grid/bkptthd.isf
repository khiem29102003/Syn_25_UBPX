<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="bkptthd" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Bảng kê phải thu theo hóa đơn" e="List of receivables by invoice"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}..." e="From {ngay_ct1} To {ngay_ct2}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_unit" width="80" aliasName="d" join="left join sysunit d on a.unit_id = d.unit_id" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="so_ct" width="100" link="V" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ma_kh" width="100">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="250" aliasName="b" join="left join dmkh b on a.ma_kh = b.ma_kh">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
		 <field name="ma_dvvt" width="100">
          <text v="Mã đơn vị vận tải" e="Trans Code"></text>
        </field>
        <field name="ten_dvvt" width="250" aliasName="C" join="left join dmdvvt C on a.ma_dvvt = C.ma_dvvt">
          <text v="Tên đơn vị vận tải" e="Trans Name"></text>
        </field>
        <field name="dien_giai" width="250">
          <text v="Diễn giải" e="Description"></text>
        </field>
       
        <field name="t_so_luong" dataType="N" format="Qty" width="100">
          <text v="Số lượng" e="Quantity"></text>
        </field>
        <field name="t_tt" dataType="N" format="FCPrice" width="100">
          <text v="Tiền vận chuyển" e="FC Price"></text>
        </field>
              

        <field name="unit_id" dataType="I" hidden="true" width="100" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="id" dataType="I" hidden="true" width="100" >
          <text v="ID" e="ID"></text>
        </field>
        <field name="ma_ct" width="100" hidden="true">
          <text v="Mã chứng từ" e="VC Code"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
  <script>
    <processing>
      <text>
        <![CDATA[<enc>QyHkmYaoGbKQhDmul2p2+G/MJFnlFwyWhIJFMDMbiRHva1WHT9V7H0VflvAwll3pTECTvFJhm4qbGrWG8Sl8MDsalodfnwUf6BDUoT+DNMMR0wQiO9KyT9Ra+GJZWz7DCFHzSlHl3XOee6H7AR6ZgWHdrPpXD8Pftll619kbKC8=</enc>]]>
      </text>
    </processing>
  </script>
</dir>