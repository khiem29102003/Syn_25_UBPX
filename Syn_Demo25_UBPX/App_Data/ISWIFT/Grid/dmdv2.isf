<dir id="dmdv2" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục dịch vụ" e="List of services"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmdv2" fieldKey="ma_dv" order="ma_dv" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_dv" fieldType="PK" width="120">
          <text v="Mã dịch vụ" e="Services code"></text>
        </field>
        <field name="ten_dv" width="250">
          <text v="Tên dịch vụ" e="Services name"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

