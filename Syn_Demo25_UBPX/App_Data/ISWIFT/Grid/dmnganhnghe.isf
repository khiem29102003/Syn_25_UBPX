<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmnganhnghe" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục ngành nghề" e="Occupation List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmnganhnghe" fieldKey="ma_nganhnghe" order="ma_nganhnghe desc" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_nganhnghe" fieldType="PK" width="120">
          <text v="Mã ngành nghề" e="Occupation Code"></text>
        </field>
        <field name="ten_nganhnghe" width="250">
          <text v="Tên ngành nghề" e="Occupation Name "></text>
        </field>
		<field name="ten_nganhnghe2" width="250">
          <text v="Tên tiếng anh" e="English name "></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_tt, ten_tt%l from dmttsd where status = 1">
            </options>
          </viewInfo>
        </field>
      </fields>

      &DefaultButton;
