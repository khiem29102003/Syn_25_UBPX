<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridFinding.xml">
]>

<dir id="dmdtcntd" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách cán bộ công khai số điện thoại tiếp dân" e="Public List of Officials' Citizen Reception Contact Numbers"></title>
  <subtitle v="Xem, sửa dữ liệu..." e="View, update data..."></subtitle>
  <grids>
    <grid table="dmdtcntd" fieldKey="ma_nv, dien_thoai" order="ma_nv, dien_thoai" allowFilter="true" allowOrder="true" >
      <fields>	
		<field name="ma_nv" width="120" fieldType="PK">
          <text v="Mã nhân viên" e="Employee Code"></text>
        </field>
		<field name="ho_ten" width="200">
          <text v="Mã nhân viên" e="Employee Code"></text>
        </field>
		<field name="ma_pb" width="120">
          <text v="Mã phòng ban" e="Department Code"></text>
        </field>
		<field name="ma_bp" width="120">
          <text v="Mã bộ phận" e="Section Code"></text>
        </field>
		<field name="ma_cv" width="120">
          <text v="Mã chức vụ" e="Duty Code"></text>
        </field>
		<field name="ma_ttp" width="120">
          <text v="Mã tỉnh thành" e="Province/City Code"></text>
        </field>
		<field name="ma_phuongxa" width="120">
          <text v="Mã phường xã" e="Ward/Commune Code"></text>
        </field>
		<field name="ma_loai" width="150">
          <text v="Mã loại" e="Type Code"></text>
        </field>
		<field name="dien_thoai" width="150" align="right" fieldType="PK">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="ghi_chu" width="150" align="right">
          <text v="Ghi chú" e="Note"></text>
        </field>
		<field name="status" viewType="Combobox" width ="150" valueDefault="1">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_tt, ten_tt%l from dmttsd where status = 1 order by ma_tt">
            </options>
          </viewInfo>
        </field>
      </fields>
	  
&DefaultButton;
