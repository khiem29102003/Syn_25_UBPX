<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmqhgd" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục quan hệ gia đình" e="List of Family Relationships"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmqhgd" fieldKey="ma_qh" order="ma_qh" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_qh" fieldType="PK" width="120">
          <text v="Mã quan hệ" e="Relationship Code"></text>
        </field>
        <field name="ten_qh" width="250">
          <text v="Tên quan hệ" e="Relationship Name"></text>
        </field>
		<field name="ten_qh2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

