<dir id="dmbp" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bộ phận" e="List of Subunit"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbp" fieldKey="ma_bp,ma_pb" order="ma_bp" allowFilter="true" allowOrder="true">
      <fields >
	  	<field name="ma_pb" width="0" fieldType="PK">
          <text v="Phòng" e="Department Code"></text>
        </field>
        <field name="ten_pb" width="250" fieldType="EX">
          <text v="Phòng ban" e="Department"></text>
        </field>
        <field name="ma_bp" width="120" fieldType="PK" >
          <text v="Mã bộ phận" e="Subunit Code"></text>
        </field>
        <field name="ten_bp" width="250">
          <text v="Tên bộ phận" e="Subunit Name"></text>
        </field>
		<field name="ten_bp2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="status" width="120" align="center">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;
