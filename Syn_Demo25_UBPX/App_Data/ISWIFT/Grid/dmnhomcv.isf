<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmnhomcv" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhóm chức vụ" e="List of position groups"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmnhomcv" fieldKey="ma_nhom" order="ma_nhom" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_nhom" fieldType="PK" width="120">
          <text v="Mã nhóm" e="Group code"></text>
        </field>
        <field name="ten_nhom" width="250">
          <text v="Tên nhóm" e="Group name"></text>
        </field>
		<field name="ten_nhom2" width="250">
          <text v="Tên khác" e="Other name"></text>
        </field>	
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

