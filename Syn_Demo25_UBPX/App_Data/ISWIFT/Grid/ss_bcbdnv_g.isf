<dir id="ss_bcbdnv" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo cáo biến động nhân viên nghỉ" e="Employee Turnover Report"></title>
  <subtitle v="Nhân viên nghỉ việc" e="Work end date"></subtitle>
  <grids>
    <grid>
      <fields>
	  	<field name="ma_dv" width="150" hidden="true">
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="ten_dv" width="150" hidden="false">
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="" width="150" hidden="true">
          <text v="Phòng ban" e="Department"></text>
        </field>
		<field name="ten_pb" width="150" hidden="false" >
          <text v="Phòng ban" e="Department"></text>
        </field>
		<field name="ma_bp" width="150" hidden="true">
          <text v="Bộ phận" e="Department"></text>
        </field>
		<field name="ten_bp" width="150" hidden="false">
          <text v="Bộ phận" e="Department"></text>
        </field>
		<field name="ma_cv" width="150" hidden="true">
          <text v="Bậc quản lý" e="Management level"></text>
        </field>
		<field name="ten_cv" width="150" hidden="false">
          <text v="Bậc quản lý" e="Management level"></text>
        </field>
		<field name="ma_vtcv" width="150" hidden="true">
          <text v="Vị trí công việc" e="Job Position"></text>
        </field> 
		<field name="ten_vtcv" width="150" hidden="false">
          <text v="Vị trí công việc" e=""></text>
        </field> 
		<field name="ma_nv" width="120" hidden="false">
          <text v="Mã nhân viên" e="Employee Code"></text>
        </field> 
		<field name="ten_nv" width="200" hidden="false">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field> 

		<field name="ngay_kt_lv" dataType="D" width="150" align="center" hidden="false">
          <text v="Ngày kết thúc làm việc" e="Work end date"></text>
        </field> 
		<field name="ly_do_nghi" width="250" hidden="false">
          <text v="Lý do nghỉ" e="Reason for leave"></text>
        </field> 
      </fields>
      &DefaultButton;
    </grid>
  </grids>

