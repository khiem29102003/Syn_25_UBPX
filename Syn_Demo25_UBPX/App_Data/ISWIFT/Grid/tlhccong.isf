<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="tlhccong" dirViewType="Grid" dirObjectType="Voucher" voucherCode="HC1" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thiết lập hành chính công" e="Public Administration Setup"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="tlhccong" fieldKey="id" order="ngay_ct desc" allowFilter="true" allowOrder="true">
      <fields>
        <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="100" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="so_ct" width="80" hidden="true"  >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>

        <field name="ma_hccong" width="150" hidden = "false">
          <text v="Mã hành chính công" e="Public Administration Code"></text>
        </field>
        <field name="ten_hccong" width="250" fieldType="EX" >
          <text v="Tên hành chính công" e="Public Administration Name"></text>
        </field>     
		<field name="stt_bd" dataType="N" format="0" width="120" >
          <text v="Số bắt đầu" e="Starting Number"></text>
        </field>
		<field name="stt_td" dataType="N" format="0" width="120" >
          <text v="Số tối đa" e="Maximum Number"></text>
        </field>
		<field name="tg_dukien" dataType="N" format="0" width="120" >
          <text v="Thời gian dự kiến (s)" e="Estimated time (s)"></text>
        </field>
		<field name="tg_trihoan" dataType="N" format="0" width="120" >
          <text v="Thời gian trì hoãn (s)" e="Delay time (s)"></text>
        </field>

		<field name="dien_giai" width="250">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;

      <script>
        <query>
          <text>
            <![CDATA[<enc>LYD75dCdQMdHYwRxBZzawIjXmyvrGnuoPtG1t9CXRI17QrkCLVP3FLX6iJtjaV+Uq/ngnn4Y7EGkvrWgbw4eIkvpWa4rKnmnbD9B+mUVagmKX5EUnj5lWzT3Vpyr6X22KGfaw7MhN0v2nQybcxAfGA96x5OFzr/5obGP/8DNqj7OgvwFVear2gYam37zOdhKtSZbP2e8RCbzFOn6N/J6uDZGMDx5VSj0I3yNQyZYN2alFQJHFBw/KepLx9s9QPlJYPNvx1UR7nZfOeXN4gNMMg==</enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>GYD0OC5JhpEhu2renQHOp9akR/6MbkWvGuvPK/+rbum6Cj1jougrUfnzbxNVaNg56EML0uNsVbic9FzJCwSGLcu9fpnjy4ATCUWbLZXFq2uXTkT8vx7KCVox27bDShISSkZVu41+3G0Ng9ryVib9XQfLsz2K7pdHt1jC9BZBe4JTLy3IKlv8B0dkNi3BrFOEdnYQ8w34WeTVE6u0zOTBSg==</enc>]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    &VoucherJSLoading;
  </script>
</dir>