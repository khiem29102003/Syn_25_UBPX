<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
   <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmkh" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục khách hàng" e="List of customer"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit..."></subtitle>
  <grids>
    <grid table="dmkh" fieldKey="ma_kh" order="ma_kh" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_kh" fieldType="PK" width="120" link="1">
          <text v="Mã khách hàng" e="Customer code"></text>
        </field>
        <field name="ten_kh" width="250">
          <text v="Tên khách hàng" e="Customer name"></text>
        </field>
		<field name="dia_chi" width="250">
          <text v="Địa chỉ" e="Adress"></text>
        </field>
        <field name="ma_so_thue" width="120">
          <text v="Mã số thuế" e="Tax code"></text>
        </field>
		<field name="home_page" width="250">
          <text v="Trang chủ " e="Home Page"></text>
        </field>
        <field name="kh_yn" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Khách hàng" e="Customer"></text>
        </field>
        <field name="ncc_yn" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Nhà cung cấp" e="Supplier"></text>
        </field>
		<field name="dl_yn" dataType="B" align="Center" width="100" allowOrder="false">
          <text v="Đại lý" e="Supplier"></text>
        </field>
		<field name="nguoi_lh" width="150">
          <text v="Người liên hệ" e="Contact Person"></text>
        </field>
		 <field name="ma_nvbh" width="100">
          <text v="Mã nhân viên bán hàng" e="Sales agent"></text>
        </field>
		<field name="ten_nvbh" width="250"  fieldType="EX">
          <text v="Tên nhân viên bán hàng" e="Sales agent"></text>
        </field>
		<field name="so_tk" width="120">
          <text v="Số tài khoản" e="Tax code"></text>
        </field>
		 <field name="ma_nh" width="0">
          <text v="Ngân hàng" e="Sales agent"></text>
        </field>
		<field name="ten_nh" fieldType="EX" width="200">
          <text v="Tên ngân hàng" e="Bank Name"></text>
        </field>
		<field name="tinh_thanh" width="150">
          <text v="Tỉnh thành" e="Province"></text>
        </field>
		
      </fields>
	  
		
	  &DefaultButton;
	   
  
      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  <css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    <request code="viewtree">
      <text>
        <![CDATA[<enc>g+KZ+QKBlC+LdD0jHhpbmdKmFxfI+e4PKr7RwKzYsIiaidO3HABMT5bB8MUttTPVMG2UgiB9E+jyMZVE7uGlZw==</enc>]]>
      </text>
