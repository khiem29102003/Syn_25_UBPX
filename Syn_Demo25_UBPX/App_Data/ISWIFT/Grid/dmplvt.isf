<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmplvt" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="hàng hóa phụ" e="Vehicle List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmplvt" fieldKey="ma_plvt" order="ma_plvt" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_plvt" fieldType="PK" width="120">
          <text v="Mã hàng hóa phụ" e="Product type code"></text>
        </field>
		<field name="ten_plvt" width="120">
          <text v="Tên hàng hóa phụ" e="Product type name"></text>
        </field>
		<field name="ten_plvt2"  width="120">
          <text v="Alias" e="Alias"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
		<field name="thu_tu" width="250">
          <text v="Thứ tự" e="Position"></text>
        </field>
		<field name="ma_clvt" width="250">
          <text v="Khóa tham chiếu" e="Reference key"></text>
        </field>
		 
      </fields>

      &DefaultButton;

    </grid>
  </grids>

