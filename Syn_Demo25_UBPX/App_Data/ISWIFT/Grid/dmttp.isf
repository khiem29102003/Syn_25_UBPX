<dir id="dmttp" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục quê quán" e="List of Hometown"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmttp" fieldKey="ma_ttp" order="ma_ttp" allowFilter="true" allowOrder="true">
