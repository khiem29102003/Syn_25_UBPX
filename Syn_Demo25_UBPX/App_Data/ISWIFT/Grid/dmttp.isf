        <field name="ma_ttp" fieldType="PK" width="120">
          <text v="Mã Quê quán" e="Hometown Code"></text>
        </field>
        <field name="ten_ttp" width="250">
          <text v="Tên Quê quán" e="Hometown name "></text>
        </field>
		<field name="ten_ttp2" width="250">
          <text v="Tên Quê quán (en)" e="Hometown name "></text>
        </field>
		<field name="full_name" width="250">
          <text v="Tên đẩy đủ" e="Full name "></text>
        </field>
		<field name="ma_qg" width="120" >
          <text v="Quốc gia" e="Full name "></text>
        </field>
		<field name="ten_qg" width="250"  hidden="true" fieldType="EX" >
          <text v="Quốc gia" e="Full name "></text>
        </field>
      </fields>

