<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridReport.xml">
]>

<dir id="bctthd" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo cáo tình trạng hóa đơn" e="Invoice Status Report"></title>
  <subtitle v="Từ ngày {ngay_ct1} đến ngày {ngay_ct2}, Trạng thái: {ten_ttct}..." e="From {ngay_ct1} To {ngay_ct2}, Status: {ten_ttct}..."></subtitle>
  <grids>
    <grid>
      <fields>
        <field name="ma_unit" width="80">
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="ngay_ct" width="100" dataType="D" align="Center">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="so_ct" width="100" link="V" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ma_kh" width="100">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ten_kh" width="350">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
        <field name="ten_ttct" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
        <field name="ma_vt" width="100">
          <text v="Mã hàng hóa" e="Goods Code"></text>
        </field>
        <field name="ten_vt" width="350">
          <text v="Tên hàng hóa" e="Goods Name"></text>
        </field>
        <field name="sl_hd" dataType="N" format="Qty" width="100">
          <text v="Sl hóa đơn" e="Qty. Invoiced"></text>
        </field>
        <field name="sl_xuat" dataType="N" format="Qty" width="100">
          <text v="Sl đã xuất" e="Qty. Issued"></text>
        </field>
        <field name="sl_cl" dataType="N" format="Qty" width="100">
          <text v="Sl còn lại" e="Qty. Remaining"></text>
        </field>
        <field name="id" dataType="I" hidden="true" width="100" >
          <text v="ID" e="ID"></text>
        </field>
        <field name="ma_ct" width="100" hidden="true">
          <text v="Mã chứng từ" e="VC Code"></text>
        </field>
      </fields>

      &DefaultButton;
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>RpbzP+PqStLO2tPhVZO/o2AdTlQ3mIF8CyWthCFvpi1ci2wChUmPWsKz20y1C3eIbulnJuNkPZz4bYkylfZgiqCRkbuFQqHQkQ6Ehon378q/Hzd1kkakFUIU+/MPbsYuw570rtlrg/yE8380a+0qgFQp7/jIgTSP1mfWYS6jmoU8hGOZoz7V8jdz3B4D/x/j+Bz5OSHPHq6pBUk+dvNFv2qrLTD8qFqerMBFbsVnDKCnLPD0JaiQK3THHvKjo3b6</enc>]]>
    </text>
  </js>
   <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
</dir>