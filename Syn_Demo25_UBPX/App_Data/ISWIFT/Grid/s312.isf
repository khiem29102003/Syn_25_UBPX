<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucherNotPrint.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="s312" dirViewType="Grid" dirObjectType="Voucher" voucherCode="BN2" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Cước vận chuyển quốc tế hàng biển LCL" e="LCL International Sea Freight"></title>
  <subtitle v="Thêm, sửa, xóa..." e="New, Edit, Delete..."></subtitle>

  <grids>
    <grid table="s312" fieldKey="id" order="id desc" allowFilter="true" allowOrder="true">
      <fields>
		<field name="so_ct" width="100" >
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D">
          <text v="Ngày c/từ" e="Voucher Date"></text>
        </field>
        <field name="ma_kh" width="0" hidden = "false">
          <text v="Mã hãng tàu / đại lý" e="Carrier/ Agent Code"></text>
        </field>
		<field name="ma_phi" width="100" hidden="false">
          <text v="Mã phí" e="Fee code"></text>
        </field>
        <field name="ten_kh" width="250" fieldType="EX" >
          <text v="Tên hãng tàu / Đại lý" e="Carrier/ Agent Name"></text>
        </field>     
		<field name="ma_noi_di" width="0" hidden="false">
          <text v="Nơi đi" e="Origin"></text>
        </field>
		<field name="ten_noi_di" width="250" fieldType="EX">
		  <text v="Nơi đi" e="Origin"></text>
		</field>
		<field name="ngay_hl" width="120" dataType="D">
          <text v="Ngày hiệu lực" e="Effective date"></text>
        </field>
		<field name="ngay_hld" width="120" dataType="D">
          <text v="Ngày hiệu lực đến" e="Expiry date"></text>
        </field>
		<field name="ma_nt" width="100" >
          <text v="Ngoại tệ" e="Currency"></text>
        </field>
        <field name="t_tt" dataType="N" format="FCAmount" width="100">
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
		<field name="t_ban" dataType="N" format="FCAmount" width="100">
          <text v="Tổng bán" e="Total Sales"></text>
        </field>
		<field name="dien_giai" width="250">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="100" fieldType="EX" >
          <text v="Đơn vị" e="Unit Name"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>

      &DefaultButton;


      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>

          </text>
        </query>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc>B3vwoV4prYvzOacbKQoWC53R/LFOlNuZjb7v9RQjlAiiQzOQYw2rLl55X8rZYQ4qSQr1GO+XgcWb+HHEL4VEDnJp4er6tVvCBS97oCi5G9tIvLDGBE/++mnoXU7GA7CIM2gzZWfHSqVHKn9rbbylONW7IsipGfbaWuUnQKU2/djIygz4ye0A14JLoQKkEtwi9ikefbs5DVgpX6cVhZHwNQ==</enc>]]>
    </text>
  </js>
<css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    &VoucherJSLoading;
  </script>
</dir>