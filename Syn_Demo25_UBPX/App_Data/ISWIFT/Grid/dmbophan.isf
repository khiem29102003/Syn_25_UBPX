<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmbophan" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bộ phận" e="Department List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmbophan" fieldKey="ma_bp" order="ma_bp" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_bp" fieldType="PK" width="120">
          <text v="Mã bộ phận" e="Department code"></text>
        </field>
        <field name="ten_bp" width="250">
          <text v="Tên bộ phận" e="Department name"></text>
        </field>
		<field name="ten_bp2" width="250">
          <text v="Tên tiếng anh" e="English name"></text>
        </field>
		<field name="status" width="250">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
