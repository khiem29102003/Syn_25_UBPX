<dir id="dmloaixe" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục loại xe" e="Vehicle Type List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid id="0" table="dmloaixe" fieldKey="ma_loai" order="ma_loai" allowFilter="true" allowOrder="true" >
