        <field name="ma_loai" fieldType="PK" width="120">
          <text v="Mã loại xe" e="Vehicle type code"></text>
        </field>
		 <field name="ten_loai" fieldType="PK" width="120">
          <text v="Tên loại xe" e="Vehicle type name"></text>
        </field>
        <field name="status" width="250">
          <text v="Trạng thái" e="Status"></text>
        </field>
      </fields>

      &DefaultButton;

    </grid>
  </grids>

