<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="qlcuochopApprove" dirViewType="Grid" selectMultiple="Table" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Xác nhận đồng ý họp" e="Approve proposals"></title>
  <subtitle v="Xử lý &lt;b&gt;%s&lt;/b&gt; họp" e="&lt;b&gt;%s&lt;/b&gt; meeting"></subtitle>

  <grids>
    <grid table="qlcuochop" fieldKey="ma_cuochop" order="ngay_hop desc" allowFilter="true" allowOrder="true" >
      <fields>
	  	<field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="ma_unit" width="100" fieldType="EX" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="ngay_hop" dataType="D" width="120">
		  <text v="Ngày họp" e="Issue Date"></text>
		</field>
		<field name="thoi_gian" width="120" fieldType="EX">
          <text v="Thời gian" e="Time"></text>
        </field>
	  	<field name="ma_cuochop" width="120" fieldType="PK">
		  <text v="Mã cuộc họp" e="Meeting Code"></text>
		</field>
		<field name="ten_cuochop" width="250">
		  <text v="Tên cuộc họp" e="Meeting Name"></text>
		</field>
		<field name="ten_cuochop2" width="0">
		  <text v="Tên tiếng anh" e="English Name"></text>
		</field>
		
		<field name="ma_lcuochop" width="120">
		  <text v="Mã loại cuộc họp" e="Meeting Type Code"></text>
		</field>
		<field name="ten_lcuochop" width="200" fieldType="EX">
          <text v="Loại cuộc họp" e="Meeting Type"></text>
        </field>
		<field name="dia_chi" width="250">
			<text v="Địa điểm" e="Location"></text>
        </field>
		<field name="linkweb" width="200">
          <text v="Link Website" e="Link Website"></text>
        </field>
		
		<field name="ds_chutri" width="250">
          <text v="Chủ trì" e="Chairperson"></text>
        </field>
		<field name="ds_nguoithamgia" width="300">
          <text v="Danh sách người tham gia" e="Participants List"></text>
        </field>
		
		<field name="status" viewType="Combobox" inactivate="true" width="150">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_tt, ten_tt%l from dmttsd where status = 1">
            </options>
          </viewInfo>
        </field>
      </fields>

      <buttons>
        <button id="approve">
          <text v="Duyệt" e="Approve"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="find">
          <text v="$FindToolbar" e="$FindToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>

        <finding>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </finding>
      </script>

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  <css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
  <script>
    <request code="Approve" transaction="true">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>

    &VoucherJSLoading;
  </script>

  <messages>
    <message val="msg1">
      <text v="Bạn có chắc chắn sẽ &lt;b&gt;đồng ý&lt;/b&gt; các cuộc họp được chọn không?" e=""/>
    </message>
    <message val="msg2">
      <text v="Bạn có chắc chắn sẽ &lt;b&gt;bỏ xác nhận&lt;/b&gt; các cuộc họp được chọn trở về trạng thái [Chờ xác nhận] không?" e=""/>
    </message>

    <message val="approve">
      <text v="Xác nhận" e="Confirm"/>
    </message>
    <message val="undo">
      <text v="Bỏ xác nhận" e="Cancel confirmation "/>
    </message>

  </messages>
</dir>