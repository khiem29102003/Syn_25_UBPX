<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="dmclvt" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Loại sản phẩm" e="Vehicle List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmclvt" fieldKey="ma_clvt" order="ma_clvt" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_clvt" fieldType="PK" width="120">
          <text v="Mã loại sản phẩm" e="Product type code"></text>
        </field>
		<field name="ten_clvt" width="120">
          <text v="Tên loại sản phẩm" e="Product type name"></text>
        </field>
		<field name="ten_clvt2"  width="120">
          <text v="Alias" e="Alias"></text>
        </field>
		<field name="status" width="120">
          <text v="Trạng thái" e="Status"></text>
        </field>
		<field name="thu_tu" width="250">
          <text v="Thứ tự" e="Position"></text>
        </field>
		 
      </fields>

      &DefaultButton;

    </grid>
  </grids>

