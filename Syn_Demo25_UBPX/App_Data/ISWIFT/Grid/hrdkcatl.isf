  <messages>
    <message val="noChange">
      <text v="Không có dữ liệu thay đổi" e="No Data Changed" />
    </message>
    <message val="inValidShift">
      <text v="Mã ca không đúng hoặc không tồn tại trong danh mục" e="Invalid Shift" />
    </message>
