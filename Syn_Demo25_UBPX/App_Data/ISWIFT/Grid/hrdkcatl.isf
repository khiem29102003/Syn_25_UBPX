<?xml version="1.0" encoding="utf-8"?>

<dir id="hrdkcatl" dirViewType="Grid" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Đăng ký ca/nhóm ca cho nhân viên" e=""></title>
  <subtitle v="Từ ngày {ngay_tu} đến {ngay_den}..." e="From {ngay_tu} To {ngay_den}..."></subtitle>
  <grids>
    <grid readOnly="false">
      <fields>
				<field name="id" dataType="N" fieldType="PK" format="0" hidden="true">
					<text v="" e=""></text>
				</field>
				<field name="ma_nv" width="120" inactivate="true" >
					<text v="Mã nhân viên" e="Employee ID"></text>
				</field>
				<field name="ho_ten_nv" width="250" inactivate="true">
					<text v="Tên nhân viên" e="Employee Name"></text>
				</field>
        <field name="ma_bp" width="120" inactivate="true">
          <text v="Mã bộ phận" e="Department"></text>
        </field>
        <field name="ca" format="U" width="50" viewType="Lookup" readOnly="false" >
          <text v="Ca" e=""></text>
          <viewInfo lookupType="One" lookupId="vhrdmca" lookupKey="status=1" lookupExactValue="1"/>
        </field>
      </fields>

      <buttons>
        <button id="save">
          <text v="$SaveToolbar" e="$SaveToolbar"></text>
        </button>
				<button id="MultiAdd">
					<text v="Đăng ký nhanh" e=""></text>
				</button>
				<button id="Copy">
					<text v="Sao chép" e=""></text>
				</button>
        <button id="find">
          <text v="$FindToolbar" e="$FindToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="export">
          <text v="$ExportToolbar" e="$ExportToolbar"></text>
        </button>
      </buttons>
    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
<css>
    <text>
		<![CDATA[<enc></enc>]]>
    </text>
  </css>
  <script>
    <request code="Save" transaction="true">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>

  </script>
