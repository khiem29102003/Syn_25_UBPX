<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGrid.xml">
]>

<dir id="vdmthue" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục thuế" e="VAT List"></title>
  <subtitle v="Thêm, xóa, sửa..." e="New, delete, edit"></subtitle>
  <grids>
    <grid table="dmthue" fieldKey="ma_thue" order="ma_thue" allowFilter="true" allowOrder="true">
      <fields >
        <field name="ma_thue" fieldType="PK" width="120">
          <text v="Mã thuế" e="VAT Code"></text>
        </field>
        <field name="ten_thue" width="250">
          <text v="Tên thuế" e="Description"></text>
        </field>
		
		<field name="ma_loai" width="100">
          <text v="Mã loại thuế" e="VAT Type"></text>
        </field>
		
		 <field name="ten_loai" width="300">
          <text v="Tên loại thuế" e="VAT Type Names"></text>
        </field>
		
      </fields>

      &DefaultButton;

    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[
function grid$dmthue(f){
  this.constructor(f);
}
grid$dmthue.prototype = new DirEvent();
grid$dmthue.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
</dir>