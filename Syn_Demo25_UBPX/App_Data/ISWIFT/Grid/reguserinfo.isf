<?xml version="1.0" encoding="utf-8"?>

<dir id="reguserinfo" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo người sử dụng" e="User Maintenance"></title>
  <subtitle v="Thêm, sửa, phân quyền người sử dụng..." e="New, edit user..."></subtitle>
  <grids>
    <grid id="0" table="reguserinfo" fieldKey="user_id" order="user_id" allowFilter="true" allowOrder="true" key="(@@admin = 1 or user_id = @@userId)" >
      <fields>
        <field name="user_id" fieldType="PK" dataType="N" align="Right" width="40" filterType="Code" aliasName="a">
          <text v="ID" e="ID"></text>
        </field>
        <field name="username" width="120" filterType="Code" aliasName="a">
          <text v="Tên" e="Name"></text>
        </field>
		<field name="ma_so_thue" width="120" aliasName="a" hidden="false">
          <text v="Mã số thuế" e="Fullname"></text>
        </field>
        <field name="nickname" width="250" aliasName="a" hidden="true">
          <text v="Tên đầy đủ" e="Fullname"></text>
        </field>
		<field name="company" width="250" aliasName="a">
          <text v="Công ty" e="Fullname"></text>
        </field>
		<field name="phone" width="300" aliasName="a">
          <text v="Số điện thoại" e="Fullname"></text>
        </field>
		<field name="type_member" width="0" aliasName="a" hidden="true">
          <text v="Loại thành viên" e="Fullname"></text>
        </field>
		<field name="ten_type" width="250" fieldType="EX">
          <text v="Loại thành viên" e="Fullname"></text>
        </field>
        <field name="parent_user" hidden="true" dataType="N" align="Right" width="40" filterType="Code">
          <text v="ID" e="ID"></text>
        </field>
        <field name="parent_username" width="120" aliasName="b.username as " fieldType="EX" hidden="true">
          <text v="Cấp trên" e="Cấp trên"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="Thêm (Alt + N)" e="Add (Alt + N)"></text>
        </button>
        <button id="edit">
          <text v="Sửa (Ctrl + E, Alt + E)" e="Edit (Ctrl + E, Alt + E)"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="permission">
          <text v="Phân quyền" e="Permission"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="Làm tươi" e="Refresh"></text>
        </button>
        <button id="freeze">
          <text v="Gim cột" e="Freeze"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>


    </grid>
  </grids>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>


  <script>
