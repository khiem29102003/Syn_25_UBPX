<dir id="dmgplx" dirViewType="Grid" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo giấy phép lái xe" e="Declare a driver's license"></title>
  <grids>
    <grid table="dmgplx" fieldKey="ma_tx" order="ma_tx" allowFilter="true" allowOrder="true" >
      <fields >
        <field name="ma_tx" fieldType="PK" width="120" >
          <text v="Tài xế" e="Driver Code"></text>
        </field>
        <field name="ten_tx" width="250" fieldType="EX" aliasName="b">
          <text v="Tên tài xế" e="Driver Name"></text>
        </field>
	    <field name="so_gplx" width="120" >
          <text v="Số GPLX" e="Driver's license number"></text>
        </field>
        <field name="ngay_thi" fieldType="PK" width="120" dataType="D">
          <text v="Ngày thi" e="Exam Date"></text>
        </field>
		 <field name="ngay_hh" fieldType="PK" width="120" dataType="D">
          <text v="Ngày hết hạn" e="Date"></text>
        </field>
        
      </fields>

