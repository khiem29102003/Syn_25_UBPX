<dir id="n14Approve" dirViewType="Grid" selectMultiple="Table" voucherCode="CL0" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Duyệt đăng ký công" e="Approve a training request form"></title>
  <subtitle v="Xử lý &lt;b&gt;%s&lt;/b&gt; phiếu yêu cầu đào tạo" e="&lt;b&gt;%s&lt;/b&gt; training request form"></subtitle>

  <grids>
    <grid table="n14" fieldKey="id" order="id desc" key="xstatus in (0,1)" allowFilter="true" allowOrder="true">
      <fields>
		<field name="ma_unit" width="100" fieldType="EX" align="center" >
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" width="100">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
		 <field name="ma_bp" fieldType="PK" hidden="false" width="100" align="center">
          <text v="Nhóm" e=""></text>
        </field>
		<field name="ngay_hl"  dataType="D"  width="150">
          <text v="Ngày hiệu lực" e="Effective date"></text>
        </field>

		<field name="so_ct" width="120" hidden="true">
          <text v="Số c/từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct" width="120" dataType="D" hidden="true">
          <text v="Ngày hiệu lực" e="Voucher Date"></text>
        </field>
		<field name="unit_id" hidden="true" dataType="I" width="120" >
          <text v="Unit ID" e="Unit ID"></text>
        </field>
        <field name="id" fieldType="PK" hidden="true" width="120">
          <text v="" e=""></text>
        </field>
      </fields>

      <buttons>
        <button id="approve">
          <text v="Duyệt" e="Approve"></text>
        </button>
        <button id="cancel">
          <text v="Hủy" e="Close"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="find">
          <text v="$FindToolbar" e="$FindToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="refresh">
          <text v="$RefreshToolbar" e="$RefreshToolbar"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
