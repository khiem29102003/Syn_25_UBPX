<?xml version="1.0" encoding="utf-8"?>

<dir id="dmcong" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục container" e="Container type list"></title>
  <grids>
    <grid table="dmcong" fieldKey="ma_cong" fieldName="ten_cong" order="datetime0,datetime2" allowFilter="true" allowOrder="true" key="" >
      <fields join="">
		<field name="ma_cong" fieldType="PK" width="120" filterType="Code" >
          <text v="Mã container" e="Container code"></text>
        </field>
        <field name="ten_cong" width="250">
          <text v="Tên container" e="Container name"></text>
        </field>
		 <field name="ma_loai" width="120">
          <text v="Loại" e="Type code"></text>
        </field>
		<field name="ten_loai" width="250" fieldType="EX">
          <text v="Loại container" e="Container type"></text>
        </field>
		<field name="datetime0" label="1" field="1" dataType="D" allowBlank="true" >
			<text v="Ngày hiệu lực " e="Effective date"></text>
		</field>
		<field name="datetime2" label="1" field="1" dataType="D" allowBlank="true" >
			<text v="Ngày hiệu lực " e="Effective date"></text>
		</field>
      </fields>
	  	<script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>
</dir>