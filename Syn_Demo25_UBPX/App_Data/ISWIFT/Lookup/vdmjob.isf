<?xml version="1.0" encoding="utf-8"?>

<dir id="vdmjob" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục Job" e="List of voucher"></title>
  <grids>
    <grid table="vdmjob" fieldKey="ma_job" fieldName="ten_job" order="ma_job" allowFilter="true" allowOrder="true" key="" >
      <fields join="">
        <field name="ma_job" fieldType="PK" width="120" filterType="Code" >
          <text v="Mã Job" e="Voucher code"></text>
        </field>
        <field name="ten_job" width="250">
          <text v="Tên Job" e="Voucher name"></text>
        </field>
      </fields>
    </grid>
  </grids>
</dir>