<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonGridVoucher.xml">
]>

<dir id="wfdmkh" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách cấu hình workflow" e="Workflow Configuration List"></title>

  <grids>
    <grid table="wfdmkh" fieldKey="id" fieldName="ma_wf" order="ngay_ct" allowFilter="true" allowOrder="true">
      <fields>
        <field name="id" dataType="N" fieldType="PK" width="80" format="0" filterType="Code">
          <text v="ID" e="ID"></text>
        </field>
		<field name="ma_wf" width="100" hidden="false" >
          <text v="Mã worfkflow" e="Worfkflow Code"></text>
        </field>
		<field name="ds_ntask" width="250" fieldType="EX">
          <text v="D/s nhóm công việc" e="Explain"></text>
        </field>
        <field name="ngay_ct" width="80" dataType="D">
          <text v="Ngày c/từ" e="Voucher date"></text>
        </field>
        <field name="dien_giai" width="250" >
          <text v="Diễn giải" e="Explain"></text>
        </field>
      </fields>
      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>
</dir>