<?xml version="1.0" encoding="utf-8"?>

<dir id="dmhaiquan" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hải quan" e="List of Customs"></title>
  <grids>
    <grid table="dmhaiquan" fieldKey="ma_hq" fieldName="ten_hq" order="ma_hq" allowFilter="true" allowOrder="true" key="" >
      <fields join="">
        <field name="ma_hq" fieldType="PK" width="100" filterType="Code" >
          <text v="Mã hải quan" e="Customs Code"></text>
        </field>
        <field name="ten_hq" width="250">
          <text v="Tên hải quan" e="Customs Name"></text>
        </field>
		<field name="ten_hq2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="ten_cd" width="250">
          <text v="Tên chức danh" e="Position Title"></text>
        </field>
      </fields>
	  <script>
		<query>
		  <text>
			<![CDATA[<enc></enc>]]>
		  </text>
		</query>
	  </script>
    </grid>
  </grids>
</dir>