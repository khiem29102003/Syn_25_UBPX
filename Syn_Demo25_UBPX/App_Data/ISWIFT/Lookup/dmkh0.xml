	  <script>
        <query>
          <text>
            <![CDATA[
declare @key2 nvarchar(3000)
select @key2 = @lookupKey + case when @val = '' then '' else ' and (@@fieldKey like N''%' + dbo.ISWIFTFunctionReplaceSQLValue(@val) + '%'' or @@fieldName like N''%' + dbo.ISWIFTFunctionReplaceSQLValue(@val) + '%'')' end
exec ISWIFTStoreTableLoading '@@table', '@@fieldKey', '@@fields', @@fieldOrder, '', '', 'left join dmnh b on a.nh_kh1 = b.ma_nh and b.ma_loai_nh =''KH1'' left join dmnh c on a.nh_kh2 = c.ma_nh and c.ma_loai_nh = ''KH2'' left join dmnh d on a.nh_kh3 = d.ma_nh and d.ma_loai_nh =''KH3'' ', 'b.ten_nh ten_nh_kh1, c.ten_nh ten_nh_kh2, d.ten_nh ten_nh_kh3', N'@@key', @key2, @@filterKey, '', @pageIndex, 10, @@admin, @@userId
         ]]>
          </text>
        </query>
      </script>
