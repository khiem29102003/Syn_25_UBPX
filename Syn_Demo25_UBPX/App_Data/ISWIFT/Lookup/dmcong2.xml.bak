<?xml version="1.0" encoding="utf-8"?>

<dir id="dmcong" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục container" e="Container Type List"></title>
  <grids>
    <grid table="dmcong" fieldKey="ma_cong" fieldName="ten_cong" order="ma_loai,ma_cong" allowFilter="true" allowOrder="true" key="" >
      <fields join="">
        <field name="ma_cong" fieldType="PK" width="150" filterType="Code" >
          <text v="Mã container" e="Container Code"></text>
        </field>
        <field name="ten_cong" width="250">
          <text v="Tên container" e="Container Type Name"></text>
        </field>
		 <field name="ma_loai" width="100">
          <text v="Loại container" e="Container Type"></text>
        </field>
      </fields>
    </grid>
  </grids>
</dir>