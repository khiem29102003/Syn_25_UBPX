        <field name="ten_tg" width="250">
          <text v="Tên tôn giáo" e="Religion Name"></text>
        </field>
		<field name="ten_tg2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
      </fields>
	  <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>
</dir>