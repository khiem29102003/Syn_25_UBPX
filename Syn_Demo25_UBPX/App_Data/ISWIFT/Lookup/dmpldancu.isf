<?xml version="1.0" encoding="utf-8"?>

<dir id="dmpldancu" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phân loại dân cư" e="Population Classification List"></title>
  <grids>
    <grid table="dmpldancu" fieldKey="ma_pl" fieldName="ten_pl" order="ma_pl" allowFilter="true" allowOrder="true">
