        <field name="ten_pl" width="300">
		  <text v="Tên phân loại dân cư" e="Population Classification Name"></text>
        </field>
		<field name="ten_pl2" width="300">
         <text v="Tên English" e="English Name"></text>
        </field>
      </fields>
	<script>
	<query>
	  <text>
		<![CDATA[<enc></enc>]]>
	  </text>
	</query>
	</script>
    </grid>
  </grids>
</dir>