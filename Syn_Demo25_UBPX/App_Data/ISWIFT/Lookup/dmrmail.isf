<?xml version="1.0" encoding="utf-8"?>

<dir id="dmrmail" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục mail" e="List of mail"></title>
  <grids>
    <grid table="dmrmail" fieldKey="r_mail" fieldName="ten_mail" order="r_mail" allowFilter="true" allowOrder="true" key="" >
      <fields>
        <field name="r_mail" fieldType="PK" width="120" filterType="Code" >
          <text v="Mã mail" e="mail Code"></text>
        </field>
        <field name="ten_mail" width="250">
          <text v="Tên mail" e="mail Name"></text>
        </field>     
		<field name="ten_mail2" width="250">
          <text v="Tên khác" e="Other Name"></text>
        </field>
      </fields>
	  <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>
</dir>