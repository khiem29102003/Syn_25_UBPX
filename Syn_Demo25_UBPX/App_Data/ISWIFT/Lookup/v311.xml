            <![CDATA[
declare @key2 nvarchar(3000)
select @key2 = @lookupKey + case when @val = '' then '' else ' and (@@fieldKey like N''' + dbo.ISWIFTFunctionReplaceSQLValue(@val) + '%'' or @@fieldName like N''' + dbo.ISWIFTFunctionReplaceSQLValue(@val) + '%'')' end
select @fieldOrder = 'id,line'
exec ISWIFTStoreTableLoadingQuote '@@table', '@@fieldKey', '@@fields', @fieldOrder, '', '', 'left join dmkh b on a.ma_kh = b.ma_kh left join dmphi c on a.ma_phi = c.ma_phi left join vdmcangdi e on a.ma_noi_di = e.ma_noi_di left join vdmcangden f on a.ma_noi_den = f.ma_noi_den', 'b.ten_kh,c.ten_phi,e.ten_noi_di,f.ten_noi_den', N'@@key', @key2, @@filterKey, '', @pageIndex, 10, @@admin, @@userId
