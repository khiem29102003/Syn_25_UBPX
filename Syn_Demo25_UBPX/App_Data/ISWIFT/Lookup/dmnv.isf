<?xml version="1.0" encoding="utf-8"?>

<dir id="dmnv" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhân sự" e="List of Employee"></title>
  <grids>
    <grid table="dmnv" fieldKey="ma_nv" fieldName="ten_nv" order="ma_nv" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="ma_nv" fieldType="PK" width="120" filterType="Code" >
          <text v="Mã nhân viên" e="Employee Code"></text>
        </field>
        <field name="ten_nv" width="250">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
		<field name="ma_pb" width="120">
          <text v="Mã phòng ban" e="Department Code"></text>
        </field>
		<field name="ten_pb" width="120" fieldType="EX">
          <text v="Phòng ban" e="Department"></text>
        </field>
		<field name="ma_bp" width="120">
          <text v="Bộ phận" e="Division Code"></text>
        </field>
		<field name="ten_bp" width="120" fieldType="EX">
          <text v="Bộ phận" e="Division"></text>
        </field>
      </fields>
	  <script>
        <query>
          <text> 	
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>
</dir>