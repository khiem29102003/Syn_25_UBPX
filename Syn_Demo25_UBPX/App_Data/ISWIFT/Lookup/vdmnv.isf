<?xml version="1.0" encoding="utf-8"?>

<dir id="vdmnv" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhân viên" e="Employee Directory"></title>
  <grids>
    <grid table="vdmnv" fieldKey="username" fieldName="nickname" order="username" allowFilter="true" allowOrder="true" >
      <fields>
        <field name="username" fieldType="PK" width="120" filterType="Code" >
          <text v="Mã nhân viên" e="Employee code"></text>
        </field>
        <field name="nickname" width="250">
          <text v="Tên nhân viên" e="Employee name"></text>
        </field>
		<field name="dien_thoai" width="250">
          <text v="Điện thoại" e="Telephone"></text>
        </field>
      </fields>
	  <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>
</dir>