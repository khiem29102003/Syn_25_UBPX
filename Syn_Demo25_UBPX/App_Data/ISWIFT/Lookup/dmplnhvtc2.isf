<?xml version="1.0" encoding="utf-8"?>

<dir id="dmplnhvtc2" dirViewType="Lookup" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhóm phân loại vật tư 2" e="Material Group Level 2"></title>
  <grids>
    <grid table="dmplnhvtc2" fieldKey="ma_nh" fieldName="ten_nh" order="ma_nh" allowFilter="true" allowOrder="true" key="unit_id in (select unit_id from dbo.ISWIFTFunctionGetUnitIDRight(@@userId, @@admin, ''''))" >
      <fields>
        <field name="ma_nh" fieldType="PK" width="120" filterType="Code" >
          <text v="Mã nhóm plvt 2" e="MGroup Code 2"></text>
        </field>
        <field name="ten_nh" width="250">
          <text v="Tên nhóm plvt 2" e="MGroup Name 2"></text>
        </field>
      </fields>
	  <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>
</dir>