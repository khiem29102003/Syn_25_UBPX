  <Code>Public Function JoinFieldValues(ByVal items As Object(), ByVal delimiter As String) As String
    Dim result As String = ""
    For Each item As Object In items
        ' Kiểm tra nếu item không null hoặc trống
        If Not IsNothing(item) AndAlso Not String.IsNullOrEmpty(item.ToString()) Then
            If Not String.IsNullOrEmpty(result) Then
                result += delimiter
            End If
            result += item.ToString()
        End If
    Next
    Return result
End Function

Public Function JoinFieldValues(ByVal items1 As Object(), ByVal items2 As Object(), ByVal delimiter As String) As String
    Dim result As String = ""
    Dim length As Integer = Math.Min(items1.Length, items2.Length)
    
    For i As Integer = 0 To length - 1
        If i &gt; 0 Then
            result += vbCrLf
        End If
        result += items1(i).ToString() &amp; delimiter &amp; items2(i).ToString()
    Next
    Return result
End Function

'Cộng chuỗi không trùng
Public Function FilterDistinct(ByVal items As Object(), ByVal delimiter As String) As String
    If items Is Nothing OrElse items.Length = 0 Then
        Return String.Empty
    End If

    Dim uniqueItems As New System.Collections.Generic.List(Of String)()
    For Each item As Object In items
        If item IsNot Nothing Then
            Dim itemStr As String = item.ToString()
            If Not uniqueItems.Contains(itemStr) Then
                uniqueItems.Add(itemStr)
            End If
        End If
    Next

    Return String.Join(delimiter, uniqueItems.ToArray())
End Function</Code>
