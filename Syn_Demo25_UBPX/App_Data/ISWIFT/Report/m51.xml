<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
select line as stt, a.ma_vt, b.ten_vt, b.ten_vt2, a.dvt, a.so_luong, a.gia_nt2 as gia2, a.tien_nt2 as tien2, a.tl_ck, a.thue_suat, a.ck, a.thue, c.t_tt, c.t_tien2, c.t_ck
  into #d51 from d51 a with(nolock) left join dmvt b on a.ma_vt = b.ma_vt 
									left join m51 c on a.id = c.id
									where a.id = @id

declare @t numeric(19, 5)
select @t = t_tt from #d51

select a.unit_id, a.so_ct, a.ma_kh, b.ten_kh, b.ten_kh2, b.dia_chi, d.ten_nvbh, d.dien_thoai, a.dien_giai, a.ma_nt, dbo.iswiftFunctionReadCurrency(a.ma_nt, @t) as t_tt_in_word
	  , replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct,
	  convert(char(10),a.ngay_hl,103) ngay_hl,e.ten_tt,a.ong_ba
	from m51 a with(nolock)
		left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
		left join dmnvbh d on a.ma_nvbh = d.ma_nvbh
		left join dmtt e on a.ma_tt = e.ma_tt
	where a.id = @id

select * from #d51
]]>
    </text>
  </query>

