<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.dvt, a.ten_dvt, a.ten_dvt2, a.ma_loai, b.ten_loai,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmdvt a with(nolock)
			left join dmloaidvt b on a.ma_loai = b.ma_loai
		where dvt = @dvt

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmdvt_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmdvt_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
    <field name="title" type="C">
      <text v="Thông tin đơn vị tính" e="Units Information"/>
    </field>
    <field name="h_dvt" type="C">
      <text v="Mã đơn vị:" e="Unit Code:"/>
    </field>
	<field name="h_ten_dvt" type="C">
      <text v="Tên đơn vị:" e="Unit Name:"/>
	</field>
	<field name="h_ten_dvt2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_ma_loai" type="C">
      <text v="Mã loại:" e="Type Code:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>