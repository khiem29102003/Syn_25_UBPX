<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_kien, a.ten_kien, a.ten_kien2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmkien a with(nolock)
		where ma_kien = @ma_kien

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmkien_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmkien_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
   	<field name="title" type="C">
      <text v="Thông tin kiện" e="Package Information"/>
    </field>
    <field name="h_ma_kien" type="C">
      <text v="Mã kiện:" e="Package Code:"/>
    </field>
	<field name="h_ten_kien" type="C">
      <text v="Tên kiện:" e="Package Name:"/>
	</field>
	<field name="h_ten_kien2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>