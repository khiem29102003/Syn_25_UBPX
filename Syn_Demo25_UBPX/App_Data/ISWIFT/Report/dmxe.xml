<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
		select a.ma_xe, a.ten_xe, a.ten_xe2, a.mau_son, a.tai_trong, a.so_may, a.so_khung, a.so_loai, a.dung_tich, a.nhan_hieu, a.ma_loai, a.unit_id,
			   convert(varchar(10),a.ngay_dk,103) ngay_dk ,
			   convert(varchar(10),a.han_dk,103) han_dk ,
		   	   IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			   from dmxe a with(nolock)
		where ma_xe = @ma_xe

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmxe_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmxe_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin xe" e="Vehicle Information"/>
    </field>
    <field name="h_ma_xe" type="C">
      <text v="Mã xe:" e="Vehicle Code:"/>
    </field>
	<field name="h_ten_xe" type="C">
      <text v="Tên xe:" e="Vehicle Name:"/>
	</field>
	<field name="h_ten_xe2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_mau_son" type="C">
      <text v="Màu sơn:" e="Color:"/>
	</field>
	<field name="h_tai_trong" type="C">
      <text v="Tải trọng:" e="Payload:"/>
	</field>
	<field name="h_so_may" type="C">
      <text v="Số máy:" e="Machine Number:"/>
	</field>
	<field name="h_so_khung" type="C">
      <text v="Số khung:" e="Frame Number:"/>
	</field>
	<field name="h_so_loai" type="C">
      <text v="Số loại:" e="Type No:"/>
	</field>
	<field name="h_dung_tich" type="C">
      <text v="Dung tích:" e="Volume:"/>
	</field>
	<field name="h_ngay_dk" type="C">
      <text v="Ngày đăng kí:" e="Date of Registration:"/>
	</field>
	<field name="h_han_dk" type="C">
      <text v="Hạn đăng kí:" e="Registration Deadline:"/>
	</field>
	<field name="h_nhan_hieu" type="C">
      <text v="Nhãn hiệu:" e="Brand:"/>
	</field>
	<field name="h_ma_loai" type="C">
      <text v="Mã loại:" e="Type Code:"/>
	</field>
	<field name="h_unit_id" type="C">
      <text v="Đơn vị:" e="Unit:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>
</report>