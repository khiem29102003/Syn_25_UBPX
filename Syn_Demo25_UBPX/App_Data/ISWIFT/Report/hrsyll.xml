<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
select a.id, a.ma_nv, rtrim(a.ho_nv) + ' ' + rtrim(a.ten_nv) as ho_ten, a.ngay_vao, a.ma_bp, a.ma_vtr, a.ngay_sinh, b.ten_bp, c.ten_vtr,
	case when a.gioi_tinh = 1 then dbo.ISWIFTStoredGetMessage('gt_nam', '') else dbo.ISWIFTStoredGetMessage('gt_nu', '') end as gioi_tinh, a.ngay_sinh, a.cmnd_so, a.cmnd_ngay_hl, d.ten_tinh as cmnd_noi_cap,
	a.dia_chi, a.dien_thoai_dd, a.email_cty, e.ten_tgiao as ton_giao
	from hrdmnv a left join hrdmbp b on a.ma_bp = b.ma_bp
		left join hrdmvtr c on a.ma_vtr = c.ma_vtr
		left join hrdmtinh d on a.cmnd_noi_cap = d.ma_tinh
		left join hrdmtgiao e on a.ma_tgiao = e.ma_tgiao
		where a.id in (15, 16, 32)

select a.id, a.ho_ten, a.ngay_sinh, a.ma_qh, b.ten_qh
	from hrettgd a left join hrdmqhgd b on a.ma_qh = b.ma_qh
	where a.id in (15, 16, 32)

select a.id, a.line, a.trinh_do, a.truong, a.chuyen_nganh, a.ngay_tot_nghiep, a.loai_tot_nghiep, b.ten_tdhv from hretdhv a left join hrdmtdhv b on a.trinh_do = b.ma_tdhv
  where a.id in (15, 16, 32)

select a.id, a.line, a.ngay_tu, a.ngay_den, a.so_quyet_dinh, a.ngay_quyet_dinh, b.ten_bp, c.ten_vtr, a.ghi_chu
	from hreqtct a left join hrdmbp b on a.ma_bp = b.ma_bp
	left join hrdmvtr c on a.ma_vtr = c.ma_vtr
	where a.id in (15, 16, 32)
]]>
    </text>
  </query>

