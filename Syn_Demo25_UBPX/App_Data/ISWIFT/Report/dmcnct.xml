<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_cnct, a.ten_cnct, a.ten_cnct2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmcnct a with(nolock)
		where ma_cnct = @ma_cnct

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmcnct_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmcnct_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
   	<field name="title" type="C">
      <text v="Thông tin chức năng chứng từ" e="Voucher Function Information"/>
    </field>
    <field name="h_ma_cnct" type="C">
      <text v="Mã chức năng:" e="Function Code:"/>
    </field>
	<field name="h_ten_cnct" type="C">
      <text v="Tên chức năng:" e="Function Name:"/>
	</field>
	<field name="h_ten_cnct2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>