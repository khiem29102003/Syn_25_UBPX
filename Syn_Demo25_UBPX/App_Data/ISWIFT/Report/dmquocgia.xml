<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_qg, a.ten_qg, a.ten_qg2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmquocgia a with(nolock)
		where ma_qg = @ma_qg

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmquocgia_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmquocgia_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin quốc gia" e="Country Information"/>
    </field>
    <field name="h_ma_qg" type="C">
      <text v="Mã quốc gia:" e="Country Code:"/>
    </field>
	<field name="h_ten_qg" type="C">
      <text v="Tên quốc gia:" e="Country Name:"/>
	</field>
	<field name="h_ten_qg2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>