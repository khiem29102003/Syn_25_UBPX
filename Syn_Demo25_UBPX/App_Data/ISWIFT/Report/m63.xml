<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
declare @t numeric(19, 5)
select a.unit_id, isnull(u.ma_so_thue, '') as ms_thue, a.so_ct, a.so_ct2 as ky_hieu, a.ma_kh, a.ong_ba as nguoi_mua_hang, b.ten_kh as ten_kh, B.dia_chi, b.ma_so_thue, b.dien_thoai,
		isnull(c.ten_tt, '') as ten_tt, a.ma_tt, a.dien_giai, isnull(d.ten_pttt, '') as ten_pttt, cast(a.status as char(1)) as status, a.ma_nt, 
		dbo.iswiftFunctionReadCurrency(a.ma_nt, a.t_tt) as t_tt_in_word,
	    replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year,
		a.ngay_ct, a.t_phi, a.t_tien_nt2, a.t_tt_nt, a.so_job, e.ten_bp, f.so_tk, f.book_no, f.mbl_no , f.hbl_no, f.dien_giai dien_giais, g.ten_kh ten_kh_s61 , h.ten_kh ten_nv, u.ten_unit
		into #m63 from m63 a with(nolock)
		left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
		left join dmtt c on a.ma_tt = c.ma_tt
		left join dmpttt d on a.ma_pttt = d.ma_pttt
		left join dmbp e on a.ma_bp = e.ma_bp
		left join s61 f on a.id_dh = f.id
		left join dmkh g on f.ma_kh = g.ma_kh 
		left join dmkh h on f.ma_nv = h.ma_kh
		left join sysunit u on a.unit_id = u.unit_id
		where a.id = @id
		select * from #m63
select line as stt, a.ma_vt, b.ten_vt, b.ten_vt2, a.tien2, a.ma_nt , a.tt, a.thue_suat, a.dvt
		into #d63 from d63 a with(nolock) 
		left join dmvt b with(nolock) on a.ma_vt = b.ma_vt
		where a.id = @id
		select * from #d63

--select a.unit_id, isnull(u.ma_so_thue, '') as ms_thue, a.so_ct, a.so_ct2 as ky_hieu, a.ma_kh, a.ong_ba as nguoi_mua_hang, b.ten_kh as ten_kh, B.dia_chi, b.ma_so_thue, b.dien_thoai, isnull(c.ten_tt, '') as ten_tt, a.ma_tt, a.dien_giai,
--		isnull(d.ten_pttt, '') as ten_pttt, cast(a.status as char(1)) as status, a.ma_nt, dbo.iswiftFunctionReadCurrency(a.ma_nt, a.t_tt_nt+a.t_phi) as t_tt_in_word
--	  , replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct,a.t_phi,a.t_tien_nt2,a.t_tt_nt,u.ten_unit
--		from m82 a with(nolock)
		drop table #m63, #d63


]]>
    </text>
  </query>

