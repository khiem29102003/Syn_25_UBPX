<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_xuatxu, a.ten_xuatxu, a.ten_xuatxu2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmxuatxu a with(nolock)
		where ma_xuatxu = @ma_xuatxu

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmxuatxu_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmxuatxu_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin xuất xứ" e="Country Information"/>
    </field>
    <field name="h_ma_xuatxu" type="C">
      <text v="Mã xuất xứ:" e="Country Code:"/>
    </field>
	<field name="h_ten_xuatxu" type="C">
      <text v="Tên xuất xứ:" e="Country Name:"/>
	</field>
	<field name="h_ten_xuatxu2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>