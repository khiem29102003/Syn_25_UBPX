	</field>
	<field name="h_phong_kd" type="C">
      <text v="Phòng kinh doanh " e="Sales Department: "/>
	</field>
	<field name="h_dien_thoai" type="C">
      <text v="Điên thoại: " e="Phone: "/>
	</field>
	<field name="h_fax" type="C">
      <text v="Fax: " e="Fax: "/>
	</field>
	
	
	
	<field name="h_nh_kh1" type="C">
      <text v="Nhóm 1: " e="Group 1: "/>
	</field>
	<field name="h_nh_kh2" type="C">
      <text v="Nhóm 2: " e="Group 2: "/>
	</field>
	<field name="h_nh_kh3" type="C">
