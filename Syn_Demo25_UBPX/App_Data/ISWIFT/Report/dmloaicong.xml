<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_loai, a.ten_loai, a.ten_loai2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmloaicong a with(nolock)
		where ma_loai = @ma_loai

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmloaicong_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmloaicong_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
   	<field name="title" type="C">
      <text v="Thông tin loại công" e="Container Type Information"/>
    </field>
    <field name="h_ma_loai" type="C">
      <text v="Mã loại:" e="Type Code:"/>
    </field>
	<field name="h_ten_loai" type="C">
      <text v="Tên loại:" e="Type Name:"/>
	</field>
	<field name="h_ten_loai2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>