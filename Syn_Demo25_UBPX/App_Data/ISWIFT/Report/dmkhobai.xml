<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_kho, a.ten_kho, a.ten_kho2,
				IIF(a.kkh_yn = 1, replace(a.kkh_yn,1,'x'), '') kkh_yn,
				IIF(a.hc_yn = 1, replace(a.hc_yn,1,'x'), '') hc_yn,
				IIF(a.hk_yn = 1, replace(a.hk_yn,1,'x'), '') hk_yn,
				IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmkhobai a with(nolock)
		where ma_kho = @ma_kho

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmkhobai_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmkhobai_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
   	<field name="title" type="C">
      <text v="Thông tin kho khách hàng" e="Warehouse Information"/>
    </field>
    <field name="h_ma_kho" type="C">
      <text v="Mã kho:" e="Warehouse Code:"/>
    </field>
	<field name="h_ten_kho" type="C">
      <text v="Tên kho:" e="Warehouse Name:"/>
	</field>
	<field name="h_ten_kho2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_kkh_yn" type="C">
      <text v="Kho khách hàng " e="Warehouse Customer"/>
	</field>
	<field name="h_hc_yn" type="C">
      <text v="Hải cảng " e="Port"/>
	</field>
	<field name="h_hk_yn" type="C">
      <text v="Cảng hàng không" e="Port Airlines"/>
	</field>
	<field name="h_ma_ttp" type="C">
      <text v="Khu vực " e="Area"/>
	</field>
	<field name="h_ma_qg" type="C">
      <text v="Quốc gia" e="Country"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>