<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_hq, a.ten_hq, a.ten_hq2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmhaiquan a with(nolock)
		where ma_hq = @ma_hq

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmhaiquan_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmhaiquan_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin hải quan" e="Customs Information"/>
    </field>
    <field name="h_ma_hq" type="C">
      <text v="Mã hải quan:" e="Customs Code:"/>
    </field>
	<field name="h_ten_hq" type="C">
      <text v="Tên hải quan:" e="Customs Name:"/>
	</field>
	<field name="h_ten_hq2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>