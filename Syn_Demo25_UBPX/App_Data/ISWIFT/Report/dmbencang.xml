<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_ben, a.ten_ben, a.ten_ben2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmbencang a with(nolock)
		where ma_ben = @ma_ben

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmbencang_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmbencang_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin bến cảng" e="Port Information"/>
    </field>
    <field name="h_ma_ben" type="C">
      <text v="Mã bến cảng:" e="Port Code:"/>
    </field>
	<field name="h_ten_ben" type="C">
      <text v="Tên bến cảng:" e="Port Name:"/>
	</field>
	<field name="h_ten_ben2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>