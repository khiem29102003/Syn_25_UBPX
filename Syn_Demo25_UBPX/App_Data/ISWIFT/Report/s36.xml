<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
select a.ma_noi_ct, b.ten_kho, b.ten_kho2, a.dvt, a.so_luong, a.gia_nt2 as gia2, a.tien_nt2 as tien2
  into #v331 from v331 a with(nolock) left join dmkhobai b on a.ma_noi_ct = b.ma_noi_ct where a.id = @id

declare @t numeric(19, 5)
select @t = sum(tien2) from #v331

select a.unit_id, a.so_ct, a.ma_kh, b.ten_kh, b.ten_kh2, b.dia_chi, d.ten_nvbh, a.dien_giai, a.ma_nt, dbo.iswiftFunctionReadCurrency(a.ma_nt, @t) as t_tt_in_word
	  , replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct,
	  convert(char(10),a.ngay_hl,103) ngay_hl,e.ten_tt,a.ong_ba
	from s361 a with(nolock)
		left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
		left join dmnvbh d on a.ma_nvbh = d.ma_nvbh
		left join dmtt e on a.ma_tt = e.ma_tt
	where a.id = @id

select * from #v331
]]>
    </text>
  </query>

  <forms>
    <form id="030" fileName="s361_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn" e="Standard Form"></text>
    </form>
	 <form id="040" fileName="s361_01" fileType="docx" exportExt="docx" image="xlsx">
      <text v="Mẫu chuẩn" e="Standard Form"></text>
    </form>
	 <form id="050" fileName="s361_01" fileType="rdlc" exportExt="xlsx" image="xlsx">
      <text v="Mẫu chuẩn" e="Standard Form"></text>
    </form>
  </forms>

