<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
select a.unit_id, isnull(u.ma_so_thue, '') as ms_thue, a.so_ct, a.so_ct2 as ky_hieu,  a.ong_ba as nguoi_mua_hang,  a.dia_chi, isnull(c.ten_tt, '') as ten_tt, a.ma_tt, a.dien_giai,
	 cast(a.status as char(1)) as status, a.ma_nt, dbo.iswiftFunctionReadCurrency(a.ma_nt, a.t_tien_nt) as t_tt_in_word, isnull(t_tien_nt,0) t_tien_nt
	  , replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct,
	  d.ma_kh, e.ten_kh, a.ma_job + a.so_job ma_so_job
	from m48 a with(nolock)
		left join dmtt c on a.ma_tt = c.ma_tt
		left join d48 d on a.id = d.id
		left join dmkh e on d.ma_kh = e.ma_kh 
		left join sysunit u on a.unit_id = u.unit_id
	where a.id = @id

select line as stt, a.ma_kh, b.ten_kh, a.tien_nt,a.tien,a.id_hd,d.ten_pttt
	from d48 a with(nolock) 
	left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
	left join dmpttt d on a.ma_pttt = d.ma_pttt
	where a.id = @id

]]>
    </text>
  </query>

