  <query>
    <text>
      <![CDATA[
--- Table 1 ---


declare @t numeric(19, 5)
select  a.unit_id, a.so_ct, a.ma_noi_di, a.ma_kh, b.ten_kh, b.ten_kh2, b.dia_chi, b.ma_so_thue, d.ten_nv, a.dien_giai, a.ma_nt, f.ten_noi_di, g.ma_noi_den, g.ten_noi_den, m.ma_noi_dodong, m.ten_noi_dodong,  e.ten_tt,a.ong_ba, 
		z.ten_tau,  a.hanh_trinh, a.hanh_trinh2, a.ma_kh_s, o.ten_kh ten_kh_s, a.ma_kh_g, l.ten_kh ten_kh_g, l.dia_chi dia_chi_g, a.ds_cong, a.book_no, a.so_tk, i.ten_hq,
		s631.so_ct so_ct_s631, (REPLACE(a.ma_job, ' ' ,'') + a.so_job) ma_job, k.ten_gd, b.nguoi_lh, b.dien_thoai, b.e_mail, a.mbl_no, a.hbl_no, a.ma_tau, p.ma_noi_giaonhan, p.ten_noi_giaonhan, j.ma_svc, j.ten_svc,
		ab.ma_cang_ct, ab.ten_cang_ct,
		dbo.iswiftFunctionReadCurrency(a.ma_nt, @t) as t_tt_in_word, n.ten_hang, r.ten_dl, aa.ten_kh ten_kh_n, a.doc_no, a.doc_nam, a.ma_cnct,
	    replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year,
		convert(varchar(10),a.ngay_hl,103) ngay_hl ,
		convert(varchar(10),a.ngay_ct,103) ngay_ct ,
		convert(varchar(10),a.ngay_hld,103) ngay_hld, 
		convert(varchar(10),a.ngay_hantra,103) ngay_hantra,
		convert(varchar(10),a.ngay_vc,103) ngay_vc ,
		convert(varchar(10),a.ngay_hd,103) ngay_hd, 
		convert(varchar(10),a.ngay_mbl,103) ngay_mbl, 
		convert(varchar(10),a.ngay_hbl,103) ngay_hbl, 
		(REPLACE((a.hanh_trinh), ' ' ,'')+ '-'+REPLACE((a.hanh_trinh2), ' ' ,'')) hanh_trinh12,
		(REPLACE((z.ten_tau), ' ' ,'')+ ' / '+REPLACE((a.hanh_trinh), ' ' ,'')) chuyen_tau,
		(REPLACE(str(a.mbl_no), ' ' ,'')+ ' - '+REPLACE(str(a.hbl_no), ' ' ,'')) mhbl_no,
		(REPLACE(str(a.mbl_no), ' ' ,'')+REPLACE(str(a.hbl_no), ' ' ,'')) mhbl_no_cm
			into #s611 from s611 a with(nolock)
			left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
			left join dmkh aa on a.ma_kh_n = aa.ma_kh
			left join dmkh h on a.ma_hang = h.ma_kh
			left join dmkh o on a.ma_kh_s = o.ma_kh
			left join dmkh l on a.ma_kh_g = l.ma_kh
			left join dmnv d on a.ma_nv = d.ma_nv
			left join dmtt e on a.ma_tt = e.ma_tt
			left join vdmcangdi f on a.ma_noi_di = f.ma_noi_di
			left join vdmcangden g on a.ma_noi_den = g.ma_noi_den
			left join vdmcangdodong m on a.ma_noi_dodong = m.ma_noi_dodong
			left join vdmcanggiaonhan p on a.ma_noi_giaonhan = p.ma_noi_giaonhan
			left join vdmcangct ab on a.ma_cang_ct = ab.ma_cang_ct
			left join vdmhangtau n on a.ma_hang = n.ma_hang
			left join vdmdaily r on a.ma_dl = r.ma_dl			
			left join dmtau z on a.ma_tau = z.ma_tau
			left join sysunit u on a.unit_id = u.unit_id
			left join s631 s631 on a.id = s631.id_dh
			left join dmgd k on a.ma_gd = k.ma_gd	
			left join dmsvc j on a.ma_svc = j.ma_svc
			left join dmhaiquan i on a.ma_hq = i.ma_hq
			where a.id = @id and k.ma_ct = 'CR1'
			select * from #s611

select s.ma_cong, s.so_luong, s.cont_no, s.seal_no, s.ty_trong, s.tong_trong, s.ty_khoi, s.tong_khoi, s.dien_giai, s.so_kien, s.ma_kien, 
	   b.ma_job ma_job_dt, b.ten_kh_g, b.ten_kh_s, b.ma_job, b.mhbl_no, b.ten_noi_dodong,
	    (' ETD: '+REPLACE((b.ngay_hl), ' ' ,'')+ ' ETA: '+REPLACE((b.ngay_hld), ' ' ,'')) ngay_etda,
				(REPLACE(str(s.so_kien), ' ' ,'')+ ''+REPLACE((s.ma_kien), ' ' ,'')) so_ma_kien
		into #v611 from v611 s with(nolock) 
		left join dmkien a on s.ma_kien = a.ma_kien
		left join #s611 b on s.id = @id
		where s.id = @id 
		select * from #v611
		
select l.ma_phi, q.ten_phi2, l.ma_dvt, x.ma_nt, l.thue_suat, l.so_luong, l.gia_nt2, l.tien_nt2, l.tt, x.dien_giai
		into #v631 from v631 l with(nolock)
		left join s631 x on l.id = x.id
		left join s611 z on x.id_dh = z.id
		--left join s611 s on l.id_dh = s.id 
		left join dmphi q on q.ma_phi = l.ma_phi
		left join dmdvt m on m.dvt = l.ma_dvt
		left join dmnt n on n.ma_nt = l.ma_nt
		where l.id = @id
select * from #v631	
drop table #v611,#v631,#s611

]]>
    </text>
  </query>

