<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
		select a.ma_dv, a.ten_dv, a.ten_dv2,
		IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmdvxd a with(nolock)
		where ma_dv = @ma_dv
	  ]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmdvxd_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmdvxd_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin đơn vị" e="Location Information"/>
    </field>
    <field name="h_ma_dv" type="C">
      <text v="Mã đơn vị:" e="Location Code:"/>
    </field>
	<field name="h_ten_dv" type="C">
      <text v="Tên đơn vị:" e="Location Name:"/>
	</field>
	<field name="h_ten_dv2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>