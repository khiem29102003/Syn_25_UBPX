<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_phi, a.ten_phi, a.ten_phi2, a.ma_dvt, a.nhom_bg1, a.nhom_bg2, a.nhom_bg3, 
				
				IIF(a.fcl_yn = 1, replace(a.fcl_yn,1,'x'), '') fcl_yn,
				IIF(a.fcl2_yn = 1, replace(a.fcl2_yn,1,'x'), '') fcl2_yn,
				IIF(a.fcl2_yn = 1, replace(a.fcl3_yn,1,'x'), '') fcl3_yn,
				
				IIF(a.lcl_yn = 1, replace(a.lcl_yn,1,'x'), '') lcl_yn,
				IIF(a.lcl2_yn = 1, replace(a.lcl2_yn,1,'x'), '') lcl2_yn,
				IIF(a.lcl2_yn = 1, replace(a.lcl3_yn,1,'x'), '') lcl3_yn,

				IIF(a.air_yn = 1, replace(a.air_yn,1,'x'), '') air_yn,
				IIF(a.air2_yn = 1, replace(a.air2_yn,1,'x'), '') air2_yn,
				IIF(a.air2_yn = 1, replace(a.air3_yn,1,'x'), '') air3_yn,

				IIF(a.cdi_yn = 1, replace(a.cdi_yn,1,'x'), '') cdi_yn,
				IIF(a.cdi2_yn = 1, replace(a.cdi2_yn,1,'x'), '') cdi2_yn,
				IIF(a.cdi3_yn = 1, replace(a.cdi3_yn,1,'x'), '') cdi3_yn,

				IIF(a.cdn_yn = 1, replace(a.cdn_yn,1,'x'), '') cdn_yn,
				IIF(a.cdn_yn = 1, replace(a.cdn2_yn,1,'x'), '') cdn2_yn,
				IIF(a.cdn_yn = 1, replace(a.cdn3_yn,1,'x'), '') cdn3_yn,

				
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmphi a with(nolock)

		where ma_phi = @ma_phi
]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmma_phi_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmma_phi_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin phí" e="Fee Information"/>
    </field>
    <field name="h_ma_phi" type="C">
      <text v="Mã đơn vị:" e="Unit Code:"/>
    </field>
	<field name="h_ten_phi" type="C">
      <text v="Tên đơn vị:" e="Unit Name:"/>
	</field>
	<field name="h_ten_phi2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_ma_loai" type="C">
      <text v="Mã loại:" e="Code:"/>
    </field>
	

	<field name="h_nhom_bg1" type="C">
      <text v="Mã đơn vị:" e="Unit Code:"/>
    </field>
	<field name="h_nhom_bg2" type="C">
      <text v="Tên đơn vị:" e="Unit Name:"/>
	</field>
	<field name="h_nhom_bg3" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>	
	
	
	<field name="h_fcl_yn" type="C">
      <text v="FCL" e="FCL"/>
	</field>
	<field name="h_fcl2_yn" type="C">
      <text v="FCL" e="FCL"/>
	</field>
	<field name="h_fcl3_yn" type="C">
      <text v="FCL" e="FCL"/>
	</field>
	
	<field name="h_lcl_yn" type="C">
      <text v="LCL" e="LCL"/>
	</field>
	<field name="h_lcl2_yn" type="C">
      <text v="LCL" e="LCL"/>
	</field>
	<field name="h_lcl3_yn" type="C">
      <text v="LCL" e="FCL"/>
	</field>
	
	<field name="h_air_yn" type="C">
      <text v="AIR" e="AIR"/>
	</field>
	<field name="h_air2_yn" type="C">
      <text v="AIR" e="AIR"/>
	</field>
	<field name="h_air3_yn" type="C">
      <text v="AIR" e="AIR"/>
	</field>
	
	<field name="h_cdi_yn" type="C">
      <text v="Phí cảng đi" e="Origin"/>
	</field>
	<field name="h_cdi2_yn" type="C">
      <text v="Phí cảng đi" e="Origin"/>
	</field>
	<field name="h_cdi3_yn" type="C">
      <text v="Phí cảng đi" e="Origin"/>
	</field>
	
	<field name="h_cdn_yn" type="C">
      <text v="Phí cảng đến" e="Destination"/>
	</field>
	<field name="h_cdn2_yn" type="C">
      <text v="Phí cảng đến" e="Destination"/>
	</field>
	<field name="h_cdn3_yn" type="C">
      <text v="Phí cảng đến" e="Destination"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>