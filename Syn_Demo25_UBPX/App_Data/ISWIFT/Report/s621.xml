<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[


select q.ma_phi, s.ma_cong, s.so_luong, s.gia_nt1, s.tien_nt1, s.thue_suat, s.tt , s.ma_nt, x.ten_bgn as ten_dk_phi
into #v621 from v621 s with(nolock) 
left join dmphi q on s.ma_phi = q.ma_phi 
left join dmbgn x on s.ma_dk_phi = x.ma_bgn 
where s.id = @id and ma_ct = 'LPH' 

declare @t numeric(19, 5)


select a.unit_id, a.so_ct, a.ma_noi_di, a.ma_kh, b.ten_kh, b.ten_kh2, b.dia_chi, d.ten_nv, a.dien_giai, a.ma_nt, f.ten_noi_di, g.ten_noi_den, h.ten_kh ten_hang, dbo.iswiftFunctionReadCurrency(a.ma_nt, @t) as t_tt_in_word
	  , replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct,
	  convert(char(10),a.ngay_hl,103) ngay_hl,e.ten_tt,a.ong_ba, ngay_hld, a.ds_cong, a.book_no, a.so_tk
		from s621 a with(nolock)
		left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
		left join dmnv d on a.ma_nv = d.ma_nv
		left join dmtt e on a.ma_tt = e.ma_tt
		left join vdmcangdi f on a.ma_noi_di = f.ma_noi_di
		left join vdmcangden g on a.ma_noi_den = g.ma_noi_den
		left join dmkh h on a.ma_hang = h.ma_kh
		left join sysunit u on a.unit_id = u.unit_id
	where a.id = @id 
select * from #v621
drop table #v621

]]>
    </text>
  </query>

  <forms>
	<form id="010" fileName="s621_02" fileType="rdlc" exportExt="pdf" image="pdf">
