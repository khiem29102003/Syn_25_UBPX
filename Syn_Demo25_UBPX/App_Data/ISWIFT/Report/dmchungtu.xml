<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_ct, a.ten_ct, a.ten_ct2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmchungtu a with(nolock)
		where ma_ct = @ma_ct

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmchungtu_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmchungtu_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin chứng từ" e="Voucher Information"/>
    </field>
    <field name="h_ma_ct" type="C">
      <text v="Mã chứng từ:" e="Voucher Code:"/>
    </field>
	<field name="h_ten_ct" type="C">
      <text v="Tên chứng từ:" e="Voucher Name:"/>
	</field>
	<field name="h_ten_ct2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>