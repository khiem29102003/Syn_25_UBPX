<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
		declare @t numeric(19, 5)
		select a.unit_id, a.so_ct, a.ma_noi_di, a.ma_kh, b.ten_kh, b.ten_kh2, b.dia_chi, b.nguoi_lh, b.e_mail, b.dien_thoai, 
			   d.ten_nv, a.dien_giai, a.ma_nt, f.ten_noi_di, g.ten_noi_den, h.ten_kh ten_hang,  dbo.iswiftFunctionReadCurrency(a.ma_nt, @t) as t_tt_in_word,
			replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct,
			convert(varchar(10),a.ngay_hl,103) ngay_hl,e.ten_tt,a.ong_ba, a.ma_nt, a.ty_gia, 
			convert(varchar(10),a.ngay_hld,103) ngay_hld, a.so_job, k.book_no, k.so_tk, k.hbl_no, k.mbl_no, z.ten_tau, k.hanh_trinh,
			convert(varchar(10),k.ngay_hantra,103) ngay_hantra, y.ten_gd
			from m54 a with(nolock)
			left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
			left join dmnv d on a.ma_nv = d.ma_nv
			left join dmtt e on a.ma_tt = e.ma_tt
			left join vdmcangdi f on a.ma_noi_di = f.ma_noi_di
			left join vdmcangden g on a.ma_noi_den = g.ma_noi_den
			left join dmkh h on a.ma_hang = h.ma_kh
			left join s611 k on a.id_dh = k.id
			left join sysunit u on a.unit_id = u.unit_id
			left join dmtau z on k.ma_tau = z.ma_tau
			left join dmgd y on k.ma_gd = y.ma_gd
		where a.id = @id 
		
		select q.ma_phi, q.ten_phi2, s.ma_cong, s.so_luong, s.gia_nt2, s.tien_nt2, s.thue_suat, s.tt, s.tt_nt , s.ma_nt, x.ten_bgn as ten_dk_phi , s.tc_tien2, s.thue
			into #d54 from d54 s with(nolock) 
			left join dmphi q on s.ma_phi = q.ma_phi 
			left join dmbgn x on s.ma_dk_phi = x.ma_bgn 
			where s.id = @id and ma_ct = 'LPH' 
		select * from #d54
		
		DECLARE @dien_giais NVARCHAR(256) 
		SELECT @dien_giais = COALESCE(@dien_giais + ', ', '') + dien_giai 
		FROM v61 where id = @id_dh 

		DECLARE @cont_nos NVARCHAR(256) 
		SELECT @cont_nos = COALESCE(@cont_nos + ', ', '') + cont_no
		FROM v61 where id = @id_dh 

		select s.ma_cong, s.so_luong, s.cont_no, @cont_nos as cont_nos ,s.seal_no,  s.ty_trong , s.tong_trong,
               s.ty_khoi, s.tong_khoi, s.dien_giai, @dien_giais as dien_giais,
			   (REPLACE(str(s.ty_trong), ' ' ,'')+ '/'+REPLACE(str(s.ty_khoi), ' ' ,'')) ty_trong_khoi
			into #v61 from v61 s with(nolock)
			where s.id = @id_dh 
			select * from #v61
		drop table #d54, #v61 
]]>
    </text>
  </query>

