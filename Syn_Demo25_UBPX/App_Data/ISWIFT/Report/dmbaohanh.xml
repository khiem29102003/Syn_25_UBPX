<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_baohanh, a.ten_baohanh, a.ten_baohanh2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmbaohanh a with(nolock)
		where ma_baohanh = @ma_baohanh

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmbaohanh_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmbaohanh_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin bảo hành" e="Warranty Information"/>
    </field>
    <field name="h_ma_baohanh" type="C">
      <text v="Mã bảo hành:" e="Warranty Code:"/>
    </field>
	<field name="h_ten_baohanh" type="C">
      <text v="Tên bảo hành:" e="Warranty Name:"/>
	</field>
	<field name="h_ten_baohanh2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>