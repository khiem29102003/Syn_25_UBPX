<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
	SELECT DISTINCT z.ma_khon, a.unit_id, a.ma_kh, a.ma_job, a.so_job, a.ma_job + a.so_job ms_job,
		b.ma_so_thue,
		d.ten_dc, d.ten_dc2, d.lien_he_gh , d.chuc_vu, d.dt_gh
		from m74 a with(nolock)
				left join sysunit b on a.unit_id = b.unit_id
				left join dmkh c on a.ma_kh = c.ma_kh
				left join dmdc d on a.ma_dc = d.ma_dc
				left join d74 z on a.id = z.id
		where a.id = @id

	SELECT line as stt, a.ma_vt, a.ma_model, a.so_luong,
			b.ten_vt
		from d74 a with(nolock)
				left join dmvt b with(nolock) on a.ma_vt = b.ma_vt
				left join m74 c on a.id = c.id
		where a.id = @id



]]>
    </text>
  </query>

