<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
select a.ma_phi, a.ma_cong, convert(float,a.so_luong) so_luong, a.gia_nt2, a.tien_nt2, a.thue_suat, a.tt , a.ma_nt, a.ma_dk_phi,
		b.ten_phi
		into #v43 from v43 a with(nolock) 
		left join dmphi b on a.ma_phi = b.ma_phi 
		where a.id = @id 

declare @t numeric(19, 5)


select a.unit_id, a.so_ct, a.ma_noi_di, a.ma_kh, a.dien_giai, a.ma_nt, a.ngay_ct, a.ong_ba, a.ds_cong, a.ds_ngay, a.ma_cuoc, a.ty_gia,
		b.ten_kh, b.ten_kh2, b.dia_chi, 
		d.ten_nv, 
		e.ten_tt,
		f.ten_noi_di, 
		g.ten_noi_den, 
		h.ten_kh ten_hang, 
		k.ten_bgn ten_cuoc,
		l.ten_bgn ma_dk_gh,
		dbo.iswiftFunctionReadCurrency(a.ma_nt, @t) as t_tt_in_word,
	    replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, 
		convert(char(10),a.ngay_hl,103) ngay_hl,
		convert(char(10),a.ngay_hld,103) ngay_hld
		from s43 a with(nolock)
		left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
		left join dmnv d on a.ma_nv = d.ma_nv
		left join dmtt e on a.ma_tt = e.ma_tt
		left join vdmcangdi f on a.ma_noi_di = f.ma_noi_di
		left join vdmcangden g on a.ma_noi_den = g.ma_noi_den
		left join dmkh h on a.ma_hang = h.ma_kh
		left join dmbgn k on a.ma_cuoc = k.ma_bgn and k.ma_ct = 'LCC'
		left join dmbgn l on a.ma_cuoc = l.ma_bgn and l.ma_ct = 'DK'
		left join sysunit u on a.unit_id = u.unit_id
	where a.id = @id
select * from #v43
select ma_cong, ma_dk_phi, sum(tt) tt from #v43 group by ma_cong, ma_dk_phi order by ma_cong
select ten_phi, ma_dk_phi from #v43 group by ten_phi, ma_dk_phi
drop table #v43
]]>
    </text>
  </query>

  <forms>
