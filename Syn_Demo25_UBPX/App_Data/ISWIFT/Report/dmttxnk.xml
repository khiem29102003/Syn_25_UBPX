<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_tt, a.ten_tt, a.ord,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmttxnk a with(nolock)
		where ma_tt = @ma_tt

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmttxnk_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmttxnk_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin trạng thái" e="Status Information"/>
    </field>
    <field name="h_ma_tt" type="C">
      <text v="Mã trạng thái:" e="Status Code:"/>
    </field>
	<field name="h_ten_tt" type="C">
      <text v="Tên trạng thái:" e="Status Name:"/>
	</field>
	<field name="h_ord" type="C">
      <text v="Trình tự: " e="Sequence: "/>         
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>