<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_loaibh, a.ten_loaibh, a.ten_loaibh2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmloaibh a with(nolock)
		where ma_loaibh = @ma_loaibh

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmloaibh_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmloaibh_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
	<field name="title" type="C">
      <text v="Thông tin loại bảo hành" e="Warranty Information"/>
    </field>
    <field name="h_ma_loaibh" type="C">
      <text v="Mã loại bảo hành:" e="Warranty Code:"/>
    </field>
	<field name="h_ten_loaibh" type="C">
      <text v="Tên loại bảo hành:" e="Warranty Name:"/>
	</field>
	<field name="h_ten_loaibh2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>

</report>