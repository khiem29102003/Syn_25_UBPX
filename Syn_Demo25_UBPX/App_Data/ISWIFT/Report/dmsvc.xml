<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
			select a.ma_svc, a.ten_svc, a.ten_svc2,
			IIF(a.status = '1', N'Còn sử dụng', N'Không sử dụng') status
			from dmsvc a with(nolock)
		where ma_svc = @ma_svc

]]>
    </text>
  </query>

  <forms>
    <form id="010" fileName="dmsvc_01" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Mẫu chuẩn (.pdf)" e="Standard Templates"></text>
    </form>
	
	<form id="030" fileName="dmsvc_01" fileType="rdlc" exportExt="xlsx" image="excel">
      <text v="Mẫu chuẩn (.xlsx)" e="Standard Templates"></text>
    </form>	
  </forms>

  <fields>
   	<field name="title" type="C">
      <text v="Thông tin SVC" e="SVC Information"/>
    </field>
    <field name="h_ma_svc" type="C">
      <text v="Mã SVC:" e="SVC Code:"/>
    </field>
	<field name="h_ten_svc" type="C">
      <text v="Tên SVC:" e="SVC Name:"/>
	</field>
	<field name="h_ten_svc2" type="C">
      <text v="Tên khác:" e="Other Name:"/>
	</field>
	<field name="h_status" type="C">
      <text v="Trạng thái:" e="Status:"/>
	</field>
  </fields>
</report>