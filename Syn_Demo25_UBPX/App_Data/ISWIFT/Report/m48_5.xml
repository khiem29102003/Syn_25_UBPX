<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
select a.unit_id, isnull(u.ma_so_thue, '') as ms_thue, a.so_ct, a.so_ct2 as ky_hieu, a.ong_ba as nguoi_mua_hang, a.dia_chi, isnull(c.ten_tt, '') as ten_tt, 
	   a.ma_tt, a.dien_giai, cast(a.status as char(1)) as status, a.ma_nt, dbo.iswiftFunctionReadCurrency(a.ma_nt, a.t_tien_nt) as t_tt_in_word,
	   isnull(t_tien_nt,0) t_tien_nt, a.ngay_ct,
	   replace(str(day(a.ngay_ct),2),' ','0') day, 
	   replace(str(month(a.ngay_ct),2),' ','0') month, 
	   cast(year(a.ngay_ct) as char(4)) year, 
	   a.ma_job + a.so_job ma_so_job,
	   c.ten_tt,
	   d.ten_kh
	from m48 a with(nolock)
		left join dmtt c on a.ma_tt = c.ma_tt
		left join dmkh d on a.ma_kh = d.ma_kh
		left join sysunit u on a.unit_id = u.unit_id
	where a.id = @id

select ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS stt, a.ma_kh, a.tien_nt, a.tien, a.id_hd, a.dien_giai,
	b.ten_kh,
	d.ten_pttt,
	e.id, e.ma_job, e.so_job
	from d48 a with(nolock) 
	left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
	left join dmpttt d on a.ma_pttt = d.ma_pttt
	left join (select a.id, b.ma_job, b.so_job from m72 a left join s61 b on a.id_dh = b.id ) e on a.id_hd = e.id
	where a.id = @id
]]>
    </text>
  </query>

