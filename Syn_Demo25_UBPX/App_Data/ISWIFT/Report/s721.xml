<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
select q.ma_phi, s.ma_cong, s.so_luong, s.gia_nt2, s.tien_nt2, s.thue_suat, s.tt , s.ma_nt
into #v721 from v721 s with(nolock) left join dmphi q on s.ma_phi = q.ma_phi where s.id = @id 

declare @t numeric(19, 5)


select a.unit_id, a.so_ct, a.ma_noi_di, a.ma_kh, b.ten_kh, b.ten_kh2, b.dia_chi, d.ten_nvbh, a.dien_giai, a.ma_nt, f.ten_noi_di, g.ten_noi_den, h.ten_kh ten_hang, k.ten_bgn ten_cuoc, dbo.iswiftFunctionReadCurrency(a.ma_nt, @t) as t_tt_in_word
	  , replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct,
	  convert(char(10),a.ngay_hl,103) ngay_hl,e.ten_tt,a.ong_ba, ngay_hld, ds_cong, ds_ngay, ma_cuoc
		from s721 a with(nolock)
		left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
		left join dmnvbh d on a.ma_nvbh = d.ma_nvbh
		left join dmtt e on a.ma_tt = e.ma_tt
		left join vdmcangdi f on a.ma_noi_di = f.ma_noi_di
		left join vdmcangden g on a.ma_noi_den = g.ma_noi_den
		left join dmkh h on a.ma_hang = h.ma_kh
		left join dmbgn k on a.ma_cuoc = k.ma_bgn
		left join sysunit u on a.unit_id = u.unit_id
	where a.id = @id and k.ma_ct = 'LCC'
select * from #v721
drop table #v721
]]>
    </text>
  </query>

  <forms>
    <form id="030" fileName="s721_02" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Báo giá (.pdf)" e="QUOTATION (.pdf)"></text>
    </form>
	<form id="040" fileName="s721_02" fileType="rdlc" exportExt="docx" image="word">
      <text v="Báo giá (.docx)" e="QUOTATION (.docx)"></text>
    </form>
	 <form id="050" fileName="s721_02" fileType="rdlc" exportExt="xlsx" image="xlsx">
      <text v="Báo giá (.xlsx)" e="QUOTATION (.xlsx)"></text>
    </form>
  </forms>

