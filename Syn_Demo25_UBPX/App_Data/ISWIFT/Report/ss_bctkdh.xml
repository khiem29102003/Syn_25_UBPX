	<!-- Master -->

  <fields>
    <field name="title" type="C">
      <text v="ĐƠN HÀNG" e="Order"/>
    </field>
	<field name="title2" type="C">
      <text v="PHIẾU UỶ QUYỀN" e="LETTER OF ATTORNEY"/>
    </field>
    <field name="h_day" type="C">
      <text v="Ngày" e="Date"/>
    </field>
    <field name="h_month" type="C">
      <text v="tháng" e="Month"/>
    </field>
    <field name="h_year" type="C">
      <text v="năm" e="Year"/>
    </field>
    <field name="h_so_ct" type="C">
      <text v="Số đơn hàng: " e="Order no.: "/>
    </field>
    <field name="h_company" type="C">
      <text v="Kính gửi:" e="Dear:"/>
    </field>
    <field name="h_address" type="C">
      <text v="Địa chỉ:" e="Address:"/>
    </field>
    <field name="h_kh" type="C">
      <text v="Tên đại lý:" e="Agent name:"/>
    </field>
    <field name="h_noi_giao" type="C">
      <text v="Nơi giao:" e="Delivery place:"/>
    </field>
	<field name="h_ong_ba" type="C">
      <text v="Người liên hệ:" e="Contact:"/>
    </field>
	<field name="h_ngay_hl" type="C">
      <text v="Ngày hiệu lực:" e="Effective date:"/>
    </field>
	<field name="h_ngay_hld" type="C">
      <text v="Ngày hiệu lực đến:" e="Expiry date:"/>
    </field>
	<field name="h_stt" type="C">
      <text v="STT" e="No"/>
    </field>
	<field name="h_dien_giai" type="C">
      <text v="Diễn giải" e="Explain"/>
    </field>
    <field name="h_ma_noi_di" type="C">
      <text v="Nơi đi: " e="Origin:"/>
    </field>
	<field name="h_ma_noi_den" type="C">
      <text v="Nơi đến: " e="Destination:"/>
    </field>
	<field name="h_ds_cong" type="C">
      <text v="Container: " e="Container:"/>
    </field>
	<field name="h_so_tk" type="C">
      <text v="Số tờ khai:" e="Schedule days:"/>
    </field>
	<field name="h_book_no" type="C">
      <text v="Book No:" e="Prepaid / Collect:"/>
    </field>
	<field name="h_ma_hang" type="C">
      <text v="Hãng tàu/ Đại lý:" e="Carrier/ Agent:"/>
    </field>
	
    <field name="h_nguoi_lh" type="C">
      <text v="ATT :" e="ATT :"/>
    </field>
	<field name="h_e_mail" type="C">
      <text v="Email :" e="Email :"/>
    </field>
