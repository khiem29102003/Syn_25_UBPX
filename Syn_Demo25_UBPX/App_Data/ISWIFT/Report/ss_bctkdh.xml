<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
declare @t numeric(19, 5)
select  a.unit_id, a.so_ct, a.ma_noi_di, a.ma_kh, a.dien_giai, a.ma_nt, a.ma_kh_g, a.ong_ba, a.hanh_trinh, a.hanh_trinh2, a.ma_kh_s,
    a.mbl_no, a.hbl_no, a.ma_tau, a.doc_no, a.doc_nam, a.ma_cnct, a.ma_noi_den, a.ma_noi_dodong, a.ma_noi_giaonhan, a.ma_cang_ct,
    a.ds_cong, a.book_no, a.so_tk, a.ma_svc, 
    b.ten_kh, b.ten_kh2, b.dia_chi, b.ma_so_thue, b.nguoi_lh, b.dien_thoai, b.e_mail,
    c.ten_kh ten_kh_n,
    --
    e.ten_kh ten_kh_s, 
    f.ten_kh ten_kh_g, f.dia_chi dia_chi_g,
    g.ten_nv, 
    h.ten_tt,
    i.ten_noi_di,
    k.ten_noi_den,
    l.ten_noi_dodong,
    m.ten_noi_giaonhan,
    n.ten_cang_ct,
    o.ten_hang,
    q.ten_dl,
    p.ten_tau,
    --
    s.ten_gd, 
    t.ten_svc,
    u.ten_hq,
    v.ty_gia,
    dbo.iswiftFunctionReadCurrency(a.ma_nt, @t) as t_tt_in_word, 
    (REPLACE(a.ma_job, ' ' ,'') + a.so_job) ma_job,
    replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, 
    cast(year(a.ngay_ct) as char(4)) year,
    convert(varchar(10),a.ngay_hl,103) ngay_hl ,
    convert(varchar(10),a.ngay_ct,103) ngay_ct ,
    convert(varchar(10),a.ngay_hld,103) ngay_hld, 
    convert(varchar(10),a.ngay_hantra,103) ngay_hantra,
    convert(varchar(10),a.ngay_vc,103) ngay_vc ,
    convert(varchar(10),a.ngay_hd,103) ngay_hd, 
    convert(varchar(10),a.ngay_mbl,103) ngay_mbl, 
    convert(varchar(10),a.ngay_hbl,103) ngay_hbl, 
    (REPLACE((a.hanh_trinh), ' ' ,'')+ '-'+REPLACE((a.hanh_trinh2), ' ' ,'')) hanh_trinh12,
    (REPLACE((ISNULL(p.ten_tau, '')), ' ' ,'')+ '  /  '+REPLACE((ISNULL(a.hanh_trinh, '')), ' ' ,'')) chuyen_tau,
    (REPLACE((ISNULL(a.mbl_no, '')), ' ' ,'')+ ' - '+REPLACE((ISNULL(a.hbl_no, '')), ' ' ,'')) mhbl_no,
    (REPLACE((ISNULL(a.mbl_no,'')), ' ' ,'')+REPLACE((ISNULL(a.hbl_no, '')), ' ' ,'')) mhbl_no_cm,
    IIF(a.chk_original = 1, replace(a.chk_original,1,'YES'), 'NO') chk_original,
    IIF(a.chk_notice = 1, replace(a.chk_notice,1,'X'), '') chk_notice,
    IIF(a.chk_recom = 1, replace(a.chk_recom,1,'X'), '') chk_recom,
    IIF(a.chk_notice = 1, replace(a.chk_notice,1,'YES'), 'NO') chk_notice_15,
    IIF(a.chk_recom = 1, replace(a.chk_recom,1,'YES'), 'NO') chk_recom_15
      into #s61 from s61 a with(nolock)
      left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
      left join dmkh c on a.ma_kh_n = c.ma_kh
      left join dmkh d on a.ma_hang = d.ma_kh
      left join dmkh e on a.ma_kh_s = e.ma_kh
      left join dmkh f on a.ma_kh_g = f.ma_kh
      left join dmnv g on a.ma_nv = g.ma_nv
      left join dmtt h on a.ma_tt = h.ma_tt
      left join vdmcangdi i on a.ma_noi_di = i.ma_noi_di
      left join vdmcangden k on a.ma_noi_den = k.ma_noi_den
      left join vdmcangdodong l on a.ma_noi_dodong = l.ma_noi_dodong
      left join vdmcanggiaonhan m on a.ma_noi_giaonhan = m.ma_noi_giaonhan
      left join vdmcangct n on a.ma_cang_ct = n.ma_cang_ct
      left join vdmhangtau o on a.ma_hang = o.ma_hang
      left join vdmdaily q on a.ma_dl = q.ma_dl      
      left join dmtau p on a.ma_tau = p.ma_tau
      left join sysunit r on a.unit_id = r.unit_id
      left join dmgd s on a.ma_gd = s.ma_gd  
      left join dmsvc t on a.ma_svc = t.ma_svc
      left join dmhaiquan u on a.ma_hq = u.ma_hq
      left join m54 v on a.id = v.id_dh
      where a.id = @id 
      select * from #s61     

--- Đơn hàng chi tiết
select ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS stt, a.ma_cong, a.so_luong, a.cont_no, a.seal_no, a.ty_trong, a.tong_trong, a.ty_khoi, a.tong_khoi, a.dien_giai, 
     a.so_kien, a.ma_kien, 
     b.ma_job ma_job_dt, b.ten_kh_g, b.ten_kh_s,
     c.ten_kien
    into #v61 from v61 a with(nolock) 
    left join dmkien c on c.ma_kien = a.ma_kien
    left join #s61 b on a.id = @id
    where a.id = @id 
    select * from #v61
	

--- Phiếu mua chi tiết
select ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS stt, a.dien_giai, a.ma_kh, a.ma_kh ma_kh_tt, a.ma_vt, a.dvt, a.ma_nt, a.so_luong, a.gia2, 
	a.gia_nt2, a.tien2, a.tien_nt2, a.thue_suat, a.thue_nt, a.thue, a.tt_nt, a.tt, 
	b.t_tien2, b.t_tieny2 , b.t_thue, b.t_tt, b.t_ttx, b.t_tty,
    c.ten_vt, c.ten_vt2,
	d.ma_kh ma_kh_m72,
    e.ten_kh ten_kh_tt  
    into #d72 from d72 a with(nolock) 
    left join (select a.id, b.id_dh, b.t_tien2, b.t_tieny2, b.t_thue, b.t_tt, b.t_ttx, b.t_tty from m72 a left join (select a.id_dh, SUM(a.t_tien2) t_tien2, SUM(a.t_tieny2) t_tieny2, SUM(a.t_thue) t_thue, SUM(a.t_tt) t_tt,  SUM(a.t_ttx) t_ttx, SUM(a.t_tty) t_tty from m72 a 
					  left join s61 b on a.id_dh = b.id group by a.id_dh
					  ) b on a.id_dh = b.id_dh
			   ) b on a.id = b.id
    left join dmvt c on c.ma_vt = a.ma_vt
	left join m72 d on a.id = d.id
    left join dmkh e on e.ma_kh = d.ma_kh
    where b.id_dh = @id 
    select * from #d72 ORDER BY stt ASC
 
--- Phiếu bán chi tiết 
select ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS stt, 
     /*Phiếu Bán*/ a.dien_giai, a.ma_kh, a.ma_vt, a.dvt, a.ma_nt, a.so_luong, a.gia2, a.gia_nt2, a.tien2, a.tien_nt2, a.thue_suat, a.thue_nt, a.thue, 
             a.tt, a.tt_nt, 
             c.ten_vt, c.ten_vt2,
             b.t_tien_nt2_m54, b.t_tien2_m54, b.t_tieny2_m54, b.t_tt_nt_m54, b.t_tt_m54, b.t_thue_m54,
     /*Phiếu Mua*/ b.t_tien_nt2_m72, b.t_tien2_m72, b.t_tieny2_m72, b.t_tt_nt_m72, b.t_tt_m72,
/*Tính Lợi Nhuận*/ b.t_ln_t_tax_nt, b.t_ln_t_tax, b.t_ln_s_tax_nt, b.t_ln_s_tax, b.t_lny_t_tax
    into #d54 from d54 a with(nolock) 
    left join (select 
     /*Phiếu Bán*/ a.id, a.id_dh, ISNULL(SUM(a.t_tien_nt2), 0) t_tien_nt2_m54, ISNULL(SUM(a.t_tien2), 0) t_tien2_m54, ISNULL(SUM(a.t_tieny2), 0) t_tieny2_m54, a.t_thue t_thue_m54,
				   ISNULL(SUM(a.t_tt_nt), 0) t_tt_nt_m54, ISNULL(SUM(a.t_tt), 0) t_tt_m54,
     /*Phiếu Mua*/ ISNULL(SUM(b.t_tien_nt2), 0) t_tien_nt2_m72, ISNULL(SUM(b.t_tien2), 0) t_tien2_m72, ISNULL(SUM(b.t_tieny2), 0) t_tieny2_m72, ISNULL(SUM(b.t_tt_nt), 0) t_tt_nt_m72,
				   ISNULL(SUM(b.t_tt), 0) t_tt_m72,
/*Tính Lợi Nhuận*/ (ISNULL(a.t_tien_nt2, 0) - ISNULL(b.t_tien_nt2, 0)) t_ln_t_tax_nt,      
				   (ISNULL(a.t_tien2, 0) - ISNULL(b.t_tien2, 0)) t_ln_t_tax,
				   (ISNULL(a.t_tieny2, 0) - ISNULL(b.t_tieny2, 0)) t_lny_t_tax,
				   (ISNULL(a.t_tt_nt, 0) - ISNULL(b.t_tt_nt, 0)) t_ln_s_tax_nt, 
				   (ISNULL(a.t_tt, 0) - ISNULL(b.t_tt, 0)) t_ln_s_tax			 
            from m54 a 
            left join(select id_dh, SUM(t_tien_nt2) t_tien_nt2, SUM(t_tien2) t_tien2, SUM(t_tieny2) t_tieny2, SUM(t_tt_nt) t_tt_nt, SUM(t_tt) t_tt 
                  from m72 GROUP BY id_dh) b on a.id_dh = b.id_dh 
                  GROUP BY a.id, a.id_dh, a.t_tien_nt2, a.t_tien2, a.t_tieny2, a.t_tt_nt, a.t_tt,
                       b.t_tien_nt2, b.t_tien2, b.t_tieny2, t_thue, b.t_tt_nt, b.t_tt                        
           ) b on a.id = b.id 
    left join dmvt c on a.ma_vt = c.ma_vt
    where b.id_dh = @id 
    select * from #d54 ORDER BY stt ASC

--- Phiếu chi hộ chi tiết
select ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS stt, a.dien_giai, a.ma_kh, a.ma_kh ma_kh_tt, a.ma_vt, a.dvt, a.ma_ntx, a.sox_luong, a.giax2, 
	a.giax_nt2, a.tienx2, a.tienx_nt2, a.thuex_suat, a.thuex_nt, a.thuex, a.ttx_nt, a.ttx, 
	b.t_tien2, b.t_tienx2, b.t_thue, b.t_tt, b.t_ttx, b.t_tty, b.t_sox_luong, b.t_thuex,
    c.ten_vt, c.ten_vt2,
    d.ten_kh ten_kh_tt  
    into #f72 from f72 a with(nolock) 
    left join (select a.id, b.id_dh, b.t_tien2, b.t_tienx2, b.t_thue, b.t_thuex, b.t_tt, b.t_ttx, b.t_tty, b.t_sox_luong from m72 a 
			   left join (select a.id_dh, SUM(a.t_tien2) t_tien2, SUM(a.t_tienx2) t_tienx2, SUM(a.t_sox_luong) t_sox_luong, SUM(a.t_thue) t_thue, SUM(a.t_thuex) t_thuex, SUM(a.t_tt) t_tt, SUM(a.t_ttx) t_ttx,
								 SUM(a.t_tty) t_tty 
						  from m72 a 
						  left join s61 b on a.id_dh = b.id group by a.id_dh
						  ) b on a.id_dh = b.id_dh
			   ) b on a.id = b.id
    left join dmvt c on c.ma_vt = a.ma_vt
    left join dmkh d on d.ma_kh = a.ma_kh
    where b.id_dh = @id 
    select * from #f72 ORDER BY stt ASC

/*--- Chi hộ chi tiết
select ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS stt, 
    a.ma_vt, a.ma_nt, a.so_luong, a.gia2, a.gia_nt2, a.tien2, a.tien_nt2, a.thue_suat, a.thue_nt, a.thue, a.tt, a.tt_nt, a.ma_kh,
	b.t_so_luong, b.t_tien2, b.t_tien_nt2, b.t_tt, b.t_tt_nt, b.t_thue, b.t_thue_nt, b.t_tienx2,
    c.ten_vt, c.ten_vt2 
    into #d63 from d63 a with(nolock) 
	  left join (select a.id, b.id_dh, b.t_so_luong, b.t_tien_nt2, b.t_tt_nt, b.t_thue_nt, b.t_tien2, SUM(a.t_tienx2) t_tienx2,, b.t_thue, b.t_tt from m63 a left join (select a.id_dh, SUM(a.t_so_luong) t_so_luong, SUM(a.t_tien_nt2) t_tien_nt2,
	  SUM(a.t_tt_nt) t_tt_nt ,SUM(a.t_tien2) t_tien2, SUM(a.t_tienx2) t_tienx2, SUM(a.t_thue) t_thue, SUM(a.t_tt) t_tt, SUM(a.t_thue_nt) t_thue_nt from m63 a 
					  left join s61 b on a.id_dh = b.id group by a.id_dh
					  ) b on a.id_dh = b.id_dh
			   ) b on a.id = b.id
      left join dmvt c on a.ma_vt = c.ma_vt
      where b.id_dh = @id 
    select * from #d63 ORDER BY stt ASC 
*/
    drop table #s61,#v61,#d72,#d54, #f72 --,#d63


]]>
    </text>
  </query>

