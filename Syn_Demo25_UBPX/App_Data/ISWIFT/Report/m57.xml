<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[
select a.unit_id, isnull(u.ma_so_thue, '') as ms_thue, a.so_ct, a.so_ct2 as ky_hieu, a.ma_kh, a.ong_ba as nguoi_mua_hang, b.ten_kh as ten_kh, b.dia_chi, b.ma_so_thue, b.dien_thoai, isnull(c.ten_tt, '') as ten_tt, a.ma_tt, a.dien_giai,
	isnull(d.ten_pttt, '') as ten_pttt, cast(a.status as char(1)) as status, a.ma_nt, dbo.iswiftFunctionReadCurrency(a.ma_nt, a.t_tt_nt) as t_tt_in_word, a.dien_thoai dien_thoai2, a.dia_chi dia_chi2, e.ten_nvbh
	  , replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct,0 t_phi,a.t_tien_nt2,a.t_tt_nt,u.ten_unit
	from m57 a with(nolock)
		left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
		left join dmtt c on a.ma_tt = c.ma_tt
		left join dmnvbh e on a.ma_nvbh = e.ma_nvbh
		left join dmpttt d on a.ma_pttt = d.ma_pttt
		left join sysunit u on a.unit_id = u.unit_id
	where a.id = @id

select line as stt, a.ma_vt, b.ten_vt, a.so_luong, a.dvt, a.gia_nt2 as gia2, a.tien_nt2 as tien2,a.thue_suat,a.tl_ck,a.thue,a.ck,a.thue_nt,a.ck_nt,
	c.t_tien2, c.t_ck, c.t_thue
	from d57 a with(nolock) left join dmvt b with(nolock) on a.ma_vt = b.ma_vt
							left join m57 c on a.id = c.id
	where a.id = @id
]]>
    </text>
  </query>

