<?xml version="1.0" encoding="utf-8"?>

<report xmlns="urn:schemas-iswift:struct-report">
  <query>
    <text>
      <![CDATA[

select a.unit_id, a.so_ct, a.ma_noi_di, a.ma_kh, b.ten_kh, b.ten_kh2, b.dia_chi, d.ten_nv, a.dien_giai, a.t_tien_tu, a.id_dh, f.ma_bp, f.ten_bp, a.ma_nt, dbo.iswiftFunctionReadCurrency(a.ma_nt, a.t_tien_tu) as t_tt_in_word
	  , replace(str(day(a.ngay_ct),2),' ','0') day, replace(str(month(a.ngay_ct),2),' ','0') month, cast(year(a.ngay_ct) as char(4)) year, a.ngay_ct
		from s641 a with(nolock)
		left join dmkh b with(nolock) on a.ma_kh = b.ma_kh
		left join dmnv d on a.ma_nv = d.ma_nv
		left join dmtt e on a.ma_tt = e.ma_tt
		left join dmbp f on d.ma_bp = f.ma_bp
		left join sysunit u on a.unit_id = u.unit_id
	where a.id = @id
]]>
    </text>
  </query>

  <forms>
    <form id="030" fileName="s641_02" fileType="rdlc" exportExt="pdf" image="pdf">
      <text v="Tạm ứng (.pdf)" e="Advance money (.pdf)"></text>
    </form>
	<form id="040" fileName="s641_02" fileType="rdlc" exportExt="docx" image="word">
      <text v="Tạm ứng (.docx)" e="Advance money (.docx)"></text>
    </form>
	<form id="050" fileName="s641_02" fileType="rdlc" exportExt="xlsx" image="xlsx">
      <text v="Tạm ứng (.xlsx)" e="Advance money (.xlsx)"></text>
    </form>
  </forms>

	<!-- Master -->

  <fields>
    <field name="title" type="C">
      <text v="PHIẾU TẠM ỨNG FCL" e="REQUEST FOR ADVANCE FCL"/>
    </field>
    <field name="h_day" type="C">
      <text v="Ngày" e="Date"/>
    </field>
    <field name="h_month" type="C">
      <text v="tháng" e="Month"/>
    </field>
    <field name="h_year" type="C">
      <text v="năm" e="Year"/>
    </field>
    <field name="h_so_ct" type="C">
      <text v="Số đơn hàng: " e="Order no.: "/>
    </field>
    <field name="h_company" type="C">
      <text v="Kính gửi :" e="Dear :"/>
    </field>
    <field name="h_address" type="C">
      <text v="Địa chỉ:" e="Address:"/>
    </field>
    <field name="h_kh" type="C">
      <text v="Tên đại lý:" e="Agent name:"/>
    </field>
    <field name="h_noi_giao" type="C">
      <text v="Nơi giao:" e="Delivery place:"/>
    </field>
	<field name="h_ong_ba" type="C">
      <text v="Người liên hệ:" e="Contact:"/>
    </field>
	<field name="h_dien_giai" type="C">
      <text v="Diễn giải :" e="Explain :"/>
    </field>
	
	
	<field name="h_ma_nv" type="C">
      <text v="Họ và tên :" e="Full name :"/>
    </field>
	<field name="h_ma_nt" type="C">
      <text v="Ngoại tệ :" e="Foreign currency :"/>
    </field>
	<field name="h_t_tien_tu" type="C">
      <text v="Tiền tạm ứng :" e="Advance money :"/>
    </field>
	<field name="h_id_dh" type="C">
      <text v="ID đơn hàng :" e="Order ID :"/>
    </field>
	<field name="h_ma_bp" type="C">
      <text v="Bộ phận :" e="Department :"/>
    </field>
	<field name="h_bang_chu" type="C">
      <text v="Bằng chữ:" e="In words:"/>
    </field>
	

  </fields>
  
</report>
