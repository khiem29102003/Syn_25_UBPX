<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="dmloaiphuongxa" table="" height="" fieldKey="ma_loai" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter Condition"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120"  >
      <fields>
		<field name="ma_loai" inactivate="false" label="1" field="-" operation="like" >
			<text v="Mã loại phường/xã" e="Ward/Commune Type Code"></text>
		</field>
		<field name="ten_loai" inactivate="false" label="1" field="-" operation="ten_loai like N'%%s%'">
			<text v="Tên loại phường/xã" e="Ward/Commune Type Name"></text>
		</field>
		<field name="ten_loai2"  inactivate="false" label="1" field="-" operation="ten_loai2 like N'%%s%'">
          <text v="Tên tiếng anh" e="English Name"></text>
		</field>
		<field name="status" viewType="Combobox" label="1" field="1" operation="=" >
          <text v="Trạng thái" e="Status"></text>
		  <viewInfo>
			<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				<option val="">
                <text v="Tất cả" e="All"></text>
              </option>
			</options>
		  </viewInfo>
		</field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmloaiphuongxa(p){
  this.constructor(p);
}
filter$dmloaiphuongxa.prototype = new DirEvent();
filter$dmloaiphuongxa.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
</dir>