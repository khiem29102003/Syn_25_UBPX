<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="g11Close" table="" height="" fieldKey="id" voucherCode="NQ1" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Lọc nhập quỹ (Đóng)" e="Filter Advance (Close)"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
        <field name="ngay_ct1" label="1" field="1" aliasName="@DFDFrom" clientDefault="true" allowBlank="false" fieldType="PK" dataType="D">
          <text v="Ngày c/từ (từ/đến)" e="Voucher Date"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" aliasName="@DFDTo" clientDefault="true" allowBlank="false" fieldType="PK" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>
        <field name="so_ct1"  label="1" field="1" operation="a.so_ct &gt;= N'%s'">
          <text v="Số c/từ (từ/đến)" e="Voucher Number"></text>
        </field>
        <field name="so_ct2"  label="" nextRow="false" field="1" operation="a.so_ct &lt;= N'%s'">
          <text v="" e=""></text>
        </field>

		
        <field name="ma_kh" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Mã nhân viên" e="Employee Code"></text>
          <viewInfo lookupType="One" lookupId="vdmnvbh" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_nv" />
        </field>
        <field name="ten_nv" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
		<field name="ma_bp" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" operation="like">
		  <text v="Bộ phận" e="Department"></text>
		  <viewInfo lookupType="One" lookupId="dmbophan" lookupKey="status =1" lookupCheck="1=1" lookupRef="ten_bp" />
		</field>
		<field name="ten_bp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="-">
		  <text v="" e=""></text>
		</field>	
		<field name="ma_pttt" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" operation="like">
          <text v="Ph/th thanh toán" e="Payment Methods"></text>
		  <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status =1" lookupCheck="1=1" lookupRef="ten_pttt" />
		</field>
		<field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="-">
		  <text v="" e=""></text>
		</field>		
        <field name="dien_giai" label="1" field="-" operation="a.dien_giai like N'%%s%'">
          <text v="Diễn giải" e="Voucher Number"></text>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="120,120,120,120"  >
      <fields>
        <field name="ma_unit" viewType="Lookup" inactivate="true" label="1" field="3" >
          <text v="Đơn vị" e="Unit"></text>
          <viewInfo lookupType="Multi" lookupId="sysunit" lookupKey="status = 1 and unit_id in (select unit_id from dbo.ISWIFTFunctionGetUnitIDRight(@@userId, @@admin, ''))" lookupCheck="1 = 1" lookupRef="ten_unit" />
        </field>
        <field name="ten_unit" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="3" valueDefault="-1">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="-1">
                <text v="Chưa đóng" e="Chưa đóng"/>
              </option>
              <option val="9">
                <text v="Đã đóng" e="Đã đóng"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="user_id0" viewType="Combobox" inactivate="true" label="1" field="3" operation="a.user_id0 in (select user_id from sysuserinfo where user_ref like '@@userRef%')" >
          <text v="Lọc theo người sd" e="Filter By User"></text>
          <viewInfo>
            <options>
              <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
              <option val="1">
                <text v="Lọc theo nhân viên đang quản lý" e=""></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>


  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$g11Close(p){
  this.constructor(p);
}
filter$g11Close.prototype = new DirEvent();
filter$g11Close.prototype.afterInit = function(){
  var p = this._dir;
}
filter$g11Close.prototype.beforeAcceptFilter = function (m2, opt, sub) {
  var p = this._dir;
  if (opt._status == -1) sub = ['%s', p.msg('close')]
  else sub = ['%s', p.msg('unclose')]
  return [m2, opt, sub];
}
         ]]>
    </text>
  </js>

  <script>

  </script>
  
  <messages>
    <message val="close">
      <text v="đóng" e="đóng"/>
    </message>
    <message val="unclose">
      <text v="bỏ đóng" e="Cancel Close"/>
    </message>
  </messages>
</dir>