      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[
	select data as id into #id from dbo.ISWIFTFunction$Split(@so_ct, ',')
	select @@fields into #t from v612 a @@join
	  where a.id in (select id from #id)
	  order by a.line, a.id

	select * from #t
	
	select a.dien_giai,a.t_tong_trong,a.t_tong_khoi, a.id id_dh, a.so_ct so_don, a.id_bg,a.id_tg,a.ngay_hl,a.ngay_hld,
	a.ma_noi_di,a.ma_kh_g,a.ma_kh_s,a.ma_noi_dodong,a.ma_noi_giaonhan,a.ma_noi_den,a.ma_hang,a.ma_nv,a.ma_kh,a.ma_nt, a.ma_job,
	b.ten_noi_di,c.ten_noi_den,d.ten_kh ten_hang, e.ten_nv, f.ten_kh, g.ten_kh ten_kh_g, h.ten_kh ten_kh_s, k.ten_noi_dodong, l.ten_noi_giaonhan,v.ten_job 
	from s612 a 
	  left join vdmcangdi b on a.ma_noi_di =b.ma_noi_di 
	  left join vdmcangden c on a.ma_noi_den =c.ma_noi_den
	  left join dmkh d on a.ma_hang = d.ma_kh
	  left join dmnv e on a.ma_nv = e.ma_nv
	  left join dmkh f on a.ma_kh = f.ma_kh
	  left join dmkh g on a.ma_kh_g = g.ma_kh
	  left join dmkh h on a.ma_kh_s = h.ma_kh
	  left join vdmcangdodong k on a.ma_noi_dodong = k.ma_noi_dodong
	  left join vdmcanggiaonhan l on a.ma_noi_giaonhan = l.ma_noi_giaonhan
	  left join vdmjob v on a.ma_job = v.ma_job
	where a.id in (select top 1 id from #id order by id desc) 
	
	drop table #id, #t
         ]]>
          </text>
        </query>
      </script>

    </grid>
   
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$s632CR2Select(p){
  this.constructor(p);
}
filter$s632CR2Select.prototype = new DirEvent();
filter$s632CR2Select.prototype.beforeInit = function(){
  var p = this._dir;
  
}


filter$s632CR2Select.prototype.afterInit = function(){
	var p = this._dir,g = p.grid(0),master = g.ds.get(1), rErr = '';
  p.valForm(['ngay_ct1','ngay_ct2','id', 'ma_noi_di', 'ten_noi_di', 'ma_noi_den','ma_gd', 'ten_noi_den', 'ma_nt', 'unit_id'], [p.options._ngay_ct1,p.options._ngay_ct2,p.options._so_ct,p.options._ma_noi_di, p.options._ten_noi_di,p.options._ma_noi_den,p.options._ma_gd, p.options._ten_noi_den,  p.options._ma_nt, p.options._unit_id]);
	dir$s632CR2SetMaster(p);

}

function dir$s632CR2SetMaster(p) {
  p.request('ma_kh_request', '', ['id']);
}

filter$s632CR2Select.prototype.beforeAcceptFilter = function (m2, opt, sub) {
  var p = this._dir, pa = p.options.parent, g = p.grid(), dt = g.data, master = g.ds.get(1), rErr = '';
 
 var fun = function(){
	//dt.removeRow('[so_luong] == 0');
    //pa.appendGrid(0, dt, p.valForm('xprocess') == "2", 'so_luong', 'so_luong');
	//pa.calcExpressionAll(0, 'so_luong');
    pa.appendForm(master, 0);
    p._close();
  }

  if (rErr.length) {
    $.question('$VoucherRetrieveLimit', null, p, function(q, v){
      q._close();
      if (v) fun();
    });
  } else fun();
  

  //p._close();
  
  return false;
}
         ]]>
    </text>
  </js>
  
  <script>
		<request code="ma_kh_request">
			<text>
			  <![CDATA[
					select top 1 a.id_bg as [!id_bg],a.id_tg as [!id_tg],a.ma_gd as [!ma_gd],a.ngay_hl as [!ngay_hl],a.ngay_hld as [!ngay_hld], a.book_no as [!book_no], a.so_tk as [!so_tk], 
					a.ma_kh as [!ma_kh],a.ma_kh_g as [!ma_kh_g],a.ma_kh_s as [!ma_kh_s],a.ma_nv as [!ma_nv],a.ma_hang as [!ma_hang], a.ma_noi_di as [!ma_noi_di],
					a.ma_noi_den as [!ma_noi_den],b.ten_noi_di as [!ten_noi_di],c.ten_noi_den as [!ten_noi_den],d.ten_kh as [!ten_kh],e.ten_kh as [!ten_hang], 
					f.ten_nv as [!ten_nv],a.dien_giai as [!dien_giai], a.t_tong_trong as [!t_tong_trong], a.t_tong_khoi as [!t_tong_khoi]
				  from s612 a 
				  left join vdmcangdi b on a.ma_noi_di =b.ma_noi_di 
				  left join vdmcangden c on a.ma_noi_den =c.ma_noi_den 
				  left join dmkh d on a.ma_kh =d.ma_kh 
				  left join dmkh e on a.ma_hang =e.ma_kh 
				  left join dmnv f on a.ma_nv = f.ma_nv
				  where a.id = @id
			]]>
			</text>
		  </request>
    
  </script>
  
</dir>