<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">

]>

<dir id="dmcong" table="" height="" fieldKey="ma_cong" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120">
      <fields>
		<field name="ma_cong" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã công" e="Container Code"></text>
			<viewInfo lookupType="One" lookupId="dmcong" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_cong" lookupInfo="dmcong|ma_cong|ten_cong"/>
        </field>
        <field name="ten_cong" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" aliasName=" cast( '' as nvarchar(200)) as " >
           <text v="" e=""></text>
        </field>
		
		<field name="ma_loai" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã loại" e="Type Code"></text>
			<viewInfo lookupType="One" lookupId="dmloaicong" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_loai" lookupInfo="dmloaicong|ma_loai|ten_loai"/>
        </field>
        <field name="ten_loai" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" aliasName=" cast( '' as nvarchar(200)) as " >
           <text v="" e=""></text>
        </field>
		
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="[150]" operation="=" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
			  <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmcong(p){
  this.constructor(p);
}
filter$dmcong.prototype = new DirEvent();
filter$dmcong.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
  <script>

  </script>
</dir>