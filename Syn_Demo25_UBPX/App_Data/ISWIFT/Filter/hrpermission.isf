<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="hrpermission" table="" fieldKey="user_id" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phân quyền" e="Permission"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120">
      <fields>
        <field name="user_id" allowBlank="false" dataType="I" hidden="true" label="" field="1">
          <text v="" e=""></text>
        </field>
        <field name="username" disabled="true" >
          <text v="Tên" e="Name"></text>
          <viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kho" />
        </field>
        <field name="nickname" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="400" columns="120,120,120" >
      <text v="Quyền bộ phận" e=""></text>
      <fields>
        <field name="dept_permission" fieldType="EX" hidden="true" label="1" field="1">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
    <form tabPageIndex="2" gravity="MiddleLeft" height="0" columns="120,120,120" >
      <text v="Quyền chức năng" e=""></text>
      <fields>
        <field name="menu_permission" fieldType="EX" hidden="true" label="1" field="1">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>


  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
