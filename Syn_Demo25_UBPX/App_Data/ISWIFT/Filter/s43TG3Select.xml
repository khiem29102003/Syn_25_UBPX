<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">
]>

<dir id="s43TG3Select" table="" height="" fieldKey="id" voucherCode="TG3" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Chi tiết báo giá được chọn" e="Quotation Entry Detail"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
        <field name="ngay_ct1" label="1" field="1" readOnly="true" aliasName="@DFDFrom" disabled="true" allowBlank="false" dataType="D">
          <text v="Ngày c/từ từ/đến" e="Voucher Date"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" allowBlank="false" disabled="true" inactivate="true" dataType="D" nextRow="false">
          <text v="Ngày đến" e="Voucher Date"></text>
        </field>
        <field name="ma_nt" hidden="true" label="1" field="1">
          <text v="Mã ngoại tệ" e="Ex Code"></text>
        </field>
        <field name="unit_id" dataType="I" hidden="true" label="1" field="1">
          <text v="Đơn vị" e="Unit"></text>
        </field>
		<field name="ma_kh" format="U" label="1" disabled="true"  field="1"  >
          <text v="Mã khách hàng" e="Code"></text>
        </field>
		<field name="ma_so_thue" label="1" field="-" disabled="true"  importable="35" nextRow="false" allowBlank="true">
          <text v="Mã số thuế " e="Tax Code"></text>
        </field>
		<field name="ten_kh" allowBlank="true" label="1" disabled="true"  field="-" importWidth="250" importable="10">
          <text v="Tên khách hàng" e="Name"></text>
        </field>
        <field name="ma_noi_di" viewType="Lookup" label="1" disabled="true" field="1" operation="like">
			<text v="Nơi đi" e="Origin "></text>
			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_noi_di" />
		</field>
		<field name="ten_noi_di" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
			<text v="" e=""></text>
		</field>
		
		<field name="ma_noi_den" viewType="Lookup" disabled="true" label="1" field="1" operation="like">
			<text v="Nơi đến" e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_noi_den"  />
		</field>
		<field name="ten_noi_den" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
			<text v="" e=""></text>
		</field>  
		<field name="so_ct" label="1" field="2" disabled="true">
          <text v="Số báo giá" e="Quot. Number"></text>
        </field>

        <field name="xprocess" label="1" field="2" valueDefault="2" viewType="Combobox">
          <text v="Xử lý" e="Process"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="Thêm vào chi tiết" e="Append To Detail"></text>
              </option>
              <option val="2">
                <text v="Xóa hết chi tiết và thêm mới" e="Delete All Detail And Append New"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="id" dataType="N" hidden="true" fieldType="PK" label="1" field="1"  >
			<text v="ID" e="Code"></text>
		</field>
        
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="350" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="v53" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

 <grids>
    <grid id="v53" table="v53" fieldKey="id, line" order="id, line" allowFilter="true" readOnly="false" allowOrder="true">
      <fields>
		<field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_phi" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã phí" e="Fee"></text>
          <viewInfo lookupType="One" lookupId="dmphi" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_phi" lookupInfo="dmphi|ma_phi|ten_phi" />
        </field>
        <field name="ten_phi" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmphi b on a.ma_phi = b.ma_phi ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
		<field name="ma_cong" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Container" e="Container"></text>
          <viewInfo lookupType="One" lookupId="dmcong" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_cong" lookupInfo="dmcong|ma_cong|ten_cong" />
        </field>
        <field name="ten_cong" width="0" fieldType="EX" inactivate="true" readOnly="true" aliasName="c" join=" left join dmcong c on a.ma_cong = c.ma_cong ">
          <text v="Container" e="Container Name"></text>
        </field>
         <field name="ma_dk_phi" viewType="Combobox" width="120" readOnly="false">
			<text v="Loại phí" e="Fee type"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'LPH' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>
		<field name="ma_dvt" width="80" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Đơn vị" e="Fee"></text>
          <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" />
        </field>
        <field name="ten_dvt" width="0" fieldType="EX" inactivate="true" readOnly="true" aliasName="x" join=" left join dmdvt x on a.ma_dvt = x.dvt ">
          <text v="Tên đơn vị" e="Fee Name"></text>
        </field>
        <field name="so_luong" dataType="N" format="Qty" allowBlank="false" valueDefault="1" width="80" readOnly="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>

       <field name="gia_nt1" dataType="N" inactivate="true" hidden="false" format="FCPrice" width="100" readOnly="true" >
          <text v="Giá mua " e=" Cost Price"></text>
        </field>
        <field name="gia_nt2" dataType="N" format="FCPrice" width="100" readOnly="false" >
          <text v="Giá bán" e="Bill Price"></text>
        </field>
		 <field name="tien_nt1" dataType="N" format="FCAmount" width="100" readOnly="false" >
          <text v="Tiền mua" e="Cost Amount"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="FCAmount" width="100" readOnly="false" >
          <text v="Tiền bán" e="Bill Amount"></text>
        </field>
        <field name="tl_ck" dataType="N" format="Rate" width="100" hidden="true" readOnly="false" >
          <text v="Tl ck(%)" e="Dis.Rate"></text>
        </field>
        <field name="ck_nt" dataType="N" format="FCAmount" width="100" hidden="true" readOnly="false" clientDefault="true" >
          <text v="Ch.khấu " e=" Discount"></text>
        </field>
		 <field name="ma_nt" width="60" allowBlank="true" viewType="Lookup" readOnly="false" >
          <text v="Mã ngoại tệ" e="Currency"></text>
          <viewInfo lookupType="One" lookupId="dmnt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nt" lookupInfo="dmnt|ma_nt|ten_nt" />
        </field>
		 <field name="ten_nt" width="0" fieldType="EX" inactivate="true" readOnly="true" aliasName="d" join=" left join dmnt d on a.ma_nt = d.ma_nt ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
		 <field name="ty_gia" dataType="N" format="Price" width="100" hidden="false" readOnly="false" >
          <text v="Tỷ giá" e="Curr.Rate"></text>
        </field>
        <field name="thue_suat" dataType="N" format="0" width="60" readOnly="false" hidden="false" clientDefault="true" >
          <text v="VAT(%)" e="Tax"></text>
        </field>
        <field name="thue_nt" dataType="N" format="FCAmount" width="100" hidden="true" readOnly="false">
          <text v="Thuế %s" e="%s Tax"></text>
        </field>
        <field name="gia1" dataType="N" format="Price" width="100" hidden="true" inactivate="true" readOnly="true" >
          <text v="Giá chuẩn" e="Std.Price"></text>
        </field>
        <field name="gia2" dataType="N" format="Price" width="0" inactivate="true" readOnly="false" >
          <text v="Giá bán" e="Price"></text>
        </field>
		 <field name="tien1" dataType="N" format="Amount" width="100" inactivate="false" readOnly="false" >
          <text v="Chi phí" e="Total Cost"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100" inactivate="false" readOnly="false" >
          <text v="Doanh thu" e="Total Bill"></text>
        </field>
		<field name="tien_ln" dataType="N" format="Amount" width="100" inactivate="false" readOnly="false" >
          <text v="Lợi nhuận" e="Profit"></text>
        </field>
        <field name="ck" dataType="N" format="Amount" width="100" inactivate="true" hidden="true" readOnly="false">
          <text v="Chiết khấu" e="Discount"></text>
        </field>
        <field name="thue" dataType="N" format="Amount" width="100" inactivate="true" hidden="true" readOnly="false">
          <text v="Thuế" e="Tax"></text>
        </field>
		<field name="dien_giai" width="200" inactivate="true" readOnly="false">
          <text v="Diễn giải" e="Explain"></text>
        </field>
        <field name="id_tg" dataType="N" fieldType="PK" format="0" hidden="true" aliasName="a.id as ">
          <text v="ID BG" e="ID BG"></text>
        </field>
        <field name="so_tg" dataType="N" fieldType="PK" format="0" hidden="true" aliasName="a.so_ct as ">
          <text v="Số báo giá" e="Quot. .No"></text>
        </field>
        <field name="line_tg" dataType="I" fieldType="PK" hidden="true" aliasName="a.line as ">
          <text v="Dòng BG" e="Quot. Line"></text>
        </field>
      </fields>

      <buttons>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[
	select data as id into #id from dbo.ISWIFTFunction$Split(@so_ct, ',')
	select @@fields into #t from v53 a @@join
	  where a.id in (select id from #id)
	  order by a.line, a.id
	  
	  
	---select id_tg, line_tg, sum(a.so_luong) as sl_bao_gia into #sl from v611 a with(index(id_tg)) where id <> @id and id_tg <> 0 and exists(select 1 from #t b where a.id_tg = b.id_tg and a.line_tg = b.line_tg) group by id_tg, line_tg
	---update #t set sl_cl = a.so_luong - isnull(b.sl_bao_gia, 0) from #t a left join #sl b on a.id_tg = b.id_tg and a.line_tg = b.line_tg
	---update #t set so_luong0 = sl_cl
	select * from #t

	select a.ma_noi_di,a.ma_noi_den,a.ma_hang,a.ma_nt,a.ngay_hl, a.ngay_hld,a.ma_gd,id id_tg,a.cvc_yn, a.xk_yn, a.nk_yn, a.pp_yn, a.ds_cong,a.so_ngay_vc,a.ds_ngay,so_ct so_tg, a.t_tong_trong, a.t_tong_khoi,
	b.ten_noi_di,c.ten_noi_den,a.ten_kh,e.ten_hang from s53 a 
	  left join vdmcangdi b on a.ma_noi_di =b.ma_noi_di 
	  left join vdmcangden c on a.ma_noi_den =c.ma_noi_den 
	  left join vdmhangtau e on a.ma_hang = e.ma_hang
	where a.id in (select top 1 id from #id order by id desc) 

	drop table #id, #t
         ]]>
          </text>
        </query>
      </script>

    </grid>
   
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$s43TG3Select(p){
  this.constructor(p);
}
filter$s43TG3Select.prototype = new DirEvent();
filter$s43TG3Select.prototype.beforeInit = function(){
  var p = this._dir;
  
}


filter$s43TG3Select.prototype.afterInit = function(){
  var p = this._dir;
  p.valForm(['ngay_ct1','ngay_ct2','id', 'ma_noi_di', 'ten_noi_di', 'ma_noi_den', 'ten_noi_den','ma_kh','ten_kh', 'ma_nt', 'unit_id'], [p.options._ngay_ct1,p.options._ngay_ct2,p.options._so_ct,p.options._ma_noi_di, p.options._ten_noi_di,p.options._ma_noi_den, p.options._ten_noi_den,p.options._ma_kh, p.options._ten_kh,  p.options._ma_nt, p.options._unit_id]);
	dir$s43TG3SetMaster(p);

}

function dir$s43TG3SetMaster(p) {
  p.request('ma_kh_request', '', ['id']);
}

filter$s43TG3Select.prototype.beforeAcceptFilter = function (m2, opt, sub) {
  var p = this._dir, pa = p.options.parent, g = p.grid(0), dt = g.data, master = g.ds.get(1), rErr = "";
  
 var fun = function(){
	dt.removeRow('[so_luong] == 0');
    pa.appendGrid(0, dt, p.valForm('xprocess') == "2", 'so_luong', 'so_luong');
	pa.calcExpressionAll(0, 'so_luong');
    pa.appendForm(master, 0);
    p._close();
  }
  
  if (rErr.length) {
    $.question('$VoucherRetrieveLimit', null, p, function(q, v){
      q._close();
      if (v) fun();
    });
  } else fun();
  
    return false;
}

         ]]>
    </text>
  </js>
  
  <script>
		<request code="ma_kh_request">
			<text>
			  <![CDATA[
					
					select top 1 a.ma_kh as [!ma_kh],a.ten_kh as [!ten_kh],a.ma_so_thue as [!ma_so_thue],a.ma_hang as [!ma_hang], a.ma_noi_di as [!ma_noi_di], a.ma_noi_den as [!ma_noi_den],
					b.ten_noi_di as [!ten_noi_di],c.ten_noi_den as [!ten_noi_den], e.ten_hang as [!ten_hang],a.so_ct as [!so_ct],a.ds_cong as [!ds_cong]
					from s53 a left join vdmcangdi b on a.ma_noi_di =b.ma_noi_di 
					left join vdmcangden c on a.ma_noi_den =c.ma_noi_den 
					left join dmkh d on a.ma_kh =d.ma_kh 
					left join vdmhangtau e on a.ma_hang =e.ma_hang
					where a.id = @id
					
					drop table #tt
			]]>
			</text>
		</request>
  </script>
</dir>