<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">

]>

<dir id="dmmodelvt" table="" height="" fieldKey="ma_vt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120"  >
      <fields>
		<field name="ma_vt" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã hàng hóa" e="Goods Code"></text>
			<viewInfo lookupType="One" lookupId="dmmodelvt" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_vt" lookupInfo="dmmodelvt|ma_vt|ten_vt"/>
        </field>
        <field name="ten_vt" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" >
           <text v="" e=""></text>
        </field>
		<field name="ma_kho" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã kho" e="Warehouse Code"></text>
			<viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_kho" lookupInfo="dmkho|ma_kho|ten_kho"/>
        </field>
        <field name="ten_kho" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" >
           <text v="" e=""></text>
        </field>
		<field name="ma_model" label="1" field="2" operation="like">
          <text v="Seri Number" e="Seri Number"></text>
        </field>
		<field name="xstatus" viewType="Combobox" inactivate="true" label="1" field="[150]" operation="=">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Tồn trong kho" e="1 - In Stock"></text>
              </option>
              <option val="0">
                <text v="0 - Đã bán" e="0 - Sold"></text>
              </option>
			  <option val="5">
                <text v="5 - Lập chứng từ" e="5 - Vouchers"></text>
              </option>
			  <option val="7">
                <text v="7 - Chuyển kho" e="Transfer Warehouse"></text>
              </option>
			  <option val="9">
                <text v="9 - Hoàn trả" e="9 - Returned Product"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="[150]" operation="=" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
			  <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmmodelvt(p){
  this.constructor(p);
}
filter$dmmodelvt.prototype = new DirEvent();
filter$dmmodelvt.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
  <script>

  </script>
</dir>