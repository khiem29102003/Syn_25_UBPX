<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">
]>

<dir id="thpkhTC1Select" table="" height="" fieldKey="id" voucherCode="AS1" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Chi tiết danh sách khách hàng" e="Customer list details"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
        <field name="ngay_thuchien1" label="1" field="1" aliasName="@DFDFrom" allowBlank="false" dataType="D" disabled="true">
          <text v="Ngày thực hiện từ/đến" e="Voucher Date"></text>
        </field>
        <field name="ngay_thuchien2" label="" field="1" allowBlank="false" inactivate="true" dataType="D" nextRow="false" disabled="true">
          <text v="Ngày đến" e="Voucher Date"></text>
        </field>
        <field name="unit_id" dataType="I" hidden="true" label="1" field="1">
          <text v="Đơn vị" e="Unit"></text>
        </field>
        <field name="xprocess" label="1" field="2" valueDefault="2" viewType="Combobox">
          <text v="Xử lý" e="Process"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="Thêm vào chi tiết" e="Append To Detail"></text>
              </option>
              <option val="2">
                <text v="Xóa hết chi tiết và thêm mới" e="Delete All Detail And Append New"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
	
    <form tabPageIndex="1" gravity="MiddleLeft" height="350" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="thpkhct" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

 <grids>
    <grid id="thpkhct" table="thpkhct" fieldKey="id, line" order="id, line" allowFilter="true" readOnly="false" allowOrder="true">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
		<field name="chon_yn" dataType="B" width="80" valueDefault="1" readOnly="false" >
          <text v="Chọn" e="Check"></text>
        </field>
		 <field name="ma_so_thue" width="120" allowBlank="false" readOnly="false" >
          <text v="Mã số thuế" e="Tax Code"></text>
        </field>
        <field name="ten_kh" width="300" inactivate="true" readOnly="true">
          <text v="Họ tên" e="Fullname"></text>
        </field>
		<field name="dia_chi" width="300" inactivate="true" readOnly="true">
          <text v="Địa chỉ" e="Address"></text>
        </field>
      </fields>

      <buttons>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>
   
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  
  <script>
		<request code="tien_request">
			<text>
			  <![CDATA[<enc>yR1E57ukVCLmcZS/15gUZn0+Lgqw3a98UMRK7vcaMNgmjsEeAwDO3XRxm2E/aQlNmCAoaM5oUkCRVCtdzP9iZlhA2qhsziUgft1NfNWhP6fLemFhDROIqqC9SWqMxato</enc>]]>
			</text>
		</request>
  </script>
</dir>