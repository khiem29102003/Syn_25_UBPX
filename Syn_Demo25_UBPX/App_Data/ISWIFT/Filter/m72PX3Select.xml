<dir id="m72CR1Select" table="" height="" fieldKey="id" voucherCode="CR1" dirViewType="Dialog" readOnly="true" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Chi tiết phiếu bán được chọn" e="Quotation Entry Detail"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
        <field name="ngay_ct1" label="1" field="1" readOnly="true" aliasName="@DFDFrom" disabled="true" allowBlank="false" dataType="D">
          <text v="Ngày c/từ từ/đến" e="Voucher Date"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" allowBlank="false" disabled="true" inactivate="true" dataType="D" nextRow="false">
          <text v="Ngày đến" e="Voucher Date"></text>
        </field>
		<field name="ma_job" label="1" field="1" disabled="true">
          <text v="Mã đơn hàng" e="Order Code"></text>
        </field>
		<field name="so_job_dh" label="" field="1" nextRow="false" disabled="true">
          <text v="Số đơn hàng" e="Order Number"></text>
        </field>
		<field name="xprocess" label="1" field="2" valueDefault="2" viewType="Combobox">
          <text v="Xử lý" e="Process"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="Thêm vào chi tiết" e="Append To Detail"></text>
              </option>
              <option val="2">
                <text v="Xóa hết chi tiết và thêm mới" e="Delete All Detail And Append New"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="id" dataType="N" hidden="true" fieldType="PK" label="1" field="1"  >
			 <text v="ID" e="Code"></text>
		</field>
		
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="350" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="d54" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

 <grids>
    <grid id="d54" table="d54" fieldKey="id, line" order="id, line" allowFilter="true" readOnly="false" allowOrder="true">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_vt" width="100" allowBlank="true" viewType="Lookup" readOnly="false" disabled="true" >
          <text v="Mã phí" e="Fee Code"></text>
          <viewInfo lookupType="One" lookupId="dmvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_vt" lookupInfo="dmvt|ma_vt|ten_vt" />
        </field>
        <field name="ten_vt" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmvt b on a.ma_vt = b.ma_vt ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>

        <field name="dvt" width="60" readOnly="false" allowBlank="true" viewType="Lookup" aliasName="a" disabled="true">
          <text v="Đvt" e="UOM"></text>
          <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" />
        </field>
        <field name="ten_dvt" width="120" inactivate="true" readOnly="true" hidden="true" aliasName="c" join=" left join dmdvt c on a.dvt = c.dvt ">
          <text v="Tên đvt" e="UOM"></text>
        </field>
        <field name="so_luong0" dataType="N" format="Amount" width="100" readOnly="false" disabled="false" aliasName="0*a.so_luong as " >
          <text v="&lt;b&gt;Sl lấy&lt;/b&gt;" e="&lt;b&gt;Qty Input&lt;/b&gt;"></text>
        </field>
		 <field name="so_luong" dataType="N" format="ExRate" valueDefault="1" readOnly="false" allowBlank="false" width="100" disabled="true">
          <text v="Số lượng" e="Quantity"></text>
        </field>
		<field name="sl_cl" dataType="N" format="Amount" width="100" aliasName="0*a.so_luong as " disabled="true">
          <text v="&lt;b&gt;Sl còn lại&lt;/b&gt;" e="PO Qty"></text>
        </field>
		
        <field name="gia_nt2" dataType="N" format="FCPrice" width="100" readOnly="false" disabled="true" >
          <text v="Giá bán" e="%s Price"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="ExRate" width="100" readOnly="false" disabled="true">
          <text v="Thành tiền" e="Amount"></text>
        </field>
		
		 <field name="ma_nt" width="70" allowBlank="false" viewType="Lookup" valueDefault="VND" readOnly="false" disabled="true">
          <text v="Mã NT" e="Currency"></text>
          <viewInfo lookupType="One" lookupId="dmnt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nt" lookupInfo="dmnt|ma_nt|ten_nt" />
        </field>
		 <field name="ten_nt" width="0" fieldType="EX" inactivate="true" readOnly="true" aliasName="nt" join=" left join dmnt nt on a.ma_nt = nt.ma_nt ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
		 <field name="ty_gia" dataType="N" format="ExRate" width="100" valueDefault="1" hidden="false" readOnly="false" disabled="true" >
          <text v="Tỷ giá" e="Curr.Rate"></text>
        </field>
		
        <field name="tl_ck" dataType="N" format="Rate" width="100" readOnly="false" hidden="true" disabled="true" >
          <text v="Tl ck(%)" e="Dis.Rate"></text>
        </field>
        <field name="ck_nt" dataType="N" format="FCAmount" width="100" readOnly="false" clientDefault="true" hidden="true" disabled="true" >
          <text v="Ch.khấu %s" e="%s Discount"></text>
        </field>

        <field name="thue_nt" dataType="N" format="FCAmount" width="100" readOnly="false" hidden="true" disabled="true">
          <text v="Thuế %s" e="%s Tax"></text>
        </field>

        <field name="gia2" dataType="N" format="Price" width="100" inactivate="true" readOnly="false" hidden="true" disabled="true">
          <text v="Giá bán VND" e="Price"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false"  disabled="true">
          <text v="Tiền VND" e="Amount"></text>
        </field>
        <field name="ck" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false" hidden="true" disabled="true">
          <text v="Chiết khấu" e="Discount"></text>
        </field>
		<field name="thue_suat" dataType="N" format="Rate" width="100" readOnly="false" clientDefault="true" hidden="false" disabled="true">
          <text v="Thuế suất(%)" e="Tax"></text>
        </field>
        <field name="thue" dataType="N" format="Amount" width="100" inactivate="false" readOnly="false" disable="false" disabled="true">
          <text v="Thuế" e="Tax"></text>
        </field>
		
		<field name="tt" dataType="N" format="Amount" width="100" hidden="false" valueDefault="0" inactivate="false" readOnly="true" disabled="true">
          <text v="Tổng cộng" e="Total"></text>
        </field>
		<field name="tt_nt" dataType="N" format="FCAmount" width="100" hidden="true" inactivate="false" readOnly="true" disabled="true">
          <text v="" e="Total "></text>
        </field>
		 <field name="sl_hd" dataType="N" inactivate="true" hidden="true" format="Amount" width="100" copy="false" aliasName="0*so_luong as " >
          <text v="Sl HĐ" e="Inv. Qty"></text>
        </field>
        <field name="id_hd" dataType="N" inactivate="true" hidden="true" copy="false" width="80" aliasName="a.id as ">
          <text v="ID HD" e="ID HD"></text>
        </field>
        <field name="so_ct_hd" width="100" fieldType="EX"  hidden="true" copy="false" readOnly="true" inactivate="true" link="m54|id_hd as id" aliasName="cast('' as nvarchar(3000)) as " >
          <text v="Số HD" e="Issue No"></text>
        </field>
        <field name="line_hd" dataType="I" width="70"  hidden="true" copy="false" inactivate="true" aliasName="a.line as ">
          <text v="Dòng HD" e="Issue Line"></text>
        </field>
		<field name="so_hd" inactivate="false" hidden="true" width="150" copy="false" disabled="true" readOnly="false">
          <text v="Số Hóa Đơn" e="Invoice Number"></text>
        </field>
		<field name="ngay_hd" width="150" dataType="D" readOnly="false" disabled="true" >
			<text v="Ngày Hóa Đơn " e="Effective date"></text>
		</field>
		<field name="dien_giai" width="300" inactivate="false" readOnly="false" disabled="true">
          <text v="Diễn giải" e="Explain"></text>
        </field>
      </fields>

      <buttons>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[
			
				select data as id into #id from dbo.ISWIFTFunction$Split(@id_m54, ',')
				select @@fields into #t from d54 a @@join
				  where a.id in (select id from #id)
				  order by a.line, a.id
				  
				select id_hd, line_hd, sum(a.so_luong) as sl_phieu_ban into #sl from d72 a with(index(id_hd)) where id <> @id and id_hd <> 0 and exists(select 1 from #t b where a.id_hd = b.id_hd and a.line_hd = b.line_hd) group by id_hd, line_hd
				update #t set sl_cl = a.so_luong - isnull(b.sl_phieu_ban, 0) from #t a left join #sl b on a.id_hd = b.id_hd and a.line_hd = b.line_hd
				update #t set so_luong0 = sl_cl
				select * from #t where sl_cl <> 0
				
				select 1 from m54 a where a.id in (select top 1 id from #id order by id desc)

				drop table #id
				drop table #t
				drop table #sl
	

         ]]>
          </text>
        </query>
      </script>

    </grid>
   
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$m72CR1Select(p){
  this.constructor(p);
}
filter$m72CR1Select.prototype = new DirEvent();
filter$m72CR1Select.prototype.beforeInit = function(){
  var p = this._dir;
  
}


filter$m72CR1Select.prototype.afterInit = function(){
	var p = this._dir,g = p.grid(0),master = g.ds.get(1), rErr = '';
  p.valForm(['ngay_ct1','ngay_ct2','id_dh', 'ma_job', 'so_job_dh'], [p.options._ngay_ct1,p.options._ngay_ct2,p.options._id_dh,p.options._ma_job, p.options._so_job_dh]);
	dir$m72CR1SetMaster(p);

}

function dir$m72CR1SetMaster(p) {
  //p.request('ma_kh_request', '', ['id']);
}

filter$m72CR1Select.prototype.beforeAcceptFilter = function (m2, opt, sub) {
  var p = this._dir, pa = p.options.parent, g = p.grid(), dt = g.data, master = g.ds.get(1), rErr = '';
 
 var fun = function(){
	dt.removeRow('[so_luong0] == 0');
    pa.appendGrid(0, dt, p.valForm('xprocess') == "2", 'so_luong', 'so_luong0');
	pa.calcExpressionAll(0, 'so_luong');
    //pa.appendForm(master, 1);
    p._close();
  }

  if (rErr.length) {
    $.question('$VoucherRetrieveLimit', null, p, function(q, v){
      q._close();
      if (v) fun();
    });
  } else fun();
  
  //p._close();
  
  return false;
}
         ]]>
    </text>
  </js>
  
  <script>
		<request code="ma_kh_request">
			<text>
			  <![CDATA[
			  
			  		DECLARE @ds_cong VARCHAR(4000)  
					SELECT distinct ma_cong into #tt FROM v61 a where a.id = @id
					SELECT @ds_cong = COALESCE(@ds_cong + ', ','') + ltrim(rtrim(ma_cong)) FROM #tt
					
					select top 1 a.ma_kh [!ma_kh],a.ma_hang [!ma_hang], a.ma_noi_di [!ma_noi_di], a.ma_noi_den [!ma_noi_den], a.ma_job [!ma_job], a.so_job [!so_job],
					@ds_cong as [!ds_cong],b.ten_noi_di [!ten_noi_di],c.ten_noi_den [!ten_noi_den],d.ten_kh [!ten_kh],e.ten_hang [!ten_hang], a.dien_giai [!dien_giai]
				  from s61 a 
				  left join vdmcangdi b on a.ma_noi_di =b.ma_noi_di 
				  left join vdmcangden c on a.ma_noi_den =c.ma_noi_den 
				  left join dmkh d on a.ma_kh =d.ma_kh 
				  left join vdmhangtau e on a.ma_hang =e.ma_hang 
				  where a.id = @id
			]]>
			</text>
		  </request>
    
  </script>
  
</dir>