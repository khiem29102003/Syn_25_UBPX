<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
  <!ENTITY ReportFilterItemGroup SYSTEM "..\Include\XML\ReportFilterItemGroup.xml">
  <!ENTITY ReportFilterCustomerGroup SYSTEM "..\Include\XML\ReportFilterCustomerGroup.xml">
  <!ENTITY ReportFilterStockType SYSTEM "..\Include\XML\ReportFilterStockType.xml">
  <!ENTITY ReportJSLoading SYSTEM "..\Include\XML\ReportJSLoading.xml">
  <!ENTITY ReportFilterUnit SYSTEM "..\Include\XML\ReportFilterUnitHidden.xml">
  <!ENTITY ReportFiltering SYSTEM "..\Include\XML\ReportFiltering.xml">
  <!ENTITY ReportDataAnalysisStruct SYSTEM "..\Include\XML\ReportDataAnalysisStruct.xml">
]>

<dir id="ss_bcdttt" table="" height="" fieldKey="id" dirViewType="Dialog" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
       <field name="ngay_ct1" label="1" field="1" aliasName="@DFDFrom" clientDefault="true" allowBlank="false" dataType="D">
          <text v="Ngày từ/đến" e="Date From/To"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" aliasName="@DFDTo" clientDefault="true" allowBlank="false" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>
		<field name="ma_job1" clientDefault="true" viewType="Lookup" label="1" field="1" allowBlank="true"  setype="1">
          <text v="Mã/Số Đơn hàng" e="Employee Code"></text>
          <viewInfo lookupType="One" lookupId="vdmjob" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_job1" lookupInfo="vdmjob|ma_job1|ten_job1" />
        </field>
        <field name="ten_job1" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="so_ct2"  label="" nextRow="false" field="1" >
          <text v="" e=""></text>
        </field>
		<field name="ma_ct" viewType="Combobox" inactivate="true" label="1" field="1" operation="=">
          <text v="Loại đơn hàng" e="Filter By User"></text>
          <viewInfo>
            <options>
              <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
              <option val="FCL">
                <text v="Hàng FCL" e="FCL Marine"></text>
              </option>
			  <option val="LCL">
                <text v="Hàng LCL" e="LCL Marine"></text>
              </option>
				<option val="AIR">
                <text v="Hàng AIR" e="AIR Marine"></text>
              </option>
			  <option val="Oth">
                <text v="Hàng Khác" e="OTHER Marine"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="ma_kh" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Khách hàng" e="Customer"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>		
		<field name="ma_xe" viewType="Lookup" label="1" field="1" operation="like" >
          <text v="Mã xe" e="Vehicle Code"></text>
          <viewInfo lookupType="One" lookupId="dmxe" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_xe" />
        </field>
        <field name="ten_xe" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
		<field name="ma_nvbh" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Nhân viên" e="Staff"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status = 1 and nv_yn = 1" lookupCheck="1 = 1" lookupRef="ten_nvbh" />
        </field>
        <field name="ten_nvbh" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
		&ReportFilterUnit;
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc>q6iCSLCowTW5wC/k2hMF+wbcxXgl1hD8zCD2PKzw09vLsSwVSN6J+0NsC66KewKAK3iCR1IenoX7sscNVZ269zmVwlNuLbpt8A2s9yVheaRF4Q/poE7CymnkFbos5o/+/8GKd0eNKidtR9pOar5IGJyziXet4gBS05NtBfNUhm7EeoYCjW0gNiI/jcqKf60k1TffCgRAdYN8fzZCswyUxg==</enc>]]>
    </text>
  </js>

  <script>
    <processing>
      <text>
        <![CDATA[<enc>TN45BLVvlQZWD1bhImJFui3B6za/B5OT7CPnricv7F9VxXndoQI7mrkZhe35dbbb</enc>]]>
      </text>
    </processing>
    &ReportJSLoading;
  </script>
</dir>