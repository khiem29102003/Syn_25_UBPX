<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="dmvb_tm" table="" height="" fieldKey="ma_vb" dirViewType="Dialog" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter Condition" color="red"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120"  >
      <fields>
	    <field name="ngay_ct1" label="1" field="1" aliasName="@DFDFrom" clientDefault="true" allowBlank="false" fieldType="PK" dataType="D">
			<text v="Ngày phát hành (từ/đến)" e="Issue Date (From/To)"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" aliasName="@DFDTo" clientDefault="true" allowBlank="false" fieldType="PK" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>

		<field name="ma_vb" label="1" field="-" inactivate="false" disabled="false" readOnly="false" operation="ma_vb like N'%%s%'" >
			<text v="Mã tài liệu mẫu" e="Template document code"></text>
		</field>
		<field name="ten_vb"  label="1" field="-" inactivate="false" disabled="false" readOnly="false" operation="ten_vb like N'%%s%'">
			<text v="Tên tài liệu mẫu" e="Template document name"></text>
		</field>
		<field name="ma_nvb" viewType="Lookup" label="1" field="1" operation="like">
			<text v="Nhóm tài liệu" e="Document group"></text>
          <viewInfo lookupType="One" lookupId="dmnhomvb" lookupKey="status = 1 and ma_loai = 'TM'" lookupCheck="1=1" lookupRef="ten_nvb" lookupInfo="dmnhomvb|ma_nvb|ten_nvb" />
        </field>
        <field name="ten_nvb" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ky_hieu" label="1" field="1" inactivate="false"  operation="ky_hieu like N'%%s%'">
			<text v="Ký hiệu" e="Symbol"></text>
		</field>
		<field name="ma_tg" label="1" field="1" viewType="Lookup" operation="like"> 
		  <text v="Thời hạn lưu trữ" e="Retention period"></text>
		  <viewInfo lookupType="One" lookupId="dmtgluuvb" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_tg" lookupInfo="dmtgluuvb|ma_tg|ten_tg" />
		</field>
		<field name="ten_tg" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="false" label="" field="[360]" aliasName="cast('' as nvarchar(4000)) as ">
		  <text v="" e=""></text>
		</field>
		<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" operation="=" >
		  <text v="Trạng thái" e="Status"></text>
		  <viewInfo>
			<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
			</options>
		  </viewInfo>
		</field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmvb_tm(p){
  this.constructor(p);
}
filter$dmvb_tm.prototype = new DirEvent();
filter$dmvb_tm.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
<script>
	
</script>
</dir>