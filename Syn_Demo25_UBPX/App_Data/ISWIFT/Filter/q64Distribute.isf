<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
  <!ENTITY ReportFilterCustomerGroup SYSTEM "..\Include\XML\ReportFilterCustomerGroup.xml">
]>

<dir id="q64Distribute" table="" height="" fieldKey="ma_nh" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120"  >
      <fields>
        <field name="ngay_ct1" label="1" field="1" aliasName="@DFDFrom" clientDefault="true" allowBlank="false" dataType="D">
          <text v="Ngày từ/đến" e="Date From/To"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" aliasName="@DFDTo" clientDefault="true" allowBlank="false" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>
        <field name="ma_nt" viewType="Lookup" label="1" field="1" operation="=">
          <text v="Mã ngoại tệ" e="EX"></text>
          <viewInfo lookupType="One" lookupId="dmnt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nt" lookupInfo="dmnt|ma_nt|ten_nt" lookupExactValue="1" />
        </field>
        <field name="ten_nt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_kh" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Mã nhà cung cấp" e="Customer"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        &ReportFilterCustomerGroup;
        <field name="pb_yn" viewType="Combobox" inactivate="true" valueDefault="0" label="1" operation="=" field="3">
          <text v="Loại phiếu chi" e=""></text>
          <viewInfo>
            <options>
              <option val="">
                <text v="Tất cả" e="All"/>
              </option>
              <option val="0">
                <text v="Chưa phân bổ hết" e=""/>
              </option>
              <option val="1">
                <text v="Đã phân bổ hết" e=""/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="xu_ly" viewType="Combobox" inactivate="true" valueDefault="1" label="1" field="3">
          <text v="Xử lý" e="Process"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Người dùng tự phân bổ" e=""/>
              </option>
              <option val="1">
                <text v="Phân bổ tự động theo ngày hóa đơn, số hóa đơn" e=""/>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc>pcwp7UTz12Cf+vbwRyw5lPmAFxMes9NoTcMtX74LosBaUunUu1sKkmB6f+4OWzun3SINDWXc+a2UnfpQF9ZCW/X7bFoUTj3gygmBaPF2sPqkmBKTCjC8HOvQgRLv/ZTycdpFgPCQWvV0gcIwheg4ko6/TVJ+8nlvZUKDgCTFBDMz6A/3Uc3oEbAVEsucOWr0Lu5vl7vRo9HQZBP9kNicOFZYzKawM1KAtgBHIzVXAh+wanFYnjhLNHBc3z/fIM4D</enc>]]>
    </text>
  </js>

</dir>