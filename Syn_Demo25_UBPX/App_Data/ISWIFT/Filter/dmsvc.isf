<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">

]>

<dir id="dmsvc" table="" height="" fieldKey="ma_svc" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120"  >
      <fields>
		<field name="ma_svc" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã SVC" e="SVC Code"></text>
			<viewInfo lookupType="One" lookupId="dmsvc" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_svc" lookupInfo="dmsvc|ma_svc|ten_svc"/>
        </field>
        <field name="ten_svc" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" >
           <text v="" e=""></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="[150]" operation="=" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
			  <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc>UBbhZyf4BdpatUcgmmWwb4S+FFg4oVzmd/svApuM/JDgFxxkPuYuBYA+Dd6lQvS3oy4znt3Xek1BhBdYuGdRSKitGjLCXAqJzp3rZcyTpXZn47lMuHS15YMU2yQOf/K5mfjMtNjhR7y5uH0gsBNhI65sfFg+Byi+3bPZxf6j5uULEFz1UZcIdSF5HAlhB/W0</enc>]]>
    </text>
  </js>
  <script>

  </script>
</dir>