<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY ReportFilterItemGroup SYSTEM "..\Include\XML\ReportFilterItemGroup.xml">
  <!ENTITY ReportFilterCustomerGroup SYSTEM "..\Include\XML\ReportFilterCustomerGroup.xml">
  <!ENTITY ReportFilterStockType SYSTEM "..\Include\XML\ReportFilterStockType.xml">
  <!ENTITY ReportJSLoading SYSTEM "..\Include\XML\ReportJSLoading.xml">
  <!ENTITY ReportFilterUnit SYSTEM "..\Include\XML\ReportFilterUnit.xml">
  <!ENTITY ReportFiltering SYSTEM "..\Include\XML\ReportFiltering.xml">
  <!ENTITY PivotScript SYSTEM "..\Include\Script\ReportAnalysisJS.js">

]>

<dir id="analysisSalesData" dirViewType="Dialog" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phân tích dữ liệu bán hàng" e=""></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120" >
      <fields>
        <field name="ngay_ct1" label="1" field="1" aliasName="@DFDFrom" clientDefault="true" allowBlank="false" dataType="D">
          <text v="Ngày từ/đến" e="Date From/To"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" aliasName="@DFDTo" clientDefault="true" allowBlank="false" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>
        <field name="data_analysis_struct" label="1" field="[360]" inactivate="true" aliasName="@" viewType="Combobox">
          <text v="Mẫu phân tích DL" e="Data Analysis Form"></text>
          <viewInfo>
            <options cache="false" query="select id, formname%l from sysreportpivot where (user_id in (0, @@userId) or form_type = 1) and controller = '@@controller' order by user_id, id">
              <option val="">
                <text v="Không phân tích" e="No Analysis"></text>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="btn_save_new" nextRow="false" label="" field="[80]" viewType="Command">
          <text v="Lưu mới" e="Save New"></text>
        </field>
        <field name="btn_save_overwrite" nextRow="false" label="" field="[80]" viewType="Command">
          <text v="Lưu đè" e="Overwrite"></text>
        </field>
        <field name="btn_delete_form" nextRow="false" label="" field="[80]" viewType="Command">
          <text v="Xóa" e="Delete"></text>
        </field>
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="520" columns="100,100,100" >
      <text v="Mẫu phân tích" e=""></text>
      <fields>
        <field name="data_struct_label" label="3" field="">
          <text v="Cột phân tích" e="Column"></text>
        </field>
        <field name="data_struct" cellCss="height: 420px;" label="" field="[270]" viewType="List">
          <text v="Danh sách" e="List"></text>
          <viewInfo listType="Multi"></viewInfo>
        </field>
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleRight" columns="100, 50, 50, 50, 50, 50, 100" >
      <fields>
        <field name="data_rows_label" blank="[220]" label="2" field="">
          <text v="Dữ liệu dòng" e="Dữ liệu dòng"></text>
        </field>

        <field name="btn_remove_rows" label="" field="[50]" viewType="Command">
          <text v="Xóa" e="Xóa"></text>
        </field>
        <field name="btn_add_rows"  nextRow="false"  label="" field="[90]" viewType="Command">
          <text v="Thêm" e="Thêm"></text>
        </field>

        <field name="btn_moveup_rows" nextRow="false" label="" field="[40]" viewType="Command">
          <text v="Lên" e="Up"></text>
        </field>
        <field name="btn_movedown_rows" nextRow="false" label="" field="[40]" viewType="Command">
          <text v="Xuống" e="Down"></text>
        </field>

        <field name="data_rows" nextRow="false" label="" field="[220]" viewType="List" cellCss="height:229px;">
          <text v="Danh sách" e="List"></text>
          <viewInfo listType="Multi">
          </viewInfo>
        </field>

        <field name="data_columns_label" label="[220]" field="">
          <text v="Dữ liệu cột" e="Dữ liệu cột"></text>
        </field>
        <field name="data_pivot_label" label="[220]" field="" nextRow="false">
          <text v="Giá trị" e="Giá trị xoay"></text>
        </field>

        <field name="data_columns" label="" field="[220]" viewType="List" cellCss="height:150px;">
          <text v="Danh sách" e="List"></text>
          <viewInfo listType="Multi">
          </viewInfo>
        </field>
        <field name="data_pivot" label="" field="[220]" viewType="List" cellCss="height:150px;"  nextRow="false">
          <text v="Danh sách" e="List"></text>
          <viewInfo listType="Multi">
          </viewInfo>
        </field>
      </fields>
    </form>
    <form tabPageIndex="2" gravity="MiddleLeft" height="500" columns="120,120,120,120,120" >
      <text v="Thông tin mẫu" e="Form Info"></text>
      <fields>
        <field name="name" label="1" field="3" >
          <text v="Tên mẫu" e="Name"></text>
        </field>
        <field name="name2" label="1" field="3" >
          <text v="Tên khác" e="Name 2"></text>
        </field>
        <field name="form_type" label="1" viewType="Combobox" field="3" >
          <text v="Loại mẫu"  e="Form Type"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Mẫu cho người sử dụng hiện tại"  e="Form For Current User"></text>
              </option>
              <option val="1">
                <text v="Mẫu chung cho tất cả người dùng"  e="Common Form For All User"></text>
              </option>
            </options>
          </viewInfo>
        </field>
        &ReportFiltering;
      </fields>
    </form>
    <form tabPageIndex="3" gravity="MiddleLeft" height="500" columns="120,120,120,120,120" >
      <text v="Lọc dữ liệu" e="Filter"></text>
      <fields>
        <field name="ma_kh" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Mã khách hàng" e="Customer"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        &ReportFilterCustomerGroup;
        <field name="ma_vt" viewType="Lookup" operation="like" label="1" field="1">
          <text v="Mã vật tư" e="Item"></text>
          <viewInfo lookupType="One" lookupId="dmvt" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_vt" />
        </field>
        <field name="ten_vt" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        &ReportFilterItemGroup;
        <field name="ma_kho" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Mã kho" e="Site"></text>
          <viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kho" />
        </field>
        <field name="ten_kho" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="ma_gd" viewType="Lookup" label="1" field="3" operation="exists(select 1 from vdmgd x where a.ma_ct = x.ma_ct and a.ma_gd = x.ma_gd and charindex(x.code, '%s') > 0) ">
          <text v="Mã giao dịch" e="Transaction"></text>
          <viewInfo lookupType="Multi" lookupId="vdmgd" lookupKey="status = 1 and nh_ct in ('BH1', 'BH2', 'BH3')" />
        </field>
        &ReportFilterUnit;
        <field name="nh_ct" label="1" viewType="Combobox" field="3" valueDefault="BH1,BH2,BH3" operation="ma_ct in (select ma_ct from dmct where charindex(nh_ct, '%s') &gt; 0)" >
          <text v="Phân hệ"  e="Source"></text>
          <viewInfo>
            <options>
              <option val="">
                <text v="Tất cả"  e="All"></text>
              </option>
              <option val="BH1,BH2,BH3">
                <text v="Bán hàng"  e="Sales"></text>
              </option>
              <option val="TK">
                <text v="Tồn kho"  e="Stock"></text>
              </option>
            </options>
          </viewInfo>
        </field>
        &ReportFilterStockType;
      </fields>
    </form>

    <form tabPageIndex="4" gravity="MiddleLeft" height="500" columns="120,120,120,120,120" >
      <text v="Lọc khác" e="Other Filter"></text>
      <fields>
        <field name="ma_khon" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Mã kho đ/c" e="Site Transfer"></text>
          <viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_khon" />
        </field>
        <field name="ten_khon" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="ma_lo" viewType="Lookup" operation="like" label="1" field="1">
          <text v="Mã lô" e="Lot"></text>
          <viewInfo lookupType="One" lookupId="dmlo2" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_lo" />
        </field>
        <field name="ten_lo" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="ma_vi_tri" viewType="Lookup" operation="like" label="1" field="1">
          <text v="Mã vị trí" e="Position"></text>
          <viewInfo lookupType="One" lookupId="dmvitri" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_vi_tri" />
        </field>
        <field name="ten_vi_tri" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="so_ct1"  label="1" field="1" operation="a.so_ct &gt;= N'%s'">
          <text v="Số c/từ (từ/đến)" e="Voucher Number"></text>
        </field>
        <field name="so_ct2"  label="" nextRow="false" field="1" operation="a.so_ct &lt;= N'%s'">
          <text v="" e=""></text>
        </field>
        <field name="dien_giai" label="1" field="3" operation="a.dien_giai like N'%%s%'">
          <text v="Diễn giải" e="Voucher Number"></text>
        </field>
      </fields>
    </form>
  </forms>

  <buttons>
    <button id="filterOk" default="true">
      <text v="Xem" e="View"></text>
    </button>
    <button id="filterCancel">
      <text v="$CancelLabel" e="$CancelLabel"></text>
    </button>
  </buttons>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>&PivotScript;
    </text>
  </js>

  <css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>

  <script>
    <request code="GetRight">
      <text>
        <![CDATA[<enc>GJgBVkOd9xy3In+SUACpOGaLg5aHMTMR/UOodHw040klChZd6w51/1i7FXMiZJVOmjj24HqR8UgEykBcvsH7z9YYRdHIIf/uUP7QWJWjMYGl2LDG5IG5g2pZmjxydsWl</enc>]]>
      </text>
    </request>

    <request code="GET">
      <text>
        <![CDATA[<enc>z0V0MGDsEwBAF9rbikyhSJjB4KC/JqwRs1g4GYfPqYHMXuJlJlnjGkI5LuyV5ZgF9BBvtchbfTrPeOZok8wxj6lodyjf0sneFuqtkIon7wYqtLfU4P6Pv/a1CTrWCwCL48CS18czCSQLdidWv5yVidurn8mMCR4xOJkTg4cfDEA=</enc>]]>
      </text>
    </request>

    <request code="NEW">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>

    <request code="EDIT">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>

    <processing>
      <text>
        <![CDATA[<enc>TN45BLVvlQZWD1bhImJFui3B6za/B5OT7CPnricv7F9VxXndoQI7mrkZhe35dbbb</enc>]]>
      </text>
    </processing>
    <loading code="2">
      <text>
        <![CDATA[<enc>yJZ+MPHTQvtTildbOwhS5Ra4ye0h8lm3Vnsfj7pLxFPN/kNPKQl3St15wrWUQdm5ziGd6MCvdBmqg1KW4XD/iAMBcGza7xm7y/6g2ItgUuWQmv9bOzc9X1lCtUgkyIyi2mNumEByVmiDob/Y1t9WGzPYuFdcVbCODOyUFxewJNEbFYjFzJiogB0JeDqgwNzF1enfkdC9bl5ykN+vemlTOnog1W8f5Q1CPpYr2qbRS4U=</enc>]]>
      </text>
    </loading>
  </script>

  <messages>
    <message val="inputNewName">
      <text v="Nhập tên mẫu mới" e="Input New Name"/>
    </message>
    <message val="formName">
      <text v="Tên mẫu mới" e="New Name"/>
    </message>
    <message val="invalidColumns">
      <text v="Chưa thêm cột dữ liệu hoặc danh sách các cột hiện tại không hợp lệ" e="Invalid Columns"/>
    </message>
    <message val="invalidDataColumns">
      <text v="Chỉ thêm các cột kiểu chuỗi vào vùng dữ liệu cột" e="Invalid Value Columns"/>
    </message>
    <message val="invalidDataPivots">
      <text v="Chỉ thêm các cột kiểu số vào vùng giá trị" e="Invalid Value Columns"/>
    </message>
    <message val="limitDataColumns">
      <text v="Số lượng cột phân tích bị giới hạn" e="Limit Pivot Columns"/>
    </message>
  </messages>

</dir>