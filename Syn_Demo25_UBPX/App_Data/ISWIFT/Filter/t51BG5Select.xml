<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">
]>

<dir id="t51BG5Select" table="" height="" fieldKey="id" voucherCode="VD1" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Chi tiết đơn hàng được chọn" e="Sales Orders Detail"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
        <field name="ma_kh" viewType="Lookup" disabled="true" label="1" field="1">
          <text v="Mã đối tượng" e="Customer"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
        <field name="so_ct" label="1" field="2" disabled="true">
          <text v="Số hợp đồng" e="Contract"></text>
        </field>
        <field name="xprocess" label="1" field="2" valueDefault="2" viewType="Combobox">
          <text v="Xử lý" e="Process"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="Thêm vào chi tiết" e="Append To Detail"></text>
              </option>
              <option val="2">
                <text v="Xóa hết chi tiết và thêm mới" e="Delete All Detail And Append New"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="350" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="d52" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
    <form tabPageIndex="2" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi phí" e="Fee"></text>
      <fields>
        <field name="f52" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi phí" e="Fee"></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="d52" table="d52" fieldKey="id, line" order="id, line" allowFilter="true" readOnly="false" allowOrder="true">
      <fields>
        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true" aliasName="0 as ">
          <text v="" e=""></text>
        </field>
        <field name="line" dataType="I" fieldType="PK" hidden="true" aliasName="0 as ">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_cong" width="100" viewType="Lookup" readOnly="true" >
          <text v="Mã sản phẩm" e="Item"></text>
          <viewInfo lookupType="One" lookupId="dmcong" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_cong" lookupInfo="dmcong|ma_cong|ten_cong" />
        </field>
        <field name="ten_cong" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmcong b on a.ma_cong = b.ma_cong ">
          <text v="Tên sản phẩm" e="Item Name"></text>
        </field>
        <field name="dvt" width="60" readOnly="true" viewType="Lookup" aliasName="a">
          <text v="Đvt" e="UOM"></text>
          <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="dvt in (select dvt from dmqddvt where ma_cong = #[ma_cong]#)" lookupCheck="dvt in (select dvt from dmqddvt where ma_cong = #[ma_cong]#)" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" />
        </field>
        <field name="ten_dvt" width="120" inactivate="true" readOnly="true" hidden="true" aliasName="c" join=" left join dmdvt c on a.dvt = c.dvt ">
          <text v="Tên đvt" e="UOM"></text>
        </field>
        <field name="so_luong0" dataType="N" format="Qty" width="100" readOnly="false" aliasName="0*a.so_luong as " >
          <text v="&lt;b&gt;Sl lấy&lt;/b&gt;" e="&lt;b&gt;Qty Input&lt;/b&gt;"></text>
        </field>
        <field name="so_luong" dataType="N" format="Qty" width="100" readOnly="true" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
        <field name="sl_cl" dataType="N" format="Qty" width="100" aliasName="0*a.so_luong as " >
          <text v="&lt;b&gt;Sl còn lại&lt;/b&gt;" e="PO Qty"></text>
        </field>
        <field name="ma_kho" width="100" clientDefault="true" viewType="Lookup" >
          <text v="Mã kho" e="Site"></text>
          <viewInfo lookupType="One" lookupId="dmkho" lookupKey="unit_id = ![unit_id]! and status=1" lookupCheck="unit_id = ![unit_id]!" lookupRef="ten_kho" lookupInfo="dmkho|ma_kho|ten_kho" />
        </field>
        <field name="ten_kho" width="120" clientDefault="true" inactivate="true" hidden="true" aliasName="d" join=" left join dmkho d on a.ma_kho = d.ma_kho ">
          <text v="Tên kho" e="Site"></text>
        </field>
        <field name="ma_lo" width="100" viewType="Lookup" hidden="true" readOnlyCondition="[lo_yn]==0" allowBlankCondition="[lo_yn]==0" >
          <text v="Mã lô" e="Lot"></text>
          <viewInfo lookupType="One" lookupId="dmlo" lookupKey="ma_cong = #[ma_cong]# and status=1" lookupCheck="1=1" lookupRef="ten_lo" lookupInfo="dmlo|ma_lo|ten_lo" />
        </field>
        <field name="ten_lo" width="120" inactivate="true" readOnly="true" hidden="true" aliasName="e" join=" left join dmlo e on a.ma_cong = e.ma_cong and a.ma_lo = e.ma_lo ">
          <text v="Tên lô" e="Lot"></text>
        </field>
        <field name="lo_yn" dataType="B" width="50" hidden="true" inactivate="true" readOnly="true" aliasName="b">
          <text v="Td lô" e="Lot"></text>
        </field>
        <field name="ma_vi_tri" width="100" clientDefault="true" hidden="true" viewType="Lookup" readOnlyCondition="[vi_tri_yn]==0" allowBlankCondition="[vi_tri_yn]==0" >
          <text v="Mã vị trí" e="Location"></text>
          <viewInfo lookupType="One" lookupId="dmvitri" lookupKey="ma_kho = #[ma_kho]# and status=1" lookupCheck="1=1" lookupRef="ten_vi_tri" lookupInfo="dmvitri|ma_vi_tri|ten_vi_tri" />
        </field>
        <field name="ten_vi_tri" width="120" inactivate="true" clientDefault="true" readOnly="true" hidden="true" aliasName="f" join=" left join dmvitri f on a.ma_kho = f.ma_kho and a.ma_vi_tri = f.ma_vi_tri ">
          <text v="Tên vị trí" e="Location Name"></text>
        </field>
        <field name="vi_tri_yn" dataType="B" width="50" clientDefault="true" hidden="true" inactivate="true" readOnly="true" aliasName="d">
          <text v="Td vị trí" e="Location"></text>
        </field>
        <field name="he_so" dataType="N" format="Rate" width="50" readOnly="true" inactivate="true" aliasName="a" hidden="true" >
          <text v="Hệ số" e="Rate"></text>
        </field>
        <field name="sl_ton" dataType="N" format="Qty" inactivate="true" width="100" readOnly="true" fieldType="EX" aliasName="0*a.so_luong as " >
          <text v="Tồn" e="Stock"></text>
        </field>
        <field name="ct_km" width="100" viewType="Combobox" inactivate="true" >
          <text v="Loại hàng" e="Item Type"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Hàng bán" e="Sale"/>
              </option>
              <option val="1">
                <text v="Hàng KM" e="Promotion"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="gia_nt1" dataType="N" hidden="true" inactivate="true" format="FCPrice" width="100" readOnly="true" >
          <text v="Giá chuẩn %s" e="%s Std.Price"></text>
        </field>
        <field name="gia_nt2" dataType="N" format="FCPrice" width="100" >
          <text v="Giá bán %s" e="%s Price"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="FCAmount" width="100" >
          <text v="Doanh số %s" e="%s Amount"></text>
        </field>
        <field name="tl_ck" dataType="N" format="Rate" width="100" >
          <text v="Tl ck(%)" e="Dis.Rate"></text>
        </field>
        <field name="ck_nt" dataType="N" format="FCAmount" width="100" clientDefault="true" >
          <text v="Ch.khấu %s" e="%s Discount"></text>
        </field>
        <field name="thue_suat" dataType="N" format="0" width="100" clientDefault="true" >
          <text v="Thuế suất(%)" e="Tax"></text>
        </field>
        <field name="thue_nt" dataType="N" format="FCAmount" width="100">
          <text v="Thuế %s" e="%s Tax"></text>
        </field>
        <field name="ngay_giao" dataType="D" width="100">
          <text v="Ngày giao" e="Delivery Date"></text>
        </field>
        &VoucherExtendFields;
        <field name="gia1" dataType="N" hidden="true" format="Price" width="100" inactivate="true" readOnly="true" >
          <text v="Giá chuẩn" e="Std.Price"></text>
        </field>
        <field name="gia2" dataType="N" hidden="true" format="Price" width="100" inactivate="true" >
          <text v="Giá bán" e="Price"></text>
        </field>
        <field name="tien2" dataType="N" hidden="true" format="Amount" width="100" inactivate="true" >
          <text v="Doanh số" e="Amount"></text>
        </field>
        <field name="ck" dataType="N" hidden="true" format="Amount" width="100" inactivate="true">
          <text v="Chiết khấu" e="Discount"></text>
        </field>
        <field name="thue" dataType="N" hidden="true" format="Amount" width="100" inactivate="true">
          <text v="Thuế" e="Tax"></text>
        </field>
        <field name="id_bg" dataType="N" fieldType="PK" format="0" hidden="true" aliasName="a.id as ">
          <text v="ID HĐ" e="ID HĐ"></text>
        </field>
        <field name="so_ct_bg" dataType="N" fieldType="PK" format="0" hidden="true" aliasName="a.so_ct as ">
          <text v="Số báo giá" e="SO .No"></text>
        </field>
        <field name="line_bg" dataType="I" fieldType="PK" hidden="true" aliasName="a.line as ">
          <text v="Dòng HĐ" e="SO Line"></text>
        </field>
      </fields>

      <buttons>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[
select data as id into #id from dbo.ISWIFTFunction$Split(@so_ct, ',')
select @@fields into #t from d52 a @@join
  where a.id in (select id from #id)
  order by a.ngay_ct, a.so_ct

select id_bg, line_bg, sum(a.so_luong*a.he_so) as sl_don_hang into #sl from r51 a with(index(id_bg)) where id <> @id and id_bg <> 0 and exists(select 1 from #t b where a.id_bg = b.id_bg and a.line_bg = b.line_bg) group by id_bg, line_bg
update #t set sl_cl = a.so_luong - isnull(b.sl_don_hang, 0) from #t a left join #sl b on a.id_bg = b.id_bg and a.line_bg = b.line_bg

exec ISWIFTStoredGetCurrentStock 'U0', '#t', '', '', '', '', 0, 'ma_cong, ma_kho'
select * from #t order by line

select a.ma_kh,a.ma_tt,cast('' as nvarchar(4000)) as ten_tt,a.ma_dc,cast('' as nvarchar(4000)) as ten_dc,a.dia_chi,a.ma_so_thue,a.ma_nvbh,cast('' as nvarchar(4000)) as ten_nvbh,a.ma_ptvc,cast('' as nvarchar(4000)) as ten_ptvc,a.ma_pttt,cast('' as nvarchar(4000)) as ten_pttt,a.ma_ptgh,cast('' as nvarchar(4000)) as ten_ptgh
	into #m52 from m52 a where a.id in (select top 1 id from #id order by id desc) 

update #m52 set ten_dc = (select isnull(max(ten_dc), '') from dmdc where ma_dc = #m52.ma_dc and ma_kh = #m52.ma_kh)
update #m52 set ten_tt = (select isnull(max(ten_tt), '') from dmtt where ma_tt = #m52.ma_tt and 1=1)
update #m52 set ten_nvbh = (select isnull(max(ten_nvbh), '') from dmnvbh where ma_nvbh = #m52.ma_nvbh and 1=1)
update #m52 set ten_ptvc = (select isnull(max(ten_ptvc), '') from dmptvc where ma_ptvc = #m52.ma_ptvc and 1=1)
update #m52 set ten_pttt = (select isnull(max(ten_pttt), '') from dmpttt where ma_pttt = #m52.ma_pttt and 1=1)
update #m52 set ten_ptgh = (select isnull(max(ten_ptgh), '') from dmptgh where ma_ptgh = #m52.ma_ptgh and 1=1)
select * from #m52

drop table #t, #sl, #id, #m52
         ]]>
          </text>
        </query>
      </script>

    </grid>
    <grid id="f52" table="f52" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ma_phi" width="100" viewType="Lookup" inactivate="true" readOnly="true">
          <text v="Mã phí" e="Fee"></text>
          <viewInfo lookupType="One" lookupId="dmphi" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_phi" lookupInfo="dmphi|ma_phi|ten_phi" />
        </field>
        <field name="ten_phi" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmphi b on a.ma_phi = b.ma_phi ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
        <field name="tien0" dataType="N" format="Qty" width="100" readOnly="false" aliasName="a.tien as " >
          <text v="&lt;b&gt;Tiền lấy&lt;/b&gt;" e="&lt;b&gt;Amount Input&lt;/b&gt;"></text>
        </field>
        <field name="tien" dataType="N" format="Amount" width="100" readOnly="false" >
          <text v="Tiền" e="Amount"></text>
        </field>
      </fields>

      <buttons>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>
      <script>
        <query>
          <text>
            <![CDATA[
select data as id into #id from dbo.ISWIFTFunction$Split(@so_ct, ',')
select @@fields into #t from f52 a @@join where a.id in (select id from #id) order by a.id, a.line
select * from #t
drop table #id, #t
         ]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$t51BG5Select(p){
  this.constructor(p);
}
filter$t51BG5Select.prototype = new DirEvent();
filter$t51BG5Select.prototype.beforeInit = function(){
  var p = this._dir;
  
}
filter$t51BG5Select.prototype.afterInit = function(){
  var p = this._dir;
  p.valForm(['ma_kh', 'ten_kh', 'so_ct'], [p.options._ma_kh, p.options._ten_kh, p.options._so_ct]);
  p.setColumnHeader(0, ['tien_nt2', 'gia_nt2', 'ck_nt', 'thue_nt'], ['%s', p.options._ma_nt]);
}
filter$t51BG5Select.prototype.beforeAcceptFilter = function (m2, opt, sub) {
  var p = this._dir, pa = p.options.parent, g = p.grid(0), dt = g.data, master = g.ds.get(1), rErr = dt.findRow("[so_luong0] > [sl_cl]");
  var f = p.grid(1), dtf = f.data, master1 = f.ds.get(1)
  
  var fun = function() {
    dt.removeRow('[so_luong0] == 0');
    pa.appendGrid(0, dt, p.valForm('xprocess') == "2", 'so_luong', 'so_luong0');
    pa.calcExpressionAll(0, 'so_luong');
    pa.appendForm(master, 0);
    //p._close();
  }
  if (rErr.length) {
    $.question('$VoucherRetrieveLimit', null, p, function(q, v){
      q._close();
      if (v) fun();
    });
  } else fun();
  
  dtf.removeRow('[tien] == 0');
  pa.appendGrid(1, dtf, p.valForm('xprocess') == "2", 'tien', 'tien0');
  pa.calcExpressionAll(1, 'tien');
  //pa.appendForm(master1, 0);
  p._close();
  
  return false;
}
         ]]>
    </text>
  </js>
</dir>