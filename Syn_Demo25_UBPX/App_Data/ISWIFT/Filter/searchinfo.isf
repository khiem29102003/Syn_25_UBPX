  <messages>
    <message val="EmptyTax">
      <text v="Vui lòng nhập mã số thuế" e="Please enter your tax code"/>
    </message>
	<message val="EmptyTelephone">
      <text v="Vui lòng nhập số điện thoại" e="Please enter your phone number"/>
    </message>
    <message val="InsertComplete">
      <text v="Thêm khách hàng thành công." e="The customer code already exists in the catalog, please choose a different code."/>
    </message>
	<message val="codeExistsNewMsg">
      <text v="Mã khách hàng đã tồn tại trong danh mục, vui lòng chọn một mã số thuế khác." e="The customer code already exists in the catalog, please choose a different code."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã khách hàng đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The customer code already exists in the catalog, please choose a different code."/>
    </message>
    <message val="taxtCodeExists">
      <text v="&lt;span class='Highlight'&gt;Lưu ý:&lt;/span&gt; Mã số thuế đã tồn tại trong danh mục khách hàng" e="&lt;span class='Highlight'&gt;Warning:&lt;/span&gt; The tax code is already exists"/>
    </message>
  </messages>
</dir>