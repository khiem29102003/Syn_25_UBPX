<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
]>

<dir id="searchinfo" table="" height="" fieldKey="ma_kh" dirViewType="Dialog" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title1 v="Tìm kiếm khách hàng" e="Customer Search"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120,120,120"  >
      <fields>
	    <field name="ma_kh" format="U" label="1" field="1" viewType="AutoIncrease" allowBlank="true" fieldType="PK" importable="1" hidden="true">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
        <field name="ma_so_thue" label="1" field="2" allowBlank="false" importable="50">
          <text v="Mã số thuế &lt;a id='btnTax' &gt;(Kiểm tra)&lt;/a&gt;" e="Tax Code &lt;a onclick='getTax(this);'&gt;(Test)&lt;/a&gt;"></text>
        </field>
		<field name="kc1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="[220]" field="0">
			<text v="" e=""></text>
		</field>	
		<field name="ngay_thuchien" label="1" field="1" clientDefault="true" allowBlank="false" fieldType="PK" dataType="D" nextRow="false" disabled="true">
          <text v="Ngày thực hiện" e="Voucher Date"></text>
        </field>
		 <field name="ten_kh" allowBlank="true" label="1" field="-" importable="5" hidden="false">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
		<field name="ten_kh2" label="1" field="-" importable="10" hidden="true">
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="dia_chi" label="1" field="-" allowBlank="true" importable="45" hidden="false">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="nguoi_lh" label="1" field="-" nextRow="false" importable="55" hidden="false">
          <text v="Người liên hệ" e="Contact"></text>
        </field>
		<field name="dien_thoai" label="1" field="2" allowBlank="false" importable="60" hidden="false">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="e_mail" label="1" field="2" importable="70">
          <text v="Email" e="Email"></text>
        </field>
		<field name="nh_kh1" viewType="Lookup" label="1" field="1" importable="85">
          <text v="Nhóm 1" e="Group 1"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH1' and status=1" lookupCheck="ma_loai_nh = 'KH1'" lookupRef="ten_nh_kh1" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'KH1' and z.status=1"/>
        </field>
        <field name="ten_nh_kh1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_kh2" viewType="Lookup" label="1" field="1" importable="90">
          <text v="Nhóm 2" e="Group 2"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH2' and status=1" lookupCheck="ma_loai_nh = 'KH2'" lookupRef="ten_nh_kh2" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'KH2' and z.status=1"/>
        </field>
        <field name="ten_nh_kh2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_kh3" viewType="Lookup" label="1" field="1" importable="95">
          <text v="Nhóm 3" e="Group 3"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH3' and status=1" lookupCheck="ma_loai_nh = 'KH3'" lookupRef="ten_nh_kh3" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'KH3' and z.status=1"/>
        </field>
        <field name="ten_nh_kh3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="insertinto" label="1" field="" allowBlank="true" importable="50" fieldtype="EX">
          <text v="&lt;a alt='Thêm' id='btnInsert' &gt;Thêm&lt;/a&gt;" e="Tax Code"></text>
        </field>
      </fields>
    </form>
   	<form tabPageIndex="1" gravity="MiddleLeft" height="280" columns="120,120,120,120,120,120,120,120" >
		<text v="Chi tiết" e="Detail"></text>
		<fields>
			<field name="dmkh0" allowBlank="true" label="" field="-" viewType="Grid">
			  <text v="Chi tiết" e="Detail"></text>
			</field>
		</fields>
	</form>

  </forms>
  <grids>
		<grid id="dmkh0" table="dmkh0" fieldKey="ma_so_thue" order="line" allowFilter="true" readOnly="false" allowOrder="true">
		  <fields>
			<!-- //ngay_thuchien, ma_so_thue, ten_kh, ten_kh2, dia_chi, nguoi_lh, dien_thoai, e_mail, nh_kh1, nh_kh2, nh_kh3 -->
			<field name="ngay_thuchien" width="100" dataType="D" readOnly="false"  >
				<text v="Ngày thực hiện" e="Execution Date"></text>
			</field>
			<field name="ma_so_thue" fieldType="PK" width ="120" hidden="false">
			  <text v="Mã số thuế" e="Tax Code"></text>
			</field>							
			<field name="ten_kh" width ="200">
			  <text v="Tên khách hàng" e="Customer Name"></text>
			</field>
			<field name="ten_kh2" width="200">
			  <text v="Tên khác" e="Other Name"></text>
			</field>
			<field name="dia_chi" width="200">
			  <text v="Địa chỉ" e="Address"></text>
			</field>
			<field name="nguoi_lh" width="200" >
			  <text v="Người liên hệ" e="Contact"></text>
			</field>
			<field name="dien_thoai" width="120">
			  <text v="Điện thoại" e="Phone"></text>
			</field>
			<field name="e_mail" width="200">
			  <text v="Email" e="Phone"></text>
			</field>
			<field name="nh_kh1" viewType="Lookup" width="120">
			  <text v="Nhóm 1" e="Group 1"></text>
			  <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH1' and status=1" lookupCheck="ma_loai_nh = 'KH1'" lookupRef="ten_nh_kh1" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'KH1' and z.status=1"/>
			</field>
			<field name="ten_nh_kh1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('''' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="nh_kh2" viewType="Lookup" width="120" >
			  <text v="Nhóm 2" e="Group 2"></text>
			  <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH2' and status=1" lookupCheck="ma_loai_nh = 'KH2'" lookupRef="ten_nh_kh2" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'KH2' and z.status=1"/>
			</field>
			<field name="ten_nh_kh2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('''' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="nh_kh3" viewType="Lookup" width="120">
			  <text v="Nhóm 3" e="Group 3"></text>
			  <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH3' and status=1" lookupCheck="ma_loai_nh = 'KH3'" lookupRef="ten_nh_kh3" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'KH3' and z.status=1"/>
			</field>
			<field name="ten_nh_kh3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('''' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="user_id0" width="20" hidden="true">
			  <text v="Userid0" e="Userid0"></text>
			</field>
		  </fields>
		  <buttons>
			<button id="refresh">
			  <text v="Hiện tất cả" e="Show All"></text>
			</button>
			<button id="freeze">
			  <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
			</button>
		  </buttons>
		  <script>
			<query>
			  <text>
				<![CDATA[<enc></enc>]]>
			  </text>
			</query>
		  </script>
		</grid>
	</grids>


  <buttons>

    <button id="filterCancel">
      <text v="$CancelLabel" e="$CancelLabel"></text>
    </button>
  </buttons>

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
