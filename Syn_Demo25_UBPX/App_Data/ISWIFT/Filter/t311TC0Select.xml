      <script>
        <query>
          <text>
            <![CDATA[
	select data as id into #id from dbo.ISWIFTFunction$Split(@so_ct, ',')
	
	select top 0 * into #t11 from t11
	insert into #t11 select * from t11


	select * into #t21 from t21 where id in (select id from #id)
	delete #t21 where id_dh not in (select id from #t11)


	select * into #r21 from r21 where id in (select id from #id)
	delete #r21 where id not in (select id from #t21)

	SELECT p.*,ROW_NUMBER() OVER(PARTITION BY p.id ORDER BY p.id DESC) AS stt into #r21_1 FROM #r21 p
	select a.*, b.ten_cong into #r21_2 from #r21_1 a left join dmcong b on a.ma_cong=b.ma_cong
	select id, sum(so_luong) so_luong into #r21_22 from #r21_2 group by id




	select a.*,a.id as id_ch,a.so_ct as so_chuyen, a.ngay_ct as ngay_gn,ff1.ngay_ct as ngay_td,ff1.so_ct as so_don ,b1.ten_noi_di,b2.ten_noi_den,b3.ten_noi_dodong,e.ten_hang,c.ten_kh,d.ten_nv,f.cont_no, f2.cont_no cont_no2, f3.cont_no cont_no3,
				f.ten_cong, f2.ten_cong ten_cong2, f3.ten_cong ten_cong3,
				cast((cast (f.so_luong as int)) as varchar(10))  + 'X' + f.ma_cong  ms_cong, f.ma_cong,
				cast((cast (f2.so_luong as int)) as varchar(10))  + 'X' + f2.ma_cong  ms_cong2,f2.ma_cong ma_cong2, 
				cast((cast (f3.so_luong as int)) as varchar(10))  + 'X' + f3.ma_cong  ms_cong3, f3.ma_cong ma_cong3,
				cast (ff.so_luong as int) so_luong from #t21 a
	left join vdmcangdi b1 on a.ma_noi_di = b1.ma_noi_di
	left join vdmcangden b2 on a.ma_noi_den = b2.ma_noi_den
	left join vdmcangdodong b3 on a.ma_noi_dodong = b3.ma_noi_dodong
	left join vdmhangtau e on a.ma_hang = e.ma_hang
	left join dmkh c on a.ma_kh = c.ma_kh
	left join dmnv d  on a.ma_nv = d.ma_nv
	left join #r21_2 f on a.id = f.id and f.stt = 1
	left join #r21_2 f2 on a.id = f2.id and f2.stt = 2
	left join #r21_2 f3 on a.id = f3.id and f3.stt = 3
	left join #r21_22 ff on a.id = ff.id
	left join #t11 ff1 on a.id_dh = ff1.id

	order by a.ngay_ct desc, a.id desc


	--select * from #t11
	--select * from #r21

	drop table #t11, #r21, #t21, #r21_1, #r21_2, #r21_22, #id


         ]]>
          </text>
        </query>
      </script>

