}
filter$t311TC0Select.prototype = new DirEvent();
filter$t311TC0Select.prototype.beforeInit = function(){
  var p = this._dir;
  
}


filter$t311TC0Select.prototype.afterInit = function(){
  var p = this._dir;
  p.valForm(['ngay_ct1','ngay_ct2','id', 'ma_noi_di', 'ten_noi_di', 'ma_noi_den', 'ten_noi_den','ma_kh','ten_kh', 'ma_nt', 'unit_id'], [p.options._ngay_ct1,p.options._ngay_ct2,p.options._so_ct,p.options._ma_noi_di, p.options._ten_noi_di,p.options._ma_noi_den, p.options._ten_noi_den,p.options._ma_kh, p.options._ten_kh,  p.options._ma_nt, p.options._unit_id]);
	var ima_kh = master.val(0, 'ma_kh');
	var iten_kh = master.val(0, 'ten_kh');
	var ima_chungtu = master.val(0, 'ma_chungtu');
	var iten_chungtu= master.val(0, 'ten_ct');
	var ima_nv = master.val(0, 'ma_nv');
	var iten_nv = master.val(0, 'ten_nv');
	var ima_noi_di = master.val(0, 'ma_noi_di');
	var iten_noi_di= master.val(0, 'ten_noi_di');
	var ima_noi_den = master.val(0, 'ma_noi_den');
	var iten_noi_den= master.val(0, 'ten_noi_den');
	p.valForm(['ten_kh','ten_kh','ma_chungtu','ten_ct','ma_nv','ma_noi_di','ten_noi_di','ma_noi_den',''ma_noi_den''],[ima_kh,iten_kh,ima_chungtu,iten_chungtu,ima_nv,iten_nv,ima_noi_di,iten_noi_di,ima_noi_den,iten_noi_den]);

}

function dir$t311TC0SetMaster(p) {
  //p.request('ma_kh_request', '', ['id']);
}

filter$t311TC0Select.prototype.beforeAcceptFilter = function (m2, opt, sub) {
  var p = this._dir, pa = p.options.parent, g = p.grid(0), dt = g.data, master = g.ds.get(1), rErr = "";
  
  var fun = function(){
	dt.removeRow('[so_luong] == 0');
    pa.appendGrid(0, dt, p.valForm('xprocess') == "2", 'so_luong', 'so_luong');
	pa.calcExpressionAll(0, 'so_luong');
    //pa.appendForm(master, 0);
    p._close();
  }
  
  if (rErr.length) {
    $.question('$VoucherRetrieveLimit', null, p, function(q, v){
      q._close();
      if (v) fun();
    });
  } else fun();
  
    return false;
}

         ]]>
