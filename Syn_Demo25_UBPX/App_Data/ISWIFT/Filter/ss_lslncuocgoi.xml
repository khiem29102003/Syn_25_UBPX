  <js>
    <text>
      <![CDATA[
function filter$ss_lslncuocgoi(p){
  this.constructor(p);
}
filter$ss_lslncuocgoi.prototype = new DirEvent();
filter$ss_lslncuocgoi.prototype.afterInit = function(){
   var p = this._dir, ev = this;

  p.request('loadadmin', '', '');

	setTimeout(function GetAdmin() {		
	var ad = p.valForm('admin1');
	if(ad == 1)
	p.setInvisible(['ma_nv'], true);
	}, 200)

}
]]>
    </text>
