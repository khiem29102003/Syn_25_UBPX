            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
			  <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmloaitd(p){
  this.constructor(p);
}
filter$dmloaitd.prototype = new DirEvent();
filter$dmloaitd.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
