              </option>
			  <option val="OTH">
                <text v="Hàng Khác" e="OTHER Marine"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="so_job" width="150">
          <text v="Số đơn hàng" e="Job Number"></text>
        </field>
	&ReportFilterUnit;
  </fields>
 </form>
</forms>


