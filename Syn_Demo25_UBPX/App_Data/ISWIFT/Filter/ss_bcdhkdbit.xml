<dir id="ss_bcdhkdbit" table="" height="" fieldKey="id" dirViewType="Dialog" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Lọc đơn hàng" e="Order filtering"></title>

<forms>
 <form gravity="TopLeft" columns="120,120,120"  >
