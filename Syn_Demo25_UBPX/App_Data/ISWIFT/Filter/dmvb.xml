<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="dmvb" table="" height="" fieldKey="ma_vb" dirViewType="Dialog" dirObjectType="Report" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Lọc thông tin văn bản" e="Filter document information" color="red"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120"  >
      <fields>
	    <field name="ngay_ct1" label="1" field="1" aliasName="@DFDFrom" clientDefault="true" allowBlank="false" fieldType="PK" dataType="D">
			<text v="Ngày phát hành (từ/đến)" e="Issue Date (From/To)"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" aliasName="@DFDTo" clientDefault="true" allowBlank="false" fieldType="PK" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>
		<field name="ma_vb" inactivate="false" label="1" field="-" operation="like" >
			<text v="Mã văn bản" e="Document Code"></text>
		</field>
		<field name="ten_vb" inactivate="false" label="1" field="-" operation="ten_vb like N'%%s%'">
			<text v="Tên văn bản" e="Document Name"></text>
		</field>
		<field name="ky_hieu" inactivate="false" label="1" field="-" operation="ky_hieu like N'%%s%'">
			<text v="Ký hiệu" e="Document Name"></text>
		</field>
		<field name="ma_pl" viewType="Lookup" label="1" field="1" operation="like">
			<text v="Văn bản lưu hành" e="Circulation Document"></text>
          <viewInfo lookupType="One" lookupId="dmplvb" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_pl" lookupInfo="dmplvb|ma_pl|ten_pl" />
        </field>
        <field name="ten_pl" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_nvb" viewType="Lookup" label="1" field="1" operation="like">
			<text v="Nhóm văn bản" e="Group Document"></text>
          <viewInfo lookupType="One" lookupId="dmnhomvb" lookupKey="status = 1 and kh_yn = 1" lookupCheck="1=1" lookupRef="ten_nvb" lookupInfo="dmnhomvb|ma_nvb|ten_nvb" />
        </field>
        <field name="ten_nvb" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmvb(p){
  this.constructor(p);
}
filter$dmvb.prototype = new DirEvent();
filter$dmvb.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
<script>
	
</script>
</dir>