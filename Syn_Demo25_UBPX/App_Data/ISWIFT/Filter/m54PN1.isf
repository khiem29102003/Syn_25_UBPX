<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="m54PN1" fieldKey="id" voucherCode="CR1" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Lọc danh sách phiếu mua theo đơn hàng" e="Filter FCL Order Numbers"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
        <field name="ngay_ct1" label="1" field="1" aliasName="@DFDFrom" clientDefault="true" allowBlank="false" fieldType="PK" dataType="D">
          <text v="Ngày từ/đến" e="Voucher Date"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" aliasName="@DFDTo" clientDefault="true" allowBlank="false" fieldType="PK" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>
		<field name="id_dh"  label="1" field="1" nextRow="true" hidden="true">
          <text v="ID DH" e="Voucher Number"></text>
        </field>
		
		<field name="ma_job" label="1" field="1" disabled="true">
          <text v="Mã đơn hàng" e="Order Code"></text>
        </field>
		<field name="so_job_dh" label="0" field="1" nextRow="false" disabled="true">
          <text v="Số đơn hàng" e="Order Number"></text>
        </field>
		 <field name="id_m72" label="1" field="1" allowBlank="false" viewType="Lookup" operation="like">
          <text v="Lấy số phiếu mua" e="Get the order number"></text>
          <viewInfo lookupType="one" lookupId="m72" lookupRef="ds_id_m72" lookupKey="ngay_ct between ![ngay_ct1]! and ![ngay_ct2]! and id_dh like ![id_dh]! + '%' and xstatus =5" lookupCheck="id_dh like ![id_dh]! + '%' and xstatus =5" />
        </field>
        <field name="ds_id_m72" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>	
      </fields>
    </form>
	
	
  </forms>


  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
<css>
    <text>
      <![CDATA[<enc>/T0x+X5J8VnLtXSs8xERBy5XsIhTcMK77n2BsK4suh7al6IPHe8OdNVaharGtBWoIj54XqGtRPyUlbB6zG6gOVTWDaEMF4Lb+C9dT+n+d8E=</enc>]]>
    </text>
  </css>
  <script>

  </script>
</dir>