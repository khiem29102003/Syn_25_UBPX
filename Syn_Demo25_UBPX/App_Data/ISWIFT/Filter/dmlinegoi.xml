<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="dmlinegoi" table="" height="" fieldKey="ma_line" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120"  >
      <fields>
	    <field name="ma_line" label="1" field="1" operation="like">
          <text v="Mã line" e="Line Code"></text>
        </field>
	    <field name="ten_line" label="1" field="1" operation="like">
          <text v="Tên line" e="Line Name"></text>
        </field>
		<field name="ten_line2" label="1" field="1" operation="like">
          <text v="Tên khác" e="Other Name"></text>
        </field>
      </fields>
    </form>
	 <form gravity="BottomLeft" columns="120,120,120"  >
      <fields>
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="[150]" operation="=" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
			  <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmlinegoi(p){
  this.constructor(p);
}
filter$dmlinegoi.prototype = new DirEvent();
filter$dmlinegoi.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
</dir>