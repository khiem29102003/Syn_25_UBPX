<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">
]>

<dir id="m58_1Select" table="" height="" fieldKey="id" voucherCode="BQ1" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Chi tiết phiếu được chọn" e="Quotation Entry Detail"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120"  >
      <fields>
		<field name="ngay_ct1" label="1" field="1" readOnly="true" aliasName="@DFDFrom" disabled="true" allowBlank="false" dataType="D">
          <text v="Ngày c/từ từ/đến" e="Voucher Date"></text>
        </field>
        <field name="ngay_ct2" label="" field="1" allowBlank="false" disabled="true" inactivate="true" dataType="D" nextRow="false">
          <text v="Ngày đến" e="Voucher Date"></text>
        </field>
        <field name="ma_nt" hidden="true" label="1" field="1">
          <text v="Mã ngoại tệ" e="Ex Code"></text>
        </field>
        <field name="unit_id" dataType="I" hidden="true" label="1" field="1">
          <text v="Đơn vị" e="Unit"></text>
        </field>

		<field name="ma_kh" label="1" disabled="true"  field="1" >
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
		<field name="ten_kh" allowBlank="true" label="1" disabled="true"  field="-" importWidth="250" importable="10">
          <text v="Tên khách hàng" e="CustomerName"></text>
        </field>
		
        <field name="xprocess" label="1" field="2" valueDefault="2" viewType="Combobox">
          <text v="Xử lý" e="Process"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="Thêm vào chi tiết" e="Append To Detail"></text>
              </option>
              <option val="2">
                <text v="Xóa hết chi tiết và thêm mới" e="Delete All Detail And Append New"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="id" dataType="N" hidden="true" fieldType="PK" label="1" field="1"  >
			<text v="ID" e="Code"></text>
		</field>
      </fields>
    </form>
	
    <form tabPageIndex="1" gravity="MiddleLeft" height="350" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="cttt20" label="" field="-" viewType="Grid">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

 <grids>
    <grid id="cttt20" table="cttt20" fieldKey="id, line" order="id, line" allowFilter="true" readOnly="false" allowOrder="true">
      <fields>
		<field name="chon_yn" dataType="B" width="80" valueDefault="1" readOnly="false" >
          <text v="Chọn" e="Check"></text>
        </field>
        <field name="id" dataType="N" width="50" format="0" >
          <text v="ID" e="ID"></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
		<field name="ma_job_dh" width="100" fieldType="EX"  inactivate="true">
          <text v="Mã DH" e="Order Code"></text>
        </field>
        <field name="so_job_dh" width="100" fieldType="EX"  inactivate="true">
          <text v="Số DH" e="Order Number"></text>
        </field>
        <field name="id_hd" width="80" allowBlank="true" readOnly="false">
          <text v="ID phiếu" e="Voucher ID"></text>
        </field>
        <field name="so_ct_hd" width="100" fieldType="EX" inactivate="true" >
          <text v="Số phiếu" e="Voucher No"></text>
        </field>
		<field name="ma_ct_hd" width="100" fieldType="EX"  inactivate="true">
          <text v="Mã phiếu" e="Voucher Code"></text>
        </field>
        <field name="ngay_ct_hd" width="100" dataType="D"  inactivate="true" fieldType="EX">
          <text v="Ngày phiếu" e="Voucher Date"></text>
        </field>
        <field name="ma_nt_hd" width="100" fieldType="EX"  inactivate="true">
          <text v="Ngoại tệ" e="Currency"></text>
        </field>
        <field name="ty_gia_hd" dataType="N" format="FCAmount" width="120" inactivate="true" fieldType="EX">
          <text v="Tỷ giá hđ" e="EX Inv"></text>
        </field>
        <field name="tien_hd_nt" dataType="N" format="FCAmount" width="120" fieldType="EX">
          <text v="Tiền trên hóa đơn" e="Invoice Amount"></text>
        </field>
        <field name="da_pb_nt" dataType="N" format="FCAmount" width="120" fieldType="EX" >
          <text v="Đã phân bổ" e="Pcs UOM"></text>
        </field>
        <field name="cl_nt" dataType="N" format="FCAmount" width="100" fieldType="EX">
          <text v="Còn lại" e=""></text>
        </field>
        <field name="tien_nt" dataType="N" allowBlank="true" format="FCAmount" width="120" readOnly="false">
          <text v="Tiền phải thanh toán" e="Money payable"></text>
        </field>
		<field name="ma_ct_dh" width="100" fieldType="EX"  inactivate="true">
          <text v="Mã c/từ đh" e="Voucher Code"></text>
        </field>
		<field name="so_ct_dh" width="100" fieldType="EX"  inactivate="true">
          <text v="Số c/từ đh" e="Voucher Code"></text>
        </field>
        <field name="ngay_ct_dh" width="100" dataType="D" inactivate="true" fieldType="EX">
          <text v="Ngày c/từ đh" e="Voucher Date"></text>
        </field>

      </fields>

      <buttons>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>
   
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  
  <script>
		<request code="ma_kh_request">
			<text>
			  <![CDATA[<enc>FTkFm4igxdrH0JOWCSE3pGHYC1WBe4eYZxuXqK1sQME=</enc>]]>
			</text>
		</request>
  </script>
</dir>