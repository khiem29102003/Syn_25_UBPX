<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">
]>

<dir id="khxl" table="" height="" fieldKey="ma_so_thue" voucherCode="TC1" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter Condition"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120"  >
      <fields>
		<field name="ma_so_thue" label="1" field="1" operation="a.ma_so_thue like N'%%s%'">
          <text v="Mã số thuế" e="Tax Code"></text>
        </field>
		<field name="ten_kh" label="1" field="-" operation="a.ten_kh like N'%%s%'">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
		<field name="ten_kh2" label="1" field="-" operation="a.ten_kh2 like N'%%s%'">
          <text v="Tên khách hàng 2" e="Other Name"></text>
        </field>
        <field name="nh_kh1" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Nhóm 1" e="Group 1"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH1' and status=1" lookupCheck="ma_loai_nh = 'KH1'" lookupRef="ten_nh_kh1" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_kh1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_kh2" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Nhóm 2" e="Group 2"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH2' and status=1" lookupCheck="ma_loai_nh = 'KH2'" lookupRef="ten_nh_kh2" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_kh2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_kh3" viewType="Lookup" label="1" field="1" operation="like">
          <text v="Nhóm 3" e="Group 3"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH3' and status=1" lookupCheck="ma_loai_nh = 'KH3'" lookupRef="ten_nh_kh3" lookupInfo="dmnh|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh_kh3" nextRow="false" fieldType="EX"  readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
	<form gravity="MiddleLeft" tabPageIndex="1" columns="120,120,120"  >
      <text v="Lời nhắn cuộc gọi" e=""/>
      <fields>
	    <field name="ngay_goi1" label="1" field="1" clientDefault="true" allowBlank="true" dataType="D">
          <text v="Ngày gọi từ/đến" e="Date call From/To"></text>
        </field>
        <field name="ngay_goi2" label="" field="1" clientDefault="true" allowBlank="true" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>

		 <field name="ma_td" viewType="Lookup" label="1" field="1">
          <text v="Mã tác động" e="Call Code"></text>
          <viewInfo lookupType="One" lookupId="vdmtd" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_td" />
        </field>
        <field name="ten_td" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>    
		
		<field name="ma_plkh" viewType="Lookup" label="1" field="1">
          <text v="Phân loại khách hàng" e="Customer Classification"></text>
          <viewInfo lookupType="One" lookupId="dmploaikh" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_plkh" />
        </field>
        <field name="ten_plkh" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>    

		
		<field name="ngay_goi_lai1" label="1" field="1" clientDefault="true" allowBlank="true" dataType="D">
          <text v="Ngày gọi lại từ/đến" e="Date call From/To"></text>
        </field>
        <field name="ngay_goi_lai2" label="" field="1" clientDefault="true" allowBlank="true" dataType="D" nextRow="false">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$khxl(p){
  this.constructor(p);

}
filter$khxl.prototype = new DirEvent();
filter$khxl.prototype.afterInit = function(){
  var p = this._dir;
}
filter$khxl.prototype.beforeAcceptFilter = function(m2, opt, sub){
  sub[1] = (sub[1] == '')?$.msg.get('AllLabel'):sub[1];
  return true;
}

         ]]>
    </text>
  </js>
 
</dir>