<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">

]>

<dir id="dmntask" table="" height="" fieldKey="ma_ntask" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120"  >
      <fields>
		<field name="ma_ntask" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã nhóm công việc" e="Job Group Code"></text>
			<viewInfo lookupType="One" lookupId="dmntask" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_ntask" lookupInfo="dmntask|ma_ntask|ten_ntask"/>
        </field>
        <field name="ten_ntask" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" >
           <text v="" e=""></text>
        </field>
		<field name="wf" dataType="B"  blank="1" label="[100]" field="[40]" operation="=">
          <text v="Workflow" e="Workflow"></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="[150]" operation="=" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
			  <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmntask(p){
  this.constructor(p);
}
filter$dmntask.prototype = new DirEvent();
filter$dmntask.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
  <script>

  </script>
</dir>