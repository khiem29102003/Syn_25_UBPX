<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">

]>

<dir id="dmtau" table="" height="" fieldKey="ma_tau" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120">
      <fields>

		<field name="ma_tau" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã tàu" e="Vessel Code"></text>
			<viewInfo lookupType="One" lookupId="dmtau" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_tau" lookupInfo="dmtau|ma_tau|ten_tau"/>
        </field>
        <field name="ten_tau" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" >
           <text v="" e=""></text>
        </field>
		
		<field name="ma_loai" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã loại tàu" e="Vessel Type Code"></text>
			<viewInfo lookupType="One" lookupId="dmloaitau" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_loai" lookupInfo="dmloaitau|ma_loai|ten_loai"/>
        </field>
        <field name="ten_loai" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" >
           <text v="" e=""></text>
        </field>
		
		<field name="ma_ben" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã bến cảng" e="Port Code"></text>
			<viewInfo lookupType="One" lookupId="dmbencang" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_ben" lookupInfo="dmbencang|ma_ben|ten_ben"/>
        </field>
        <field name="ten_ben" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" >
           <text v="" e=""></text>
        </field>
		
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="[150]" operation="=" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
			  <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmtau(p){
  this.constructor(p);
}
filter$dmtau.prototype = new DirEvent();
filter$dmtau.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
  <script>

  </script>
</dir>