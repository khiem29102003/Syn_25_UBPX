<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonFilter.xml">

]>

<dir id="dmccnn" table="" height="" fieldKey="ma_tdhv" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Điều kiện lọc" e="Filter"></title>

  <forms>
    <form gravity="TopLeft" columns="120,120,240,120"  >
      <fields>
		<field name="ma_nn" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã ngoại ngữ" e="Language Code"></text>
			<viewInfo lookupType="One" lookupId="dmngoaingu" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_nn" lookupInfo="dmngoaingu|ma_nn|ten_nn"/>
        </field>
        <field name="ten_nn" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" >
           <text v="" e=""></text>
        </field>
		<field name="ma_cc" viewType="Lookup" label="1" field="[150]" operation="like">
			<text v="Mã chứng chỉ" e="Certification Code"></text>
			<viewInfo lookupType="One" lookupId="dmccnn" lookupKey="status = 1 and ma_nn = ![ma_nn]!" lookupCheck="1=1" lookupRef="ten_cc" lookupInfo="dmccnn|ma_cc|ten_cc"/>
        </field>
        <field name="ten_cc" nextRow="false" readOnly="true" inactivate="true" label="" field="[150]" >
           <text v="" e=""></text>
        </field>
		
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="[150]" operation="=" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
			  <option val="">
                <text v="Tất cả" e="All"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function filter$dmccnn(p){
  this.constructor(p);
}
filter$dmccnn.prototype = new DirEvent();
filter$dmccnn.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
  <script>

  </script>
</dir>