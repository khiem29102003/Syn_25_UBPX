        <field name="ten_hang" nextRow="false" readOnly="true" fieldType="EX" disabled="true" label="" field="-">
          <text v="" e=""></text>
        </field>
		
		 <field name="ds_cong" allowBlank="true" viewType="Lookup" label="1" field="2"  hidden="">
