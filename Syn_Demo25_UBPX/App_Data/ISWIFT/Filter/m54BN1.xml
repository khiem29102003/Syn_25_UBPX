        <!-- </field> -->
		<field name="ma_ct_dh" label="1" field="1" allowBlank="true" hidden="false" disabled="true">
          <text v="Mã chứng từ" e="Quot. Number"></text>
        </field>
			
        <field name="so_ct" label="1" field="1" allowBlank="true" hidden="true" >
