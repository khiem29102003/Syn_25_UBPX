			  <viewInfo lookupType="Multi" lookupId="dmcong2" lookupKey="status=1" lookupCheck="status=1" lookupRef="" lookupInfo="dmcong|ma_cong|ten_cong" />
		</field>
		<field name="t_tong_trong" dataType="N" label="1" field="[120]" format="FCAmount" hidden="false" disabled="true" nextRow="true">
			<text v="G.W Volume" e="Gross Weight(KGS)"></text>
		</field>
		
		<field name="t_tong_khoi" dataType="N" label="0" field="[120]" format="FCAmount" nextRow="false"  hidden="false" disabled="true">
