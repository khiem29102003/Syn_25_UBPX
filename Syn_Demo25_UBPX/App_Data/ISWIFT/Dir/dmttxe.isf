<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmttxe" table="dmttxe" fieldKey="ma_xe" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục trạng thái xe" e="List of Vehicle Status"></title>
  <title0 v="Thêm mới" e="Create New"></title0>
  <title1 v="Sửa" e="Edit"></title1>


  <forms>
    <form gravity="TopLeft" columns="120,120,120" >	
      <fields>
		
		<field name="ma_xe" viewType="Lookup" label="1" field="1" fieldType="PK" allowBlank="false" importable="1">
          <text v="Xe" e="Vehicle"></text>
          <viewInfo lookupType="One" lookupId="dmxe" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_xe" lookupInfo="dmxe|ma_xe|ten_xe" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_xe" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>	
		
		<field name="tt_xe" viewType="Combobox" valueDefault="" label="1" field="2" importable="2" >
			<text v="Trạng thái xe" e="Vehicle Status"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'TXE' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>	
		
        <field name="status" viewType="Combobox" inactivate="true" valueDefault="1" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  
  <css>
	<text>
	  <![CDATA[<enc>YkWQBTDGylCtyJwcHZMp4jDvm0u1sJJhM8YQ9YMcSxqy/TRUA+O48YFrzsup+4u9gQJ+D5EiTW9STuQqOQg9Fnf0AeBHLbzlKXm+l553uu+zzyejhBVD1yYtp7CpaPb5</enc>]]>
	</text>
  </css>
  
  <script>
	<importing>
      <text>
        <![CDATA[<enc>PDeYaSq5D3THjzUfjXLnuOov+zRPCu/HsQ7cYLJ9+NUbtW4WBDcym9s/zoBHUkNI</enc>]]>
      </text>
    </importing>
  </script>
  
  <messages>
	<message val="codeExistsNewMsg">
		<text v="Xe đã tồn tại trạng thái" e="The vehicle is already in this status"/>
	</message>
	<message val="codeExistsEditMsg">
		<text v="Xe đã tồn tại trạng thái" e="The vehicle is already in this status"/>
	</message>
  </messages>

</dir>