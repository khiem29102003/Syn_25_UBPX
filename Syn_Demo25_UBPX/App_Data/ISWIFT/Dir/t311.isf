			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcang_di|ma_noi_di|ten_noi_di" />
        </field>
		<field name="ten_noi_di" width="230" fieldType="EX" inactivate="true" readOnly="true" aliasName="h" join=" left join vdmcangdi h on a.ma_noi_di = h.ma_noi_di ">
          <text v="Nơi nhận" e="Destination"></text>
        </field>
		<field name="ma_noi_dodong" width="0" viewType="Lookup" readOnly="false" >
          <text v="Nơi giao hàng" e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangdodong" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_noi_dodong" lookupInfo="vdmcangdodong|ma_noi_dodong|ten_noi_dodong" />
        </field>
        <field name="ten_noi_dodong" width="230" fieldType="EX" inactivate="true" readOnly="true" aliasName="i" join=" left join vdmcangdodong i on a.ma_noi_dodong = i.ma_noi_dodong ">
          <text v=" Nơi giao hàng" e="Destination"></text>
        </field>
		<field name="ma_noi_den" width="0" viewType="Lookup" readOnly="false" >
