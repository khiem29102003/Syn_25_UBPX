  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from t311 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
  if @@admin = 0 and exists(select 1 from t311 a where status = 7 and id = @id and not exists(select 1 from kbnguoiduyet y where y.user_id = @@userId and y.status = 1 and y.loai = 1 and a.ma_nt = y.ma_nt and (y.tien = 0 or a.t_tt_nt &lt;= y.tien))) begin
    select '$notApproveRightEdit' as message
    return
  end
    ">
]>


<dir id="t311" table="t311" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="TT1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Tạo chuyến hàng" e="Create a shipment"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
	  	<field name="ma_ldx" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false">
          <text v="Hình thức" e="Shipment Code"></text>
          <viewInfo lookupType="One" lookupId="dmldx" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_ldx" lookupInfo="dmldx|ma_ldx|ten_ldx" />
        </field>
        <field name="ten_ldx" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="1" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_gd" nextRow="false" viewType="Combobox" valueDefault=""  hidden="false" label="[100]" field="[120]" >
          <text v="Giao dịch" e="Transaction Code"></text>
          <viewInfo>
            <options query="select ma_gd, ten_gd%l from dmgd where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
         <field name="ma_xe" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false">
          <text v="Đầu kéo" e="Tractor Code"></text>
          <viewInfo lookupType="One" lookupId="dmxe" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_xe" lookupInfo="dmxe|ma_xe|ten_xe" />
        </field>
        <field name="ten_xe" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_tx" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false">
		  <text v="Tài xế" e="Driver"></text>
		  <viewInfo lookupType="One" lookupId="vdmtaixe" lookupKey="status = 5 and ma_bp = 'TX'" lookupCheck="1=1" lookupRef="ten_tx" lookupInfo="vdmtaixe|ma_tx|ten_tx" />
		</field>
		<field name="ten_tx" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="-" aliasName="cast('' as nvarchar(200)) as ">
		  <text v="" e=""></text>
		</field>
		
		<field name="ma_rm" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false">
          <text v="Rờ mooc" e="Ro mooc"></text>
          <viewInfo lookupType="One" lookupId="vdmromooc" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_rm" lookupInfo="vdmromooc|ma_rm|ten_rm" />
        </field>
        <field name="ten_rm" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
		<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" >
			<text v="Ngày hiệu lực " e="Effective date"></text>
		</field>
		<field name="di_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
			<text v="" e=""></text>
		</field>
				
		<field name="ngay_hld" label="[100]" field="[120]" dataType="D" allowBlank="false" nextRow="false" >
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>
	
		<field name="dien_giai" label="1" rows="1" field="-">
		  <text v="Diễn giải" e="Explain"></text>
		</field>
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_dh" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
      </fields>
    </form>

   
    <form tabPageIndex="1" gravity="MiddleLeft" height="300" columns="120,120,240" >
