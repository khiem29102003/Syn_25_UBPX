<dir id="tb_Product" table="tb_Product" fieldKey="Id" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Sản phẩm" e="Product List"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120" >
      <fields>
       <field name="Id" fieldType="PK" width="120">
          <text v="Mã sản phẩm" e="Product code"></text>
        </field>
		 <field name="Title"   width="120">
          <text v="Tên sản phẩm" e="Product name"></text>
        </field>
		<field name="Alias"  width="120">
          <text v="Alias" e="Alias"></text>
        </field>
		<field name="ProductCode"  width="120">
          <text v="Code sản phẩm" e="Product code"></text>
        </field>
		<field name="ProductCategoryId" viewType="Lookup" label="1" field="1" >
          <text v="Mã loại sản phẩm" e="Product category code"></text>
          <viewInfo lookupType="One" lookupId="tb_ProductCategory" lookupKey="IsActive=1" lookupCheck="1=1" lookupRef="ProductCategoryName" lookupInfo="tb_ProductCategory|Id|Title"/>
        </field>
		<field name="ProductCategoryName" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="PromotionId" viewType="Lookup" label="1" field="1" >
          <text v="Mã khuyến mãi" e="Promotion code"></text>
          <viewInfo lookupType="One" lookupId="tb_Promotion" lookupKey="IsActive=1" lookupCheck="1=1" lookupRef="PromotionName" lookupInfo="tb_Promotion|Id|Title"/>
        </field>
		<field name="PromotionName" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="BrandId" viewType="Lookup" label="1" field="1" >
          <text v="Mã thương hiệu" e="Brand Code"></text>
          <viewInfo lookupType="One" lookupId="tb_Brand" lookupKey="IsActive=1" lookupCheck="1=1" lookupRef="BrandName" lookupInfo="tb_Brand|Id|Title"/>
        </field>
		<field name="BrandName" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="Description" width="120">
          <text v="Mô tả" e="Description"></text>
        </field>
		 <field name="Detail"  width="120">
          <text v="Chi tiết" e="Detail"></text>
        </field>
		<field name="Information"  width="120">
          <text v="Thông tin sản phẩm" e="Information"></text>
        </field>
		
		<field name="Image" label="1" field="2" viewType="Image" fieldType="EXParam">
          <text v="" e=""></text>
           <viewInfo fileFieldId0="Id" fileGroup="Item" fileExtension="jpg,png" maxFileSize="10240" maxFileCount="1"></viewInfo>
        </field>
		 

		<field name="Price"  width="120" dataType="N">
          <text v="Giá gốc" e="Price"></text>
        </field>
		<field name="PriceSale"  width="120" dataType="N">
          <text v="Giá khuyến mãi" e="Price sale"></text>
        </field>
		<field name="Quantity" width="120">
          <text v="Số lượng" e="Quantity"></text>
        </field>
		<field name="Guarantee" width="120">
          <text v="Bảo hành" e="Guarantee"></text>
        </field>
		<field name="ViewCount" width="120">
          <text v="Số lượt xem" e="View count"></text>
        </field>
		<field name="Position"  width="120">
          <text v="Thứ tự" e="Position"></text>
        </field>
		<field name="SeoTitle"  width="120">
          <text v="Seo Title" e="Seo Title"></text>
        </field>
        <field name="SeoDescription" width="250">
          <text v="Seo Description" e="Seo Description"></text>
        </field>
		<field name="SeoKeywords" width="250">
          <text v="Seo Keywords" e="Seo Keywords"></text>
        </field>
		<field name="IsActive" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="IsHome" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trang chính" e="Is Home"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="IsFeature" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Tính năng" e="Is Feature"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="IsSale" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Khuyễn mãi" e="Is Sale"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="IsHot" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Nổi bật" e="Is Hot"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
