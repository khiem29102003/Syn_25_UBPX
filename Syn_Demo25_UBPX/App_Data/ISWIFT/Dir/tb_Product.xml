  <js>
    <text>
      <![CDATA[
function dir$tb_Product(p){
  this.constructor(p);
}
dir$tb_Product.prototype = new DirEvent();
dir$tb_Product.prototype.afterInit = function(){
  var p = this._dir;
  dir$tb_ProductLoadDataQuote(p);
}
function dir$tb_ProductLoadDataQuote(p){
	if (p.options.action == "NEW" ) {
	
		p.request('get_id', '', '')

	}
}
         ]]>
    </text>

  </js>

  <script>
  <request code="get_id">
			<text> <![CDATA[ exec st_get_id_number 'tb_Product','SP' ]]> </text>
	</request>

