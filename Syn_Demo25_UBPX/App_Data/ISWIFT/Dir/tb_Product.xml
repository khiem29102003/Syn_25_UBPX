  <script>
       <query>
      <text>
        <![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @action in ('EDIT', 'VIEW') exec ISWIFTStoreGetListFiles 'Image', @Id, 'Item', '', @script output
if @script is null set @script = ''

if @action = 'EDIT'
  if exists(select 1 from syscodeexists with(nolock, index(code1)) where code1 = @Id and field = 'Id')
    select @script = @script + 'p.setDisabled(''Id'', true); '

if @action in ('EDIT', 'VIEW') select @script as script
drop table #@@table
        ]]>
      </text>
    </query>
	    <updated>
      <text>
        <![CDATA[
update dmttin set status = 0 from dmttin where id0 = @Id and xgroup = 'Item'
if @Image <> '' update dmttin set status = 1, id0 = @Id from dmttin where charindex(id, @Image) > 0 and xgroup = 'Item'
         ]]>
      </text>
    </updated>
    
    <inserting>
      <text>
        <![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
]]>
      </text>
    </inserting>
    <inserted>
      <text>
        <![CDATA[
if @Image <> '' update dmttin set status = 1, id0 = @Id from dmttin where charindex(id, @Image) > 0 and xgroup = 'Item'
]]>
      </text>
    </inserted>
	</script>
