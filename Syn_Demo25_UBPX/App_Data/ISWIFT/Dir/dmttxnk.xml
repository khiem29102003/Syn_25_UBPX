<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmttxnk" table="dmttxnk" fieldKey="ma_tt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục trạng thái" e="List of Status"></title>
  <title0 v="Thêm mới" e="Create New"></title0>
  <title1 v="Sửa" e="Edit"></title1>


  <forms>
    <form gravity="TopLeft" columns="120,120,120,120" >
      <fields>
       <field name="ma_tt" fieldType="PK" label="1" field="1" filterType="Code" allowBlank="false" importable="1">
          <text v="Mã trạng thái" e="Status Code"></text>
        </field>
        <field name="ten_tt" label="1" field="-" allowBlank="false" importable="5 ">
          <text v="Tên trạng thái" e="Status Name"></text>
        </field>		
		<field name="ord" label="1" field="1" dataType="N" importable="10" >
          <text v="Trình tự" e="Sequence"></text>
        </field>	
		<field name="status" viewType="Combobox" inactivate="true" valueDefault="1" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmttxnk(p){
  this.constructor(p);
}
dir$dmttxnk.prototype = new DirEvent();
dir$dmttxnk.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmttxnk.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

  dir$dmttxnkDisabledMasterField(p, g);

}

function dir$dmttxnkDisabledMasterField(p, g){
  
  if(p.valForm('ma_tt').trim() != '')
  {
    p.setDisabled('ma_tt', true);
  }
  else
  {
    p.setDisabled('ma_tt', false);
  }
}

         ]]>
    </text>
  </js>
  
  <css>
	<text>
	  <![CDATA[
		.control-label.ma_tt, .control-label.ten_tt
		{	
			//font-weight:bold;	
			color: #499b98;;
		}
	  ]]>
	</text>
  </css>
  
  <script>
	<importing>
      <text>
        <![CDATA[
		@@insert
        ]]>
      </text>
    </importing>
  </script>
  
  <messages>
	<message val="codeExistsNewMsg">
		<text v="Mã trạng thái đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The status code already exists in the catalog, please choose a different code."/>
	</message>
	<message val="codeExistsEditMsg">
		<text v="Mã trạng thái đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The status code already exists in the catalog, please choose a different code."/>
	</message>
  </messages>

</dir>