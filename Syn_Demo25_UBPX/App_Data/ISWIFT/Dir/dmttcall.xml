<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmttcall" table="dmttcall" fieldKey="ma_ttcall" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục trạng thái cuộc gọi" e="List of Call Status"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_ttcall" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã t/thái cuộc gọi" e="Call Status code"></text>
        </field>
        <field name="ten_ttcall" label="1" field="-" allowBlank="false" fieldType="PK" >
          <text v="Tên t/thái cuộc gọi" e="Call Status name"></text>
        </field>
        <field name="ten_ttcall2" label="1" field="-">
          <text v="Tên khác" e="Other name"></text>
        </field>
		<field name="ma_td" viewType="Lookup" label="1" field="1" clientDefault="true" importable="4">
			<text v="Mã tác động" e="Impact code"></text>
			 <viewInfo lookupType="One" lookupId="vdmtd" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_td" lookupInfo="vdmtd|ma_td|ten_td" importCheck="@@DF and z.status=1" />
        </field>
		<field name="ten_td" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true">
			<text v = "" e = ""></text>
		</field>
		<field name="ma_plkh" viewType="Lookup" label="1" field="1" clientDefault="true" importable="4">
			<text v="P/loại khách hàng" e="Customer classification"></text>
			 <viewInfo lookupType="One" lookupId="dmploaikh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_plkh" lookupInfo="dmploaikh|ma_plkh|ten_plkh" importCheck="@@DF and z.status=1" />
        </field>
		<field name="ten_plkh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true">
			<text v = "" e = ""></text>
		</field>
		<field name="is_close" dataType="B" clientDefault="true" label="1" field="[40]" nextRow="true" inactivate="true" >
			<text v="Is close" e="Is close"></text>
		</field> 
			<field name="status" viewType="Combobox" label="1" field="1" valueDefault="1">
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 order by ma_tt">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmttcall(p){
  this.constructor(p);
}
dir$dmttcall.prototype = new DirEvent();
dir$dmttcall.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmttcall.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

dir$dmttcallDisabledMasterField(p, g);

}

function dir$dmttcallDisabledMasterField(p, g){
  
  if(p.valForm('ma_ttcall').trim() != '')
  {
    p.setDisabled('ma_ttcall', true);
  }
  else
  {
    p.setDisabled('ma_ttcall', false);
  }
}
         ]]>
    </text>
  </js>
   <css>
		<text>
		  <![CDATA[
	.control-label.ma_ttcall, .control-label.ten_ttcall
	{	

		color: #499b98;;
	}
		  ]]>
		</text>
  </css>
  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã trạng thái cuộc gọi đã tồn tại.' else N'The call status code already exists.' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã trạng thái cuộc gọi đã tồn tại.' else N'The call status code already exists.' end
         ]]>
      </text>
    </declare>
  </script>
  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã trạng thái cuộc gọi đã tồn tại." e="The call status code already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã trạng thái cuộc gọi đã tồn tại." e="The call status code already exists."/>
    </message>
  </messages>
</dir>