<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmsp" table="dmsp" fieldKey="ma_sp" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục sản phẩm" e="Product List"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>
  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
          <text v="" e=""></text>
        </field>
        <field name="ma_sp" format="U" label="1" field="1" viewType="AutoIncrease" clientDefault="true" allowBlank="false" fieldType="PK" importable="5" importWidth="250">
          <text v="Mã sản phẩm" e="Code"></text>
        </field>
        <field name="ten_sp" allowBlank="false" label="1" field="-" importable="10">
          <text v="Tên sản phẩm" e="Description"></text>
        </field>
        <field name="ten_sp2" allowBlank="true" label="1" field="-" importable="15">
          <text v="Tên khác" e="Other name"></text>
        </field>
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="330" columns="120,120,240" >
      <text v="Thông tin chung" e="General"></text>
      <fields>
		<field name="ma_km" format="U" viewType="Lookup" label="1" field="1" clientDefault="true" allowBlank="false" importable="20" importWidth="50">
          <text v="Mã khuyến mãi" e="UOM"></text>
          <viewInfo lookupType="One" lookupId="dmkm" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_km" lookupInfo="dmkm|ma_km|ten_km" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_km" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="dvt" format="U" viewType="Lookup" label="1" field="1" clientDefault="true" allowBlank="false" importable="20" importWidth="50">
          <text v="Đơn vị tính" e="UOM"></text>
          <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_dvt" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
     
        <field name="ma_lvt" viewType="Lookup" label="1" field="1" clientDefault="true" importable="35">
          <text v="Loại vật tư" e="Item Type"></text>
          <viewInfo lookupType="One" lookupId="dmlvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_lvt" lookupInfo="dmlvt|ma_lvt|ten_lvt" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_lvt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true">
          <text v="" e=""></text>
        </field>
      
      </fields>
    </form>
	<form tabPageIndex="2" gravity="MiddleLeft" height="350" columns="140,120,240" >
      <text v="Bảo hành" e="Guarantee"></text>
      <fields>
        <field name="ma_imei" format="U" label="1" field="1" importable="65">
          <text v="Mã imei" e="Imei Code"></text>
        </field>
				
		<!-- <field name="bh_yn" dataType="B" clientDefault="true" label="[10]" field="[60]" inactivate="true" importable="66"> -->
          <!-- <text v="Theo dõi bảo hành" e="Guarantee Control"></text> -->
        <!-- </field> -->
        <field name="so_ngay_sp" label="1" field="1" dataType="N" format="Amount" importable="67">
          <text v="Vòng đời sp (số ngày)" e="Product Lifecycle (days)"></text>
        </field>
        <field name="so_ngay_bh" label="1" field="1" dataType="N" format="Amount" importable="68">
          <text v="Tg bảo hành (số ngày)" e="Warranty Period (days)"></text>
        </field>     
      </fields>
    </form>
	<form tabPageIndex="3" gravity="MiddleLeft" height="350" columns="120,120,240" >
      <text v="Thông tin" e="Information"></text>
      <fields>
        <field name="mo_ta" label="1" field="1" importable="69">
          <text v="Thông tin sản phẩm" e="Information"></text>
        </field>
      </fields>
    </form>
    <form tabPageIndex="4" gravity="MiddleLeft" height="350" columns="120,120,240" >
      <text v="Kích cỡ/Màu sắc" e="Size/Color"></text>
      <fields>
        <field name="ma_sp2" format="U" label="1" field="1" importable="69">
          <text v="Mã phụ" e="Other Code"></text>
        </field>
        <field name="nuoc_sx" label="1" field="2" importable="70">
          <text v="Nước sản xuất" e="Manufacturer"></text>
        </field>
        <field name="mau_sac" label="1" field="2" importable="75">
          <text v="Màu sắc" e="Color"></text>
        </field>
        <field name="kich_co" label="1" field="2" importable="80">
          <text v="Kích cỡ" e="Size"></text>
        </field>
        <field name="kieu" label="1" field="2" importable="85">
          <text v="Kiểu" e="Style"></text>
        </field>
      </fields>
    </form>
    <form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Hình ảnh" e="Images"></text>
      <fields>
        <field name="ximage" label="1" field="2" viewType="Image" fieldType="EXParam">
          <text v="Chọn hình ảnh" e="Chọn hình ảnh"></text>
          <viewInfo fileFieldId0="ma_sp" fileGroup="Item" fileExtension="jpg,png" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
    <form tabPageIndex="6" gravity="MiddleLeft" height="350" columns="120,120,240" >
      <text v="Khác" e="Other"></text>
      <fields>
        <field name="sl_min" label="1" field="1" dataType="N" format="Qty" importable="90">
          <text v="Tồn tối thiểu" e="Minimum Quantity"></text>
        </field>
        <field name="sl_max" label="1" field="1" dataType="N" format="Qty" importable="95">
          <text v="Tồn tối đa" e="Maximum Quantity"></text>
        </field>
        <field name="ngay_nhap" label="1" field="1" dataType="D" importable="96">
          <text v="Ngày nhập cuối" e="Last Receipt Date"></text>
        </field>
        <field name="ngay_xuat" label="1" field="1" dataType="D" importable="97">
          <text v="Ngày xuất cuối" e="Last Issue Date"></text>
        </field>
        <field name="ghi_chu" allowBlank="true" label="1" field="-" rows="3" importable="100">
          <text v="Ghi chú" e="Notes"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" valueDefault="1" importable="-1">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

