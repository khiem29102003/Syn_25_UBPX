  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã vật tư đã tồn tại trong danh mục vật tư." e="The record already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã vật tư đã tồn tại trong danh mục vật tư." e="The record already exists."/>
    </message>
  </messages>
</dir>