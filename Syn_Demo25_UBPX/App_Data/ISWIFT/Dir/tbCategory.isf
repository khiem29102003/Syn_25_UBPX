    </text>
  </js>

  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã kho và vị trí đã có trong danh mục vị trí kho." e="The record consisting of site and location is already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã kho và vị trí đã có trong danh mục vị trí kho." e="The record consisting of site and location is already exists."/>
    </message>
  </messages>

</dir>