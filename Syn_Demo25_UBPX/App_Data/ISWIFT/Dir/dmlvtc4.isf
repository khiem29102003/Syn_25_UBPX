<dir id="dmlvtc4" table="dmlvtc4" fieldKey="ma_lvtc4" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
	<title v="Danh mục nghành hàng cấp 4" e="Level 4 product catalog"></title>
	<title0 v="Thêm mới" e="New"></title0>
	<title1 v="Sửa" e="Edit"></title1>

	<forms>
		<form gravity="TopLeft" columns="120,120,120" >
			<fields>
				<field name="ma_lvtc4" label="1" field="2"  hidden="true" fieldType="PK" >
					<text v="Mã nghành hàng" e="Industry code"></text>
				</field>
				<field name="ten_lvtc4" label="1" field="2" allowBlank="false" >
					<text v="Tên nghành hàng" e="Industry name"></text>
				</field>
				<field name="ten_khac" label="1" field="2" allowBlank="false" >
					<text v="Tên khác" e="Other name"></text>
				</field>
				<field name="ma_lvtc3" viewType="Lookup" label="1" field="1" clientDefault="true" importable="35" allowBlank="false">
					<text v="Mã nh cấp 3" e="Industry code level 3"></text>
					<viewInfo lookupType="One" lookupId="dmlvtc3" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_lvtc3" lookupInfo="dmlvtc3|ma_lvtc3|ten_lvtc3" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_lvtc3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true">
					<text v="" e=""></text>
				</field>
				<field name="unit_id" label="1" field="2" hidden="true" dataType="I">
					<text v="Đơn vị" e="Unit"></text>
				</field>
				<field name="thu_tu" label="1" field="2" dataType="I">
					<text v="Thứ tự" e="Position"></text>
				</field>
				<field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
					<text v="Trạng thái" e="Status"></text>
					<viewInfo>
						<options>
							<option val="1">
								<text v="1 - Còn sử dụng" e="1 - Use"></text>
							</option>
							<option val="0">
								<text v="0 - Không sử dụng" e="0 - Not use"></text>
							</option>
						</options>
					</viewInfo>
				</field>
			</fields>
		</form>
	</forms>

	&DefaultButton;

