<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="hrelcb" table="hrelcb" fieldKey="id, line" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Lương cơ bản" e=""></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120" >
      <fields>
        <field name="id" dataType="N" fieldType="PK" label="1" field="1" format="0" hidden="true">
          <text v="ID" e="ID"></text>
        </field>
        <field name="line" dataType="N" fieldType="PK" label="1" field="1" format="0" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ngay_hl" dataType="D" allowBlank="false" label="1" field="1" >
          <text v="Ngày hiệu lực" e=""></text>
        </field>
        <field name="ngay_qd" dataType="D" label="1" field="1" >
          <text v="Ngày quyết định" e=""></text>
        </field>
        <field name="he_so" dataType="N" label="1" field="1" format="2">
          <text v="Hệ số" e=""></text>
        </field>
        <field name="muc_luong" dataType="N" label="1" field="1" format="0">
          <text v="Mức lương" e=""></text>
        </field>
        <field name="phu_cap1" dataType="N" label="1" field="1" format="0">
          <text v="Phụ cấp 1" e=""></text>
        </field>
        <field name="phu_cap2" dataType="N" label="1" field="1" format="0">
          <text v="Phụ cấp 2" e=""></text>
        </field>
        <field name="phu_cap3" dataType="N" label="1" field="1" format="0">
          <text v="Phụ cấp 3" e=""></text>
        </field>
        <field name="phu_cap4" dataType="N" label="1" field="1" format="0">
          <text v="Phụ cấp 4" e=""></text>
        </field>
        <field name="phu_cap5" dataType="N" label="1" field="1" format="0">
          <text v="Phụ cấp 5" e=""></text>
        </field>
        <field name="ghi_chu" rows="3" label="1" field="-" >
          <text v="Ghi chú" e="Notes"></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$hrelcb(p){
  this.constructor(p);
}
dir$hrelcb.prototype = new DirEvent();
dir$hrelcb.prototype.afterInit = function(){
  var p = this._dir, pa = p.options.parent;
  if (p.options.action == 'NEW') p.valForm('id', pa.options._id);
}
]]>
    </text>
  </js>

  <script>

    <beforesave>
      <text>
        <![CDATA[
if exists(select 1 from @@table where ngay_hl = @ngay_hl and id = @id and line <> @line) begin
  select N'$exists' as message
  return
end
]]>
      </text>
    </beforesave>

    <updating>
      <text>
        <![CDATA[
if exists(select 1 from @@table where ngay_hl = @ngay_hl and id = @id and line <> @line) begin
  select N'$exists' as message
  return
end
]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]
         ]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[
select @line = max(line) from @@table where id = @id
set @line = isnull(@line, 0) + 1
select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId

if exists(select 1 from @@table where ngay_hl = @ngay_hl and id = @id) begin
  select N'$exists' as message
  return
end
]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[
select @line as [#line]
        ]]>
      </text>
    </inserted>

  </script>

  <messages>
    <message val="exists">
      <text v="Khai báo đã tồn tại." e="" />
    </message>
  </messages>

</dir>