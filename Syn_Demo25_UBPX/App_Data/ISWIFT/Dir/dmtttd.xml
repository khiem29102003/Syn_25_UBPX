<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmtttd" table="dmtttd" fieldKey="ma_tttd" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục trạng thái tác động" e="Action Status List"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_tttd" format="U" label="1" field="1" allowBlank="false" fieldType="PK" importable="1">
          <text v="Mã trạng thái" e="Status code"></text>
        </field>
        <field name="ten_tttd" label="1" field="-" allowBlank="false" fieldType="PK"  importable="2">
          <text v="Tên trạng thái" e="Status name"></text>
        </field>
		<field name="ma_loai" viewType="Lookup" label="1" field="1" nextRow="false" importable="3" >
		  <text v="Loại trạng thái" e="Religion"></text>
		  <viewInfo lookupType="One" lookupId="dmloaitd" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_loai" lookupInfo="dmloaitd|ma_loai|ten_loai" importCheck="@@DF and z.status=1"/>
		</field>
		<field name="ten_loai" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
		   <text v="" e=""></text>
		</field>
        <field name="status" viewType="Combobox" inactivate="true" valueDefault ="1" label="1" field="2" importable="-1" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmtttd(p){
  this.constructor(p);
}
dir$dmtttd.prototype = new DirEvent();
dir$dmtttd.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmtttd.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

dir$dmtttdDisabledMasterField(p, g);

}

function dir$dmtttdDisabledMasterField(p, g){
  
  if(p.valForm('ma_tttd').trim() != '')
  {
    p.setDisabled('ma_tttd', true);
  }
  else
  {
    p.setDisabled('ma_tttd', false);
  }
}
         ]]>
    </text>
  </js>
  <css>
		<text>
		  <![CDATA[
	.control-label.ma_tttd, .control-label.ten_tttd
	{	
		//font-weight:bold;	
		color: #499b98;;
	}
		  ]]>
		</text>
  </css>
  <importing>
      <text>
        <![CDATA[
---update #data set unit_id = @@unit
@@insert
        ]]>
      </text>
    </importing>
  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã trạng thái đã tồn tại.' else N'Status code already exists.' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã trạng thái đã tồn tại.' else N'Status code already exists.' end
         ]]>
      </text>
    </declare>
  </script>
  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã trạng thái đã tồn tại." e="Status code already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã trạng thái đã tồn tại." e="Status code already exists."/>
    </message>
  </messages>
</dir>