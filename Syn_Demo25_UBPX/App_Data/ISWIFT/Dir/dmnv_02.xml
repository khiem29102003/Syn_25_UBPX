     <![CDATA[
function dir$dmnv(p){
  this.constructor(p);
  document._dir = p;

}
dir$dmnv.prototype = new DirEvent();

dir$dmnv.prototype.formFieldValueChange = function (o, cF, v) {
  var p = this._dir;
  switch (cF){
	case 'ma_dv':
		if(p.options.action == "NEW")
		{
			p.request('GetEmployeeCode', '', ['ma_dv']);
		}
		break;
	case 'bhxh_yn':
		if(p.valForm('bhxh_yn') == 1) { p.setInvisible(['so_bhxh','cd_bhxh','ghichu1'], false) }
		else { p.setInvisible(['so_bhxh','cd_bhxh','ghichu1'], true) };
		break;
	case 'bhyt_yn':
		if(p.valForm('bhyt_yn') == 1) { p.setInvisible(['so_bhyt','cd_bhyt','ghichu2'], false) }
		else { p.setInvisible(['so_bhyt','cd_bhyt','ghichu2'], true) };
		break;
	case 'bhtn_yn':
		if(p.valForm('bhtn_yn') == 1) { p.setInvisible(['so_bhtn','cd_bhtn','ghichu3'], false) }
		else { p.setInvisible(['so_bhtn','cd_bhtn','ghichu3'], true) };
		break;
    default:
      break;
  }
}
function getDV() {
var madv = 'where ma_dv = '+localStorage.getItem('madv');

if (madv == 'BD') {
document.querySelector("input.ma_dv_temp").setAttribute('value', madv);
}

console.log(madv)
}
function getTax(o) {
  var p = document._dir;
  var tax = p.valForm('ma_so_thue');
  if (tax.length != 10 && tax.length != 13) {
    $.showToast('Thông tin mã số thuế không đúng.');
    return;
  }
  
  $.invoke('GetTax', { taxCode: tax }, this, 30000
    , function (result) {
      if (result) {
        var obj = JSON.parse(result);
        p.valForm('ten_nv', obj.Name, true);
        p.valForm('dia_chi', obj.Address, true);
		p.valForm('ten_nv2', obj.Other, true);
		p.valForm('nguoi_lh', obj.Contact, true);
		p.valForm('dien_thoai', obj.Telephone, true);
		
      }
    }, function (event) {} );
	
}



function getCMND(o) {
  var p = document._dir;
  var cmnd = p.valForm('cmnd_so');
  if (cmnd.length != 9 && cmnd.length != 12) {
    $.showToast('Thông tin CMT/CCCD không đúng.');
    return;
  }
  
  $.invoke('GetTax', { taxCode: cmnd }, this, 30000
    , function (result) {
      if (result) {
        var obj = JSON.parse(result);
        p.valForm('ten_nv', obj.Name, true);
        p.valForm('dia_chi', obj.Address, true);
		p.valForm('ten_nv2', obj.Other, true);
		p.valForm('nguoi_lh', obj.Contact, true);
		p.valForm('ma_so_thue', obj.TaxCode, true);
		p.valForm('dien_thoai', obj.Telephone, true);
		
      }
    }, function (event) {} );
	
}


dir$dmnv.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()
 

	
  dir$dmnvDisabledMasterField(p, g);
  dir$dmnvInvisibleMasterField(p, g)
  
  document._dir = p;
  //getDV();
}

function dir$dmnvDisabledMasterField(p, g){
	if(p.valForm('ma_nv').trim() != '')
  {
    p.setDisabled('ma_nv', true);
  }
  else
  {
    p.setDisabled('ma_nv', false);
  }
}
function dir$dmnvInvisibleMasterField(p, g){

	if (p.valForm('bhxh_yn') == 0) p.setInvisible(['so_bhxh','cd_bhxh','ghichu1'], true);
	if (p.valForm('bhyt_yn') == 0) p.setInvisible(['so_bhyt','cd_bhyt','ghichu2'], true);
	if (p.valForm('bhtn_yn') == 0) p.setInvisible(['so_bhtn','cd_bhtn','ghichu3'], true);
	
}
