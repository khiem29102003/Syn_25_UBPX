<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmhh" table="dmhh" fieldKey="ma_vt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hàng hóa" e="Commodity Menu"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_vt" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã vật tư" e="Agent Code"></text>
        </field>
        <field name="ten_vt" label="1" field="2" allowBlank="false" fieldType="PK" >
          <text v="Tên vật tư" e="Agent Name"></text>
        </field>
        <field name="ten_vt2" label="1" field="2">
          <text v="Tên khác" e="Other name"></text>
        </field>
		<field name="ma_dvt" viewType="Lookup" label="1" field="[120] ">
           <text v="Mã đơn vị tính" e="Unit Code"></text>
           <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_dvt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
           <text v="" e=""></text>
        </field>	
		<field name="ma_nhom" viewType="Lookup" label="1" field="[120] ">
           <text v="Mã nhóm" e="Group Code"></text>
           <viewInfo lookupType="One" lookupId="dmnhomhh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nhom" lookupInfo="dmnhomhh|ma_nhom|ten_nhom" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_nhom" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
           <text v="" e=""></text>
        </field>	
		<field name="dg_ban" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Đang bán" e="On Sale"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmhh(p){
  this.constructor(p);
}
dir$dmhh.prototype = new DirEvent();
dir$dmhh.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã hàng hóa đã tồn tại' else N'Commodity code already exists' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã hàng hóa đã tồn tại' else N'Commodity code already exists' end
         ]]>
      </text>
    </declare>
  </script>

</dir>