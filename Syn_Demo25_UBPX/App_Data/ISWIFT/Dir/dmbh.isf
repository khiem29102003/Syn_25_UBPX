<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmbh" table="dmbh" fieldKey="ma_bh" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bảo hành" e="Insurance list"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_bh" format="U" label="1" field="2" allowBlank="false" fieldType="PK" >
          <text v="Mã bảo hành" e="Insurance code"></text>
        </field>
        <field name="ten_bh" label="1" field="2" allowBlank="false"  >
          <text v="Tên bảo hành" e="Insurance name"></text>
        </field>
        <!-- <field name="model" label="1" field="2" fieldType="PK"> -->
          <!-- <text v="Model" e="Modal name"></text> -->
        <!-- </field> -->
		<field name="model" allowBlank="false" viewType="Lookup" label="[120]" field="[120]"  hidden="false" nextRow="true" disabled="false">
			<text v="Mã Model" e="Product Code"></text>
			<viewInfo lookupType="One" lookupId="dmvt" lookupKey="status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmvt|ma_vt|ten_vt" />
		</field>
		<!-- <field name="ten_vt" nextRow="true" fieldType="EX" readOnly="false"  disabled = "true" inactivate="true"  hidden="false" label="1" field="2" aliasName="cast('' as nvarchar(200)) as "> -->
			<!-- <text v="Tên vật tư" e="Product Name"></text> -->
		<!-- </field> -->
		<field name="ten_vt" label="1" field="2" disabled ="true" fieldType="EX">
          <text v="Tên sản phẩm" e="Product name"></text>
        </field>
		<field name="so_ngay_bh" label="1" field="2" disabled="true" dataType="I" fieldType="EX">
          <text v="Bảo hành (tháng)" e="Guarantee"></text>
        </field>
		
		<field name="ngay_bh" label="1" field="2" allowBlank="false" dataType="D">
          <text v="Ngày bảo hành" e="Guarantee start"></text>
        </field>
		<field name="ngay_hbh" label="1" field="2" allowBlank="true" dataType="D" disabled="true">
          <text v="Ngày hết bảo hành" e="Guarantee end"></text>
        </field>
		<field name="series" label="1" field="2" allowBlank="true" viewType="Lookup" readOnly="false" >
          <text v="Serial number(S/N)" e="Serial number(S/N)"></text>
          <viewInfo lookupType="One" lookupId="dmmodelvt" lookupKey="ma_vt = ![model]! and xstatus = 0 and xstatus2 = 0" lookupCheck="1=1" lookupRef="" lookupInfo="dmmodelvt|ma_model" />
        </field>
		<field name="pn" label="1" field="2" allowBlank="true" readOnly="false" >
          <text v="P/N" e="P/N"></text>         
        </field>
		<field name="ma_kh" allowBlank="false" viewType="Lookup" label="[120]" field="[120]" hidden="false" nextRow="true" disabled="false">
			<text v="Mã khách hàng" e="Custom Code"></text>
			<viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmkh|ma_kh|ten_kh" />
		</field>
		<field name="ten_kh" label="1" field="2" allowBlank="false" disabled="true">
          <text v="Tên khách hàng" e="Customer name"></text>
        </field>
		<field name="dien_thoai" label="1" field="2" allowBlank="false" disabled="true">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="noi_mua" label="1" field="2" allowBlank="false">
          <text v="Nơi mua" e="Where"></text>
        </field>
		<field name="khoang_trang_action" label="1" field="2" fieldType="EX" hidden="true">
          <text v="Action" e="Action"></text>
        </field>
		<field name="so_luong" label="1" field="2" allowBlank="false" dataType="I">
          <text v="Số lượng" e="Quantity"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
	<form gravity="TopRight" columns="120,120" >
		<fields>
			<field name="ximage1" label="1" field="0" importable="65">
			  <text v="&lt;img class='image-single' id='img_ximage1' src='' onerror='src=`../Images/noImage.png`'/&gt; &lt;input type='button' value='Tải ảnh' onclick='browseServer(`ximage1`, `img_ximage1`);' value='Mở 1' style='text-align: center; display: block; margin: 0 auto;' /&gt;" e="Image 1"></text>
			</field>
	   </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <script>
	<query>
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </query>
