  <script>
    &VoucherRequest;
    &VoucherSaleRequest;
		<request code="quote_request">
			<text>
			  <![CDATA[
			  		---DECLARE @ds_cong VARCHAR(4000)  
					---SELECT distinct ma_cong into #tt FROM v41 a where a.id = @id_bg
					---SELECT @ds_cong = COALESCE(@ds_cong + ', ','') + ltrim(rtrim(ma_cong)) FROM #tt
					
					select top 1 a.id_bg as [!id_bg],a.ngay_hl as [!ngay_hl],a.ngay_hld as [!ngay_hld], a.book_no as [!book_no], a.so_tk as [!so_tk], 
					a.ma_kh as [!ma_kh],a.ma_kh_g as [!ma_kh_g],a.ma_kh_s as [!ma_kh_s],a.ma_nv as [!ma_nv],a.ma_hang as [!ma_hang], a.ma_noi_di as [!ma_noi_di],
					a.ma_noi_den as [!ma_noi_den],a.ma_noi_dodong as [!ma_noi_dodong], a.ma_noi_giaonhan as [!ma_noi_giaonhan],
					b.ten_noi_di as [!ten_noi_di],c.ten_noi_den as [!ten_noi_den],i.ten_noi_dodong as [!ten_noi_dodong],j.ten_noi_giaonhan as [!ten_noi_giaonhan],
					a.ds_cong as [!ds_cong],d.ten_kh as [!ten_kh],e.ten_kh as [!ten_hang], f.ten_nv as [!ten_nv], g.ten_kh as [!ten_kh_g],h.ten_kh as [!ten_kh_s]
				  from s611 a 
				  left join vdmcangdi b on a.ma_noi_di =b.ma_noi_di 
				  left join vdmcangden c on a.ma_noi_den =c.ma_noi_den 
				  left join dmkh d on a.ma_kh =d.ma_kh 
				  left join dmkh e on a.ma_hang =e.ma_kh 
				  left join dmnv f on a.ma_nv = f.ma_nv
				  left join dmkh g on a.ma_kh_g = g.ma_kh
				  left join dmkh h on a.ma_kh_s = h.ma_kh
				  left join vdmcangdodong i on a.ma_noi_dodong = i.ma_noi_dodong
				  left join vdmcanggiaonhan j on a.ma_noi_giaonhan = j.ma_noi_giaonhan
				  where a.id = @id_dh
			]]>
			</text>
		</request>
		<request code="ma_dk_ngay">
			<text>
			  <![CDATA[
				  select @t2_yn = 1,@t3_yn = 1,@t4_yn = 1,@t5_yn = 1,@t6_yn = 1,@t7_yn = 1,@t8_yn = 1
				  select @t2_yn as [!t2_yn],@t3_yn as [!t3_yn],@t4_yn as [!t4_yn],@t5_yn as [!t5_yn],@t6_yn as [!t6_yn],@t7_yn as [!t7_yn],@t8_yn as [!t8_yn]
			]]>
			</text>
		  </request>
		  
		   <request code="GetExRateDetail">
      <text>
        <![CDATA[
			select dbo.sf_GetExRate(@ma_nt, @ngay_ct) as #ty_gia
        ]]>
      </text> 
    </request>
	
    <query>
      <text>
        <![CDATA[
if @action = 'EDIT' begin
]]>&CheckUpdatingDeleting;<![CDATA[
end
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @action in ('EDIT', 'VIEW') exec ISWIFTStoreGetListFiles 'xfile', @id, '@@voucherCode', '', @script output
if @script is null set @script = ''

if @action = 'NEW' begin
  declare @ma_nk varchar(32), @ten_nk nvarchar(3000), @ngay_ct date, @so_ct varchar(32), @i_so_ct int, @unit_id int
  select @ngay_ct = getdate(), @unit_id = @@unit
  
  
]]>&VoucherNumberQuery;<![CDATA[
  if @so_ct is null
    select '' as [so_ct], 0 as [i_so_ct], @unit_id as [unit_id], '' as ma_nk, '' as ten_nk
  else
    select @so_ct as [so_ct], @i_so_ct as [i_so_ct], @unit_id as [unit_id], @ma_nk as ma_nk, @ten_nk as ten_nk
end
else select @script as script
drop table #@@table
         ]]>
      </text>
    </query>

    <declare>
      <text>
        <![CDATA[
declare @warning nvarchar(256), @dOldVoucherDate date, @dVoucherDate date, @nVoucherType tinyint, @strIds varchar(256), @q nvarchar(4000)
set @warning = ''

         ]]>
      </text>
    </declare>

    &VoucherJSLoading;

    <beforesave>
      <text>
        &VoucherNumberBeforeSave;
		<![CDATA[
		if @@admin = 0 and @status = 7 and not exists(select 1 from kbnguoiduyet y where y.user_id = @@userId and y.status = 1 and y.loai = 1 and @ma_nt = y.ma_nt and (y.tien = 0 or @t_tt_nt <= y.tien)) begin
		  select '$notApproveRight' as message, 'status' as field
		  return
		end
		]]>
      </text>
    </beforesave>

    <deleting>
      <text>
        &CheckUpdatingDeleting;
        <![CDATA[
select @dOldVoucherDate = ngay_ct, @dVoucherDate = ngay_ct, @nVoucherType = ma_ngv from s631 where id = @id
        ]]>
      </text>
    </deleting>

    <deleted>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
-- Áp dụng cho dữ liệu lớn
exec ISWIFTStoredDeleteDataWithKey 'v631', @strIds, '', @dVoucherDate

        ]]>
      </text>
    </deleted>

    <updating>
      <text>

        <![CDATA[
select @dOldVoucherDate = ngay_ct from s631 where id = @id
        ]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId, i_so_ct = @i_so_ct, so_ct = @so_ct where [%whereFieldKey]
update dmttin set status = 0 from dmttin where id0 = rtrim(@id) and xgroup = '@@voucherCode'
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
         ]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[
select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @ma_ct = '@@voucherCode'
exec ISWIFTStoredGetIdentityNumber '@@voucherCode', '@@table', @id output
         ]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
]]>
      </text>
    </inserted>

    <aftersave>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
if @action = 'NEW' set @dOldVoucherDate = @ngay_ct
update @v631 set id = @id, ma_kh = @ma_kh, ngay_ct = @ngay_ct, so_ct = @so_ct, status = @status
delete v631 where id = @id
insert v631 select * from @v631


--exec ISWIFTStoredPostingVoucher 's631', 'v631', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
--exec ISWIFTStoredPostingVoucher 's631', 'v631_1', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
--exec ISWIFTStoredPostingVoucher 's631', 'v631_2', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
--exec ISWIFTStoredPostingVoucher 's631', 'v631_3', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''


exec ISWIFTStoredIncreaseVoucherNo @ma_nk, @ngay_ct, '@@voucherCode', @i_so_ct, @so_ct, '@@table'
select '' as message, @warning as warning, @id as [#id], @so_ct as [#so_ct], @ma_unit as [#ma_unit]
]]>
      </text>
    </aftersave>
  </script>

  <messages>
  <message val="EmptyContainer">
      <text v="Vui lòng nhập Container" e="Please Enter Congtainer" />
    </message>
	 <message val="HaveIDBG">
      <text v="Chỉ thực hiện khi đơn hàng có số báo giá" e="Only fulfillment when the order has a quotation number" />
    </message>
    <message val="physicalRetrieve">
      <text v="Chỉ xử lý nghiệp vụ sổ sách lấy dữ liệu từ thực tế" e="" />
    </message>
	 <message val="noDate">
      <text v="Ngày hiệu lực đến không hợp lệ." e="Error Expiry Date."/>
    </message>
	<message val="notApproveRightEdit">
      <text v="Không có quyền sửa/xóa đơn hàng đã duyệt ngoài mức được phân quyền" e="" />
    </message>
	<message val="notApproveRight">
      <text v="Không có quyền duyệt đơn hàng" e="" />
    </message>
	 <message val="OnLyNew">
      <text v="Chỉ thực hiện chức này ở trạng thái thêm mới." e="Only perform this function in the newly added state."/>
    </message>
  </messages>
</dir>