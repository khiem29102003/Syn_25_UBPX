	"gia1":["t_so_luong","tien1", "t_tien1", "t_km", "t_tc_tien2", "t_thue", "t_ck","tc_tien2","tc_tien_nt2","tt_nt","tt","tien_ln","t_tc_tien2","t_tc_tien_nt2","t_tt_nt","t_tt","t_tl_ln"],
