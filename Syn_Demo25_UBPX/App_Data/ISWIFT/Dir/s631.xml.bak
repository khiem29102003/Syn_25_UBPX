<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields03.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields04.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid1.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from s631 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
  if @@admin = 0 and exists(select 1 from s631 a where status = 7 and id = @id and not exists(select 1 from kbnguoiduyet y where y.user_id = @@userId and y.status = 1 and y.loai = 1 and a.ma_nt = y.ma_nt and (y.tien = 0 or a.t_tt_nt &lt;= y.tien))) begin
    select '$notApproveRightEdit' as message
    return
  end
    ">
]>


<dir id="s631" table="s631" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="PB1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phiếu bán" e="Billing"></title>
  <title0 v="Tạo phiếu bán [%s]" e="Create an offer [%s]"></title0>
  <title1 v="Sửa phiếu bán [%s]" e="Edit an offer [%s]"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
	  	<field name="tt" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="1" field="[40]">
          <text v="Thông tin đơn hàng: " e="Order Information: "></text>
        </field>
		<field name="id_dh" nextRow="false" dataType="N" fieldType="PK" disabled="true" format="0" copy="false" hidden="false" blank="[260]" label="[80]" field="[80]">
		  <text v="Số đơn hàng" e=""></text>
		</field>
         <field name="ma_kh" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false">
          <text v="Khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_hang" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false">
		  <text v="Hãng tàu/ Đại lý" e="Carrier/ Agent Code"></text>
		  <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1 and (ncc_yn =1 or dl_yn = 1)" lookupCheck="1=1" lookupRef="ten_hang" lookupInfo="dmkh|ma_kh|ten_kh" />
		</field>
		<field name="ten_hang" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="-" aliasName="cast('' as nvarchar(200)) as ">
		  <text v="" e=""></text>
		</field>
		<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" >
			<text v="Ngày hiệu lực " e="Effective date"></text>
		</field>
		<field name="di_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
			<text v="" e=""></text>
		</field>
				
		<field name="ngay_hld" label="[100]" field="[120]" dataType="D" allowBlank="false" nextRow="false" >
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>
		<field name="ds_cong" allowBlank="true" viewType="Lookup" label="1" field="-"  hidden="false">
			<text v="Container" e="Container List"></text>
			<viewInfo lookupType="Multi" lookupId="dmcong2" lookupKey="status=1" lookupCheck="status=1" lookupRef="" lookupInfo="dmcong|ma_cong|ten_cong" />
		</field>
		<field name="ma_noi_di" viewType="Lookup" label="1" field="1" allowBlank="false">
			<text v="Cảng đi" e="Origin"></text>
			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="(kkh_yn = 1 or hc_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
		</field>
		<field name="ten_noi_di" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1"  aliasName="cast('' as nvarchar(4000)) as ">
			<text v="" e=""></text>
		</field>	
		<field name="book_no" label="[100]" field="[120]" allowBlank="true" nextRow="false">
			<text v="Book No." e="Book No"></text>
		</field>
		<field name="ma_noi_den" viewType="Lookup" label="1" field="1" allowBlank="false">
			<text v="Cảng đến" e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="(kkh_yn = 1 or hc_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_den" lookupInfo="vdmcangden|ma_noi_den|ten_noi_den"/>
		</field>
		<field name="ten_noi_den" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="1" aliasName="cast('' as nvarchar(200)) as ">
			<text v="" e=""></text>
		</field> 		
		<field name="so_tk" label="[100]" field="[120]" allowBlank="true" nextRow="false">
			<text v="Số tờ khai" e="Declaration Number "></text>
		</field>	
		<field name="ma_nv" clientDefault="true" viewType="Lookup" label="1" field="1" allowBlank="false"  setype="1">
          <text v="Mã nhân viên" e="Employee Code"></text>
          <viewInfo lookupType="One" lookupId="dmnv" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nv" lookupInfo="dmnv|ma_nv|ten_nv" />
        </field>
        <field name="ten_nv" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
			
		<field name="dien_giai" label="1" rows="1" field="-">
		  <text v="Diễn giải" e="Explain"></text>
		</field>
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_yc" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_bg" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
      </fields>
    </form>

   
    <form tabPageIndex="1" gravity="MiddleLeft" height="300" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="v631" allowBlank="true" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
