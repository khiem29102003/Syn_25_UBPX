dir$s631.prototype.gridDetailActionChange = function(gindex, action, r){
  var p = this._dir;
  if (action == 'AfterDeleteRow' || action == 'AfterAppendGrid') dir$s631DisabledMasterField(p, p.grid(gindex));
  return true;
}
function dir$s631DisabledMasterPort(p){
	if (p.valForm('id_yc') != 0) p.setDisabled([ 'ma_noi_di','ma_noi_den'], true);
  else p.setDisabled([ 'ma_noi_di','ma_noi_den'], false);
}
function dir$s631DisabledMasterField(p, g){
  var dt = g.data, rows = dt.findRow("[ma_phi].trim() != ''"), dis = rows.length > 0;
  p.setDisabled('unit_id', dis);
  p.setInactive('unit_id', true);
  
  p.setDisabled([ 'ma_noi_di','ma_noi_den'], false);
  
  if (p.options._sale_lock_master == 1) p.setDisabled([ 'ma_noi_di','ma_noi_den','ngay_ct', 'ma_nt'], dis);
  
}
function dir$s631HiddenColumnByType(p){
  var v = p.valForm('ma_ngv'), nt = p.valForm('ma_nt'), bc = p.options.struct.baseCurrency;
}
function dir$s631HiddenColumnByTran(p){
  
}
function dir$s631LoadDataQuote(p){
var pa = p.options.parent;
  if (p.options.action == 'NEW')
  {
  p.valForm('id_dh', pa.options._id_dh)
  p.setTitle(['%s', pa.options._id_dh]);
  p.request('quote_request', '', ['id_dh']);
  
  p.setDisabled([ 'ma_noi_di','ma_noi_den','ma_kh','ma_hang','ngay_ct', 'ma_nt','ma_kh_g', 'ma_kh_s', 'ma_nv', 'ma_noi_dodong', 'ma_noi_giaonhan','ngay_hl','ngay_hld','book_no','so_tk','unit_id','ds_cong'], true);
  }
}

function dir$s631HiddenColumnByDay(p){
	var v = p.valForm('ma_dk_ngay');
	if (v == 1) p.request('ma_dk_ngay', '', ['t2_yn','t3_yn','t4_yn','t5_yn','t6_yn','t7_yn','t8_yn']);
	p.setDisabled(['t2_yn','t3_yn','t4_yn','t5_yn','t6_yn','t7_yn','t8_yn'], v == 1);
	}

function dir$s631DisabledStatusByAction(p){
  var o = p.jObject('status');
  if (p.options.action != 'VIEW') o.find("[value=6],[value=7],[value=9]").remove();
}



         ]]>
    </text>
  </js>

<css>
    <text>
