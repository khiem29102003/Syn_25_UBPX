dir$s631.prototype.beforeButtonDialogClick = function (id) {
  var p = this._dir, g = p.grid(0), dt = g.data;
  switch (id) {
    case 'ok':
		var d = p.valForm('ngay_hl'),d2 = p.valForm('ngay_hld');
		var k = $.date(d,"dd/mm/yy"),k2 = $.date(d2,"dd/mm/yy");
		if (p.valForm('ngay_hld') <= p.valForm('ngay_hl')) { 
			<!-- $.question('jkhj '+'Nhap sai ngay ??' ); -->
			<!-- $.showToast(p.msg('noDate')); -->
			
			$.alert(p.msg('noDate')+' ' + k + ' < ' + k2);			
			return false;
			Break;
			}	  		  
    default:
      break;
  }
  return true;
}
dir$s631.prototype.beforeButtonGridClick = function (id, gindex) {

  var p = this._dir;
  switch (id) {
	case '10':
     if (p.valForm('ma_noi_di').trim() == '') {
        p.jObject('ma_noi_di').focus(); 
        return;
      }if (p.valForm('ma_noi_den').trim() == '') {
        p.jObject('ma_noi_den').focus(); 
        return;
      }if (p.valForm('id_bg') == 0) {
		$.showToast(p.msg('HaveIDBG'));
        return;
      }
       p.showFilter("s631BQ1", null, {_ngay_ct: p.valForm('ngay_ct'),_ngay_ct1: p.valForm('ngay_hl'),_ngay_ct2: p.valForm('ngay_hld'),_ma_noi_di: p.valForm('ma_noi_di'), _ten_noi_di: p.valForm('ten_noi_di'), _ma_noi_den: p.valForm('ma_noi_den'), _ten_noi_den: p.valForm('ten_noi_den'), _id_bg: p.valForm('id_bg')});	  
	  p.setInactive([ 'ma_noi_di','ma_noi_den'], false);
	  return false;
      break;
    case '20':
        var p = document._dir;
		if (p.valForm('id_bg') != '') {
			$.showToast(p.msg('NewOrder'));
			return;
		 }
	   if (p.valForm('ma_noi_di').trim() == '') {
        p.jObject('ma_noi_di').focus(); 
        return;
      }if (p.valForm('ma_noi_den').trim() == '') {
        p.jObject('ma_noi_den').focus(); 
        return;
      }
	  if (p.valForm('ds_cong').trim() == '') {
		$.showToast(p.msg('EmptyContainer'));
        p.jObject('ds_cong').focus(); 
        return;
      }  
      p.showFilter("s621BN1", null, {_ngay_ct: p.valForm('ngay_ct'),_ngay_ct1: p.valForm('ngay_hl'),_ngay_ct2: p.valForm('ngay_hld'),_unit_id: p.valForm('unit_id'),_id_dh: p.valForm('id_dh'),_ma_noi_di: p.valForm('ma_noi_di'),_ds_cong: p.valForm('ds_cong'), _ten_noi_di: p.valForm('ten_noi_di'), _ma_noi_den: p.valForm('ma_noi_den'), _ten_noi_den: p.valForm('ten_noi_den'),_ma_hang: p.valForm('ma_hang'), _ten_hang: p.valForm('ten_hang')});
	 return false;
      break;
    default:
      break;
  }
  return true;
}
