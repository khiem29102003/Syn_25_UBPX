<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY CheckUpdatingDeleting "
	if exists(select 1 from dmdtcn where dien_thoai = @dien_thoai and status in (0,3)) begin
	select '$NotEditVoucherStatus' as message
		return
		end
  ">
]>

<dir id="dmdtcn" table="dmdtcn" fieldKey="ma_so_thue, dien_thoai" transaction="true" tryCatch="true" dirViewType="Dialog" voucherCode="TC1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục điện thoại cá nhân" e="List of personal phone"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120" >
		<fields>
			<field name="tt" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="[200]" field="0">
				<text v="Thông tin điện thoại cá nhân:" e="Personal phone information: "></text>
			</field>	
			<field name="ma_so_thue" nextRow="true" label="1" field="2" importable="5" allowBlank="true" disabled="false" fieldType="PK">
				<text v="Mã số thuế" e="Tax"></text>
			</field>
			<!-- <field name="ma_so_thue" viewType="Lookup" nextRow="true" label="1" field="2" importable="5" allowBlank="true" disabled="false"> -->
				<!-- <text v="CMND/CCCD" e="Citizen ID"></text> -->
				<!-- <viewInfo lookupType="One" lookupId="dmcccd" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_cccd" lookupInfo="dmcccd|ma_so_thue|ten_cccd" importCheck="@@DF and z.status=1"/> -->
			<!-- </field> -->
			<!-- <field name="ten_cccd" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as "> -->
				<!-- <text v="" e=""></text> -->
			<!-- </field> -->
			<field name="dien_thoai" nextRow="true" label="1" field="2" importable="10" disabled="false" align="left" fieldType="PK">
				<text v="Điện thoại" e="Phone Number"></text>
			</field>
			<field name="ghi_chu" nextRow="true" label="1" field="2" importable="20" disabled="false">
				<text v="Ghi chú 1" e="Note 1"></text>
			</field>
			<field name="ghi_chu2" nextRow="true" label="1" field="2" importable="30" disabled="false">
				<text v="Ghi chú 2" e="Note 2"></text>
			</field>
			<field name="status" viewType="Combobox" width ="150" valueDefault="1">
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 order by ma_tt">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
	
	<form tabPageIndex="1" gravity="MiddleLeft" height="300" columns="120,120,120,120,120,120,120,120,120,120" >
		<text v="Chi tiết" e="Information"></text>
		<fields>		
        <field name="ten_kh" allowBlank="false" label="1" field="2" fieldType="EX">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
        <field name="ten_kh2" label="1" field="2" fieldType="EX">
          <text v="Tên khác" e="Other Name"></text>
        </field>

        <field name="dia_chi" label="1" field="-" allowBlank="false" fieldType="EX">
          <text v="Địa chỉ" e="Address"></text>
        </field>
        <field name="nguoi_lh" label="1" field="1" nextRow="false" fieldType="EX">
          <text v="Người liên hệ" e="Contact"></text>
        </field>
        <field name="fax" label="1" field="1" nextRow="false" fieldType="EX">
          <text v="Fax" e="Fax"></text>
        </field>
		<field name="e_mail" label="1" field="2" fieldType="EX">
          <text v="Email" e="Email"></text>
        </field>
        <field name="nh_kh1" viewType="Lookup" label="1" field="1" fieldType="EX">
          <text v="Nhóm 1" e="Group 1"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH1' and status=1" lookupCheck="ma_loai_nh = 'KH1'" lookupRef="ten_nh_kh1" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'KH1' and z.status=1"/>
        </field>
        <field name="ten_nh_kh1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_kh2" viewType="Lookup" label="1" field="1" fieldType="EX">
          <text v="Nhóm 2" e="Group 2"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH2' and status=1" lookupCheck="ma_loai_nh = 'KH2'" lookupRef="ten_nh_kh2" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'KH2' and z.status=1"/>
        </field>
        <field name="ten_nh_kh2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="nh_kh3" viewType="Lookup" label="1" field="1" fieldType="EX">
          <text v="Nhóm 3" e="Group 3"></text>
          <viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'KH3' and status=1" lookupCheck="ma_loai_nh = 'KH3'" lookupRef="ten_nh_kh3" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'KH3' and z.status=1"/>
        </field>
        <field name="ten_nh_kh3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="so_tk" label="1" field="1" nextRow="false" allowBlank="true" fieldType="EX">
          <text v="Số tài khoản" e="Account Number"></text>
        </field>
		<field name="ma_nh" viewType="Lookup" label="1" field="1" fieldType="EX">
          <text v="Ngân hàng" e="Bank"></text>
          <viewInfo lookupType="One" lookupId="dmnganhang" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nh" lookupInfo="dmnganhang|ma_nh|ten_nh" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_nh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
      </fields>
	</form>
  </forms>

	<buttons>
		<button id="ok" default="true">
		<text v="$AcceptLabel" e="$AcceptLabel"></text>
		</button>
	</buttons>

  <js>
    <text>
      <![CDATA[
	function dir$dmdtcn(p){
	  this.constructor(p);
	}
	dir$dmdtcn.prototype = new DirEvent();
	dir$dmdtcn.prototype.afterInit = function(){
	  var p = this._dir;
	}
	dir$dmdtcn.prototype.afterInit = function(renderType){
	  var p = this._dir,g = p.grid();
	  
	  
	p.request('info_request', '', ['ma_so_thue']);

	dir$dmdtcnDisabledMasterField(p, g);
	
	//if(p.options.action == 'VIEW')	{
		//const buttonToHide = document.querySelector('button[btnid="deleteForm"]');
		//buttonToHide.style.display = 'none'; 
	//}

	}

	function dir$dmdtcnDisabledMasterField(p, g){
	  if(p.valForm('ma_so_thue').trim() != '')
	  {
		p.setDisabled('ma_so_thue', true);
	  }
	  else
	  {
		p.setDisabled('ma_so_thue', false);
	  }
	}
         ]]>
    </text>
  </js>
<css>
	<text>
		  <![CDATA[
		.modal-dialog-lg{min-width:720px!important;}
		.control-label.tt {color: #499b98; text-decoration: underline}
		.control-label.ma_so_thue, .control-label.dien_thoai {color: #499b98;}
		  ]]>
	</text>
</css>
  <script>
	<request code="info_request">
		<text>		
			<![CDATA[
			select distinct a.ten_kh as [!ten_kh], a.ten_kh2 as [!ten_kh2], a.dia_chi as [!dia_chi],
						 a.nguoi_lh as [!nguoi_lh], a.fax [!fax],
						 a.e_mail as [!e_mail], a.nh_kh1 as [!nh_kh1],
						 a.nh_kh2 as [!nh_kh2], a.nh_kh3 as [!nh_kh3], a.so_tk [!so_tk], a.ma_nh [!ma_nh]
						from dmkh0 a
				where a.ma_so_thue = @ma_so_thue
			]]>
		</text>
	</request>
  <inserting>
      <text>
        <![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit, @status = @@status, @xcase = @@xcase
]]>
      </text>
    </inserting>
	<importing>
      <text>
        <![CDATA[
@@insert
        ]]>
      </text>
    </importing>
    <declare>
      <text>
        <![CDATA[
			declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
			select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Số điện thoại đã tồn tại' else N'Phone number is exists' end
			select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Số điện thoại đã tồn tại' else N'Phone number is exists' end
         ]]>
      </text>
    </declare>
  </script>
  <messages>
    <message val="codeExistsNewMsg">
      <text v="Số điện thoại đã tồn tại" e="Phone number is exists"/>
    </message>
    <message val="taxtCodeExists">
      <text v="Số điện thoại đã tồn tại" e="Phone number is exists"/>
    </message>
  </messages>
</dir>
