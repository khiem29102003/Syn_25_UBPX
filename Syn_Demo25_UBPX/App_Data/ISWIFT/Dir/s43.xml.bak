}

function dir$s43DisabledMasterField(p, g){
  var dt = g.data, rows = dt.findRow("[ma_phi].trim() != ''"), dis = rows.length > 0;
  p.setDisabled('unit_id', dis);
  p.setInactive('unit_id', true);
	if(p.options.action !="NEW") p.setDisabled(['ngay_ct', 'ma_nt','ty_gia','ma_gd','ma_ngv','so_ct'], dis);
  
}
function dir$s43HiddenColumnByType(p){
  var v = p.valForm('ma_ngv'), nt = p.valForm('ma_nt'), bc = p.options.struct.baseCurrency;
  	if(v == 1) {
		//p.setDisabled([ 'ma_noi_di','ma_noi_den','ds_cong','cvc_yn','nk_yn','xk_yn','pp_yn'], false);
		p.valForm('id_yc', "" , true);
		p.valForm('id_tg', "" , true);
		p.setInvisible('tt', true);
	}
	else
	{
		//p.setDisabled([ 'ma_noi_di','ma_noi_den','ds_cong','cvc_yn','nk_yn','xk_yn','pp_yn'], true);
		p.setInvisible('tt', false);
	}
}
function dir$s43HiddenColumnByTran(p){
	var gd = p.valForm('ma_gd').trim();
}

function dir$s43HiddenColumnByDay(p){
	var v = p.valForm('ma_dk_ngay');
	if (v == 1) p.request('ma_dk_ngay', '', ['t2_yn','t3_yn','t4_yn','t5_yn','t6_yn','t7_yn','t8_yn']);
	p.setDisabled(['t2_yn','t3_yn','t4_yn','t5_yn','t6_yn','t7_yn','t8_yn'], v == 1);
	}

function dir$s43DisabledStatusByAction(p){
  var o = p.jObject('status');
  if (p.options.action != 'VIEW') o.find("[value=4],[value=6],[value=7],[value=9],[value=5],[value=0]").remove();
  if (p.options.action == 'VIEW') p.setTitle(p.jObject('ma_ngv').find('option:selected').text());
}



