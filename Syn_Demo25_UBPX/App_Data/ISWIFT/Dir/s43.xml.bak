  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$s43(p){
  this.constructor(p);
}
dir$s43.prototype = new DirEvent();
dir$s43.prototype.beforeInit = function(renderType){
  this._dir.options._files = null;
  document._dir = this._dir;
}
dir$s43.prototype.afterInit = function(renderType){
  var p = this._dir, g = p.grid(0),g2 = p.grid(1);
  var exp = {
    gia1: ['*gia1', '[gia_nt1]*[ty_gia]'],
    gia_ban: ['*gia_ban', '[gia_ban_nt]*[ty_gia]'],
    gia2: ['*gia2', '[gia_nt2]*[ty_gia]'],
    tien_nt1: ['*tien_nt1', '[so_luong]*[gia_nt1]'],
	tien_nt2: ['*tien_nt2', '[so_luong]*[gia_nt2]'],
    tien2_tg: ['*tien2', '[tien_nt2]*[ty_gia]'],
    tien1: ['*tien1', '[so_luong]*[gia1]'],
	tien2: ['*tien2', '[so_luong]*[gia2]'],
	
    thue_nt: ['*thue_nt', '[thue_suat]*([tien_nt2] - [ck_nt])/100'],
    thue: ['*thue', '[thue_suat]*([tien2] - [ck])/100'],
    thue_tg: ['*thue', '[ty_gia]*[thue_nt]'],
    ck_nt: ['*ck_nt', '[tien_nt2]*[tl_ck]/100'],
    ck_tg: ['*ck', '[ck_nt]*[ty_gia]'],
    ck: ['*ck', '[tien2]*[tl_ck]/100'],
	
	//tc_tien_nt2: ['@t_tc_tien_nt2', '[tien_nt2] - [ck_nt]', '[ct_km] == 0'],
    //tc_tien2: ['@t_tc_tien2','[tien2] - [ck]', '[ct_km] == 0'],
	
	tc_tien2: ['*tc_tien2','[tien2] - [ck]', '[ct_km] == 0'],
	tc_tien_nt2: ['*tc_tien_nt2', '[tien_nt2] - [ck_nt]', '[ct_km] == 0'],
	tt_nt: ['*tt_nt', '[tien_nt2] + [thue_nt]'],
    tt: ['*tt', '[tien2] + [thue]'],
	tien_ln: ['*tien_ln', '[tt]-[tien1]'],
	// ap dung cong thuc dung - trong thay doi
	t_tien_nt2: ['@t_tien_nt2', '[tien_nt2]'],
	t_tien2: ['@t_tien2',  '[tien2]'],
	t_tc_tien_nt2: ['@t_tc_tien_nt2', '[tc_tien_nt2]'],
	t_tc_tien2: ['@t_tc_tien2',  '[tc_tien2]'],
	t_tt_nt: ['@t_tt_nt',  '[tt_nt]'],
	t_tt: ['@t_tt',  '[tt]'],
	
	//
		
    t_so_luong: ['@t_so_luong', '[so_luong]'],
   // t_tien_nt2: ['@t_tien_nt2', '[tien_nt2] - [ck_nt]', '[ct_km] == 0'],
   // t_tien2: ['@t_tien2', '[tien2] - [ck]', '[ct_km] == 0'],
	t_tien_nt1: ['@t_tien_nt1', '[tien_nt1]'],
    t_tien1: ['@t_tien1', '[tien1]'],
    t_ck_nt: ['@t_ck_nt', '[ck_nt]', '[ct_km] == 0'],
    t_ck: ['@t_ck', '[ck]', '[ct_km] == 0'],
    t_thue_nt: ['@t_thue_nt', '[thue_nt]', '[ct_km] == 0'],
    t_thue: ['@t_thue', '[thue]', '[ct_km] == 0'],
   // t_tc_tien_nt2: ['@t_tc_tien_nt2', '[tien_nt2]'],
   // t_tc_tien2: ['@t_tc_tien2', '[tien2]'],
    t_km_nt: ['@t_km_nt', '[tien_nt2]', '[ct_km] == 1'],
    t_km: ['@t_km', '[tien2]', '[ct_km] == 1'],
   // t_tt_nt: ['#t_tt_nt', '[t_tien_nt2] + [t_thue_nt]'],
   // t_tt: ['#t_tt', '[t_tien2] + [t_thue]'],
	t_tl_ln:['#t_tl_ln', '([t_tt] - [t_tien1])/[t_tt]*100','[t_tt]==0']
  }
  p.applyExpression(exp, g, false);
  
  
  
  <!-- var expForm = { -->
    <!-- t_tt_nt: ['#t_tt_nt', '[t_tien_nt2] + [t_thue_nt]'], -->
    <!-- t_tt: ['#t_tt', '[t_tien2] + [t_thue] + [t_phi]'] -->
  <!-- } -->
  <!-- p.applyExpressionForm(expForm, true); -->
  
  g.FomulaApplied = {
    "so_luong":["t_so_luong","tien_nt1","tien1","tien_nt2", "tien2","ck_nt","ck_tg", "thue_nt", "thue_tg","tien2_tg","t_tien_nt2","tc_tien2","t_tien_nt1", "t_km_nt", "t_tc_tien_nt2", "t_tien2","t_tien1", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck","t_tc_tien2","tc_tien_nt2", "t_tt_nt", "t_tt","t_tc_tien_nt2","t_tt_nt","t_tt","tien_ln","t_tl_ln"],
    "he_so":["tien_nt1","tien1","tien_nt2", "tien2","ck_nt","ck_tg", "thue_nt", "thue_tg","tien2_tg","t_tien_nt2","tc_tien2","t_tien_nt1", "t_km_nt", "t_tc_tien_nt2", "t_tien2","t_tien1", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck","t_tc_tien2","tc_tien_nt2", "t_tt_nt", "t_tt","t_tc_tien_nt2","t_tt_nt","t_tt","tien_ln","t_tl_ln"],
    "gia_nt1":["tien_nt1",  "gia1", "tien1", "t_tien_nt1", "t_tien1", "tt_nt","tt","t_tt","tien_ln","t_tt_nt","t_tl_ln"],
   "gia_nt2":["tien_nt2", "gia2", "ck_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck","tc_tien2","tc_tien_nt2","tt_nt","tt","tien_ln","t_tc_tien2","t_tc_tien_nt2","t_tt_nt","t_tt","t_tl_ln"],
	
"!ty_gia":["gia2", "tien2_tg", "ck_tg", "thue_tg", "t_tien2", "t_km", "t_tc_tien2", "t_ck", "t_thue","tc_tien2","tc_tien_nt2","tt_nt","tt","tien_ln","t_tc_tien2","t_tc_tien_nt2","t_tt_nt","t_tt","t_tl_ln"],
