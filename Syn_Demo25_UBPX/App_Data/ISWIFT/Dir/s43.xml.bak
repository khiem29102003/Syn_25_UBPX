dir$s43.prototype.beforeButtonDialogClick = function (id) {
  var p = this._dir, g = p.grid(0), dt = g.data;
  switch (id) {
    case 'ok':
		var d = p.valForm('ngay_hl'),d2 = p.valForm('ngay_hld');
		var k = $.date(d,"dd/mm/yy"),k2 = $.date(d2,"dd/mm/yy");
		if (p.valForm('ngay_hld') <= p.valForm('ngay_hl')) { 
			<!-- $.question('jkhj '+'Nhap sai ngay ??' ); -->
			<!-- $.showToast(p.msg('noDate')); -->
			
			$.alert(p.msg('noDate')+' ' + k + ' < ' + k2);			
			return false;
			Break;
			}	  		  
    default:
      break;
  }
  return true;
}
