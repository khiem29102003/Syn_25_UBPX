    <text>
      <![CDATA[<enc></enc>]]><![CDATA[<enc>CmtxZ64bWSAHb6iprcHZwt8nZnT7hCzPnrT/0NbI8L/uDVHVlGjNfiYBdML6ILwYS6roNrsoqT6fpzoIPOK0ZHH0lmG+V9XS2j9sTdOSL1unDQEel7bPUOTljQ096IC8AZ2zx8E8jjmcQw+XNS6P8xQdEJUnZn76Pp7PHLU7IHAkjd6hfBXryGglUTe7IURf</enc>]]>&VoucherExRateValid01;<![CDATA[<enc>0/nnS4SIpHnhTWOnks9p3xAXPC+NCR5gdkAnuBGPLLrc5FUl8OnsIN8lWQtb8Dn1B0Abb57ASGY/c5EY3LGh+USxxFyJOXrdWI0sbeebGXFG2rO7pOzNG9KUTcbtUlTxDa+U7YRH7Wg/9jbfbvEW7N8ugpOYshmifOKJ3woX3B3tRGX3S1YH3VElVky24+Z06lD/E/rvJ5Z2QCeg7HKMMnZDBRPITJz/79dBKq6uJxkEvdo226gGhG2vjvaY608O</enc>]]><![CDATA[<enc></enc>]]>
