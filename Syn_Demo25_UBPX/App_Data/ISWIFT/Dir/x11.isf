  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from x11 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="x11" table="x11" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="VL1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Tạo đơn hàng tổng" e="Create a total order"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
	  <field name="ma_gd" viewType="Combobox" valueDefault="" label="1" field="1" >
          <text v="Loại hàng" e="Type Code"></text>
          <viewInfo>
            <options query="select ma_gd, ten_gd%l from dmgd where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="ma_kh" allowBlank="false" viewType="Lookup" label="1" field="1">
          <text v="Mã khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_nvbh" clientDefault="true" nextRow="false" viewType="Lookup" label="1" field="1">
          <text v="Mã nhân viên" e="Sale"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1" lookupCheck="1=1" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" />
        </field>		
        <field name="ten_nvbh" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ong_ba" label="1"  rows="1" field="1">
          <text v="Người liên hệ" e="Contact"></text>
        </field>
        
        <field name="ma_tt" viewType="Lookup" label="1" field="1" nextRow="true" >
          <text v="Mã thanh toán" e="Credit Term"></text>
          <viewInfo lookupType="One" lookupId="dmtt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_tt" lookupInfo="dmtt|ma_tt|ten_tt" />
        </field>
		<field name="ten_tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_hang" viewType="Lookup" label="1" field="1">
          <text v="Hãng Tàu" e="Carrier code"></text>
          <viewInfo lookupType="One" lookupId="dmhangtau" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_hang" lookupInfo="dmhangtau|ma_hang|ten_hang" />
        </field>
		<field name="ten_hang" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
	
		
		
		<field name="ngay_dk" dataType="D" label="1" rows="1" field="1" >
          <text v="Dự kiến VC" e="Estimated shipping"></text>
        </field>		
        <field name="gio_dk" label="[80]" field="[120]"  nextRow="false" rows="1" >
          <text v="Thời gian" e="Time"></text>
        </field>
		
		<field name="ngay_hh" dataType="D" label="1" rows="1" field="1" nextrow="false" >
          <text v="Hết hạn/ Cut off" e="Expiration date"></text>
        </field>		
        <field name="gio_hh" inactivate="true" label="[80]" field="[120]" clientDefault="true" nextRow="false">
          <text v="Thời gian" e="Time"></text>
        </field>
        
        <field name="dien_giai" label="1" rows="1" field="-">
          <text v="Diễn giải" e="Explain"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
		<field name="ngay_hl" dataType="D" label="1" rows="1" field="1">
          <text v="Ngày hiệu lực" e="Effective to"></text>
        </field>
		<field name="book_no" label="1" rows="1" field="1">
          <text v="Số booking" e="Booking number"></text>
        </field>
		<field name="so_tk" label="1" rows="1" field="1">
          <text v="Số tờ khai" e="Some declarations"></text>
        </field>
	
        &VoucherRequiredFields02;
		
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="y11" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="2" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi phí" e="Fee"></text>
      <fields>
        <field name="y113" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi phí" e="Fee"></text>
        </field>
      </fields>
    </form>
	
	<form tabPageIndex="3" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Giá bán ( tổng )" e="Selling price (total)"></text>
      <fields>
        <field name="y114" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Giá bán ( tổng )" e="Selling price (total)"></text>
        </field>
      </fields>
    </form>
    
    <form tabPageIndex="4" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Thông tin khách hàng" e="Customer Info"></text>
      <fields>
        <field name="ma_dc" viewType="Lookup" label="1" field="1">
          <text v="Địa chỉ" e="Địa chỉ"></text>
          <viewInfo lookupType="One" lookupId="dmdc" lookupKey="ma_kh in (![ma_kh]!, '') and status = 1" lookupCheck="ma_kh in (![ma_kh]!, '')" lookupRef="ten_dc" lookupInfo="dmdc|ma_dc|ten_dc"/>
        </field>
        <field name="ten_dc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="dia_chi" label="1" field="-">
          <text v="Địa chỉ" e="Address"></text>
        </field>
        
      </fields>
    </form>
	
	<form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Thông tin giao nhận" e="Delivery information"></text>
      <fields>
		<field name="ma_noi_di" viewType="Lookup" label="1" field="1">
          <text v="Mã nơi đi" e="Where to go code"></text>
		   <viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kho" />
        </field>
		<field name="ma_noi_dr" viewType="Lookup" label="1" field="1">
          <text v="Mã nơi đóng/rút" e="Code where to close/withdraw"></text>
		  <viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kho" />
        </field>
		<field name="ma_noi_ha" viewType="Lookup" label="1" field="1">
          <text v="Mã nơi hạ" e="Landing code"></text>
		  <viewInfo lookupType="One" lookupId="dmkho" lookupKey="status = 1" lookupCheck="1 = 1" lookupRef="ten_kho" />
        </field>
      </fields>
    </form>
    <form tabPageIndex="6" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Khác" e="Other"></text>
      <fields>
		<field name="ma_ptvc" viewType="Lookup" label="1" field="1">
          <text v="Phương tiện v/c" e="Transportation"></text>
          <viewInfo lookupType="One" lookupId="dmptvc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptvc" lookupInfo="dmptvc|ma_ptvc|ten_ptvc" />
        </field>
        <field name="ten_ptvc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_pttt" viewType="Lookup" label="1" field="1">
          <text v="Ph/th thanh toán" e="Payment Methods"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptgh" viewType="Lookup" label="1" field="1">
          <text v="Ph/th giao hàng" e="Delivery Methods"></text>
          <viewInfo lookupType="One" lookupId="dmptgh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptgh" lookupInfo="dmptgh|ma_ptgh|ten_ptgh" />
        </field>
        <field name="ten_ptgh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        
      </fields>
    </form>

    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="VL1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="150,120,120,120,120" >
      <fields>
         <field name="t_sl_n" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng số container" e="Total Container"></text>
        </field>
        <field name="t_sl_x" label="" field="1" nextRow="false" disabled="false" dataType="N" format="Amount" >
          <text v="Tổng container đã phân bổ" e="Total containers allocated"></text>
        </field>
        <field name="t_sl_t" label="1" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng container chưa phân bổ" e="Total unallocated containers"></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="y11" table="y11" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_cong" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã container" e="Container Code"></text>
          <viewInfo lookupType="One" lookupId="dmcong" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_cong" lookupInfo="dmcong|ma_cong|ten_cong" />
        </field>
        <field name="ten_cong" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmcong b on a.ma_cong = b.ma_cong ">
          <text v="Tên container" e="Container Name"></text>
        </field>
      
        <field name="sl_n" dataType="N" format="Qty" allowBlank="false" width="100" readOnly="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
         <field name="sl_x" dataType="N" format="Qty" allowBlank="false" width="100" readOnly="false" >
          <text v="Số đã phân bổ" e="Allotted number"></text>
        </field>
		<field name="sl_t" dataType="N" format="Qty" allowBlank="false" width="100" readOnly="false" >
          <text v="Số lượng tồn" e="Quantity in stock"></text>
        </field>
		
        &VoucherExtendFields;
       
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>
    <grid id="y113" table="y113" fieldKey="id, line" order="line" readOnly="false">
      <fields>
