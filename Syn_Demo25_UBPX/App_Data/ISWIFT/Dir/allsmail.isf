<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields09.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from allsmail where id = @id and status in (5,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="allsmail" table="allsmail" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="SM2" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Mail vãng lai" e="Mail"></title>
  <title0 v="Mới - Mail" e="New - Mail"></title0>
  <title1 v="Sửa - Mail" e="Edit - Mail"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>

        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true" importable = "-1">
          <text v="" e=""></text>
        </field>
		<field name="s_mail" allowBlank="false" format="L" viewType="Lookup" label="1" field="2" importable ="10">
			<text v="Email gửi" e="Email Sent"></text>
			<viewInfo lookupType="One" lookupId="dmsmail" lookupKey=" status = 1" lookupCheck="1=1" lookupRef="ten_mail" lookupInfo="dmsmail|s_mail|ten_mail" />
		</field>
		<field name="ten_mail" allowBlank="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="[150]"  aliasName="cast('' as nvarchar(4000)) as ">
			<text v="" e=""></text>
		</field> 
		<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" importable ="15">
			<text v="Ngày hiệu lực " e="Effective date"></text>
		</field>
		<field name="di_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
			<text v="" e=""></text>
		</field>
		<field name="ngay_hld" label="[100]" field="[120]" dataType="D" allowBlank="false" nextRow="false" importable ="20">
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>
		<field name="title" label="1" rows="1" field="-" allowBlank="false" importWidth="300" importable ="25">
          <text v="Tiêu đề" e="Subject"></text>
        </field>
		<field name="ds_mail" label="1" rows="1" field="-" allowBlank="false" importWidth="300" importable ="25">
          <text v="Danh sách mail (,)" e="Subject"></text>
        </field>
		<!-- <field name="link" label="1" rows="1" field="-" allowBlank="true" importable ="-1"> -->
          <!-- <text v="Đường dẫn" e="link"></text> -->
        <!-- </field> -->
		<field name="email_body" rows="10" label="1" allowBlank="false" field="-" importWidth="500" importable = "30">
          <text v="Nội dung" e="Body"></text>
        </field>	
      </fields>
    </form>
	
    <form gravity="TopRight" columns="120,120" >
      <fields>
			&VoucherRequiredFields01;
      </fields>
    </form>

	<form tabPageIndex="1" gravity="MiddleLeft" height="200" columns="120,120" >
	  <text v="Đính kèm" e="Attach Files"></text>
	  <fields>
		<field name="xfile" label="1" field="-" viewType="File" fieldType="EXParam">
		  <text v="Chọn files" e="Attach Files"></text>
		  <viewInfo fileFieldId0="id" fileGroup="SM2" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
		</field>
	  </fields>
	</form>

  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
