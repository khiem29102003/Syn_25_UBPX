    <deleting>
      <text>
        &CheckUpdatingDeleting;
        <![CDATA[
select @dOldVoucherDate = ngay_ct, @dVoucherDate = ngay_ct, @nVoucherType = ma_ngv from m73 where id = @id
        ]]>
      </text>
    </deleting>

    <deleted>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
insert into #idupdatestatus select id_px from d73 where id = @id 
insert into #idupdatestatusYC1 select id_yc from d73 where id = @id and id_yc <> 0

]]>&VoucherCurrStockCreateTempTable;<![CDATA[
exec ISWIFTStoredDeleteDataWithKey 'd73,r70$%Partition,r90$%Partition', @strIds, '', @dVoucherDate
]]>&VoucherCurrStockCalc;<![CDATA[

exec ISWIFTStoredUpdateRetrieveStatus 'm73', 'd73', 'm73', 'd73', 'id_px', 'line_px', '#idupdatestatus', 5, 6, 7
drop table #idupdatestatus

exec ISWIFTStoredUpdateRetrieveStatus 'm71', 'd71', 'm73', 'd73', 'id_yc', 'line_yc', '#idupdatestatusYC1', 5, 6, 7
drop table #idupdatestatusYC1
        ]]>
      </text>
    </deleted>

    <updating>
      <text>
        <![CDATA[
insert into #idupdatestatus select id_px from d73 where id = @id
insert into #idupdatestatusYC1 select id_yc from d73 where id = @id and id_yc <> 0
select @dOldVoucherDate = ngay_ct from m73 where id = @id
        ]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId, i_so_ct = @i_so_ct, so_ct = @so_ct where [%whereFieldKey]
         ]]>
