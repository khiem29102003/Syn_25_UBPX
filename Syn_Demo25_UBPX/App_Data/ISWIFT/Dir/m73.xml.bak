    <aftersave>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
if @action = 'NEW' set @dOldVoucherDate = @ngay_ct
update @d73 set id = @id, ma_kh = @ma_kh, ngay_ct = @ngay_ct, so_ct = @so_ct, status = @status
delete d73 where id = @id
insert d73 select * from @d73

]]>&VoucherCurrStockCreateTempTable;<![CDATA[

exec ISWIFTStoredDeleteDataWithKey 'r70$%Partition,r90$%Partition', @strIds, '', @dOldVoucherDate

exec ISWIFTStoredPostingVoucher 'm73', 'd73', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''

exec ISWIFTStoredPostingInventory @ma_ngv, 'm73', 'd73', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''

]]>&VoucherCurrStockInsertNewTempTable;&VoucherCurrStockCalc;<![CDATA[

insert into #idupdatestatus select id_px from @d73 where id = @id and id_px not in (select id from #idupdatestatus)
exec ISWIFTStoredUpdateRetrieveStatus 'm73', 'd73', 'm73', 'd73', 'id_px', 'line_px', '#idupdatestatus', 5, 6, 7
drop table #idupdatestatus

insert into #idupdatestatusYC1 select id_yc from @d73 where id = @id and id_yc <> 0 and id_yc not in (select id from #idupdatestatusYC1)
exec ISWIFTStoredUpdateRetrieveStatus 'm71', 'd71', 'm73', 'd73', 'id_yc', 'line_yc', '#idupdatestatusYC1', 5, 6, 7
drop table #idupdatestatusYC1

exec ISWIFTStoredIncreaseVoucherNo @ma_nk, @ngay_ct, '@@voucherCode', @i_so_ct, @so_ct, '@@table'
select '' as message, @warning as warning, @id as [#id], @so_ct as [#so_ct], @ma_unit as [#ma_unit]
]]>
