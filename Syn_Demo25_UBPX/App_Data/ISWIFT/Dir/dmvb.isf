<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmvb" table="dmvb" fieldKey="ma_vb" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục mẫu văn bản" e="Document Template Catalog"></title>
  <title0 v="Mới - văn bản" e="New - document"></title0>
  <title1 v="Sửa - văn bản" e="Edit - document"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120,120">
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ngay_ct" nextRow="true" dataType="D" valueDefault="new Date()" label="1" field="1" importable="5" >
				<text v="Ngày phát hành" e="Issue Date"></text>
			</field>
			<field name="tu_so" label="1" field="1" fieldType="EX" allowBlank="true" disabled="true" nextRow="false">
			  <text v="Trong khoảng từ:" e="In the range from"></text>
			</field>
			<field name="den_so" label="1" field="1" fieldType="EX" allowBlank="true" disabled="true" nextRow="false">
			  <text v="Đến:" e="In the range to"></text>
			</field>
			<field name="ma_vb" label="1" field="-" allowBlank="false" fieldType="PK" disabled="true" importable="-1">
				<text v="Mã văn bản" e="Group code"></text>
			</field>
			<field name="ten_vb" label="1" field="-" allowBlank="true" disabled="false" importable="10">
			  <text v="Tên văn bản" e="Name"></text>
			</field>
			<field name="ten_vb2" label="1" field="-" allowBlank="true" disabled="false"  importable="15">
			  <text v="Tên tiếng anh" e="Name English"></text>
			</field>
			<field name="ky_hieu" label="1" field="1" allowBlank="true" disabled="false" nextRow="true" importable="20" >
			  <text v="Ký hiệu" e="Symbol"></text>
			</field>
			
			<field name="ma_pl" label="1" field="1" viewType="Lookup" allowBlank="false" importable="25">
			  <text v="Văn bản lưu hành" e="Circulation Document"></text>
			  <viewInfo lookupType="One" lookupId="dmplvb" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_pl" lookupInfo="dmplvb|ma_pl|ten_pl" />
			</field>
			<field name="ten_pl" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="false" label="" field="[240]" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>

			<field name="ma_nvb" label="1" field="1" viewType="Lookup" allowBlank="false" importable="30"> 
			  <text v="Nhóm văn bản" e="Group Document"></text>
			  <viewInfo lookupType="One" lookupId="dmnhomvb" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_nvb" lookupInfo="dmnhomvb|ma_nvb|ten_nvb" />
			</field>
			<field name="ten_nvb" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="false" label="" field="[360]" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
	<form tabPageIndex="1" gravity="MiddleLeft" height="300" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="ma_vb" fileGroup="dmvb" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
</forms>

&DefaultButton;

<js>
