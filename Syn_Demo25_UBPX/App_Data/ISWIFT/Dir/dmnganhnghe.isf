<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmnganhnghe" table="dmnganhnghe" fieldKey="ma_nganhnghe" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục ngành nghề" e="Occupation List"></title>
  <title0 v="Thêm mới - ngành nghề" e="New - Occupation"></title0>
  <title1 v="Sửa - ngành nghề" e="Edit - Occupation"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
		<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
		  <text v="" e=""></text>
		</field>
        <field name="ma_nganhnghe" format="U" label="1" field="1" allowBlank="false" fieldType="PK" importable="5">
          <text v="Mã ngành nghề" e="Occupation Code"></text>
        </field>
        <field name="ten_nganhnghe" label="1" field="-" allowBlank="false" importable="10">
          <text v="Tên ngành nghề" e="Occupation Name"></text>
        </field>
		<field name="ten_nganhnghe2" label="1" field="-" allowBlank="true" importable="15">
          <text v="Tên tiếng anh" e="English Name "></text>
        </field>
		<field name="ma_loai" viewType="Combobox" inactivate="false" label="1" field="1" nextRow="true" importable="20" >
		  <text v="Mã loại" e="Type Code"></text>
		  <viewInfo>
			<options query="select ma_loai, ten_loai%l from dmloainganhnghe where status = 1 ">
			</options>
		  </viewInfo>
		</field>
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
		  <text v="Trạng thái" e="Status"></text>
		  <viewInfo>
			<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
			</options>
		  </viewInfo>
		</field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
