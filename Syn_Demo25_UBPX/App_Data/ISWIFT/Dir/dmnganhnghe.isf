  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã ngành nghề đã tổn tại." e="Occupation code already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã ngành nghề đã tổn tại." e="Occupation code already exists."/>
