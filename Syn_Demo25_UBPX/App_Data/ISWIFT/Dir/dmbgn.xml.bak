<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmhangtau" table="dmhangtau" fieldKey="ma_hang" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hãng tàu" e="List Of Shipping Lines"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_hang" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã hãng" e="Brand Code"></text>
        </field>
        <field name="ten_hang" format="U" label="1" field="[200]" viewType="AutoIncrease" allowBlank="false" fieldType="PK" importable="5">
          <text v="Tên hãng" e="Brand Name"></text>
        </field>
		<field name="ten_hang2" format="U" label="1" field="[200]" viewType="AutoIncrease" allowBlank="false" fieldType="PK" importable="5">
          <text v="Tên khác" e="Another Name"></text>
        </field>
		
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmhangtau(p){
  this.constructor(p);
}
dir$dmhangtau.prototype = new DirEvent();
dir$dmhangtau.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmhangtau.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

  dir$dmhangtauDisabledMasterField(p, g);

}

function dir$dmhangtauDisabledMasterField(p, g){
  
  if(p.valForm('ma_hang').trim() != '')
  {
    p.setDisabled('ma_hang', true);
  }
  else
  {
    p.setDisabled('ma_hang', false);
  }
}
         ]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã hãng tàu đã tồn tại' else N'List Of Shipping Lines is exists' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã hãng tàu đã tồn tại' else N'List Of Shipping Lines is exists' end
         ]]>
      </text>
    </declare>
  </script>

</dir>