  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from s341 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="s341" table="s341" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="PC1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phụ phí hàng biển FCL" e="FCL Surcharge"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
	  	<field name="ma_kh"  viewType="Lookup" label="1" field="1" allowBlank="false">
          <text v="Hãng tàu/ Đại lý" e="Carrier/ Agent Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="(ncc_yn = 1 or dl_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>		

		<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" >
			<text v="Ngày hiệu lực" e="Effective date"></text>
		</field>
		<field name="di_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
			<text v="" e=""></text>
		</field>
				
		<field name="ngay_hld" label="[100]" field="[120]" dataType="D" allowBlank="false" nextRow="false" >
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>
		<field name="ds_cong" allowBlank="true" viewType="Lookup" label="1" field="-"  hidden="false">
			<text v="Container" e="Container List"></text>
			<viewInfo lookupType="Multi" lookupId="dmcong2" lookupKey="status=1" lookupCheck="status=1" lookupRef="" lookupInfo="dmcong|ma_cong|ten_cong" />
		</field>
		<field name="dien_giai" label="1" rows="1" field="-">
		  <text v="Diễn giải" e="Explain"></text>
		</field>
		<field name="den_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
			<text v="" e=""></text>
		</field>
				
				
			
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields341;
        &VoucherRequiredFields02;
      </fields>
    </form>

   
    <form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="v341" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>
	
	<form tabPageIndex="2" gravity="MiddleLeft" height="320" columns="120,120,240" >
