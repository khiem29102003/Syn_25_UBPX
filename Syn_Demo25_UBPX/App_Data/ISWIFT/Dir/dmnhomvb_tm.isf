<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmnhomvb" table="dmnhomvb" fieldKey="ma_nvb, ma_loai" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhóm tài liệu mẫu" e="Template Document Group Catalog"></title>
  <title0 v="Thêm mới - nhóm tài liệu mẫu" e="New - template document group"></title0>
  <title1 v="Sửa - nhóm tài liệu mẫu" e="Edit - template document group"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120" >
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_nvb" label="1" field="[120]" importable="5" allowBlank="false" fieldType="PK">
				<text v="Mã nhóm tài liệu" e="Template Group Code"></text>
			</field>
			<field name="ten_nvb" label="[120]" field="-" importable="10" allowBlank="true">
			  <text v="Tên nhóm tài liệu" e="Template Group Name"></text>
			</field>
			<field name="ten_nvb2" label="[120]" field="-" importable="15" allowBlank="true">
			  <text v="Tên tiếng anh" e="English Name"></text>
			</field>
			<field name="ma_loai" label="" field="" importable="-1" allowBlank="true" hidden="true" fieldType="PK">
			  <text v="Mã loại" e="Type Code"></text>
			</field>
			<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
</forms>

&DefaultButton;

