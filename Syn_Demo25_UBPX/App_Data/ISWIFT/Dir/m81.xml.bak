  <script>


  

    <query>
      <text>
        <![CDATA[

select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @script is null set @script = ''

if @action = 'NEW' begin
  declare  @ngay_hl date,  @unit_id int
  select @ngay_hl = getdate(), @unit_id = @@unit
 end
]]>
      </text>
    </query>

    <declare>
      <text>
        <![CDATA[
declare @warning nvarchar(256), @dOldVoucherDate date, @dVoucherDate date, @nVoucherType tinyint, @strIds varchar(256), @q nvarchar(4000)
set @warning = ''

         ]]>
      </text>
    </declare>

    &VoucherJSLoading;

    <beforesave>
      <text>
        <![CDATA[
declare  @ma_unit nvarchar(256)

select @ma_unit = ma_unit from sysunit where unit_id = @unit_id
]]>
      </text>
    </beforesave>

    <deleting>
      <text>
        
        <![CDATA[
select @dOldVoucherDate = ngay_hl, @dVoucherDate = ngay_hl from m81 where id = @id
        ]]>
      </text>
    </deleting>

    <deleted>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)

]]>
<![CDATA[


        ]]>
      </text>
    </deleted>

    <updating>
      <text>
        <![CDATA[
select @dOldVoucherDate = ngay_hl from m81 where id = @id
        ]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]

         ]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[
select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId
exec ISWIFTStoredGetIdentityNumber '', '@@table', @id output,'gcvt'
         ]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[
]]>
      </text>
    </inserted>

    <aftersave>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
if @action = 'NEW' set @dOldVoucherDate = @ngay_hl
update @d81 set id = @id, ma_kh = @ma_kh, ngay_hl = @ngay_hl, unit_id=@unit_id

delete d81 where id = @id

insert d81 select * from @d81

]]><![CDATA[
select '' as message, @warning as warning, @id as [#id], @ma_unit as [#ma_unit]

]]>
      </text>
    </aftersave>

  </script>

  <messages>
    <message val="invoiceRetrieve">
      <text v="Chỉ xử lý nghiệp vụ lấy số liệu cho hóa đơn" e="" />
    </message>
    <message val="DaThanhToan">
      <text v="Đã có chứng từ thanh toán cho hóa đơn này, không được sửa/xóa." e=""/>
    </message>
    <message val="DaTraLai">
      <text v="Đã có chứng từ trả lại cho hóa đơn này, không được sửa/xóa." e=""/>
    </message>
  </messages>
</dir>