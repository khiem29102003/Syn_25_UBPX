]]><![CDATA[
dir$m81.prototype.gridDetailActionChange = function(gindex, action, r){
  if(gindex > 0) return true;
  
  var p = this._dir;
  if (action == 'AfterDeleteRow' || action == 'AfterAppendGrid') dir$m81DisabledMasterField(p, p.grid(gindex));
  return true;
}
function dir$m81DisabledMasterField(p, g){
  var dt = g.data, rows = dt.findRow("[ma_dvvt].trim() != ''"), dis = rows.length > 0;
  p.setDisabled('unit_id', dis);
  p.setInactive('unit_id', true);
  
 
}
function dir$m81HiddenColumnByTran(p){
  
