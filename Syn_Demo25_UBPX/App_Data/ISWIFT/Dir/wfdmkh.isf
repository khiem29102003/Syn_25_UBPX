<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields09.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from wfdmkh where id = @id and status in (5,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="wfdmkh" table="wfdmkh" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="WF1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Cấu hình Workflow" e="Customer-Specific Workflow Configuration"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
		<field name="ma_wf" format="U" label="1" field="1" viewType="AutoIncrease" allowBlank="false">
          <text v="Mã workflow" e="Workflow Code"></text>
        </field>
        <field name="dien_giai" label="1" rows="1" field="-">
          <text v="Diễn giải" e="Explain"></text>
        </field>
      </fields>
    </form>
	
    <form gravity="TopRight" columns="120,120" >
      <fields>
			&VoucherRequiredFields01;
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="400" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="wfdmkhct" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="WF1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="wfdmkhct" table="wfdmkhct" fieldKey="id, line" order="line" allowFilter="true" readOnly="false" allowOrder="true">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ma_ntask" width="120" allowBlank="false" viewType="Lookup" readOnly="false" inactivate="false" >
          <text v="Mã nhóm c/việc" e="Task Group Code"></text>
          <viewInfo lookupType="One" lookupId="dmntask" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ntask" lookupInfo="dmntask|ma_ntask|ten_ntask" />
        </field>
        <field name="ten_ntask" width="200" fieldType="EX" inactivate="true" readOnly="false" disabled="true" aliasName="b" join = 'left join dmntask b on a.ma_ntask = b.ma_ntask'>
          <text v="Tên nhóm công việc" e="Task Group Name"></text>
        </field>
        <field name="ma_nv" width="120" allowBlank="true" viewType="Lookup" readOnly="false" inactivate="false">
          <text v="Gán nhân viên" e="Assign Employee"></text>
          <viewInfo lookupType="One" lookupId="dmnv" lookupKey="EXISTS (SELECT 1 FROM dmntask WHERE ma_ntask = #[ma_ntask]# AND ',' + ds_nv + ',' LIKE '%,' + ma_nv + ',%') " lookupCheck="1=1" lookupRef="ten_nv" lookupInfo="dmnv|ma_nv|ten_nv" />
        </field>
        <field name="ten_nv" width="200" fieldType="EX" inactivate="true" readOnly="false" disabled="true" aliasName="c" join = 'left join dmnv c on a.ma_nv = c.ma_nv'>
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
		<field name="dien_giai" width="250" inactivate="false" readOnly="false">
          <text v="Diễn giải" e="Explain"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>

      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc>LiypPclQn3GzgBvXQZUhok4BgtjU/ZTEusHE/e/d2lrWDwpOKX7nY1ST2EiSr5kyYIXCxd1dBZdyIvfDe8RkGcxVVi4T1CiRl8diPWRgM9pcDhgmGVMfVzNRsxdhAtSrBvKGWW8e997TfwdfFHsVuW5gsetbBtKS14vV9M8EveC6rERtKeypzPCX/O8GESFp</enc>]]>
          </text>
        </query>
      </script>

    </grid>

  </grids>

