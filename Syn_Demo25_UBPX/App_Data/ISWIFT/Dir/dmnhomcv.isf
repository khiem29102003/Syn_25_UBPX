<dir id="dmnhomcv" table="dmnhomcv" fieldKey="ma_nhom" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhóm chức vụ" e="List of position groups"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_nhom" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã nhóm" e="Group code"></text>
        </field>
        <field name="ten_nhom" label="1" field="-" allowBlank="false" fieldType="PK" >
          <text v="Tên nhóm" e="Group name"></text>
        </field>
		<field name="ten_nhom2" label="1" field="-" >
          <text v="Tên khác" e="Other name"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
