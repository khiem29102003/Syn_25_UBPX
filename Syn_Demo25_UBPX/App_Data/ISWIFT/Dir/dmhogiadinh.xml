<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmhogiadinh" table="dmhogiadinh" fieldKey="ma_hogiadinh" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách hộ gia đình" e="List of Circulated Documents"></title>
  <title0 v="Thêm mới - hộ gia đình" e="New - household"></title0>
  <title1 v="Sửa - hộ gia đình" e="Edit - household"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120" >
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_hogiadinh" label="[120]" field="[120]" allowBlank="false" format="U" disabled="false" fieldType="PK" importable="5" >
				<text v="Mã hộ gia đình" e="Household Code"></text>
			</field>
			<field name="ma_chuho" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" importable="10">
			  <text v="Mã chủ hộ" e="Household Head Code"></text>
			  <viewInfo lookupType="One" lookupId="qldctcccd" lookupKey="ma_qhgd = '03' and ma_dancu not in (select ma_chuho from dmhogiadinh) and status = 1" lookupCheck="1=1" lookupRef="ten_chuho" lookupInfo="qldctcccd|ma_dancu|ten_dancu" />
			</field>
			<field name="ten_chuho" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>

			<field name="ma_ttp" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false" importable="15">
			  <text v="Mã tỉnh thành phố" e="Province/City Code"></text>
			  <viewInfo lookupType="One" lookupId="dmttp" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_ttp" lookupInfo="dmttp|ma_ttp|ten_ttp" />
			</field>
			<field name="ten_ttp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ma_phuongxa" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" importable="15">
			  <text v="Mã phường/xã" e="Ward/Commune Code"></text>
			  <viewInfo lookupType="One" lookupId="dmphuongxa" lookupKey="ma_ttp = ![ma_ttp]! and status = 1" lookupCheck="1=1" lookupRef="ten_phuongxa" lookupInfo="dmphuongxa|ma_phuongxa|ten_phuongxa" />
			</field>
			<field name="ten_phuongxa" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ma_khupho" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" importable="20">
			  <text v="Mã khu phố" e="Neighborhood Code"></text>
			  <viewInfo lookupType="One" lookupId="dmkhupho" lookupKey="(ma_phuongxa = '' or  ma_phuongxa = ![ma_phuongxa]!) and status = 1" lookupCheck="1=1" lookupRef="ten_khupho" lookupInfo="dmkhupho|ma_khupho|ten_khupho" />
			</field>
			<field name="ten_khupho" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="dia_chi" label="1" field="-"  allowBlank="true" disabled="false" importable="25">
			  <text v="Địa chỉ" e="Address"></text>
			</field>
			<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
</forms>

&DefaultButton;

<js>
    <text>
  <![CDATA[
function dir$dmhogiadinh(p){
  this.constructor(p);
}
dir$dmhogiadinh.prototype = new DirEvent();
dir$dmhogiadinh.prototype.afterInit = function(renderType){
  var p = this._dir;
	dir$dmhogiadinhDisabledMasterField(p);

}

function dir$dmhogiadinhDisabledMasterField(p){
var maPl = p.valForm('ma_hogiadinh');
	if(maPl) {
		p.setDisabled('ma_hogiadinh', true);
	} else {
		p.setDisabled('ma_hogiadinh', false);
	}
}
         ]]>
    </text>
  </js>
	<css>
		<text>
			  <![CDATA[
.modal-dialog-lg{min-width:720px!important;}
.control-label.tt {color: #499b98; text-decoration: underline}
.control-label.ma_hogiadinh {color: #499b98;}
			  ]]>
		</text>
	</css>
	<script>
		<query>
		  <text>
			<![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table
drop table #@@table
			 ]]>
		  </text>
		</query>
		<updated>
		  <text>
			<![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]
			 ]]>
		  </text>
		</updated>
		<inserting>
		  <text>
			<![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
			]]>
		  </text>
		</inserting>
		<importing>
			<text>
			<![CDATA[
update #data set unit_id = @@unit
@@insert
			]]>
			</text>
		</importing>
	</script>
	<messages>
		<message val="codeExistsNewMsg">
		  <text v="Mã hộ gia đình đã tồn tại trong danh mục." e="The household code already exists in the list."/>
		</message>
	</messages>
</dir>
