<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmcong" table="dmcong" fieldKey="ma_cong" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục công/thùng hàng" e="List of Container/Cargo"></title>
  <title0 v="Thêm mới" e="Create New"></title0>
  <title1 v="Sửa" e="Edit"></title1>


  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_cong" format="U" label="1" field="1" allowBlank="false" fieldType="PK" importable="1" >
          <text v="Mã container" e="Container Code"></text>
        </field>
        <field name="ten_cong" label="1" field="-" allowBlank="false" importable="5" >
          <text v="Tên container" e="Container Name"></text>
        </field>
		<field name="ten_cong2" label="1" field="-" importable="10" >
          <text v="Tên khác" e="Other Name"></text>
        </field>
		<field name="ma_loai" viewType="Lookup" label="1" field="1" importable="15" >
           <text v="Mã loại" e="Type Code"></text>
           <viewInfo lookupType="One" lookupId="dmloaicong" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_loai" lookupInfo="dmloaicong|ma_loai|ten_loai" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_loai" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
           <text v="" e=""></text>
        </field>
		
        <field name="status" viewType="Combobox" inactivate="true" valueDefault="1" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmcong(p){
  this.constructor(p);
}
dir$dmcong.prototype = new DirEvent();
dir$dmcong.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmcong.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

  dir$dmcongDisabledMasterField(p, g);

}

function dir$dmcongDisabledMasterField(p, g){
  
  if(p.valForm('ma_cong').trim() != '')
  {
    p.setDisabled('ma_cong', true);
  }
  else
  {
    p.setDisabled('ma_cong', false);
  }
}
         ]]>
    </text>
  </js>
  
  <css>
	<text>
	  <![CDATA[
		.control-label.ma_cong, .control-label.ten_cong
		{	
			//font-weight:bold;	
			color: #499b98;;
		}
	  ]]>
	</text>
  </css>
  
  <script>
	<importing>
      <text>
        <![CDATA[
		@@insert
        ]]>
      </text>
    </importing>
  </script>
  
  <messages>
	<message val="codeExistsNewMsg">
		<text v="Mã công/thùng hàng đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The container/cargo code already exists in the catalog, please choose a different code."/>
	</message>
	<message val="codeExistsEditMsg">
		<text v="Mã công/thùng hàng đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The container/cargo code already exists in the catalog, please choose a different code."/>
	</message>
  </messages>


</dir>