		</field>
		<field name="ma_hq" allowBlank="true" nextRow="false" viewType="Lookup" label="1" field="1"  hidden="false">
          <text v="Hải quan" e="Custom House"></text>
          <viewInfo lookupType="One" lookupId="dmhaiquan" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_hq" lookupInfo="dmhaiquan|ma_hq|ten_hq" />
        </field>
        <field name="ten_hq" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="2" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="doc_nam" label="1" field="1" allowBlank="true">
			<text v="Doc Year" e="Doc Year"></text>
		</field>
		<field name="doc_export" label="1" field="1" allowBlank="true">
			<text v="Export Ref" e="Export Ref"></text>
		</field>
		<field name="ma_cnct" label="1" field="1" allowBlank="true">
			<text v="Doc Function" e="Doc Function"></text>
		</field>
