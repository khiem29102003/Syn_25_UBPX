    <aftersave>
      <text>
        <![CDATA[<enc></enc>]]>&VoucherCurrStockCreateTempTable;<![CDATA[<enc></enc>]]>&VoucherCurrStockInsertNewTempTable;&VoucherCurrStockCalc;<![CDATA[<enc></enc>]]>
