<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields10.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid05.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">
  <!ENTITY JobNumberBeforeSave SYSTEM "..\Include\Script\JobNumberBeforeSave.txt">
  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherPurchaseRequest SYSTEM "..\Include\XML\VoucherPurchaseRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from q82 where id = @id and status in (5,6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
  if exists(select 1 from d56 with(index(id_hd)) where id_hd = @id) begin
    select '$DaTraLai' as message
    return
  end
  if exists(select 1 from ctqlq20 where id_tt = @id and loai_tt = 1) begin
    select '$DaThanhToan' as message
    return
  end
    ">
]>

<dir id="q82" table="q82" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="NQ1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phiếu nhập quỹ" e="Fund Entry Slip"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120,120,120"  >
      <fields>
		<field name="ma_ngv" viewType="Combobox" valueDefault="" label="1" field="1" hidden="true" >
          <text v="Loại hóa đơn" e="Inv. Type"></text>
          <viewInfo>
            <options query="select ma_ngv, ten_ngv%l from dmngv where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="ma_kh" allowBlank="true" viewType="Lookup" label="1" field="1" importable="5">
          <text v="Nhân viên" e="Employee Code"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status = 1 and nv_yn = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>

		<field name="t_tt" nextRow="false" label="1" field="1" dataType="N" allowBlank ="false" disabled="false" format="Amount" >
          <text v="Tiền" e="Total Amount"></text>
        </field>
		<field name="dien_giai" label="1" rows="1" field="-">
          <text v="Diễn giải" e="Explain"></text>
        </field>


		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_dh" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;

        &VoucherRequiredFields02;
		
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="200" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="NQ1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>&VoucherSaleRequestGrid;<![CDATA[<enc></enc>]]>&VoucherExRateValid01;<![CDATA[<enc></enc>]]>&VoucherExRateValid02;<![CDATA[<enc></enc>]]>
    </text>
  </js>
<css>
    <text>
      <![CDATA[<enc>CZFh94GVoHFblzG+rXsCnXHxXMEwNmrGQTbp8VglpyAdweEtRLdafCtWo/DlIJ6/fgHVAYTMAhoPiKD+Oj1Yr9b6gLiv3wjtH0yAKuuxDnv81aFdsnW2zV5s65euEJZHbstGCGl2dCa3p9vGL9zncT8/imgIG9LfLzwScaKYqMzjNeW7VrXcd+dDdCbic0qCC2xadceORG308dUT637UDsaYLcqhRxAmKegqmbA638YZiTVMQdDYtwc7GhwGG7Jz</enc>]]>
    </text>
  </css>
  <script>


    &VoucherRequest;
    &VoucherPurchaseRequest;


	 <request code="GetExRateDetail">
      <text>
        <![CDATA[<enc>gZ7UrPfPQeXpaJ+MX5crPlPOmL45ydfn4q/+FwSzfHMDZAArCOiOK8jOWcYmbRckRDiRiE/PQ9R7PMI4Cw9MH3JumxFxdb6/dinQxWRHf0rzzx2m6FTTWwOaaCxsy0aZ</enc>]]>
