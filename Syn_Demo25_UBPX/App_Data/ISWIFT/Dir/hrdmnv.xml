  <script>

    <query>
      <text>
        <![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @fscript nvarchar(4000)
if @action in ('EDIT', 'VIEW') exec ISWIFTStoreGetListFiles 'image_id', @id, 'Employee', '', @fscript output
if @fscript is null set @fscript = ''
if @action in ('EDIT', 'VIEW') begin
    select @fscript as script
end
drop table #@@table
]]>
      </text>
    </query>



    <beforesave>
      <text>
        <![CDATA[
if exists(select 1 from hrdmnv where ma_nv = @ma_nv and id <> @id)
begin
	select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
	return
end
				 ]]>
      </text>
    </beforesave>

    <updated>
      <text>
        <![CDATA[
update dmttin set status = 0 from dmttin where id0 = rtrim(@id) and xgroup = 'Employee'
if @image_id <> '' update dmttin set status = 1, id0 = rtrim(@id) from dmttin where charindex(id, @image_id) > 0 and xgroup = 'Employee'
update @@table set datetime2 = getdate(), user_id2 = @@userId, image_id = @image_id where [%whereFieldKey]
]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[
select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId
exec ISWIFTStoredGetIdentityNumber 'HRM', '@@table', @id output, 'HRM'
         ]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[
if @image_id <> '' update dmttin set status = 1, id0 = rtrim(@id) from dmttin where charindex(id, @image_id) > 0 and xgroup = 'Employee'

if @action = 'NEW'
  insert into hreqtct(id, line, ma_bp, ma_vtr, ngay_tu) select @id, 1, @ma_bp, @ma_vtr, @ngay_vao

select '' as message, @id as [#id]
]]>
      </text>
    </inserted>

    <aftersave>
      <text>
        <![CDATA[
delete hrenn where id = @id
insert hrenn select * from @hrenn


delete hretdhv where id = @id
insert hretdhv select * from @hretdhv

update hrdmnv set bp_ref = b.bp_ref from hrdmnv a join hrdmbp b on a.ma_bp = b.ma_bp where id = @id
select @ho_nv + space(1) + @ten_nv as [#ho_ten_nv], @id as [#id], '' as message
return
				 ]]>
      </text>
    </aftersave>

  </script>

