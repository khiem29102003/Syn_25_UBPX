<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields01.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from x11 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="x11" table="x11" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="VL1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Tạo đơn hàng tổng" e="Create a total order"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120,120,120" >
      <fields>
	  <field name="ma_gd" viewType="Combobox" valueDefault="" label="1" field="[180]" >
          <text v="Loại hàng" e="Type Code"></text>
          <viewInfo>
            <options query="select ma_gd, ten_gd%l from dmgd where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="ma_kh" allowBlank="false" viewType="Lookup" label="1" field="1">
          <text v="Mã khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ong_ba" label="1" nextRow="false"  rows="1" field="-">
          <text v="Người liên hệ" e="Contact"></text>
        </field>
        <field name="ngay_hl" dataType="D" label="1" rows="1" field="1">
          <text v="Ngày hiệu lực" e="Effective to"></text>
        </field>
        <field name="ma_tt" viewType="Lookup" label="1" field="1" nextRow="true" >
          <text v="Mã thanh toán" e="Credit Term"></text>
          <viewInfo lookupType="One" lookupId="dmtt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_tt" lookupInfo="dmtt|ma_tt|ten_tt" />
        </field>
        <field name="ten_tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		 
		<field name="ma_nvbh" clientDefault="true" nextRow="false" viewType="Lookup" label="3" field="1" importable="85">
          <text v="Mã nhân viên" e="Sale"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nvbh" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" />
        </field>
		
        <field name="ten_nvbh" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
        <field name="dien_giai" label="1" rows="1" field="-">
          <text v="Diễn giải" e="Memo"></text>
        </field>
        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
		
	
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="y11" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="2" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi phí" e="Fee"></text>
      <fields>
        <field name="y113" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi phí" e="Fee"></text>
        </field>
      </fields>
    </form>
    
    <form tabPageIndex="3" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Thông tin khách hàng" e="Customer Info"></text>
      <fields>
        <field name="ma_dc" viewType="Lookup" label="1" field="1">
          <text v="Địa chỉ" e="Địa chỉ"></text>
          <viewInfo lookupType="One" lookupId="dmdc" lookupKey="ma_kh in (![ma_kh]!, '') and status = 1" lookupCheck="ma_kh in (![ma_kh]!, '')" lookupRef="ten_dc" lookupInfo="dmdc|ma_dc|ten_dc"/>
        </field>
        <field name="ten_dc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="dia_chi" label="1" field="-">
          <text v="Địa chỉ" e="Address"></text>
        </field>
        
      </fields>
    </form>

    <form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Khác" e="Other"></text>
      <fields>
       
        <field name="ma_ptvc" viewType="Lookup" label="1" field="1">
          <text v="Phương tiện v/c" e="Transportation"></text>
          <viewInfo lookupType="One" lookupId="dmptvc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptvc" lookupInfo="dmptvc|ma_ptvc|ten_ptvc" />
        </field>
        <field name="ten_ptvc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_pttt" viewType="Lookup" label="1" field="1">
          <text v="Ph/th thanh toán" e="Payment Methods"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptgh" viewType="Lookup" label="1" field="1">
          <text v="Ph/th giao hàng" e="Delivery Methods"></text>
          <viewInfo lookupType="One" lookupId="dmptgh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptgh" lookupInfo="dmptgh|ma_ptgh|ten_ptgh" />
        </field>
        <field name="ten_ptgh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        
      </fields>
    </form>

    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="VL1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="150,120,120,120,120" >
      <fields>
         <field name="t_sl_n" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng số container" e="Total Container"></text>
        </field>
        <field name="t_sl_x" label="" field="1" nextRow="false" disabled="false" dataType="N" format="Amount" >
          <text v="Tổng container đã phân bổ" e="Total containers allocated"></text>
        </field>
        <field name="t_sl_t" label="1" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng container chưa phân bổ" e="Total unallocated containers"></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="y11" table="y11" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_cong" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã container" e="Container Code"></text>
          <viewInfo lookupType="One" lookupId="dmcong" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_cong" lookupInfo="dmcong|ma_cong|ten_cong" />
        </field>
        <field name="ten_cong" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmcong b on a.ma_cong = b.ma_cong ">
          <text v="Tên container" e="Container Name"></text>
        </field>
      
        <field name="sl_n" dataType="N" format="Qty" allowBlank="false" width="100" readOnly="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
         <field name="sl_x" dataType="N" format="Qty" allowBlank="false" width="100" readOnly="false" >
          <text v="Số đã phân bổ" e="Allotted number"></text>
        </field>
		 <field name="sl_t" dataType="N" format="Qty" allowBlank="false" width="100" readOnly="false" >
          <text v="Số lượng tồn" e="Quantity in stock"></text>
        </field>
      
        &VoucherExtendFields;
       
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[
set nocount on
select @@fields into #t from y11 a @@join where @@key order by line

--if @copy = 0 and exists(select 1 from m85 where id = @id and status >= 5) exec ISWIFTStoredGetCurrentStock 'U1', '#t' else 
--exec ISWIFTStoredGetCurrentStock 'U0', '#t'

select * from #t order by line
drop table #t
         ]]>
          </text>
        </query>
      </script>

    </grid>
    <grid id="y113" table="y113" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ma_phi" width="100" viewType="Lookup" readOnly="false" >
          <text v="Mã phí" e="Fee"></text>
          <viewInfo lookupType="One" lookupId="dmphi" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_phi" lookupInfo="dmphi|ma_phi|ten_phi" />
        </field>
        <field name="ten_phi" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmphi b on a.ma_phi = b.ma_phi ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
        <field name="tien" dataType="N" format="Amount" width="100" readOnly="false" >
          <text v="Tiền" e="Amount"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>
      <script>
        <query>
          <text>
            <![CDATA[
set nocount on
select @@fields into #t from y113 a @@join where @@key order by line
select * from #t order by line
drop table #t
         ]]>
          </text>
        </query>
      </script>
    </grid>
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$x11(p){
  this.constructor(p);
}
dir$x11.prototype = new DirEvent();
dir$x11.prototype.beforeInit = function(renderType){
  this._dir.options._files = null;
}
dir$x11.prototype.afterInit = function(renderType){
  var p = this._dir, g = p.grid(), y113 = p.grid(1);
  var exp = {
    
    sl_t: ['*sl_t', '[sl_n]-[sl_x]'],
    
    t_sl_n: ['@t_sl_n', '[sl_n]'],
	t_sl_x: ['@t_sl_x', '[sl_x]'],
	t_sl_t: ['@t_sl_t', '[sl_t]']
  }
  p.applyExpression(exp, g, false);
   
  
  g.FomulaApplied = {
    "sl_n":["t_sl_n", "t_sl_x", "t_sl_t", "sl_t"],
	"sl_x":["t_sl_n", "t_sl_x", "t_sl_t", "sl_t"]
  }
  //console.log(JSON.stringify(g.FomulaApplied)); //Gan la ds cong thuc tinh cho cot nao do: 
  
  //p.options.FCColumns = {FC: ['t_sl_n'], BC: ['sl_n']};
 // g.FCColumns = {FC: ['t_sl_n'], BC: ['sl_n']};
  
 
	dir$x11DisabledMasterField(p, g);
  dir$x11HiddenColumnByType(p);
  dir$x11HiddenColumnByTran(p);
  dir$x11DisabledStatusByAction(p);
  

  p.find(".control-label.t_sl_n, .control-label.t_sl_x, .control-label.t_sl_t,  .input-field.t_sl_n, .input-field.t_sl_x, .input-field.t_sl_t").css("font-weight", "bold");

}

dir$x11.prototype.beforeButtonDialogClick = function (id) {
  var p = this._dir, g = p.grid(0), dt = g.data;
  switch (id) {
    case 'ok':
      var rows = dt.findRow("[sl_t] < 0") //Ban chuan chi xu ly canh bao ton kho tuc thoi tren client
      if (p.valForm('status') != '0' && rows.length) {
        $.question('$VoucherCurrentStockOverload', $.msg.get("QuestionTitle"), p, function (q, v) {
          q._close();
          if (v)
            p.options.event.buttonDialogClick(id, false);
          else {
            p.tabActive("1");
            p.jCell(rows[0], 'sl_t', 0).focus();
          }
        });
        return false;
      }
      break;
    default:
      break;
  }
  return true;
}
dir$x11.prototype.beforeButtonGridClick = function (id, gindex) {
  var p = this._dir;
  switch (id) {
    default:
      break;
  }
  return true;
}

dir$x11.prototype.gridCellValueChange = function (o, g, r, c, v) {
  var p = this._dir;
  switch (c){
]]><![CDATA[
    default:
      break;
  }
}
dir$x11.prototype.formFieldValueChange = function (o, cF, v) {
  var p = this._dir;
  switch (cF){
]]>&VoucherExRateValid01;<![CDATA[
    case 'ma_gd':
      dir$x11HiddenColumnByTran(p);
      break;
    case 'ma_ngv':
      dir$x11HiddenColumnByType(p);
      break;
    case 'ty_gia':
      p.calcExpressionAll(0, '!ty_gia');
      break;
    case 'ma_kh':
      p.request('Customer', '', ['ma_kh', 'ngay_ct', 'ma_nt']);
      break;
    default:
      break;
  }
}
]]><![CDATA[
dir$x11.prototype.gridDetailActionChange = function(gindex, action, r){
  var p = this._dir;
  if (action == 'AfterDeleteRow' || action == 'AfterAppendGrid') dir$x11DisabledMasterField(p, p.grid(gindex));
  return true;
}
function dir$x11DisabledMasterField(p, g){
  var dt = g.data, rows = dt.findRow("[ma_cong].trim() != ''"), dis = rows.length > 0;
  p.setDisabled('unit_id', dis);
  p.setInactive('unit_id', true);
  if (p.options._sale_lock_master == 1) p.setDisabled(['ma_kh', 'ngay_ct', 'ma_nt'], dis);
}
function dir$x11HiddenColumnByType(p){
  var v = p.valForm('ma_ngv'), nt = p.valForm('ma_nt'), bc = p.options.struct.baseCurrency;
}
function dir$x11HiddenColumnByTran(p){
  
}
function dir$x11DisabledStatusByAction(p){
  var o = p.jObject('status');
  if (p.options.action != 'VIEW') o.find("[value=6],[value=7],[value=9]").remove();
}
         ]]>
    </text>
  </js>

  <script>
    &VoucherRequest;
    &VoucherSaleRequest;

    <query>
      <text>
        <![CDATA[
if @action = 'EDIT' begin
]]>&CheckUpdatingDeleting;<![CDATA[
end
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @action in ('EDIT', 'VIEW') exec ISWIFTStoreGetListFiles 'xfile', @id, '@@voucherCode', '', @script output
if @script is null set @script = ''

if @action = 'NEW' begin
  declare @ma_nk varchar(32), @ten_nk nvarchar(3000), @ngay_ct date, @so_ct varchar(32), @i_so_ct int, @unit_id int
  select @ngay_ct = getdate(), @unit_id = @@unit
]]>&VoucherNumberQuery;<![CDATA[
  if @so_ct is null
    select '' as [so_ct], 0 as [i_so_ct], @unit_id as [unit_id], '' as ma_nk, '' as ten_nk
  else
    select @so_ct as [so_ct], @i_so_ct as [i_so_ct], @unit_id as [unit_id], @ma_nk as ma_nk, @ten_nk as ten_nk
end
else select @script as script
drop table #@@table
         ]]>
      </text>
    </query>

    <declare>
      <text>
        <![CDATA[
declare @warning nvarchar(256), @dOldVoucherDate date, @dVoucherDate date, @nVoucherType tinyint, @strIds varchar(256), @q nvarchar(4000)
set @warning = ''
         ]]>
      </text>
    </declare>

    &VoucherJSLoading;

    <beforesave>
      <text>
        &VoucherNumberBeforeSave;
      </text>
    </beforesave>

    <deleting>
      <text>
        &CheckUpdatingDeleting;
        <![CDATA[
select @dOldVoucherDate = ngay_ct, @dVoucherDate = ngay_ct, @nVoucherType = ma_ngv from x11 where id = @id
        ]]>
      </text>
    </deleting>

    <deleted>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
exec ISWIFTStoredDeleteDataWithKey 'y11', @strIds, '', @dVoucherDate
        ]]>
      </text>
    </deleted>

    <updating>
      <text>
        <![CDATA[
select @dOldVoucherDate = ngay_ct from x11 where id = @id
        ]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId, i_so_ct = @i_so_ct, so_ct = @so_ct where [%whereFieldKey]
update dmttin set status = 0 from dmttin where id0 = rtrim(@id) and xgroup = '@@voucherCode'
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
         ]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[
select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @ma_ct = '@@voucherCode'
exec ISWIFTStoredGetIdentityNumber '@@voucherCode', '@@table', @id output
         ]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
]]>
      </text>
    </inserted>

    <aftersave>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
if @action = 'NEW' set @dOldVoucherDate = @ngay_ct
update @y11 set id = @id, ma_kh = @ma_kh, ngay_ct = @ngay_ct, so_ct = @so_ct, status = @status
delete y11 where id = @id
insert y11 select * from @y11
update @y113 set id = @id
delete y113 where id = @id
insert y113 select * from @y113

exec ISWIFTStoredPostingVoucher 'x11', 'y11', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''

exec ISWIFTStoredIncreaseVoucherNo @ma_nk, @ngay_ct, '@@voucherCode', @i_so_ct, @so_ct, '@@table'
select '' as message, @warning as warning, @id as [#id], @so_ct as [#so_ct], @ma_unit as [#ma_unit]
]]>
      </text>
    </aftersave>
  </script>

  <messages>
    <message val="physicalRetrieve">
      <text v="Chỉ xử lý nghiệp vụ sổ sách lấy dữ liệu từ thực tế" e="" />
    </message>
  </messages>
</dir>