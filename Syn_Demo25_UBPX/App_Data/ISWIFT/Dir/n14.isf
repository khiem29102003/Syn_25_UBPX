  if exists(select 1 from n14 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>



<dir id="n14" table="n14" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="CC0" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Đăng ký ngày công" e="Timekeeping"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="ma_bp" format="U" label="1" field="1" viewType="Lookup" clientDefault="true" allowBlank="false" fieldType="PK" copy = "0" >
          <text v="Team" e="Team"></text>
          <viewInfo lookupType="One" lookupId="dmbp" lookupKey="status = 1 " lookupCheck="1=1" lookupRef="ten_bp" lookupInfo="dmbp|ma_bp|ten_bp" />
        </field>
        <field name="ten_bp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ngay_hl" label="1" field="1" valueDefault="new Date()" copy="false" allowBlank="false" dataType="D">
		  <text v="Ngày hiệu lực" e="Effective date"></text>
		</field>
      </fields>
    </form>
	
	<form gravity="TopRight" columns="120,120" >
		<fields>
			&VoucherRequiredFieldsHiddenMaNT;
		</fields>
    </form>
	
	
	<form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
       <text v="Chi tiết" e="Detail"></text>
       <fields>
			<field name="h14" allowBlank="false" label="" field="-" viewType="Grid">
				<text v="Chi tiết" e="Detail"></text>
			</field>
		</fields>
    </form>
	
</forms>
<grids>
    <grid id="h14" table="h14" fieldKey="id, line" order="line" readOnly="false">
		<fields>
			<field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
				<text v="" e=""></text>
			</field>
			<field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
				<text v="Dòng" e="Line"></text>
			</field>
			<field name="ma_nv" width="150" viewType="Lookup" readOnly="false" disabled="true">
			  <text v=" Mã nhân viên" e="Employee code"></text>
				<viewInfo lookupType="One" lookupId="dmnv" lookupKey="xstatus = 5" lookupCheck="1=1" lookupRef="ten_nv" lookupInfo="dmnv|ma_nv|ten_nv" />
			</field>
			<field name="ten_nv" width="200" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmnv b on a.ma_nv = b.ma_nv">
			  <text v="Họ và tên" e="Full name"></text>
			</field>
			
			<field name="t2" width="80" readOnly="false" viewType="Lookup" >
			  <text v="T2" e="T2"></text>
			  	<viewInfo lookupType="One" lookupId="dmcalv" lookupKey="status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmcalv|t2" />
			</field>
			<field name="t3" width="80" readOnly="false" viewType="Lookup" >
			  <text v="T3" e="T2"></text>
			  	<viewInfo lookupType="One" lookupId="dmcalv" lookupKey="status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmcalv|t2" />
			</field>
			<field name="t4" width="80" readOnly="false" viewType="Lookup" >
			  <text v="T4" e="T2"></text>
			  	<viewInfo lookupType="One" lookupId="dmcalv" lookupKey="status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmcalv|t2" />
			</field>
				<field name="t5" width="80" readOnly="false" viewType="Lookup" >
			  <text v="T5" e="T2"></text>
			  	<viewInfo lookupType="One" lookupId="dmcalv" lookupKey="status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmcalv|t2" />
			</field>
			<field name="t6" width="80" readOnly="false" viewType="Lookup" >
			  <text v="T6" e="T2"></text>
			  	<viewInfo lookupType="One" lookupId="dmcalv" lookupKey="status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmcalv|t2" />
			</field>
			<field name="t7" width="80" readOnly="false" viewType="Lookup" >
			  <text v="T7" e="T2"></text>
			  	<viewInfo lookupType="One" lookupId="dmcalv" lookupKey="status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmcalv|t2" />
			</field>

		</fields>

		  <buttons>
			<button id="add">
			  <text v="$AddToolbar" e="$AddToobar"></text>
			</button>
			<button id="delete">
			  <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
			</button>
			<button id="copy">
			  <text v="$CopyToolbar" e="$CopyToolbar"></text>
			</button>
			<button id="paste">
			  <text v="$PasteToolbar" e="$PasteToolbar"></text>
			</button>
			<button id="moveup">
			  <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
			</button>
			<button id="movedown">
			  <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
			</button>
			<button id="split">
			  <text v="-" e="-"></text>
			</button>
			<button id="freeze">
			  <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
			</button>
		  </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>
	
    </grid>
	
 
  </grids>
  &DefaultButton;
  <js>
    <text>
      <![CDATA[<enc></enc>]]>&VoucherExRateValid01;<![CDATA[<enc></enc>]]>
    </text>
  </js>
