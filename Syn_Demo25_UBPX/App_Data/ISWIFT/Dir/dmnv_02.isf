<dir id="dmnv" table="dmnv" fieldKey="ma_nv" dirViewType="Dialog" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhân viên" e="List of employee"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>

		<field name="tt" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="[160]" field="0">
			<text v="Thông tin nhân viên" e="Employee Information: "></text>
		</field>
		<field name="khoang_cach" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="[100]">
           <text v="" e=""></text>
        </field>

		<field name="xstatus" viewType="Combobox" inactivate="true" label="1" field="[150]" nextRow="false" valueDefault ="5" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
			  <option val="3">
                <text v="Thử việc" e="Try job"></text>
              </option>
              <option val="5">
                <text v="Đang làm việc" e="Working"></text>
              </option>
              <option val="9">
                <text v="Nghỉ việc" e="Quitting your job"></text>
              </option>
			  <option val="7">
                <text v="Nghỉ chế độ" e="Vacation mode"></text>
              </option>
            </options>
          </viewInfo>
        </field>
	    <field name="user_id" label="" field="1" dataType="I" hidden="true" fieldType="PK" >
          <text v="" e=""></text>
        </field>
		<field name="ma_dv" viewType="Lookup" label="1" field="1" importable="100" >
		   <text v="Đơn vị" e="Unit"></text>	
