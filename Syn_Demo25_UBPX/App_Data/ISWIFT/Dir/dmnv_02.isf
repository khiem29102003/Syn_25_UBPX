        </field>
		<field name="ten_nv" label="1" field="2" format="U" nextRow="false" allowBlank="false" importable="5" >
          <text v="Họ và tên" e="Employee name"></text>
        </field>
		<field name="ngay_sinh" dataType="D" label="1" field="1" allowBlank="true" importable="15" >
