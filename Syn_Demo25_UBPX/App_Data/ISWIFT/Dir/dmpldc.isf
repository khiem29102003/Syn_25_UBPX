<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmpldc" table="dmpldc" fieldKey="ma_pl" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phân loại dân cư" e="Population Classification List"></title>
  <title0 v="Thêm mới - hu phố" e="New - Population Classification List"></title0>
  <title1 v="Sửa - hu phố" e="Edit - Population Classification List"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120" >
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_pl" label="[120]" field="[120]" allowBlank="false" format="U" disabled="false" fieldType="PK" importable="5" >
				<text v="Mã phân loại dân cư" e="Population Classification Code"></text>
			</field>
			<field name="ten_pl" label="[120]" field="-" allowBlank="false" disabled="false" importable="10">
			  <text v="Tên phân loại dân cư" e="Population Classification Name"></text>
			</field>
			<field name="ten_pl2" label="[120]" field="-" allowBlank="true" disabled="false" importable="15">
			  <text v="Tên tiếng anh" e="English Name"></text>
			</field>
			<!-- <field name="ma_ttp" viewType="Lookup" label="1" field="1" allowBlank="true" importable="15"> -->
			  <!-- <text v="Mã tỉnh/thành phố" e="Province/City Code"></text> -->
			  <!-- <viewInfo lookupType="One" lookupId="dmttp" lookupKey="status=1" lookupRef="ten_ttp" lookupCheck="1=1" lookupInfo="dmttp|ma_ttp|ten_ttp" importCheck="@@DF and z.status=1"/> -->
			<!-- </field> -->
			<!-- <field name="ten_ttp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="false" label="" field="[240]" aliasName="cast('' as nvarchar(4000)) as "> -->
			  <!-- <text v="" e=""></text> -->
			<!-- </field> -->
			<!-- <field name="ma_phuongxa" viewType="Lookup" label="1" field="1" allowBlank="true" importable="20"> -->
			  <!-- <text v="Mã phường xã" e="Commune Code"></text> -->
			  <!-- <viewInfo lookupType="One" lookupId="dmphuongxa" lookupKey="status=1 and ma_ttp = ![ma_ttp]!" lookupRef="ten_phuongxa" lookupCheck="1=1" lookupInfo="dmphuongxa|ma_phuongxa|ten_phuongxa" importCheck="@@DF and z.status=1"/> -->
			<!-- </field> -->
			<!-- <field name="ten_phuongxa" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="false" label="" field="[240]" aliasName="cast('' as nvarchar(4000)) as "> -->
			  <!-- <text v="" e=""></text> -->
			<!-- </field> -->
			<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
</forms>

&DefaultButton;

