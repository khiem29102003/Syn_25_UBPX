  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmbanggia(p){
    this.constructor(p);
	document._dir = p;
}
dir$dmbanggia.prototype = new DirEvent();
dir$dmbanggia.prototype.afterInit = function(){
  var p = this._dir;
  if (p.options.action === "NEW") p.request('GetSTT', '', ['ma_bg'])

  setTimeout(function() {		
		setImages('img_ximage1', 'ximage1', p);
		setImages('img_ximage2', 'ximage2', p);
	}, 500);
}
function browseServer(value, src) {
	var p = document._dir;
	var finder = new CKFinder();
	finder.selectActionFunction = function (url) {
		p.valForm(value, url, true);
		document.getElementById(src).src = url;
	};
	finder.popup();
}
function setImages(id, name, p) {
	$('#' + id).attr("src", p.valForm(name));
}
         ]]>
    </text>
  </js>
<script>
  <request code="GetSTT">
	<text>
		<![CDATA[
				DECLARE @max_number int

				SELECT @max_number = MAX(thu_tu) FROM @@table

				SELECT @max_number = @max_number + 1

				SELECT @max_number [!ma_bg] , @max_number [!thu_tu]
		]]>
	</text>
  </request>
 </script>
  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã dịch vụ đã có hoặc lồng nhau trong danh mục dịch vụ." e="The Service is invalid or already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã dịch vụ đã có hoặc lồng nhau trong danh mục dịch vụ." e="The Service is invalid or already exists."/>
    </message>
  </messages>

