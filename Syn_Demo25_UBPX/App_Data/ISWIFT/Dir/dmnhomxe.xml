          <text v="Mã nhóm xe" e="Vehicle group code"></text>
        </field>
        <field name="ten_nhom" label="1" field="2" allowBlank="false" fieldType="PK" >
          <text v="Tên nhóm xe" e="Vehicle group name"></text>
        </field>
        <field name="ten_nhom2" label="1" field="2">
          <text v="Tên xe" e="Other name"></text>
        </field>
     
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - xeông sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmnhomxe(p){
  this.constructor(p);
}
dir$dmnhomxe.prototype = new DirEvent();
dir$dmnhomxe.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã nhóm xe đã tồn tại' else N'Vehicle group code is exists' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã nhóm xe đã tồn tại' else N'Vehicle group code is exists' end
         ]]>
      </text>
    </declare>
