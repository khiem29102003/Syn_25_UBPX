<!-- GET mã nhân viên-->  
<script>
  <request code="GetEmployeeCode">
	<text>
		<![CDATA[
DECLARE @newCode VARCHAR(20);
DECLARE @prefix  VARCHAR(3) = 'NSP';
DECLARE @maxNum  INT;

SELECT @maxNum = MAX(CAST(RIGHT(ma_nv, 4) AS INT))
FROM dmnv
WHERE ma_nv LIKE @prefix + '%';

SET @maxNum = ISNULL(@maxNum, 0) + 1;

SET @newCode = @prefix + RIGHT('0000' + CAST(@maxNum AS VARCHAR(4)), 4);

SELECT @newCode AS [!ma_nv];
		]]>
	</text>
   </request>
  <request code="GetInfoResident">
	<text>
		<![CDATA[
IF @ma_dancu <> '' BEGIN
	SELECT ten_dancu [!ten_nv], ma_ttp [!ma_ttp], ma_phuongxa [!ma_phuongxa], ma_khupho [!ma_khupho], 
	dia_chi [!dia_chi], ngay_sinh [!ngay_sinh], so_cccd [!cmnd_so], gioi_tinh [!ma_gt], ngay_cap [!cmnd_ngay_cap], dan_toc [!ma_dt], dien_thoai [!dien_thoai]
	FROM qldctcccd
	WHERE ma_dancu = @ma_dancu
END
ELSE BEGIN
	SELECT '' [!ten_nv], '' [!ma_ttp], '' [!ma_phuongxa], '' [!ma_khupho], '' [!dia_chi], NULL [!ngay_sinh], '' [!cmnd_so], '0' [!ma_gt], NULL [!cmnd_ngay_cap], '' [!ma_dt], '' [!dien_thoai]
END
		]]>
	</text>
   </request>
  
<!-- GET dataDate-->    
  <request code="LoadDataDate">
	 <text> 
		<![CDATA[
			select DATEADD(DAY, so_ngay - 1, @ngay_ky_hd) [!ngay_kt_hd] from dmhopdong where ma_hd = @ma_hd
		]]> 
	 </text>
  </request>  
  
  <request code="LoadDataDate1">
	 <text> 
		<![CDATA[
			select DATEADD(DAY, so_ngay , @ngay_ky1_hd) [!ngay_kt1_hd] from dmhopdong where ma_hd = @ma_hd1
		]]> 
	 </text>
  </request>
  
  <request code="LoadDataDate2">
	 <text> 
		<![CDATA[
			select DATEADD(DAY, so_ngay , @ngay_ky2_hd) [!ngay_kt2_hd] from dmhopdong where ma_hd = @ma_hd2
		]]> 
	 </text>
  </request>

  <request code="LoadDataDate3">
	 <text> 
		<![CDATA[
			select DATEADD(DAY, so_ngay , @ngay_ky3_hd) [!ngay_kt3_hd] from dmhopdong where ma_hd = @ma_hd3
		]]> 
	 </text>
  </request>


  <query>
      <text>
        <![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @action in ('EDIT', 'VIEW') 
BEGIN 
exec ISWIFTStoreGetListFiles 'image_id', @ma_nv, 'SysUser', '', @script output 
exec ISWIFTStoreGetListFiles 'xfile', @ma_nv, 'DMNV', '', @script output 
END
if @script is null set @script = ''

if @action = 'EDIT'
  if exists(select 1 from syscodeexists with(nolock, index(code1)) where code1 = @ma_nv and field = 'ma_nv')
    select @script = @script + 'p.setDisabled(''ma_nv'', true); '

if @action in ('EDIT', 'VIEW') select @script as script
drop table #@@table
        ]]>
      </text>
    </query>
	
 

    <beforesave>
      <text>
	     <![CDATA[
IF @xstatus = 9 EXEC ISWIFTStoredSplitGroupName 'dmnv', @ma_nv
		 ]]>
      </text>
    </beforesave>
	
	<updated>
		  <text>
			<![CDATA[
update dmttin set status = 0 from dmttin where id0 = @ma_nv and xgroup = 'SysUser'
if @image_id <> '' update dmttin set status = 1, id0 = @ma_nv from dmttin where charindex(id, @image_id) > 0 and xgroup = 'SysUser'
if @xfile <> '' update dmttin set status = 1, id0 = @ma_nv from dmttin where charindex(id, @xfile) > 0 and xgroup = 'DMNV'

update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]

			 ]]>
      </text>
    </updated>
	
	<inserting>
      <text>
        <![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
]]>
      </text>
    </inserting>
	
     <inserted>
      <text>
        <![CDATA[
if @image_id <> '' update dmttin set status = 1, id0 = @ma_nv from dmttin where charindex(id, @image_id) > 0 and xgroup = 'SysUser'
if @xfile <> '' update dmttin set status = 1, id0 = @ma_nv from dmttin where charindex(id, @xfile) > 0 and xgroup = 'DMNV'
]]>
