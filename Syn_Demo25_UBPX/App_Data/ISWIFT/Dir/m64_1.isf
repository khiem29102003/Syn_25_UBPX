<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields01.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from m64 where id = @id and ma_ngv = 1) and exists(select 1 from cthu20 where id = @id and loai_tt = 1) begin
    select '$DaPhanBo' as message
    return
  end">
]>


<dir id="m64" table="m64" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="HU0" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Hoàn ứng theo phiếu tạm ứng" e="Refund according to advance slip"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="ma_ngv" viewType="Combobox" valueDefault="1" label="1" field="[180]" >
          <text v="Loại phiếu chi" e="Voucher Type"></text>
          <viewInfo>
            <options query="select ma_ngv, ten_ngv%l from dmngv where ma_ct = '@@voucherCode' and status = 1 and ma_ngv=1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="dia_chi" label="1" field="-">
          <text v="Địa chỉ" e="Address"></text>
        </field>
        <field name="ong_ba" label="1" field="-">
          <text v="Người nộp tiền" e="Payer"></text>
        </field>
        <field name="dien_giai" label="1" rows="1" field="-">
          <text v="Diễn giải" e="Pay for"></text>
        </field>
        <field name="tk" hidden="true">
          <text v="Tài khoản nợ" e="Debit Account"></text>
        </field>
        <field name="so_ct0" hidden="true">
          <text v="Số chứng từ" e="Voucher Number"></text>
        </field>
        <field name="ngay_ct0" dataType="D" hidden="true">
          <text v="Ngày chứng từ" e="Voucher Date"></text>
        </field>
        <field name="hd_yn" dataType="B" hidden="true">
          <text v="Theo dõi thanh toán" e=""></text>
        </field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="d64" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="120,120,120,120,120,0" >
      <fields>
        <field name="t_tien_nt" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
        <field name="t_tien" nextRow="false" label="" field="1" disabled="true" dataType="N" format="Amount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="d64" table="d64" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="tk_co" width="100" hidden="true">
          <text v="Tài khoản có" e="Credit Account"></text>
        </field>

        <field name="ma_kh" viewType="Lookup" width="120" allowBlank="false" readOnly="false">
          <text v="Mã nhân viên" e="Employee Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1 and nv_yn = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" fieldType="EX" inactivate="true" width="250" aliasName="c.ten_kh as " join="left join dmkh c on a.ma_kh = c.ma_kh">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
        <field name="id_hd" width="80" allowBlank="false" viewType="Lookup" readOnly="false">
          <text v="ID phiếu" e="ID hóa đơn"></text>
          <viewInfo lookupType="Two" lookupId="cthu20HU0" lookupRef="so_ct_hd" lookupKey="ma_kh = #[ma_kh]# and unit_id = ![unit_id]! and ngay_ct &lt;= ![ngay_ct]! and loai_tt = 0 and (tt_yn = 0 or (id in (select id_tt from cthu20 where id = ![id]! and loai_tt = 1)))" />
        </field>
        <field name="so_ct_hd" width="100" fieldType="EX" aliasName="b.so_ct as " join="left join #cthu20 b on a.id_hd = b.id and b.loai_tt = 0" >
          <text v="Số phiếu" e="Invoice No."></text>
        </field>
		<field name="ma_ct_hd" width="100" fieldType="EX"  inactivate="true" aliasName="b.ma_ct as ">
          <text v="Mã phiếu" e="Voucher Code"></text>
        </field>
        <field name="ngay_ct_hd" width="100" dataType="D"  inactivate="true" fieldType="EX" aliasName="b.ngay_ct as ">
          <text v="Ngày phiếu" e="Voucher Date"></text>
        </field>
        <field name="ma_nt_hd" width="100" fieldType="EX"  inactivate="true" aliasName="b.ma_nt as ">
          <text v="Ngoại tệ" e="Currency"></text>
        </field>
        <field name="ty_gia_hd" dataType="N" format="FCAmount" width="120" inactivate="true" fieldType="EX" aliasName="b.ty_gia as ">
          <text v="Tỷ giá hđ" e="EX Inv"></text>
        </field>
        <field name="tien_hd_nt" dataType="N" format="FCAmount" width="120" fieldType="EX" aliasName="b.t_tt as ">
          <text v="Tiền trên hóa đơn" e="Invoice Amount"></text>
        </field>
        <field name="da_pb_nt" dataType="N" format="FCAmount" width="120" fieldType="EX" aliasName="0*b.t_tt as ">
          <text v="Đã phân bổ" e="Pcs UOM"></text>
        </field>
        <field name="cl_nt" dataType="N" format="FCAmount" width="100" fieldType="EX" aliasName="0*b.t_tt as " >
          <text v="Còn lại" e=""></text>
        </field>
        <field name="tien_nt" dataType="N" allowBlank="false" format="FCAmount" width="120" readOnly="false">
          <text v="Tiền phải thanh toán" e="Money payable"></text>
        </field>
        <field name="tien" dataType="N" format="Amount" width="120" inactivate="true">
          <text v="Tiền" e="Amount"></text>
        </field>
		
		<field name="ma_pttt" viewType="Lookup" width="100" allowBlank="false" readOnly="false">
          <text v="Mã PT thanh toán" e="Payment Methods Code"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" fieldType="EX" inactivate="true" width="150" aliasName="d.ten_pttt as " join="left join dmpttt d on a.ma_pttt = d.ma_pttt">
          <text v="Tên PT thanh toán" e="Payment Methods Name"></text>
        </field>
        <field name="dien_giai" width="300" readOnly="false">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		<field name="ma_ct_dh" width="100" fieldType="EX"  inactivate="true" aliasName="b.ma_ct_dh as " >
          <text v="Mã c/từ đh" e="Voucher Code"></text>
        </field>
		<field name="so_ct_dh" width="100" fieldType="EX"  inactivate="true" aliasName="b.so_ct_dh as ">
          <text v="Số c/từ đh" e="Voucher Code"></text>
        </field>
        <field name="ngay_ct_dh" width="100" dataType="D"  inactivate="true" fieldType="EX" aliasName="b.ngay_ct_dh as ">
          <text v="Ngày c/từ đh" e="Voucher Date"></text>
        </field>
		<field name="ma_job_dh" width="100" fieldType="EX"  inactivate="true" aliasName="b.ma_job_dh as ">
          <text v="Mã job đh" e="Voucher Code"></text>
        </field>
        <field name="so_job_dh" width="100" fieldType="EX"  inactivate="true" aliasName="b.so_job_dh as ">
          <text v="Số job đh" e="Currency"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
		<button id="retrieve">
          <text v="$RetrieveToolbar" e="$RetrieveToolbar"></text>
          <items>
            <button id="20">
              <text v="Lấy dữ liệu phiếu của nhân viên"  e="Get data from freight costs"/>
            </button>
            <button id="80">
              <text v="-"  e="-"/>
            </button>
            
          </items>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>
  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>&VoucherExRateValid01;<![CDATA[<enc>Py0/TmSZIMJaYLQLEORDRCGjWgJszwElye25g9k9B5zh1n+R31tzskg5zBuuvekuU866QUdgJ8ODLe9TofoI17Gkz3cIq/ZPCBcEFDcelDwFfn5x8ERstQ3WU6n6gKtT</enc>]]>&VoucherExRateValid02;<![CDATA[<enc></enc>]]>
    </text>
  </js>

  <css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>


  <script>
    &VoucherRequest;
    <request code="Invoice">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </request>
