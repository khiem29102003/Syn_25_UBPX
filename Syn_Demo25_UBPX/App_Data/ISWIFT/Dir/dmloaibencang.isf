      </text>
    </importing>
  </script>
  
  <messages>
	<message val="codeExistsNewMsg">
		<text v="Mã loại bến cảng đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The port type code already exists in the catalog, please choose a different code."/>
	</message>
	<message val="codeExistsEditMsg">
		<text v="Mã loại bến cảng đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The port type code already exists in the catalog, please choose a different code."/>
	</message>
  </messages>

</dir>