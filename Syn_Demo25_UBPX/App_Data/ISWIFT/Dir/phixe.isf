	  <script>
		<declare>
		  <text>
			<![CDATA[<enc>kgNieZitFtjbYbV1eT4v7ciUpdGaE46TTZegTe2osMbiAEbgPFq0FNxCkR+qFRXtRqaXIzMeFt+8vINQjCt9n72Xj8JwPV9ZnPAev4OAGhxqcroqLaNwVe4mi1LECCwx5Kbi4dxK2Q49c/ogX6zXfmbtRfn/+EW913QpeLams4NEnVQw9QcHGc9R9Eq5AAlVtlLpqVapXaHekO1885Ej3kvCA3pXTLn0xJu31/4FI6uJrSqAeIzCGIj2CD9EtZrO</enc>]]>
