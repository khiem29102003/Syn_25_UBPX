<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields05.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherPurchaseRequest SYSTEM "..\Include\XML\VoucherPurchaseRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from m63 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
  if exists(select 1 from d56 with(index(id_hd)) where id_hd = @id) begin
    select '$DaTraLai' as message
    return
  end
  if exists(select 1 from ctct20 where id_tt = @id and loai_tt = 1) begin
    select '$DaThanhToan' as message
    return
  end
  if exists(select 1 from cttt20 where id_tt = @id and loai_tt = 1) begin
    select '$DaThanhToan' as message
    return
  end
    ">
]>

<dir id="m63" table="m63" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="CH0" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Phiếu chi hộ" e="Purchase Invoice"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120,120,120"  >
      <fields>
	  	<field name="tt" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="1" field="">
          <text v="Thông tin đơn hàng: " e="Order Information: "></text>
        </field>
		<field name="tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="1" field="">
          <text v="&lt;a onclick='getRequest(this);'&gt;(Từ đơn hàng)&lt;/a&gt; " e="&lt;a onclick='getRequest(this);'&gt;(From Order)&lt;/a&gt;"></text>
        </field>
		<field name="ma_ngv" viewType="Combobox" valueDefault="" label="1" field="1" hidden="true" >
          <text v="Loại hóa đơn" e="Inv. Type"></text>
          <viewInfo>
            <options query="select ma_ngv, ten_ngv%l from dmngv where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="ma_kh" allowBlank="true" nextRow="true" viewType="Lookup" label="[100]" field="1" importable="5">
          <text v="Đối tượng TT" e="Payer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
		<field name="ma_kh_tt" allowBlank="true" nextRow="false" viewType="Lookup" label="[100]" field="1" importable="5">
          <text v="Khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1 and ma_kh not in (select ma_kh from dmkh where nv_yn = 1) " lookupCheck="ma_kh not in (select ma_kh from dmkh where nv_yn = 1)" lookupRef="ten_kh_tt" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh_tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>

		<field name="ma_bp" allowBlank="true" viewType="Lookup" label="[100]" field="1" importable="5">
          <text v="Bộ phận" e="Department"></text>
          <viewInfo lookupType="One" lookupId="dmbp" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_bp" lookupInfo="dmbp|ma_bp|ten_bp" />
        </field>
        <field name="ten_bp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_noi_di" viewType="Lookup" label="[100]" field="1" nextRow="false" allowBlank="true" fieldType="EX" disabled="true">
			<text v="Cảng đi" e="Origin"></text>
			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="(kkh_yn = 1 or hc_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
		</field>
		<field name="ten_noi_di" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field=""  aliasName="cast('' as nvarchar(4000)) as " hidden="true">
			<text v="" e=""></text>
		</field>
	
	
        <field name="ma_pttt" viewType="Lookup" label="[100]" field="1">
          <text v="Hình thức TT" e="Payment Methods"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_noi_den" viewType="Lookup" fieldType="EX" label="[100]" field="1" nextRow="false"  allowBlank="true" disabled="true">
			<text v="Cảng đến" e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="(kkh_yn = 1 or hc_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_den" lookupInfo="vdmcangden|ma_noi_den|ten_noi_den"/>
		</field>
		<field name="ten_noi_den" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="" aliasName="cast('' as nvarchar(200)) as ">
			<text v="" e=""></text>
		</field> 	

        <field name="dien_giai" label="[100]" rows="1" field="-">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_dh" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_yc" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_bg" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_tg" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;

        &VoucherRequiredFields02;
		<field name="ma_job_ct1" allowBlank="true" fieldType="EX" label="[60]" field="" disabled="true"   hidden="false">
          <text v="Số c/t đh" e="Job Code"></text>
        </field>
		<field name="ma_ct_dh" inactivate="true" fieldType="EX" hidden="false" nextRow="false" field="[60]" label="" disabled="true">
		  <text v="" e="Number"></text>
		</field>
		<field name="so_ct_dh" allowBlank="true" fieldType="EX" field="[120]" label="" disabled="true" nextRow="false" hidden="false">
          <text v="" e=""></text>
        </field>

		<field name="ma_job_ct2" allowBlank="true" fieldType="EX" label="[60]" field="" disabled="true"   hidden="false">
          <text v="Số job dh" e="Số file dh"></text>
        </field>
		<field name="ma_job" allowBlank="false" fieldType="EX" nextRow="false" label="" field="[60]"   hidden="false" tabIndex="1" disabled="true">
          <text v="" e="Job Code"></text>
        </field>
		<field name="so_job_dh" format="U" fieldType="EX" copy="false" hidden="false" nextRow="false" align="left" label="" field="[120]" disabled="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="d63" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>

      <form tabPageIndex="3" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Thông tin nhà cung cấp" e="Customer Info"></text>
      <fields>
        <field name="ma_dc" viewType="Lookup" label="1" field="1">
          <text v="Địa chỉ" e="Địa chỉ"></text>
          <viewInfo lookupType="One" lookupId="dmdc" lookupKey="ma_kh in (![ma_kh]!, '') and status = 1" lookupCheck="ma_kh in (![ma_kh]!, '')" lookupRef="ten_dc" lookupInfo="dmdc|ma_dc|ten_dc"/>
        </field>
        <field name="ten_dc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="dia_chi" label="1" field="-">
          <text v="Địa chỉ" e="Address"></text>
        </field>
        <field name="ma_so_thue" label="1" field="-">
          <text v="Mã số thuế" e="Tax Code"></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Khác" e="Other"></text>
      <fields>
        <field name="ma_nvbh" clientDefault="true" allowBlank="true" viewType="Lookup" label="1" field="1" setype="1">
          <text v="Mã nhân viên" e="Sale"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nvbh" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" />
        </field>
        <field name="ten_nvbh" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptvc" viewType="Lookup" label="1" field="1">
          <text v="Phương tiện v/c" e="Transportation"></text>
          <viewInfo lookupType="One" lookupId="dmptvc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptvc" lookupInfo="dmptvc|ma_ptvc|ten_ptvc" />
        </field>
        <field name="ten_ptvc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_tt" viewType="Lookup" label="1" field="1">
          <text v="Mã thanh toán" e="Credit Term"></text>
          <viewInfo lookupType="One" lookupId="dmtt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_tt" lookupInfo="dmtt|ma_tt|ten_tt" />
        </field>
        <field name="ten_tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>

        <field name="ma_ptgh" viewType="Lookup" label="1" field="1">
          <text v="Ph/th giao hàng" e="Delivery Methods"></text>
          <viewInfo lookupType="One" lookupId="dmptgh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptgh" lookupInfo="dmptgh|ma_ptgh|ten_ptgh" />
        </field>
        <field name="ten_ptgh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_gd" viewType="Combobox" valueDefault="" label="1" field="[180]" >
          <text v="Giao dịch" e="Transaction Code"></text>
          <viewInfo>
            <options query="select ma_gd, ten_gd%l from dmgd where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="so_bk" format="U" label="1" field="1" >
          <text v="Số bảng kê" e="List No"></text>
        </field>
        <field name="ngay_bk" dataType="D" label="1" field="1" nextRow="false">
          <text v="Ngày bảng kê" e="List Date"></text>
        </field>
        <field name="ghi_chu" label="1" rows="3" field="-">
          <text v="Ghi chú" e="Note"></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="6" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Tổng cộng" e="Total"></text>
      <fields>
        <field name="t_tien_nt" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền vốn" e="COGS Amount"></text>
        </field>
        <field name="t_tien" nextRow="false" label="" field="1" disabled="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_ck_nt" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng chiết khấu" e="Total Tax"></text>
        </field>
        <field name="t_ck" label="" field="1" nextRow="false" disabled="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_tc_tien_nt2" label="1" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền hàng" e="Total Tax"></text>
        </field>
        <field name="t_tc_tien2" label="" field="1" nextRow="false" disabled="true" fieldType="EX" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_km_nt" label="1" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền KM" e="Total Tax"></text>
        </field>
        <field name="t_km" label="" field="1" nextRow="false" disabled="true" fieldType="EX" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="CH0" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="100,100,100,100,100,100,130" >
      <fields>
        <field name="t_so_luong" label="1" field="1" dataType="N" disabled="true" format="Amount" >
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
		<field name="t_tien2" nextRow="false" label="1" field="1" disabled="true" dataType="N" format="Amount" hidden="true">
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
		<field name="t_tt" label="" field="1" nextRow="false" disabled="true" hidden="false" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_tien_nt2" nextRow="true" label="1" field="1" dataType="N" disabled="true" hidden="true" format="FCAmount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>

        <field name="t_thue_nt" blank="2" label="1" field="1" dataType="N" disabled="true" format="FCAmount" hidden="true" >
          <text v="Tổng thuế" e="Total Tax"></text>
        </field>
        <field name="t_thue" label="" field="1" nextRow="false" disabled="true" dataType="N" format="Amount" hidden="true">
          <text v="" e="Total Tax"></text>
        </field>
        <field name="t_tt_nt" nextRow="false" label="1" field="1" dataType="N" disabled="true" format="FCAmount" hidden="true">
          <text v="Tổng thanh toán" e="Total Amount"></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="d63" table="d63" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_vt" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã phí" e="Fee Code"></text>
          <viewInfo lookupType="One" lookupId="dmvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_vt" lookupInfo="dmvt|ma_vt|ten_vt" />
        </field>
        <field name="ten_vt" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmvt b on a.ma_vt = b.ma_vt ">
          <text v="Tên mã phí" e="Fee Name"></text>
        </field>
        <field name="dvt" width="100" readOnly="false" allowBlank="true" viewType="Lookup" aliasName="a">
          <text v="Đơn vị" e="UOM"></text>
          <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|ma_dvt|ten_dvt" />
        </field>
        <field name="ten_dvt" width="120" inactivate="true" readOnly="true" hidden="true" aliasName="c" join=" left join dmdvt c on a.dvt = c.dvt ">
          <text v="Tên đvt" e="UOM"></text>
        </field>
        <field name="ma_kho" width="100" clientDefault="true" allowBlank="true" viewType="Lookup" readOnly="false" hidden="true" >
          <text v="Mã kho" e="Site"></text>
          <viewInfo lookupType="One" lookupId="dmkho" lookupKey="unit_id = ![unit_id]! and status=1" lookupCheck="unit_id = ![unit_id]!" lookupRef="ten_kho" lookupInfo="dmkho|ma_kho|ten_kho" />
        </field>
        <field name="ten_kho" width="120" clientDefault="true" inactivate="true" hidden="true" aliasName="d" join=" left join dmkho d on a.ma_kho = d.ma_kho ">
          <text v="Tên kho" e="Site"></text>
        </field>
        <field name="ma_lo" width="100" readOnly="false" allowBlank="false" hidden="true" viewType="Lookup" readOnlyCondition="[lo_yn]==0" allowBlankCondition="[lo_yn]==0" >
          <text v="Mã lô" e="Lot"></text>
          <viewInfo lookupType="One" lookupId="dmlo" lookupKey="ma_vt = #[ma_vt]# and status=1" lookupCheck="1=1" lookupRef="ten_lo" lookupInfo="dmlo|ma_lo|ten_lo" />
        </field>
        <field name="ten_lo" width="120" inactivate="true" readOnly="true" hidden="true" aliasName="e" join=" left join dmlo e on a.ma_vt = e.ma_vt and a.ma_lo = e.ma_lo ">
          <text v="Tên lô" e="Lot"></text>
        </field>
        <field name="lo_yn" dataType="B" width="50" hidden="true" inactivate="true" readOnly="true" aliasName="b">
          <text v="Td lô" e="Lot"></text>
        </field>
        <field name="ma_vi_tri" width="100" readOnly="false" clientDefault="true" hidden="true"  allowBlank="false" viewType="Lookup" readOnlyCondition="[vi_tri_yn]==0" allowBlankCondition="[vi_tri_yn]==0" >
          <text v="Mã vị trí" e="Location"></text>
          <viewInfo lookupType="One" lookupId="dmvitri" lookupKey="ma_kho = #[ma_kho]# and status=1" lookupCheck="1=1" lookupRef="ten_vi_tri" lookupInfo="dmvitri|ma_vi_tri|ten_vi_tri" />
        </field>
        <field name="ten_vi_tri" width="120" inactivate="true" clientDefault="true" readOnly="true" hidden="true" aliasName="f" join=" left join dmvitri f on a.ma_kho = f.ma_kho and a.ma_vi_tri = f.ma_vi_tri ">
          <text v="Tên vị trí" e="Location Name"></text>
        </field>
        <field name="vi_tri_yn" dataType="B" width="50" clientDefault="true" hidden="true" inactivate="true" readOnly="true" aliasName="d">
          <text v="Td vị trí" e="Location"></text>
        </field>
        <field name="he_so" dataType="N" format="Rate" width="50" readOnly="true" inactivate="true" aliasName="a" hidden="true" >
          <text v="Hệ số" e="Rate"></text>
        </field>
        <field name="sl_ton" dataType="N" format="Qty" inactivate="true" width="100" readOnly="true" fieldType="EX" aliasName="0*a.so_luong as " hidden="true" >
          <text v="Tồn" e="Stock"></text>
        </field>
        <field name="so_luong" dataType="N" format="Amount" allowBlank="false" width="100" valueDefault="1"  readOnly="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>

        <field name="ct_km" width="100" valueDefault="0"  hidden="true" viewType="Combobox" inactivate="true" readOnly="false" >
          <text v="Loại hàng" e="Item Type"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Hàng mua" e="Sale"/>
              </option>
              <option val="1">
                <text v="Hàng KM" e="Promotion"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="px_dd" dataType="B" width="100"  hidden="true" readOnly="false" >
          <text v="Đích danh" e="Specific Cost"></text>
        </field>
        <field name="gia_nt" dataType="N" format="FCPrice" width="100" hidden="true" inactivate="true" readOnly="false" readOnlyCondition="[px_dd] == 0" >
          <text v="Giá tồn %s" e="%s Price"></text>
        </field>
        <field name="tien_nt" dataType="N" format="FCAmount" width="100" hidden="true" inactivate="true" readOnly="true" readOnlyCondition="[px_dd] == 0" >
          <text v="Tiền %s" e="%s Amount"></text>
        </field>
        <field name="gia_nt1" dataType="N" inactivate="true" hidden="true" format="FCPrice" width="100" readOnly="false" >
          <text v="Giá chuẩn %s" e="%s Std.Price"></text>
        </field>
        <field name="gia_nt2" dataType="N" format="FCPrice" width="100" readOnly="false" >
          <text v="Đơn giá" e="Purchase Price"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="FCAmount" width="100" readOnly="false" disabled="true" >
          <text v="Thành tiền" e="Amount"></text>
        </field>
		
        <field name="tl_ck" dataType="N" format="Rate" width="100" readOnly="false" hidden="true" >
          <text v="Tl ck(%)" e="Dis.Rate"></text>
        </field>
        <field name="ck_nt" dataType="N" format="FCAmount" width="100" readOnly="false" clientDefault="true" hidden="true">
          <text v="Ch.khấu %s" e="%s Discount"></text>
        </field>

        <field name="thue_nt" dataType="N" format="FCAmount" width="100" readOnly="false" hidden="true">
          <text v="Thuế %s" e="%s Tax"></text>
        </field>
        <field name="ma_imei" width="100"  hidden="true" readOnly="false" >
          <text v="Mã Imei" e="Imei Code"></text>
        </field>

	   <field name="so_ngay_bh" dataType="N" hidden="true" width="100" readOnly="false" >
			<text v="Tg bảo hành (ngày)" e="Guarantee(days)"></text>
		</field>
		
		<field name="ma_nt" width="70" allowBlank="true" valueDefault="VND" viewType="Lookup" readOnly="false" >
          <text v="Mã NT" e="Currency"></text>
          <viewInfo lookupType="One" lookupId="dmnt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nt" lookupInfo="dmnt|ma_nt|ten_nt" />
        </field>
		 <field name="ten_nt" width="0" fieldType="EX" inactivate="true" readOnly="true" aliasName="t" join=" left join dmnt t on a.ma_nt = t.ma_nt ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
		 <field name="ty_gia" dataType="N" format="Price" width="100" valueDefault="1" hidden="false" readOnly="false" >
          <text v="Tỷ giá" e="Curr.Rate"></text>
        </field>

		<field name="ma_bh"  width="100" hidden="true" inactivate="true" readOnly="false" >
          <text v="Mã bảo hành" e="Guarantee Code"></text>
        </field>
        <field name="ngay_bh" dataType="D" hidden="true" width="100" readOnly="false" >
          <text v="Ngày bảo hành" e="Start Date"></text>
        </field>
        <field name="ngay_kt" dataType="D" hidden="true" width="100" readOnly="false" >
          <text v="Ngày kết thúc BH" e="End Date"></text>
        </field>

        <field name="gia" dataType="N" format="Price"  hidden="true" width="0" inactivate="true" readOnly="false" readOnlyCondition="[px_dd] == 0" >
          <text v="Giá tồn" e="Price"></text>
        </field>
        <field name="tien" dataType="N" format="Amount"  hidden="true" width="0" inactivate="true" readOnly="true" readOnlyCondition="[px_dd] == 0" >
          <text v="Tiền" e="Amount"></text>
        </field>
        <field name="gia1" dataType="N"  hidden="true" format="Price" width="300" inactivate="true" readOnly="true" >
          <text v="Giá chuẩn" e="Std.Price"></text>
        </field>
        <field name="gia2" dataType="N" format="Price" width="100" inactivate="true" readOnly="false" hidden="true" >
          <text v="Giá mua VND" e=" VND Purchase Price"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false" >
          <text v="Tiền VND" e=" VND Amount"></text>
        </field>
        <field name="ck" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false" hidden="true">
          <text v="Chiết khấu" e="Discount"></text>
        </field>
		<field name="thue_suat" dataType="N" format="0" width="100" readOnly="false" clientDefault="true" hidden="false">
          <text v="Thuế suất(%)" e="Tax"></text>
        </field>
        <field name="thue" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false" disabled="true">
          <text v="Thuế" e="Tax"></text>
        </field>
		
		<field name="tt" dataType="N" format="Amount" width="100" hidden="false" valueDefault="0" inactivate="false" readOnly="true" >
          <text v="Tổng cộng" e="Total"></text>
        </field>
		<field name="tt_nt" dataType="N" format="Amount" width="100" hidden="true" inactivate="false" readOnly="true" >
          <text v="" e="Total "></text>
        </field>
        <field name="sl_pn" dataType="N" inactivate="true"  hidden="true" format="Qty" width="100" copy="false" aliasName="0*so_luong as " >
          <text v="Sl đã nhập" e="Pur.Qty"></text>
        </field>
        <field name="id_pn" dataType="N" inactivate="true" hidden="true" format="0" width="80" copy="false">
          <text v="ID PN" e="ID PN"></text>
        </field>
        <field name="so_ct_pn" width="100" fieldType="EX"  hidden="true" copy="false" readOnly="true" inactivate="true" link="m63|id_pn as id" aliasName="cast('' as nvarchar(3000)) as ">
          <text v="Số PN" e="Issue No"></text>
        </field>
        <field name="line_pn" dataType="I" width="70"  hidden="true" copy="false" inactivate="true">
          <text v="Dòng pn" e="Issue Line"></text>
        </field>
        <field name="id_dh" dataType="N" inactivate="true" hidden="true" format="0" width="80" copy="false">
          <text v="ID ĐH" e="ID ĐH"></text>
        </field>
        <field name="so_ct_dh" width="100" fieldType="EX" copy="false"  hidden="true" readOnly="true" inactivate="true" link="s61|id_dh as id" aliasName="cast('' as nvarchar(3000)) as ">
          <text v="Số đơn hàng" e="Order No."></text>
        </field>
        <field name="line_dh" dataType="I" width="70"  hidden="true" copy="false" inactivate="true">
          <text v="Dòng ĐH" e="SO Line"></text>
        </field>
      </fields>

