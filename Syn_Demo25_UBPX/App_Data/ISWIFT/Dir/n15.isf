<dir id="n15" table="n15" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="RB1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Đăng ký ngày công" e="Timekeeping"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		
		<field name="ma_nv" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false" tabIndex="1">
          <text v="Mã nhân viên" e="Employee Staff"></text>
          <viewInfo lookupType="One" lookupId="dmnv" lookupKey="xstatus = 5" lookupCheck="1=1" lookupRef="ten_nv" lookupInfo="dmnv|ma_nv|ten_nv" />
        </field>
        <field name="ten_nv" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
		<field name="ngay_hl"  label="1" field="1" dataType="D" valueDefault="new Date()" allowBlank="false" nextRow="false" >
			<text v="Ngày từ/ đến:" e="Effective date"></text>
		</field>	
		<field name="ngay_hld" label="" field="1" dataType="D" allowBlank="false" nextRow="false" >
			<text v="" e=""></text>
		</field>
		
		<field name="ma_loainghi" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false" tabIndex="1">
          <text v="Mã loại nghỉ" e="Employee Staff"></text>
          <viewInfo lookupType="One" lookupId="dmloainghi" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_loainghi" lookupInfo="dmloainghi|ma_loainghi|ten_loainghi" />
        </field>
        <field name="ten_loainghi" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>

		
		<field name="ma_ca" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false" tabIndex="1">
          <text v="Mã ca" e="Employee Staff"></text>
          <viewInfo lookupType="One" lookupId="dmcalv" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_ca" lookupInfo="dmcalv|ma_ca|ten_ca" />
        </field>
        <field name="ten_ca" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
		<field name="so_gio" dataType="N" format="FCAmount" allowBlank="false" label="1" field="1" readOnly="false" >
          <text v="Số giờ" e="Quantity"></text>
        </field>
		
		<field name="dien_giai" label="1" field="-">
		  <text v="Ghi chú" e="Note"></text>
		</field>
      </fields>
    </form>
	
	<form gravity="TopRight" columns="120,120" >
		<fields>
        &VoucherRequiredFields03;
		&VoucherRequiredFields02;
		</fields>
    </form>
	
	
</forms>

