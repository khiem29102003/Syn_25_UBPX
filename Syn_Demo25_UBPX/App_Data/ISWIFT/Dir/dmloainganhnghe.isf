<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmloainganhnghe" table="dmloainganhnghe" fieldKey="ma_loai" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục loại ngành nghề" e="Occupation Category List"></title>
  <title0 v="Thêm mới - loại ngành nghề" e="New - Occupation Category"></title0>
  <title1 v="Sửa - loại ngành nghề" e="Edit - Occupation Category"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120" >
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_loai" label="1" field="1" allowBlank="false" format="U" disabled="false" fieldType="PK" importable="5" >
				<text v="Mã loại ngành nghề" e="Occupation Category Code"></text>
			</field>
			<field name="ten_loai" label="1" field="-" allowBlank="false" disabled="false" importable="10">
			  <text v="Tên loại ngành nghề" e="Occupation Category Name"></text>
			</field>
			<field name="ten_loai2" label="1" field="-" allowBlank="true" disabled="false" importable="15">
			  <text v="Tên tiếng anh" e="English Name"></text>
			</field>
			<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
</forms>

&DefaultButton;

