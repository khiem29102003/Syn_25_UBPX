  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã khu vực đã tổn tại." e="Code area already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã khu vực đã tổn tại." e="Code area already exists."/>
    </message>
  </messages>
</dir>