<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmbp" table="dmbp" fieldKey="ma_bp,ma_pb" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bộ phận" e="List of Subunit"></title>
  <title0 v="Thêm mới" e="Create New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
	  	<field name="ma_pb" viewType="Lookup" label="1" field="1" fieldType="PK" importable="5">
          <text v="Phòng ban" e="Department"></text>
          <viewInfo lookupType="One" lookupId="dmpb" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_pb" lookupInfo="dmpb|ma_pb|ten_pb" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_pb" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>		
        <field name="ma_bp" format="U" label="1" field="1" allowBlank="false" fieldType="PK" importable="10" >
          <text v="Mã bộ phận" e="Subunit Code"></text>
        </field>
        <field name="ten_bp" label="1" field="-" allowBlank="false" importable="15" >
          <text v="Tên bộ phận" e="Subunit Name"></text>
        </field>
        <field name="ten_bp2" label="1" field="-" importable="20">
          <text v="Tên khác" e="Other Name"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" valueDefault="1" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmbp(p){
  this.constructor(p);
}
dir$dmbp.prototype = new DirEvent();
dir$dmbp.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmbp.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

dir$dmbpDisabledMasterField(p, g);

}

function dir$dmbpDisabledMasterField(p, g){
  
  if(p.options.action == 'EDIT')
  {
    p.setDisabled(['ma_bp','ma_pb'], true);
  }
  else
  {
    p.setDisabled(['ma_bp','ma_pb'], false);
  }
}
         ]]>
    </text>
  </js>
  <css>
	<text>
	  <![CDATA[
		.control-label.ma_pb, .control-label.ma_bp, .control-label.ten_bp
		{	
			//font-weight:bold;	
			color: #499b98;;
		}
	  ]]>
	</text>
  </css>
  
  <script>
	<importing>
      <text>
        <![CDATA[
		@@insert
        ]]>
      </text>
    </importing>
  </script>
  
  <messages>
	<message val="codeExistsNewMsg">
		<text v="Mã bộ phận và phòng ban đã cùng tồn tại trong danh mục, vui lòng chọn một mã khác." e="The department and subunit codes already exist in the catalog, please select a different code."/>
	</message>
	<message val="codeExistsEditMsg">
		<text v="Mã bộ phận và phòng ban đã cùng tồn tại trong danh mục, vui lòng chọn một mã khác." e="The department and subunit codes already exist in the catalog, please select a different code."/>
	</message>
  </messages>

</dir>