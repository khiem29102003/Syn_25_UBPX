<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmngaycong" table="dmngaycong" fieldKey="ma_ngaycong" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách ngày công" e="List of workday"></title>
  <title0 v="Thêm mới - ngày công" e="New - cirulated"></title0>
  <title1 v="Sửa - ngày công" e="Edit - cirulated"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120" >
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_ngaycong" label="[120]" field="[120]" allowBlank="false" format="U" disabled="false" fieldType="PK" importable="5" >
				<text v="Mã ngày công" e="Workday Code"></text>
			</field>
			<field name="ten_ngaycong" label="[120]" field="-" allowBlank="false" disabled="false" importable="10">
			  <text v="Tên ngày công" e="Workday Name"></text>
			</field>
			<field name="ten_ngaycong2" label="[120]" field="-" allowBlank="true" disabled="false" importable="15">
			  <text v="Tên tiếng anh" e="English Name"></text>
			</field>
      </fields>
    </form>
	
	<form tabPageIndex="1" gravity="MiddleLeft" height="250" columns="120,120,120,120,120" >
		<text v="Thông tin chi tiết" e="Infor Detail"></text>
		<fields>
			<field name="he_so" format="Qty" dataType="N" label="[120]" field="[120]">
			  <text v="Hệ số" e="Word symbol"></text>
			</field>
			<field name="ma_loaingaycong" format="U" viewType="Lookup" label="1" field="1" clientDefault="true" allowBlank="true" importable="95">
			  <text v="Mã loại ngày công" e="Workday Type Code"></text>
			  <viewInfo lookupType="One" lookupId="dmloaingaycong" lookupKey="status=1 " lookupCheck="1=1" lookupRef="ten_loaingaycong" lookupInfo="dmloaingaycong|ma_loaingaycong|ten_loaingaycong" importCheck="@@DF and z.status=1"/>
			</field>
			<field name="ten_loaingaycong" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ghi_chu" label="[120]" field="-" rows="2">
			  <text v="Ghi chú" e="Note"></text>
			</field>
			<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				</options>
			  </viewInfo>
			</field>
		</fields>
    </form>
</forms>

&DefaultButton;

<js>
    <text>
  <![CDATA[
function dir$dmngaycong(p){
  this.constructor(p);
}
dir$dmngaycong.prototype = new DirEvent();
dir$dmngaycong.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmngaycong.prototype.afterInit = function(renderType){
  var p = this._dir;

dir$dmngaycongDisabledMasterField(p);

}

function dir$dmngaycongDisabledMasterField(p){
var maPl = p.valForm('ma_ngaycong');
	if(maPl) {
		p.setDisabled('ma_ngaycong', true);
	} else {
		p.setDisabled('ma_ngaycong', false);
	}
}
         ]]>
    </text>
  </js>
	<css>
		<text>
			  <![CDATA[
.modal-dialog-lg{min-width:720px!important;}
.control-label.tt {color: #499b98; text-decoration: underline}
.control-label.ma_ngaycong, .control-label.he_so {color: #499b98;}
			  ]]>
		</text>
	</css>
	<script>
		<query>
		  <text>
			<![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table
drop table #@@table
			 ]]>
		  </text>
		</query>
		<updated>
		  <text>
			<![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]
			 ]]>
		  </text>
		</updated>
		<inserting>
		  <text>
			<![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
			]]>
		  </text>
		</inserting>
		<importing>
			<text>
			<![CDATA[
update #data set unit_id = @@unit
@@insert
			]]>
			</text>
		</importing>
	</script>
	<messages>
		<message val="codeExistsNewMsg">
		  <text v="Mã ngày công đã tồn tại trong danh mục." e="The circulation document code already exists in the list."/>
		</message>
	</messages>
</dir>
