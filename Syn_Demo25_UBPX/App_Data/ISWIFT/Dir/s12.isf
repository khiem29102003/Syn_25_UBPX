  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from s12 where id = @id and status in (5)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="s12" table="s12" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="YG2" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Yêu cầu báo giá hàng biển LCL" e="Request LCL Marine Quote"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
		<field name="ma_noi_di" viewType="Lookup" label="1" field="1" allowBlank="false">
			<text v="Nơi đi" e="Origin"></text>
			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="(kkh_yn = 1 or hc_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
		</field>
		<field name="ten_noi_di" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="[150]"  aliasName="cast('' as nvarchar(4000)) as ">
			<text v="" e=""></text>
		</field> 	
		<field name="ma_dk_gh" viewType="Combobox" valueDefault="" label="[120]" field="[70]" nextRow="false" >
			<text v="Điều kiện giao hàng" e="Traffic term"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'DK' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>
		<field name="ma_noi_den" viewType="Lookup" label="1" field="1" allowBlank="false ">
			<text v="Nơi đến" e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="(kkh_yn = 1 or hc_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_den" lookupInfo="vdmcangden|ma_noi_den|ten_noi_den"/>
		</field>
		<field name="ten_noi_den" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="[150]" aliasName="cast('' as nvarchar(200)) as ">
			<text v="" e=""></text>
		</field> 
		<field name="ma_dk_nh" viewType="Combobox" valueDefault="" label="[120]" field="[70]" nextRow="false">
			<text v="Điều kiện nhận hàng" e="Traffic term"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'DK' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>
				
		<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" >
			<text v="Ngày hiệu lực " e="Effective date"></text>
		</field>
		<field name="di_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
			<text v="" e=""></text>
		</field>
				
		<field name="ngay_hld" label="[100]" field="[100]" dataType="D" allowBlank="false" nextRow="false" >
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>
		<field name="dien_giai" label="1" rows="1" field="-">
			<text v="Diễn giải" e="Explain"></text>
		</field>
		<field name="tt" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="[140]" field="0">
          <text v="Thông tin khách hàng " e="Customer Information: "></text>
        </field>
		<field name="ma_gd" viewType="Combobox" valueDefault="" hidden="false" nextRow="false" label="" field="[180]" >
          <text v="" e=""></text>
          <viewInfo>
            <options query="select ma_gd, ten_gd%l from dmgd where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
		<field name="ma_so_thue" label="1" field="1"  importable="35" nextRow="true" allowBlank="true">
          <text v="Mã số thuế &lt;a onclick='getTax(this);'&gt;(Kiểm tra)&lt;/a&gt;" e="Tax Code &lt;a onclick='getTax(this);'&gt;(Test)&lt;/a&gt;"></text>
        </field>

		<field name="ma_kh" allowBlank="true" nextRow="false" viewType="Lookup" blank ="[80]" label="[100]" field="-"   hidden="false">
          <text v="Mã khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" />
        </field>
		<field name="ten_kh" allowBlank="true" label="1" field="-" importWidth="250" importable="10">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
        <field name="ten_kh2" label="1" field="-" importWidth="250"  importable="15">
          <text v="Tên quốc tế" e="International Name"></text>
        </field>
		<field name="nguoi_lh" label="1" field="[200]" importable="40" nextRow="true">
          <text v="Người liên hệ" e="Contact Person"></text>
        </field>
		<field name="email" label="[100]" field="-"  importable="80" nextRow="false"  allowBlank="true">
          <text v="Email" e="Email"></text>
        </field>

		<field name="dia_chi" label="1" field="[200]" importWidth="250" importable="30">
          <text v="Địa chỉ" e="Address"></text>
        </field>	
		<field name="dien_thoai" label="[100]" field="-" importable="80" allowBlank="false" nextRow="false">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="cvc_yn" dataType="B" clientDefault="true" label="[80]" field="[40]" nextRow="true" valueDefault="1"  inactivate="true">
          <text v="Cước v/c" e="Freight Y/N?"></text>
        </field>
		<field name="xk_yn" dataType="B" clientDefault="true" label="[80]" field="[40]" nextRow="false" valueDefault="1"  inactivate="true">
          <text v="Xuất khẩu" e="Export Y/N?"></text>
        </field>
		<field name="nk_yn" dataType="B" clientDefault="true" label="[80]" field="[40]" nextRow="false" valueDefault="1"  inactivate="true">
          <text v="Nhập khẩu" e="Import Y/N?"></text>
        </field>
		<field name="pp_yn" dataType="B" clientDefault="true" label="[80]" field="[40]" nextRow="false" valueDefault="1"  inactivate="true">
          <text v="Phụ phí" e="Surcharge Y/N?"></text>
        </field>
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
      </fields>
    </form>

   
    <form tabPageIndex="1" gravity="MiddleLeft" height="300" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="v12" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>
	
	<form tabPageIndex="2" gravity="MiddleLeft" height="300" columns="120,120,240" >
      <text v="Services Log" e="Services Log"></text>
      <fields>
        <field name="v121" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Services Log" e="Services Log"></text>
        </field>
      </fields>
    </form>
	
   
	<form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Khác" e="Other"></text>
      <fields>
        <field name="ma_nvbh" clientDefault="true" viewType="Lookup" label="1" field="1" setype="1">
          <text v="Mã nhân viên" e="Sale"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nvbh" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" />
        </field>
        <field name="ten_nvbh" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptvc" viewType="Lookup" label="1" field="1">
          <text v="Phương tiện v/c" e="Transportation"></text>
          <viewInfo lookupType="One" lookupId="dmptvc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptvc" lookupInfo="dmptvc|ma_ptvc|ten_ptvc" />
        </field>
        <field name="ten_ptvc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_pttt" viewType="Lookup" label="1" field="1">
          <text v="Ph/th thanh toán" e="Payment Methods"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptgh" viewType="Lookup" label="1" field="1">
          <text v="Ph/th giao hàng" e="Delivery Methods"></text>
          <viewInfo lookupType="One" lookupId="dmptgh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptgh" lookupInfo="dmptgh|ma_ptgh|ten_ptgh" />
        </field>
        <field name="ten_ptgh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
		<field name="t_ck_nt" label="1" field="1" dataType="N" disabled="true" hidden="true" format="FCAmount" >
          <text v="Tổng chiết khấu" e="Total Tax"></text>
        </field>
        <field name="t_ck" label="" field="1" nextRow="false" disabled="true" dataType="N" hidden="true" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_tc_tien_nt2" label="1" field="1" fieldType="EX" dataType="N" hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng tiền hàng" e="Total Tax"></text>
        </field>
        <field name="t_tc_tien2" label="" field="1" nextRow="false" disabled="true" fieldType="EX" hidden="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_km_nt" label="1" field="1" fieldType="EX" dataType="N" disabled="true" hidden="true" format="FCAmount" >
          <text v="Tổng tiền KM" e="Total Tax"></text>
        </field>
        <field name="t_km" label="" field="1" nextRow="false" disabled="true" fieldType="EX" dataType="N" hidden="true" format="Amount" >
          <text v="" e=""></text>
        </field>
			
      </fields>
    </form>

     
    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="YG2" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="120,120,120,120,120,120" >
      <fields>
        <field name="t_so_luong" label="1" field="1" dataType="N" disabled="true" format="Amount" >
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
	
		<field name="t_tong_trong" label="1" field="1" dataType="N" disabled="true" nextRow="false" format="FCAmount" >
          <text v="Tổng trọng lượng" e="Total Weight"></text>
        </field>
		
		<field name="t_tong_khoi" label="1" field="1" dataType="N" disabled="true" nextRow="false" format="FCAmount" >
          <text v="Tổng Volume" e="Total Volume"></text>
        </field>
		
        <field name="t_tien_nt2" label="1" field="1"  hidden="true" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
        <field name="t_tien2" nextRow="false" label="" field="1" hidden="true" disabled="true" dataType="N" format="Amount" >
          <text v="" e="Total Amount"></text>
        </field>
        <field name="t_thue_nt" blank="2" label="1" field="1" dataType="N" hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thuế" e="Total Tax"></text>
        </field>
        <field name="t_thue" label="" field="1" nextRow="false" disabled="true" hidden="true" dataType="N" format="Amount" >
          <text v="" e="Total Tax"></text>
        </field>
        <field name="t_tt_nt" nextRow="false" label="1" field="1" dataType="N"  hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thanh toán" e="Total Amount"></text>
        </field>
        <field name="t_tt" label="" field="1" nextRow="false" disabled="true" hidden="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>
 <grids>
    <grid id="v12" table="v12" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
		<field name="ma_kien" width="100" allowBlank="false" viewType="Lookup" readOnly="false" hidden="false"  >
          <text v="Mã kiện" e="Package Code"></text>
          <viewInfo lookupType="One" lookupId="dmkien" lookupKey="status=1 and ma_loai = 2" lookupCheck="1=1" lookupRef="ten_kien" lookupInfo="dmkien|ma_kien|ten_kien" />
        </field>
        <field name="ten_kien" width="150" fieldType="EX" inactivate="true" readOnly="true" aliasName="k" join=" left join dmkien k on a.ma_kien = k.ma_kien " hidden="false" >
          <text v="Tên kiện" e="Package Name"></text>
        </field>	
         <field name="so_luong" dataType="N" format="fCAmount" allowBlank="false" valueDefault="1" width="100" readOnly="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
		 <field name="ty_trong" dataType="N" format="FCPrice" width="120" readOnly="false" >
          <text v="Trọng lượng(KGS)" e="Gross Weight(KGS)"></text>
        </field>
		 <field name="tong_trong" dataType="N" inactivate="true" format="FCPrice" width="120" readOnly="false" >
          <text v="Tổng trọng lượng (KGS)" e="Total Gross Weight(KGS)"></text>
        </field>
		<field name="ty_khoi" dataType="N" format="FCPrice" width="120" readOnly="false" >
          <text v="Volume(CBM)" e="Volume(CBM)"></text>
        </field>
		<field name="tong_khoi" dataType="N" inactivate="true" format="FCPrice" width="120" readOnly="false"  >
          <text v="Tổng Volume" e="Total Volume"></text>
        </field>
		<field name="ma_nhomhang" width="100" viewType="Combobox" inactivate="true" readOnly="false" >
			<text v="Nhóm hàng" e="Traffic term"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'NH' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>
		<field name="tt_imo" width="150" readOnly="false" >
          <text v="Thông tin IMO" e="IMO Information"></text>
        </field>
		<field name="so_un" width="150" readOnly="false" >
          <text v="Số UN" e="Quantity"></text>
        </field>			
       
        <field name="ct_km" width="100" valueDefault="0" viewType="Combobox" inactivate="true" hidden="true" readOnly="false" >
          <text v="Loại hàng" e="Container Type"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Hàng bán" e="Sale"/>
              </option>
              <option val="1">
                <text v="Hàng KM" e="Promotion"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="gia_nt1" dataType="N" inactivate="true" hidden="true" format="FCPrice" width="100" readOnly="true" >
          <text v="Giá chuẩn %s" e="%s Std.Price"></text>
        </field>
        <field name="gia_nt2" dataType="N" format="FCPrice" width="100" hidden="true"  readOnly="false" >
          <text v="Giá bán %s" e="%s Price"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="FCAmount" width="100" hidden="true"  readOnly="false" >
          <text v="Doanh số %s" e="%s Amount"></text>
        </field>
        <field name="tl_ck" dataType="N" format="Rate" width="100" hidden="true" readOnly="false" >
          <text v="Tl ck(%)" e="Dis.Rate"></text>
        </field>
        <field name="ck_nt" dataType="N" format="FCAmount" width="100" hidden="true" readOnly="false" clientDefault="true" >
          <text v="Ch.khấu %s" e="%s Discount"></text>
        </field>
        <field name="thue_suat" dataType="N" format="0" width="100" readOnly="false" hidden="true" clientDefault="true" >
          <text v="Thuế suất(%)" e="Tax"></text>
        </field>
        <field name="thue_nt" dataType="N" format="FCAmount" width="100" hidden="true" readOnly="false">
          <text v="Thuế %s" e="%s Tax"></text>
        </field>
        <field name="gia1" dataType="N" format="Price" width="100" hidden="true" inactivate="true" readOnly="true" >
          <text v="Giá chuẩn" e="Std.Price"></text>
        </field>
        <field name="gia2" dataType="N" format="Price" width="100" inactivate="true" readOnly="false" >
          <text v="Giá bán" e="Price"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100" inactivate="true" readOnly="false" >
          <text v="Thành tiền" e="Amount"></text>
        </field>
        <field name="ck" dataType="N" format="Amount" width="100" inactivate="true" hidden="true" readOnly="false">
          <text v="Chiết khấu" e="Discount"></text>
        </field>
        <field name="thue" dataType="N" format="Amount" width="100" inactivate="true" hidden="true" readOnly="false">
          <text v="Thuế" e="Tax"></text>
        </field>
		
		<field name="dien_giai" width="300" inactivate="false" readOnly="false" >
		  <text v="Mô tả hàng hóa" e="Goods description"></text>
		</field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc>+xmpUohYLUbzcDztN+joosjRFFOciJwMySqmsyLzJw67z6X4mtehuKyoITA3AKUBAe15joLc6/WcSJxaKTjXX2Qw610VC3KiiDX9N1yTtyqnM3xP1HtITpve+caVJJeJJegAFspeoWo3fXX8SMkt629713KWg4TiMPiCAPYWzBc=</enc>]]>
          </text>
        </query>
      </script>

    </grid>
	<grid id="v121" table="v121" fieldKey="id, line" order="line" allowFilter="true" allowOrder="true" readOnly="false">
       <fields>
          <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
		 <field name="ma_dv" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã dịch vụ" e="Services Code"></text>
          <viewInfo lookupType="One" lookupId="dmdvlog" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dv" lookupInfo="dmdvlog|ma_dv|ten_dv" />
        </field>
        <field name="ten_dv" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmdvlog b on a.ma_dv = b.ma_dv ">
          <text v="Tên dịch vụ" e="Services Log Name"></text>
        </field>
		<field name="chon_yn" dataType="B" width="80" readOnly="false" >
          <text v="Chọn" e="Check"></text>
        </field>
		<field name="ghi_chu" width="450" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
