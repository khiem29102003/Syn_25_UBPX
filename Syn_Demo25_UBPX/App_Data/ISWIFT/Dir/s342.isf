        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>
    </grid>
	<grid id="v3420" table="v3420" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
		
		<field name="chon_yn" dataType="B" width="80" readOnly="false" hidden="true">
          <text v="Chọn" e="Check"></text>
        </field>
        <field name="ma_noi_di" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã cảng đi" e="Origin Code"></text>
          <viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="status=1 and (hc_yn = 1 or kkh_yn =1)" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
        </field>
        <field name="ten_noi_di" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join vdmcangdi b on a.ma_noi_di = b.ma_noi_di ">
          <text v="Tên cảng đi" e="Origin Name"></text>
        </field>
		
		<field name="dien_giai" width="300" inactivate="true" readOnly="false">
          <text v="Diễn giải" e="Explain"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="retrieve">
          <text v="$RetrieveToolbar" e="$RetrieveToolbar"></text>
          <items>
            <button id="10">
              <text v="Chọn nhiều cảng"  e="Extract info from Request a Quote"/>
            </button>
            <button id="80">
              <text v="-"  e="-"/>
            </button>
            
          </items>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

       <script>
