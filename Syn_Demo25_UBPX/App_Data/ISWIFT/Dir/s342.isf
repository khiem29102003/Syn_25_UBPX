        </field>
        <field name="t_hh" label="" field="1" nextRow="false" disabled="true" dataType="N" hidden="true" format="Amount" >
          <text v="" e=""></text>
        </field>
		
        <field name="t_tc_tien_nt2" label="1" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng phí nơi đi" e="Total Fee"></text>
