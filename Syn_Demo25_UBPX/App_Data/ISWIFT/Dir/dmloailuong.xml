<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmloailuong" table="dmloailuong" fieldKey="ma_luong" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục loại lương" e="List of Salary types"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120" >
      <fields>
        <field name="ma_luong" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã lương" e="Salary code"></text>
        </field>
        <field name="ten_luong" label="1" field="2" allowBlank="false" fieldType="PK" >
          <text v="Loại lương" e="Salary type "></text>
        </field>
        <field name="ten_luong2" label="1" field="2">
          <text v="Loại lương 2" e="Salary type 2"></text>
        </field> 
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmloailuong(p){
  this.constructor(p);
}
dir$dmloailuong.prototype = new DirEvent();
dir$dmloailuong.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã loại lương đã tồn tại' else N'Salary type code already exists' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã loại lương đã tồn tại' else N'Salary type code already exists' end
         ]]>
      </text>
    </declare>
  </script>

</dir>