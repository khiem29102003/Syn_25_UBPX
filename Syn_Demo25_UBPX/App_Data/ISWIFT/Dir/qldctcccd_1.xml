<js>
    <text>
  <![CDATA[
function dir$qldctcccd_1(p){
  this.constructor(p);
}
dir$qldctcccd_1.prototype = new DirEvent();

dir$qldctcccd_1.prototype.afterInit = function(renderType){
var p = this._dir, gParent = p.options.parent;

  
	if (p.options.action == 'NEW') {
		p.valForm('ma_hogiadinh', gParent.options._ma_hogiadinh, true);
		p.valForm('ma_ttp', gParent.options._ma_ttp, true);
		p.valForm('ma_phuongxa', gParent.options._ma_phuongxa, true);
		p.valForm('ma_khupho', gParent.options._ma_khupho, true);
		p.valForm('dia_chi', gParent.options._dia_chi, true);
	}

	
  p.setTitle(['%s', gParent.options._ma_hogiadinh]);
  dir$qldctcccd_1DisabledMasterField(p);
}

function dir$qldctcccd_1DisabledMasterField(p){

}

dir$qldctcccd_1.prototype.formFieldValueChange = function (o, cF, v) {
  var p = this._dir;
  
  switch (cF){
	case 'so_cccd':
		if(p.options.action == "NEW")
		{
			dir$qldctcccd_1CreateCode(p);
		}
		break;
	case 'ngay_cap':
		if(p.options.action == "NEW")
		{
			dir$qldctcccd_1CreateCode(p);
		}
		break;
	case 'thuongtru_yn':
		var element = p.valForm('thuongtru_yn');
		var element2 = p.valForm('tamtru_yn');
		// Xử lý khi điều kiện thỏa mãn
		if (element === 1) {
			p.setDisabled('tamtru_yn', true);
		} else {
			p.setDisabled('tamtru_yn', false);
		}
		break;
    case 'tamtru_yn':
		var element = p.valForm('tamtru_yn');
		
		// Xử lý khi điều kiện thỏa mãn
		if (element === 1) {
			p.setDisabled('thuongtru_yn', true);
		} else {
			p.setDisabled('thuongtru_yn', false);
		}
		break;
	default:
      break;
	}
}

function dir$qldctcccd_1CreateCode(p) {
	var ngayCap = p.valForm('ngay_cap'), soCCCD = p.valForm('so_cccd');
	
	const date = new Date(ngayCap);
	const yyyy = date.getFullYear();
	const mm = String(date.getMonth() + 1).padStart(2, '0'); // Tháng bắt đầu từ 0
	const dd = String(date.getDate()).padStart(2, '0');
	const formattedDate = `${yyyy}${mm}${dd}`;
	return p.valForm('ma_dancu', `MDC${formattedDate}${soCCCD}`, true);
	
}
         ]]>
    </text>
  </js>
