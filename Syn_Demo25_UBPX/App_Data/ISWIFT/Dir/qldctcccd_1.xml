	<script>
		<query>
		  <text>
			<![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table
drop table #@@table
			 ]]>
		  </text>
		</query>
		<updated>
		  <text>
			<![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]
			 ]]>
		  </text>
		</updated>
		<inserting>
		  <text>
			<![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
			]]>
		  </text>
		</inserting>
		<aftersave>
			<![CDATA[
IF EXISTS (SELECT 1 FROM dmhogiadinh WHERE ma_hogiadinh = @ma_hogiadinh and @ma_qhgd = '03')
BEGIN
	UPDATE dmhogiadinh set ma_chuho = @ma_dancu WHERE ma_hogiadinh = @ma_hogiadinh
END
			]]>
		</aftersave>
		<importing>
			<text>
			<![CDATA[
update #data set unit_id = @@unit
@@insert
			]]>
			</text>
		</importing>
	</script>
	<messages>
		<message val="codeExistsNewMsg">
		  <text v="Mã văn bản lưu hành đã tồn tại trong danh mục." e="The circulation document code already exists in the list."/>
		</message>
	</messages>
