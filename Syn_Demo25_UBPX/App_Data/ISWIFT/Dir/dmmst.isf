  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã khách hàng đã tồn tại trong danh mục khách hàng." e="The record already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã khách hàng đã tồn tại trong danh mục khách hàng." e="The record already exists."/>
    </message>
    <message val="taxtCodeExists">
