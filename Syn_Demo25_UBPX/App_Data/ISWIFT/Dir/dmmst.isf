<dir id="dmmst" table="dmmst" fieldKey="ma_so_thue" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục mã số thuế" e="List of customer"></title>
  <title0 v="Thêm" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
	    <field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
          <text v="" e=""></text>
        </field>
		<field name="ma_so_thue" label="1" field="2"  importable="35" fieldType="PK" allowBlank="false">
          <text v="Mã số thuế &lt;a onclick='getTax(this);'&gt;(Kiểm tra)&lt;/a&gt;" e="Tax code &lt;a onclick='getTax(this);'&gt;(Test)&lt;/a&gt;"></text>
        </field>
        <field name="ten_kh" label="1" field="-" importWidth="250" importable="15">
          <text v="Tên khách hàng" e="Other name"></text>
        </field>			
        <field name="dia_chi" label="1" field="-" importWidth="250" importable="30">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="ngay_sinh" label="1" dataType="D" field="1" nextRow="true" importable="40">
          <text v="Ngày sinh" e="Contact"></text>
        </field>
        <field name="nguoi_lh" label="1" field="-" nextRow="false" importable="40">
          <text v="Người đại diện" e="Contact"></text>
        </field>
        <field name="dien_thoai" label="1" field="2" importable="80">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="email" label="1" field="2" importable="80">
          <text v="Email" e="Phone"></text>
        </field>
		<field name="ngay_hoat_dong" label="1" dataType="D" field="1" nextRow="false" importable="40">
          <text v="Ngày hoạt động" e="Contact"></text>
        </field>
		<field name="noi_ql" label="1" field="2" importable="80">
          <text v="Quản lý bởi" e="Phone"></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

