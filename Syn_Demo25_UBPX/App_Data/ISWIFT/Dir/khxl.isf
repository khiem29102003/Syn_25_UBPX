    </message>
	<message val="copypaste">
      <text v="Đã sao chép " e="Copied "/>
    </message>
	<message val="tdnull">
      <text v="Dữ liệu rỗng" e="Null"/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã hợp đồng đã tồn tại trong hợp đồng." e="The record already exists."/>
    </message>
    <message val="taxtCodeExists">
      <text v="Mã số thuế đã tồn tại trong danh mục, &lt;span class='Highlight'&gt;Lưu ý:&lt;/span&gt; hệ thống vẫn lưu dữ liệu vừa cập nhật." e="The tax code is already exists, &lt;span class='Highlight'&gt;Warning:&lt;/span&gt; Updated data has been saved."/>
    </message>
	<message val="OnLyEdit">
      <text v="Chỉ thực hiện chức này ở trạng thái sửa." e="Perform this function only in the edited state."/>
    </message>
	<message val="Empty">
      <text v="Ô này trống không có số điện thoại." e="This box is empty without a phone number."/>
    </message>
	<message val="Empty1">
      <text v="Nhập CP bắt buộc chọn Lý do" e="Enter the required CP, select Reason"/>
    </message>
	<message val="NotAllow">
