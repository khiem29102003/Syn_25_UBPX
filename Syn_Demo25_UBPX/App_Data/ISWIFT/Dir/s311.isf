<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields03.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields04.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from s311 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="s311" table="s311" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="BN1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Cước vận chuyển quốc tế hàng biển FCL" e="FCL International Sea Freight"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
		<field name="ma_kh"  viewType="Lookup" label="1" field="1" allowBlank="false" importable="1">
          <text v="Hãng tàu/ Đại lý" e="Carrier/ Agent Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="(ncc_yn = 1 or dl_yn = 1) and status = 1 " lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
		<field name="ma_noi_di" viewType="Lookup" label="1" field="1" allowBlank="false" importable="5">
			<text v="Nơi đi" e="Origin"></text>
			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="(hc_yn = 1 or kkh_yn =1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
		</field>
		<field name="ten_noi_di" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-"  aliasName="cast('' as nvarchar(4000)) as ">
			<text v="" e=""></text>
		</field> 					
		
		<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" importable="10" >
			<text v="Ngày hiệu lực " e="Effective date"></text>
		</field>
		<field name="di_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
			<text v="" e=""></text>
		</field>
				
		<field name="ngay_hld" label="[100]" field="[120]" dataType="D" allowBlank="false" nextRow="false" importable="15" >
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>
		
		<field name="ds_cong" allowBlank="true" viewType="Lookup" label="1" field="-"  hidden="false" importable="20">
			<text v="Container" e="Container List"></text>
			<viewInfo lookupType="Multi" lookupId="dmcong2" lookupKey="status=1" lookupCheck="status=1" lookupRef="" lookupInfo="dmcong|ma_cong|ten_cong" />
		</field>						
		<field name="dien_giai" label="1" rows="1" field="-" importable="25" >
		  <text v="Diễn giải" e="Explain"></text>
		</field>
			
		<field name="ma_phi" allowBlank="false" viewType="Lookup" label="1" field="1" hidden="false" importable="30">
		  <text v="Loại cước/ Phí" e="Freight/ Fee"></text>
		  <viewInfo lookupType="One" lookupId="dmphi" lookupKey="status = 1 and ma_phi = 'OF' " lookupCheck="1=1" lookupRef="ten_phi2" lookupInfo="dmphi|ma_phi|ten_phi2" />
		</field>
		<field name="ten_phi2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(200)) as ">
		  <text v="" e=""></text>
		</field>


	
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
      </fields>
    </form>

   
    <form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="v311" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>
	
 

    <form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Khác" e="Other"></text>
      <fields>
        <field name="ma_nvbh" clientDefault="true" viewType="Lookup" label="1" field="1" setype="1" importable="40" >
          <text v="Mã nhân viên" e="Sale"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nvbh" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" />
        </field>
        <field name="ten_nvbh" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptvc" viewType="Lookup" label="1" field="1" importable="45" >
          <text v="Phương tiện v/c" e="Transportation"></text>
          <viewInfo lookupType="One" lookupId="dmptvc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptvc" lookupInfo="dmptvc|ma_ptvc|ten_ptvc" />
        </field>
        <field name="ten_ptvc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_pttt" viewType="Lookup" label="1" field="1" importable="50" >
          <text v="Ph/th thanh toán" e="Payment Methods"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptgh" viewType="Lookup" label="1" field="1" importable="55" >
          <text v="Ph/th giao hàng" e="Delivery Methods"></text>
          <viewInfo lookupType="One" lookupId="dmptgh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptgh" lookupInfo="dmptgh|ma_ptgh|ten_ptgh" />
        </field>
        <field name="ten_ptgh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>

		

		
        <field name="t_tc_tien_nt2" label="1" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền phí" e="Total Fee"></text>
        </field>
        <field name="t_tc_tien2" label="" field="1" nextRow="false" disabled="true" fieldType="EX" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>

			
      </fields>
    </form>

   
    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="BN1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="120,120,120,120,120" >
      <fields>
        <field name="t_so_luong" label="1" field="1" dataType="N" disabled="true" hidden="true" format="Amount" >
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
        <field name="t_tien_nt2" nextRow="true" label="1" field="1" dataType="N" hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
        <field name="t_tien2" nextRow="false" label="" field="1" hidden="true" disabled="true" dataType="N" format="Amount" >
          <text v="" e="Total Amount"></text>
        </field>
        <field name="t_thue_nt" blank="2" label="1" field="1" dataType="N" hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thuế" e="Total Tax"></text>
        </field>
        <field name="t_thue" label="" field="1" nextRow="false" disabled="true" hidden="true" dataType="N" format="Amount" >
          <text v="" e="Total Tax"></text>
        </field>
        <field name="t_tt_nt" nextRow="false" label="1" field="1" dataType="N"  hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thanh toán" e="Total Amount"></text>
        </field>
        <field name="t_tt" label="" field="1" nextRow="false" disabled="true" hidden="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="v311" table="v311" fieldKey="id, line" order="line" readOnly="false">
      <fields>


        <field name="ma_noi_den" width="100" viewType="Lookup" readOnly="false" allowBlank="false" importable="70" >
          <text v="Nơi đến " e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="(hc_yn = 1 or kkh_yn =1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_den" lookupInfo="vdmcangden|ma_noi_den|ten_noi_den" />
        </field>
        <field name="ten_noi_den" width="200" fieldType="EX" inactivate="true" readOnly="true" aliasName="b.ten_noi_den " join=" left join vdmcangden b on a.ma_noi_den = b.ma_noi_den ">
          <text v=" Tên nơi đến" e="Destination"></text>
        </field>	
      	
		
		<field name="ds_ngay" allowBlank="true" viewType="Lookup" width="120" readOnly="false" importable="75" >
          <text v="Lịch vận chuyển" e="Schedule Days"></text>
          <viewInfo lookupType="Multi" lookupId="dmbgn" lookupKey="status=1 and ma_ct ='DIW'" lookupCheck="status=1" lookupRef="" lookupInfo="dmbgn|ma_bgn|ten_bgn" />
        </field>
		
		<field name="so_ngay_vc" dataType="N" format="Amount" hidden="false" width="80" readOnly="false" importable="80" >
          <text v="Số ngày vc" e="Transit time"></text>
        </field>			
				
		<field name="ma_dk_vc" viewType="Combobox" valueDefault="1" width="150" readOnly="false" importable="85">
			<text v="Đi thẳng/Chuyển tải" e="Direct / Transit"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'VT' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>	

		<field name="gia_20GP" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="90" >
          <text v="20'GP %s" e="20'GP %s"></text>
        </field>
		
		<field name="gia_40GP" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="95" >
          <text v="40'GP %s" e="40'GP %s"></text>
        </field>
		 <field name="gia_40HQ" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="100" >
          <text v="40'HQ %s" e="40'HQ %s"></text>
        </field>		
		<field name="gia_45HQ" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="105" >
          <text v="45'HQ %s" e="45'HQ %s"></text>
        </field>		
		<field name="gia_20RF" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="110" >
          <text v="20'RF %s" e="20'RF %s"></text>
        </field>	
		<field name="gia_40RF" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="115" >
          <text v="40'RF %s" e="40'RF %s"></text>
        </field>	
		
		
		<field name="gia_20OT" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="120" >
          <text v="20'OT %s" e="20'OT %s"></text>
        </field>		
		
		
		<field name="gia_40OT" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="125" >
          <text v="40'OT %s" e="40'OT %s"></text>
        </field>
		
		
		<field name="gia_40HOT" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="130" >
          <text v="40'OT HQ %s" e="40'OT HQ %s"></text>
        </field>
		
		
		<field name="gia_20FL" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="135" >
          <text v="20'FL %s" e="20'FL %s"></text>
        </field>
		
		
		<field name="gia_40FL" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="140" >
          <text v="40'FL %s" e="40'FL %s"></text>
        </field>
		
		
		 <field name="gia_40HFL" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="145" >
          <text v="40'FL HQ %s" e="40'FL HQ %s"></text>
        </field>
		
		
		
		<field name="gia_20TK" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="150" >
          <text v="20'TK %s" e="20'TK %s"></text>
        </field>
		
		
		<field name="gia_40TK" dataType="N" inactivate="false" format="FCPrice" width="120" readOnly="false" importable="155" >
          <text v="40'TK %s" e="40'TK %s"></text>
        </field>
		<field name="dien_giai" width="300" inactivate="false" readOnly="false" importable="160">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
      </fields>

	  <buttons>
	    <button id="add">
	  	  <text v="$AddToolbar" e="$AddToobar"></text>
	    </button>
	    <button id="delete">
		  <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
	    </button>
	    <button id="copy">
	  	  <text v="$CopyToolbar" e="$CopyToolbar"></text>
	    </button>
	    <button id="paste">
		  <text v="$PasteToolbar" e="$PasteToolbar"></text>
	    </button>
	    <button id="moveup">
		  <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
	    </button>
	    <button id="movedown">
		  <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
	    </button>
	    <button id="split">
	   	 <text v="-" e="-"></text>
	    </button>
	    <button id="freeze">
	  	  <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
	    </button>
	  </buttons>

      <script>
        <query>
          <text>
