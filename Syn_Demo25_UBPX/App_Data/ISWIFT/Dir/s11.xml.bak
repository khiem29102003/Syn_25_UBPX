  <script>
    &VoucherRequest;
    &VoucherSaleRequest;
		<request code="ma_kh_request">
			<text>
			  <![CDATA[
				select top 1 a.nguoi_lh as [!nguoi_lh],a.ma_so_thue as [!ma_so_thue], a.ten_kh as [!ten_kh],a.ten_kh2 as [!ten_kh2], a.dia_chi as [!dia_chi], a.dien_thoai as [!dien_thoai]
				from dmkh a where a.ma_kh = @ma_kh
				]]>
			</text>
		  </request>
    
		<request code="ma_dk_ngay">
			<text>
			  <![CDATA[
				  select @t2_yn = 1,@t3_yn = 1,@t4_yn = 1,@t5_yn = 1,@t6_yn = 1,@t7_yn = 1,@t8_yn = 1
				  select @t2_yn as [!t2_yn],@t3_yn as [!t3_yn],@t4_yn as [!t4_yn],@t5_yn as [!t5_yn],@t6_yn as [!t6_yn],@t7_yn as [!t7_yn],@t8_yn as [!t8_yn]
			]]>
			</text>
		  </request>
    <query>
      <text>
        <![CDATA[
if @action = 'EDIT' begin
]]>&CheckUpdatingDeleting;<![CDATA[
end
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @action in ('EDIT', 'VIEW') exec ISWIFTStoreGetListFiles 'xfile', @id, '@@voucherCode', '', @script output
if @script is null set @script = ''

if @action = 'NEW' begin
  declare @ma_nk varchar(32), @ten_nk nvarchar(3000), @ngay_ct date, @so_ct varchar(32), @i_so_ct int, @unit_id int
  select @ngay_ct = getdate(), @unit_id = @@unit
  
  
]]>&VoucherNumberQuery;<![CDATA[
  if @so_ct is null
    select '' as [so_ct], 0 as [i_so_ct], @unit_id as [unit_id], '' as ma_nk, '' as ten_nk
  else
    select @so_ct as [so_ct], @i_so_ct as [i_so_ct], @unit_id as [unit_id], @ma_nk as ma_nk, @ten_nk as ten_nk
end
else select @script as script
drop table #@@table
         ]]>
      </text>
    </query>

    <declare>
      <text>
        <![CDATA[
declare @warning nvarchar(256), @dOldVoucherDate date, @dVoucherDate date, @nVoucherType tinyint, @strIds varchar(256), @q nvarchar(4000)
set @warning = ''
         ]]>
      </text>
    </declare>

    &VoucherJSLoading;

    <beforesave>
      <text>
        &VoucherNumberBeforeSave;
      </text>
    </beforesave>

    <deleting>
      <text>
        &CheckUpdatingDeleting;
        <![CDATA[
select @dOldVoucherDate = ngay_ct, @dVoucherDate = ngay_ct, @nVoucherType = ma_ngv from s11 where id = @id
        ]]>
      </text>
    </deleting>

    <deleted>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
-- Áp dụng cho dữ liệu lớn
exec ISWIFTStoredDeleteDataWithKey 'v11', @strIds, '', @dVoucherDate
exec ISWIFTStoredDeleteDataWithKey 'v111', @strIds, '', @dVoucherDate
        ]]>
      </text>
    </deleted>

    <updating>
      <text>
        <![CDATA[
select @dOldVoucherDate = ngay_ct from s11 where id = @id
        ]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId, i_so_ct = @i_so_ct, so_ct = @so_ct where [%whereFieldKey]
update dmttin set status = 0 from dmttin where id0 = rtrim(@id) and xgroup = '@@voucherCode'
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
         ]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[
select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @ma_ct = '@@voucherCode'
exec ISWIFTStoredGetIdentityNumber '@@voucherCode', '@@table', @id output
         ]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
]]>
      </text>
    </inserted>

    <aftersave>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
if @action = 'NEW' set @dOldVoucherDate = @ngay_ct
update @v11 set id = @id, ma_kh = @ma_kh, ngay_ct = @ngay_ct, so_ct = @so_ct, status = @status, unit_id = @unit_id, ma_noi_di = @ma_noi_di, ma_noi_den = @ma_noi_den, ma_nt = @ma_nt
delete v11 where id = @id 
delete @v11 where so_luong = 0
insert v11 select * from @v11 where so_luong <> 0

declare @t_sl numeric(19,4)
select @t_sl=isnull(sum(so_luong),0) from @v11 
update s11 set t_so_luong =@t_sl where id = @id

update @v111 set id = @id, ma_kh = @ma_kh, ngay_ct = @ngay_ct, so_ct = @so_ct, status = @status, unit_id = @unit_id, ma_noi_di = @ma_noi_di,ma_noi_den = @ma_noi_den, ma_nt = @ma_nt
delete v111 where id = @id 
delete @v111 where chon_yn = 0
insert v111 select * from @v111 where chon_yn <> 0



---if @ma_so_thue <> '' and @ma_kh is null
---insert into dmkh (ma_kh, ten_kh, ten_kh2, dia_chi, ma_so_thue, nguoi_lh, kh_yn, dien_thoai, unit_id, status, datetime0, datetime2, user_id0, user_id2)
			select 'KH'+ @so_ct, @ten_kh, @ten_kh2, @dia_chi, @ma_so_thue, @nguoi_lh, 1, @dien_thoai, @@unit, 1, getdate(), getdate(), @@userId, @@userId
			
--exec ISWIFTStoredPostingVoucher 's11', 'v11', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
--exec ISWIFTStoredPostingVoucher 's11', 'v111', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
--exec ISWIFTStoredPostingVoucher 's11', 'v11_2', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
--exec ISWIFTStoredPostingVoucher 's11', 'v111', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''

exec ISWIFTStoredIncreaseVoucherNo @ma_nk, @ngay_ct, '@@voucherCode', @i_so_ct, @so_ct, '@@table'

select '' as message, @warning as warning, @id as [#id], @so_ct as [#so_ct], @ma_unit as [#ma_unit]
if @ma_so_thue <> '' and exists (select 1 from dmkh where ma_so_thue = @ma_so_thue and ma_kh <> @ma_kh)        
select '$taxtCodeExists' as toast
]]>
      </text>
    </aftersave>
  </script>

  <messages>
