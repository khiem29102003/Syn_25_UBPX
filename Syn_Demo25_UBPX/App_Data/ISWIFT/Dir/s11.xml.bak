}
function dir$s11HiddenColumnByTran(p){
  var gd = p.valForm('ma_gd');
  var kh = p.valForm('ma_kh');   
	if(gd == 'KC') {
		p.setDisabled(['ma_so_thue','ten_kh','ten_kh2','dia_chi','nguoi_lh'], true);
		p.setInvisible('ma_kh', false);
		
		if(p.options.action == "NEW" && kh == "") {
			p.valForm('ma_kh', "" , true);
			p.valForm('ten_kh', "" , true);
			p.valForm('ten_kh2', "" , true);
			p.valForm('ma_so_thue', "" , true);
			p.valForm('dia_chi', "" , true);
			p.valForm('nguoi_lh', "" , true);
			p.valForm('dien_thoai', "" , true);
		}
		else {
			p.setDisabled('ma_gd', true);
		}
	}
	else {
		p.setDisabled(['ma_so_thue','ten_kh','ten_kh2','dia_chi','nguoi_lh'], false);
		p.setInvisible('ma_kh', true);
		
		if(p.options.action == "NEW") {
			p.valForm('ma_kh', "" , true);
			p.valForm('ten_kh', "" , true);
			p.valForm('ten_kh2', "" , true);
			p.valForm('ma_so_thue', "" , true);
			p.valForm('dia_chi', "" , true);
			p.valForm('nguoi_lh', "" , true);
			p.valForm('dien_thoai', "" , true);
			
		}
		else {
			p.setDisabled('ma_gd', true);
		}
	}
}
function dir$s11DisabledDT(p){
var gd = p.valForm('ma_gd');
var kh = p.valForm('ma_kh');   
	if (kh != "" && gd == 'KC') {
		p.request('ma_kh_request', '', ['ma_kh', 'ngay_ct', 'ma_nt'])
		return;
	}
	if(kh == "" && gd == 'KC'){
		p.valForm('ten_kh', "" , true);
		p.valForm('ten_kh2', "" , true);
		p.valForm('ma_so_thue', "" , true);
		p.valForm('dia_chi', "" , true);
		p.valForm('nguoi_lh', "" , true);
		p.valForm('dien_thoai', "" , true);
		
		return;
	}
}
function dir$s11DisabledStatusByAction(p){
  var o = p.jObject('status');
  if (p.options.action != 'VIEW') o.find("[value=6],[value=7],[value=9]").remove();
}
