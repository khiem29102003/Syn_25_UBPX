}
function dir$s11DisabledMasterField(p, g){
  var dt = g.data, rows = dt.findRow("[ma_cong].trim() != ''"), dis = rows.length > 0;
  p.setDisabled('unit_id', dis);
  p.setInactive('unit_id', true);
  if (p.options._sale_lock_master == 1) p.setDisabled(['ma_kh', 'ngay_ct', 'ma_nt'], dis);
}
function dir$s11HiddenColumnByType(p){
