  <messages>
    <message val="invoiceRetrieve">
      <text v="Chỉ xử lý nghiệp vụ lấy số liệu cho hóa đơn" e="" />
    </message>
    <message val="DaThanhToan">
      <text v="Đã có chứng từ thanh toán cho hóa đơn này, không được sửa/xóa." e=""/>
    </message>
    <message val="DaTraLai">
      <text v="Đã có chứng từ trả lại cho hóa đơn này, không được sửa/xóa." e=""/>
    </message>
	  <message val="EmptyContainer">
      <text v="Vui lòng nhập Container" e="Please Enter Congtainer" />
    </message>
	  <message val="EmptyOrder">
      <text v="Vui lòng chọn đơn hàng" e="Please Enter Congtainer" />
    </message>
	 <message val="HaveIDBG">
      <text v="Chỉ thực hiện khi đơn hàng lấy từ báo giá" e="Only fulfillment when the order has a quotation number" />
    </message>
	<message val="HaveIDTG">
      <text v="Chỉ thực hiện khi đơn hàng lấy từ tự tìm giá" e="Only fulfillment when the order has a quotation number" />
    </message>
	<message val="NewOrder">
      <text v="Vui lòng chọn lấy từ báo giá" e="Only fulfillment when the order has a quotation number" />
    </message>
    <message val="physicalRetrieve">
      <text v="Chỉ xử lý nghiệp vụ sổ sách lấy dữ liệu từ thực tế" e="" />
    </message>
	 <message val="noDate">
      <text v="Ngày hiệu lực đến không hợp lệ." e="Error Expiry Date."/>
    </message>
	<message val="noUng">
      <text v="Số tiền ứng lớn hơn tiền quỹ hiện có." e="Error Expiry Date."/>
    </message>
	<message val="notApproveRightEdit">
      <text v="Không có quyền sửa/xóa đơn hàng đã duyệt ngoài mức được phân quyền" e="" />
    </message>
	<message val="notApproveRight">
      <text v="Không có quyền duyệt đơn hàng" e="" />
    </message>
	 <message val="OnLyNew">
      <text v="Chỉ thực hiện chức này ở trạng thái thêm mới." e="Only perform this function in the newly added state."/>
    </message>
  </messages>
</dir>