<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="reguserinfo" table="reguserinfo" fieldKey="user_id" dirViewType="Dialog" transaction="true" tryCatch="true" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo người sử dụng" e="User Maintenance"></title>
  <title0 v="Thêm thông tin người sử dụng" e="New User's Information"></title0>
  <title1 v="Sửa thông tin người sử dụng" e="Edit User's Information"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120"  >
      <fields>
        <field name="user_id" label="" field="1" dataType="I" hidden="true" fieldType="PK" >
          <text v="" e=""></text>
        </field>
        <field name="admin" label="1" field="1" dataType="I" hidden="true" >
          <text v="" e=""></text>
        </field>
		<field name="username" format="U" label="1" field="1" allowBlank="false" >
          <text v="Tên người dùng" e="Name"></text>
        </field>
		<field name="type_member" viewType="Combobox" valueDefault="" label="1" field="2" nextRow="true" >
		<text v="Chọn loại thành viên" e="Type of Member"></text>
		<viewInfo>
			<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'RSU' and status = 1 order by stt">
			</options>
		</viewInfo>
		</field>
        <field name="ma_so_thue" label="1" field="1"  importable="35">
          <text v="Mã số thuế &lt;a onclick='getTax(this);'&gt;(Kiểm tra)&lt;/a&gt;" e="Tax code &lt;a onclick='getTax(this);'&gt;(Test)&lt;/a&gt;"></text>
        </field>
		<field name="nguoi_lh" label="1" field="2" hidden="false" nextRow="false">
          <text v="Người liên hệ" e="Description"></text>
        </field>		
		<field name="company" format="U" label="1" field="2" >
          <text v="Tên công ty" e="Company Name"></text>
        </field>
		<field name="phone" label="1" field="1" nextRow="true" allowBlank="false">
          <text v="Điện thoại" e="Mobile Phone Number"></text>
        </field>
		<field name="e_mail" label="1" field="2" nextRow="false">
          <text v="Email" e="Email Address"></text>
        </field>
        <field name="image_id" label="0" field="1" viewType="Image">
          <text v="" e=""></text>
          <viewInfo fileFieldId0="user_id" fileGroup="SysUser" fileExtension="jpg,png" maxFileSize="10240" maxFileCount="1"></viewInfo>
        </field>	
        <field name="nickname" allowBlank="false" label="1" field="2" hidden="true">
          <text v="Tên đầy đủ" e="Description"></text>
        </field>
        <field name="vpassword" allowBlank="false" fieldType="EX" valueDefault="********" label="1" field="2">
          <text v="Mật khẩu" e="Password"></text>
        </field>
        <field name="vpassword2" allowBlank="false" fieldType="EX" valueDefault="********" label="1" field="2">
          <text v="Nhập lại mật khẩu" e="Re-Password"></text>
        </field>

        <field name="birthday" label="1" field="1" clientDefault="true" dataType="D" hidden="true">
          <text v="Ngày sinh" e="Birthday"></text>
        </field>
        <field name="parent_user" label="-" field="1" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="parent_username" clientDefault="true" fieldType="EXParam" viewType="Lookup" label="1" field="1" hidden="true">
          <text v="Nhân viên cấp trên" e="Parent User"></text>
          <viewInfo lookupType="One" lookupId="sysuserinfo" lookupKey="1=1" lookupCheck="1=1" lookupRef="parent_username_name" lookupInfo="sysuserinfo|username|nickname" />
        </field>
        <field name="parent_username_name" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="user_ref" label="" field="1" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="rg_code" clientDefault="true" viewType="Lookup" label="1" field="1">
          <text v="Khu vực" e="Region"></text>
          <viewInfo lookupType="One" lookupId="sysregioninfo" lookupKey="1=1" lookupCheck="1=1" lookupRef="rg_code_name" lookupInfo="sysregioninfo|rg_code|rgname" />
        </field>
        <field name="rg_code_name" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="language" viewType="Combobox" inactivate="true" label="1" field="1" >
          <text v="Ngôn ngữ ngầm định" e="Default Language"></text>
          <viewInfo>
            <options>
              <option val="v">
                <text v="Tiếng Việt" e="Vietnamese"></text>
              </option>
              <option val="e">
                <text v="Tiếng Anh" e="English"></text>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="lock_yn" dataType="B" valueDefault="1" label="1" field="[60]" fieldType="EXParam" aliasName="case when errorpass > 5 then 1 else 0 end as ">
          <text v="Khóa đăng nhập" e="Khóa đăng nhập"></text>
        </field>

        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e=""></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="password" label="" hidden="true" field="1">
          <text v="" e=""></text>
        </field>
        <field name="update_pass" fieldType="EXParam" label="" hidden="true" field="1">
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <css>
    <text>
      <![CDATA[<enc>NnrjY7t9qla1gUM/7uX7PNyA8qTemdRMMLce1Xe0G9+X6o1JxWHDgfOqXO2TwFi3K0n0Ql8vlfOcVYZfeE8RlrCPgKnwPZpXrpKCZPLUUOIyThWPK7wgtzxsAF4061aMlYxq9Y+vK3A5gHajOPty/H/CUIVz9R/i0bHNpIdj7PAW0Owo3ZR4BEZWpPCWwloz</enc>]]>
    </text>
  </css>

  <script>

    <query>
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </query>

    <loading code="1">
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </loading>

    <updating>
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[<enc></enc>]]>
      </text>
    </inserted>

  </script>

  <messages>
    <message val="exists">
      <text v="Tên người dùng đã tồn tại" e="User name already exists." />
    </message>
    <message val="maxUser">
      <text v="Số lượng người dùng vượt quá giới hạn." e="Số lượng người dùng vượt quá giới hạn." />
    </message>
    <message val="phoneExists">
      <text v="Số điện thoại di động đã tồn tại." e="Phone Number already exists." />
    </message>
    <message val="emailExists">
      <text v="Địa chỉ Thư (Email) đã tồn tại." e="Email already exists." />
    </message>
    <message val="parentConflict">
      <text v="Nhân viên cấp trên không hợp lệ." e="Invalid Parent User." />
    </message>
    <message val="NotParent4Admin">
      <text v="Không nhập cấp trên cho administrator" e="" />
    </message>
  </messages>
</dir>