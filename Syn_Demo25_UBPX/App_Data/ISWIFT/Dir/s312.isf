	<!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
	<!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

	<!ENTITY CheckUpdatingDeleting "
	if exists(select 1 from s312 where id = @id and status in (6,7,9)) begin
	select '$NotEditVoucherStatus' as message
		return
		end
	">
]>


<dir id="s312" table="s312" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="BN2" width="Large" xmlns="urn:schemas-iswift:struct-dir">
	<title v="Cước vận chuyển quốc tế hàng biển LCL" e="LCL International Sea Freight"></title>
	<title0 v="Mới" e="New"></title0>
	<title1 v="Sửa" e="Edit"></title1>
	<forms>
		<form gravity="TopLeft" columns="120,120,120,120" >
			<fields>
				<field name="ma_kh"  viewType="Lookup" label="1" field="1" allowBlank="false" hidden="false" importable="1">
				  <text v="Hãng tàu/ Đại lý" e="Carrier/ Agent Code"></text>
				  <viewInfo lookupType="One" lookupId="dmkh" lookupKey="(ncc_yn = 1 or dl_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
				</field>
				<field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
				  <text v="" e=""></text>
				</field>
				<field name="ma_noi_di" viewType="Lookup" label="1" field="1" allowBlank="false" importable="5">
					<text v="Nơi đi" e="Origin"></text>
					<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="(hc_yn = 1 or kkh_yn =1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
				</field>
				<field name="ten_noi_di" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-"  aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field> 	
				<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" importable="10" >
					<text v="Ngày hiệu lực" e="Effective date"></text>
				</field>
				<field name="di_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
					<text v="" e=""></text>
				</field>
				<field name="ngay_hld" label="[100]" field="[120]" dataType="D" allowBlank="false" nextRow="false" importable="15" >
					<text v="Hiệu lực đến" e="Expiry date"></text>
				</field>

				<field name="dien_giai" label="1" rows="1" field="-" importable="20" >
					<text v="Diễn giải" e="Explain"></text>
				</field>
				<field name="ma_phi" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false" importable="25">
					<text v="Loại cước/ Phí" e="Freight/ Fee"></text>
					<viewInfo lookupType="One" lookupId="dmphi" lookupKey="status = 1 and ma_phi = 'OF' " lookupCheck="1=1" lookupRef="ten_phi2" lookupInfo="dmphi|ma_phi|ten_phi2" />
				</field>
				<field name="ten_phi2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(200)) as ">
					<text v="" e=""></text>
				</field>
				<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
				  <text v="" e=""></text>
				</field>
			</fields>
		</form>

		<form gravity="TopRight" columns="120,120" >
			<fields>
				&VoucherRequiredFields01;
				&VoucherRequiredFields02;
			</fields>
		</form>

		<form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
			<text v="Chi tiết" e="Detail"></text>
			<fields>
				<field name="v312" allowBlank="false" label="" field="-" viewType="Grid">
					<text v="Chi tiết" e="Detail"></text>
				</field>
			</fields>
		</form>

		<form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
			<text v="Khác" e="Other"></text>
			<fields>
				<field name="ma_nvbh" clientDefault="true" viewType="Lookup" label="1" field="1" setype="1" importable="30" >
					<text v="Mã nhân viên" e="Sale"></text>
					<viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nvbh" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" />
				</field>
				<field name="ten_nvbh" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field>
				<field name="ma_ptvc" viewType="Lookup" label="1" field="1" importable="35" >
					<text v="Phương tiện v/c" e="Transportation"></text>
					<viewInfo lookupType="One" lookupId="dmptvc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptvc" lookupInfo="dmptvc|ma_ptvc|ten_ptvc" />
				</field>
				<field name="ten_ptvc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field>
				<field name="ma_pttt" viewType="Lookup" label="1" field="1" importable="40">
					<text v="Ph/th thanh toán" e="Payment Methods"></text>
					<viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
				</field>
				<field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field>
				<field name="ma_ptgh" viewType="Lookup" label="1" field="1" importable="45">
					<text v="Ph/th giao hàng" e="Delivery Methods"></text>
					<viewInfo lookupType="One" lookupId="dmptgh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptgh" lookupInfo="dmptgh|ma_ptgh|ten_ptgh" />
				</field>
				<field name="ten_ptgh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field>
				<field name="t_tc_tien_nt2" label="1" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" >
					<text v="Tổng tiền phí" e="Total Fee"></text>
				</field>
				<field name="t_tc_tien2" label="" field="1" nextRow="false" disabled="true" fieldType="EX" dataType="N" format="Amount" >
					<text v="" e=""></text>
				</field>			
			</fields>
		</form>

	<form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
		<text v="Đính kèm" e="Attach Files"></text>
		<fields>
			<field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
				<text v="Chọn files" e="Attach Files"></text>
				<viewInfo fileFieldId0="id" fileGroup="BN2" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
			</field>
		</fields>
	</form>

    <form gravity="BottomLeft" columns="100,100,100,100,100,100,130" >
      <fields>
	   <field name="t_so_luong" label="1" field="[100]" dataType="N" disabled="true" format="Amount" hidden="false" >
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
        <field name="t_tien_nt2" nextRow="false" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
        <field name="t_tien2" nextRow="false" label="" field="1" hidden="true" disabled="true" dataType="N" format="Amount" >
          <text v="" e="Total Amount"></text>
        </field>
		 <field name="t_ban_nt" nextRow="false" label="0" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền bán" e="Total Amount"></text>
        </field>
        <field name="t_ban" nextRow="false" label="" field="[100]" hidden="true" disabled="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_thue_nt" blank="2" label="1" field="1" dataType="N" hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thuế" e="Total Tax"></text>
        </field>
        <field name="t_thue" label="" field="1" nextRow="false" disabled="true" hidden="true" dataType="N" format="Amount" >
          <text v="" e="Total Tax"></text>
        </field>
        <field name="t_tt_nt" nextRow="false" label="1" field="1" dataType="N"  hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thanh toán" e="Total Amount"></text>
        </field>
        <field name="t_tt" label="" field="1" nextRow="false" disabled="true" hidden="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="v312" table="v312" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="ma_noi_den" width="100" viewType="Lookup" readOnly="false" allowBlank="false">
          <text v="Nơi đến " e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="(hc_yn = 1 or kkh_yn =1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_den" lookupInfo="vdmcangden|ma_noi_den|ten_noi_den" />
        </field>
        <field name="ten_noi_den" width="200" fieldType="EX" inactivate="true" readOnly="true" aliasName="b.ten_noi_den " join=" left join vdmcangden b on a.ma_noi_den = b.ma_noi_den ">
          <text v=" Tên nơi đến" e="Destination"></text>
        </field>		
		
        <field name="so_luong" dataType="N" format="Amount"  hidden="false" allowBlank="false" valueDefault="1" width="100" readOnly="false" disabled="true" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
		<field name="ds_ngay" allowBlank="true" viewType="Lookup" width="120" readOnly="false">
          <text v="Lịch vận chuyển" e="Schedule Days"></text>
          <viewInfo lookupType="Multi" lookupId="dmbgn" lookupKey="status=1 and ma_ct ='DIW'" lookupCheck="status=1" lookupRef="" lookupInfo="dmbgn|ma_bgn|ten_bgn" />
        </field>
		<field name="so_ngay_vc" dataType="N" format="Amount" hidden="false" width="80" readOnly="false" >
          <text v="Số ngày vc" e="Transit time"></text>
        </field>			
		<field name="ma_dk_vc" viewType="Combobox" valueDefault="1" width="150" readOnly="false">
			<text v="Đi thẳng/Chuyển tải" e="Direct / Transit"></text>
			<viewInfo>
				<options query="select ma_bgn	, ten_bgn%l from dmbgn where ma_ct = 'VT' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>	

        <field name="gia_nt2" dataType="N" hidden="false" format="FCPrice" width="100" readOnly="false" disabled="false" >
          <text v="Giá cước %s" e="%s Freight Price"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100" readOnly="false" disabled="true" >
          <text v="Cước VND" e="Amount"></text>
        </field>
		<field name="ban_nt" dataType="N" format="FCAmount" width="100" hidden="false" readOnly="false" clientDefault="true" >
          <text v="Giá bán %s" e="Price %s"></text>
        </field>
		<field name="ban" dataType="N" format="Amount" width="100" inactivate="true" hidden="false"  readOnly="false" disabled="true">
          <text v="Giá bán VND" e="Price VND"></text>
        </field>
		<field name="dien_giai" width="300" inactivate="false" readOnly="false">
          <text v="Diễn giải" e="Explain"></text>
        </field>

		<field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
		 <field name="ct_km" width="100" valueDefault="0" viewType="Combobox" inactivate="true" hidden="true" readOnly="false" >
          <text v="Loại hàng" e="container Type"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Hàng bán" e="Sale"/>
              </option>
              <option val="1">
                <text v="Hàng KM" e="Promotion"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="gia_nt1" dataType="N" inactivate="true" hidden="true" format="FCPrice" width="100" readOnly="false" >
          <text v="Giá chuẩn %s" e="%s Std.Price"></text>
        </field>
		<field name="tien_nt2" dataType="N" format="FCAmount" hidden="true" inactivate="true"  width="100" disabled="true" readOnly="false" >
          <text v="Cước %s" e="%s Freight"></text>
        </field>
        <field name="tl_ck" dataType="N" format="Rate" width="100" hidden="true" readOnly="false" >
          <text v="Tl ck(%)" e="Dis.Rate"></text>
        </field>
        <field name="ck_nt" dataType="N" format="FCAmount" width="100" hidden="true" readOnly="false" clientDefault="true" >
          <text v="Ch.khấu %s" e="%s Discount"></text>
        </field>
		
        <field name="thue_suat" dataType="N" format="0" width="100" readOnly="false" hidden="true" clientDefault="true" >
          <text v="Thuế suất(%)" e="Tax"></text>
        </field>
        <field name="thue_nt" dataType="N" format="FCAmount" width="100" hidden="true" readOnly="false">
          <text v="Thuế %s" e="%s Tax"></text>
        </field>
        <field name="gia1" dataType="N" format="Price" width="100" hidden="true" inactivate="true" readOnly="true" >
          <text v="Giá chuẩn" e="Std.Price"></text>
        </field>
		 <field name="gia2" dataType="N" format="Price" width="100" inactivate="true" disabled="true" hidden="true" readOnly="false">
          <text v="Giá Cước VND" e="Price"></text>
        </field>
		<field name="ck" dataType="N" format="Amount" width="100" inactivate="true" hidden="true" readOnly="false">
          <text v="Chiết khấu" e="Discount"></text>
        </field>
		
        <field name="thue" dataType="N" format="Amount" width="100" inactivate="true" hidden="true" readOnly="false">
          <text v="Thuế" e="Tax"></text>
        </field>
		<field name="tl_ban" dataType="N" format="FCPrice" hidden="true" width="100" readOnly="false" >
          <text v="Lợi nhuận (%)" e="%s Profit "></text>
        </field>
		
		<field name="tl_hh" dataType="N" format="Rate" width="100" hidden="true" readOnly="false" >
          <text v="Tl HH (%)" e="Commi.Rate"></text>
        </field>
        <field name="hh_nt" dataType="N" format="FCAmount" width="100" hidden="true" readOnly="false" clientDefault="true" >
          <text v="Hoa hồng %s" e="%s Commission"></text>
        </field>
		<field name="hh" dataType="N" format="Amount" width="100" inactivate="true" hidden="true" readOnly="false">
          <text v="Hoa hồng VND" e="Commission"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc>Z0SM+tBL+QTSdjLaV3bLKH9/oGHShARNq9ypOEza7ZmxeN4C0PRwznODUrTpn/JHUPKN/50EQobuWUT0mBByM20cPDbQUd6WbUoZ+jQ94DiYFfjfPcYrngoH7KbhhwbiObBKABBlvKIqPSlQz0LH/UTnrjKAgqyFf/zMv687XJQzZK2nNGvaoEMH731c9eHLuL3AgvIhtwSNKICfqECtkA==</enc>]]>
          </text>
        </query>
      </script>
	
    </grid>
	
	
  </grids>
