  <js>
    <text>
      <![CDATA[
function dir$s03(p){
  this.constructor(p);
}
dir$s03.prototype = new DirEvent();
dir$s03.prototype.beforeInit = function(renderType){
  this._dir.options._files = null;
}
dir$s03.prototype.afterInit = function(renderType){
  var p = this._dir, g = p.grid(0), g2 = p.grid(1);
  var exp = {
    gia1: ['*gia1', '[!ty_gia]*[gia_nt1]'],
    gia_ban: ['*gia_ban', '[gia_ban_nt]*[!ty_gia]'],
    gia2: ['*gia2', '[gia_nt2]*[!ty_gia]'],
    tien_nt2: ['*tien_nt2', '[so_luong]*[gia_nt2]'],
    tien2_tg: ['*tien2', '[tien_nt2]*[!ty_gia]'],
    tien2: ['*tien2', '[so_luong]*[gia2]'],
    thue_nt: ['*thue_nt', '[thue_suat]*([tien_nt2] - [ck_nt])/100'],
    thue: ['*thue', '[thue_suat]*([tien2] - [ck])/100'],
    thue_tg: ['*thue', '[!ty_gia]*[thue_nt]'],
    ck_nt: ['*ck_nt', '[tien_nt2]*[tl_ck]/100'],
    ck_tg: ['*ck', '[ck_nt]*[!ty_gia]'],
    ck: ['*ck', '[tien2]*[tl_ck]/100'],
	
	 hh_nt: ['*hh_nt', '[tien_nt2]*[tl_hh]/100'],
	 hh_tg: ['*hh', '[hh_nt]*[!ty_gia]'],
	 hh: ['*hh', '[tien2]*[tl_hh]/100'],
    t_so_luong: ['@t_so_luong', '[so_luong]'],
    t_tien_nt2: ['@t_tien_nt2', '[tien_nt2] - [ck_nt]', '[ct_km] == 0'],
    t_tien2: ['@t_tien2', '[tien2] - [ck]', '[ct_km] == 0'],
    t_ck_nt: ['@t_ck_nt', '[ck_nt]', '[ct_km] == 0'],
    t_ck: ['@t_ck', '[ck]', '[ct_km] == 0'],
	
	 t_hh_nt: ['@t_hh_nt', '[hh_nt]', '[ct_km] == 0'],
    t_hh: ['@t_hh', '[hh]', '[ct_km] == 0'],
	
    t_thue_nt: ['@t_thue_nt', '[thue_nt]', '[ct_km] == 0'],
    t_thue: ['@t_thue', '[thue]', '[ct_km] == 0'],
    t_tc_tien_nt2: ['@t_tc_tien_nt2', '[tien_nt2]'],
    t_tc_tien2: ['@t_tc_tien2', '[tien2]'],
    t_km_nt: ['@t_km_nt', '[tien_nt2]', '[ct_km] == 1'],
    t_km: ['@t_km', '[tien2]', '[ct_km] == 1'],

    t_tt_nt: ['#t_tt_nt', '[t_tien_nt2] + [t_thue_nt]'],
    t_tt: ['#t_tt', '[t_tien2] + [t_thue]']
  }
  p.applyExpression(exp, g, false);
  
  var expForm = {
    t_tt_nt: ['#t_tt_nt', '[t_tien_nt2] + [t_thue_nt]'],
    t_tt: ['#t_tt', '[t_tien2] + [t_thue]']
  }
  p.applyExpressionForm(expForm, true);
  
  g.FomulaApplied = {
    "so_luong":["t_so_luong", "tien_nt2", "ck_nt", "hh_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "he_so":["tien_nt2", "ck_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "gia_nt2":["t_so_luong", "tien_nt2", "gia2", "gia1", "ck_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "!ty_gia":["gia2", "tien2_tg", "ck_tg", "thue_tg", "t_tien2", "t_km", "t_tc_tien2", "t_ck", "t_hh", "t_thue", "t_tt"],
    "thue_suat":["thue_nt", "thue", "t_thue_nt", "t_thue", "t_tt_nt", "t_tt"],
    "tien_nt2":["ck_nt", "hh_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_hh_nt", "t_hh", "t_tt_nt", "t_tt"],
    "tl_ck":["ck_nt", "thue_nt", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "ck_nt":["thue_nt", "ck_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_tt_nt", "t_tt"],
    "tl_hh":["hh_nt", "thue_nt", "hh_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_hh_nt", "t_ck", "t_tt_nt", "t_tt"],
    "hh_nt":["thue_nt", "hh_tg", "thue_tg", "t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_hh_nt", "t_hh", "t_tt_nt", "t_tt"],
  
	
	"ct_km":["t_tien_nt2", "t_km_nt", "t_tc_tien_nt2", "t_tien2", "t_km", "t_tc_tien2", "t_thue_nt", "t_thue", "t_ck_nt", "t_ck", "t_hh_nt", "t_hh", "t_tt_nt", "t_tt"],
    "gia2":["t_so_luong","tien2", "ck", "hh","thue", "t_tien2", "t_km", "t_tc_tien2", "t_thue", "t_ck","t_hh", "t_tt"],
    "tien2":["ck","hh", "thue", "t_tien2", "t_km", "t_tc_tien2", "t_thue", "t_ck", "t_hh","t_tt"],
    "ck":["thue", "t_tien2", "t_km", "t_tc_tien2", "t_thue", "t_ck", "t_tt"],
	"hh":["thue", "t_tien2", "t_km", "t_tc_tien2", "t_thue", "t_hh", "t_tt"],
    "thue_nt":["thue_tg", "t_thue_nt", "t_thue", "t_tt", "t_tt_nt"],
    "thue":["t_thue", "t_tt"],
    "t_tien_nt2":["t_tt_nt"],
    "t_thue_nt":["t_tt_nt"],
    "t_tien2":["t_tt"],
    "t_thue":["t_tt"],
	"ma_phi":["t_so_luong"],
    "t_ex_total": ["t_tc_tien_nt2", "t_tc_tien2", "t_km_nt", "t_km"]
  }
   // Chi tiết 2
   var exp2 = {
		gia1: ['*gia1', '[!ty_gia]*[gia_nt1]'],
		gia_ban: ['*gia_ban', '[gia_ban_nt]*[!ty_gia]'],
		gia2: ['*gia2', '[gia_nt2]*[!ty_gia]'],
		tien_nt2: ['*tien_nt2', '[so_luong]*[gia_nt2]'],
		tien2_tg: ['*tien2', '[tien_nt2]*[!ty_gia]'],
		tien2: ['*tien2', '[so_luong]*[gia2]'],
		thue_nt: ['*thue_nt', '[thue_suat]*([tien_nt2] - [ck_nt])/100'],
		thue: ['*thue', '[thue_suat]*([tien2] - [ck])/100'],
		thue_tg: ['*thue', '[!ty_gia]*[thue_nt]'],
		ck_nt: ['*ck_nt', '[tien_nt2]*[tl_ck]/100'],
		ck_tg: ['*ck', '[ck_nt]*[!ty_gia]'],
		ck: ['*ck', '[tien2]*[tl_ck]/100'],

		hh_nt: ['*hh_nt', '[tien_nt2]*[tl_hh]/100'],
		hh_tg: ['*hh', '[hh_nt]*[!ty_gia]'],
		hh: ['*hh', '[tien2]*[tl_hh]/100'],
		t2_so_luong: ['@t2_so_luong', '[so_luong]'],
		t2_tien_nt2: ['@t2_tien_nt2', '[tien_nt2] - [ck_nt]', '[ct_km] == 0'],
		t2_tien2: ['@t2_tien2', '[tien2] - [ck]', '[ct_km] == 0'],
		t2_ck_nt: ['@t2_ck_nt', '[ck_nt]', '[ct_km] == 0'],
		t2_ck: ['@t2_ck', '[ck]', '[ct_km] == 0'],

		t2_hh_nt: ['@t_hh_nt', '[hh_nt]', '[ct_km] == 0'],
		t2_hh: ['@t2_hh', '[hh]', '[ct_km] == 0'],

		t2_thue_nt: ['@t2_thue_nt', '[thue_nt]', '[ct_km] == 0'],
		t2_thue: ['@t2_thue', '[thue]', '[ct_km] == 0'],
		t2_tc_tien_nt2: ['@t2_tc_tien_nt2', '[tien_nt2]'],
		t2_tc_tien2: ['@t2_tc_tien2', '[tien2]'],
		t2_km_nt: ['@t2_km_nt', '[tien_nt2]', '[ct_km] == 1'],
		t2_km: ['@t2_km', '[tien2]', '[ct_km] == 1'],

		t2_tt_nt: ['#t2_tt_nt', '[t2_tien_nt2] + [t2_thue_nt]'],
		t2_tt: ['#t2_tt', '[t2_tien2] + [t2_thue]']
  }
  p.applyExpression(exp2, g2, false);
  
  
  var expForm2 = {
    t2_tt_nt: ['#t2_tt_nt', '[t2_tien_nt2] + [t2_thue_nt]'],
    t2_tt: ['#t2_tt', '[t2_tien2] + [t2_thue]']
  }
  p.applyExpressionForm(expForm2, true);
  
  
  g2.FomulaApplied = {
    "so_luong":["t2_so_luong", "tien_nt2", "ck_nt", "hh_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t2_tien_nt2", "t2_km_nt", "t2_tc_tien_nt2", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue_nt", "t2_thue", "t2_ck_nt", "t2_ck", "t2_tt_nt", "t2_tt"],
    "he_so":["tien_nt2", "ck_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t2_tien_nt2", "t_km_nt", "t2_tc_tien_nt2", "t2_tien2", "t_km", "t2_tc_tien2", "t2_thue_nt", "t2_thue", "t_ck_nt", "t_ck", "t2_tt_nt", "t2_tt"],
    "gia_nt2":["t2_so_luong", "tien_nt2", "gia2", "gia1", "ck_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t2_tien_nt2", "t2_km_nt", "t2_tc_tien_nt2", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue_nt", "t2_thue", "t2_ck_nt", "t2_ck", "t2_tt_nt", "t2_tt"],
    "!ty_gia":["gia2", "tien2_tg", "ck_tg", "thue_tg", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_ck", "t2_hh", "t2_thue", "t2_tt"],
    "thue_suat":["thue_nt", "thue", "t2_thue_nt", "t2_thue", "t2_tt_nt", "t2_tt"],
    "tien_nt2":["ck_nt", "hh_nt", "thue_nt", "tien2_tg", "ck_tg", "thue_tg", "t2_tien_nt2", "t2_km_nt", "t2_tc_tien_nt2", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue_nt", "t2_thue", "t2_ck_nt", "t2_ck", "t2_hh_nt", "t2_hh", "t2_tt_nt", "t2_tt"],
    "tl_ck":["ck_nt", "thue_nt", "ck_tg", "thue_tg", "t2_tien_nt2", "t2_km_nt", "t2_tc_tien_nt2", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue_nt", "t2_thue", "t2_ck_nt", "t2_ck", "t2_tt_nt", "t2_tt"],
    "ck_nt":["thue_nt", "ck_tg", "thue_tg", "t2_tien_nt2", "t2_km_nt", "t2_tc_tien_nt2", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue_nt", "t2_thue", "t2_ck_nt", "t_ck", "t2_tt_nt", "t2_tt"],
     "tl_hh":["hh_nt", "thue_nt", "hh_tg", "thue_tg", "t2_tien_nt2", "t2_km_nt", "t2_tc_tien_nt2", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue_nt", "t2_thue", "t2_hh_nt", "t2_ck", "t2_tt_nt", "t2_tt"],
    "hh_nt":["thue_nt", "hh_tg", "thue_tg", "t2_tien_nt2", "t2_km_nt", "t2_tc_tien_nt2", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue_nt", "t2_thue", "t2_hh_nt", "t2_hh", "t2_tt_nt", "t2_tt"],
  
	
	"ct_km":["t2_tien_nt2", "t2_km_nt", "t2_tc_tien_nt2", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue_nt", "t2_thue", "t2_ck_nt", "t2_ck", "t2_hh_nt", "t2_hh", "t2_tt_nt", "t2_tt"],
    "gia2":["t2_so_luong","tien2", "ck", "hh","thue", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue", "t2_ck","t2_hh", "t2_tt"],
    "tien2":["ck","hh", "thue", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue", "t2_ck", "t2_hh","t2_tt"],
    "ck":["thue", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue", "t2_ck", "t2_tt"],
	"hh":["thue", "t2_tien2", "t2_km", "t2_tc_tien2", "t2_thue", "t2_hh", "t2_tt"],
    "thue_nt":["thue_tg", "t2_thue_nt", "t2_thue", "t2_tt", "t2_tt_nt"],
    "thue":["t2_thue", "t2_tt"]
  }
  //console.log(JSON.stringify(g.FomulaApplied)); //Gan la ds cong thuc tinh cho cot nao do: 
  
  p.options.FCColumns = {FC: ['t_tien_nt2', 't_thue_nt', 't_tt_nt', 't_tc_tien_nt2','t2_tien_nt2', 't2_thue_nt', 't2_tt_nt', 't2_tc_tien_nt2'], BC: ['t_tien2', 't_thue', 't_tt', 't_tc_tien2','t2_tien2', 't_thue', 't2_tt', 't2_tc_tien2']};
  g.FCColumns = {FC: ['gia_nt2', 'tien_nt2','hh_nt'], BC: ['gia2', 'tien2', 'hh']};
  // Chi tiết 2
  g2.FCColumns = {FC: ['gia_nt2', 'tien_nt2','hh_nt'], BC: ['gia2', 'tien2', 'hh']};
   
  var oldTG = '', oTG = p.jObject('ma_nt'); //Neu ty gia thay doi
  oTG.focus(function(){ oldTG = oTG.fval(); }).blur(function(){ if (oldTG != oTG.fval()) onExRateChanged(oTG, p);});
  p.applyFCColumns();
  p.applyFCColumns(g);
  p.applyFCColumns(g2);
  p.setFCHidden(oTG.fval());
  p.calcExpressionAll(0, 't_ex_total');
  
  p.setColumnAuth(0, ['ma_lo', 'ma_vi_tri'], true); // Ko sd ma_lo, ma_vi_tri
  dir$s03DisabledMasterField(p, g);
  dir$s03DisabledMasterField(p, g2);
  dir$s03HiddenColumnByType(p);
  dir$s03HiddenColumnByTran(p);
  dir$s03HiddenColumnByDay(p);
  dir$s03DisabledStatusByAction(p);

}


dir$s03.prototype.beforeButtonDialogClick = function (id) {
  var p = this._dir, g = p.grid(0), dt = g.data;
  switch (id) {
    case 'ok':
		var d = p.valForm('ngay_hl'),d2 = p.valForm('ngay_hld');
		var k = $.date(d,"dd/mm/yy"),k2 = $.date(d2,"dd/mm/yy");
		if (p.valForm('ngay_hld') <= p.valForm('ngay_hl')) { 
			<!-- $.question('jkhj '+'Nhap sai ngay ??' ); -->
			<!-- $.showToast(p.msg('noDate')); -->
			
			$.alert(p.msg('noDate')+' ' + k + ' < ' + k2);			
			return false;
			Break;
			}	  		  
    default:
      break;
  }
  return true;
}
dir$s03.prototype.beforeButtonGridClick = function (id, gindex) {
  var p = this._dir;
  switch (id) {
    default:
      break;
  }
  return true;
}

dir$s03.prototype.formFieldValueChange = function (o, cF, v) {
  var p = this._dir;
  switch (cF){
]]>&VoucherExRateValid01;<![CDATA[
    case 'ma_gd':
      dir$s03HiddenColumnByTran(p);
      break;
    case 'ma_ngv':
      dir$s03HiddenColumnByType(p);
      break;
    case 'ty_gia':
      p.calcExpressionAll(0, '!ty_gia');
      break;
    case 'ma_kh':
      p.request('Customer', '', ['ma_kh', 'ngay_ct', 'ma_nt']);
      break;
	case 'ma_dk_ngay':
      dir$s03HiddenColumnByDay(p);
      break;
    default:
      break;
  }
}
]]>&VoucherExRateValid02;<![CDATA[
dir$s03.prototype.gridDetailActionChange = function(gindex, action, r){
  var p = this._dir;
  if (action == 'AfterDeleteRow' || action == 'AfterAppendGrid') dir$s03DisabledMasterField(p, p.grid(gindex));
  return true;
}
function dir$s03DisabledMasterField(p, g){
if ( p.options.action != 'NEW')
{
  p.setDisabled('unit_id', true);
  p.setDisabled(['ma_kh', 'ngay_ct', 'ma_nt'], true);
}
}
function dir$s03HiddenColumnByType(p){
  var v = p.valForm('ma_ngv'), nt = p.valForm('ma_nt'), bc = p.options.struct.baseCurrency;
}
function dir$s03HiddenColumnByTran(p){
  
}

function dir$s03HiddenColumnByDay(p){
	var v = p.valForm('ma_dk_ngay');
	if (v == 1) p.request('ma_dk_ngay', '', ['t2_yn','t3_yn','t4_yn','t5_yn','t6_yn','t7_yn','t8_yn']);
	p.setDisabled(['t2_yn','t3_yn','t4_yn','t5_yn','t6_yn','t7_yn','t8_yn'], v == 1);
	}

function dir$s03DisabledStatusByAction(p){
  var o = p.jObject('status');
  if (p.options.action != 'VIEW') o.find("[value=6],[value=7],[value=9]").remove();
}
