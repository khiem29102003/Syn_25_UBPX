    </text>
  </css>

  <script>
    &VoucherRequest;
    &VoucherSaleRequest;
		<request code="ma_dk_ngay">
			<text>
			  <![CDATA[
				  select @t2_yn = 1,@t3_yn = 1,@t4_yn = 1,@t5_yn = 1,@t6_yn = 1,@t7_yn = 1,@t8_yn = 1
				  select @t2_yn as [!t2_yn],@t3_yn as [!t3_yn],@t4_yn as [!t4_yn],@t5_yn as [!t5_yn],@t6_yn as [!t6_yn],@t7_yn as [!t7_yn],@t8_yn as [!t8_yn]
			]]>
			</text>
		  </request>
    <query>
      <text>
        <![CDATA[
if @action = 'EDIT' begin
]]>&CheckUpdatingDeleting;<![CDATA[
end
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
if @action in ('EDIT', 'VIEW') exec ISWIFTStoreGetListFiles 'xfile', @id, '@@voucherCode', '', @script output
if @script is null set @script = ''

if @action = 'NEW' begin
  declare @ma_nk varchar(32), @ten_nk nvarchar(3000), @ngay_ct date, @so_ct varchar(32), @i_so_ct int, @unit_id int
  select @ngay_ct = getdate(), @unit_id = @@unit
  
  
]]>&VoucherNumberQuery;<![CDATA[
  if @so_ct is null
    select '' as [so_ct], 0 as [i_so_ct], @unit_id as [unit_id], '' as ma_nk, '' as ten_nk
  else
    select @so_ct as [so_ct], @i_so_ct as [i_so_ct], @unit_id as [unit_id], @ma_nk as ma_nk, @ten_nk as ten_nk
end
else select @script as script
drop table #@@table
         ]]>
      </text>
    </query>

    <declare>
      <text>
        <![CDATA[
declare @warning nvarchar(256), @dOldVoucherDate date, @dVoucherDate date, @nVoucherType tinyint, @strIds varchar(256), @q nvarchar(4000)
set @warning = ''
         ]]>
      </text>
    </declare>

    &VoucherJSLoading;

    <beforesave>
      <text>
        &VoucherNumberBeforeSave;
      </text>
    </beforesave>

    <deleting>
      <text>
        &CheckUpdatingDeleting;
        <![CDATA[
select @dOldVoucherDate = ngay_ct, @dVoucherDate = ngay_ct, @nVoucherType = ma_ngv from s03 where id = @id
        ]]>
      </text>
    </deleting>

    <deleted>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
-- Áp dụng cho dữ liệu lớn
--exec ISWIFTStoredDeleteDataWithKey 'v03', @strIds, '', @dVoucherDate
--exec ISWIFTStoredDeleteDataWithKey 'v03_1', @strIds, '', @dVoucherDate
--exec ISWIFTStoredDeleteDataWithKey 'v03_2', @strIds, '', @dVoucherDate

        ]]>
      </text>
    </deleted>

    <updating>
      <text>
        <![CDATA[
select @dOldVoucherDate = ngay_ct from s03 where id = @id
        ]]>
      </text>
    </updating>

    <updated>
      <text>
        <![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId, i_so_ct = @i_so_ct, so_ct = @so_ct where [%whereFieldKey]
update dmttin set status = 0 from dmttin where id0 = rtrim(@id) and xgroup = '@@voucherCode'
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
         ]]>
      </text>
    </updated>

    <inserting>
      <text>
        <![CDATA[
select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @ma_ct = '@@voucherCode'
exec ISWIFTStoredGetIdentityNumber '@@voucherCode', '@@table', @id output
         ]]>
      </text>
    </inserting>

    <inserted>
      <text>
        <![CDATA[
if @xfile <> '' update dmttin set status = 1, id0 = @id from dmttin where charindex(id, @xfile) > 0 and xgroup = '@@voucherCode'
]]>
      </text>
    </inserted>

    <aftersave>
      <text>
        <![CDATA[
select @strIds = rtrim(@id)
if @action = 'NEW' set @dOldVoucherDate = @ngay_ct
update @v03 set id = @id, ma_kh = @ma_kh, ngay_ct = @ngay_ct, so_ct = @so_ct, status = @status
update @v03 set ma_hang = @ma_hang, ma_noi_di = @ma_noi_di, ma_noi_den = @ma_noi_den, ngay_hl = @ngay_hl, ngay_hld = @ngay_hld
delete @v03 where so_luong = 0 or gia2 =0
delete v03 where id = @id
insert v03 select * from @v03

update @v031 set id = @id, ma_kh = @ma_kh, ngay_ct = @ngay_ct, so_ct = @so_ct, status = @status
update @v031 set ma_hang = @ma_hang, ma_noi_di = @ma_noi_di, ma_noi_den = @ma_noi_den, ngay_hl = @ngay_hl, ngay_hld = @ngay_hld
delete @v031 where so_luong = 0 or gia2 =0

delete v031 where id = @id
insert v031 select * from @v031

update @v03_1 set id = @id 
delete v03_1 where id = @id
insert v03_1 select * from @v03_1


update @v03_2 set id = @id
delete v03_2 where id = @id
insert v03_2 select * from @v03_2


declare @t_sl numeric(19,4)
select @t_sl=isnull(sum(so_luong),0) from @v03 
update s03 set t_so_luong =@t_sl where id = @id


declare @t2_sl numeric(19,4)
select @t2_sl=isnull(sum(so_luong),0) from @v031
update s03 set t2_so_luong =@t2_sl where id = @id

--exec ISWIFTStoredPostingVoucher 's03', 'v03', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
--exec ISWIFTStoredPostingVoucher 's03', 'v03_1', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''
--exec ISWIFTStoredPostingVoucher 's03', 'v03_2', @dOldVoucherDate, @ngay_ct, @id, '@@voucherCode', '', ''

exec ISWIFTStoredIncreaseVoucherNo @ma_nk, @ngay_ct, '@@voucherCode', @i_so_ct, @so_ct, '@@table'
select '' as message, @warning as warning, @id as [#id], @so_ct as [#so_ct], @ma_unit as [#ma_unit]
]]>
      </text>
    </aftersave>
  </script>

  <messages>
    <message val="physicalRetrieve">
      <text v="Chỉ xử lý nghiệp vụ sổ sách lấy dữ liệu từ thực tế" e="" />
    </message>
	 <message val="noDate">
      <text v="Ngày hiệu lực đến không hợp lệ." e="Error Expiry Date."/>
    </message>
  </messages>
</dir>