<css>
    <text>
      <![CDATA[
.control-label.t_tien_nt2, .control-label.t_tien, .control-label.t_so_luong,
.control-label.t2_tien_nt2, .control-label.t2_tien, .control-label.t2_so_luong,
.input-field.t_tien_nt2, .input-field.t_tien, .input-field.t_so_luong, .input-field.t_tien2,
.input-field.t2_tien_nt2, .input-field.t2_tien, .input-field.t2_so_luong, .input-field.t2_tien2
{
  font-weight:bold;

}
.control-label.ma_noi_di, .control-label.ma_noi_den, .control-label.ma_hang, .control-label.ngay_hld, .control-label.so_ngay_vc

{
	font-weight:bold;	
	color: #499b98;
}


.input-field.status, .input-field.unit_id
{
	color: #ab6926;
}
.control-label.ma_phi, .control-label.ma_phi
{
    font-weight:bold;
	color: red;
}
