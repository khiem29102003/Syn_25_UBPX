<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields03.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields04.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from s53 where id = @id and status in (5)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="s53" table="s53" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="TG3" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Tìm giá vận tải hàng không" e="Find Air Freight Rates"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
		<field name="ma_kh" allowBlank="false" label="1" field="1"  hidden="true">
          <text v="Mã khách hàng" e="Customer Code"></text>
        </field>
		<field name="ma_noi_di" viewType="Lookup" label="1" field="1" allowBlank="false">
			<text v="Nơi đi" e="Origin"></text>
			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="hk_yn = 1 and status =1" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
		</field>
		<field name="ten_noi_di" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1"  aliasName="cast('' as nvarchar(4000)) as ">
			<text v="" e=""></text>
		</field> 	
		<field name="ma_gd" nextRow="false" viewType="Combobox" valueDefault="" label="[100]" field="[120]"		>
          <text v="Giao dịch" e="Transaction Code"></text>
          <viewInfo>
            <options query="select ma_gd, ten_gd%l from dmgd where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
		<field name="ma_noi_den" viewType="Lookup" label="1" field="1" allowBlank="false ">
			<text v="Nơi đến" e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="hk_yn = 1 and status =1" lookupCheck="1=1" lookupRef="ten_noi_den" lookupInfo="vdmcangden|ma_noi_den|ten_noi_den"/>
		</field>
		<field name="ten_noi_den" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="-" aliasName="cast('' as nvarchar(200)) as ">
			<text v="" e=""></text>
		</field> 
		<field name="t_tong_trong" dataType="N" disabled="false" format="FCAmount" hidden="false">
			<text v="Trọng lượng(KGS)" e="Gross Weight(KGS)"></text>
		</field>
		<field name="tt" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="[140]" field="0">
          <text v="Thông tin khách hàng " e="Customer Information: "></text>
        </field>	
		<field name="ma_so_thue" label="1" field="[120]"  importable="35" nextRow="false" allowBlank="true">
          <text v="Mã số thuế &lt;a onclick='getTax(this);'&gt;(Kiểm tra)&lt;/a&gt;" e="Tax Code &lt;a onclick='getTax(this);'&gt;(Test)&lt;/a&gt;"></text>
        </field>
		<field name="dien_thoai" label="[80]" field="[120]" importable="80" nextRow="false"  allowBlank="false">
          <text v="Điện thoại" e="Phone"></text>
        </field>
		<field name="ten_kh" allowBlank="true" label="1" field="[250]" importWidth="250" importable="10">
          <text v="Tên khách hàng" e="Name"></text>
        </field>     
		<field name="nguoi_lh" label="[80]" field="1" importable="40" nextRow="false">
          <text v="Người liên hệ" e="Contact"></text>
        </field>
		<field name="dia_chi" label="1" field="[250]" importWidth="250" importable="30">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		
		<field name="email" label="[80]" field="1" importable="80" nextRow="false"  allowBlank="true">
          <text v="Email" e="Email"></text>
        </field>
		 <field name="ten_kh2" label="1" field="-" hidden="true" importWidth="250"  importable="15">
          <text v="Tên quốc tế" e="Name 2"></text>
        </field>
		
		<field name="tt2" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="[180]" field="">
          <text v="Đơn vị vận chuyển &lt;a onclick='getRequest2(this);'&gt;(Lấy số liệu)&lt;/a&gt; " e="Transport info &lt;a onclick='getRequest2(this);'&gt;(get data)&lt;/a&gt;"></text>
        </field>
		<field name="cvc_yn" dataType="B" clientDefault="true" label="[60]" field="[40]" nextRow="false" valueDefault="1"  inactivate="true">
          <text v="Cước vc" e="Freight"></text>
        </field>
		<field name="xk_yn" dataType="B" clientDefault="true" label="[60]" field="[40]" nextRow="false" valueDefault="1"  inactivate="true">
          <text v="Xuất khẩu" e="Export"></text>
        </field>
		<field name="nk_yn" dataType="B" clientDefault="true" label="[60]" field="[40]" nextRow="false" valueDefault="1"  inactivate="true">
          <text v="Nhập khẩu" e="Import"></text>
        </field>
		<field name="pp_yn" dataType="B" clientDefault="true" label="[60]" field="[40]" nextRow="false" valueDefault="1"  inactivate="true">
          <text v="Phụ phí" e="Surcharge"></text>
        </field>
		<field name="ma_hang" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false">
		  <text v="Hãng tàu/ Đại lý" e="Carrier/ Agent Code"></text>
		  <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_hang" lookupInfo="dmkh|ma_kh|ten_kh" />
		</field>
		<field name="ten_hang" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="-" aliasName="cast('' as nvarchar(200)) as ">
		  <text v="" e=""></text>
		</field>			
		<field name="ds_ngay" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false">
			<text v="Lịch vận chuyển" e="Schedule Days"></text>
			<viewInfo lookupType="Multi" lookupId="dmbgn" lookupKey="status=1 and ma_ct ='DIW'" lookupCheck="status=1" lookupRef="" lookupInfo="dmbgn|ma_bgn|ten_bgn" />
		</field>
		<field name="ngay_hl"  label="[100]" field="[120]" dataType="D" valueDefault="new Date()" allowBlank="false" nextRow="false" >
			<text v="Hiệu lực từ/ đến:" e="Effective date"></text>
		</field>	
		<field name="ngay_hld" label="" field="[120]" dataType="D" allowBlank="false" nextRow="false" >
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>	
					
		<field name="dien_giai" label="1" rows="1" field="-">
		  <text v="Diễn giải" e="Explain"></text>
		</field>
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_yc" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        &VoucherRequiredFields02;
		<field name="tt3" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="[250]" field="">
          <text v="|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|" e="Conditions of transport"></text>
        </field>
		<field name="ma_dk_vc" viewType="Combobox" valueDefault="" label="1" field="1" nextRow="true" >
			<text v="Đi thẳng/Chuyển tải" e="Direct / Transit"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'VT' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>	
		<field name="ma_cuoc" viewType="Combobox" valueDefault=""  nextRow="false" label="[90]" field="[150]" >
			<text v="Loại cước" e="Prepaid / Collect"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'LCC' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>	
		<field name="so_ngay_vc" label="[140]" field="[100]"  dataType="N" format="Amount" nextRow="true">
		  <text v="T.Gian v.chuyển (ngày)" e="Transit time (Days)"></text>
		</field>
      </fields>
    </form>
   
    <form tabPageIndex="1" gravity="MiddleLeft" height="300" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="v53" allowBlank="true" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>
    <form tabPageIndex="5" gravity="MiddleLeft" height="0" columns="120,120,120,120" >
      <text v="Khác" e="Other"></text>
      <fields>
        <field name="ma_nv" clientDefault="true" viewType="Lookup" label="1" field="1" setype="1">
          <text v="Mã nhân viên" e="Sale"></text>
          <viewInfo lookupType="One" lookupId="dmnv" lookupKey="status=5" lookupCheck="1=1" lookupRef="ten_nv" lookupInfo="dmnv|ma_nv|ten_nv" />
        </field>
        <field name="ten_nv" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptvc" viewType="Lookup" label="1" field="1">
          <text v="Phương tiện v/c" e="Transportation"></text>
          <viewInfo lookupType="One" lookupId="dmptvc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptvc" lookupInfo="dmptvc|ma_ptvc|ten_ptvc" />
        </field>
        <field name="ten_ptvc" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_pttt" viewType="Lookup" label="1" field="1">
          <text v="Ph/th thanh toán" e="Payment Methods"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ma_ptgh" viewType="Lookup" label="1" field="1">
          <text v="Ph/th giao hàng" e="Delivery Methods"></text>
          <viewInfo lookupType="One" lookupId="dmptgh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ptgh" lookupInfo="dmptgh|ma_ptgh|ten_ptgh" />
        </field>
        <field name="ten_ptgh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		
		<field name="t_ck_nt" label="1" field="1" dataType="N" disabled="true" hidden="true" format="FCAmount" >
          <text v="Tổng chiết khấu" e="Total Tax"></text>
        </field>
        <field name="t_ck" label="" field="1" nextRow="false" disabled="true" dataType="N" hidden="true" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_tc_tien_nt2" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền hàng" e="Total Tax"></text>
        </field>
        <field name="t_tc_tien2" label="" field="1" nextRow="false" disabled="true" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_km_nt" label="1" field="1" fieldType="EX" dataType="N" disabled="true" hidden="true" format="FCAmount" >
          <text v="Tổng tiền KM" e="Total Tax"></text>
        </field>
        <field name="t_km" label="" field="1" nextRow="false" disabled="true" fieldType="EX" dataType="N" hidden="true" format="Amount" >
          <text v="" e=""></text>
        </field>
			
      </fields>
    </form>

  
    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="TG3" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>

    <form gravity="BottomLeft" columns="100,100,100,100,100,100,130" >
      <fields>
	   <field name="t_so_luong" label="1" field="1" dataType="N" disabled="true" format="Amount" >
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
       
        <field name="t_tien2" nextRow="false" label="1" field="1" hidden="false" disabled="true" dataType="N" format="Amount" >
          <text v="Tổng tiền" e="Total Amount"></text>
        </field>
		<field name="t_tt" label="" field="1" nextRow="false" disabled="true" hidden="false" dataType="N" format="Amount" >
          <text v="" e=""></text>
        </field>
        <field name="t_tien_nt2" hidden="true"  nextRow="true" label="1" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng thanh toán" e="Total Bill Amount"></text>
        </field>

		<field name="test"  nextRow="true" label="2" field="" dataType="N" fieldType="EX" disabled="true" format="FCAmount" >
          <text v="" e="Total Bill Amount"></text>
        </field>

		<field name="t_tl_ln" nextRow="true" label="[80]" field="[60]" hidden="true" disabled="true" dataType="N" format="FCAmount" >
          <text v="% Lợi nhuận" e="% Profit"></text>
        </field>
		
        <field name="t_thue_nt" blank="2" label="1" field="1" dataType="N" hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thuế" e="Total Tax"></text>
        </field>
        <field name="t_thue" label="" field="1" nextRow="false" disabled="true" hidden="true" dataType="N" format="Amount" >
          <text v="" e="Total Tax"></text>
        </field>
        <field name="t_tt_nt" nextRow="false" label="1" field="1" dataType="N"  hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng thanh toán" e="Total Amount"></text>
        </field>
        
		<field name="t_so_luongx" label="1" field="1" dataType="N" hidden="true" disabled="true" format="Amount" >
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
		 <field name="t_tien_ntx2"  blank="2" nextRow="true" label="1" hidden="true" field="1" dataType="N" disabled="true" format="FCAmount" >
          <text v="Tổng tiền bán" e="Total Bill Amount"></text>
        </field>
        <field name="t_tien_nt1" nextRow="false" label="1" field="1" dataType="N"  hidden="true" disabled="true" format="FCAmount" >
          <text v="Tổng tiền mua" e="Total Cost Amount"></text>
        </field>
        <field name="t_tien1" nextRow="false" label="" field="1" hidden="true" disabled="true" dataType="N" format="Amount" >
          <text v="" e="Total Amount"></text>
        </field>
        <field name="t_tienx2" nextRow="false" label="[60]" field="[100]" hidden="true" disabled="true" dataType="N" format="Amount" >
          <text v="Phụ thêm" e="Add Amount"></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="v53" table="v53" fieldKey="id, line" order="line" readOnly="false">
      <fields>
		<field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_phi" width="100" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã phí" e="Fee"></text>
          <viewInfo lookupType="One" lookupId="dmphi" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_phi" lookupInfo="dmphi|ma_phi|ten_phi" />
        </field>
        <field name="ten_phi" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmphi b on a.ma_phi = b.ma_phi ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
         <field name="ma_dk_phi" viewType="Combobox" width="130" readOnly="false">
			<text v="Loại phí" e="Fee type"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'LPH' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>	
		<field name="ma_dvt" width="80" allowBlank="true" viewType="Lookup" readOnly="false" >
          <text v="Đơn vị" e="Unit"></text>
          <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" />
        </field>
        <field name="ten_dvt" width="0" fieldType="EX" inactivate="true" readOnly="true" aliasName="x" join=" left join dmdvt x on a.ma_dvt = x.dvt ">
          <text v="Tên đơn vị" e="Fee Name"></text>
        </field>
		
        <field name="so_luong" dataType="N" format="Amount" allowBlank="false" valueDefault="1" width="100" readOnly="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
        <field name="ct_km" width="100" valueDefault="0" viewType="Combobox" inactivate="true" hidden="true" readOnly="false" >
          <text v="Loại hàng" e="Fee Type"></text>
          <viewInfo>
            <options>
              <option val="0">
                <text v="Hàng bán" e="Sale"/>
              </option>
              <option val="1">
                <text v="Hàng KM" e="Promotion"/>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="gia_nt1" dataType="N" hidden="true" format="FCPrice" width="100" readOnly="false"  >
          <text v="Giá mua " e=" Cost Price"></text>
        </field>
        
		 <field name="tien_nt1" dataType="N" hidden="true" format="FCAmount" width="100" valueDefault="0" readOnly="false" disabled="true" >
          <text v="Tiền mua" e="Cost Amount"></text>
        </field>
		
		<field name="gia_nt2" dataType="N" format="FCPrice" width="100" readOnly="true" >
          <text v="Giá bán" e="Bill Price"></text>
        </field>
        <field name="tien_nt2" dataType="N" format="FCAmount" valueDefault="0" width="100" readOnly="true" >
          <text v="Tiền bán" e="Bill Amount"></text>
        </field>
		<field name="gia_nt3" dataType="N" format="FCPrice" width="120" readOnly="false" >
          <text v="Giá thương lượng" e="Negotiable Price"></text>
        </field>
        <field name="tien_nt3" dataType="N" format="FCAmount" valueDefault="0" width="120" readOnly="false" disabled="true"  >
          <text v="Tiền thương lượng" e="Negotiable Money"></text>
        </field>
        <field name="tl_ck" dataType="N" format="Rate" width="100" hidden="true" readOnly="false" >
          <text v="Tl ck(%)" e="Dis.Rate"></text>
        </field>
        <field name="ck_nt" dataType="N" format="FCAmount" width="100" hidden="true" readOnly="false" clientDefault="true" >
          <text v="Ch.khấu " e=" Discount"></text>
        </field>
		 <field name="ma_nt" width="70" allowBlank="false" viewType="Lookup" readOnly="false" >
          <text v="Mã NT" e="Currency"></text>
          <viewInfo lookupType="One" lookupId="dmnt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nt" lookupInfo="dmnt|ma_nt|ten_nt" />
        </field>
		 <field name="ten_nt" width="0" fieldType="EX" inactivate="true" readOnly="true" aliasName="d" join=" left join dmnt d on a.ma_nt = d.ma_nt ">
          <text v="Tên phí" e="Fee Name"></text>
        </field>
		 <field name="ty_gia" dataType="N" format="Price" width="100" valueDefault="1" hidden="false" readOnly="false" >
          <text v="Tỷ giá" e="Curr.Rate"></text>
        </field>
        
        <field name="gia1" dataType="N" format="Price" width="100" hidden="true"  valueDefault="0" inactivate="true" readOnly="true" >
          <text v="Giá chuẩn" e="Std.Price"></text>
        </field>
        <field name="gia2" dataType="N" format="Price" width="0" inactivate="true" valueDefault="0" readOnly="true" >
          <text v="Giá bán" e="Price"></text>
        </field>
		<field name="gia3" dataType="N" format="Price" width="0" inactivate="true" valueDefault="0" readOnly="true" >
          <text v="Giá bán" e="Price"></text>
        </field>
		 <field name="tien1" dataType="N" format="Amount" width="100" inactivate="true" hidden="true"  valueDefault="0" readOnly="false" disabled="true" >
          <text v="Chi phí" e="Total Cost"></text>
        </field>
        <field name="tien2" dataType="N" format="Amount" width="100" inactivate="true" valueDefault="0" readOnly="false"  disabled="true">
          <text v="Tiền VND" e="Total Vietnamese dong"></text>
        </field>
		<field name="tien3" dataType="N" format="Amount" width="100" inactivate="true" valueDefault="0" readOnly="false" disabled="true" >
          <text v="Thương lượng" e="Total Negotiation"></text>
        </field>
		
        <field name="ck" dataType="N" format="Amount" width="100" inactivate="true" hidden="true" readOnly="false">
          <text v="Chiết khấu" e="Discount"></text>
        </field>
		<field name="thue_suat" dataType="N" format="0" width="60" readOnly="false"  valueDefault="0" hidden="false" clientDefault="true" >
          <text v="VAT(%)" e="Tax"></text>
        </field>
        <field name="thue_nt" dataType="N" format="FCAmount" width="100" hidden="true" readOnly="true">
          <text v="Thuế %s" e="%s Tax"></text>
        </field>
        <field name="thue" dataType="N" format="Amount" width="100" inactivate="true" hidden="true" readOnly="true">
          <text v="Thuế" e="Tax"></text>
        </field>
		<field name="tc_tien2" dataType="N" format="Amount" width="100" hidden="true" valueDefault="0" inactivate="false" readOnly="true" >
          <text v="" e="Total"></text>
        </field>
		<field name="tc_tien_nt2" dataType="N" format="Amount" width="100" hidden="true" valueDefault="0" inactivate="false" readOnly="true" >
          <text v="" e="Total "></text>
        </field>
		
		<field name="tt" dataType="N" format="Amount" width="100" hidden="false" valueDefault="0" inactivate="false" readOnly="true" >
          <text v="Tổng cộng" e="Total"></text>
        </field>
		<field name="tt_nt" dataType="N" format="Amount" width="100" hidden="true" inactivate="false" readOnly="true" >
          <text v="" e="Total "></text>
        </field>
		<field name="tien_ln" dataType="N" format="Amount" width="100" inactivate="false" valueDefault="0" readOnly="false" disabled="true" hidden="true"		>
          <text v="Lợi nhuận" e="Profit"></text>
        </field>
		<field name="dien_giai" width="200" inactivate="true" readOnly="false">
          <text v="Diễn giải" e="Explain"></text>
        </field>
      </fields>

