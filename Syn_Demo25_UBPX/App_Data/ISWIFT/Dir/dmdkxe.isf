<dir id="dmdkxe" table="dmdkxe" fieldKey="ma_xe,ngay_dk" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo đăng kiểm" e="Registration declaration"></title>
  <title0 v="Thêm" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120" >
      <fields>
        <field name="ma_xe" format="U" label="1" field="1" viewType="Lookup" clientDefault="true" allowBlank="false" fieldType="PK" >
          <text v="Xe đăng kiểm" e="Currency Code"></text>
          <viewInfo lookupType="One" lookupId="dmxe" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_xe" lookupInfo="dmxe|ma_xe|ten_xe" />
        </field>
        <field name="ten_xe" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="so_dk" label="1" field="1" allowBlank="false" >
          <text v="Số phiếu đăng kiểm" e="Date From"></text>
        </field>
		<field name="ngay_dk" label="1" field="1" valueDefault="new Date()" allowBlank="false" dataType="D" fieldType="PK">
          <text v="Ngày đăng kiểm" e="Date From"></text>
        </field>
		<field name="khoang_cach" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="1">
			<text v="" e=""></text>
		</field>
        <field name="ngay_hh" label="1" field="1" allowBlank="false" dataType="D" nextRow="false" fieldType="PK">
          <text v="Ngày hết hạn" e="Date From"></text>
        </field>
		
       
      </fields>
    </form>
  </forms>

  &DefaultButton;

