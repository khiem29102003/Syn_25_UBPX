        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="retrieve">
          <text v="$RetrieveToolbar" e="$RetrieveToolbar"></text>
          <items>
            <button id="10">
              <text v="Lấy dữ liệu từ đơn hàng"  e="Extract Data from Purchase Orders"/>
            </button>
            <button id="20">
              <text v="Lấy dữ liệu từ phiếu xuất"  e="Extract Data from Pick List"/>
            </button>
            <button id="80">
              <text v="-"  e="-"/>
            </button>
            <button id="90">
              <text v="Xem các hóa đơn liên quan"  e="View Invoice"/>
            </button>
          </items>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
