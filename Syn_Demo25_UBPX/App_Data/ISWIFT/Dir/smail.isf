<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields09.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from smail where id = @id and status in (5,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="smail" table="smail" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="SM1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Mail" e="Mail"></title>
  <title0 v="Mới - Mail" e="New - Mail"></title0>
  <title1 v="Sửa - Mail" e="Edit - Mail"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>

        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true" importable = "-1">
          <text v="" e=""></text>
        </field>
		<field name="s_mail" format="L" allowBlank="false" viewType="Lookup" label="1" field="2" importable ="10">
			<text v="Email gửi" e="Email Sent"></text>
			<viewInfo lookupType="One" lookupId="dmsmail" lookupKey=" status = 1" lookupCheck="1=1" lookupRef="ten_mail" lookupInfo="dmsmail|s_mail|ten_mail" />
		</field>
		<field name="ten_mail" allowBlank="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="[150]"  aliasName="cast('' as nvarchar(4000)) as ">
			<text v="" e=""></text>
		</field> 
		<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" importable ="15">
			<text v="Ngày hiệu lực " e="Effective date"></text>
		</field>
		<field name="di_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
			<text v="" e=""></text>
		</field>
		<field name="ngay_hld" label="[100]" field="[120]" dataType="D" allowBlank="false" nextRow="false" importable ="20">
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>
		<field name="title" label="1" rows="1" field="-" allowBlank="false" importWidth="300" importable ="25">
          <text v="Tiêu đề" e="Subject"></text>
        </field>
		<field name="link" label="1" rows="1" field="-" allowBlank="true" importable ="-1">
          <text v="CC" e="CC"></text>
        </field>
		<!-- <field name="email_body" rows="10" label="0" allowBlank="false" field="-" importWidth="500" importable = "30"> -->
          <!-- <text v="Nội dung" e="Body"></text> -->
        <!-- </field> -->
      </fields>
    </form>
	
    <form gravity="TopRight" columns="120,120" >
      <fields>
			&VoucherRequiredFields01;
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="200" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="smailct" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>

	<form tabPageIndex="2" gravity="MiddleLeft" height="0" columns="120,120" >
	  <text v="Đính kèm" e="Attach Files"></text>
	  <fields>
		<field name="xfile" label="1" field="-" viewType="File" fieldType="EXParam">
		  <text v="Chọn files" e="Attach Files"></text>
		  <viewInfo fileFieldId0="id" fileGroup="SM1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
		</field>
	  </fields>
	</form>
    <form gravity="BottomLeft" columns="120,120" >
      <fields>
		<field name="email_body" rows="10" label="1" allowBlank="true" field="-" importWidth="500" importable = "30" hidden="true" >
          <text v="Nội dung" e="Body"></text>
        </field>
		
		<field name="email_body_con" rows="10" label="1" allowBlank="true" field="-" importWidth="500" fieldType="EX" >
          <text v="Nội dung" e="Body"></text>
        </field>
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="smailct" table="smailct" fieldKey="id, line" order="line" allowFilter="true" readOnly="false" allowOrder="true" >
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
		<field name="r_mail" format="L" allowBlank="true" viewType="Lookup" width= "120" hidden="false" disabled="false" readOnly="false" importable = "35">
          <text v="Email nhận" e="Email Recipient"></text>
          <viewInfo lookupType="One" lookupId="dmrmail" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_mail" lookupInfo="dmrmail|r_mail|ten_mail"/>
        </field>
		<field name="ten_mail" allowBlank="true" width= "450" inactivate="false" readOnly="true" aliasName="b" join=" left join dmrmail b on a.r_mail = b.r_mail " >
          <text v="Tên mail" e="Mail Name"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="retrieve">
          <text v="$RetrieveToolbar" e="$RetrieveToolbar"></text>
          <items>
            <button id="80">
              <text v="-"  e="-"/>
            </button>
          </items>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc>U/mDQPPo7y8u4tUKy47DCbwoFxQK/K35+gTQlTp0FMMnRldg9FhGs38N8aL1BlUXvBcc1Uy3pqLSKvEdXtk3WglFku2o9YOW1/CalxF0lRInm9rISJI6OEZzNkJrGGxWYt2QowdT+ebaIdPPikOmHrnsSSrrc5a76MNCGG2hDD4=</enc>]]>
          </text>
        </query>
      </script>

    </grid>

  </grids>

