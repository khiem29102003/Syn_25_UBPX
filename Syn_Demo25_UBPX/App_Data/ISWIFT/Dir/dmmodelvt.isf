      <text>
        <![CDATA[<enc>Z9VhYZh2kwIxlkbOHgUwsCXFSp2ZJjeiHvMVV9R5vaZSmHkyLKxVwmORxYP++FUdl7D/7biIe0IxlYXzRGj65xn0AkQzU5CrzPQ1LmymPhEuVl+An14LpG3pDuLwxrtOGj0pD8d+KaPOP4FLyIMRfSuET2gCrWmO06tGC2rs3TNlzw5+1k2ScJUxfDpE4r172paSGnRLZ5tNQboQCKaYbBS37q4PJR+yN3Br+h39fgHLInKmoXMKmdoHb3qmO4qa</enc>]]>
      </text>
    </inserting>
	<importing>
      <text>
        <![CDATA[<enc>OJTGoSIy8QCZeoyJMmdxeUd7FCB/9CUKI3D1cWkrCmCczF6fKYxFNFvElWRVu3fA</enc>]]>
      </text>

    </importing>
  </script>
  
	<messages>
		<message val="codeExistsNewMsg">
			<text v="Mã hàng hóa và mã model đã cùng tồn tại trong danh mục." e="The product code and model code already exist in the inventory."/>
		</message>
		<message val="codeExistsEditMsg">
			<text v="Mã hàng hóa và mã model đã cùng tồn tại trong danh mục." e="The product code and model code already exist in the inventory."/>
		</message>
	</messages>
</dir>