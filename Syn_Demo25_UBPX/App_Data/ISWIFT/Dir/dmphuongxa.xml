<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmphuongxa" table="dmphuongxa" fieldKey="ma_phuongxa" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phường/xã" e="Ward/Commune List"></title>
  <title0 v="Thêm mới - phường/xã" e="New - Ward/Commune"></title0>
  <title1 v="Sửa - phường/xã" e="Edit - Ward/Commune"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
		<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
		  <text v="" e=""></text>
		</field>
        <field name="ma_phuongxa" format="U" label="1" field="1" allowBlank="false" fieldType="PK" importable="5">
          <text v="Mã phường/xã" e="Ward/Commune Code"></text>
        </field>
        <field name="ten_phuongxa" label="1" field="-" allowBlank="false" importable="10">
          <text v="Tên phường/xã" e="Ward/Commune Name"></text>
        </field>
		<field name="ten_phuongxa2" label="1" field="-" allowBlank="true" importable="15">
          <text v="Tên tiếng anh" e="English Name "></text>
        </field>
		<field name="ma_loai" viewType="Combobox" inactivate="false" label="1" field="1" nextRow="true" importable="20" >
		  <text v="Mã loại" e="Type Code"></text>
		  <viewInfo>
			<options query="select ma_loai, ten_loai%l from dmloaiphuongxa where status = 1 ">
			</options>
		  </viewInfo>
		</field>
		<field name="ma_ttp" viewType="Lookup" label="1" field="1" clientDefault="true" importable="25">
          <text v="Tỉnh thành" e="Province/City"></text>
          <viewInfo lookupType="One" lookupId="dmttp" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ttp" lookupInfo="dmttp|ma_ttp|ten_ttp" importCheck="@@DF and z.status=1" />
        </field>
        <field name="ten_ttp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true">
          <text v="" e=""></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
		  <text v="Trạng thái" e="Status"></text>
		  <viewInfo>
			<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
			</options>
		  </viewInfo>
		</field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmphuongxa(p){
  this.constructor(p);
}
dir$dmphuongxa.prototype = new DirEvent();
dir$dmphuongxa.prototype.afterInit = function(){
  var p = this._dir, g = p.grid();
  dir$dmphuongxaDisabledMasterField(p, g);
}
function dir$dmphuongxaDisabledMasterField(p, g){
  
  if(p.valForm('ma_phuongxa').trim() != '')
  {
    p.setDisabled('ma_phuongxa', true);
  }
  else
  {
    p.setDisabled('ma_phuongxa', false);
  }
}
         ]]>
    </text>
  </js>
  <css>
		<text>
		  <![CDATA[
	.control-label.ma_phuongxa, .control-label.ten_phuongxa
	{	
		color: #499b98;;
	}
		  ]]>
		</text>
  </css>

	<script>
		<query>
		  <text>
			<![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table
drop table #@@table
			 ]]>
		  </text>
		</query>
		<updated>
		  <text>
			<![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]
			 ]]>
		  </text>
		</updated>
		<inserting>
		  <text>
			<![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
			]]>
		  </text>
		</inserting>
		<importing>
			<text>
			<![CDATA[
update #data set unit_id = @@unit
@@insert
			]]>
			</text>
		</importing>
	</script>
  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã phường/xã đã tổn tại." e="Ward/Commune code already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã phường/xã đã tổn tại." e="Ward/Commune code already exists."/>
    </message>
  </messages>
</dir>