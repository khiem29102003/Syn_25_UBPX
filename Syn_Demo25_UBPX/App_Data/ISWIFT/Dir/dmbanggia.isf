<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmbanggia" table="dmbanggia" fieldKey="ma_bg" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Bảng giá/ Nhãn hàng" e="Service List"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_bg" format="U" label="1" field="2" readOnly="true" allowBlank="false" fieldType="PK">
          <text v="Mã Bảng giá" e="Service Code"></text>
        </field>
        <field name="ten_bg" label="1" field="2" allowBlank="false">
          <text v="Tên Bảng giá" e="Description"></text>
        </field>
		
      
		<field name="thu_tu" label="1" field="2" dataType="N">
          <text v="Thứ tự" e="Position"></text>
        </field>
		<field name="tool_tip" label="1" field="2" >
          <text v="Tool_tip(?)" e="Position"></text>
        </field>
		
		
		<field name="ma_loai" viewType="Lookup" label="1" field="1" clientDefault="true" importable="35" >
          <text v="Lĩnh vực" e="Item Type"></text>
          <viewInfo lookupType="One" lookupId="dmloailinhvuc" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_loai" lookupInfo="dmloailinhvuc|ma_loai|ten_loai" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_loai" nextRow="false" fieldType="EX" readOnly="true"  inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true">
          <text v="" e=""></text>
        </field>	
			<field name="thu_tu2" label="1" field="2"  >
          <text v="Thuộc" e="Position"></text>
        </field>
		
		
		<field name="pack1" dataType="B" blank ="1" clientDefault="false" label="[100]" field="[40]" valueDefault="1" inactivate="true" importable="40">
          <text v="Standard" e="Standard"></text>
        </field>
		<field name="pack2" dataType="B" clientDefault="false" label="[100]" field="[40]" inactivate="true" importable="45" nextRow="false">
          <text v="Professional" e="Professional"></text>
        </field>
		<field name="pack3" dataType="B" clientDefault="false" label="[100]" field="[40]" inactivate="true" importable="50" nextRow="false" hidden="false">
          <text v="Premium" e="Premium"></text>
        </field>
			<field name="pack4" dataType="B" clientDefault="false" label="[100]" field="[40]" inactivate="true" importable="50" nextRow="false" hidden="false">
          <text v="Customer" e="Customer"></text>
        </field>
		
		 
		
	
       <!-- <field name="ma_clvt" viewType="Lookup" label="1" field="1" clientDefault="true" importable="35"> -->
          <!-- <text v="Danh mục chính" e="Item Type"></text> -->
          <!-- <viewInfo lookupType="One" lookupId="dmclvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_clvt" lookupInfo="dmclvt|ma_clvt|ten_clvt" importCheck="@@DF and z.status=1"/> -->
        <!-- </field> -->
        <!-- <field name="ten_clvt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true"> -->
          <!-- <text v="" e=""></text> -->
        <!-- </field> -->
  
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>

      </fields>
    </form>
	 	 
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
<script>
  <request code="GetSTT">
	<text>
