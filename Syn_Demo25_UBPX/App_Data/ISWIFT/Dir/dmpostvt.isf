				</field>
				
				<field name="ma_lvtc2" viewType="Lookup" label="[100]" field="1" nextRow="false" importable="40" allowBlank="true">
					<text v="Mã NH cấp 2" e="Industry code level 2"></text>
					<viewInfo lookupType="One" lookupId="dmlvtc2" lookupKey="status=1 and ma_lvtc1 = ![ma_lvtc1]!" lookupCheck="1=1" lookupRef="ten_lvtc2" lookupInfo="dmlvtc2|ma_lvtc2|ten_lvtc2" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_lvtc2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1" aliasName="cast('' as nvarchar(4000)) as " >
					<text v="" e=""></text>
				</field>
				<field name="ma_lvtc3" viewType="Lookup" label="1" field="1" importable="45" allowBlank="true">
					<text v="Mã NH cấp 3" e="Industry code level 3"></text>
					<viewInfo lookupType="One" lookupId="dmlvtc3" lookupKey="status=1 and ma_lvtc2 = ![ma_lvtc2]!" lookupCheck="1=1" lookupRef="ten_lvtc3" lookupInfo="dmlvtc3|ma_lvtc3|ten_lvtc3" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_lvtc3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1" aliasName="cast('' as nvarchar(4000)) as " >
