				<field name="ma_th" format="U" viewType="Lookup" label="[120]" field="1" nextRow="false" clientDefault="true" allowBlank="true" importable="20" importWidth="50">
					<text v="Thương hiệu" e="Brand"></text>
					<viewInfo lookupType="One" lookupId="dmth" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_th" lookupInfo="dmth|ma_th|ten_th" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_th" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="[120]" aliasName="cast('' as nvarchar(4000)) as ">
