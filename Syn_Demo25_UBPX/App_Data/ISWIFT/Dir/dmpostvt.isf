				<field name="ma_loaibh" format="U" viewType="Lookup" label="[120]" field="1" nextRow="false" clientDefault="true" allowBlank="true" importable="20" importWidth="50">
					<text v="Loại bảo hành" e="Warranty type"></text>
					<viewInfo lookupType="One" lookupId="dmloaibh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_loaibh" lookupInfo="dmloaibh|ma_loaibh|ten_loaibh" importCheck="@@DF and z.status=1"/>
