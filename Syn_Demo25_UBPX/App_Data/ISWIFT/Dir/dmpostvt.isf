				<field name="ma_baohanh" format="U" viewType="Lookup" label="[120]" field="1" nextRow="true" clientDefault="true" allowBlank="true" importable="20" importWidth="50">
					<text v="Bảo hành" e="Warranty"></text>
					<viewInfo lookupType="One" lookupId="dmbaohanh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_baohanh" lookupInfo="dmbaohanh|ma_baohanh|ten_baohanh" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_baohanh" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="[120]" aliasName="cast('' as nvarchar(4000)) as ">
