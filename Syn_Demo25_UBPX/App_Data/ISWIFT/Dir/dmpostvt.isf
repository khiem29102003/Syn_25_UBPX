<dir id="dmpostvt" table="dmpostvt" fieldKey="ma_vt" dirViewType="Dialog" width="Large" xmlns="urn:schemas-iswift:struct-dir">
	<title v="Danh mục vật tư, sản phẩm" e="Product List"></title>
	<title0 v="Mới" e="New"></title0>
	<title1 v="Sửa" e="Edit"></title1>
	<forms>
		<form gravity="TopLeft" columns="120,120,120" >
			<fields>
				<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
					<text v="" e=""></text>
				</field>
				<field name="ma_vt" format="U" viewType="Lookup" label="1" field="1" allowBlank="false" fieldType="PK">
					<text v="Mã sản phẩm" e="Product Code"></text>
					<viewInfo lookupType="One" lookupId="dmvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="" lookupInfo="dmvt|ma_vt|ten_vt" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_vt" allowBlank="false" label="1" field="-" importable="10">
					<text v="Tên sản phẩm" e="Product Name"></text>
				</field>
				<field name="ten_vt2" allowBlank="true" label="1" field="-" importable="15">
					<text v="Tên khác" e="Other name"></text>
				</field>
				<field name="status" viewType="Combobox" valueDefault="1" label="1" field="[200]" nextRow="true" >
					<text v="Trạng thái" e="Status"></text>
					<viewInfo>
						<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 order by ma_tt">
						</options>
					</viewInfo>
				</field>
				<field name="images-container" label="-" field="0" fieldType="EX" disabled="true">
					<text v="&lt;div class='edit-label edit-title'&gt;
							&lt;div class='mandatory'&gt;
								&lt;span class='mandatory-icon'&gt;*&lt;/span&gt;
							&lt;/div&gt;
							&lt;span &gt;Hình ảnh sản phẩm&lt;/span&gt;
						&lt;/div&gt;
						&lt;div id='imageUploadArea' style='display: flex; margin-bottom: 20px;'&gt;
							&lt;input type='hidden' id='refId' value='product_123' /&gt;

							&lt;!-- Dòng ảnh ngang --&gt;
							&lt;div id='imageList' class='image-grid'&gt;&lt;/div&gt;

							&lt;!-- Nút thêm ảnh --&gt;
							&lt;button id='addImageLabel' onclick='document.getElementById(`imagePicker`).click();'&gt;
								&lt;div style='color: #ee4d2d;text-align: center;display: -webkit-box;display: -ms-flexbox;display: flex;-webkit-box-orient: vertical;-webkit-box-direction: normal;-ms-flex-direction: column;flex-direction: column;-webkit-box-pack: center;-ms-flex-pack: center;justify-content: center;-ms-flex-line-pack: center;align-content: center;padding: 0 2px;line-height: 20px;'&gt;
									&lt;div style='font-size: 24px;'&gt;📷&lt;/div&gt;
									&lt;span&gt;Thêm hình ảnh&lt;/span&gt;
									&lt;span id='imageCount'&gt;(0/9)&lt;/span&gt;
								&lt;/div&gt;
							&lt;/button&gt;
						&lt;/div&gt;" e="Images"></text>
				</field>
				
				<field name="banner-container" label="-" field="0" fieldType="EX" disabled="true">
					<text v="&lt;div class='edit-label edit-title'&gt;
							&lt;div class='mandatory'&gt;
								&lt;span class='mandatory-icon'&gt;*&lt;/span&gt;
							&lt;/div&gt;
							&lt;span &gt;Ảnh bìa&lt;/span&gt;
						&lt;/div&gt;
						&lt;div style='display: flex; gap: 10px; margin-bottom: 20px;' &gt;
							&lt;div id='mainImagePreview' class='main-preview main-image-preview' &gt;
								Chưa có ảnh
							&lt;/div&gt;
							
							&lt;ul class='edit-label edit-title' style='flex-flow: column; list-style-type: disc;' &gt;
								&lt;li &gt;
									Tải lên hình ảnh 1:1.
								&lt;/li&gt;
								&lt;li &gt;
									Ảnh bìa sẽ được hiển thị tại các trang Kết quả tìm kiếm, Gợi ý hôm nay,... Việc sử dụng ảnh bìa đẹp sẽ thu hút thêm lượt truy cập vào sản phẩm của bạn
								&lt;/li&gt;
							&lt;/ul&gt;
						&lt;/div&gt;" e="Banner"></text>
				</field>
				
				<field name="video-container" label="-" field="0" fieldType="EX" disabled="false">
					<text v="&lt;div class='edit-label edit-title'&gt;
							&lt;span &gt;Video sản phẩm&lt;/span&gt;
						&lt;/div&gt;

						&lt;div style='display: flex; gap: 10px; margin-bottom: 20px;' &gt;
							&lt;div style='display: flex; flex-direction: row; gap: 10px;'&gt;
								&lt;div id='mainVideoPreview' class='main-preview main-video-preview'&gt;
									Chưa có video
								&lt;/div&gt;
								
								&lt;button id='addVideoLabel' onclick='document.getElementById(`videoPicker`).click();'&gt;
									&lt;div style='color: #ee4d2d;text-align: center;display: -webkit-box;display: -ms-flexbox;display: flex;-webkit-box-orient: vertical;-webkit-box-direction: normal;-ms-flex-direction: column;flex-direction: column;-webkit-box-pack: center;-ms-flex-pack: center;justify-content: center;-ms-flex-line-pack: center;align-content: center;padding: 0 2px;line-height: 20px;'&gt;
										&lt;div style='font-size: 24px;'&gt;📷&lt;/div&gt;
										&lt;span&gt;Thêm video&lt;/span&gt;
									&lt;/div&gt;
								&lt;/button&gt;
							&lt;/div&gt;
							
							&lt;ul class='edit-label edit-title' style='flex-flow: column; list-style-type: disc;' &gt;
								&lt;li &gt;
									Kích thước tối đa 30Mb, độ phân giải không vượt quá 1280x1280px
								&lt;/li&gt;
								&lt;li &gt;
									Độ dài: 10s-60s
								&lt;/li&gt;
								&lt;li &gt;
									Định dạng: MP4
								&lt;/li&gt;
								&lt;li &gt;
									Lưu ý: sản phẩm có thể hiển thị trong khi video đang được xử lý. Video sẽ tự động hiển thị sau khi đã xử lý thành công.
								&lt;/li&gt;
							&lt;/ul&gt;
						&lt;/div&gt;" e="Video"></text>
				</field>
				
				<field name="images-multiple" label="0" field="0" fieldType="EX">
					<text v="&lt;input type='file' id='imagePicker' accept='image/*' multiple hidden /&gt;" e="&lt;input type='file' id='imagePicker' accept='image/*' multiple hidden /&gt;"></text>
				</field>
				
				<field name="video-multiple" label="0" field="0" fieldType="EX">
					<text v="&lt;input type='file' id='videoPicker' accept='video/mp4' multiple hidden /&gt;" e="&lt;input type='file' id='videoPicker' accept='video/mp4' multiple hidden /&gt;"></text>
				</field>
			</fields>
		</form>
		<form tabPageIndex="1" gravity="MiddleLeft" height="360" columns="120,120,120,120,120,120" >
			<text v="Thông tin cơ bản" e="General Information"></text>
			<fields>	
				<field name="ma_lvtc1" viewType="Lookup" label="1" field="1" importable="35" allowBlank="false">
					<text v="Mã NH cấp 1" e="Industry code level 1"></text>
					<viewInfo lookupType="One" lookupId="dmlvtc1" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_lvtc1" lookupInfo="dmlvtc1|ma_lvtc1|ten_lvtc1" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_lvtc1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1" aliasName="cast('' as nvarchar(4000)) as " >
