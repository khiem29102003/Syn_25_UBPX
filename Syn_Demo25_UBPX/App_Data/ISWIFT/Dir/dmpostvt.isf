				<field name="ma_htnhom1" nextRow="false" viewType="Combobox" valueDefault="" label="[100]" field="[120]">
				  <text v="Hiển thị theo" e="Transaction Code"></text>
				  <viewInfo>
					<options query="select ma_htnhom, ten_htnhom%l from dmhtnhom where status = 1 order by ma_htnhom">
					    <option val="">
							<text v="Trống" e="Empty"></text>
						</option>
					</options>
				  </viewInfo>
				</field>
				<field name="ma_lo" viewType="Lookup" label="1" field="1" clientDefault="true" importable="55">
					<text v="Mã lô" e="Lot Number "></text>
					<viewInfo lookupType="One" lookupId="dmlo" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_lo" lookupInfo="dmlo|ma_lo|ten_lo" importCheck="@@DF and z.status=1"/>
