					<viewInfo lookupType="One" lookupId="dmlvtc4" lookupKey="status=1 and ma_lvtc3 = ![ma_lvtc3]!" lookupCheck="1=1" lookupRef="ten_lvtc4" lookupInfo="dmlvtc4|ma_lvtc4|ten_lvtc4" importCheck="@@DF and z.status=1"/>
