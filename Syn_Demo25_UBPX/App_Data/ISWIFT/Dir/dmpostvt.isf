				<field name="dvt" format="U" viewType="Lookup" label="[120]" field="1" nextRow="true" clientDefault="true" allowBlank="false" importable="20" importWidth="50">
					<text v="Đơn vị tính" e="UOM"></text>
					<viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_dvt" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="[120]" aliasName="cast('' as nvarchar(4000)) as ">
