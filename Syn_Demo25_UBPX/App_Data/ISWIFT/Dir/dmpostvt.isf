					<text v="Mã NH cấp 5" e="Industry code level 5"></text>
					<viewInfo lookupType="One" lookupId="dmlvt" lookupKey="status=1 and ma_lvtc4 = ![ma_lvtc4]!" lookupCheck="1=1" lookupRef="ten_lvt" lookupInfo="dmlvt|ma_lvt|ten_lvt" importCheck="@@DF and z.status=1"/>
