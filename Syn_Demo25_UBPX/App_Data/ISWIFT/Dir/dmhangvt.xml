  <js>
    <text>
      <![CDATA[
function dir$dmkh(p){
  this.constructor(p);
}
dir$dmkh.prototype = new DirEvent();

dir$dmkh.prototype.formFieldValueChange = function (o, cF, v) {
  var p = this._dir;
  switch (cF){
    default:
      break;
  }
}

function getTax(o) {
  var p = document._dir;
  var tax = p.valForm('ma_so_thue');
  if (tax.length != 10 && tax.length != 13) {
    $.showToast('Thông tin mã số thuế không đúng.');
    return;
  }
  
  $.invoke('GetTax', { taxCode: tax }, this, 30000
    , function (result) {
      if (result) {
        var obj = JSON.parse(result);
        p.valForm('ten_kh', obj.Name, true);
        p.valForm('dia_chi', obj.Address, true);
		p.valForm('ten_kh2', obj.Other, true);
		p.valForm('nguoi_lh', obj.Contact, true);
		p.valForm('dien_thoai', obj.Telephone, true);
		
      }
    }, function (event) {} );
	
}

dir$dmkh.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

  dir$dmkhDisabledMasterField(p, g);
  var p = this._dir;
  document._dir = p;
}

function dir$dmkhDisabledMasterField(p, g){
	if(p.valForm('ma_kh').trim() != '') {
		p.setDisabled(['ma_kh'], true);
		p.setDisabled('vc_yn', true);
	}
	else {
		p.setDisabled(['ma_kh'], false);
		p.setDisabled('vc_yn', true)
	}
}
]]>
		
    </text>
