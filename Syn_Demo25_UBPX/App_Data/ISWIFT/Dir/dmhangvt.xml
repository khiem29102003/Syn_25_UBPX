  <script>
    
   <query>
      <text>
        <![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
select @script = '';
if @action = 'EDIT'
  if exists(select 1 from syscodeexists with(nolock, index(code1)) where code1 = @ma_kh and field = 'ma_kh')
    select @script = @script + 'p.setDisabled(''ma_kh'', true); '

if @action in ('EDIT', 'VIEW') select @script as script
drop table #@@table
         ]]>
      </text>
   </query>
	
   <inserting>
      <text>
        <![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

if @ma_so_thue <> '' and @ma_kh <> '' and exists (select 1 from dmkh where ma_so_thue = @ma_so_thue and ma_kh <> @ma_kh) begin
  select '$taxtCodeExists' as message, 'ma_so_thue' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
]]>
      </text>
   </inserting>
	
   <aftersave>
      <text>
        <![CDATA[
if @ma_so_thue <> '' and exists (select 1 from dmkh where ma_so_thue = @ma_so_thue and ma_kh <> @ma_kh)        
  select '$taxtCodeExists' as toast
]]>
      </text>
   </aftersave>


   <importing>
      <text>
        <![CDATA[
update #data set unit_id = @@unit
@@insert
        ]]>
      </text>
    </importing>
	
  </script>

  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã hãng vận tải đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The Trucking Company code already exists in the catalog, please choose a different code."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã hãng vận tải đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The Trucking Company code already exists in the catalog, please choose a different code."/>
    </message>
    <message val="taxtCodeExists">
