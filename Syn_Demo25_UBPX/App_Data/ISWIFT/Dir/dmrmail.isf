<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmrmail" table="dmrmail" fieldKey="ma_rmail" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục mail" e="List of mail"></title>
  <title0 v="Thêm mới" e="Create New"></title0>
  <title1 v="Sửa" e="Edit"></title1>


  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
	    <field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
          <text v="" e=""></text>
        </field>
		<field name="ma_rmail" format="U" label="1" field="1" allowBlank="true" fieldType="PK" importable="-1" >
          <text v="Mã" e="Code"></text>
        </field>
        <field name="r_mail" label="1" field="-" allowBlank="false" importable="5" >
          <text v="Email" e="Email"></text>
        </field>
        <field name="ten_mail" label="1" field="-" allowBlank="false" importable="10" >
          <text v="Tên mail" e="Full Name"></text>
        </field>
        <field name="ten_mail2" label="1" field="-" importable="15">
          <text v="Tên khác" e="Other Name"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" valueDefault="1" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="so_lan_gui" label="" field="" importable="-1">
          <text v="Số lần gửi" e="Total"></text>
        </field>
		<field name="lastsentdate" label="" field="" importable="-1">
          <text v="Lần gửi cuối" e="Other Name"></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
  
  <css>
	<text>
