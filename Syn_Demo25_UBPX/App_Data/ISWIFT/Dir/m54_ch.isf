          <text v="Tổng cộng" e="Total"></text>
        </field>
		
		<field name="ttx_nt" dataType="N" format="ExRate" width="100" hidden="true" inactivate="false" readOnly="true" >
          <text v="" e="Total "></text>
        </field>
        <field name="sl_pn" dataType="N" inactivate="true"  hidden="true" format="Qty" width="100" copy="false" aliasName="0*sox_luong as " >
          <text v="Sl đã nhập" e="Pur.Qty"></text>
        </field>
        <field name="id_pn" dataType="N" inactivate="true" hidden="true" format="0" width="80" copy="false">
          <text v="ID PN" e="ID PN"></text>
        </field>
        <field name="so_ct_pn" width="100" fieldType="EX"  hidden="true" copy="false" readOnly="true" inactivate="true" link="m72|id_pn as id" aliasName="cast('' as nvarchar(3000)) as ">
          <text v="Số PN" e="Issue No"></text>
        </field>
        <field name="line_pn" dataType="I" width="70"  hidden="true" copy="false" inactivate="true">
          <text v="Dòng pn" e="Issue Line"></text>
        </field>
        <field name="id_dh" dataType="N" inactivate="true" hidden="true" format="0" width="80" copy="false">
          <text v="ID ĐH" e="ID ĐH"></text>
        </field>
        <field name="so_ct_dh" width="100" fieldType="EX" copy="false"  hidden="true" readOnly="true" inactivate="true" link="s61|id_dh as id" aliasName="cast('' as nvarchar(3000)) as ">
          <text v="Số đơn hàng" e="Order No."></text>
        </field>
        <field name="line_dh" dataType="I" width="70"  hidden="true" copy="false" inactivate="true">
          <text v="Dòng ĐH" e="SO Line"></text>
        </field>
		<field name="so_hd" inactivate="false" hidden="false" width="150" copy="false" disabled="false" readOnly="false">
          <text v="Số Hóa Đơn" e="Invoice Number"></text>
        </field>
		<field name="ngay_hd" width="150" dataType="D" readOnly="false"  >
			<text v="Ngày Hóa Đơn " e="Effective date"></text>
		</field>
		<field name="dien_giai" width="300" inactivate="false" readOnly="false">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		
      </fields>

      <buttons>

        <button id="moveup">
