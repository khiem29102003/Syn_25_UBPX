        </field>
		<field name="kc3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="[20]" field="">
          <text v="" e=""></text>
        </field>
		<field name="t_tc_tieny_nt2" label="[100]" field="1" fieldType="EX" dataType="N" disabled="true" format="FCAmount" nextRow="false" >
          <text v="Tổng tiền hàng" e="Total Tax"></text>
        </field>
        <field name="t_tc_tieny2" label="" field="[120]" nextRow="false" disabled="true" fieldType="EX" dataType="N" format="Amount" >
