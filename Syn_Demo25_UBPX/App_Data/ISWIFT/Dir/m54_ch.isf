  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from m54 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
  if exists(select 1 from d56 with(index(id_hd)) where id_hd = @id) begin
    select '$DaTraLai' as message
    return
  end
  if exists(select 1 from cttt20 where id_tt = @id and loai_tt = 1) begin
    select '$DaThanhToan' as message
    return
  end
    ">
]>

<dir id="m54" table="m54" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="PX3" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Hóa đơn bán hàng" e="Sales Invoice"></title>
  <title0 v="Mới - Phiếu bán hàng" e="New"></title0>
  <title1 v="Sửa - Phiếu bán hàng" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120,120,120"  >
      <fields>
	  	<field name="tt" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="1" field="">
          <text v="Thông tin đơn hàng: " e="Order Information: "></text>
        </field>
		<field name="tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="1" field="">
          <text v="&lt;a onclick='getRequest(this);'&gt;(Từ đơn hàng)&lt;/a&gt; " e="&lt;a onclick='getRequest(this);'&gt;(From Order)&lt;/a&gt;"></text>
        </field>
		<field name="ma_ngv" viewType="Combobox" valueDefault="" label="1" field="1" hidden="true">
          <text v="Loại hóa đơn" e="Inv. Type"></text>
          <viewInfo>
            <options query="select ma_ngv, ten_ngv%l from dmngv where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
        <field name="ma_kh" allowBlank="true" viewType="Lookup" label="1" field="1" importable="5">
          <text v="Khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1 and ma_kh not in (select ma_kh from dmkh where nv_yn = 1)" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_tt" viewType="Lookup" label="1" field="1">
          <text v="Mã thanh toán" e="Credit Term"></text>
          <viewInfo lookupType="One" lookupId="dmtt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_tt" lookupInfo="dmtt|ma_tt|ten_tt" />
        </field>
        <field name="ten_tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="[200]" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="hbl_no" label="1" field="[120]" allowBlank="true" fieldType="EX" nextRow="false" disabled="true">
			<text v="Số B/L" e="B/L No"></text>
		</field>
        <field name="ma_pttt" viewType="Lookup" label="1" field="1">
          <text v="Ph/th thanh toán" e="Payment Methods"></text>
          <viewInfo lookupType="One" lookupId="dmpttt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_pttt" lookupInfo="dmpttt|ma_pttt|ten_pttt" />
        </field>
        <field name="ten_pttt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="[200]" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>


		<field name="so_tk" label="1" field="[120]" allowBlank="true" fieldType="EX" nextRow="false" disabled="true">
			<text v="Số tờ khai" e="Declaration No"></text>
		</field>	
	

	
		<field name="ma_hang" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false" nextRow="true" fieldType="EX" disabled="false">
		  <text v="Hãng tàu" e="Carrier"></text>
		  <viewInfo lookupType="One" lookupId="vdmhangtau" lookupKey="status = 1 and ncc_yn =1 " lookupCheck="1=1" lookupRef="ten_hang" lookupInfo="vdmhangtau|ma_hang|ten_hang" />
		</field>
		<field name="ten_hang" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="[200]" aliasName="cast('' as nvarchar(200)) as ">
		  <text v="" e=""></text>
		</field>
		<field name="t_tong_trong" dataType="N" label="1" field="[120]" format="FCAmount" hidden="false" disabled="false" nextRow="false">
			<text v="Trọng lượng(KGS)" e="Gross Weight(KGS)"></text>
		</field>
		<field name="ds_cong" allowBlank="true" fieldType="EX" viewType="Lookup" label="1" field="1"  hidden="false" disabled="false">
			<text v="Container" e="Container List"></text>
			<viewInfo lookupType="Multi" lookupId="dmcong2" lookupKey="status=1" lookupCheck="status=1" lookupRef="" lookupInfo="dmcong|ma_cong|ten_cong" />
		</field>
		<field name="tt5" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="[200]" field="">
          <text v="" e=""></text>
        </field>
		<field name="t_tong_khoi" dataType="N" label="1" field="[120]" format="FCAmount" nextRow="false"  hidden="false" disabled="false">
		  <text v="Volume(CBM)" e="Volume(CBM)"></text>
		</field>	
        <field name="dien_giai" label="1" rows="1" field="-">
          <text v="Diễn giải" e="Explain"></text>
        </field>
		<field name="ma_noi_di" viewType="Lookup" label="1" field="[120]" nextRow="true" allowBlank="true" fieldType="EX" disabled="true" hidden="true">
			<text v="Cảng đi" e="Origin"></text>
			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="(kkh_yn = 1 or hc_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
		</field>
		<field name="ten_noi_di" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field=""  aliasName="cast('' as nvarchar(4000)) as " hidden="true">
			<text v="" e=""></text>
		</field>
		<field name="ma_noi_den" viewType="Lookup" fieldType="EX" label="1" field="[120]" nextRow="true"  allowBlank="true" disabled="true" hidden="true">
			<text v="Cảng đến" e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="(kkh_yn = 1 or hc_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_den" lookupInfo="vdmcangden|ma_noi_den|ten_noi_den"/>
		</field>
		<field name="ten_noi_den" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="" aliasName="cast('' as nvarchar(200)) as ">
			<text v="" e=""></text>
		</field> 
		<field name="id" dataType="N" label="" field="1" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="ID" e="ID"></text>
		</field>
		<field name="id_dh" dataType="N" label="" field="1" format="0" hidden="true">
		  <text v="ID đơn hàng" e="Order ID"></text>
		</field>
		<field name="id_dh_nb" dataType="N" label="" field="1" format="0" hidden="true">
		  <text v="ID đơn hàng nội bộ" e="Internal Order ID"></text>
		</field>
		<field name="id_yc" dataType="N" label="" field="1" format="0" hidden="true">
		  <text v="ID yêu cầu" e="ID Request"></text>
		</field>
		<field name="id_bg" dataType="N" label="" field="1" format="0" hidden="true">
		  <text v="ID báo giá" e="Quotation ID"></text>
		</field>
		<field name="id_tg" dataType="N" label="" field="1" format="0" hidden="true">
		  <text v="ID đề nghị" e="ID Request"></text>
		</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;

        &VoucherRequiredFields02;
		<field name="ma_job_ct1" allowBlank="true" fieldType="EX" label="[60]" field="" disabled="true"   hidden="false">
          <text v="Số c/t đh" e="Job Code"></text>
        </field>
		<field name="ma_ct_dh" inactivate="true" fieldType="EX" hidden="false" nextRow="false" field="[60]" label="" disabled="true">
		  <text v="" e="Number"></text>
		</field>
		<field name="so_ct_dh" allowBlank="true" fieldType="EX" field="[120]" label="" disabled="true" nextRow="false" hidden="false">
          <text v="" e=""></text>
        </field>

		<field name="ma_job_ct2" allowBlank="true" fieldType="EX" label="[60]" field="" disabled="true"   hidden="false">
          <text v="Số job dh" e="Số file dh"></text>
        </field>
		<field name="ma_job" allowBlank="false" fieldType="EX" nextRow="false" label="" field="[60]"   hidden="false" tabIndex="1" disabled="true">
          <text v="" e="Job Code"></text>
        </field>
		<field name="so_job_dh" format="U" fieldType="EX" copy="false" hidden="false" nextRow="false" align="left" label="" field="[120]" disabled="true">
		  <text v="" e=""></text>
		</field>
		<field name="xstatus" viewType="Combobox" valueDefault="5" inactivate="true" label="[60]" field="[180]" hidden="true" >
		  <text v="Trạng thái" e="Status"></text>
		  <viewInfo>
			<options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
			</options>
		  </viewInfo>
		</field>
		<field name="ngay_han_tt" dataType="D" label="[120]" field="1" nextRow="true" hidden="false">
          <text v="Ngày thanh toán" e="Payment Date"></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="300" columns="120,120,240" >
