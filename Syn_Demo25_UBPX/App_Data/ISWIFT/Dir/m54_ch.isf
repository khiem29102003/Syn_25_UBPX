          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1 and nv_yn = 1" lookupCheck="1=1" lookupRef="ten_nvbh" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" />
