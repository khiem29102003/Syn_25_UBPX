<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields09.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from thpkh where id = @id and status in (5,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="thpkh" table="thpkh" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="AS1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Gán danh sách khách hàng cho nhân viên" e="Assign customer list to staff"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
        <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
		<field name="ma_nv" clientDefault="true" viewType="Lookup" label="1" field="1" allowBlank="true"  setype="1" nextRow="true">
          <text v="Mã nhân viên" e="Employee Code"></text>
          <viewInfo lookupType="One" lookupId="vdmnv" lookupKey="xstatus = 5 and status = 1" lookupCheck="1=1" lookupRef="ten_nv" lookupInfo="vdmnv|ma_nv|ten_nv" />
        </field>
        <field name="ten_nv" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>	
		<field name="ngay_hl" label="1" field="[120]" valueDefault="new Date()" dataType="D" allowBlank="false" >
			<text v="Ngày hiệu lực " e="Effective date"></text>
		</field>
		<field name="di_ngay" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="1" >
			<text v="" e=""></text>
		</field>
		<field name="ngay_hld" label="[100]" field="[120]" dataType="D" allowBlank="false" nextRow="false" >
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>
        <field name="dien_giai" label="1" rows="1" field="-">
          <text v="Diễn giải" e="Explain"></text>
        </field>
      </fields>
    </form>
	
    <form gravity="TopRight" columns="120,120" >
      <fields>
			&VoucherRequiredFields01;
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="400" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="thpkhct" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="AS1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
    <form gravity="BottomLeft" columns="120,120,120,120" >
      <fields>
		<field name="t_chon_yn" nextRow="true" label="1" field="1" disabled="true" dataType="N" format="Amount" >
           <text v="Tổng số lượng" e="Total Amount"></text> 
        </field> 
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="thpkhct" table="thpkhct" fieldKey="id, line" order="line" allowFilter="true" readOnly="false" allowOrder="true">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ma_kh" width="120" allowBlank="false" viewType="Lookup" readOnly="false" importable="1" disabled="false">
          <text v="Mã số thuế" e="Tax Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh0" lookupKey="status=1" lookupCheck="1=1" lookupRef="" lookupInfo="dmkh0|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" width="200" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join = "left join #dmkh0full b on a.ma_kh = b.ma_kh ">
          <text v="Tên khách hàng" e="Customer Name"></text>
        </field>
        <field name="dia_chi" width="200" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="home_page" width="100" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Website" e="Website"></text>
        </field>
		<field name="ten_ttp" width="120" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Tỉnh thành phố" e="Province/City"></text>
        </field>
		<field name="rgname" width="120" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Khu vực" e="Region"></text>
        </field>
		<field name="ten_cv" width="120" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Chức vụ" e="Position"></text>
        </field>
		<field name="e_mail" width="120" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Email" e="Email"></text>
        </field>
		<field name="dien_thoai" width="120" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Điện thoại" e="Province/City"></text>
        </field>
		<field name="ten_nh_kh1" width="120" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Tên nhóm kh 1" e="Province/City"></text>
        </field>
		<field name="ten_nh_kh2" width="120" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Tên nhóm kh 2" e="Province/City"></text>
        </field>
		<field name="ten_nh_kh3" width="120" fieldType="EX" inactivate="true" readOnly="true" aliasName="b">
          <text v="Tên nhóm kh 3" e="Province/City"></text>
        </field>
		<field name="chon_yn" dataType="N" format="Amount" width="0" valueDefault="1" inactivate="true" readOnly="true" hidden="true">
          <text v="Chonyn" e="Total Bill"></text>
        </field>
      </fields>

      <buttons>
        <button id="add">
          <text v="$AddToolbar" e="$AddToobar"></text>
        </button>
        <button id="delete">
          <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
        </button>
        <button id="copy">
          <text v="$CopyToolbar" e="$CopyToolbar"></text>
        </button>
        <button id="paste">
          <text v="$PasteToolbar" e="$PasteToolbar"></text>
        </button>
        <button id="moveup">
          <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
        </button>
        <button id="movedown">
          <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
        </button>
		<button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="retrieve">
          <text v="$RetrieveToolbar" e="$RetrieveToolbar"></text>
          <items>
            <button id="10">
              <text v="Nhận dữ liệu danh sách khách hàng"  e="Retrieve customer data/list"/>
            </button>
            <button id="80">
              <text v="-"  e="-"/>
            </button>
          </items>
        </button>
        <button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>

  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>
