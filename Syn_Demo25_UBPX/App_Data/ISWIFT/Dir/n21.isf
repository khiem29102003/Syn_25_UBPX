<grids>
	<grid id="wf2" table="wf2" fieldKey="id, line" order="line" allowFilter="true" readOnly="false" allowOrder="true">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
		<field name="chon_yn" width="80" dataType="B" readOnly="false" disabled="true">
          <text v="..." e="..."></text>
        </field>
        <field name="ma_task" width="120" viewType="Lookup" readOnly="false" >
          <text v="Mã công việc" e="Task Code"></text>
          <viewInfo lookupType="One" lookupId="dmtask" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_task" lookupInfo="dmtask|ma_task|ten_task" />
        </field>
        <field name="ten_task" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="b.ten_task " join=" left join dmtask b on a.ma_task = b.ma_task ">
          <text v="Tên công việc" e="Task"></text>
        </field>
		<field name="ma_nv" width="120" viewType="Lookup" readOnly="false" fieldType="EX"  aliasName="c.ma_nv " join=" left join wf1 c on a.id = c.id and a.ma_ntask= c.ma_ntask ">
          <text v="Mã nhân viên" e="Employee Code"></text>
          <viewInfo lookupType="One" lookupId="dmnv" lookupKey="status=1 and xstatus = 5" lookupCheck="1=1" lookupRef="ten_nv" lookupInfo="dmnv|ma_nv|ten_nv" />
        </field>
        <field name="ten_nv" width="200" fieldType="EX" inactivate="true" readOnly="true" aliasName="d.ten_nv " join=" left join dmnv d on c.ma_nv = d.ma_nv ">
          <text v="Tên nhân viên" e="Employee Name"></text>
        </field>
		<field name="ma_ntask" width="120" viewType="Lookup" readOnly="false" >
          <text v="Mã nhóm công việc" e="Task Group Code"></text>
          <viewInfo lookupType="One" lookupId="dmntask" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ntask" lookupInfo="dmntask|ma_ntask|ten_ntask" />
        </field>
        <field name="ten_ntask" width="250" fieldType="EX" inactivate="true" readOnly="true" aliasName="e.ten_ntask " join=" left join dmntask e on a.ma_ntask = e.ma_ntask ">
          <text v="Tên nhóm công việc" e="Task Group Name"></text>
        </field>
      </fields>

      <buttons>
		<button id="split">
          <text v="-" e="-"></text>
        </button>
        <button id="freeze">
          <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
        </button>
      </buttons>

      <script>
        <query>
