  <messages>
    <message val="codeExistsNewMsg">
      <text v="Số điện thoại đã tồn tại" e="Phone number is exists"/>
    </message>
    <message val="taxtCodeExists">
      <text v="Số điện thoại đã tồn tại" e="Phone number is exists"/>
    </message>
  </messages>
</dir>
