<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="qllichtd" table="qllichtd" fieldKey="ma_lichtd" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách lịch tiếp dân định kỳ" e="List of Regular Citizen Reception Schedules"></title>
  <title0 v="Mới - lịch tiếp dân" e="New - reception schedules"></title0>
  <title1 v="Sửa - lịch tiếp dân" e="Edit - reception Schedules"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120,120">
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ngay_ct" nextRow="true" dataType="D" valueDefault="new Date()" label="1" field="1" importable="5" >
				<text v="Ngày tạo" e="Date Created"></text>
			</field>
			<field name="ma_lichtd" label="1" field="-" allowBlank="false" fieldType="PK" disabled="true" importable="-1">
				 <text v="Mã lịch tiếp dân" e="Reception Schedule Code"></text>
			</field>
			<field name="ma_lhhd" allowBlank="false" viewType="Lookup" label="1" field="1" hidden="false" importable="5">
			  <text v="Loại hình hoạt động" e="Activity Type"></text>
			  <viewInfo lookupType="One" lookupId="dmlhhd" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_lhhd" lookupInfo="dmlhhd|ma_lhhd|ten_lhhd" />
			</field>
			<field name="ten_lhhd" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="noi_dung" label="1" field="-" allowBlank="false" disabled="false" rows="3"  importable="10">
				<text v="Nội dung tiếp dân" e="Citizen reception content"></text>
			</field>
			<field name="dk_ngay" viewType="Lookup" label="1" field="1" allowBlank="false" nextRow="true" importable="15">
			  <text v="Thứ trong tuần" e="Weekdays"></text>
			  <viewInfo lookupType="Multi" lookupId="dmdkngay" lookupKey="status = 1" lookupCheck="1=1" lookupInfo="dmdkngay|ma_dkngay|ten_dkngay" />
			</field>
			
			<field name="ma_calv" allowBlank="false" viewType="Lookup" label="1" field="1" hidden="false" importable="20">
			  <text v="Ca làm việc" e="Meeting Type Code"></text>
			  <viewInfo lookupType="One" lookupId="dmcalv" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_calv" lookupInfo="dmcalv|ma_ca|ten_ca" />
			</field>
			<field name="ten_calv" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			
			<field name="dia_chi" label="1" field="1" allowBlank="false" disabled="false" importable="25">
			  <text v="Địa điểm" e="Location"></text>
			</field>
			<field name="ma_ttp" viewType="Lookup" label="1" field="1" allowBlank="false" importable="30">
			  <text v="Mã tỉnh/thành phố" e="Province/City Code"></text>
			  <viewInfo lookupType="One" lookupId="dmttp" lookupKey="status=1" lookupRef="ten_ttp" lookupCheck="1=1" lookupInfo="dmttp|ma_ttp|ten_ttp" importCheck="@@DF and z.status=1"/>
			</field>
			<field name="ten_ttp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="false" label="" field="[240]" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ma_phuongxa" viewType="Lookup" label="1" field="1" allowBlank="true" importable="35">
			  <text v="Mã phường xã" e="Commune Code"></text>
			  <viewInfo lookupType="One" lookupId="dmphuongxa" lookupKey="status=1 and ma_ttp = ![ma_ttp]!" lookupRef="ten_phuongxa" lookupCheck="1=1" lookupInfo="dmphuongxa|ma_phuongxa|ten_phuongxa" importCheck="@@DF and z.status=1"/>
			</field>
			<field name="ten_phuongxa" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="false" label="" field="[240]" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>

			<field name="ds_nguoithamgia" viewType="Lookup" label="1" field="-" allowBlank="false" setype="1" nextRow="true" importable="40">
			  <text v="Cán bộ tham gia" e="Participants"></text>
			  <viewInfo lookupType="Multi" lookupId="dmnv" lookupKey="xstatus = 5 and status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmnv|ma_nv|ten_nv" />
			</field>
			<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
	<form tabPageIndex="1" gravity="MiddleLeft" height="250" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="ma_lichtd" fileGroup="qllichtd" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
</forms>

&DefaultButton;

<js>
<text>
  <![CDATA[
function dir$qllichtd(p){
  this.constructor(p);
}
dir$qllichtd.prototype = new DirEvent();

dir$qllichtd.prototype.beforeInit = function(renderType){
  this._dir.options._files = null;
  document._dir = this._dir;
}
dir$qllichtd.prototype.afterInit = function(renderType){
    var p = this._dir,g = p.options.parent;
	
	dir$qllichtdLoadMaLichTD(p);
	dir$qllichtdDisabledMasterField(p, g);
}

function dir$qllichtdLoadMaLichTD(p){

	if(p.options.action == 'NEW') {	
		p.request('LoadMaLichTd', '', ['ngay_ct']);
	}
}

dir$qllichtd.prototype.formFieldValueChange = function(o, cF, v) {
    var p = this._dir;
	switch (cF){
		case 'ngay_ct':
			dir$qllichtdLoadMaLichTD(p);
		break;

		default:
		  break;
	}
};

function dir$qllichtdDisabledMasterField(p){
	var maLichTd = p.valForm('ma_lichtd');
	if (maLichTd !== '') {
		p.setDisabled('ngay_ct', true);
	}
	else {
		p.setDisabled('ngay_ct', false);
	}
}
         ]]>
    </text>
  </js>
	<css>
		<text>
			  <![CDATA[
.modal-dialog-lg{min-width:960px!important;}
.control-label.tt {color: #499b98; text-decoration: underline}
.control-label.ma_lichtd, .control-label.ma_lcuochop, .control-label.ten_cuochop,.control-label.noi_dung, .control-label.ds_chutri, .control-label.ds_nguoithamgia {color: #499b98;}
			  ]]>
		</text>
	</css>
	<script>
		<request code="LoadMaLichTd">
		<text>		
			<![CDATA[
EXEC [dbo].[st_CreateLichTiepDanCode] @ngay_ct;
			]]>				
		</text>
		</request>
  		<query>
		  <text>
			<![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table
drop table #@@table
			 ]]>
		  </text>
		</query>
		<updated>
		  <text>
			<![CDATA[
update @@table set datetime2 = getdate(), user_id2 = @@userId where [%whereFieldKey]
			 ]]>
		  </text>
		</updated>
		<inserting>
		  <text>
			<![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
			]]>
		  </text>
		</inserting>
		<importing>
			<text>
			<![CDATA[
update #data set unit_id = @@unit
@@insert
			]]>
			</text>
		</importing>
	</script>
  <messages>
	<message val="codeExistsNewMsg">
	  <text v="Mã lịch tiếp dân đã tồn tại trong danh mục." e="The reception schedule already exists in the list."/>
	</message>
  </messages>
</dir>
