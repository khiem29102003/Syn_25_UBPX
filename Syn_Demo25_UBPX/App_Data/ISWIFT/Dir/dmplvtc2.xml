<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmplvtc2" table="dmplvtc2" fieldKey="ma_lo" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục phân loại vật tư 2" e="Material Classification List 2"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1">
          <text v="" e=""></text>
        </field>
        <field name="ma_unit" viewType="Lookup" fieldType="EXParam" readOnly="false" label="1" field="1" allowBlank="false">
          <text v="Đơn vị" e="Unit"></text>
          <viewInfo lookupType="One" lookupId="sysunit" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_unit" lookupInfo="sysunit|ma_unit|ten_unit" />
        </field>
        <field name="ten_unit" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>

        <field name="ma_lo" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã phân loại vật tư 2" e="MClassification 2 Code"></text>
        </field>
        <field name="ten_lo" label="1" field="-" allowBlank="false" fieldType="PK" >
          <text v="Tên phân loại vật tư 2" e="MClassification 2 Name"></text>
        </field>
        <field name="ten_lo2" label="1" field="-">
          <text v="Tên tiếng anh" e="Other Name"></text>
        </field>

        <field name="ngay_nhap" label="1" field="1" dataType="D" hidden="true">
          <text v="Ngày nhập" e="Receipt Date"></text>
        </field>
        <field name="ngay_sx" label="1" field="1" dataType="D" hidden="true">
          <text v="Ngày sản xuất" e="Manufacturing Date"></text>
        </field>
        <field name="ngay_hhsd" label="1" field="1" dataType="D" hidden="true">
          <text v="Hạn sử dụng" e="Expiry Date"></text>
        </field>
        <field name="ngay_hhbh" label="1" field="1" dataType="D" hidden="true">
          <text v="Ngày bảo hành" e="Warranty Date"></text>
        </field>
        <field name="ma_nh" viewType="Lookup" label="1" field="1">
          <text v="Nhóm p/loại vật tư 2" e="MGroup 2"></text>
          <viewInfo lookupType="One" lookupId="dmplnhvtc2" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nh" lookupInfo="dmplnhvtc2|ma_nh|ten_nh" />
        </field>
        <field name="ten_nh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="ghi_chu" rows="3" label="1" field="-" >
          <text v="Ghi chú" e="Notes"></text>
        </field>

        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmplvtc2(p){
  this.constructor(p);
}
dir$dmplvtc2.prototype = new DirEvent();
dir$dmplvtc2.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>
  <script>

  <query>
      <text>
        <![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table
if @action = 'EDIT' or @copy = 1 select ma_unit, ten_unit from sysunit where unit_id in (select unit_id from #@@table)
else select ma_unit, ten_unit from sysunit where unit_id = @@unit
drop table #@@table
         ]]>
      </text>
    </query>
    
    <beforesave>
      <text>
        <![CDATA[
select @unit_id = unit_id from sysunit where ma_unit = @ma_unit
        ]]>
      </text>
    </beforesave>
    
  </script>
  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã vật tư và lô đã có trong danh mục lô." e="The record consisting of item and lot is already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã vật tư và lô đã có trong danh mục lô." e="The record consisting of item and lot is already exists."/>
    </message>
  </messages>

</dir>