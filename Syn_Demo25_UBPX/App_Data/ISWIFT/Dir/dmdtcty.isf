<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmdtcty" table="dmdtcty" fieldKey="ma_sdt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục điện thoại CTY" e="List of Phone company"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_sdt" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã số đt" e="Phone code"></text>
        </field>
        <field name="ten_sdt" label="1" field="2" allowBlank="false" >
          <text v="Tên CTY" e="Company name "></text>
        </field>
		<field name="fax" label="1" field="2" allowBlank="false" >
          <text v="FAX" e="FAX"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

