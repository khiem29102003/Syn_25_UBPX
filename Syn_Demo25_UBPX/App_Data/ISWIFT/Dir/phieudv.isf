<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields01.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">
  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">
  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from phieu_dv where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="phieu_dv" table="phieu_dv" fieldKey="id" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
	<title v="Phiếu yêu cầu dịch vụ" e="Service Request Form"></title>
	<title0 v="Thêm mới" e="New"></title0>
	<title1 v="Sửa" e="Edit"></title1>
	<forms>
		<form gravity="TopLeft" columns="120,120,120,120,120,120" >
			<fields>
				<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
					<text v="" e=""></text>
				</field>
				<field name="ma_thue" label="1" field="1" importable="90">
					<text v="Mã số thuế" e="Tax code"></text>
				</field>
				<field name="fax" label="[70]" field="1" importable="90" nextRow="false">
					<text v="FAX" e="FAX"></text>
				</field>
				<field name="ma_sdt" clientDefault="true" viewType="Lookup" label="1" field="1">
					<text v="SĐT Garage" e="Phone Garage"></text>
					<viewInfo lookupType="One" lookupId="dmdtcty" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_sdt" lookupInfo="dmdtcty|ma_sdt|ten_sdt" />
				</field>		
				<field name="ten_sdt" clientDefault="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field>
				<field name="ngay_den" label="1" field="1" dataType="D" importable="90">
					<text v="Ngày đến" e="Arrival date"></text>
				</field>
				<field name="gio_den" label="[70]" field="1" nextRow="false" importable="90">
					<text v="Giờ đến" e="Arrival time"></text>
				</field>
				<field name="ngay_giao_xe" label="1" field="1" dataType="D" importable="90">
					<text v="Ngày giao xe" e="Delivery date"></text>
				</field>
				<field name="gio_giao_xe" label="[70]" field="1" nextRow="false" importable="90">
					<text v="Giờ giao xe" e="Delivery time"></text>
				</field>	
			</fields>
		</form>

		<form gravity="TopRight" columns="120,120" >
			<fields>
				&VoucherRequiredFields01;
				&VoucherRequiredFields02;
			</fields>
		</form>   
		
		<form tabPageIndex="1" gravity="MiddleLeft" height="320" columns="120,120,240" >
			<text v="Thông tin xe" e="Car detail"></text>
			<fields>
				<field name="grxe" allowBlank="false" label="" field="-" viewType="Grid">
					<text v="Thông tin xe" e="Car detail"></text>
				</field>
			</fields>
		</form>

		<form tabPageIndex="2" gravity="MiddleLeft" height="320" columns="120,120,240" >
			<text v="Hạng mục dịch vụ" e="Repair form"></text>
			<fields>
				<field name="" allowBlank="false" label="" field="-" viewType="Grid">
					<text v="Hạng mục dịch vụ" e="Repair form"></text>
				</field>
			</fields>
		</form>	
		
	</forms>
	 <grids>
		<grid id="grxe" table="grxe" fieldKey="id, line" order="line" readOnly="false">
			<fields>
				<field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
					<text v="" e=""></text>
				</field>
				<field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
					<text v="Dòng" e="Line"></text>
				</field>
				<field name="ma_xe" width="100" viewType="Lookup" readOnly="false" >
					<text v="Mã xe" e="Vehicle code"></text>
					<viewInfo lookupType="One" lookupId="dmxe" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_xe" lookupInfo="dmxe|ma_xe|ten_xe" />
				</field>
				<field name="ten_xe" width="200" fieldType="EX" inactivate="true" readOnly="true" aliasName="c" join=" left join dmxe c on a.ma_xe = c.ma_xe ">
					<text v="Tên xe" e="Vehicle name"></text>
				</field>	
				<field name="nhan_hieu" width="100" readOnly="false" >
					<text v="Thương hiệu" e="Brand"></text>
				</field>
				<field name="so_khung" width="100" readOnly="false" >
					<text v="Số VIN" e="VIN number"></text>
				</field>
				<field name="so_may" width="100" readOnly="false" >
					<text v="Số máy" e="Host number"></text>
				</field>
				<field name="mau_son" width="100" readOnly="false" >
					<text v="Màu sơn" e="Paint color"></text>
				</field>	
			</fields>
			<buttons>
				<button id="add">
					<text v="$AddToolbar" e="$AddToobar"></text>
				</button>
				<button id="delete">
					<text v="$DeleteToolbar" e="$DeleteToolbar"></text>
				</button>
				<button id="copy">
					<text v="$CopyToolbar" e="$CopyToolbar"></text>
				</button>
				<button id="paste">
					<text v="$PasteToolbar" e="$PasteToolbar"></text>
				</button>
				<button id="moveup">
					<text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
				</button>
				<button id="movedown">
					<text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
				</button>
				<button id="split">
					<text v="-" e="-"></text>
				</button>
				<button id="retrieve">
					<text v="$RetrieveToolbar" e="$RetrieveToolbar"></text>
					<items>
						<button id="10">
							<text v="?????"  e="Extract Data from Sales Orders"/>
						</button>
					</items>
				</button>
				<button id="split">
					<text v="-" e="-"></text>
				</button>
				<button id="freeze">
					<text v="$FreezeToolbar" e="$FreezeToolbar"></text>
				</button>
			</buttons>
			<script>
				<query>
					<text>
						<![CDATA[<enc>cGsaDUIu+KbD/gO+6oThICTH4UpIHmcV5oALXLgtFUQCXjXNLK64/3ToZv6skj/YBNd1aYswSl4iw5lJG2PUwGxtTdi9IXRvD7nKcMof4u++v2xERmQ98TG52JI7XMfCMi504Y/lJKpRFniT7uZe+Cnjt5WYUfFX35cseXKeibk=</enc>]]>
					</text>
				</query>
			</script>
		</grid>
	</grids>
	
  &DefaultButton;

	<js>
		<text>
			<![CDATA[<enc>EuMCwtDI9y7rS8KP0lFtq1P1iCQt+F7JTssN9opKJ2zvSfdqvl/mfCLND6d8OHr75U+GWOLRYCB2yLd8MhJ+PNXVhVjj72a42NHSFN8lgUh7SdLQzpGOKT/tqwkmhsUmcYn6/d10TCYY4JYh1lIogmwEsYPNqC3QbUnpNhm8WkgU8Mw0hk0Z5kgIbRCl+rnxS1a7SVR9jZp81OL56p33a+BIUHwhRvdT5fheoBd8KMg=</enc>]]>
