<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmhtsc" table="dmhtsc" fieldKey="ma_htsc" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hình thức sửa chữa" e="List Payment"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_htsc" format="U" label="[150]" field="1" allowBlank="false" fieldType="PK">
          <text v="Mã hình thức sửa chữa" e="Payment Code"></text>
        </field>
        <field name="ten_htsc" label="[150]" field="2" allowBlank="false" >
          <text v="Tên hình thức sửa chữa" e="Payment Name"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="[150]" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmhtsc(p){
  this.constructor(p);
}
dir$dmhtsc.prototype = new DirEvent();
dir$dmhtsc.prototype.afterInit = function(){
  var p = this._dir;
}
         ]]>
    </text>
  </js>

  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã htsc đã tồn tại' else N'UOM code is exists' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã htsc đã tồn tại' else N'UOM code is exists' end
         ]]>
      </text>
    </declare>
  </script>

</dir>