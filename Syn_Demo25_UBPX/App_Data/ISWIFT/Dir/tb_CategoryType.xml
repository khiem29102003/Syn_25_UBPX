function dir$tb_CategoryType(p){
  this.constructor(p);
}
dir$tb_CategoryType.prototype = new DirEvent();
dir$tb_CategoryType.prototype.afterInit = function(){
  var p = this._dir;
  dir$tb_CategoryTypeLoadDataQuote(p);
}
function dir$tb_CategoryTypeLoadDataQuote(p){
	if (p.options.action == "NEW" ) {
	
		p.request('get_id', '', '')

	}
}
