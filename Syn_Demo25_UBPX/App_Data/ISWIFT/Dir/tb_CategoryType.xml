<dir id="tb_CategoryType" table="tb_CategoryType" fieldKey="Id" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Loại danh mục" e="Category Type List"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120" >
      <fields>
       <field name="Id" disabled="true" fieldType="PK" width="100" filterType="Code">
          <text v="Mã loại danh mục" e="License plate"></text>
        </field>
        <field name="Title" width="250">
          <text v="Tên loại danh mục" e="Car owner"></text>
        </field>	
        <field name="Alias" width="250">
          <text v="Alias" e="Alias"></text>
        </field>			
		<field name="CategoryId" viewType="Lookup" label="1" field="1" >
          <text v="Mã danh mục" e="Category Code"></text>
          <viewInfo lookupType="One" lookupId="tb_Category" lookupKey="IsActive=1" lookupCheck="1=1" lookupRef="CategoryName" lookupInfo="tb_Category|Id|Title"/>
        </field>
		<field name="CategoryName" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="Description" width="120">
          <text v="Mô tả" e="Description More"></text>
        </field>
		<field name="Position"  width="120" valueDefault="1" dataType="N">
          <text v="Thứ tự" e="Position"></text>
        </field>
		<field name="IsActive" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
		<field name="SeoTitle"  width="120">
          <text v="SEO Title" e="SEO Title"></text>
        </field>
		<field name="SeoDescription"  width="120">
          <text v="Seo Description" e="Seo Description"></text>
        </field>
        <field name="SeoKeywords" width="250">
          <text v="Seo Keywords" e="Seo Keywords"></text>
        </field>
      </fields>
    </form>
