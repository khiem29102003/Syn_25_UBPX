      <text v="Mã quốc gia đã tồn tại." e="Country code already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã quốc gia đã tồn tại." e="Country code already exists."/>
    </message>
  </messages>
</dir>