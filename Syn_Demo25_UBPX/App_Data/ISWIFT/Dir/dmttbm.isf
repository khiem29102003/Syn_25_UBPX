      <text v="Mã trạng thái nhấc máy đã tồn tại." e="Pick-up state code already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã trạng thái nhấc máy đã tồn tại." e="Pick-up state code already exists."/>
    </message>
  </messages>
