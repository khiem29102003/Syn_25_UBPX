<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY HreScript SYSTEM "..\Include\XML\HreScript.xml">
]>

<dir id="hrettk" table="hrettk" fieldKey="id, line" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thông tin khác" e="Other Infomation"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120" >
      <fields>
        <field name="id" dataType="N" fieldType="PK" label="1" field="1" format="0" hidden="true">
          <text v="ID" e="ID"></text>
        </field>
        <field name="line" dataType="N" fieldType="PK" label="1" field="1" format="0" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
        <field name="ngay_ky" dataType="D" allowBlank="false" label="1" field="1" >
          <text v="Ngày ký" e="Date Signed"></text>
        </field>
        <field name="loai" viewType="Combobox" inactivate="true" label="1" field="2" valueDefault="1" importable="-1">
          <text v="Loại" e="Type"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Khen thưởng" e="1 - Award"></text>
              </option>
              <option val="2">
                <text v="2 - Kỷ luật" e="2 - Disciplinary"></text>
              </option>
            </options>
          </viewInfo>
        </field>
        <field name="noi_dung" label="1" field="-" >
          <text v="Nội dung" e="Content"></text>
        </field>
        <field name="tien2" label="1" field="1" allowBlank="true" format="Amount" dataType="N">
          <text v="Tiền" e="Amount"></text>
        </field>
        <field name="ghi_chu" rows="3" label="1" field="-" >
          <text v="Ghi chú" e="Note"></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$hrettk(p){
  this.constructor(p);
}
dir$hrettk.prototype = new DirEvent();
dir$hrettk.prototype.afterInit = function(){
  var p = this._dir, pa = p.options.parent;
  if (p.options.action == 'NEW') p.valForm('id', pa.options._id);
}
]]>
    </text>
  </js>

  <script>
    &HreScript;
  </script>
</dir>