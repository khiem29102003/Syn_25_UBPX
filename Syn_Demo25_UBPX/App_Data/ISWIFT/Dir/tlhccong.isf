<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields01.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid05.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">
  <!ENTITY JobNumberBeforeSave SYSTEM "..\Include\Script\JobNumberBeforeSave.txt">
  
  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from tlhccong where id = @id and status in (5,6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="tlhccong" table="tlhccong" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="HC1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Thiết lập hành chính công" e="Public Administration Setup"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,100,120,120" >
      <fields>
		<field name="ma_hccong" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false">
          <text v="Mã hành chính công" e="Public Administration Code"></text>
          <viewInfo lookupType="One" lookupId="dmhccong" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_hccong" lookupInfo="dmhccong|ma_hccong|ten_hccong" />
        </field>
        <field name="ten_hccong" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="stt_bd" dataType="N" label="1" field="1" disabled="false" format="0" hidden="false">
			<text v="Số bắt đầu" e="Gross Weight(KGS)"></text>
		</field>
		<field name="tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="1" field="">
          <text v="" e=""></text>
        </field>
		<field name="stt_td" dataType="N" label="1" field="1" disabled="false" format="0" hidden="false" nextRow="false">
			<text v="Số tối đa" e="Gross Weight(KGS)"></text>
		</field>
		<field name="tg_lamviec" label="1" field="1" allowBlank="true" disabled="false" nextRow="false" >
			<text v="Thời gian làm việc" e="Working hours"></text>
		</field>
		<field name="tg_dukien" dataType="N" label="1" field="1" disabled="false" format="0" hidden="false" nextRow="true">
          <text v="Thời gian dự kiến (s)" e="Estimated time (s)"></text>
		</field>
		<field name="tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="1" field="">
          <text v="" e=""></text>
        </field>
		<field name="tg_trihoan" dataType="N" label="1" field="1" disabled="false" format="0" hidden="false" nextRow="false">
          <text v="Thời gian trì hoãn (s)" e="Delay time (s)"></text>
		</field>
		<field name="id" dataType="N" fieldType="PK" format="0" copy="true" hidden="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
      <fields>
        &VoucherRequiredFields01;
        <field name="status" viewType="Combobox" valueDefault="5" inactivate="true" label="[60]" field="[180]" >
		  <text v="Trạng thái" e="Status"></text>
		  <viewInfo>
			<options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = '@@voucherCode' and status = 1 order by stt">
			</options>
		  </viewInfo>
		</field>
		</fields>
    </form>

    <form tabPageIndex="1" gravity="MiddleLeft" height="200" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="HC1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

<css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>
