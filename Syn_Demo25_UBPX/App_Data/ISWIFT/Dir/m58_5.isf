  </script>

  <messages>
    <message val="GtLonHonPhanBo">
      <text v="Số tiền lớn hơn số tiền còn phải phân bổ. Có tiếp tục không?" e="Sure?"/>
    </message>
    <message val="DuplicateInv">
      <text v="Số hóa đơn không được trùng" e="Duplicate Invoice Number"/>
    </message>
    <message val="DuplicateCus">
      <text v="Mã khách hàng không được trùng" e="Duplicate Customer"/>
    </message>
    <message val="DaPhanBo">
      <text v="Đã phân bổ phiếu thu này, không được sửa/xóa" e=""/>
    </message>
  </messages>
</dir>