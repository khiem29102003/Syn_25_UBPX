<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="hrdmkcb" table="hrdmkcb" fieldKey="ma_kcb" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nơi đăng ký KCB" e="Medical Care Center List"></title>
  <title0 v="Thêm" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_kcb" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã đăng ký" e="Code"></text>
        </field>
        <field name="ten_kcb" allowBlank="false" label="1" field="-">
          <text v="Tên đăng ký" e="Description"></text>
        </field>
        <field name="ten_kcb2" label="1" field="-">
          <text v="Tên khác" e="Other name"></text>
        </field>

        <field name="ma_tinh" format="U" viewType="Lookup" nextRow="false" label="1" field="1">
          <text v="Nơi cấp" e=""></text>
          <viewInfo lookupType="One" lookupId="hrdmtinh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_tinh" lookupInfo="hrdmtinh|ma_tinh|ten_tinh" />
        </field>
        <field name="ten_tinh" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="benh_vien" allowBlank="false" label="1" field="1">
          <text v="Bệnh viện" e="Hospital"></text>
        </field>

        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$hrdmkcb(p){
  this.constructor(p);
}
dir$hrdmkcb.prototype = new DirEvent();
dir$hrdmkcb.prototype.afterInit = function(){
  var p = this._dir, pa = p.options.parent;
}
]]>
    </text>
  </js>

  <script>

    <query>
      <text>
        <![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table
drop table #@@table
]]>
      </text>
    </query>

  </script>

  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã nơi đăng ký đã có hoặc lồng nhau trong danh mục nơi đăng ký KCB." e="This medical care center is invalid or already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã nơi đăng ký đã có hoặc lồng nhau trong danh mục nơi đăng ký KCB." e="This medical care center is invalid or already exists."/>
    </message>
  </messages>

</dir>