<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
	<!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmlvtc1" table="dmlvtc1" fieldKey="ma_lvtc1" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
	<title v="Danh mục nghành hàng cấp 1" e="Level 1 product catalog"></title>
	<title0 v="Thêm mới" e="New"></title0>
	<title1 v="Sửa" e="Edit"></title1>

	<forms>
		<form gravity="TopLeft" columns="120,120,120" >
			<fields>
				<field name="ma_lvtc1" label="1" field="2" fieldType="PK" >
					<text v="Mã nghành hàng" e="Industry code"></text>
				</field>
				<field name="ten_lvtc1" label="1" field="2" allowBlank="false" >
					<text v="Tên nghành hàng" e="Industry name"></text>
				</field>
				<field name="ten_khac" label="1" field="2" allowBlank="false" >
					<text v="Tên khác" e="Other name"></text>
				</field>
				<field name="unit_id" label="1" field="2" hidden="true" dataType="I">
					<text v="Đơn vị" e="Unit"></text>
				</field>
				<field name="thu_tu" label="1" field="2" dataType="I">
					<text v="Thứ tự" e="Position"></text>
				</field>
				<field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
					<text v="Trạng thái" e="Status"></text>
					<viewInfo>
						<options>
							<option val="1">
								<text v="1 - Còn sử dụng" e="1 - Use"></text>
							</option>
							<option val="0">
								<text v="0 - Không sử dụng" e="0 - Not use"></text>
							</option>
						</options>
					</viewInfo>
				</field>
				
				<field name="banner-container" label="-" field="0" fieldType="EX" disabled="true">
					<text v="
						&lt;div class='edit-label edit-title'&gt;
							&lt;div class='mandatory'&gt;
								&lt;span class='mandatory-icon'&gt;*&lt;/span&gt;
							&lt;/div&gt;
							&lt;span &gt;Ảnh bìa danh mục&lt;/span&gt;
						&lt;/div&gt;
						&lt;div style='display: flex; gap: 11px;' &gt;
							&lt;div id='mainImagePreview' class='main-preview' style='position: relative;' &gt;
								Chưa có ảnh
							&lt;/div&gt;

							&lt;button id='addImageLabel' onclick='document.getElementById(`imagePicker`).click();' type='button'&gt;
								&lt;div style='color: #ee4d2d; text-align: center; display: flex; flex-direction: column; justify-content: center; align-content: center; padding: 0 2px; line-height: 20px;'&gt;
									&lt;div style='font-size: 24px;'&gt;📷&lt;/div&gt;
									&lt;span&gt;Thêm ảnh bìa&lt;/span&gt;
								&lt;/div&gt;
							&lt;/button&gt;
						&lt;/div&gt;" e="Banner"></text>
				</field>

				<field name="images-single" label="0" field="0" fieldType="EX">
					<text v="&lt;input type='file' id='imagePicker' accept='image/*' hidden /&gt;" e="&lt;input type='file' id='imagePicker' accept='image/*' hidden /&gt;"></text>
				</field>
			</fields>
		</form>
		
		<form tabPageIndex="1" gravity="MiddleLeft" height="150" columns="120,120,120,120,120,120,120,120">
			<text v="Danh mục ảnh" e="Detail images"></text>
			<fields>
				<field name="dmvtmedia" allowBlank="true" label="" field="-" viewType="Grid">
				  <text v="Chi tiết cài đặt" e="Detail Setup"></text>
				</field>
			</fields>
		</form>
	</forms>
	
	<grids>
		<grid id="dmvtmedia" table="dmvtmedia" fieldKey="ma_vt, line" order="line">
			<fields>		
				<field name="media_id" width="150" readOnly="true" inactivate="true">
					<text v="Mã gốc" e="Origin code"></text>
				</field>
				<field name="ext" width="150" allowBlank="true" readOnly="true" >
					<text v="Ext" e="Ext"></text>
				</field>
				<field name="url" width="150" allowBlank="true" readOnly="true">
					<text v="Url" e="Url"></text>
				</field>
				<field name="thumbnail_url" width="150" allowBlank="true" readOnly="true">
					<text v="Thumbnail url" e="Thumbnail url"></text>
				</field>
				<field name="product_card_url" width="150" allowBlank="true" readOnly="true">
					<text v="Product card url" e="Product card url"></text>
				</field>
				<field name="detail_thumb_srcset" width="150" allowBlank="true" readOnly="true">
					<text v="Detail thumbnail src set" e="Detail thumbnail src set"></text>
				</field>
				<field name="detail_main_srcset" width="150" allowBlank="true" readOnly="true">
					<text v="Detail main src set" e="Detail main src set"></text>
				</field>
				<field name="video_url" width="150" allowBlank="true" readOnly="true">
					<text v="Video url" e="Video url"></text>
				</field>
				<field name="width" width="150" allowBlank="true" readOnly="true">
					<text v="Width" e="Width"></text>
				</field>
				<field name="height" width="150" allowBlank="true" readOnly="true">
					<text v="Height" e="Height"></text>
				</field>
				<field name="type" width="150" allowBlank="true" readOnly="true">
					<text v="Type" e="Type"></text>
				</field>
				<field name="is_cover" width="150" allowBlank="true" readOnly="true">
					<text v="Is cover" e="Is cover"></text>
				</field>
				<field name="status" width="150" allowBlank="true" format="1" readOnly="true">
					<text v="Status" e="Status"></text>
				</field>

				<field name="ma_vt" foreignField="ma_lvtc1" dataType="C" width="100" fieldType="PK" copy="false" hidden="true">
					<text v="Mã sản phẩm" e="Product code"></text>
				</field>
				<field name="line" foreignField="@@ROW" dataType="I" width="100" fieldType="PK" hidden="true">
					<text v="Dòng" e="Line"></text>
				</field>
			</fields>
			
			<buttons>
				<button id="freeze">
					<text v="$FreezeToolbar" e="$FreezeToolbar"></text>
				</button>
			</buttons>
		  
			<script>
				<query>
					<text>
						<![CDATA[<enc>jFuGpoSCxpO6QPaemlGvWQmb/UhkaOSnQYtCvyenUae7I2mGK7GQ1Xb4kbs6NlsESTh42SoRrd6H27qmcz5kifKPnJ4ubiiPVtwz+7Z7n/W5wGGyIBOea4iJGSby/ZOZOoCK9EtKAF66uKAGpvj/E1ecfsyn6CoBrpTbd5Pm6rT7xHEPL3D6FcunuVL+PFom050hbNh7QXO4K1rmcPCi5A==</enc>]]>
					</text>
				</query>
			</script>
		</grid>
	</grids>

	&DefaultButton;

	<js>
		<text>
			<![CDATA[<enc></enc>]]>
		</text>
	</js>
	
