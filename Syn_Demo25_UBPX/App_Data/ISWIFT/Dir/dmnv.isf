<dir id="dmnv" table="dmnv" fieldKey="ma_nv" dirViewType="Dialog" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Khai báo nhân sự" e="List of Employee"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>

		<field name="tt" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="[160]" field="0">
