            <options>
			  <option val="3">
                <text v="Thử việc" e="Try job"></text>
              </option>
              <option val="5">
                <text v="Đang làm việc" e="Working"></text>
              </option>
              <option val="9">
                <text v="Nghỉ việc" e="Quitting your job"></text>
              </option>
			  <option val="7">
