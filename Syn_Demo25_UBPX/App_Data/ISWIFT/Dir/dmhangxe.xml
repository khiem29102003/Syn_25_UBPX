<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmhangxe" table="dmhangxe" fieldKey="ma_hang" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục hãng xe" e="List of Vehicle Brand"></title>
  <title0 v="Thêm mới" e="Create New"></title0>
  <title1 v="Sửa" e="Edit"></title1>


  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_hang" format="U" label="1" field="1" allowBlank="false" fieldType="PK" importable="1" >
          <text v="Mã hãng" e="Brand Code"></text>
        </field>
        <field name="ten_hang" label="1" field="-" importable="5" >
          <text v="Tên hãng" e="Brand Name"></text>
        </field>
        <field name="ten_hang2" label="1" field="-" importable="10">
          <text v="Tên khác" e="Other Name"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" valueDefault="1" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmhangxe(p){
  this.constructor(p);
}
dir$dmhangxe.prototype = new DirEvent();
dir$dmhangxe.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmhangxe.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

dir$dmhangxeDisabledMasterField(p, g);

}

function dir$dmhangxeDisabledMasterField(p, g){
  
  if(p.valForm('ma_hang').trim() != '')
  {
    p.setDisabled('ma_hang', true);
  }
  else
  {
    p.setDisabled('ma_hang', false);
  }
}
         ]]>
    </text>
  </js>
  
  <css>
	<text>
	  <![CDATA[
		.control-label.ma_hang, .control-label.ten_hang
		{	
			//font-weight:bold;	
			color: #499b98;;
		}
	  ]]>
	</text>
  </css>
  
  <script>
	<importing>
      <text>
        <![CDATA[
		@@insert
        ]]>
      </text>
    </importing>
  </script>
  
  <messages>
	<message val="codeExistsNewMsg">
		<text v="Mã hãng xe đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The vehicle manufacturer code already exists in the catalog, please choose a different code."/>
	</message>
	<message val="codeExistsEditMsg">
		<text v="Mã hãng xe đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The vehicle manufacturer code already exists in the catalog, please choose a different code."/>
	</message>
  </messages>

</dir>