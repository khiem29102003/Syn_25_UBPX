<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmnhansu" table="dmnhansu" fieldKey="ma_ns" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhân viên" e="List of customer"></title>
  <title0 v="Thêm" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
        <field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
          <text v="" e=""></text>
        </field>
        <field name="ma_ns" format="U" label="1" field="1" viewType="AutoIncrease" allowBlank="false" fieldType="PK" importable="5">
          <text v="Mã nhân viên" e="Code"></text>
        </field>
        <field name="ten_ns" allowBlank="false" label="1" field="-" importWidth="250" importable="10">
          <text v="Tên nhân viên" e="Name"></text>
        </field>
  
        <field name="ma_so_thue" label="1" field="2"  importable="35">
          <text v="Mã số thuế &lt;a onclick='getTax(this);'&gt;(Kiểm tra)&lt;/a&gt;" e="Tax Code"></text>
        </field>
		
      <field name="ma_hd" viewType="Lookup" label="1" field="[120] ">
        <text v="Hợp đồng LV" e="Position"></text>
        <viewInfo lookupType="One" lookupId="dmhopdong" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_hd" lookupInfo="dmhopdong|ma_hd|ten_hd" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_hd" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
           <text v="" e=""></text>
        </field>
       
        <field name="rg_code" format="U" viewType="Lookup" label="1" field="1" clientDefault="true" importable="75">
          <text v="Khu vực" e="Region Code"></text>
          <viewInfo lookupType="One" lookupId="sysregioninfo" lookupKey="status=1" lookupCheck="1=1" lookupRef="rgname" lookupInfo="sysregioninfo|rg_code|rgname" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="rgname" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
     
        
        
       
      </fields>
    </form>
		<form tabPageIndex="1" gravity="MiddleLeft" height="200" columns="140,120,240" >
      <text v="Thông tin cá nhân" e="Personal information"></text>
      <fields>
	      <field name="dien_thoai" label="1" field="2"  importable="80">
          <text v="Điện thoại" e="Phone"></text>
        </field>
       
        <field name="e_mail" label="1" field="2" importable="90">
          <text v="Email" e="Email"></text>
        </field>
       <field name="dia_chi" label="1" field="-" importWidth="250" importable="30">
          <text v="Địa chỉ" e="Address"></text>
        </field>
		<field name="ngay_sinh" dataType="D" label="1" field="1" >
          <text v="Ngày sinh" e="Date of birth"></text>
        </field>
		 <field name="noi_sinh" label="1" field="-" importWidth="250" importable="30">
          <text v="Nơi sinh" e="Date of birth"></text>
        </field>
      </fields>
    </form>
	   <form tabPageIndex="2" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Khai báo CMND" e="Declare ID card"></text>
      <fields>
        <field name="cmnd_so" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Số chứng minh" e="ID code"></text>
        </field>
		<field name="cmnd_ngay_cap" dataType="D" label="1" field="1" >
          <text v="Ngày cấp" e="Date Range"></text>
        </field>	
		<field name="cmnd_noi_cap" label="1" field="-" importWidth="250"  importable="85">
          <text v="Nơi cấp" e="Issued by"></text>
        </field>
		<field name="ma_gt" dataType="B" clientDefault="true" label="1" field="[60]"  inactivate="true" importable="25">
          <text v="Giới tính" e="Sex"></text>
        </field>
		 
		 
      </fields>
    </form>
		 
	  <form tabPageIndex="3" gravity="MiddleLeft" height="320" columns="120,120,240" >
      <text v="Phòng ban" e="Declare ID card"></text>
      <fields>
        <field name="phong_ban" label="1" field="1" allowBlank="false" >
          <text v="Phòng ban" e="ID code"></text>
        </field>
		<field name="ma_cv" viewType="Lookup" label="1" field="[120] ">
        <text v="Chức vụ" e="Position"></text>
        <viewInfo lookupType="One" lookupId="dmchucvu" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_cv" lookupInfo="dmchucvu|ma_cv|ten_cv" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_cv" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
           <text v="" e=""></text>
        </field>
		
		<field name="ma_bp" viewType="Lookup" label="1" field="[120] ">
        <text v="Bộ phận" e="Position"></text>
        <viewInfo lookupType="One" lookupId="dmbophan" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_bp" lookupInfo="dmbophan|ma_bp|ten_bp" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_bp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
           <text v="" e=""></text>
        </field>
		
		 <field name="so_nam_lv" dataType="N" label="1" field="1" allowBlank="false" >
          <text v="Số năm làm việc" e="ID code"></text>
        </field>
		 
		 
      </fields>
    </form> 
  </forms>

  &DefaultButton;

<js>
    <text>
      <![CDATA[<enc></enc>]]>
		
    </text>
  </js>
