<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields09.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from chcall where id = @id and status in (5,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end

    ">
]>


<dir id="chcall" table="chcall" fieldKey="id, ma_dv" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="CH1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Cấu hình cuộc gọi" e="Call configuration"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
	    <field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
		
		<field name="ma_dv" viewType="Lookup" label="1" field="1" importable="100" fieldType="PK" copy="false">
		   <text v="Đơn vị" e="Unit"></text>	
		   <viewInfo lookupType="One" lookupId="dmdonvi" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dv" lookupInfo="dmdonvi|ma_dv|ten_dv" importCheck="@@DF and z.status=1"/>
		</field>
		<field name="ten_dv" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
		   <text v="" e=""></text>
		</field>
		
        <field name="web_socket" label="1" field="2">
          <text v="Web Socket" e="Web Socket"></text>
        </field>
		<field name="ip_address" label="1" rows="1" field="2">
          <text v="IP Address" e="IP Address"></text>
        </field>
		<field name="port" label="1" rows="1" field="1">
          <text v="Port" e="Port"></text>
        </field>
		 <field name="linkweb" label="1" field="2">
          <text v="Link website" e="Link website"></text>
        </field>
		<field name="dien_giai" label="1" rows="1" field="-">
		  <text v="Diễn giải" e="Explain"></text>
		</field>
      </fields>
    </form>
	
    <form gravity="TopRight" columns="120,120" >
      <fields>
			&VoucherRequiredFields01;
      </fields>
    </form>
    <form tabPageIndex="1" gravity="MiddleLeft" height="400" columns="120,120,240" >
      <text v="Chi tiết" e="Detail"></text>
      <fields>
        <field name="chcallct" allowBlank="false" label="" field="-" viewType="Grid">
          <text v="Chi tiết" e="Detail"></text>
        </field>
      </fields>
    </form>

    <form tabPageIndex="7" gravity="MiddleLeft" height="0" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="id" fileGroup="CH1" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
    <form gravity="BottomLeft" columns="120,120,120,120,120" >
      <fields>
		
        <field name="t_so_luong" label="1" field="1" dataType="N" disabled="true" format="Amount" hidden="false">
          <text v="Tổng số lượng" e="Total Quatity"></text>
        </field>
		
      </fields>
    </form>
  </forms>

  <grids>
    <grid id="chcallct" table="chcallct" fieldKey="id, line" order="line" allowFilter="true" readOnly="false" allowOrder="true">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>
		<field name="ma_nv" width="150" allowBlank="false" viewType="Lookup" readOnly="false">
		  <text v=" Mã nhân viên" e="Employee code"></text>
			<viewInfo lookupType="One" lookupId="dmnv" lookupKey="xstatus = 5" lookupCheck="1=1" lookupRef="ten_nv" lookupInfo="dmnv|ma_nv|ten_nv" />
		</field>
		<field name="ten_nv" width="200" fieldType="EX" inactivate="true" readOnly="true" aliasName="b" join=" left join dmnv b on a.ma_nv = b.ma_nv">
		  <text v="Họ và tên" e="Full name"></text>
		</field>
		<field name="so_luong" dataType="N" format="Qty" allowBlank="false" valueDefault="1" width="100" readOnly="false" hidden="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
        <field name="line_sip" width="80" allowBlank="true" viewType="Lookup" readOnly="false" >
          <text v="Mã line" e="Line Code"></text>
          <viewInfo lookupType="One" lookupId="dmlinegoi" lookupKey="status = 1 and ma_line not in (select line_sip from chcallct)" lookupCheck="1=1" lookupRef="ten_line" lookupInfo="dmlinegoi|ma_line|ten_line" />
        </field>
        <field name="ten_line" width="0" fieldType="EX" inactivate="true" readOnly="true" aliasName="c" join=" left join dmlinegoi c on a.line_sip = c.ma_line ">
          <text v="Tên line" e="Line Name"></text>
        </field>
        <field name="password_sip" width="200" inactivate="true" allowBlank="true" readOnly="false" disabled="false">
          <text v="Password SIP" e="Password SIP"></text>
        </field>
		
      </fields>
		  <buttons>
			<button id="add">
			  <text v="$AddToolbar" e="$AddToobar"></text>
			</button>
			<button id="delete">
			  <text v="$DeleteToolbar" e="$DeleteToolbar"></text>
			</button>
			<button id="copy">
			  <text v="$CopyToolbar" e="$CopyToolbar"></text>
			</button>
			<button id="paste">
			  <text v="$PasteToolbar" e="$PasteToolbar"></text>
			</button>
			<button id="moveup">
			  <text v="$MoveUpToolbar" e="$MoveUpToolbar"></text>
			</button>
			<button id="movedown">
			  <text v="$MoveDownToolbar" e="$MoveDownToolbar"></text>
			</button>
			<button id="split">
			  <text v="-" e="-"></text>
			</button>
			<button id="freeze">
			  <text v="$FreezeToolbar" e="$FreezeToolbar"></text>
			</button>
		  </buttons>

      <script>
        <query>
          <text>
            <![CDATA[<enc></enc>]]>
          </text>
        </query>
      </script>

    </grid>

  </grids>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>&VoucherSaleRequestGrid;<![CDATA[<enc>ZSCmN3uIqwXJ61/ZPBl2f5EBerm9295dQOzz+9u/oVBRryBnFyblOXlhq2Dxrl98wDURUFsOUWOmUk4Sj2CJgDIYGXZ6idybDdhDBdBX2SpiOD/c8EK6lNs/Y4Pro9o5VP4xlmndYUvLdOFXM/6sD1huz1ALzpaNnh4KEOOFjtWMweQW6BIVDRb/vZ6drqEf</enc>]]>&VoucherExRateValid01;<![CDATA[<enc>Py0/TmSZIMJaYLQLEORDRJz2jwFYS9rl/zGttIUzNQIk8Xow4za5vsZRiBNVNeAzN1beAzPl6FaSfcKlKu8jJECA8gMH+2/6ClcvgXtIuTlZ1UU02cP8cV7yRRXC0ACiZhzi6N8HZdY95z60AKcwHPUCcFAg9OdrD4PxCaOnZ1kGCAWwPChVBOPPvjl9PeYeu4MY5GOgJOWtKCNEYdJ75w==</enc>]]>&VoucherExRateValid02;<![CDATA[<enc></enc>]]>
