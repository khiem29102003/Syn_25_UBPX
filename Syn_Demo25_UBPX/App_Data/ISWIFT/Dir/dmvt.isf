<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
	<!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmvt" table="dmvt" fieldKey="ma_vt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
	<title v="Danh mục vật tư" e="Product List"></title>
	<title0 v="Mới" e="New"></title0>
	<title1 v="Sửa" e="Edit"></title1>
	<forms>
		<form gravity="TopLeft" columns="120,120,120" >
			<fields>
				<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
					<text v="" e=""></text>
				</field>
				<field name="ma_vt" format="U" label="1" field="1" viewType="AutoIncrease" clientDefault="true" allowBlank="false" fieldType="PK" importable="5" importWidth="250">
					<text v="Mã vật tư" e="Item Code"></text>
				</field>
				<field name="ten_vt" allowBlank="false" label="1" field="-" importable="10">
					<text v="Tên vật tư" e="Item Name"></text>
				</field>
				<field name="ten_vt2" allowBlank="true" label="1" field="-" importable="15">
					<text v="Tên khác" e="Other name"></text>
				</field>
			</fields>
		</form>
		<form tabPageIndex="1" gravity="MiddleLeft" height="330" columns="120,120,240" >
			<text v="Thông tin chung" e="General"></text>
			<fields>
				<field name="dvt" format="U" viewType="Lookup" label="1" field="1" clientDefault="true" allowBlank="false" importable="20" importWidth="50">
					<text v="Đơn vị tính" e="UOM"></text>
					<viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_dvt" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field>
				<field name="ton_kho_yn" dataType="B" clientDefault="true" label="[120]" field="[60]" inactivate="true" importable="25">
					<text v="Theo dõi tồn kho" e="Stock Control"></text>
				</field>
				<field name="lo_yn" dataType="B" clientDefault="true" label="[80]" field="[60]" nextRow="false" inactivate="true" importable="30">
					<text v="Theo dõi lô" e="Lot Control"></text>
				</field>
				<!-- <field name="ma_lvt" viewType="Lookup" label="1" field="1" clientDefault="true" importable="35"> -->
					<!-- <text v="Loại vật tư" e="Fee Type"></text> -->
					<!-- <viewInfo lookupType="One" lookupId="dmlvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_lvt" lookupInfo="dmlvt|ma_lvt|ten_lvt" importCheck="@@DF and z.status=1"/> -->
				<!-- </field> -->
				<!-- <field name="ten_lvt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true"> -->
					<!-- <text v="" e=""></text> -->
				<!-- </field> -->
				<field name="ma_lo" viewType="Lookup" label="1" field="1" clientDefault="true" importable="55">
					<text v="Mã lô" e="Lot Number "></text>
					<viewInfo lookupType="One" lookupId="dmlo" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_lo" lookupInfo="dmlo|ma_lo|ten_lo" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_lo" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="1" aliasName="cast('' as nvarchar(4000)) as "  clientDefault="true">
					<text v="" e=""></text>
				</field>
				<field name="nh_vt1" viewType="Lookup" label="1" field="1" importable="40">
					<text v="Nhóm 1" e="Group 1"></text>
					<viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'VT1' and status=1" lookupCheck="ma_loai_nh = 'VT1'" lookupRef="ten_nh_vt1" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'VT1' and z.status=1"/>
				</field>
				<field name="ten_nh_vt1" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field>
				<field name="nh_vt2" viewType="Lookup" label="1" field="1" importable="45">
					<text v="Nhóm 2" e="Group 2"></text>
					<viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'VT2' and status=1" lookupCheck="ma_loai_nh = 'VT2'" lookupRef="ten_nh_vt2" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'VT2' and z.status=1"/>
				</field>
				<field name="ten_nh_vt2" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field>
				<field name="nh_vt3" viewType="Lookup" label="1" field="1" importable="50">
					<text v="Nhóm 3" e="Group 3"></text>
					<viewInfo lookupType="One" lookupId="dmnh" lookupKey="ma_loai_nh = 'VT3' and status=1" lookupCheck="ma_loai_nh = 'VT3'" lookupRef="ten_nh_vt3" lookupInfo="dmnh|ma_nh|ten_nh" importCheck="@@DF and z.ma_loai_nh = 'VT3' and z.status=1"/>
				</field>
				<field name="ten_nh_vt3" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
					<text v="" e=""></text>
				</field>
				<field name="ma_kho" viewType="Lookup" label="1" field="1" clientDefault="true" importable="55">
					<text v="Mã kho" e="Site"></text>
					<viewInfo lookupType="One" lookupId="dmkho" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_kho" lookupInfo="dmkho|ma_kho|ten_kho" importCheck="@@DF and z.status=1"/>
				</field>
				<field name="ten_kho" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as "  clientDefault="true">
					<text v="" e=""></text>
				</field>
				<field name="ma_vi_tri" viewType="Lookup" label="1" field="1" clientDefault="true" importable="60">
					<text v="Mã vị trí" e="Location"></text>
					<viewInfo lookupType="One" lookupId="dmvitri" lookupKey="status=1 and ma_kho = ![ma_kho]!" lookupCheck="ma_kho = ![ma_kho]!" lookupRef="ten_vi_tri" lookupInfo="dmvitri|ma_vi_tri|ten_vi_tri" importCheck="@@DF and z.ma_kho = a.ma_kho and z.status=1"/>
				</field>
				<field name="ten_vi_tri" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as "  clientDefault="true">
					<text v="" e=""></text>
				</field>
			</fields>
		</form>
		<form tabPageIndex="2" gravity="MiddleLeft" height="350" columns="140,120,240" >
			<text v="Bảo hành" e="Guarantee"></text>
			<fields>
				<field name="ma_imei" format="U" label="1" field="1" importable="65">
					<text v="Mã imei" e="Imei Code"></text>
				</field>
				<field name="so_ngay_sp" label="1" field="1" dataType="N" format="Amount" importable="67">
					<text v="Vòng đời sp (số ngày)" e="Product Lifecycle (days)"></text>
				</field>
				<field name="so_ngay_bh" label="1" field="1" dataType="N" format="Amount" importable="68">
					<text v="Tg bảo hành (số ngày)" e="Warranty Period (days)"></text>
				</field>     
			</fields>
		</form>
		<form tabPageIndex="3" gravity="MiddleLeft" height="350" columns="120,120,240" >
			<text v="Kích cỡ/Màu sắc" e="Size/Color"></text>
			<fields>
				<field name="ma_vt2" format="U" label="1" field="1" importable="69">
					<text v="Mã phụ" e="Other Code"></text>
				</field>
				<field name="nuoc_sx" label="1" field="2" importable="70">
					<text v="Nước sản xuất" e="Manufacturer"></text>
				</field>
				<field name="mau_sac" label="1" field="2" importable="75">
					<text v="Màu sắc" e="Color"></text>
				</field>
				<field name="kich_co" label="1" field="2" importable="80">
					<text v="Kích cỡ" e="Size"></text>
				</field>
				<field name="kieu" label="1" field="2" importable="85">
					<text v="Kiểu" e="Style"></text>
				</field>
			</fields>
		</form>
		<form tabPageIndex="4" gravity="MiddleLeft" height="0" columns="120,120,360" >
			<text v="Hình ảnh" e="Images"></text>
			<fields>
				<field name="ximage" label="1" field="2" viewType="Image" fieldType="EXParam">
					<text v="Chọn hình ảnh" e="Chọn hình ảnh"></text>
					<viewInfo fileFieldId0="ma_vt" fileGroup="Fee" fileExtension="jpg,png" maxFileSize="10240" maxFileCount="10"></viewInfo>
				</field>
			</fields>
		</form>
		<form tabPageIndex="5" gravity="MiddleLeft" height="350" columns="120,120,240" >
			<text v="Khác" e="Other"></text>
			<fields>
				<field name="sl_min" label="1" field="1" dataType="N" format="Qty" importable="90">
					<text v="Tồn tối thiểu" e="Minimum Quantity"></text>
				</field>
				<field name="sl_max" label="1" field="1" dataType="N" format="Qty" importable="95">
					<text v="Tồn tối đa" e="Maximum Quantity"></text>
				</field>
				<field name="ngay_nhap" label="1" field="1" dataType="D" importable="96">
					<text v="Ngày nhập cuối" e="Last Receipt Date"></text>
				</field>
				<field name="ngay_xuat" label="1" field="1" dataType="D" importable="97">
					<text v="Ngày xuất cuối" e="Last Issue Date"></text>
				</field>
				<field name="ghi_chu" allowBlank="true" label="1" field="-" rows="3" importable="100">
					<text v="Ghi chú" e="Notes"></text>
				</field>
				<field name="status" viewType="Combobox" inactivate="true" label="1" field="2" valueDefault="1" importable="-1">
					<text v="Trạng thái" e="Status"></text>
					<viewInfo>
						<options>
							<option val="1">
								<text v="1 - Còn sử dụng" e="1 - Use"></text>
							</option>
							<option val="0">
								<text v="0 - Không sử dụng" e="0 - Not use"></text>
							</option>
						</options>
					</viewInfo>
				</field>
			</fields>
		</form>
	</forms>

	&DefaultButton;

	<js>
		<text>
			<![CDATA[<enc></enc>]]>
		</text>
	</js>
	
