    <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã chứng từ - Tên/nhóm đã tồn tại" e="Voucher Code - Name/Group Already Exists"/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã chứng từ - Tên/nhóm đã tồn tại" e="Voucher Code - Name/Group Already Exists"/>
    </message>
    <message val="commonInfo">
