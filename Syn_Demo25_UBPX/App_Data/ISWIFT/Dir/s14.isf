<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY DefaultButtonGridDetail SYSTEM "..\Include\XML\DefaultButtonGridDetail.xml">
  <!ENTITY VoucherRequiredFields01 SYSTEM "..\Include\XML\VoucherRequiredFields03.xml">
  <!ENTITY VoucherRequiredFields02 SYSTEM "..\Include\XML\VoucherRequiredFields02.xml">
  <!ENTITY VoucherRequest SYSTEM "..\Include\XML\VoucherRequest.xml">
  <!ENTITY VoucherJSLoading SYSTEM "..\Include\XML\VoucherJSLoading.xml">
  <!ENTITY VoucherExtendFields SYSTEM "..\Include\XML\VoucherExtendFields.xml">

  <!ENTITY VoucherExRateValid01 SYSTEM "..\Include\Script\VoucherExRateValid01.txt">
  <!ENTITY VoucherExRateValid02 SYSTEM "..\Include\Script\VoucherExRateValid02.txt">
  <!ENTITY VoucherNumberQuery SYSTEM "..\Include\Script\VoucherNumberQuery.txt">
  <!ENTITY VoucherNumberBeforeSave SYSTEM "..\Include\Script\VoucherNumberBeforeSave.txt">

  <!ENTITY VoucherCurrStockCreateTempTable SYSTEM "..\Include\Script\VoucherCurrStockCreateTempTable.txt">
  <!ENTITY VoucherCurrStockInsertNewTempTable SYSTEM "..\Include\Script\VoucherCurrStockInsertNewTempTable.txt">
  <!ENTITY VoucherCurrStockCalc SYSTEM "..\Include\Script\VoucherCurrStockCalc.txt">

  <!ENTITY VoucherSaleRequest SYSTEM "..\Include\XML\VoucherSaleRequest.xml">
  <!ENTITY VoucherSaleRequestGrid SYSTEM "..\Include\Script\VoucherSaleRequestGrid.txt">

  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from s14 where id = @id and status in (6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
    ">
]>


<dir id="s14" table="s14" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="YG4" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo giá khác" e="Other quotes"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120" >
		<fields>
			<field name="tt" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="[140]" field="0">
			  <text v="Thông tin khách hàng " e="Customer Information: "></text>
			</field>
			<field name="ma_gd" viewType="Combobox" valueDefault="" hidden="false" nextRow="false" label="" field="[180]" >
			  <text v="" e=""></text>
			  <viewInfo>
				<options query="select ma_gd, ten_gd%l from dmgd where ma_ct = '@@voucherCode' and status = 1 order by stt">
				</options>
			  </viewInfo>
			</field>
			<field name="ma_so_thue" label="1" field="1"  importable="35" nextRow="true" allowBlank="true">
			  <text v="Mã số thuế &lt;a onclick='getTax(this);'&gt;(Kiểm tra)&lt;/a&gt;" e="Tax Code &lt;a onclick='getTax(this);'&gt;(Test)&lt;/a&gt;"></text>
			</field>

			<field name="ma_kh" allowBlank="true" nextRow="false" viewType="Lookup" blank ="[80]" label="[100]" field="-"   hidden="false">
			  <text v="Mã khách hàng" e="Customer Code"></text>
			  <viewInfo lookupType="One" lookupId="dmkh" lookupKey="status = 1" lookupCheck="1=1" />
			</field>
			<field name="ten_kh" allowBlank="true" label="1" field="-" importWidth="250" importable="10">
			  <text v="Tên khách hàng" e="Customer Name"></text>
			</field>
			<field name="ten_kh2" label="1" field="-" importWidth="250"  importable="15">
			  <text v="Tên quốc tế" e="International Name"></text>
			</field>
			<field name="nguoi_lh" label="1" field="[200]" importable="40" nextRow="true">
			  <text v="Người liên hệ" e="Contact Person"></text>
			</field>
			<field name="email" label="[100]" field="-"  importable="80" nextRow="false"  allowBlank="true">
			  <text v="Email" e="Email"></text>
			</field>

			<field name="dia_chi" label="1" field="[200]" importWidth="250" importable="30">
			  <text v="Địa chỉ" e="Address"></text>
			</field>	
			<field name="dien_thoai" label="[100]" field="-" importable="80" allowBlank="false" nextRow="false">
			  <text v="Điện thoại" e="Phone"></text>
			</field>
			
			<field name="tieu_de" label="1"  field="-" allowBlank="false" >
				<text v="Tiêu đề " e="Request title	"></text>
			</field>
			<field name="noi_dung" label="1" rows="2" field="-">
				<text v="Ghi chú " e="Remarks"></text>
			</field>
			<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
			  <text v="" e=""></text>
			</field>
		</fields>
    </form>

    <form gravity="TopRight" columns="120,120" >
		<fields>
			&VoucherRequiredFields01;
			&VoucherRequiredFields02;
			<field name="ngay_hl" label="1" field="1" valueDefault="new Date()" dataType="D" allowBlank="false" >
				<text v="Ngày dự đi" e="Effective date"></text>
			</field>
			<field name="ngay_hld" label="1" field="1" dataType="D" allowBlank="false" >
				<text v="Ngày dự đến" e="Expiry date"></text>
			</field>
		</fields>
    </form>
	
	
	<form gravity="BottomLeft" columns="120,120,120,120,120,120" >
      <fields>
		<field name="xfile" label="1" field="-" viewType="File" fieldType="EXParam">
			<text v="" e=""></text>
			<viewInfo fileFieldId0="id" fileGroup="YG4" fileExtension="*" maxFileCount="10"></viewInfo>
		</field>
	  </fields>
    </form>
  </forms>

  

  &DefaultButton;


  <js>
    <text>
      <![CDATA[<enc></enc>]]>&VoucherExRateValid01;<![CDATA[<enc></enc>]]>
    </text>
  </js>
<css>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </css>

