  <!ENTITY CheckUpdatingDeleting "
  if exists(select 1 from s41 where id = @id and status in (5,6,7,9)) begin
    select '$NotEditVoucherStatus' as message
    return
  end
  if @@admin = 0 and exists(select 1 from s41 a where status = 5 and id = @id and not exists(select 1 from kbnguoiduyet y where y.user_id = @@userId and y.status = 1 and y.loai = 1 and a.ma_nt = y.ma_nt and (y.tien = 0 or a.t_tt_nt &lt;= y.tien))) begin
    select '$notApproveRightEdit' as message
    return
  end
    ">
]>


<dir id="s41" table="s41" fieldKey="id" transaction="true" tryCatch="true" dirViewType="Dialog" dirObjectType="Voucher" voucherCode="BQ1" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Báo giá vận chuyển hàng biển FCL" e="FCL Ocean Freight Quotes"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120,120" >
      <fields>
		<field name="ma_ngv" viewType="Combobox" valueDefault=""  hidden="false" label="1" field="1" >
          <text v="Loại báo giá" e="Inv. Type"></text>
          <viewInfo>
            <options query="select ma_ngv, ten_ngv%l from dmngv where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
		<field name="tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="1" field="">
          <text v="&lt;a onclick='getRequest(this);'&gt;(Từ báo giá)&lt;/a&gt; " e="&lt;a onclick='getRequest(this);'&gt;(From Quote)&lt;/a&gt;"></text>
        </field>
		<field name="ma_gd" nextRow="false" viewType="Combobox" valueDefault="" label="[100]" field="[120]"		>
          <text v="Giao dịch" e="Transaction Code"></text>
          <viewInfo>
            <options query="select ma_gd, ten_gd%l from dmgd where ma_ct = '@@voucherCode' and status = 1 order by stt">
            </options>
          </viewInfo>
        </field>
         <field name="ma_kh" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false">
          <text v="Mã khách hàng" e="Customer Code"></text>
          <viewInfo lookupType="One" lookupId="dmkh" lookupKey="kh_yn = 1 and status = 1" lookupCheck="1=1" lookupRef="ten_kh" lookupInfo="dmkh|ma_kh|ten_kh" />
        </field>
        <field name="ten_kh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="ma_noi_di" allowBlank="true" viewType="Lookup" label="1" field="1" >
			<text v="Nơi đi" e="Origin"></text>
			<viewInfo lookupType="One" lookupId="vdmcangdi" lookupKey="(hc_yn = 1 or kkh_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_di" lookupInfo="vdmcangdi|ma_noi_di|ten_noi_di" />
		</field>
		<field name="ten_noi_di" allowBlank="false" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="[150]"  aliasName="cast('' as nvarchar(4000)) as ">
			<text v="" e=""></text>
		</field> 	
		<field name="ma_dk_gh" viewType="Combobox" valueDefault="2" label="[120]" field="[70]" nextRow="false" >
			<text v="Điều kiện giao hàng" e="Traffic term"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'DK' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>		
		<field name="ma_noi_den" viewType="Lookup" label="1" field="1" allowBlank="true">
			<text v="Nơi đến" e="Destination"></text>
			<viewInfo lookupType="One" lookupId="vdmcangden" lookupKey="(hc_yn = 1 or kkh_yn = 1) and status = 1" lookupCheck="1=1" lookupRef="ten_noi_den" lookupInfo="vdmcangden|ma_noi_den|ten_noi_den"/>
		</field>
		<field name="ten_noi_den" allowBlank="true" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="true" label="" field="[150]" aliasName="cast('' as nvarchar(200)) as ">
			<text v="" e=""></text>
		</field> 			
		<field name="ma_dk_nh" viewType="Combobox" valueDefault="2" label="[120]" field="[70]" nextRow="false">
			<text v="Điều kiện nhận hàng" e="Traffic term"></text>
			<viewInfo>
				<options query="select ma_bgn, ten_bgn%l from dmbgn where ma_ct = 'DK' and status = 1 order by stt">
				</options>
			</viewInfo>
		</field>
		<field name="ds_cong" allowBlank="true" viewType="Lookup" label="1" field="-"  hidden="false">
			  <text v="Container" e="Container List"></text>
			  <viewInfo lookupType="Multi" lookupId="dmcong2" lookupKey="status=1" lookupCheck="status=1" lookupRef="" lookupInfo="dmcong|ma_cong|ten_cong" />
			</field>
		<field name="tt2" nextRow="true" fieldType="EX" readOnly="true" inactivate="true" label="[180]" field="">
          <text v="Đơn vị vận chuyển &lt;a onclick='getRequest2(this);'&gt;(Lấy số liệu)&lt;/a&gt; " e="Transport info &lt;a onclick='getRequest2(this);'&gt;(Get data)&lt;/a&gt;"></text>
        </field>
		<field name="cvc_yn" dataType="B" clientDefault="true" label="[60]" field="[40]" nextRow="false" valueDefault="1"  inactivate="true">
          <text v="Cước v/c" e="Freight"></text>
        </field>
		<field name="xk_yn" dataType="B" clientDefault="true" label="[60]" field="[40]" nextRow="false" valueDefault="0"  inactivate="true">
          <text v="Xuất khẩu" e="Export"></text>
        </field>
		<field name="nk_yn" dataType="B" clientDefault="true" label="[60]" field="[40]" nextRow="false" valueDefault="0"  inactivate="true">
          <text v="Nhập khẩu" e="Import"></text>
        </field>
		<field name="pp_yn" dataType="B" clientDefault="true" label="[60]" field="[40]" nextRow="false" valueDefault="0"  inactivate="true">
          <text v="Phụ phí" e="Surcharge"></text>
        </field>
		<field name="ma_hang" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false">
		  <text v="Hãng tàu/ Đại lý" e="Carrier/ Agent Code"></text>
		  <viewInfo lookupType="One" lookupId="vdmhangtau" lookupKey="status = 1 and (ncc_yn =1 or dl_yn = 1)" lookupCheck="1=1" lookupRef="ten_hang" lookupInfo="vdmhangtau|ma_hang|ten_hang" />
		</field>
		<field name="ten_hang" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="true" label="" field="-" aliasName="cast('' as nvarchar(200)) as ">
		  <text v="" e=""></text>
		</field>				
		<field name="ds_ngay" allowBlank="true" viewType="Lookup" label="1" field="1"  hidden="false">
			<text v="Lịch vận chuyển" e="Schedule Days"></text>
			<viewInfo lookupType="Multi" lookupId="dmbgn" lookupKey="status=1 and ma_ct ='DIW'" lookupCheck="status=1" lookupRef="" lookupInfo="dmbgn|ma_bgn|ten_bgn" />
		</field>
		<field name="ngay_hl"  label="[100]" field="[120]" dataType="D" valueDefault="new Date()" allowBlank="false" nextRow="false" >
			<text v="Hiệu lực từ/ đến:" e="Effective date"></text>
		</field>	
		<field name="ngay_hld" label="" field="[120]" dataType="D" allowBlank="false" nextRow="false" >
			<text v="Hiệu lực đến" e="Expiry date"></text>
		</field>
		<field name="dien_giai" label="1" rows="1" field="-">
		  <text v="Diễn giải" e="Explain"></text>
		</field>
		<field name="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="id_yc" dataType="N" fieldType="PK" format="0" copy="true" hidden="true">
		  <text v="" e=""></text>
		</field>
		<field name="so_yc" format="U" allowBlank="true" label="1" field="1" hidden="true">
		  <text v="Số y/c" e="Voucher No"></text>
		</field>
		<field name="so_tg" format="U" allowBlank="true" label="1" field="1" hidden="true">
		  <text v="Số T/g" e="Voucher No"></text>
		</field>
		<field name="id_tg" dataType="N" fieldType="PK" format="0" copy="true" hidden="true">
		  <text v="" e=""></text>
		</field>
      </fields>
    </form>

