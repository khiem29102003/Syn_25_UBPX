  <grids>
    <grid id="r11" table="r11" fieldKey="id, line" order="line" readOnly="false">
      <fields>
        <field name="id" foreignField="id" dataType="N" fieldType="PK" format="0" copy="false" hidden="true">
          <text v="" e=""></text>
        </field>
        <field name="line" foreignField="@@ROW" dataType="I" fieldType="PK" hidden="true">
          <text v="Dòng" e="Line"></text>
        </field>

        <field name="ma_cong" width="90" viewType="Lookup" readOnly="false" >
          <text v="Mã công" e="Freight Code"></text>
		<viewInfo lookupType="One" lookupId="dmcong" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_cong" lookupInfo="dmcong|ma_cong|ten_cong" />

        </field>
        <field name="ten_cong" width="120" inactivate="true" readOnly="true" aliasName="b" >
          <text v="Tên công" e="Freight Name"></text>
        </field>
		<!--
        <field name="dvt" width="80" allowBlank="true" viewType="Lookup" readOnly="false" >
          <text v="Đơn vị" e="Calculation Unit"></text>
          <viewInfo lookupType="One" lookupId="dmdvt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_dvt" lookupInfo="dmdvt|dvt|ten_dvt" />
        </field>
        <field name="ten_dvt" width="250" fieldType="EX" hidden="true" inactivate="true" readOnly="true" aliasName="c" join=" left join dmdvt c on a.dvt = c.dvt ">
          <text v="" e=""></text>
        </field> 
		-->
        <field name="so_luong" dataType="N" format="Amount"  hidden="false" allowBlank="true" valueDefault="1" width="100" readOnly="false" >
          <text v="Số lượng" e="Quantity"></text>
        </field>
		<field name="sl_x" dataType="N" format="Amount"  hidden="false" allowBlank="true" valueDefault="1" width="100" readOnly="false" disabled="true" >
          <text v="SL phân bổ" e="Quantity Allotment"></text>
        </field>
		<field name="sl_t" dataType="N" format="Amount"  hidden="false" allowBlank="true" valueDefault="1" width="100" readOnly="false"  disabled="true" >
          <text v="SL tồn" e="Quantity in stock"></text>
        </field>
		
		
