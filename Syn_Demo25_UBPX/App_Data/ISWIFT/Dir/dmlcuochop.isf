<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmlcuochop" table="dmlcuochop" fieldKey="ma_lcuochop" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục loại cuộc họp" e="List of meeting type"></title>
  <title0 v="Thêm mới - loại cuộc họp" e="New - meeting type"></title0>
  <title1 v="Sửa - loại cuộc họp" e="Edit - meeting type"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120" >
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_lcuochop" label="[120]" field="[120]" allowBlank="false" format="U" disabled="false" fieldType="PK" importable="5" >
				<text v="Mã loại cuộc họp" e="Meeting Type Code"></text>
			</field>
			<field name="ten_lcuochop" label="[120]" field="-" allowBlank="false" disabled="false" importable="10">
			  <text v="Tên loại cuộc họp" e="Meeting Type Name"></text>
			</field>
			<field name="ten_lcuochop2" label="[120]" field="-" allowBlank="true" disabled="false" importable="15">
			  <text v="Tên tiếng anh" e="English Name"></text>
			</field>
			<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
</forms>

&DefaultButton;

