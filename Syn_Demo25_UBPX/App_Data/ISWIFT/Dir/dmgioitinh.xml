<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmgioitinh" table="dmgioitinh" fieldKey="ma_gt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục giới tính" e="List of Genders"></title>
  <title0 v="Thêm mới" e="Create New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_gt" format="U" label="1" field="1" allowBlank="false" fieldType="PK"  importable="5">
          <text v="Mã giới tính" e="Gender Code"></text>
        </field>
        <field name="ten_gt" label="1" field="-" allowBlank="false" importable="10">
          <text v="Tên giới tính" e="Gender Name"></text>
        </field>
        <field name="ten_gt2" label="1" field="-" importable="15">
          <text v="Tên khác" e="Other Name"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" valueDefault="1" label="1" field="2">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmgioitinh(p){
  this.constructor(p);
}
dir$dmgioitinh.prototype = new DirEvent();
dir$dmgioitinh.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmgioitinh.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

dir$dmgioitinhDisabledMasterField(p, g);

}

function dir$dmgioitinhDisabledMasterField(p, g){
  
  if(p.valForm('ma_gt').trim() != '')
  {
    p.setDisabled('ma_gt', true);
  }
  else
  {
    p.setDisabled('ma_gt', false);
  }
}
         ]]>
    </text>
  </js>
  
  <css>
	<text>
	  <![CDATA[
		.control-label.ma_gt, .control-label.ten_gt
		{	
			//font-weight:bold;	
			color: #499b98;;
		}
	  ]]>
	</text>
  </css>
  
  <script>
	<importing>
      <text>
        <![CDATA[
		@@insert
        ]]>
      </text>
    </importing>
  </script>
  
  <messages>
	<message val="codeExistsNewMsg">
		<text v="Mã giới tính đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The gender code already exists in the catalog, please choose a different code."/>
	</message>
	<message val="codeExistsEditMsg">
		<text v="Mã giới tính đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The gender code already exists in the catalog, please choose a different code."/>
	</message>
  </messages>
</dir>