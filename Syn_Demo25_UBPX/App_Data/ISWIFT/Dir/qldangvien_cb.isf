<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="qldangvien_cb" table="qldangvien" fieldKey="ma_dangvien" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Quản lý đảng viên Cán bộ" e="Party Member Management for Officials"></title>
  <title0 v="Thêm mới - đảng viên" e="New - party member"></title0>
  <title1 v="Sửa -đảng viên" e="Edit - party member"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120" >
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_dangvien" format="U" label="1" field="1" allowBlank="false" disabled="false" fieldType="PK" importable="5">
				<text v="Mã đảng viên" e="Party Member Code"></text>
			</field>
			
			<field name="ma_dancu" viewType="Lookup" label="1" field="1" allowBlank="false" importable="10">
				<text v="Mã cư dân" e="Resident code"></text>
			  <viewInfo lookupType="One" lookupId="qldctcccd" lookupKey="ma_dancu in (select ma_dancu from dmnv where ma_dancu IS NOT NULL AND ma_dancu != '')" lookupRef="ten_dancu" lookupCheck="ma_dancu not in (select ma_dancu from dmnv where ma_dancu IS NOT NULL AND ma_dancu != '')" lookupInfo="qldctcccd|ma_dancu|ten_dancu" importCheck="@@DF and z.status=1"/>
			</field>
			<field name="ten_dancu" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			
			<field name="so_the_dang" allowBlank="false" label="1" field="1" importable="15">
				<text v="Số thẻ đảng" e="Party card number"></text>
			</field>
			<field name="ngay_vao_dang" label="1" field="1" dataType="D" importable="20">
				<text v="Ngày vào đảng" e="Party admission"></text>
			</field>
			<field name="ngay_chinh_thuc" label="1" field="1" dataType="D" importable="25">
				<text v="Ngày chính thức" e="Official admission"></text>
			</field>
			<field name="ma_chibo" viewType="Lookup" label="1" field="1" allowBlank="true" importable="30">
				<text v="Mã chi bộ" e="Party Cell code"></text>
			  <viewInfo lookupType="One" lookupId="dmchibo" lookupKey="status=1" lookupRef="ten_chibo" lookupCheck="1=1" lookupInfo="dmchibo|ma_chibo|ten_chibo" importCheck="@@DF and z.status=1"/>
			</field>
			<field name="ten_chibo" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ma_loai" viewType="Combobox" label="1" field="1" inactivate="true" disabled="true" importable="-1">
			  <text v="Mã loại" e="Type Code"></text>
			  <viewInfo>
				<options query="select ma_loai, ten_loai%l from dmloaidangvien where status = 1 and ma_loai = 'CANBO' order by ma_loai">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
</forms>

&DefaultButton;

<js>
    <text>
  <![CDATA[<enc></enc>]]>
    </text>
  </js>
