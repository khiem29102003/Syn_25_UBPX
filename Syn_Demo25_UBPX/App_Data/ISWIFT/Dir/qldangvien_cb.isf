	<messages>
		<message val="codeExistsNewMsg">
		  <text v="Mã đảng viên đã tồn tại trong danh mục." e="The party member code already exists in the list."/>
		</message>
		<message val="StdDuplicate">
		  <text v="Số thẻ đảng đã tồn tại trong danh mục." e="The party card number already exists in the list."/>
		</message>
	</messages>
</dir>
