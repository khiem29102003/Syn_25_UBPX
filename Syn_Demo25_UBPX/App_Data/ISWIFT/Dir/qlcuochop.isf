<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="qlcuochop" table="qlcuochop" fieldKey="ma_cuochop" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh sách cuộc họp" e="List of Meetings"></title>
  <title0 v="Mới - cuộc họp" e="New - meeting"></title0>
  <title1 v="Sửa - cuộc họp" e="Edit - meeting"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120,120">
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_cuochop" label="1" field="-" allowBlank="false" fieldType="PK" disabled="true" importable="-1">
				<text v="Mã cuộc họp" e="Meeting code"></text>
			</field>
			<field name="ten_cuochop" label="1" field="-" allowBlank="false" disabled="false" importable="10">
			  <text v="Tên cuộc họp" e="Meeting Name"></text>
			</field>
			<field name="ten_cuochop2" label="1" field="-" allowBlank="true" disabled="false"  importable="15">
			  <text v="Tên tiếng anh" e="English name"></text>
			</field>
			<field name="noi_dung" label="1" field="-" allowBlank="false" disabled="false" rows="3"  importable="15">
			  <text v="Nội dung cuộc họp" e="Meeting Content"></text>
			</field>
			<field name="ma_lcuochop" allowBlank="false" viewType="Lookup" label="1" field="1" hidden="false" importable="20">
			  <text v="Mã loại cuộc họp" e="Meeting Type Code"></text>
			  <viewInfo lookupType="One" lookupId="dmlcuochop" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_lcuochop" lookupInfo="dmlcuochop|ma_lcuochop|ten_lcuochop" />
			</field>
			<field name="ten_lcuochop" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="ngay_hop" nextRow="true" dataType="D" valueDefault="new Date()" label="1" field="1" importable="5" >
				<text v="Ngày họp" e="Meeting Date"></text>
			</field>
			<field name="gio_bd" label="1" field="[100]" allowBlank="true" disabled="false" nextRow="false" >
				<text v="Giờ bắt đầu" e="Time Start"></text>
			</field>
			<field name="gio_kt" label="1" field="[100]" allowBlank="true" disabled="false" nextRow="false">
				<text v="Giờ kết thúc" e="Time End"></text>
			</field>
			<field name="dia_chi" label="1" field="1" allowBlank="false" disabled="false" importable="15">
			  <text v="Địa điểm" e="Location"></text>
			</field>
			<field name="ds_chutri" viewType="Lookup" label="1" field="-" allowBlank="false" setype="1" nextRow="true">
			  <text v="Chủ trì" e="Chairperson "></text>
			  <viewInfo lookupType="Multi" lookupId="dmnv" lookupKey="xstatus = 5 and status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmnv|ma_nv|ten_nv" />
			</field>
			<field name="ds_nguoithamgia" viewType="Lookup" label="1" field="-" allowBlank="false" setype="1" nextRow="true">
			  <text v="Thành phần tham gia" e="Participants"></text>
			  <viewInfo lookupType="Multi" lookupId="dmnv" lookupKey="xstatus = 5 and status = 1" lookupCheck="1=1" lookupRef="" lookupInfo="dmnv|ma_nv|ten_nv" />
			</field>
			<field name="status" viewType="Combobox" inactivate="false" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
				</options>
			  </viewInfo>
			</field>
      </fields>
    </form>
	<form tabPageIndex="1" gravity="MiddleLeft" height="300" columns="120,120,360" >
      <text v="Đính kèm" e="Attach Files"></text>
      <fields>
        <field name="xfile" label="1" field="2" viewType="File" fieldType="EXParam">
          <text v="Chọn files" e="Attach Files"></text>
          <viewInfo fileFieldId0="ma_cuochop" fileGroup="qlcuochop" fileExtension="*" maxFileSize="10240" maxFileCount="10"></viewInfo>
        </field>
      </fields>
    </form>
</forms>

&DefaultButton;

<js>
<text>
  <![CDATA[<enc></enc>]]>
    </text>
  </js>
