  <messages>

	 <message val="RequireMaPl">
      <text v="Vui lòng chọn văn bản lưu hành để tạo mã văn bản" e="Please select a circulation document to generate a document code."/>
    </message>
	<message val="RequireMaNVB">
      <text v="Vui lòng chọn nhóm văn bản để tạo mã văn bản" e="Please select a document group to generate a document code."/>
    </message>
	<message val="codeExistsNewMsg">
	  <text v="Mã văn bản đã tồn tại trong danh mục." e="The document code already exists in the list."/>
	</message>
  </messages>
</dir>
