  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã vật tư đã tồn tại trong danh mục vật tư." e="The record already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã vật tư đã tồn tại trong danh mục vật tư." e="The record already exists."/>
    </message>
	<message val="uploadSuccess">
      <text v="Tải hình ảnh lên thành công." e="Image uploaded successfully."/>
    </message>
	<message val="uploadFail">
      <text v="Tải hình ảnh lên thất bại." e="Image upload failed."/>
    </message>
	<message val="uploadLimit">
      <text v="Chỉ được phép chọn tối đa 5 hình ảnh." e="Only a maximum of 5 images are allowed."/>
    </message>
	<message val="uploadUndefined">
      <text v="Chọn ảnh mới không hợp lệ." e="Select new invalid image."/>
    </message>
	<message val="uploadCount">
      <text v=" hình ảnh đã được tải lên." e=" image has been uploaded."/>
    </message>
	<message val="uploadEmpty">
      <text v="." e="."/>
    </message>
  </messages>
</dir>