<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY Jquery371 SYSTEM "..\Include\Script\jquery-3.7.1.min.js">
]>


<dir id="dmbv" table="dmbv" fieldKey="ma_bv" dirViewType="Dialog" width="Large" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bài viết" e="Posts list"></title>
  <title0 v="Mới - bài viết" e="New - post"></title0>
  <title1 v="Sửa - bài viết" e="Edit - post"></title1>
  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>       
        <field name="ma_bv" label="1" field="1" clientDefault="false" format="U" fieldType="PK" importable="5" disabled="true">
          <text v="Mã bài viết" e="Code"></text>
        </field>
        <field name="ten_bv" allowBlank="false" label="1" field="-" importable="10">
          <text v="Tiêu đề bài viết" e="Name"></text>
        </field>
        <field name="ten_bv2" allowBlank="true" label="1" field="-" importable="15">
          <text v="Tên tiếng anh" e="English name"></text>
        </field>
		<field name="tag" allowBlank="false" viewType="Lookup" label="1" field="1" hidden="false" importable="20">
          <text v="Mã loại bài viết" e="Post Type Code"></text>
          <viewInfo lookupType="One" lookupId="dmloaibv" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_tag" lookupInfo="dmloaibv|ma_loai|ten_loai" />
        </field>
        <field name="ten_tag" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="false" label="1" field="1" importable="-1" >
		  <text v="Trạng thái" e="Gender"></text>
		  <viewInfo>
			<options query="select ma_tt, ten_tt%l from dmttsd where status = 1">
			</options>
		  </viewInfo>
		</field>
		<field name="danh_gia" allowBlank="true" dataType="N" importable="-1" hidden="true">
          <text v="Đánh giá" e="Evaluate"></text>
        </field>
		<field name="luot_xem" allowBlank="true" dataType="N" importable="-1" hidden="true">
          <text v="Lượt xem" e="Views"></text>
        </field>
      </fields>
    </form>
	<form tabPageIndex="1" gravity="MiddleLeft" height="350" columns="120,120,120,230" >
      <text v="Mô tả" e="Describe"></text>
      <fields>
		 <field name="mo_ta" label="0" field="-">
          <text v="Mô tả" e="Description"></text>
        </field>	
	  </fields>
	</form>
	<form tabPageIndex="2" gravity="MiddleLeft" height="350" columns="120,120,120,230" >
      <text v="Nội dung" e="Content"></text>
      <fields>
		 <field name="noi_dung" label="0" field="-">
          <text v="Nội dung" e="Content"></text>
        </field>	
	  </fields>
	</form>
	<form tabPageIndex="3" gravity="MiddleLeft" height="360" columns="120,120,120,120,120,120" >
		<text v="Hình ảnh" e="Content"></text>
		<fields>
			<field name="ximage1" label="1" field="0">
			  <text v="&lt;img class='image-single' id='img_ximage1' src='' onerror='src=`../Images/noImage.png`'/&gt; &lt;input type='button' value='Tải ảnh' onclick='browseServer(`ximage1`, `img_ximage1`);' value='Mở 1' style='text-align: center; display: block; margin: 0 auto;' /&gt;" e="&lt;img class='image-single' id='img_ximage1' src='' onerror='src=`../Images/noImage.png`'/&gt; &lt;input type='button' value='Upload Image' onclick='browseServer(`ximage1`, `img_ximage1`);' value='Open 1' style='text-align: center; display: block; margin: 0 auto;' /&gt;"></text>
			</field>
		</fields>
	</form>
	<form tabPageIndex="4" gravity="MiddleLeft" height="360" columns="120,120,120,120,120,120" >
      <text v="SEO" e="SEO"></text>
      <fields>
        <field name="title" label="1" field="-" importable="25">
          <text v="Title" e="Title"></text>
        </field>
        <field name="keywords" label="1" field="-" importable="30">
          <text v="Keywords" e="Keywords"></text>
        </field>
        <field name="description" label="1" field="-" importable="35">
          <text v="Description" e="Description"></text>
        </field>
        <field name="og_title" label="1" field="-" importable="40">
          <text v="Og title" e="Og title"></text>
        </field>      
		<field name="og_description" label="1" field="-" importable="45">
          <text v="Og description" e="Og description"></text>
        </field>
		<field name="canonical" label="1" field="-" importable="50">
          <text v="Canonical" e="Canonical"></text>
        </field>
		<field name="og_image" label="1" field="-" importable="55">
          <text v="Og image" e="Og image"></text>
        </field>
		<field name="copyright" label="1" field="-" importable="60">
          <text v="Copyright" e="Copyright"></text>
        </field>
		<field name="author" label="1" field="-" importable="75">
          <text v="Author" e="Author"></text>
        </field>
		<field name="generator" label="1" field="-" importable="80">
          <text v="Generator" e="Generator"></text>
        </field>
		<field name="og_site_name" label="1" field="-" importable="85">
          <text v="Og site name" e="Og site name"></text>
        </field>
		<field name="og_type" label="1" field="-" importable="90">
          <text v="Og type" e="Og type"></text>
        </field>
		<field name="og_locale" label="1" field="-" importable="95">
          <text v="Og locale" e="Og locale"></text>
        </field>
		<field name="robots" label="1" field="-" importable="100">
          <text v="Robots" e="Robots"></text>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

