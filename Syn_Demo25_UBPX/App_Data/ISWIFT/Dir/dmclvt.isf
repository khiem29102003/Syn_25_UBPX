<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="dmclvt" table="dmclvt" fieldKey="ma_clvt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục dịch vụ" e="Service List"></title>
  <title0 v="Thêm mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_clvt" format="U" label="1" field="2" allowBlank="false" fieldType="PK" >
          <text v="Mã dịch vụ" e="Service Code"></text>
        </field>
        <field name="ten_clvt" label="1" field="2" allowBlank="false" fieldType="PK" >
          <text v="Tên dịch vụ" e="Description"></text>
        </field>
        <field name="ten_clvt2" label="1" field="2">
          <text v="Tên khác" e="Other name"></text>
        </field>
		<field name="thu_tu" label="1" field="2" dataType="N">
          <text v="Thứ tự" e="Position"></text>
        </field>
		
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
	<form gravity="TopRight" columns="120,120" >
		<fields>
			<field name="ximage1" label="1" field="0" importable="65">
			  <text v="&lt;img class='image-single' id='img_ximage1' src='' onerror='src=`../Images/noImage.png`'/&gt; &lt;input type='button' value='Tải ảnh' onclick='browseServer(`ximage1`, `img_ximage1`);' value='Mở 1' style='text-align: center; display: block; margin: 0 auto;' /&gt;" e="Image 1"></text>
			</field>
			<field name="ximage2" label="1" field="0" importable="65" nextRow="false">
			  <text v="&lt;img class='image-single' id='img_ximage2' src='' onerror='src=`../Images/noImage.png`'/&gt; &lt;input type='button' value='Tải ảnh' onclick='browseServer(`ximage2`, `img_ximage2`);' value='Mở 2' style='text-align: center; display: block; margin: 0 auto;' /&gt;" e="Image 2"></text>
			</field>
	   </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[<enc></enc>]]>
    </text>
  </js>

  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã dịch vụ đã có hoặc lồng nhau trong danh mục dịch vụ." e="The Service is invalid or already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã dịch vụ đã có hoặc lồng nhau trong danh mục dịch vụ." e="The Service is invalid or already exists."/>
    </message>
  </messages>

</dir>