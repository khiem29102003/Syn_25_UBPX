<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
  <!ENTITY CheckUpdatingDeleting "
	if exists(select 1 from cskh0 where ma_so_thue = @ma_so_thue and status in (1)) begin
