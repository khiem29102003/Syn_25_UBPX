<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmnt" table="dmnt" fieldKey="ma_nt" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục ngoại tệ" e="Currency List"></title>
  <title0 v="Mới" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_nt" format="U" label="1" field="1" allowBlank="false" fieldType="PK" >
          <text v="Mã ngoại tệ" e="Currency Code"></text>
        </field>
        <field name="ten_nt" label="1" field="-" allowBlank="false" >
          <text v="Tên ngoại tệ" e="Currency Namr"></text>
        </field>
        <field name="ten_nt2" label="1" field="-" >
          <text v="Tên khác" e="Other name"></text>
        </field>
        <field name="stt" label="1" field="1" dataType="I">
          <text v="Stt" e="No"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

