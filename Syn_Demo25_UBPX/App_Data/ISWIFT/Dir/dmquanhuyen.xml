<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmquanhuyen" table="dmquanhuyen" fieldKey="ma_quanhuyen" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục quận/huyện" e="District List"></title>
  <title0 v="Thêm mới - quận huyện" e="New - district"></title0>
  <title1 v="Sửa - quận huyện" e="Edit - district"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_quanhuyen" format="U" label="1" field="1" allowBlank="false" fieldType="PK" importable="5">
          <text v="Mã quận huyện" e="District Code"></text>
        </field>
        <field name="ten_quanhuyen" label="1" field="-" allowBlank="false" importable="10">
          <text v="Tên quận huyện" e="District Name"></text>
        </field>
		<field name="ten_quanhuyen2" label="1" field="-" allowBlank="true" importable="15">
          <text v="Tên tiếng anh" e="English Name "></text>
        </field>
		<field name="ma_ttp" viewType="Lookup" label="1" field="1" clientDefault="true" importable="20">
          <text v="Tỉnh thành" e="Province/City"></text>
          <viewInfo lookupType="One" lookupId="dmttp" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_ttp" lookupInfo="dmttp|ma_ttp|ten_ttp" importCheck="@@DF and z.status=1" />
        </field>
        <field name="ten_ttp" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true">
          <text v="" e=""></text>
        </field>
		<field name="status" viewType="Combobox" inactivate="true" label="1" field="2" valueDefault="1" nextRow="true" importable="-1" >
		  <text v="Trạng thái" e="Status"></text>
		  <viewInfo>
			<options query="select ma_tt, ten_tt%l from dmttsd where status = 1 ">
			</options>
		  </viewInfo>
		</field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmquanhuyen(p){
  this.constructor(p);
}
dir$dmquanhuyen.prototype = new DirEvent();
dir$dmquanhuyen.prototype.afterInit = function(){
  var p = this._dir, g = p.grid();
  dir$dmquanhuyenDisabledMasterField(p, g);
}
function dir$dmquanhuyenDisabledMasterField(p, g){
  
  if(p.valForm('ma_quanhuyen').trim() != '')
  {
    p.setDisabled('ma_quanhuyen', true);
  }
  else
  {
    p.setDisabled('ma_quanhuyen', false);
  }
}
         ]]>
    </text>
  </js>
  <css>
		<text>
		  <![CDATA[
	.control-label.ma_quanhuyen, .control-label.ten_quanhuyen
	{	
		color: #499b98;;
	}
		  ]]>
		</text>
  </css>

  <script>
    <declare>
      <text>
        <![CDATA[
declare @codeExistsNewMsg nvarchar(256), @codeExistsEditMsg nvarchar(256)
select @codeExistsNewMsg = case when '@@lan' = 'v' then N'Mã quận huyện đã tổn tại.' else N'Code area already exists.' end
select @codeExistsEditMsg = case when '@@lan' = 'v' then N'Mã quận huyện đã tổn tại.' else N'Code area already exists.' end
         ]]>
      </text>
    </declare>
  </script>
  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã quận huyện đã tổn tại." e="Code area already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã quận huyện đã tổn tại." e="Code area already exists."/>
    </message>
  </messages>
</dir>