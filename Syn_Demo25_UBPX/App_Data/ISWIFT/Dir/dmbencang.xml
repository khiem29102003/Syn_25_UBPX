<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmbencang" table="dmbencang" fieldKey="ma_ben" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục bến cảng" e="List of Ports"></title>
  <title0 v="Thêm mới" e="Create New"></title0>
  <title1 v="Sửa" e="Edit"></title1>


  <forms>
    <form gravity="TopLeft" columns="120,120,120" >
      <fields>
        <field name="ma_ben" format="U" label="1" field="1" allowBlank="false" fieldType="PK" importable="1"  >
          <text v="Mã bến cảng" e="Port Code"></text>
        </field>
        <field name="ten_ben" label="1" field="-" allowBlank="false" importable="5" >
          <text v="Tên bến cảng" e="Port Name"></text>
        </field>
        <field name="ten_ben2" label="1" field="-" importable="10" >
          <text v="Tên khác" e="Other Name"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" valueDefault="1" label="1" field="2" >
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

  <js>
    <text>
      <![CDATA[
function dir$dmbencang(p){
  this.constructor(p);
}
dir$dmbencang.prototype = new DirEvent();
dir$dmbencang.prototype.afterInit = function(){
  var p = this._dir;
}
dir$dmbencang.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

  dir$dmbencangDisabledMasterField(p, g);

}

function dir$dmbencangDisabledMasterField(p, g){
  
  if(p.valForm('ma_ben').trim() != '')
  {
    p.setDisabled('ma_ben', true);
  }
  else
  {
    p.setDisabled('ma_ben', false);
  }
}
         ]]>
    </text>
  </js>
 
  <css>
	<text>
	  <![CDATA[
		.control-label.ma_ben, .control-label.ten_ben
		{	
			//font-weight:bold;	
			color: #499b98;;
		}
	  ]]>
	</text>
  </css>
  
  <script>
	<importing>
      <text>
        <![CDATA[
		@@insert
        ]]>
      </text>
    </importing>
  </script>
  
  <messages>
	<message val="codeExistsNewMsg">
		<text v="Mã bến cảng đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The port code already exists in the catalog, please choose a different code."/>
	</message>
	<message val="codeExistsEditMsg">
		<text v="Mã bến cảng đã tồn tại trong danh mục, vui lòng chọn một mã khác." e="The port code already exists in the catalog, please choose a different code."/>
	</message>
  </messages>

</dir>