<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>

<dir id="qlhccong" table="qlhccong" fieldKey="ma_hccong, stt" transaction="true" tryCatch="true" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Quản lý hành chính công" e="Public Administration Management."></title>
  <title0 v="Thêm mới - hành chính công" e="New - public administration"></title0>
  <title1 v="Sửa - hành chính công" e="Edit - Public Administration"></title1>

  <forms>
	<form gravity="TopLeft" columns="120,120,120,120,120" >
		<fields>
			<field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
			  <text v="" e=""></text>
			</field>
			<field name="ma_hccong" allowBlank="false" viewType="Lookup" label="1" field="1"  hidden="false" fieldType="PK">
			  <text v="Mã hành chính công" e="Public Administration Code"></text>
			  <viewInfo lookupType="One" lookupId="dmhccong" lookupKey="status = 1" lookupCheck="1=1" lookupRef="ten_hccong" lookupInfo="dmhccong|ma_hccong|ten_hccong" />
			</field>
			<field name="ten_hccong" nextRow="false" fieldType="EX" readOnly="true" inactivate="true"  hidden="false" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
			  <text v="" e=""></text>
			</field>
			<field name="stt" dataType="N" label="1" field="1" disabled="true" format="0" hidden="false" nextRow="true" fieldType="PK">
				<text v="Số thứ tự" e="STT"></text>
			</field>
			<field name="thoi_gian" label="1" field="1" allowBlank="true" disabled="true" nextRow="true" >
				<text v="Thời gian" e="Time"></text>
			</field>
			<field name="tg_dukienbd" label="1" field="1" allowBlank="true" disabled="true" nextRow="true" >
				<text v="TG dự kiến bắt đầu" e="Estimated Start Time"></text>
			</field>
			<field name="tg_dukienkt" label="1" field="1" allowBlank="true" disabled="true" nextRow="true" >
				<text v="TG dự kiến kết thúc" e="Estimated End Time"></text>
			</field>
			<field name="error" label="1" field="1" fieldType="EX" readOnly="true" inactivate="true" hidden="true">
			  <text v="" e=""></text>
			</field>
      </fields>
    </form>
	<form gravity="TopRight" columns="120,120" >
		<fields>
			<field name="ngay_ct" label="1" field="1" valueDefault="new Date()" copy="false" allowBlank="false" dataType="D">
			  <text v="Ngày đăng ký" e="Resgiter Date"></text>
			</field>
			<field name="status" viewType="Combobox" valueDefault="5" inactivate="true" label="[60]" field="[180]" >
			  <text v="Trạng thái" e="Status"></text>
			  <viewInfo>
				<options query="select ma_ttct, ten_ttct%l from dmttct where ma_ct = 'HC1' and status = 1 order by stt">
				</options>
			  </viewInfo>
			</field>
		</fields>
    </form>
</forms>

&DefaultButton;

<js>
    <text>
  <![CDATA[<enc></enc>]]>
    </text>
  </js>
