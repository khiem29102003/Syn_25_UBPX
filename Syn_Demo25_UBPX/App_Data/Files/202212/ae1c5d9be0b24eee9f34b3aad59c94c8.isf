<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
  <!ENTITY DefaultButton SYSTEM "..\Include\XML\DefaultButtonDir.xml">
]>


<dir id="dmnhansu" table="dmnhansu" fieldKey="ma_ns" dirViewType="Dialog" xmlns="urn:schemas-iswift:struct-dir">
  <title v="Danh mục nhân viên" e="List of customer"></title>
  <title0 v="Thêm" e="New"></title0>
  <title1 v="Sửa" e="Edit"></title1>

  <forms>
    <form gravity="TopLeft" columns="120,120,120,120,120,120" >
      <fields>
        <field name="unit_id" dataType="I" hidden="true" readOnly="true" inactivate="true" label="1" field="1" importable="-1">
          <text v="" e=""></text>
        </field>
        <field name="ma_ns" format="U" label="1" field="1" viewType="AutoIncrease" allowBlank="false" fieldType="PK" importable="5">
          <text v="Mã nhân viên" e="Code"></text>
        </field>
        <field name="ten_ns" allowBlank="false" label="1" field="-" importWidth="250" importable="10">
          <text v="Tên nhân viên" e="Name"></text>
        </field>
        	<field name="phong_ban" allowBlank="false" label="1" field="-" importWidth="250" importable="10">
          <text v="Phòng ban" e="Name"></text>
        </field>
         <field name="chuc_vu" allowBlank="false" label="1" field="-" importWidth="250" importable="10">
          <text v="Chức vụ" e="Name"></text>
        </field>		
	    <field name="so_nam_lv" allowBlank="false" label="1" field="-" importWidth="250" importable="10">
          <text v="Số năm làm việc" e="Name"></text>
        </field>
        <field name="dia_chi" label="1" field="-" importWidth="250" importable="30">
          <text v="Địa chỉ" e="Address"></text>
        </field>
        <field name="ma_so_thue" label="1" field="2"  importable="35">
          <text v="Mã số thuế &lt;a onclick='getTax(this);'&gt;(Kiểm tra)&lt;/a&gt;" e="Tax Code"></text>
        </field>
        <field name="nguoi_lh" label="1" field="-" nextRow="false" importable="40">
          <text v="Người liên hệ" e="Contact"></text>
        </field>
        <field name="ma_nvbh" viewType="Lookup" label="1" field="1" clientDefault="true" importable="45">
          <text v="Nhân viên bán hàng" e="Employee"></text>
          <viewInfo lookupType="One" lookupId="dmnvbh" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_nvbh" lookupInfo="dmnvbh|ma_nvbh|ten_nvbh" importCheck="@@DF and z.status=1" />
        </field>
        <field name="ten_nvbh" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as " clientDefault="true">
          <text v="" e=""></text>
        </field>
        <field name="ma_tt" viewType="Lookup" label="1" field="1" importable="50">
          <text v="Mã thanh toán" e="Sale"></text>
          <viewInfo lookupType="One" lookupId="dmtt" lookupKey="status=1" lookupCheck="1=1" lookupRef="ten_tt" lookupInfo="dmtt|ma_tt|ten_tt" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="ten_tt" nextRow="false" fieldType="EX" readOnly="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="gioi_han_no" label="1" field="1" dataType="N" format="" importable="55">
          <text v="Giới hạn tiền nợ" e="Giới hạn tiền nợ"></text>
        </field>
         
     
        <field name="rg_code" format="U" viewType="Lookup" label="1" field="1" clientDefault="true" importable="75">
          <text v="Khu vực" e="Region Code"></text>
          <viewInfo lookupType="One" lookupId="sysregioninfo" lookupKey="status=1" lookupCheck="1=1" lookupRef="rgname" lookupInfo="sysregioninfo|rg_code|rgname" importCheck="@@DF and z.status=1"/>
        </field>
        <field name="rgname" nextRow="false" fieldType="EX" readOnly="true" clientDefault="true" inactivate="true" label="" field="-" aliasName="cast('' as nvarchar(4000)) as ">
          <text v="" e=""></text>
        </field>
        <field name="dien_thoai" label="1" field="2"  importable="80">
          <text v="Điện thoại" e="Phone"></text>
        </field>
        <field name="fax" label="1" field="2" nextRow="false" importable="85">
          <text v="Fax" e="Fax"></text>
        </field>
        <field name="e_mail" label="1" field="2" importable="90">
          <text v="Email" e="Email"></text>
        </field>
        <field name="home_page" label="1" field="2" nextRow="false" importWidth="150" importable="95">
          <text v="Trang chủ" e="Home Page"></text>
        </field>
        <field name="ghi_chu" label="1" field="-" inactivate="true" importWidth="250" importable="100">
          <text v="Ghi chú" e="Notes"></text>
        </field>
        <field name="status" viewType="Combobox" inactivate="true" label="1" field="2" valueDefault="1" importable="-1">
          <text v="Trạng thái" e="Status"></text>
          <viewInfo>
            <options>
              <option val="1">
                <text v="1 - Còn sử dụng" e="1 - Use"></text>
              </option>
              <option val="0">
                <text v="0 - Không sử dụng" e="0 - Not use"></text>
              </option>
            </options>
          </viewInfo>
        </field>
      </fields>
    </form>
  </forms>

  &DefaultButton;

<js>
    <text>
      <![CDATA[
function dir$dmnhansu(p){
  this.constructor(p);
}
dir$dmnhansu.prototype = new DirEvent();

dir$dmnhansu.prototype.formFieldValueChange = function (o, cF, v) {
  var p = this._dir;
  switch (cF){
    default:
      break;
  }
}

function getTax(o) {
  var p = document._dir;
  var tax = p.valForm('ma_so_thue');
  if (tax.length != 10 && tax.length != 13) {
    $.showToast('Thông tin mã số thuế không đúng.');
    return;
  }
  
  $.invoke('GetTax', { taxCode: tax }, this, 30000
    , function (result) {
      if (result) {
        var obj = JSON.parse(result);
        p.valForm('ten_ns', obj.Name, true);
        p.valForm('dia_chi', obj.Address, true);
		p.valForm('ten_ns2', obj.Other, true);
		p.valForm('nguoi_lh', obj.Contact, true);
		p.valForm('dien_thoai', obj.Telephone, true);
		
      }
    }, function (event) {} );
	
}

dir$dmnhansu.prototype.afterInit = function(renderType){
  var p = this._dir,g = p.grid()

  dir$dmkhDisabledMasterField(p, g);
  var p = this._dir;
  document._dir = p;
}

function dir$dmkhDisabledMasterField(p, g){
	if(p.valForm('ma_ns').trim() != '')
  {
    p.setDisabled('ma_ns', true);
  }
  else
  {
    p.setDisabled('ma_ns', false);
  }
}
         ]]>
		
    </text>
  </js>
   <css>
		<text>
		  <![CDATA[
	.control-label.ma_ns, .control-label.ten_ns
	{	
		font-weight:bold;	
		color: #499b98;;
	}
		  ]]>
		</text>
  </css>

  <script>
    
    <query>
      <text>
        <![CDATA[
select @@fields into #@@table from @@table a where [%whereFieldKey]
[%updateRef]
select * from #@@table

declare @script nvarchar(4000)
select @script = '';
if @action = 'EDIT'
  if exists(select 1 from syscodeexists with(nolock, index(code1)) where code1 = @ma_ns and field = 'ma_ns')
    select @script = @script + 'p.setDisabled(''ma_ns'', true); '

if @action in ('EDIT', 'VIEW') select @script as script
drop table #@@table
         ]]>
      </text>
    </query>
    <inserting>
      <text>
        <![CDATA[
if exists(select 1 from @@table a where [%whereFieldKey]) begin
  select '$codeExistsNewMsg' as message, '@@firstFieldKey' as field
  return
end

select @datetime0 = getdate(), @datetime2 = getdate(), @user_id0 = @@userId, @user_id2 = @@userId, @unit_id = @@unit
]]>
      </text>
    </inserting>
    <aftersave>
      <text>
        <![CDATA[
if @ma_so_thue <> '' and exists (select 1 from dmnhansu where ma_so_thue = @ma_so_thue and ma_ns <> @ma_ns)        
  select '$taxtCodeExists' as toast
]]>
      </text>
    </aftersave>


    <importing>
      <text>
        <![CDATA[
update #data set unit_id = @@unit
@@insert
        ]]>
      </text>

    </importing>
  </script>

  <messages>
    <message val="codeExistsNewMsg">
      <text v="Mã nhân viên đã tồn tại trong danh mục nhân viên." e="The record already exists."/>
    </message>
    <message val="codeExistsEditMsg">
      <text v="Mã nhân viên đã tồn tại trong danh mục nhân viên." e="The record already exists."/>
    </message>
    <message val="taxtCodeExists">
      <text v="Mã số thuế đã tồn tại trong danh mục, &lt;span class='Highlight'&gt;Lưu ý:&lt;/span&gt; hệ thống vẫn lưu dữ liệu vừa cập nhật." e="The tax code is already exists, &lt;span class='Highlight'&gt;Warning:&lt;/span&gt; Updated data has been saved."/>
    </message>
  </messages>
</dir>